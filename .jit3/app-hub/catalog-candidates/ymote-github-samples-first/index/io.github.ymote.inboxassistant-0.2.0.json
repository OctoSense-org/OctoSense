      "risk": "act",
      "background": true,
      "shareable": false,
      "private_data": true,
      "implemented_by": "host-service"
    },
    {
      "name": "inboxassistant.notify",
      "description": "Publish one important-email workspace using only the admitted glance-workspace.splash template and initial.message. The host binds its connection. Use the exact message ID as card_id; notify only if relevant. Executable card source is not accepted.",
