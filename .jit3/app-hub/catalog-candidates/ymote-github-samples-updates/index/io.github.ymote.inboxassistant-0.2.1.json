      "private_data": true,
      "implemented_by": "host-service"
    },
    {
      "name": "inboxassistant.draft_edit",
      "description": "Save an explicitly requested draft change only against its current revision. Never authorizes sending.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
