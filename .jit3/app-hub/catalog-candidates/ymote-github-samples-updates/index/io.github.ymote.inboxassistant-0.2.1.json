  "listing": {
    "schema": 1,
    "subtitle": "Gmail reply and selective-notification preview",
    "description": "MacOS developer preview: read Gmail, edit a shared reply through Email / Reply / Chat, and review the exact saved reply in the host before sending. Uses host-managed Google authorization and optional consented app-agent tools; credentials stay in the host. Fresh GitHub-published app identity with separate storage/account grants from the legacy sample. Requires contract 1.8.0 / publisher-github-v1 and compatible connected services. Includes fictional local UI states. Publishing and local UI tests do not validate live Google login, provider writes, model behavior or physical approval. Android Google authorization is unavailable; only macOS is advertised.",
    "category": "productivity",
    "keywords": [
      "email",
      "gmail",
      "reply",
      "sample"
    ],
    "screenshots": [
      "screenshots/01-main.png",
      "screenshots/03-reply.png",
      "screenshots/02-chat.png"
    ],
    "icon": "assets/icon.svg",
    "platforms": [
      "macos"
    ],
    "publisher": {
      "name": "ymote",
      "support": "https://github.com/ymote/octosense-inbox-assistant/issues",
      "privacy_policy_url": "https://github.com/ymote/octosense-inbox-assistant/blob/main/PRIVACY.md"
    },
    "release_notes": "0.2.1: generated release receipts now distinguish release creation from App Hub admission, and direct publishers to open or update the existing submission issue. App UI, tool permissions and storage layout are unchanged from 0.2.0. This immutable update supports verified install/update and local-draft retention checks; live Google/model/provider writes remain outside the test scope.",
    "age_rating": "all",
    "license": "Apache-2.0"
  },
  "tools": [
    {
      "name": "inboxassistant.messages",
      "description": "List message IDs for this account and selected Gmail label. Use page_token when present.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "connection": {
            "maxLength": 256,
            "type": "string"
          },
          "label": {
            "maxLength": 256,
            "type": "string"
          },
          "page_token": {
            "maxLength": 2048,
            "type": "string"
          }
        },
        "required": [
          "connection"
        ],
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "background": true,
      "shareable": false,
      "private_data": true,
      "implemented_by": "host-service"
    },
    {
      "name": "inboxassistant.message",
      "description": "Read the bound email as plain text, with an explicit notice for omitted attachments.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "connection": {
            "maxLength": 256,
            "type": "string"
          },
          "message_id": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "connection",
          "message_id"
        ],
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "background": true,
      "shareable": false,
      "private_data": true,
      "implemented_by": "host-service"
    },
    {
      "name": "inboxassistant.draft_open",
      "description": "Open or restore the one authoritative local reply draft for this email. Does not send.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "connection": {
            "maxLength": 256,
            "type": "string"
          },
          "message_id": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "connection",
          "message_id"
        ],
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "act",
      "background": true,
      "shareable": false,
      "private_data": true,
      "implemented_by": "host-service"
    },
    {
      "name": "inboxassistant.draft_get",
      "description": "Read the exact saved draft body, revision and submission state.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "connection": {
            "maxLength": 256,
            "type": "string"
          },
          "draft": {
            "maxLength": 256,
            "type": "string"
          }
