        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "act",
      "background": true,
      "shareable": false,
      "private_data": true,
      "implemented_by": "host-service"
    },
    {
      "name": "inboxassistant.event_status",
      "description": "Read the durable decision, if any, for this incoming Gmail event.",
      "input_schema": {
        "additionalProperties": false,
