            "type": "boolean"
          },
          "priority": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "summary": {
            "maxLength": 200,
            "type": "string"
          },
          "template": {
            "enum": [
              "glance-workspace.splash"
            ],
            "type": "string"
          },
