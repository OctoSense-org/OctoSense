{
  "schema": 1,
  "tools": [
    {
      "name": "news.list",
      "description": "List collected stories, newest first, optionally for one topic or since a time.",
      "input_schema": {
        "type": "object",
        "properties": {
          "topic": { "type": "string", "description": "A followed topic; omit for all." },
          "since": { "type": "string", "format": "date-time" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "source": { "type": "string" },
                "lang": { "type": "string" },
                "published": { "type": "string", "format": "date-time" }
              },
              "required": ["id", "title"]
            }
          }
        },
        "required": ["items"]
      },
      "risk": "read",
      "background": true,
      "shareable": true,
      "private_data": false,
      "implemented_by": "host-service"
    },
    {
      "name": "news.read",
      "description": "Read one collected story's main text by its id.",
      "input_schema": {
        "type": "object",
        "properties": { "id": { "type": "string" } },
        "required": ["id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "text": { "type": "string" },
          "link": { "type": "string" }
        },
        "required": ["id", "text"]
      },
      "risk": "read",
      "background": true,
      "shareable": false,
      "implemented_by": "host-service"
    },
    {
      "name": "news.topics.get",
      "description": "The topics the person follows, with their languages.",
      "input_schema": { "type": "object", "properties": {} },
      "output_schema": {
        "type": "object",
        "properties": { "topics": { "type": "array", "items": { "type": "string" } } },
        "required": ["topics"]
      },
      "risk": "read",
      "background": true,
      "shareable": false,
      "implemented_by": "host-service"
    },
    {
      "name": "news.topics.set",
      "description": "Replace the followed topics. The collector uses them from its next fetch.",
      "input_schema": {
        "type": "object",
        "properties": { "topics": { "type": "array", "items": { "type": "string" }, "maxItems": 32 } },
        "required": ["topics"]
      },
      "output_schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } },
      "risk": "act",
      "background": true,
      "shareable": false,
      "implemented_by": "host-service"
    },
    {
      "name": "news.digest.write",
      "description": "Write the structured digest the glance card shows: sections of stories, each with a summary and the ids it cites.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "maxLength": 120 },
          "sections": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "topic": { "type": "string" },
                "summary": { "type": "string", "maxLength": 600 },
                "cites": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["topic", "summary", "cites"]
            }
          }
        },
        "required": ["title", "sections"]
      },
      "output_schema": { "type": "object", "properties": { "digest_id": { "type": "string" } }, "required": ["digest_id"] },
      "risk": "act",
      "background": true,
      "shareable": false,
      "implemented_by": "host-service"
    }
  ]
}
