# level: L0
# DELIBERATELY BROKEN: two topic chips too long for one row, and five stories
# where the glance tile has room for two. card-studio must flag the squeezed
# chip label (text_truncated), the stories that are never laid out
# (text_hidden) and the card not fitting the tile (does_not_fit).
theme light
state digest {shape: record}
copy heading {class: vocabulary, en: "Today in tech"}
view root Surface {
    TextTitle(text: copy.heading)
    Row {
        Chip(text: digest.topic_a)
        Chip(text: digest.topic_b)
    }
    Col {
        for item in digest.items key item.id {
            TextBody(text: item.title)
            TextCaption(text: item.publisher)
        }
    }
}
