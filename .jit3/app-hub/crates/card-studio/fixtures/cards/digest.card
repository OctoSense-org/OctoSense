# level: L0
# A News digest card that fits the glance tile: a title and two stories.
theme light
state digest {shape: record}
copy heading {class: vocabulary, en: "Today in tech"}
view root Surface {
    TextTitle(text: copy.heading)
    Col {
        for item in digest.items key item.id {
            TextBody(text: item.title)
            TextCaption(text: item.publisher)
        }
    }
}
