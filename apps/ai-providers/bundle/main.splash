// AI providers: the LLMs the assistant answers with, first to last. Every
// change goes through the `llm` host service; keys, PINs and QR codes are
// typed and shown only on OctoSense's own sheets, never here.
let providers = []      // primary first: {id, family, label, model, custom_model, base_url, api_type, key, index}
let scanner = false     // the host can scan a QR
let image_picker = false // the host can read a QR from a chosen image
let store = ""          // where keys go: keychain, secrets folder, profile
let results = []        // [{id, text, ok}] from Test
let confirm_remove = ""
let editing = nil       // the provider whose model is being changed

fn status(text){ ui.status.set_text(text) }
fn load(){
    host.request("llm.providers", {}, fn(r){
        if !r.is_ok { status(r.error) return }
        let list = []
        if r.data.primary != nil { list.push(r.data.primary) }
        for f in r.data.fallbacks { list.push(f) }
        let i = 0
        for p in list { p.index = i; i = i + 1 }
        providers = list
        ui.empty.set_visible(list.len() == 0)
        scanner = r.data.scanner
        store = r.data.store
        ui.scan.set_visible(scanner)
        ui.paste.set_visible(!scanner)
        image_picker = r.data.image_picker == true
        if image_picker { ui.paste.set_text("Import code from image") } else { ui.paste.set_text("Paste code") }
        if store == "profile" { ui.where.set_text("Keys are kept in the assistant's private settings on this device.") } else { ui.where.set_text("Keys are kept in the " + store + ".") }
        ui.rows.render()
    })
}
fn result_of(id){
    for t in results { if t.id == id { return t.text } }
    return ""
}
fn set_result(id, text){
    let kept = []
    for t in results { if t.id != id { kept.push(t) } }
    kept.push({id: id text: text})
    results = kept
    ui.rows.render()
}
fn add_provider(){
    status("Add the provider on the sheet OctoSense shows.")
    host.request("llm.add_provider", {}, fn(r){
        if r.is_ok { status("Added " + r.data.label) } else { status(r.error) }
        load()
    })
}
fn edit(p){
    status("")
    host.request("llm.edit_provider", {id: p.id}, fn(r){
        if r.is_ok { status("Saved " + r.data.label) } else { status(r.error) }
        load()
    })
}
fn run_test(p){
    set_result(p.id, "Testing…")
    host.request("llm.test", {id: p.id}, fn(r){
        if r.is_ok {
            if r.data.error == nil { set_result(p.id, "OK · " + r.data.ms + " ms") } else { set_result(p.id, r.data.error) }
        } else { set_result(p.id, r.error) }
    })
}
fn change(method, args, done){
    confirm_remove = ""
    host.request(method, args, fn(r){
        if r.is_ok { done() } else { status(r.error) }
        load()
    })
}
fn move_to(p, to){ change("llm.move", {id: p.id to: to}, || status("")) }
fn make_primary(p){ change("llm.set_primary", {id: p.id}, || status(p.label + " answers first now.")) }
fn remove_provider(p){
    if confirm_remove != p.id {
        confirm_remove = p.id
        ui.rows.render()
        return
    }
    change("llm.remove", {id: p.id}, || status("Removed " + p.label))
}
fn change_model(p){
    editing = p
    ui.m_title.set_text(p.label)
    ui.m_field.set_text(p.model)
    ui.m_note.set_text("")
    pane("model")
}
fn save_model(){
    if editing == nil { return }
    host.request("llm.set_model", {id: editing.id model: ui.m_field.text()}, fn(r){
        if r.is_ok { status("Model saved"); pane("list"); load() } else { ui.m_note.set_text(r.error) }
    })
}
fn show_qr(){
    if providers.len() == 0 { status("Add a provider first.") return }
    status("The code is on the sheet OctoSense shows.")
    host.request("llm.export_qr", {}, fn(r){
        if r.is_ok { status("") } else { status(r.error) }
    })
}
fn import_code(){
    status("")
    host.request("llm.import_qr", {}, fn(r){
        if r.is_ok {
            let names = ""
            for n in r.data.applied {
                if names != "" { names = names + ", " }
                names = names + n
            }
            status("Imported " + names)
        } else { status(r.error) }
        load()
    })
}
fn pane(name){
    ui.list.set_visible(name == "list")
    ui.model.set_visible(name == "model")
}
fn detail(p){
    let text = p.model
    if p.base_url != nil { text = text + " · " + p.base_url }
    return text
}

start_timeout(0.05, || load())

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #x007aff
let danger = #xff3b30
let Bar = ButtonFlat{height: 36 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: #x00000000 color_hover: #x0000000a color_down: #x00000014 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}
}
let Small = ButtonFlat{height: 30 padding: Inset{left: 10 right: 10}
    draw_bg +: {border_radius: 8.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd1d1d6 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 13}}
}
let SmallDanger = Small{draw_text +: {color: danger color_hover: danger color_down: danger}}
let Big = ButtonFlat{width: Fill height: 44
    draw_bg +: {border_radius: 22.0 color: #x007aff color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style +: {font_size: 15}}
}
let BigPlain = ButtonFlat{width: Fill height: 44
    draw_bg +: {border_radius: 22.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd1d1d6 border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 15}}
}
let Field = TextInput{width: Fill height: 40
    draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7
        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000 border_radius: 10.0}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
}
let Caption = Label{text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}

SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: #xffffff
    list := View{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 16 bottom: 6} spacing: 4
            Label{text: "AI providers" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 30}}
            Label{width: Fill text: "The assistant asks the first provider, and the next ones if it fails."
                draw_text.color: secondary draw_text.text_style.font_size: 13}
            where := Caption{width: Fill}
            status := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style.font_size: 12}
            empty := Label{visible: false width: Fill padding: Inset{top: 24} text: "No providers yet. Add one so the assistant can answer."
                draw_text.color: ink draw_text.text_style.font_size: 15}
        }
        rows := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 padding: Inset{left: 12 right: 12 top: 4 bottom: 12} on_render: || {
            // Always one child: a render that yields none keeps the last rows.
            View{width: Fill height: 1}
            for p in providers {
                RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: 12 show_bg: true draw_bg.color: #xf7f7fa draw_bg.border_radius: 12.0
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{width: Fill text: p.label max_lines: 1 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                        if p.index == 0 { Label{text: "Primary" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 12}} }
                        else { Label{text: "Fallback " + p.index draw_text.color: secondary draw_text.text_style.font_size: 12} }
                    }
                    Label{width: Fill text: detail(p) max_lines: 2 draw_text.color: #x3a3a3c draw_text.text_style.font_size: 13}
                    Label{width: Fill text: "Key: " + p.key draw_text.color: secondary draw_text.text_style.font_size: 12}
                    if result_of(p.id) != "" {
                        Label{width: Fill text: result_of(p.id) draw_text.color: #x3a3a3c draw_text.text_style.font_size: 12}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6
                        Small{text: "Test" on_click: || run_test(p)}
                        Small{text: "Edit" on_click: || edit(p)}
                        Small{text: "Model" on_click: || change_model(p)}
                        if p.index > 0 { Small{text: "Up" on_click: || move_to(p, p.index - 1)} }
                        if p.index < providers.len() - 1 { Small{text: "Down" on_click: || move_to(p, p.index + 1)} }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6
                        if p.index > 0 { Small{text: "Make primary" on_click: || make_primary(p)} }
                        if (confirm_remove == p.id) { SmallDanger{text: "Tap again to remove" on_click: || remove_provider(p)} }
                        else { SmallDanger{text: "Remove" on_click: || remove_provider(p)} }
                    }
                }
            }
        }}
        View{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 16 right: 16 top: 4 bottom: 16}
            Big{text: "Add provider" on_click: || add_provider()}
            // Stacked: side by side, a phone's width clips both labels.
            View{width: Fill height: Fit flow: Down spacing: 8
                BigPlain{text: "Show QR for phone" on_click: || show_qr()}
                scan := BigPlain{visible: false text: "Scan QR from desktop" on_click: || import_code()}
                paste := BigPlain{text: "Paste code" on_click: || import_code()}
            }
        }
    }
    model := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true draw_bg.color: #xffffff padding: Inset{left: 16 right: 16 top: 8} spacing: 8
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            Bar{text: "Cancel" on_click: || pane("list")}
            View{width: Fill height: 1}
            Bar{text: "Save" on_click: || save_model()}
        }
        m_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 22}}
        Caption{text: "Model (empty: the provider's default)"}
        m_field := Field{empty_text: "model id"}
        m_note := Label{width: Fill text: "" draw_text.color: danger draw_text.text_style.font_size: 12}
    }
}
