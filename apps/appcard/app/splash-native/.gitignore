# Build output. These were committed by accident in the first splash-native commit —
# ~1500 files of dex, gradle caches and Rust artifacts, which bloat the repo and conflict
# on every build.
.gradle/
app/build/
rust/target/

# Native library built from rust/ (see README "Build"); never commit it —
# a locally built .so embeds the build machine's paths.
app/src/main/jniLibs/**/*.so
