// BEGIN shared app interface
// Shared system-app interface. Run tools/sync-app-interface.py after editing.
// Bundles carry this prelude so they work in the contained standalone host too.
// Resolve the current theme after a host restyle, not a retained prelude alias.
let theme = mod.theme
// A desktop shell's style sheet says `ui_pointer = true`: the app gets pointer
// metrics and the Mac layouts (13-point text, 28-point controls, a sidebar and
// a toolbar). Anything else, a phone or a bare host, keeps the touch metrics.
let ui_desk = try { theme.ui_pointer == true } catch { false }
// A Mac's window has no title bar over an app that says so to the shell
// (crates/shell/src/clients.rs, unified_chrome): the app draws to the window's top
// edge, its toolbar is 52 points tall, and the lights sit over the leading 84 points
// of the toolbar, or over the top of a sidebar. Other desktops keep a title bar.
let ui_unified = ui_desk && try { theme.ui_unified == true } catch { false }
fn ui_by(touch, desk){ if ui_desk { desk } else { touch } }
let ui_ink = theme.color_text
let ui_page = theme.color_bg_app
let ui_light = dot(ui_ink, #x36b61200) < 0.5
let ui_surface = if ui_light { #xffffff } else { mix(ui_page, ui_ink, ui_by(0.06, 0.07)) }
let ui_field = if ui_desk && ui_light { #xffffff } else { mix(ui_page, ui_ink, ui_by(0.075, 0.07)) }
let ui_hover = mix(ui_page, ui_ink, ui_by(0.12, 0.07))
let ui_border = mix(ui_page, ui_ink, ui_by(0.22, 0.14))
let ui_muted = mix(ui_ink, ui_page, ui_by(0.24, 0.26))
// The Mac's system colours where the page is a Mac's, near white or near black;
// a retro style's mid-gray page keeps text that is mostly ink.
let ui_lum = dot(ui_page, #x36b61200)
let ui_mac = ui_desk && (ui_lum > 0.86 || ui_lum < 0.25)
let ui_link = if ui_mac { if ui_light { #x0060c0 } else { #x6cb8ff } } else { mix(ui_ink, #x356bce, 0.25) }
let ui_primary = ui_by(#x285cd6, #x0071e3)
let ui_success = if ui_mac { if ui_light { #x1a7030 } else { #x30d158 } } else { mix(ui_ink, #x28a55b, 0.20) }
let ui_danger = if ui_mac { if ui_light { #xc70012 } else { #xffa097 } } else { mix(ui_ink, #xe13b53, 0.20) }
// The Mac's surfaces: a sidebar and a toolbar a shade off the page, a selection
// in the sidebar's own gray, a push button's face.
let ui_sidebar = mix(ui_page, ui_ink, 0.03)
let ui_bar = if ui_light { #xededf0 } else { #x303033 }
let ui_selected = mix(ui_page, ui_ink, 0.11)
let ui_button = if ui_light { #xffffff } else { mix(ui_page, ui_ink, 0.16) }
// What a list or a document sits on: white in the light; in the dark, darker than
// the window around it, as a Mac's content is.
let ui_content = if ui_mac { if ui_light { #xffffff } else { #x1e1e1e } } else { ui_surface }
// A selected row: the accent when it is the row the person is on, white text on it.
let ui_accent_row = if ui_light { #x0064d2 } else { #x0a60c8 }
// A Mac dims the window behind a sheet, more in the dark; the shell's own sheets
// and the native apps' dim as much.
let ui_sheet_dim = if ui_light { #x00000024 } else { #x00000052 }
// A touch size in the type scale; on the desktop, the Mac's size for that role
// (Makepad's font_size is three quarters of a point).
fn ui_fs(n){
    if !ui_desk { return n }
    if n <= 12 { return 8.25 }
    if n <= 13 { return 9 }
    if n <= 16 { return 9.75 }
    if n <= 18 { return 11.25 }
    if n <= 21 { return 12.75 }
    if n <= 24 { return 13.5 }
    if n <= 28 { return 16.5 }
    19.5
}
let ui_icons = {}
fn ui_icon(name){
    let handle = ui_icons[name]
    if handle == nil {
        handle = http_resource("{{assets}}/icons/ui-" + name + ".svg")
        ui_icons[name] = handle
    }
    handle
}
let UiButton = ButtonFlat{height: ui_by(44, 28) margin: 0 padding: Inset{left: ui_by(14, 12) right: ui_by(14, 12)} spacing: 6
    icon_walk: Walk{width: 15 height: 15}
    draw_bg +: {border_radius: ui_by(12.0, 3.0) border_size: ui_by(0.0, 1.0) border_color: ui_border
        color: ui_by(#x00000000, ui_button) color_hover: ui_by(ui_hover, mix(ui_button, ui_ink, 0.04)) color_down: ui_by(ui_field, mix(ui_button, ui_ink, 0.1)) color_focus: ui_by(ui_hover, ui_button)}
    draw_text +: {color: ui_by(ui_link, ui_ink) color_hover: ui_by(ui_link, ui_ink) color_down: ui_by(ui_link, ui_ink) color_focus: ui_by(ui_link, ui_ink)
        text_style: ui_by(theme.font_bold{font_size: 14}, theme.font_regular{font_size: 9.75})}
    draw_icon +: {color: ui_ink}
}
let UiPrimary = UiButton{
    draw_bg +: {border_size: 0.0 color: ui_primary color_hover: ui_by(#x3468df, #x006edb) color_down: ui_by(#x204cb8, #x0060c0) color_focus: ui_by(#x204cb8, ui_primary)}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}
    draw_icon +: {color: #xffffff}
}
let UiPill = UiButton{height: ui_by(44, 24) padding: Inset{left: ui_by(14, 10) right: ui_by(14, 10)}
    draw_bg +: {color: ui_by(ui_surface, #x00000000) border_size: 0.0 border_radius: ui_by(22.0, 3.0)}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink}}
let UiField = TextInput{width: Fill height: ui_by(48, 28) margin: 0 padding: Inset{left: ui_by(14, 8) right: ui_by(14, 8) top: ui_by(12, 6) bottom: ui_by(12, 6)}
    draw_bg +: {color: ui_field color_hover: ui_field color_focus: ui_field color_empty: ui_field
        border_color: ui_border border_color_hover: ui_by(ui_link, ui_border) border_color_focus: ui_link border_color_empty: ui_border border_radius: ui_by(12.0, 3.0)}
    draw_text +: {color: ui_ink color_hover: ui_ink color_focus: ui_ink color_empty: ui_muted color_empty_hover: ui_muted color_empty_focus: ui_muted text_style: theme.font_regular{font_size: ui_by(15, 9.75)}}
    draw_selection.color: #x557dcc55
}
let UiCard = RoundedView{width: Fill height: Fit flow: Down spacing: ui_by(12, 8) padding: ui_by(20, 14)
    show_bg: true draw_bg +: {color: ui_surface border_radius: ui_by(16.0, 5.0) border_size: ui_by(0.0, 1.0) border_color: ui_by(#x00000000, ui_border)}}
let UiCaption = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: ui_by(13, 8.25) line_spacing: 1.4}}}
let UiTitle = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: ui_by(28, 16.5) line_spacing: 1.2}}}
// The Mac's parts. They are drawn on a desktop only; a phone keeps its pages.
// A shader's border_radius is half the corner it draws: 3 is a 6-point corner.
let UiSep = SolidView{width: Fill height: 1 draw_bg.color: ui_border}
let UiVSep = SolidView{width: 1 height: Fill draw_bg.color: ui_border}
let UiGlyph = Svg{width: 16 height: 16 animating: false draw_svg +: {color: ui_muted}}
let UiTool = ButtonFlat{height: 28 margin: 0 padding: Inset{left: 8 right: 8} spacing: 5 icon_walk: Walk{width: 16 height: 16}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
    draw_icon +: {color: ui_ink}
}
let UiToolIcon = UiTool{width: 30 padding: 0 spacing: 0 text: ""}
// A tool whose click hides it or the pane it sits on: it comes back unwashed.
let UiPaneTool = UiToolIcon{reset_hover_on_click: true}
// The clear button inside a search field, shown while it holds text.
let UiSearchClear = UiPaneTool{visible: false width: 24 height: 24 icon_walk: Walk{width: 14 height: 14}
    draw_bg +: {color_hover: #x00000000 color_down: #x00000000}
    draw_icon +: {svg: ui_icon("search-clear") color: ui_muted}}
let UiToolbar = SolidView{width: Fill height: if ui_unified { 52 } else { 40 } flow: Right align: Align{y: 0.5} spacing: 4 padding: Inset{left: 12 right: 10} draw_bg.color: ui_bar}
// A toolbar that starts at the window's leading edge, with no sidebar beside it.
let UiWindowToolbar = UiToolbar{padding: Inset{left: if ui_unified { 84 } else { 12 } right: 10}}
let UiBarTitle = Label{clip_y: false padding: 0 text: "" max_lines: 1 draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 11.25}}}
let UiBarSub = Label{clip_y: false padding: 0 text: "" max_lines: 1 draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
let UiSidebar = SolidView{width: 208 height: Fill flow: Down padding: Inset{left: 8 right: 8 top: if ui_unified { 52 } else { 8 } bottom: 8} spacing: 1 draw_bg.color: ui_sidebar}
let UiSideHead = Label{padding: Inset{left: 8 top: 12 bottom: 4} text: "" draw_text +: {color: ui_muted text_style: theme.font_bold{font_size: 8.25}}}
let UiSideRow = ButtonFlat{width: Fill height: 28 margin: 0 padding: Inset{left: 8 right: 8} spacing: 7 align: Align{x: 0.0 y: 0.5}
    icon_walk: Walk{width: 16 height: 16} label_walk: Walk{width: Fill height: Fit}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: #x00000000 color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
    draw_icon +: {color: ui_link}
}
let UiSideRowOn = UiSideRow{draw_bg +: {color: ui_selected color_hover: ui_selected color_focus: ui_selected}}
let UiSeg = ButtonFlat{height: 24 margin: 0 padding: Inset{left: 12 right: 12}
    draw_bg +: {border_radius: 2.5 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
}
let UiSegOn = UiSeg{draw_bg +: {color: ui_button color_hover: ui_button color_focus: ui_button border_size: 1.0 border_color: ui_border}}
let UiSegments = RoundedView{width: Fit height: 28 flow: Right align: Align{y: 0.5} spacing: 2 padding: 2 show_bg: true draw_bg +: {color: ui_selected border_radius: 3.5}}
let UiSearch = UiField{padding: Inset{left: 26 right: 8 top: 6 bottom: 6}}
let UiGroup = RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: ui_surface border_radius: 5.0 border_size: 1.0 border_color: ui_border}}
let UiFormRow = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 12 padding: Inset{left: 14 right: 14 top: 8 bottom: 8}}
let UiFormLabel = Label{clip_y: false padding: 0 width: Fill text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiListRow = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10 padding: Inset{left: 14 right: 14 top: 8 bottom: 8}}
// A two-line row of a list: a line in the body size, a line under it in the small.
let UiRowTitle = Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiRowNote = Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
// A form: the label right-aligned in a 110-point column to the left of its control.
let UiFormKey = Label{clip_y: false padding: 0 width: 110 text: "" align: Align{x: 1.0} draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiFormLine = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8}
// A pop-up button: the choice, and the up-down mark at its trailing edge (an
// Overlay of this over UiPopupMark).
let UiPopup = UiButton{padding: Inset{left: 10 right: 28} align: Align{x: 0.0 y: 0.5}}
let UiPopupMark = View{width: Fit height: Fit padding: Inset{right: 8} new_batch: true
    Svg{width: 13 height: 13 animating: false draw_svg +: {svg: ui_icon("updown") color: ui_muted}}}
// A small count or state beside a name.
let UiBadge = RoundedView{width: Fit height: Fit padding: Inset{left: 6 right: 6 top: 2 bottom: 2} new_batch: true show_bg: true draw_bg +: {color: mix(ui_surface, ui_ink, 0.1) border_radius: 2.5}}
let UiBadgeText = Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 8.25}}}
// A status bar along a window's bottom: small text on the bar's colour.
let UiFootBar = SolidView{width: Fill height: 24 flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 12 right: 12} draw_bg.color: ui_bar}
// An empty list or an empty window: a glyph, a title, a line, and, under them, what
// to do about it. Centred in what the empty state fills.
let UiEmpty = View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 6 padding: 24
    glyph := Svg{width: 36 height: 36 margin: Inset{bottom: 4} animating: false draw_svg +: {color: ui_muted}}
    title := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 11.25}}}
    note := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
}
// A Mac's alert carries its app's icon, as the native apps' alerts do: 64 points
// on top in the alert below. The shell draws it in its style's frame (`ReviewAppIcon`,
// crates/shell/src/connected_review.rs; `app` is the bundle's id, "os.writer"); a host
// without the shell has none, and the alert keeps its words alone.
let UiAlertIcon = try { mod.widgets.ReviewAppIcon } catch { nil }
let ui_alert_icon = ui_mac && UiAlertIcon != nil
// A Mac's alert as macOS has drawn it since 11 (Files' Empty Trash): 260 points
// wide, the app's 64-point icon on top, the title and its words centred under it,
// then the buttons. Two sit side by side, each as wide as the other, the default
// on the right (UiAlertRow, each button `width: Fill`); three or more stand one
// over another, the default on top (UiAlertStack). A host with no app icon shows
// the words alone. Off a Mac an app keeps its own sheet.
let UiAlertPanel = RoundedShadowView{width: 260 height: Fit flow: Down align: Align{x: 0.5} padding: Inset{left: 16 right: 16 top: 20 bottom: 16} new_batch: true cursor: MouseCursor.Default
    draw_bg +: {color: ui_surface border_size: 1.0 border_color: ui_border border_radius: 10.0 shadow_color: #x00000040 shadow_radius: 18.0 shadow_offset: vec2(0.0, 4.0)}}
// A Label's margin counts twice: 10 and 6 points between icon, title and words.
let UiAlertTitle = Label{clip_y: false width: Fill padding: 0 margin: Inset{top: 5} align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75 line_spacing: 1.3}}}
let UiAlertNote = Label{clip_y: false width: Fill padding: 0 margin: Inset{top: 3} align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 8.25 line_spacing: 1.3}}}
let UiAlertRow = View{width: Fill height: Fit flow: Right spacing: 8 margin: Inset{top: 16}}
let UiAlertStack = View{width: Fill height: Fit flow: Down spacing: 8 margin: Inset{top: 16}}
// END shared app interface
// Calendar owns one store. Both this UI and agents use calendar.*; the
// Glance event card is a projection of the same saved event, never a copy.
let month = ""
let day = ""
let today = ""
let zone = ""
let weeks = []
let events = []
let selected = nil
let screen = "calendar"
let busy = false
let generation = 0
let last_view = ""
let delete_pending = false
let weekdays = ["M" "T" "W" "T" "F" "S" "S"]

fn status(message){ ui.status.set_text(message) }
fn pane(name){
    screen = name
    ui.calendar.set_visible(name == "calendar")
    ui.detail.set_visible(name == "detail")
    ui.editor.set_visible(name == "editor")
}
fn render_detail(){
    if selected == nil { return }
    ui.event_title.set_text(selected.title)
    let when = selected.start
    if selected.when != nil { when = selected.when }
    ui.event_when.set_text(when)
    let tz = "Device local time"
    if selected.timezone != nil && selected.timezone != "" { tz = selected.timezone }
    ui.event_zone.set_text(tz)
    let place = "No location added"
    if selected.location != "" { place = selected.location }
    ui.event_place.set_text(place)
    let note = "No notes added"
    if selected.notes != "" { note = selected.notes }
    ui.event_notes.set_text(note)
}
fn open_event(event){
    selected = event
    ui.delete_button.set_text("Delete event")
    delete_pending = false
    render_detail()
    ui.detail_status.set_text("")
    pane("detail")
}
fn refresh(direction){
    generation = generation + 1
    let request_generation = generation
    host.request("calendar.view", {month: month day: day direction: direction take_focus: screen != "editor"}, fn(r){
        if request_generation != generation { return }
        if !r.is_ok { status(r.error); return }
        if last_view == r.data.fingerprint { return }
        last_view = r.data.fingerprint
        month = r.data.month
        day = r.data.day
        today = r.data.today
        zone = r.data.timezone
        weeks = r.data.weeks
        events = r.data.events
        ui.month_title.set_text(r.data.month_label)
        ui.day_title.set_text(r.data.day_label)
        ui.grid.render()
        ui.events.render()
        status("Your schedule, all in one place")
        if r.data.focused != nil && screen != "editor" { open_event(r.data.focused) }
        if screen == "detail" && selected != nil {
            for event in events { if event.id == selected.id { selected = event; render_detail() } }
        }
    })
}
fn pick(date){ day = date; month = ""; refresh(0) }
fn go_today(){ day = today; month = ""; refresh(0) }
fn back(){ selected = nil; pane("calendar"); refresh(0) }
fn edit_new(){
    selected = nil
    ui.edit_heading.set_text("New event")
    ui.e_title.set_text("")
    ui.e_date.set_text(day)
    ui.e_start.set_text("09:00")
    ui.e_end_date.set_text(day)
    ui.e_end.set_text("")
    ui.e_zone.set_text(zone)
    ui.e_place.set_text("")
    ui.e_notes.set_text("")
    ui.edit_status.set_text("Title and date are required. End time is optional.")
    pane("editor")
}
fn edit_existing(){
    if selected == nil { return }
    ui.edit_heading.set_text("Edit event")
    ui.e_title.set_text(selected.title)
    let start_parts = selected.start.split("T")
    ui.e_date.set_text(start_parts[0])
    let time = ""
    if start_parts.len() > 1 { time = start_parts[1] }
    ui.e_start.set_text(time)
    let end = ""
    let end_date = start_parts[0]
    if selected.end != nil { let parts = selected.end.split("T"); end_date = parts[0]; if parts.len() > 1 { end = parts[1] } }
    ui.e_end_date.set_text(end_date)
    ui.e_end.set_text(end)
    let tz = ""
    if selected.timezone != nil { tz = selected.timezone }
    ui.e_zone.set_text(tz)
    ui.e_place.set_text(selected.location)
    ui.e_notes.set_text(selected.notes)
    ui.edit_status.set_text("Changes update this event and its Glance card.")
    pane("editor")
}
fn cancel_edit(){ if busy { return }; if selected != nil { pane("detail") } else { pane("calendar") }; refresh(0) }
fn save(){
    if busy { return }
    busy = true
    ui.edit_status.set_text("Saving…")
    let end = ""
    if ui.e_end.text() != "" { end = ui.e_end_date.text() + "T" + ui.e_end.text() }
    let start = ui.e_date.text()
    if ui.e_start.text() != "" { start = start + "T" + ui.e_start.text() }
    else { if ui.e_end.text() == "" && ui.e_end_date.text() != ui.e_date.text() { end = ui.e_end_date.text() } }
    let args = {title: ui.e_title.text() start: start end: end timezone: ui.e_zone.text() location: ui.e_place.text() notes: ui.e_notes.text()}
    let method = "calendar.add_event"
    if selected != nil { method = "calendar.update_event"; args.id = selected.id; args.expected = selected }
    host.request(method, args, fn(r){
        busy = false
        if !r.is_ok { ui.edit_status.set_text(r.error); return }
        if r.data.card_warning != nil { ui.edit_status.set_text("Event saved. " + r.data.card_warning); busy = false; return }
        day = args.start.split("T")[0].split(" ")[0]
        month = ""
        selected = nil
        pane("calendar")
        refresh(0)
    })
}
fn show_glance(){
    if selected == nil || busy { return }
    busy = true
    host.request("calendar.notify", {event: selected.id}, fn(r){
        busy = false
        if r.is_ok { ui.detail_status.set_text("Event shown in Glance.") }
        else { ui.detail_status.set_text(r.error) }
    })
}
fn remove(){
    if selected == nil || busy { return }
    if !delete_pending { delete_pending = true; ui.delete_button.set_text("Confirm delete"); return }
    busy = true
    host.request("calendar.remove_event", {id: selected.id expected: selected}, fn(r){
        busy = false
        if r.is_ok { back() } else { ui.detail_status.set_text(r.error) }
    })
}
start_timeout(0.05, || { if ui_desk { desk_boot() } else { refresh(0) } })
// A top-level interval is replaced by the host on a theme reload. A recursive
// timeout chain survives that reload and starts an extra poller every time.
start_interval(1.0, || { if ui_desk { desk_poll() } else if !busy && screen != "editor" { refresh(0) } })

let ink = ui_ink
let muted = ui_muted
let accent = ui_link
let Bar = UiButton{}
let Primary = UiPrimary{}
let Field = UiField{}
let Caption = UiCaption{}
let Day = Bar{draw_text.text_style: theme.font_regular{font_size: 14} width: Fill height: 44 padding: 0 draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 14}}}
let Marked = Day{draw_bg +: {color: ui_field color_hover: ui_hover color_down: ui_hover}}
let Chosen = Day{draw_bg +: {color: ui_primary color_hover: ui_primary color_down: ui_primary} draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}

let TouchRoot = SolidView{width: Fill height: Fill flow: Overlay align: Align{x: 0.5} draw_bg.color: ui_page
    calendar := View{width: Fill max_width: 840 height: Fill flow: Down
        View{width: Fill height: 62 flow: Right align: Align{y: 0.5} padding: Inset{left: 18 right: 14} spacing: 6
            Label{width: Fill text: "Calendar" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
            Bar{text: "Today" on_click: || go_today()}
            Primary{text: "+ Event" on_click: || edit_new()}
        }
        status := Caption{padding: Inset{left: 18 right: 18 bottom: 8} text: "Loading calendar…"}
        ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 bottom: 28} spacing: 12
            UiCard{padding: 8 spacing: 8
            View{width: Fill height: 46 flow: Right align: Align{y: 0.5}
                Bar{width: 44 text: "‹" on_click: || refresh(-1)}
                month_title := Label{width: Fill align: Align{x: 0.5} text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
                Bar{width: 44 text: "›" on_click: || refresh(1)}
            }
            View{width: Fill height: 22 flow: Right
                for name in weekdays { Label{width: Fill align: Align{x: 0.5} text: name draw_text.color: muted draw_text.text_style.font_size: 13} }
            }
            grid := View{width: Fill height: Fit flow: Down spacing: 3 on_render: || {
                for week in weeks {
                    View{width: Fill height: 44 flow: Right spacing: 3
                        for date in week.days {
                            let label = date.label
                            if date.marked { label = label + " •" }
                            if date.selected { Chosen{text: label on_click: || pick(date.date)} }
                            else if date.marked { Marked{text: label on_click: || pick(date.date)} }
                            else if !date.in_month { Day{text: label draw_text.color: ui_muted on_click: || pick(date.date)} }
                            else { Day{text: label on_click: || pick(date.date)} }
                        }
                    }
                }
            }}
            }
            day_title := Label{width: Fill margin: Inset{top: 10} text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
            events := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
                if events.len() == 0 {
                    UiCard{padding: 20 spacing: 8
                        Label{width: Fill text: "A little room in your day" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
                        Label{width: Fill text: "No events on this day" draw_text.color: muted draw_text.text_style.font_size: 15}
                        Bar{text: "+ Add an event" on_click: || edit_new()}
                    }
                }
                for event in events {
                    GestureView{width: Fill height: Fit on_tap: |x, y| open_event(event)
                        UiCard{padding: 16 spacing: 6
                            Label{width: Fill text: event.time draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 15}}
                            Label{width: Fill text: event.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 18}}
                            if event.location != "" { Caption{text: event.location} }
                            Bar{text: "View event  ›" on_click: || open_event(event)}
                        }
                    }
                }
            }}
        }
    }
    detail := SolidView{visible: false width: Fill max_width: 840 height: Fill flow: Down draw_bg.color: ui_surface
        View{width: Fill height: 56 flow: Right padding: Inset{left: 8 right: 12} align: Align{y: 0.5}
            Bar{text: "‹ Calendar" on_click: || back()}
            View{width: Fill height: 1}
            Primary{text: "Edit" on_click: || edit_existing()}
        }
        ScrollYView{width: Fill height: Fill flow: Down padding: 20 spacing: 18
            event_title := UiTitle{text: ""}
            SolidView{width: Fill height: Fit flow: Down padding: 18 spacing: 8 draw_bg.color: ui_field
                Caption{text: "WHEN"}
                event_when := Label{width: Fill text: "" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 21}}
                event_zone := Caption{text: ""}
            }
            Caption{text: "LOCATION"}
            event_place := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 16}
            Caption{text: "NOTES"}
            event_notes := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 16}
            Primary{text: "Show in Glance" on_click: || show_glance()}
            detail_status := Caption{text: ""}
            delete_button := Bar{text: "Delete event" draw_text +: {color: ui_danger color_hover: ui_danger color_down: ui_danger color_focus: ui_danger} on_click: || remove()}
        }
    }
    editor := SolidView{visible: false width: Fill max_width: 840 height: Fill flow: Down draw_bg.color: ui_surface
        View{width: Fill height: 58 flow: Right padding: Inset{left: 8 right: 12} align: Align{y: 0.5} spacing: 8
            Bar{text: "Cancel" on_click: || cancel_edit()}
            edit_heading := Label{width: Fill text: "New event" align: Align{x: 0.5} draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 17}}
            Primary{text: "Save" on_click: || save()}
        }
        View{width: Fill height: Fit flow: Down new_batch: true padding: Inset{left: 18 right: 18 bottom: 10}
            edit_status := Caption{text: ""}
        }
        ScrollYView{width: Fill height: Fill flow: Down padding: 18 spacing: 10 new_batch: true
            UiTitle{text: "Event details"}
            Caption{text: "Title"}
            e_title := Field{empty_text: "Event title"}
            View{width: Fill height: Fit flow: Right spacing: 12
                View{width: Fill height: Fit flow: Down spacing: 8
                    Caption{text: "Date"}
                    e_date := Field{empty_text: "2026-10-06"}
                }
                View{width: Fill height: Fit flow: Down spacing: 8
                    Caption{text: "Start · 24-hour time"}
                    e_start := Field{empty_text: "00:00 if empty"}
                }
            }
            View{width: Fill height: Fit flow: Right spacing: 12
                View{width: Fill height: Fit flow: Down spacing: 8
                    Caption{text: "End date"}
                    e_end_date := Field{empty_text: "2026-10-06"}
                }
                View{width: Fill height: Fit flow: Down spacing: 8
                    Caption{text: "End time · Optional"}
                    e_end := Field{empty_text: "Not specified"}
                }
            }
            Caption{text: "Time zone"}
            e_zone := Field{empty_text: "Device local if empty"}
            Caption{text: "Location"}
            e_place := Field{empty_text: "Add a location"}
            Caption{text: "Notes"}
            e_notes := Field{is_multiline: true height: 150 empty_text: "Add notes"}
        }
    }
}

// The Mac's Calendar: Day, Week, Month and Year over the one store, a sidebar with
// the calendars list, the selected day's events and a mini-month, and an event's
// details and editor in a popover beside what was clicked. The grid is drawn from
// the events themselves (calendar.events), and dates are worked out here so that a
// view is drawn without asking the service for its layout.
//
// Everything the window remembers is one object kept on `mod`: switching between
// light and dark runs this file again, every `let` starts over and the widgets keep
// what they show, so the rerun finds it here and goes on with it (a half-typed event
// included).
let dk = nil
if ui_desk {
    dk = try { mod.calendar_desk } catch { nil }
    if dk == nil {
        dk = {
            ready: false          // the store has been read once
            failed: ""            // why it could not be read
            view: "month"         // day, week, month or year
            day: ""               // the selected day, 2026-11-02
            today: ""
            y: 2026  m: 1         // the month the Month view shows; its year is the Year view's
            mini_y: 2026  mini_m: 1
            mini_start: 0
            grid_start: 0         // the Month view's first cell, as a day number
            grid_weeks: 6
            all: []               // every event in the store, soonest first, as read
            rows: []              // the same events, worked out for drawing
            by_day: {}            // date to the events of that one day
            long: []              // the events over more than one day
            sig: ""               // what was last drawn from
            gen: 0                // the store read under way
            loading: false  load_at: 0  reload: false
            show_cal: true        // the calendars list's checkbox
            sel: ""               // the selected event's id
            sel_row: nil
            want: ""              // an event to open once it is read (a Glance card's route)
            want_status: ""
            tap_id: ""  tap_date: ""  tap_at: 0
            cols: []              // the Week or Day view's columns
            band_start: 0
            band_slots: {}
            first_hour: 7
            now_min: -1
            near_hour: -1
            pop: nil              // the open popover: {mode row date x y}
            form: nil             // the editor's values
            menu: nil             // the open date or time zone menu
            shut_at: 0  menu_shut_at: 0   // when each last closed
            busy: false
            add_failure: nil      // the failed action, retained for an explicit retry
            search: ""
            found: []
            w: 1120  h: 720       // the window's size, once the shell has said
            size_gen: 0
            side_user: nil        // the sidebar's toggle; nil follows the window's width
            booted: false
            clip: nil             // an event copied or cut, for Paste
            zone_used: []         // the time zones chosen lately, newest first
            zone_find: nil        // the time zone chooser while it is open
            zone_shut_at: 0
            fresh: nil            // a new event to open once it is read: {id step}
            undo: []  redo: []    // Edit > Undo and Redo: {kind id a b ev}
            pop_n: 0              // each popover's number, for answers that come after it closed
        }
        mod.calendar_desk = dk
    }
}

let cal_bar_h = if ui_unified { 52 } else { 40 }
let cal_side_w = 209      // the sidebar and its hairline
let cal_found_w = 281     // the search results' column and its hairline
let cal_info_w = 261      // a Mac's Day view: the month and the chosen event beside the day, and its hairline
let cal_gutter = 52       // the hours' column of Week and Day
let cal_hour = 44         // an hour's height in Week and Day
let cal_head_h = 46       // the title and the ‹ Today › control
let cal_days_h = 22       // Mon Tue Wed over the month
let cal_edit_w = 396      // the editor's popover
let cal_edit_h = 374      // with room for a line under its fields: see desk_edit_h
let cal_lane_min = 40     // leave room for a readable title or a count that opens the day
let cal_lane_min_week = 16 // a week's day is a narrow column: overlaps share it side by side, as Calendar draws them
// The narrowest an event's strip gets before a count stands for the rest.
fn desk_lane_min(){ if dk.view == "week" { cal_lane_min_week } else { cal_lane_min } }

// Today's disc is Calendar's own mark, not a state: white on it measures 4.7:1.
let cal_today_mark = #xdd2c2c
let cal_today_word = if ui_light { cal_today_mark } else { #xff5f57 }
let cal_day_mark = mix(ui_content, ui_ink, if ui_light { 0.12 } else { 0.28 })
let cal_small_mark = mix(ui_content, ui_ink, if ui_light { 0.22 } else { 0.28 })
let cal_out = if ui_mac { mix(ui_ink, ui_content, if ui_light { 0.3 } else { 0.36 }) } else { ui_muted }
let cal_weekend = mix(ui_content, ui_ink, if ui_light { 0.025 } else { 0.035 })
let cal_tint = mix(ui_content, ui_link, if ui_light { 0.16 } else { 0.24 })
let cal_line = mix(ui_content, ui_ink, if ui_light { 0.1 } else { 0.16 })
let cal_shadow = if ui_light { #x00000040 } else { #x00000090 }
// "No Event Selected", as Mail's "No Message Selected": a grey that still reads (5.1:1 light, 5.8:1 dark).
let cal_none_ink = if ui_light { #x6e6e73 } else { #x98989d }
// A popover's face: in dark it stays below its controls' face, so they read on it.
let cal_pop_face = if ui_light { ui_button } else { mix(ui_content, ui_ink, 0.12) }
let cal_box_line = if ui_light { ui_border } else { mix(ui_content, ui_ink, 0.45) }
