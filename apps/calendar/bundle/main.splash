// ---- dates ----------------------------------------------------------------
// A day number counts days from a fixed date, so a grid is arithmetic. Howard
// Hinnant's civil-date algorithms. Monday is weekday 0, as the service's weeks start.
fn cal_ord(y, m, d){
    let a = if m <= 2 { y - 1 } else { y }
    let era = floor(a / 400)
    let yoe = a - era * 400
    let mp = (m + 9) % 12
    let doy = floor((153 * mp + 2) / 5) + d - 1
    let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
    era * 146097 + doe
}
fn cal_civil(z){
    let era = floor(z / 146097)
    let doe = z - era * 146097
    let yoe = floor((doe - floor(doe / 1460) + floor(doe / 36524) - floor(doe / 146096)) / 365)
    let doy = doe - (365 * yoe + floor(yoe / 4) - floor(yoe / 100))
    let mp = floor((5 * doy + 2) / 153)
    let d = doy - floor((153 * mp + 2) / 5) + 1
    let m = if mp < 10 { mp + 3 } else { mp - 9 }
    let y = yoe + era * 400
    if m <= 2 { y = y + 1 }
    {y: y m: m d: d}
}
fn cal_weekday(o){ (o + 2) % 7 }
// A desktop's grids start the week where the machine does: its place in a row of seven.
let cal_first = (local_time().week_start + 6) % 7
fn cal_col(o){ (cal_weekday(o) - cal_first + 7) % 7 }
fn cal_in_week_order(days){
    let out = []
    let i = 0
    while i < 7 {
        out.push(days[(i + cal_first) % 7])
        i = i + 1
    }
    out
}
let cal_heads_short = cal_in_week_order(cal_day_short)
let cal_heads_letter = cal_in_week_order(cal_day_letter)
fn cal_pad(n){ if n < 10 { "0" + n } else { "" + n } }
fn cal_date(y, m, d){ "" + y + "-" + cal_pad(m) + "-" + cal_pad(d) }
fn cal_date_of(o){
    let c = cal_civil(o)
    cal_date(c.y, c.m, c.d)
}
fn cal_parts(date){
    let p = date.split("-")
    {y: p[0].to_f64() m: p[1].to_f64() d: p[2].to_f64()}
}
fn cal_ord_of(date){
    let p = cal_parts(date)
    cal_ord(p.y, p.m, p.d)
}
fn cal_days_in(y, m){
    let next = if m == 12 { cal_ord(y + 1, 1, 1) } else { cal_ord(y, m + 1, 1) }
    next - cal_ord(y, m, 1)
}
fn cal_month_add(y, m, by){
    let n = y * 12 + (m - 1) + by
    {y: floor(n / 12) m: n % 12 + 1}
}
// The same date and time words everywhere: Nov 2, 2026 and 3:45 PM.
fn cal_long(date){
    let p = cal_parts(date)
    cal_month_short[p.m - 1] + " " + p.d + ", " + p.y
}
fn cal_brief(date){
    let p = cal_parts(date)
    cal_month_short[p.m - 1] + " " + p.d
}
fn cal_with_day(date){ cal_day_short[cal_weekday(cal_ord_of(date))] + ", " + cal_long(date) }
fn cal_side_day(date){
    let p = cal_parts(date)
    cal_day_long[cal_weekday(cal_ord_of(date))] + ", " + cal_month_short[p.m - 1] + " " + p.d
}
fn cal_time(mins){
    let h = floor(mins / 60)
    let m = mins - h * 60
    let hh = h % 12
    if hh == 0 { hh = 12 }
    "" + hh + ":" + cal_pad(m) + if h % 24 < 12 { " AM" } else { " PM" }
}
fn cal_time_short(mins){
    let h = floor(mins / 60)
    let m = mins - h * 60
    let hh = h % 12
    if hh == 0 { hh = 12 }
    let ap = if h % 24 < 12 { " AM" } else { " PM" }
    if m == 0 { "" + hh + ap } else { "" + hh + ":" + cal_pad(m) + ap }
}
fn cal_stamp_mins(time){
    let p = time.split(":")
    p[0].to_f64() * 60 + p[1].to_f64()
}
// A time as a person types it: 9, 9:30, 9.30, 9am, 2:15 PM, 14:15. Minutes, or -1.
fn cal_parse_time(text){
    let c = ("" + text).trim().to_chars()
    let n = c.len()
    let i = 0
    let h = 0
    while i < n && i < 2 && c[i] >= 48 && c[i] <= 57 {
        h = h * 10 + (c[i] - 48)
        i = i + 1
    }
    if i == 0 { return -1 }
    let mins = 0
    if i < n && (c[i] == 58 || c[i] == 46) {
        if i + 2 >= n || c[i + 1] < 48 || c[i + 1] > 57 || c[i + 2] < 48 || c[i + 2] > 57 { return -1 }
        mins = (c[i + 1] - 48) * 10 + (c[i + 2] - 48)
        i = i + 3
    }
    while i < n && c[i] == 32 { i = i + 1 }
    let half = 0
    if i < n && (c[i] == 97 || c[i] == 65) { half = 1 }
    if i < n && (c[i] == 112 || c[i] == 80) { half = 2 }
    if half > 0 {
        i = i + 1
        if i < n && c[i] == 46 { i = i + 1 }
        if i < n && (c[i] == 109 || c[i] == 77) { i = i + 1 }
        if i < n && c[i] == 46 { i = i + 1 }
    }
    if i != n { return -1 }
    if half > 0 {
        if h < 1 || h > 12 { return -1 }
        h = h % 12
        if half == 2 { h = h + 12 }
    }
    if h > 23 || mins > 59 { return -1 }
    h * 60 + mins
}
fn cal_stamp(date, mins){
    let h = floor(mins / 60)
    date + "T" + cal_pad(h) + ":" + cal_pad(mins - h * 60)
}
fn cal_join(parts, by){
    let out = ""
    for i p in parts { out = if i == 0 { p } else { out + by + p } }
    out
}
fn cal_zone_name(id){
    if id == "" { return "Automatic" }
    let name = ""
    for z in cal_world { if z.id == id { name = z.city } }
    if name == "" {
        // A zone an agent wrote that the pop-up does not list: its city, in words.
        let parts = id.split("/")
        name = cal_join(parts[parts.len() - 1].split("_"), " ")
    }
    name
}

// ---- the store --------------------------------------------------------------
// One event worked out for drawing. `all` is the service's own rule: a day alone is
// stored at midnight, with no end or an end at midnight on its last day.
fn desk_row(e){
    let s = e.start.split("T")
    let sd = s[0]
    let sm = if s.len() > 1 { cal_stamp_mins(s[1]) } else { 0 }
    let ed = sd
    let em = -1
    if e.end != nil {
        let t = e.end.split("T")
        ed = t[0]
        em = if t.len() > 1 { cal_stamp_mins(t[1]) } else { 0 }
    }
    let r = {id: e.id title: e.title raw: e sd: sd sm: sm ed: ed em: em all: sm == 0 && em <= 0 multi: ed != sd so: 0 eo: 0}
    if r.multi {
        r.so = cal_ord_of(sd)
        r.eo = cal_ord_of(ed)
    }
    r
}
fn desk_index(list){
    let by = {}
    let long = []
    let rows = []
    for e in list {
        let r = desk_row(e)
        rows.push(r)
        if r.multi { long.push(r) }
        else {
            let bucket = by[r.sd]
            if bucket == nil {
                bucket = []
                by[r.sd] = bucket
            }
            bucket.push(r)
        }
    }
    dk.by_day = by
    dk.long = long
    dk.rows = rows
}
fn desk_day_rows(date, o){
    let out = []
    if !dk.show_cal { return out }
    for r in dk.long { if r.so <= o && r.eo >= o { out.push(r) } }
    let list = dk.by_day[date]
    if list != nil { for r in list { out.push(r) } }
    out
}
// A week's bars: an event over several days keeps one line while it lasts.
fn desk_slots(start, days){
    let out = {}
    let ends = []
    for r in dk.long {
        if r.so < start + days && r.eo >= start {
            let from = max(r.so, start)
            let slot = -1
            for i e in ends { if slot < 0 && e < from { slot = i } }
            if slot < 0 {
                slot = ends.len()
                ends.push(r.eo)
            } else {
                ends[slot] = r.eo
            }
            out[r.id] = slot
        }
    }
    out
}
// What a month's cell lists: the bars in their lines, then the day's own events.
fn desk_cell_lines(o, date, slots){
    let lines = []
    if !dk.show_cal { return lines }
    for r in dk.long {
        if r.so <= o && r.eo >= o {
            let s = slots[r.id]
            while lines.len() <= s { lines.push(nil) }
            lines[s] = r
        }
    }
    let list = dk.by_day[date]
    if list != nil { for r in list { lines.push(r) } }
    lines
}
fn desk_day_marked(date, o){
    if !dk.show_cal { return false }
    if dk.by_day[date] != nil { return true }
    let hit = false
    for r in dk.long { if r.so <= o && r.eo >= o { hit = true } }
    hit
}
fn desk_row_by_id(id){
    let hit = nil
    for r in dk.rows { if r.id == id { hit = r } }
    hit
}
// All of the store, a page at a time. A later page starts two days before the last
// event of the one before, since the service compares on the device's clock and an
// event's own zone may differ, and repeats are dropped.
fn desk_load(){
    let now = time_now()
    if dk.loading && now - dk.load_at < 10 {
        dk.reload = true
        return
    }
    dk.loading = true
    dk.load_at = now
    dk.reload = false
    dk.gen = dk.gen + 1
    desk_page(dk.gen, "", [], {})
}
fn desk_read_done(){
    dk.loading = false
    if dk.reload { desk_load() }
}
fn desk_page(gen, from, acc, seen){
    host.request("calendar.events", {from: from limit: 200}, fn(r){
        if gen != dk.gen { return }
        if !r.is_ok {
            dk.loading = false
            desk_failed(r.error)
            return
        }
        let page = r.data.events
        if from == "" && page.len() < 200 {
            desk_loaded(page)
            desk_read_done()
            return
        }
        let fresh = 0
        for e in page {
            if seen[e.id] == nil {
                seen[e.id] = true
                acc.push(e)
                fresh = fresh + 1
            }
        }
        if page.len() == 200 && fresh > 0 {
            let last = page[199].start.split("T")[0]
            desk_page(gen, cal_date_of(cal_ord_of(last) - 2), acc, seen)
        } else {
            desk_loaded(acc)
            desk_read_done()
        }
    })
}
fn desk_failed(why){
    if dk.failed == why { return }
    dk.failed = why
    desk_show()
}
fn desk_loaded(list){
    let sig = list.to_json()
    let first = !dk.ready
    let was_failed = dk.failed != ""
    dk.failed = ""
    dk.ready = true
    if sig == dk.sig && !first && !was_failed {
        if dk.fresh != nil { desk_open_fresh() }
        if dk.want != "" { desk_focus(dk.want) }
        return
    }
    dk.sig = sig
    dk.all = list
    desk_index(list)
    // The selected event may have changed or gone.
    if dk.sel != "" {
        dk.sel_row = desk_row_by_id(dk.sel)
        if dk.sel_row == nil { dk.sel = "" }
    }
    if first || was_failed { desk_show() }
    desk_draw_all()
    if dk.search != "" { desk_find() }
    desk_follow_popover()
    desk_steps_read()
    if dk.fresh != nil { desk_open_fresh() }
    if dk.want != "" { desk_focus(dk.want) }
}
// What the service still answers for: a route from a Glance card. Today is the
// device's own date, as the menu bar's clock has it.
fn desk_today(){
    let t = local_time()
    cal_date(t.year, t.month, t.day)
}
fn desk_view_poll(){
    let editing = dk.pop != nil && dk.pop.mode == "edit"
    host.request("calendar.view", {month: "" day: dk.day direction: 0 take_focus: !editing}, fn(r){
        if !r.is_ok { desk_failed(r.error); return }
        if r.data.focused != nil && !editing { desk_focus(r.data.focused.id) }
    })
}
fn desk_boot(){
    dk.today = desk_today()
    if dk.day == "" { desk_jump(dk.today) }
    desk_show()
    ui.segs.render()
    ui.nav_box.render()
    ui.cal_box.render()
    if dk.booted && dk.ready {
        desk_draw_all()
        if dk.search != "" { ui.results.render() }
    }
    if dk.booted && dk.pop != nil {
        ui.pop_host.render()
        ui.pop_layer.set_visible(true)
    }
    if dk.booted && dk.menu != nil {
        ui.menu_host.render()
        ui.menu_layer.set_visible(true)
    }
    if dk.booted && dk.zone_find != nil {
        ui.zone_search.set_text(dk.zone_find.q)
        ui.zone_rows.render()
        ui.zone_layer.set_visible(true)
    }
    desk_sync_failed_action()
    dk.booted = true
    ui.cal_keys.focus()
    desk_view_poll()
    // A switch of appearance may have left a read's answer nowhere to go.
    dk.loading = false
    desk_load()
}
fn desk_poll(){
    if dk.busy || dk.day == "" { return }
    let today = desk_today()
    if today != dk.today {
        dk.today = today
        desk_draw_all()
    }
    desk_view_poll()
    desk_load()
    if dk.view == "week" || dk.view == "day" {
        let t = local_time()
        let mins = t.hour * 60 + t.minute
        if mins != dk.now_min {
            let was_on = desk_now_on()
            dk.now_min = mins
            if was_on || desk_now_on() {
                desk_draw_cols()
                let near = desk_near_hour()
                if near != dk.near_hour {
                    dk.near_hour = near
                    ui.wk_lines.render()
                }
            }
        }
    }
}

// ---- the window ---------------------------------------------------------------
fn desk_side_on(){
    if dk.side_user != nil { return dk.side_user }
    dk.w >= 860
}
fn desk_main_w(){
    let w = dk.w
    if desk_side_on() { w = w - cal_side_w }
    if dk.search != "" { w = w - cal_found_w }
    if desk_info_on() { w = w - cal_info_w }
    w
}
// A Mac's Day view keeps a column on its right for the month and the chosen event, as
// Calendar's does, while the day keeps room beside it; search results take that place.
fn desk_info_on(){
    if !ui_unified || dk.view != "day" || dk.search != "" || !dk.ready || dk.failed != "" { return false }
    let w = dk.w
    if desk_side_on() { w = w - cal_side_w }
    w - cal_info_w >= 380
}
fn desk_side_x(){ if desk_side_on() { cal_side_w } else { 0 } }
fn desk_grid_top(){ cal_bar_h + 1 + cal_head_h + cal_days_h + 1 }
fn desk_cell_w(){ (desk_main_w() - 6) / 7 }
fn desk_cell_h(){ (dk.h - desk_grid_top() - (dk.grid_weeks - 1)) / dk.grid_weeks }
fn desk_show(){
    let fine = dk.ready && dk.failed == ""
    ui.load_pane.set_visible(!dk.ready && dk.failed == "")
    ui.fail_pane.set_visible(dk.failed != "")
    ui.head_pane.set_visible(fine)
    ui.month_pane.set_visible(fine && dk.view == "month")
    ui.week_pane.set_visible(fine && (dk.view == "week" || dk.view == "day"))
    ui.year_pane.set_visible(fine && dk.view == "year")
    ui.found_wrap.set_visible(dk.search != "")
    ui.day_info_wrap.set_visible(desk_info_on())
    let side = desk_side_on()
    ui.side_wrap.set_visible(side)
    ui.lights_room.set_visible(ui_unified && !side)
    ui.search_x.set_visible(dk.search != "")
}
fn on_app_resize(width, height){
    if !ui_desk { return }
    if width == dk.w && height == dk.h { return }
    dk.w = width
    dk.h = height
    // Called every frame of the opening animation and of a drag: the grid's rows and
    // columns follow by themselves, and what depends on the size waits for it to settle.
    dk.size_gen = dk.size_gen + 1
    let gen = dk.size_gen
    start_timeout(0.12, || { if gen == dk.size_gen && dk.booted { desk_settled() } })
}
fn desk_settled(){
    desk_show()
    if dk.ready { desk_draw_main() }
    if dk.menu != nil { desk_close_menu() }
    if dk.pop != nil { desk_keep_popover_in() }
}
fn desk_toggle_side(){
    dk.side_user = !desk_side_on()
    desk_show()
    if dk.ready { desk_draw_main() }
}

// ---- moving around -------------------------------------------------------------
fn desk_jump(date){
    dk.day = date
    let p = cal_parts(date)
    dk.y = p.y
    dk.m = p.m
    dk.mini_y = p.y
    dk.mini_m = p.m
}
fn desk_goto(date){
    desk_jump(date)
    dk.sel = ""
    dk.sel_row = nil
    desk_draw_all()
}
fn desk_nav(by){
    if dk.view == "month" {
        let n = cal_month_add(dk.y, dk.m, by)
        let t = cal_parts(dk.today)
        if t.y == n.y && t.m == n.m { desk_goto(dk.today) } else { desk_goto(cal_date(n.y, n.m, 1)) }
    } else if dk.view == "week" {
        desk_goto(cal_date_of(cal_ord_of(dk.day) + by * 7))
    } else if dk.view == "day" {
        desk_goto(cal_date_of(cal_ord_of(dk.day) + by))
    } else {
        let p = cal_parts(dk.day)
        let y = p.y + by
        desk_goto(cal_date(y, p.m, min(p.d, cal_days_in(y, p.m))))
    }
}
fn desk_set_view(v){
    if dk.view == v { return }
    dk.view = v
    desk_jump(dk.day)
    ui.segs.render()
    desk_show()
    desk_draw_head()
    desk_draw_main()
    desk_draw_mini()
}
fn desk_show_day(date){
    dk.view = "day"
    desk_jump(date)
    ui.segs.render()
    desk_show()
    desk_draw_all()
}
// A GestureView reads every press, also one that a popover over it has claimed, and a
// click away from a popover closes it and is spent. So what lies under an open popover
// or pop-up leaves the press alone.
fn desk_add_problem(){ try { dk.add_failure } catch { nil } }
// Retained key handlers can hold an older state after a restyle. The visible
// sheet is the shared source of truth for shielding its underlying calendar.
fn desk_failure_visible(){ try { ui.add_fail_layer.is_visible() } catch { false } }
// Menu hooks run while the host has borrowed the root view, so they cannot
// query a widget. Their state guard stays independent of the visible-layer
// check used by the keyboard handler below.
fn desk_covered(){ dk.pop != nil || dk.menu != nil || desk_add_problem() != nil || time_now() - dk.shut_at < 0.1 }
// The keyboard, as in Calendar on a Mac: plain arrows move the day, Tab the event.
fn desk_move_day(by){
    let date = cal_date_of(cal_ord_of(dk.day) + by)
    let a = cal_parts(dk.day)
    let b = cal_parts(date)
    if (dk.view == "month" && a.y == b.y && a.m == b.m) || (dk.view == "year" && a.y == b.y) {
        let old_day = dk.day
        let old_row = dk.sel_row
        dk.day = date
        dk.sel = ""
        dk.sel_row = nil
        desk_selection_moved(old_day, old_row)
    } else {
        desk_goto(date)
    }
}
fn desk_next_event(by){
    let rows = desk_agenda_rows()
    if rows.len() == 0 { return }
    let at = -1
    for i r in rows {
        if r.id == dk.sel { at = i }
    }
    let to = if at >= 0 { (at + by + rows.len()) % rows.len() } else if by > 0 { 0 } else { rows.len() - 1 }
    let old_row = dk.sel_row
    dk.sel = rows[to].id
    dk.sel_row = rows[to]
    desk_selection_moved(dk.day, old_row)
}
fn desk_key(key, cmd, shift){
    // The sheet's default and cancel buttons handle Return and Escape.
    if desk_failure_visible() { return }
    if desk_add_problem() != nil {
        if key == "Escape" { desk_cancel_failed_add() }
        return
    }
    // A sheet's default button can close it before this handler sees the
    // same Return key. Do not open the selected event with that key too.
    if key == "ReturnKey" && time_now() - dk.shut_at < 0.1 { return }
    if dk.zone_find != nil {
        if key == "Escape" { desk_zone_close() }
        return
    }
    if dk.menu != nil {
        if key == "Escape" { desk_close_menu() }
        return
    }
    if dk.pop != nil {
        // Escape closes the popover, as a click away does; what it holds is saved first.
        if key == "Escape" { if dk.pop.mode == "delete" { desk_keep() } else { desk_done() } }
        return
    }
    if time_now() - dk.shut_at < 0.1 { return }
    let event = dk.sel_row
    if cmd {
        if key == "KeyN" { desk_new_event(dk.day, 540, desk_from_tool()) }
        else if key == "KeyT" { desk_goto(dk.today) }
        else if key == "KeyF" { ui.search.focus() }
        else if key == "KeyI" { if event != nil { desk_open_event(event, dk.day, desk_from_event(event, dk.day)) } }
        // A Mac's menu bar takes these first; another desktop's style sends them here.
        else if key == "KeyC" { if event != nil { desk_copy(event) } }
        else if key == "KeyX" { if event != nil { desk_cut(event) } }
        else if key == "KeyV" { desk_paste(dk.day, -1) }
        else if key == "KeyD" { if event != nil { desk_duplicate(event) } }
        else if key == "KeyZ" { if shift { desk_redo() } else { desk_undo() } }
        else if key == "ArrowLeft" { desk_nav(-1) }
        else if key == "ArrowRight" { desk_nav(1) }
        else if key == "Key1" { desk_set_view("day") }
        else if key == "Key2" { desk_set_view("week") }
        else if key == "Key3" { desk_set_view("month") }
        else if key == "Key4" { desk_set_view("year") }
        return
    }
    if key == "ArrowLeft" { desk_move_day(-1) }
    else if key == "ArrowRight" { desk_move_day(1) }
    else if key == "ArrowUp" { desk_move_day(-7) }
    else if key == "ArrowDown" { desk_move_day(7) }
    else if key == "Tab" { desk_next_event(if shift { -1 } else { 1 }) }
    else if key == "ReturnKey" { if event != nil { desk_open_event(event, dk.day, desk_from_event(event, dk.day)) } }
    else if key == "Backspace" || key == "Delete" { if event != nil { desk_delete_of(event, dk.day) } }
    else if key == "Escape" {
        if event != nil {
            dk.sel = ""
            dk.sel_row = nil
            desk_selection_moved(dk.day, event)
        }
    }
}
// A Mac's menu bar asks for these while Calendar is in front.
fn app_menus(){
    let free = !desk_covered()
    let event = free && dk.sel_row != nil
    [
        {menu: "File" title: "New Event" key: "cmd+N" command: "new" enabled: free}
        {menu: "File" title: "Get Info" key: "cmd+I" command: "info" enabled: event}
        // Undo, Redo, Cut, Copy and Paste stand in for the text ones while no field has the keyboard.
        {menu: "Edit" title: "Undo" key: "cmd+Z" command: "undo" enabled: free && !dk.busy && desk_can_undo()}
        {menu: "Edit" title: "Redo" key: "shift+cmd+Z" command: "redo" enabled: free && !dk.busy && dk.redo.len() > 0}
        {menu: "Edit" title: "Cut" key: "cmd+X" command: "cut" enabled: event}
        {menu: "Edit" title: "Copy" key: "cmd+C" command: "copy" enabled: event}
        {menu: "Edit" title: "Paste" key: "cmd+V" command: "paste" enabled: free && dk.clip != nil}
        {menu: "Edit" title: "Duplicate" key: "cmd+D" command: "duplicate" enabled: event}
        {menu: "Edit" title: if ui_unified { "Delete" } else { "Delete Event…" } command: "delete" enabled: event}
        {menu: "Edit"}
        {menu: "Edit" title: "Find…" key: "cmd+F" command: "find" enabled: free}
        {menu: "View" title: "Day" key: "cmd+1" command: "day" checked: dk.view == "day" enabled: free}
        {menu: "View" title: "Week" key: "cmd+2" command: "week" checked: dk.view == "week" enabled: free}
        {menu: "View" title: "Month" key: "cmd+3" command: "month" checked: dk.view == "month" enabled: free}
        {menu: "View" title: "Year" key: "cmd+4" command: "year" checked: dk.view == "year" enabled: free}
        {menu: "View"}
        {menu: "View" title: "Go to Today" key: "cmd+T" command: "today" enabled: free}
        {menu: "View" title: "Next" key: "cmd+right" command: "next" enabled: free}
        {menu: "View" title: "Previous" key: "cmd+left" command: "previous" enabled: free}
        {menu: "View"}
        {menu: "View" title: if desk_side_on() { "Hide Calendar List" } else { "Show Calendar List" } key: "ctrl+cmd+S" command: "sidebar" enabled: free}
    ]
}
fn on_menu_command(command){
    if desk_covered() { return }
    let event = dk.sel_row
    if command == "new" { desk_new_event(dk.day, 540, desk_from_tool()) }
    else if command == "info" { if event != nil { desk_open_event(event, dk.day, desk_from_event(event, dk.day)) } }
    else if command == "find" { ui.search.focus() }
    else if command == "cut" { if event != nil { desk_cut(event) } }
    else if command == "copy" { if event != nil { desk_copy(event) } }
    else if command == "paste" { desk_paste(dk.day, -1) }
    else if command == "duplicate" { if event != nil { desk_duplicate(event) } }
    else if command == "undo" { desk_undo() }
    else if command == "redo" { desk_redo() }
    else if command == "delete" { if event != nil { desk_delete_of(event, dk.day) } }
    else if command == "today" { desk_goto(dk.today) }
    else if command == "next" { desk_nav(1) }
    else if command == "previous" { desk_nav(-1) }
    else if command == "sidebar" { desk_toggle_side() }
    else { desk_set_view(command) }
}
// What a right click on an event offers, as Calendar's does: its commands, the calendar it
// is in (ticked), and Glance. Paste is there once something has been copied.
// A Mac's Delete asks nothing (Undo puts the event back), so it has no ellipsis.
let cal_delete_row = if ui_unified { "Delete" } else { "Delete…" }
let cal_event_menu = ["Get Info", "-", "Cut", "Copy", "Duplicate", "-", cal_delete_row, "-", "My Calendar", "-", "Show in Glance"]
let cal_event_menu_paste = ["Get Info", "-", "Cut", "Copy", "Paste", "Duplicate", "-", cal_delete_row, "-", "My Calendar", "-", "Show in Glance"]
fn desk_event_menu_rows(){ if dk.clip == nil { cal_event_menu } else { cal_event_menu_paste } }
// And on a day, or an hour of one.
let cal_day_menu = ["New Event", "New All-Day Event"]
let cal_day_menu_paste = ["New Event", "New All-Day Event", "-", "Paste"]
fn desk_day_menu_rows(){ if dk.clip == nil { cal_day_menu } else { cal_day_menu_paste } }
fn desk_event_menu(r, date, from, title){
    if desk_covered() { return }
    if title == "Get Info" { desk_open_event(r, date, from) }
    else if title == "Cut" { desk_select(r, date); desk_cut(r) }
    else if title == "Copy" { desk_select(r, date); desk_copy(r) }
    else if title == "Paste" { desk_paste(date, -1) }
    else if title == "Duplicate" { desk_duplicate(r) }
    else if title == cal_delete_row { desk_delete_of(r, date) }
    else if title == "Show in Glance" {
        // Its result is said on the event, so the event opens.
        desk_open_event(r, date, from)
        desk_glance()
    }
}
fn desk_day_menu(date, mins, from, title){
    if desk_covered() { return }
    if title == "New Event" { desk_new_event(date, if mins >= 0 { mins } else { 540 }, from) }
    else if title == "New All-Day Event" { desk_new_event_as(date, 540, from, true) }
    else if title == "Paste" { desk_paste(date, mins) }
}

// ---- Cut, Copy, Paste and Duplicate -------------------------------------------------------------
// What is copied is the event's own fields. A paste puts them on a day, at the copy's own time
// or at the hour it was asked for, and keeps its length; the Mac's clipboard gets its words.
fn cal_text(v){ if v == nil { "" } else { "" + v } }
fn desk_clip_of(r){
    let zone = try { r.raw.timezone } catch { "" }
    {title: r.title start: r.raw.start end: cal_text(r.raw.end) location: cal_text(r.raw.location) notes: cal_text(r.raw.notes)
        timezone: cal_text(zone) sd: r.sd sm: r.sm em: r.em all: r.all multi: r.multi}
}
fn desk_clip_words(r){
    let out = r.title + "\n" + cal_day_long[cal_weekday(cal_ord_of(r.sd))] + ", " + cal_long(r.sd) + ", " + desk_agenda_when(r, r.sd)
    if cal_text(r.raw.location) != "" { out = out + "\n" + r.raw.location }
    if cal_text(r.raw.notes) != "" { out = out + "\n\n" + r.raw.notes }
    out
}
fn desk_copy(r){
    if desk_covered() { return }
    let first = dk.clip == nil
    dk.clip = desk_clip_of(r)
    host.request("clipboard.write", {text: desk_clip_words(r)}, fn(answer){})
    // The menus offer Paste from now on.
    if first && dk.ready {
        desk_draw_all()
        if dk.search != "" { ui.results.render() }
    }
}
fn desk_cut(r){
    if desk_covered() || dk.busy { return }
    desk_cut_step(r)
}
fn desk_cut_step(r){
    if dk.busy { return }
    let copied = desk_clip_of(r)
    host.request("clipboard.write", {text: desk_clip_words(r)}, fn(answer){})
    dk.busy = true
    host.request("calendar.remove_event", {id: r.id expected: r.raw}, fn(answer){
        dk.busy = false
        if !answer.is_ok {
            if answer.error == "This event changed elsewhere. Reload before deleting it." {
                dk.sig = ""
                desk_load()
                desk_add_failed({kind: "cut-changed"})
            } else {
                desk_add_failed({kind: "cut" event: r})
            }
            return
        }
        // A refused remove is not a cut: keep the previous internal clipboard
        // until the original event has actually been removed.
        dk.clip = copied
        // On a Mac, Undo puts a cut event back as it was (see desk_delete_of). Elsewhere Paste
        // brings it back as a new one, and Undo can't.
        if ui_unified { desk_push_step({kind: "delete" id: r.id a: nil b: nil ev: r.raw}) } else { desk_no_undo() }
        if dk.sel == r.id {
            dk.sel = ""
            dk.sel_row = nil
        }
        dk.sig = ""
        desk_load()
    })
}
fn cal_shift(stamp, by){
    if stamp == "" { return "" }
    let p = stamp.split("T")
    let day = cal_date_of(cal_ord_of(p[0]) + by)
    if p.len() > 1 { day + "T" + p[1] } else { day }
}
fn desk_paste(date, mins){
    let c = dk.clip
    if c == nil || desk_covered() || dk.busy { return }
    let by = cal_ord_of(date) - cal_ord_of(c.sd)
    let start = cal_shift(c.start, by)
    let end = cal_shift(c.end, by)
    if mins >= 0 && !c.all && !c.multi {
        start = cal_stamp(date, mins)
        end = if c.em >= 0 { cal_stamp(date, min(1439, mins + c.em - c.sm)) } else { "" }
    }
    desk_add_copy(c, start, end)
}
// A copy at the same time on the same day, selected, as on a Mac.
fn desk_duplicate(r){
    if desk_covered() || dk.busy { return }
    let c = desk_clip_of(r)
    desk_add_copy(c, c.start, c.end)
}
fn desk_add_copy(c, start, end){
    dk.busy = true
    let intent = {kind: "copy" event: c start: start end: end}
    host.request("calendar.add_event", {title: c.title start: start end: end timezone: c.timezone location: c.location notes: c.notes}, fn(answer){
        dk.busy = false
        if !answer.is_ok { desk_add_failed(intent) return }
        desk_push_step({kind: "add" id: answer.data.id a: nil b: nil ev: nil})
        dk.sel = answer.data.id
        dk.sel_row = nil
        dk.day = start.split("T")[0]
        dk.sig = ""
        desk_load()
    })
}
// A click selects, and a second click on the same thing opens it, as on a Mac. The
// second click lands on what the first one redrew, so the time decides.
fn desk_event_tap(r, date, from){
    if desk_covered() { return }
    ui.cal_keys.focus()
    let now = time_now()
    let again = dk.tap_id == r.id && now - dk.tap_at < 0.45
    dk.tap_id = r.id
    dk.tap_at = now
    dk.tap_date = ""
    if again {
        dk.tap_id = ""
        desk_open_event(r, date, from)
    } else if dk.sel != r.id || dk.day != date {
        let old_day = dk.day
        let old_row = dk.sel_row
        dk.sel = r.id
        dk.sel_row = r
        dk.day = date
        desk_selection_moved(old_day, old_row)
        dk.tap_at = time_now()
    }
}
fn desk_day_tap(date, then_new){
    if desk_covered() { return }
    ui.cal_keys.focus()
    let now = time_now()
    let again = dk.tap_date == date && now - dk.tap_at < 0.45
    dk.tap_date = date
    dk.tap_at = now
    dk.tap_id = ""
    if again {
        dk.tap_date = ""
        then_new()
    } else if dk.sel != "" || dk.day != date {
        let old_day = dk.day
        let old_row = dk.sel_row
        dk.day = date
        dk.sel = ""
        dk.sel_row = nil
        desk_selection_moved(old_day, old_row)
        dk.tap_at = time_now()
    }
}
fn desk_mark_dirty(dirty, o){
    let i = floor((o - dk.grid_start) / 7)
    if i >= 0 && i < 6 { dirty[i] = true }
}
fn desk_mark_row(dirty, r){
    if r == nil { return }
    if r.multi {
        let o = r.so
        while o <= r.eo {
            desk_mark_dirty(dirty, o)
            o = o + 7
        }
        desk_mark_dirty(dirty, r.eo)
    } else {
        desk_mark_dirty(dirty, cal_ord_of(r.sd))
    }
}
fn desk_draw_rows(dirty){
    for i d in dirty { if d { desk_draw_week_row(i) } }
}
fn desk_selection_moved(old_day, old_row){
    if dk.view == "month" {
        let dirty = [false false false false false false]
        desk_mark_dirty(dirty, cal_ord_of(old_day))
        desk_mark_dirty(dirty, cal_ord_of(dk.day))
        desk_mark_row(dirty, old_row)
        desk_mark_row(dirty, dk.sel_row)
        desk_draw_rows(dirty)
    } else if dk.view == "year" {
        desk_draw_year()
    } else {
        desk_draw_cols()
        ui.wk_head.render()
        ui.wk_all.render()
    }
    let p = cal_parts(dk.day)
    dk.mini_y = p.y
    dk.mini_m = p.m
    desk_draw_side()
    if dk.search != "" { ui.results.render() }
}

// ---- drawing --------------------------------------------------------------------
fn desk_draw_all(){
    desk_draw_head()
    desk_draw_main()
    desk_draw_side()
}
fn desk_draw_side(){
    if !ui_unified {
        ui.day_title.set_text(cal_side_day(dk.day))
        ui.events.render()
    }
    desk_draw_mini()
}
fn desk_draw_mini(){
    ui.mini_title.set_text(cal_month_names[dk.mini_m - 1] + " " + dk.mini_y)
    ui.mini.render()
    desk_draw_info()
}
fn desk_draw_info(){
    if desk_info_on() { ui.day_info.render() }
}
// The Day view's column: the month on top, as the sidebar's (its day picks the day), then the
// chosen event's details, or that none is chosen.
fn desk_day_info(){
    let r = if dk.sel != "" { desk_row_by_id(dk.sel) } else { nil }
    let o = cal_ord_of(dk.day)
    let shown = r != nil && cal_ord_of(r.sd) <= o && o <= cal_ord_of(r.ed)
    View{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
            View{width: Fill height: 24 flow: Right align: Align{y: 0.5} padding: Inset{left: 6}
                info_month := Label{clip_y: false padding: 0 text: cal_month_names[dk.mini_m - 1] + " " + dk.mini_y draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75}}}
                View{width: Fill height: 1}
                CalMiniTool{draw_icon +: {svg: ui_icon("chevron-left")} on_click: || desk_mini_nav(-1)}
                CalMiniTool{draw_icon +: {svg: ui_icon("chevron-right")} on_click: || desk_mini_nav(1)}
            }
            info_grid := View{width: 231 height: Fit flow: Flow.Right{wrap: true} new_batch: true on_item_tap: |i| desk_mini_tap(i)
                for name in cal_heads_letter {
                    View{width: 33 height: 20 align: Align{x: 0.5 y: 0.5} CalSmallNum{text: name draw_text +: {color: ui_muted}}}
                }
                for c in desk_mini_cells() { desk_info_cell(c, c.m == dk.mini_m) }
            }
        }
        UiSep{}
        if shown { desk_info_event(r) }
        if !shown {
            View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} padding: 16
                info_none := Label{clip_y: false padding: 0 width: Fill align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: "No Event Selected"
                    draw_text +: {color: cal_none_ink text_style: theme.font_regular{font_size: 13.5 line_spacing: 1.2}}}
            }
        }
    }
}
// A day of the column's month: today's red disc, the chosen day's grey one, a dot under a day
// with events. (The sidebar's own month names its chosen day: this one doesn't.)
fn desk_info_cell(c, in_month){
    let marked = desk_day_marked(c.date, c.o)
    View{width: 33 height: 24 flow: Overlay align: Align{x: 0.5 y: 0.5}
        if c.date == dk.today {
            CalSmallDisc{draw_bg +: {color: cal_today_mark}
                CalSmallNum{text: "" + c.d draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 8.25}}}
            }
        } else if c.date == dk.day {
            CalSmallDisc{draw_bg +: {color: cal_small_mark}
                CalSmallNum{text: "" + c.d draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 8.25}}}
            }
        } else if in_month {
            CalSmallNum{text: "" + c.d}
        } else {
            CalSmallNum{text: "" + c.d draw_text +: {color: cal_out}}
        }
        if marked {
            View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0}
                RoundedView{width: 3 height: 3 show_bg: true draw_bg +: {color: if c.date == dk.today || c.date == dk.day { #x00000000 } else { ui_muted } border_radius: 1.5}}
            }
        }
    }
}
// The chosen event, as its popover says it: its title and place, when, its time zone, its notes.
// A double click on it in the day opens its popover to change them.
fn desk_info_event(r){
    let v = desk_vals(r)
    ScrollYView{width: Fill height: Fill flow: Down
        View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{left: 20 right: 16 top: 14 bottom: 14}
            View{width: Fill height: Fit flow: Right spacing: 8
                info_title := Label{clip_y: false width: Fill padding: 0 flow: Flow.Right{wrap: true} text: v.title draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 12.75 line_spacing: 1.2}}}
                RoundedView{width: 10 height: 10 margin: Inset{top: 4} show_bg: true draw_bg +: {color: ui_link border_radius: 2.5}}
            }
            if v.place != "" {
                Label{clip_y: false width: Fill padding: 0 flow: Flow.Right{wrap: true} text: v.place draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.3}}}
            }
            UiSep{margin: Inset{top: 4 bottom: 4}}
            info_when := Label{clip_y: false width: Fill padding: 0 flow: Flow.Right{wrap: true} text: desk_when_line(v) draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.3}}}
            if v.notes != "" {
                UiSep{margin: Inset{top: 4 bottom: 4}}
                Label{clip_y: false width: Fill padding: 0 flow: Flow.Right{wrap: true} text: v.notes draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.3}}}
            }
        }
    }
}
fn desk_draw_head(){
    if dk.view == "month" {
        ui.month_title.set_text(cal_month_names[dk.m - 1])
        ui.year_title.set_text("" + dk.y)
    } else if dk.view == "year" {
        ui.month_title.set_text("" + dk.y)
        ui.year_title.set_text("")
    } else if dk.view == "day" {
        ui.month_title.set_text(cal_day_long[cal_weekday(cal_ord_of(dk.day))])
        ui.year_title.set_text(cal_long(dk.day))
    } else {
        let start = cal_ord_of(dk.day) - cal_col(cal_ord_of(dk.day))
        let a = cal_civil(start)
        let b = cal_civil(start + 6)
        if a.m == b.m {
            ui.month_title.set_text(cal_month_names[a.m - 1])
            ui.year_title.set_text("" + a.y)
        } else if a.y == b.y {
            ui.month_title.set_text(cal_month_short[a.m - 1] + " – " + cal_month_short[b.m - 1])
            ui.year_title.set_text("" + a.y)
        } else {
            ui.month_title.set_text(cal_month_short[a.m - 1] + " " + a.y + " – " + cal_month_short[b.m - 1])
            ui.year_title.set_text("" + b.y)
        }
    }
}
fn desk_draw_main(){
    if dk.view == "month" { desk_draw_month() }
    else if dk.view == "year" { desk_draw_year() }
    else { desk_draw_week() }
    desk_draw_info()
}
fn desk_draw_month(){
    let first = cal_ord(dk.y, dk.m, 1)
    let offset = cal_col(first)
    dk.grid_start = first - offset
    dk.grid_weeks = floor((offset + cal_days_in(dk.y, dk.m) + 6) / 7)
    ui.w4_wrap.set_visible(dk.grid_weeks > 4)
    ui.w5_wrap.set_visible(dk.grid_weeks > 5)
    ui.w0.render()
    ui.w1.render()
    ui.w2.render()
    ui.w3.render()
    if dk.grid_weeks > 4 { ui.w4.render() }
    if dk.grid_weeks > 5 { ui.w5.render() }
}
fn desk_draw_week_row(i){
    if i == 0 { ui.w0.render() }
    else if i == 1 { ui.w1.render() }
    else if i == 2 { ui.w2.render() }
    else if i == 3 { ui.w3.render() }
    else if i == 4 && dk.grid_weeks > 4 { ui.w4.render() }
    else if i == 5 && dk.grid_weeks > 5 { ui.w5.render() }
}
// One week of the month's cells.
fn desk_cells(w){
    let out = []
    let cap = max(1, floor((desk_cell_h() - 28) / 18))
    let wide = desk_cell_w() >= 118
    let o = dk.grid_start + w * 7
    let slots = desk_slots(o, 7)
    let i = 0
    while i < 7 {
        let c = cal_civil(o)
        out.push({o: o y: c.y m: c.m d: c.d date: cal_date(c.y, c.m, c.d) col: i cap: cap wide: wide slots: slots})
        o = o + 1
        i = i + 1
    }
    out
}
fn desk_cell_tap(w, col){
    let o = dk.grid_start + w * 7 + col
    let date = cal_date_of(o)
    desk_day_tap(date, || desk_new_event(date, 540, desk_from_cell(o)))
}
// Where a popover opens: beside the thing it is about.
fn desk_from_cell(o){ desk_from_line(o, 0) }
// A line of a cell: the number's 24 and a little above it, then a chip's 18 each.
fn desk_from_line(o, line){
    let i = o - dk.grid_start
    let row = floor(i / 7)
    let col = i - row * 7
    let cw = desk_cell_w()
    let ch = desk_cell_h()
    let y = desk_grid_top() + row * (ch + 1) + 26 + line * 18
    {x: desk_side_x() + col * (cw + 1) y: y w: cw aim: y + 9 top: y bottom: y + 18}
}
fn desk_from_col(o){
    let i = 0
    let at = 0
    for c in dk.cols {
        if c.o == o { at = i }
        i = i + 1
    }
    let cw = (desk_main_w() - cal_gutter) / max(1, dk.cols.len())
    {x: desk_side_x() + cal_gutter + at * cw y: cal_bar_h + 1 + cal_head_h + 40 w: cw}
}
fn desk_col_w(){ (desk_main_w() - cal_gutter) / max(1, dk.cols.len()) }
// Where the hours start under the day names and the all-day band.
fn desk_hours_top(){
    let band = 24
    for c in dk.cols { band = max(band, 5 + min(3, desk_band_lines(c).len()) * 19) }
    let head = if dk.view == "week" { 26 } else { 0 }
    cal_bar_h + 1 + cal_head_h + head + band + 1
}
// A span of the hours as it is on the screen now, the pane's scroll included: only what
// shows is pointed at.
fn desk_from_span(a, b, x, w){
    let top0 = desk_hours_top()
    let scrolled = try { ui.wk_scroll.scroll_y() } catch { 0 }
    let y = top0 + desk_time_y(a) - scrolled
    let y2 = y + max(18, (b - a) * cal_hour / 60 - 1)
    let shown = max(y, top0)
    let shown_end = min(y2, dk.h)
    if shown_end - shown < 10 { return {x: x y: max(top0, min(dk.h - 40, y)) w: w} }
    {x: x y: shown w: w aim: shown + min(9, (shown_end - shown) / 2) top: shown bottom: shown_end}
}
// Where an event is drawn now: its chip in the month, its block in the hours.
fn desk_from_event(r, date){
    let o = cal_ord_of(date)
    if dk.view == "week" || dk.view == "day" {
        let cw = desk_col_w()
        let hit = nil
        for c in dk.cols {
            if c.o == o {
                for it in c.items {
                    if hit == nil && it.r.id == r.id {
                        let lanes = max(1, min(it.lanes, floor((cw - 4) / desk_lane_min())))
                        let lane_w = (cw - 4) / lanes
                        let lane = min(it.lane, lanes - 1)
                        hit = desk_from_span(it.a, it.b, desk_side_x() + cal_gutter + c.col * cw + 2 + lane * lane_w, lane_w - 1)
                    }
                }
            }
        }
        if hit != nil { return hit }
    }
    if dk.view == "month" {
        let i = o - dk.grid_start
        if i >= 0 && i < dk.grid_weeks * 7 {
            let week = floor(i / 7)
            let lines = desk_cell_lines(o, date, desk_slots(dk.grid_start + week * 7, 7))
            let cap = max(1, floor((desk_cell_h() - 28) / 18))
            let shown = if lines.len() > cap { cap - 1 } else { lines.len() }
            let at = -1
            for k x in lines { if at < 0 && x != nil && x.id == r.id { at = k } }
            if at >= 0 && at < shown { return desk_from_line(o, at) }
        }
    }
    desk_from_day(date)
}
fn desk_from_day(date){
    let o = cal_ord_of(date)
    if dk.view == "month" {
        let i = o - dk.grid_start
        if i >= 0 && i < dk.grid_weeks * 7 { return desk_from_cell(o) }
    }
    if dk.view == "week" || dk.view == "day" { return desk_from_col(o) }
    {x: desk_side_x() y: cal_bar_h + 1 + cal_head_h w: 8}
}
fn desk_from_side(i){
    let first = if ui_unified { 173 } else { 129 }
    let y = first + i * 45
    {x: 0 y: y w: cal_side_w aim: y + 22 top: y bottom: y + 44}
}
fn desk_from_found(i){
    let y = cal_bar_h + 1 + 6 + i * 45
    {x: dk.w - cal_found_w y: y w: 0 aim: y + 22}
}
// The toolbar's +: a popover below it, with its beak on the button.
fn desk_from_tool(){
    let lead = if desk_side_on() { cal_side_w + 12 } else if ui_unified { 84 } else { 12 }
    {x: desk_side_x() + 8 y: cal_bar_h + 8 w: 8 below: lead + 49}
}

// A cell's number: today in its red disc, the selected day in a gray one, and the rest
// of the cell left clear for its events.
fn desk_number(text, date, in_month){
    if date == dk.today {
        CalDisc{draw_bg +: {color: cal_today_mark} CalNum{text: text draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 9.75}}}}
    } else if date == dk.day {
        CalDisc{draw_bg +: {color: cal_day_mark} CalNum{text: text draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75}}}}
    } else if in_month {
        CalNum{text: text}
    } else {
        CalNum{text: text draw_text +: {color: cal_out}}
    }
}
// An event over more than one day is one bar across the week: each day's part runs on
// under the next one's, with the title on its first day and at the start of a week.
// A whole day's event is the same bar on its own.
fn desk_bar_cell_w(){
    if dk.view == "month" { return desk_cell_w() }
    (desk_main_w() - cal_gutter) / max(1, dk.cols.len())
}
fn desk_bar(r, c, last_col, line){
    let on = dk.sel == r.id
    let date = c.date
    let o = c.o
    let title = if r.so == c.o || c.col == 0 || !r.multi { r.title } else { "" }
    let runs_on = r.multi && r.eo > c.o
    // Rounded ends meet over the other part's colour, past the line between the days.
    let left = if r.multi && r.so < c.o { if c.col == 0 { -2 } else { -6 } } else { 0 }
    let right = if runs_on { if c.col == last_col { -2 } else { -11 } } else { 0 }
    let room = if runs_on { 20 } else { 4 }
    // A cell's padding is 2 either side. A negative margin doesn't widen what fills.
    let bar_w = desk_bar_cell_w() - 4 - left - right
    GestureView{width: Fill height: 18 clip_x: false menu: desk_event_menu_rows() menu_current: "My Calendar" on_menu: |title| desk_event_menu(r, date, desk_from_chip(o, date, line), title)
        if on {
            View{width: Fill height: 18 new_batch: true clip_x: false
                CalChipAllOn{width: bar_w margin: Inset{left: left} padding: Inset{left: 5 right: room} text: title on_click: || desk_event_tap(r, date, desk_from_chip(o, date, line))}
            }
        } else {
            CalChipAll{width: bar_w margin: Inset{left: left} padding: Inset{left: 5 right: room} text: title on_click: || desk_event_tap(r, date, desk_from_chip(o, date, line))}
        }
    }
}
fn desk_from_chip(o, date, line){
    if line < 0 || dk.view != "month" { return desk_from_day(date) }
    desk_from_line(o, line)
}
fn desk_chip(r, c, line){
    if r.all || r.multi { return desk_bar(r, c, 6, line) }
    let on = dk.sel == r.id
    let date = c.date
    let o = c.o
    let wide = c.wide
    let when = cal_time_short(r.sm)
    // The title stops short of the time beside it: the time's width at this size and its
    // margin, the few points an ellipsis runs past where a label was told to stop, and a gap.
    let room = if wide { 22 + when.len() * 5.25 } else { 8 }
    GestureView{width: Fill height: 18 menu: desk_event_menu_rows() menu_current: "My Calendar" on_menu: |title| desk_event_menu(r, date, desk_from_line(o, line), title)
        View{width: Fill height: 18 flow: Overlay align: Align{x: 1.0 y: 0.5} new_batch: on
            if on {
                CalChipOn{padding: Inset{left: 4 right: room} text: r.title on_click: || desk_event_tap(r, date, desk_from_line(o, line))}
            } else {
                CalChip{padding: Inset{left: 4 right: room} text: r.title on_click: || desk_event_tap(r, date, desk_from_line(o, line))}
            }
            if wide { CalNote{margin: Inset{right: 4} text: when draw_text +: {color: if on { #xffffff } else { ui_muted }}} }
        }
    }
}
fn desk_cell(c){
    let lines = desk_cell_lines(c.o, c.date, c.slots)
    let n = lines.len()
    let shown = if n > c.cap { c.cap - 1 } else { n }
    let hidden = 0
    for i r in lines { if i >= shown && r != nil { hidden = hidden + 1 } }
    let in_month = c.m == dk.m
    GestureView{width: Fill height: Fill clip_x: false menu: desk_day_menu_rows() on_menu: |title| desk_day_menu(c.date, -1, desk_from_cell(c.o), title)
        SolidView{width: Fill height: Fill flow: Down clip_x: false padding: Inset{left: 2 right: 2 top: 2} draw_bg.color: if cal_weekday(c.o) >= 5 { cal_weekend } else { ui_content }
            View{width: Fill height: 24 flow: Right align: Align{x: 1.0 y: 0.5} spacing: 3 padding: Inset{right: 4}
                if c.d == 1 { CalNum{text: cal_month_short[c.m - 1] draw_text +: {color: if in_month { ui_ink } else { cal_out }}} }
                desk_number("" + c.d, c.date, in_month)
            }
            for i r in lines {
                if i < shown {
                    if r == nil { View{width: Fill height: 18} } else { desk_chip(r, c, i) }
                }
            }
            if hidden > 0 {
                CalMore{padding: Inset{left: if c.wide { 16 } else { 4 } right: if c.wide { 4 } else { 0 }} text: "+" + hidden + " more" on_click: || desk_show_day(c.date)}
            }
        }
    }
}
// A small month (the sidebar's, the Year view's, the date pop-up's): cells of a given
// size, in a wrapping row, so one tap handler reads which was hit.
fn desk_small_cell(c, in_month, w, h, tinted){
    View{width: w height: h flow: Overlay align: Align{x: 0.5 y: 0.5}
        if in_month || !tinted {
            let marked = desk_day_marked(c.date, c.o)
            // The sidebar's month names its chosen day (mini_day): with no day list beside
            // it on a Mac, that disc is where the sidebar says which day is chosen.
            if c.date == dk.today && c.date == dk.day && !tinted {
                CalSmallDisc{draw_bg +: {color: cal_today_mark}
                    mini_day := CalSmallNum{text: "" + c.d draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 8.25}}}
                }
            } else if c.date == dk.today {
                CalSmallDisc{draw_bg +: {color: cal_today_mark}
                    CalSmallNum{text: "" + c.d draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 8.25}}}
                }
            } else if c.date == dk.day && !tinted {
                CalSmallDisc{draw_bg +: {color: cal_small_mark}
                    mini_day := CalSmallNum{text: "" + c.d draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 8.25}}}
                }
            } else if c.date == dk.day {
                CalSmallDisc{draw_bg +: {color: cal_small_mark}
                    CalSmallNum{text: "" + c.d draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 8.25}}}
                }
            } else if marked && tinted {
                CalTintDisc{CalSmallNum{text: "" + c.d}}
            } else if in_month {
                CalSmallNum{text: "" + c.d}
            } else {
                CalSmallNum{text: "" + c.d draw_text +: {color: cal_out}}
            }
            if marked && !tinted {
                View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0}
                    RoundedView{width: 3 height: 3 show_bg: true draw_bg +: {color: if c.date == dk.today || c.date == dk.day { #x00000000 } else { ui_muted } border_radius: 1.5}}
                }
            }
        }
    }
}
fn desk_mini_cells(){
    let out = []
    let first = cal_ord(dk.mini_y, dk.mini_m, 1)
    let o = first - cal_col(first)
    dk.mini_start = o
    let i = 0
    while i < 42 {
        let c = cal_civil(o)
        out.push({o: o d: c.d m: c.m date: cal_date(c.y, c.m, c.d)})
        o = o + 1
        i = i + 1
    }
    out
}
fn desk_mini_tap(i){
    if i < 7 { return }
    ui.cal_keys.focus()
    desk_goto(cal_date_of(dk.mini_start + i - 7))
}
fn desk_mini_nav(by){
    let n = cal_month_add(dk.mini_y, dk.mini_m, by)
    dk.mini_y = n.y
    dk.mini_m = n.m
    desk_draw_mini()
}
fn desk_agenda_when(r, date){
    if r.multi && (r.all || (date != r.sd && date != r.ed)) { return cal_brief(r.sd) + " – " + cal_brief(r.ed) }
    if r.all { return "All day" }
    if r.multi && date == r.sd { return cal_time(r.sm) + " – " + cal_brief(r.ed) }
    if r.multi { return cal_brief(r.sd) + " – " + cal_time(r.em) }
    if r.em < 0 { return cal_time(r.sm) }
    cal_time(r.sm) + " – " + cal_time(r.em)
}
fn desk_agenda_rows(){
    desk_day_rows(dk.day, cal_ord_of(dk.day))
}
fn desk_agenda_row(r, i){
    let on = dk.sel == r.id
    let date = dk.day
    GestureView{width: Fill height: 44 on_tap: |x, y| desk_event_tap(r, date, desk_from_side(i))
        menu: desk_event_menu_rows() menu_current: "My Calendar" on_menu: |title| desk_event_menu(r, date, desk_from_side(i), title)
        RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} spacing: 7 show_bg: true
            draw_bg +: {color: if on { ui_selected } else { #x00000000 } border_radius: 3.0}
            CalSmallDot{}
            View{width: Fill height: Fit flow: Down spacing: 2
                UiRowTitle{text: r.title}
                UiRowNote{text: desk_agenda_when(r, date)}
            }
        }
    }
}

// ---- Week and Day -----------------------------------------------------------------
fn desk_column(o){
    let date = cal_date_of(o)
    let timed = []
    let spanning = []
    let single = []
    let all = []
    for r in desk_day_rows(date, o) {
        // Over a day long, or a day alone: the band above the hours.
        if r.all || (r.multi && r.eo - r.so > 1) { all.push(r) }
        else if r.multi { spanning.push(r) } else { single.push(r) }
    }
    // Both lists come from the service in start-time order. Merge them by their
    // start on this day: an overnight event ending today starts at midnight.
    let i = 0
    let j = 0
    while i < spanning.len() || j < single.len() {
        if j >= single.len() || (i < spanning.len() && desk_start_on(spanning[i], date) <= desk_start_on(single[j], date)) {
            timed.push(spanning[i])
            i = i + 1
        } else {
            timed.push(single[j])
            j = j + 1
        }
    }
    {o: o date: date col: o - dk.band_start all: all items: desk_lanes(timed, date)}
}
fn desk_start_on(r, date){ if r.multi && r.sd != date { 0 } else { r.sm } }
fn desk_band_lines(c){
    let lines = []
    for r in c.all {
        if r.multi {
            let s = dk.band_slots[r.id]
            while lines.len() <= s { lines.push(nil) }
            lines[s] = r
        }
    }
    for r in c.all { if !r.multi { lines.push(r) } }
    lines
}
// A timed event's part of one day, in minutes, and the lanes side by side where they
// overlap.
fn desk_lanes(timed, date){
    let out = []
    let cluster = []
    let ends = []
    let cluster_end = -1
    for r in timed {
        let a = desk_start_on(r, date)
        let b = if r.multi && r.ed != date { 1440 } else { if r.em < 0 { a + 60 } else { r.em } }
        if b < a + 30 { b = a + 30 }
        if cluster.len() > 0 && a >= cluster_end {
            for it in cluster { it.lanes = ends.len() }
            cluster = []
            ends = []
            cluster_end = -1
        }
        let lane = -1
        for i e in ends { if lane < 0 && e <= a { lane = i } }
        if lane < 0 {
            lane = ends.len()
            ends.push(b)
        } else {
            ends[lane] = b
        }
        let it = {r: r a: a b: b lane: lane lanes: 1}
        cluster.push(it)
        out.push(it)
        cluster_end = max(cluster_end, b)
    }
    for it in cluster { it.lanes = ends.len() }
    out
}
fn desk_draw_week(){
    let o = cal_ord_of(dk.day)
    let is_week = dk.view == "week"
    let start = if is_week { o - cal_col(o) } else { o }
    let n = if is_week { 7 } else { 1 }
    let cols = []
    let first = 7
    dk.band_start = start
    let i = 0
    while i < n {
        let c = desk_column(start + i)
        for it in c.items { first = min(first, floor(it.a / 60)) }
        cols.push(c)
        i = i + 1
    }
    dk.cols = cols
    dk.band_slots = desk_slots(start, n)
    let t = local_time()
    dk.now_min = t.hour * 60 + t.minute
    let hours_changed = first != dk.first_hour
    dk.first_hour = first
    dk.near_hour = desk_near_hour()
    ui.wk_head_wrap.set_visible(is_week)
    if is_week { ui.wk_head.render() }
    ui.wk_all.render()
    ui.wk_lines.render()
    ui.c1w.set_visible(is_week)
    ui.c2w.set_visible(is_week)
    ui.c3w.set_visible(is_week)
    ui.c4w.set_visible(is_week)
    ui.c5w.set_visible(is_week)
    ui.c6w.set_visible(is_week)
    desk_draw_cols()
}
fn desk_draw_cols(){
    ui.now_mark.render()
    ui.c0.render()
    if dk.cols.len() > 1 {
        ui.c1.render()
        ui.c2.render()
        ui.c3.render()
        ui.c4.render()
        ui.c5.render()
        ui.c6.render()
    }
}
fn desk_hours(){
    let out = []
    let h = dk.first_hour
    while h < 24 {
        out.push(h)
        h = h + 1
    }
    out
}
fn cal_hour_label(h){
    if h == 12 { return "Noon" }
    cal_time_short(h * 60)
}
fn desk_day_height(){ 8 + (24 - dk.first_hour) * cal_hour + 8 }
fn desk_time_y(mins){ 8 + (mins - dk.first_hour * 60) * cal_hour / 60 }
fn desk_mins_at(y){
    let mins = dk.first_hour * 60 + (y - 8) * 60 / cal_hour
    max(0, min(23 * 60, floor(mins / 30) * 30))
}
// A narrow week column groups the hidden events into connected time spans. Each
// count is the number of events in that span, and opens the wider day view.
fn desk_overflows(items, cw){
    let out = []
    let open = nil
    for it in items {
        let lanes = max(1, min(it.lanes, floor((cw - 4) / desk_lane_min())))
        if it.lanes > lanes && it.lane >= lanes - 1 {
            if open != nil && it.a < open.b && open.lanes == lanes {
                open.b = max(open.b, it.b)
                open.count = open.count + 1
            } else {
                if open != nil { out.push(open) }
                open = {a: it.a b: it.b count: 1 lanes: lanes first: it.r.id}
            }
        }
    }
    if open != nil { out.push(open) }
    out
}
fn desk_more_block(it, c, lane, lane_w){
    let date = c.date
    let h = max(18, (it.b - it.a) * cal_hour / 60 - 1)
    GestureView{width: max(12, lane_w - 1) height: h margin: Inset{left: 2 + lane * lane_w top: desk_time_y(it.a)}
        on_tap: |x, y| desk_open_overflow(date, it.first)
        RoundedView{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: cal_tint border_radius: 2.5}
            Label{clip_y: false padding: 0 max_lines: 1 text: "+" + it.count
                draw_text +: {color: ui_link text_style: theme.font_bold{font_size: 8.25}}}
        }
    }
}
// If even the day is crowded, reveal its scrollable event list at the first
// hidden event instead of leaving the count as a dead end.
fn desk_open_overflow(date, first){
    let from_day = dk.view == "day"
    if from_day { dk.side_user = true }
    desk_show_day(date)
    if from_day {
        let at = 0
        for i r in desk_day_rows(date, cal_ord_of(date)) { if r.id == first { at = i } }
        start_timeout(0.1, || {
            if !ui_unified && dk.view == "day" && dk.day == date { ui.events_scroll.set_scroll_y(max(0, at * 45 - 45)) }
        })
    }
}
// How many lines words take at about `per` points a letter, a word longer than the line
// broken where it must be.
fn cal_rows_of(text, width, per){
    if width < per { return 99 }
    let rows = 1
    let x = 0
    for word in text.split(" ") {
        let w = word.len() * per
        if x > 0 && x + per * 0.5 + w <= width {
            x = x + per * 0.5 + w
        } else {
            if x > 0 { rows = rows + 1 }
            while w > width {
                rows = rows + 1
                w = w - width
            }
            x = w
        }
    }
    rows
}
// The letters in a title's longest word.
fn cal_longest_word(text){
    let most = 0
    for word in text.split(" ") {
        most = max(most, word.len())
    }
    most
}
fn desk_block(it, c, cw){
    let r = it.r
    let on = dk.sel == r.id
    let lanes = max(1, min(it.lanes, floor((cw - 4) / desk_lane_min())))
    let lane_w = (cw - 4) / lanes
    if it.lanes > lanes && it.lane >= lanes - 1 { return View{width: 0 height: 0} }
    let h = max(18, (it.b - it.a) * cal_hour / 60 - 1)
    let date = c.date
    let lane_x = desk_side_x() + cal_gutter + c.col * cw + 2 + it.lane * lane_w
    let one_line = h < 34
    let thin = lane_w < 34
    let pads = if thin { 3 } else { 7 }
    let room = lane_w - 4 - pads
    let when = cal_time_short(it.a)
    let rows = max(1, floor((h - 6) / 13))
    // A title wraps at its words, and its time goes under them when there is a line. One with a
    // word wider than its strip keeps to one line and ends in an ellipsis, as a Mac's grid does:
    // no word is broken.
    // A Mac's thin strip (events side by side at one hour) shows the start of its title instead,
    // broken where it must be and cut at the strip's foot, as Calendar does: never an ellipsis
    // alone.
    let breaks = ui_unified && thin
    let wraps = breaks || (!one_line && cal_longest_word(r.title) * 6.4 <= room)
    let words = if wraps { cal_rows_of(r.title, room, 6.4) } else { 1 }
    let hugs = one_line && r.title.len() * 6.5 + when.len() * 5.25 + 24 < lane_w
    let timed = if one_line { lane_w > 110 } else { !thin && when.len() * 6.2 <= room && words < rows }
    let most = if breaks { if one_line { 1 } else { rows } } else if !wraps { 1 } else if timed { rows - 1 } else { rows }
    GestureView{width: max(12, lane_w - 1) height: h margin: Inset{left: 2 + it.lane * lane_w top: desk_time_y(it.a)}
        on_tap: |x, y| desk_event_tap(r, date, desk_from_span(it.a, it.b, lane_x, lane_w - 1))
        menu: desk_event_menu_rows() menu_current: "My Calendar" on_menu: |title| desk_event_menu(r, date, desk_from_span(it.a, it.b, lane_x, lane_w - 1), title)
        RoundedView{width: Fill height: Fill flow: Right show_bg: true draw_bg +: {color: if on { ui_accent_row } else { cal_tint } border_radius: 2.5}
            RoundedView{width: 3 height: Fill show_bg: true draw_bg +: {color: if on { #xffffff } else { ui_link } border_radius: 1.5}}
            View{width: Fill height: Fill flow: if one_line { Right } else { Down } spacing: if one_line { 4 } else { 1 } padding: Inset{left: if thin { 2 } else { 4 } right: if thin { 1 } else { 3 } top: if one_line { 2 } else { 3 }}
                Label{clip_y: false padding: 0 width: if hugs { Fit } else { Fill } flow: Flow.Right{wrap: wraps} max_lines: most text_overflow: if breaks { TextOverflow.Clip } else { TextOverflow.Ellipsis } text: r.title
                    draw_text +: {color: if on { #xffffff } else { ui_link } text_style: theme.font_bold{font_size: 8.25}}}
                if timed {
                    Label{clip_y: false padding: 0 max_lines: 1 text: when
                        draw_text +: {color: if on { #xffffff } else { ui_ink } text_style: theme.font_regular{font_size: 8.25}}}
                }
            }
        }
    }
}
fn desk_col_view(i){
    if i >= dk.cols.len() { return View{width: Fill height: 1} }
    let c = dk.cols[i]
    let total = desk_day_height()
    let cw = (desk_main_w() - cal_gutter) / dk.cols.len()
    let weekend = cal_weekday(c.o) >= 5
    let date = c.date
    let o = c.o
    let col_x = desk_side_x() + cal_gutter + c.col * cw + 2
    View{width: Fill height: total flow: Overlay
        GestureView{width: Fill height: total
            on_tap: |x, y| desk_col_tap(date, o, y)
            menu: desk_day_menu_rows() on_menu: |title, x, y| desk_day_menu(date, desk_mins_at(y), desk_from_span(desk_mins_at(y), desk_mins_at(y) + 60, col_x, cw - 5), title)
            SolidView{width: Fill height: Fill draw_bg.color: if weekend { if ui_light { #x00000006 } else { #xffffff08 } } else { #x00000000 }}
        }
        SolidView{width: 1 height: total draw_bg.color: cal_line}
        for it in c.items { desk_block(it, c, cw) }
        for it in desk_overflows(c.items, cw) { desk_more_block(it, c, it.lanes - 1, (cw - 4) / it.lanes) }
        if date == dk.today && floor(dk.now_min / 60) >= dk.first_hour {
            View{width: Fill height: 7 margin: Inset{top: desk_time_y(dk.now_min) - 3} flow: Overlay align: Align{y: 0.5}
                SolidView{width: Fill height: 1 draw_bg.color: cal_today_mark}
                RoundedView{width: 7 height: 7 show_bg: true draw_bg +: {color: cal_today_mark border_radius: 3.5}}
            }
        }
    }
}
fn desk_now_on(){
    let hit = false
    for c in dk.cols { if c.date == dk.today { hit = true } }
    hit && floor(dk.now_min / 60) >= dk.first_hour
}
// The hour whose label the now line's time would sit on: it gives way, as on a Mac.
fn desk_near_hour(){
    if !desk_now_on() { return -1 }
    let h = floor((dk.now_min + 22) / 60)
    if h * 60 - dk.now_min < 23 && dk.now_min - h * 60 < 23 { h } else { -1 }
}
fn desk_now_label(){
    if !desk_now_on() { return View{width: 0 height: 0} }
    View{width: cal_gutter height: 16 margin: Inset{top: desk_time_y(dk.now_min) - 8} flow: Right align: Align{x: 1.0 y: 0.5} padding: Inset{right: 6}
        SolidView{width: Fit height: Fit draw_bg.color: ui_content
            CalNote{text: cal_time(dk.now_min) draw_text +: {color: cal_today_word}}
        }
    }
}
fn desk_col_tap(date, o, y){
    let mins = desk_mins_at(y)
    let cw = desk_col_w()
    let x = desk_side_x() + cal_gutter + (o - dk.band_start) * cw + 2
    desk_day_tap(date, || desk_new_event(date, mins, desk_from_span(mins, mins + 60, x, cw - 5)))
}

// ---- Year ---------------------------------------------------------------------------
fn desk_draw_year(){
    ui.y0.render()
    ui.y1.render()
    ui.y2.render()
    ui.y3.render()
    ui.y4.render()
    ui.y5.render()
    ui.y6.render()
    ui.y7.render()
    ui.y8.render()
    ui.y9.render()
    ui.y10.render()
    ui.y11.render()
}
fn desk_year_cw(){ floor((desk_main_w() - 40 - 3 * 22) / 4 / 7) }
// Twelve months fill the pane where they can, and scroll where they can't.
fn desk_year_ch(){ clamp(floor((dk.h - cal_bar_h - 1 - cal_head_h - 18 - 2 * 14 - 3 * (22 + 16)) / 18), 18, 28) }
fn desk_year_cells(m){
    let out = []
    let first = cal_ord(dk.y, m, 1)
    let o = first - cal_col(first)
    let i = 0
    while i < 42 {
        let c = cal_civil(o)
        out.push({o: o d: c.d in_month: c.m == m date: cal_date(c.y, c.m, c.d)})
        o = o + 1
        i = i + 1
    }
    out
}
fn desk_year_tap(m, i){
    if i < 7 { return }
    let first = cal_ord(dk.y, m, 1)
    let o = first - cal_col(first) + i - 7
    let c = cal_civil(o)
    if c.m != m { return }
    let date = cal_date(c.y, c.m, c.d)
    desk_day_tap(date, || desk_show_day(date))
}
fn desk_year_title(m){
    let t = cal_parts(dk.today)
    let now = t.y == dk.y && t.m == m
    CalYearTitle{text: cal_month_names[m - 1] draw_text +: {color: if now { cal_today_word } else { ui_ink } color_hover: if now { cal_today_word } else { ui_ink } color_down: if now { cal_today_word } else { ui_ink } color_focus: if now { cal_today_word } else { ui_ink }}
        on_click: || desk_open_month(m)}
}
fn desk_open_month(m){
    dk.view = "month"
    let t = cal_parts(dk.today)
    let date = if t.y == dk.y && t.m == m { dk.today } else { cal_date(dk.y, m, 1) }
    desk_jump(date)
    ui.segs.render()
    desk_show()
    desk_draw_all()
}
fn desk_year_month(m){
    let cw = desk_year_cw()
    let ch = desk_year_ch()
    View{width: Fill height: Fit flow: Down new_batch: true
        CalFillsFirst{}
        desk_year_title(m)
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} on_item_tap: |i| desk_year_tap(m, i)
            for name in cal_heads_letter {
                View{width: cw height: 16 align: Align{x: 0.5 y: 0.5} CalSmallNum{text: name draw_text +: {color: ui_muted}}}
            }
            for c in desk_year_cells(m) { desk_small_cell(c, c.in_month, cw, ch, true) }
        }
    }
}

// ---- an event's popover --------------------------------------------------------------
// Beside what it is about: on the right where there is room, else on the left. With no room
// either side, below it, or above it, its beak on the middle of it. A wide thing (a day of the
// Day view) is pointed at where its words are.
fn desk_place(from, w, h){
    let below = try { from.below } catch { nil }
    if below != nil { return {x: max(8, min(dk.w - w - 8, from.x)) y: from.y side: "top" aim: below edge: 0} }
    let aim = try { from.aim } catch { -1 }
    let fw = min(from.w, 240)
    let y = max(cal_bar_h + 8, min(dk.h - h - 8, from.y - 12))
    if aim >= 0 {
        if from.x + fw + 8 + w <= dk.w - 8 { return {x: from.x + fw + 8 y: y side: "left" aim: aim edge: 0} }
        if from.x - w - 8 >= 8 { return {x: from.x - w - 8 y: y side: "right" aim: aim edge: 0} }
        let top = try { from.top } catch { aim - 9 }
        let bottom = try { from.bottom } catch { aim + 9 }
        let x = max(8, min(dk.w - w - 8, from.x + fw / 2 - w / 2))
        let mid = max(x + 18, min(x + w - 18, from.x + fw / 2))
        if bottom + 10 + h <= dk.h - 8 { return {x: x y: bottom + 10 side: "top" aim: mid edge: 0} }
        if top - 10 - h >= cal_bar_h + 8 { return {x: x y: top - 10 - h side: "bottom" aim: mid edge: top - 10} }
    }
    // Nowhere it fits whole: beside it, over what is next to it, with no beak to be wrong.
    let x = from.x + fw + 8
    if x + w > dk.w - 8 { x = from.x - w - 8 }
    if x < 8 { x = min(dk.w - w - 8, max(8, from.x + 8)) }
    {x: x y: y side: "" aim: -1 edge: 0}
}
fn desk_pop_show(){
    ui.pop_host.render()
    ui.pop_layer.set_visible(true)
}
fn desk_pop_height(p){
    if p.mode == "delete" { return 120 }
    // A Mac's popover is as tall as what it shows (desk_edit_h): its arrow stays on it.
    if ui_unified && dk.form != nil { return desk_edit_h(dk.form) }
    cal_edit_h
}
// How tall the editor is now: its time zone's row goes with All-day, its last line comes
// only with something to say.
fn desk_edit_h(f){ desk_edit_h_as(f, desk_when_open()) }
fn desk_edit_h_as(f, open){
    let h = cal_edit_h - 22
    // A Mac's popover says when in one line until that line is clicked: its four rows
    // (All-day, Starts, Ends, Time zone) or three (all day) stand for it.
    if ui_unified && !open { h = h - 112 }
    else if f.all { h = h - 36 }
    if desk_status_of(f) != "" { h = h + 22 }
    if f.error != "" || f.gone { h = h + 38 }
    h
}
// ---- when, on a Mac: one line, as Calendar's popover has, that opens its rows when clicked.
fn desk_when_open(){ dk.pop != nil && dk.pop.mode == "edit" && dk.pop.when }
fn desk_when_line(f){
    let zone = if f.zone == "" { "" } else { "  (" + cal_zone_name(f.zone) + ")" }
    if f.all {
        if f.ed != f.sd { return cal_long(f.sd) + " to " + cal_long(f.ed) }
        return cal_long(f.sd) + "  all-day"
    }
    if f.et.trim() == "" { return cal_long(f.sd) + "  " + f.st + zone }
    if f.ed != f.sd { return cal_long(f.sd) + "  " + f.st + " to " + cal_long(f.ed) + "  " + f.et + zone }
    cal_long(f.sd) + "  " + f.st + " to " + f.et + zone
}
fn desk_when_expand(){
    let p = dk.pop
    if p == nil || p.mode != "edit" || p.when || dk.form == nil { return }
    p.when = true
    desk_pop_fit()
    ui.pop_host.render()
    // The click took the keyboard from the fields: Escape still closes the popover.
    ui.cal_keys.focus()
}
// The popover grew: placed again by what it points at, as a Mac's popover is, or kept in the
// window when it points at nothing any more.
fn desk_pop_fit(){
    let p = dk.pop
    let h = desk_edit_h(dk.form)
    if p.side != "" && p.from != nil {
        let at = desk_place(p.from, cal_edit_w, h)
        p.x = at.x
        p.y = at.y
        p.side = at.side
        p.aim = at.aim
        p.edge = at.edge
    } else {
        p.y = max(cal_bar_h + 8, min(dk.h - h - 8, p.y))
    }
}
// The editor's top edge as drawn: one above its event hangs from the beak, so it grows up.
fn desk_pop_top(){
    let p = dk.pop
    if p.side == "bottom" && dk.form != nil { p.edge - desk_edit_h(dk.form) } else { p.y }
}
fn desk_keep_popover_in(){
    let p = dk.pop
    // What it pointed at has moved with the window.
    p.side = ""
    p.x = max(8, min(dk.w - cal_edit_w - 8, p.x))
    p.y = max(cal_bar_h + 8, min(dk.h - desk_pop_height(p) - 8, p.y))
    ui.pop_host.render()
}
fn desk_close_popover(){
    dk.shut_at = time_now()
    dk.pop = nil
    dk.form = nil
    ui.pop_layer.set_visible(false)
    ui.pop_host.render()
    ui.cal_keys.focus()
}
fn desk_select(r, date){
    if dk.sel == r.id && dk.day == date { return }
    let old_day = dk.day
    let old_row = dk.sel_row
    dk.sel = r.id
    dk.sel_row = r
    dk.day = date
    desk_selection_moved(old_day, old_row)
}
fn desk_open_event(r, date, from){ desk_open_as(r, date, from, nil) }
// An event's popover edits it in place, as Calendar's does: each change is saved as it is
// made, and Escape or a click away closes it. A new event's opens with its title ready to
// type: what is typed replaces "New Event".
fn desk_open_as(r, date, from, step){
    desk_select(r, date)
    desk_form_from(r)
    if step != nil {
        dk.form.step = step
        dk.form.title = ""
    }
    let at = desk_place(from, cal_edit_w, if ui_unified { desk_edit_h_as(dk.form, false) } else { cal_edit_h })
    dk.pop_n = dk.pop_n + 1
    dk.pop = {n: dk.pop_n mode: "edit" row: r date: date x: at.x y: at.y side: at.side aim: at.aim edge: at.edge status: "" closing: false when: false from: from}
    desk_pop_show()
    if step != nil { start_timeout(0.05, || { try { ui.e_title.focus() } catch { nil } }) }
}
// The store changed under an open popover: it shows the event as it is now, or closes if the
// event went. What the person changed and hasn't saved yet stays as they left it.
fn desk_follow_popover(){
    let p = dk.pop
    if p == nil || p.row == nil || dk.busy { return }
    let f = dk.form
    let r = desk_row_by_id(p.row.id)
    if r == nil {
        if p.mode == "edit" && f != nil && desk_dirty(f) {
            f.gone = true
            desk_form_update()
        } else {
            desk_close_popover()
        }
        return
    }
    if f != nil && f.gone {
        // It is back (the store read whole again): a change saves over it as before.
        f.gone = false
        desk_form_update()
    }
    let same = r.raw.to_json() == p.row.raw.to_json()
    if p.mode != "edit" || f == nil {
        if !same {
            p.row = r
            ui.pop_host.render()
        }
        return
    }
    if same && !f.stale { return }
    desk_rebase(f, r)
}
// The event changed elsewhere while its popover is open. What the person changed stays, and
// the rest shows the latest. Where both changed the same thing, theirs is kept and it says
// so: it is saved over the latest when they go on.
fn desk_rebase(f, r){
    let p = dk.pop
    let old = f.saved
    let now = desk_vals(r)
    let fresh = r.raw.to_json() != f.raw.to_json()
    let clash = false
    let title = desk_title_of(f.title)
    if title == desk_title_of(old.title) {
        if now.title != old.title {
            f.title = now.title
            desk_put("title", now.title)
        }
    } else if now.title != old.title && now.title != title { clash = true }
    let place = ("" + f.place).trim()
    if place == ("" + old.place).trim() {
        if now.place != old.place {
            f.place = now.place
            desk_put("place", now.place)
        }
    } else if now.place != old.place && now.place != place { clash = true }
    let notes = ("" + f.notes).trim()
    if notes == ("" + old.notes).trim() {
        if now.notes != old.notes {
            f.notes = now.notes
            desk_put("notes", now.notes)
        }
    } else if now.notes != old.notes && now.notes != notes { clash = true }
    let all_was = f.all
    let mine = desk_when_sig(f)
    let was = desk_when_sig(old)
    let then = desk_when_sig(now)
    if mine == was {
        if then != was {
            f.all = now.all
            f.sd = now.sd
            f.st = now.st
            f.ed = now.ed
            f.et = now.et
            f.zone = now.zone
            f.span = now.span
            desk_put_when(f)
        }
    } else if then != was && then != mine { clash = true }
    f.raw = r.raw
    f.saved = now
    p.row = r
    // A change from elsewhere is no one's to undo here: the next change starts a step of its own.
    if f.step != nil && f.step.kind == "edit" { f.step = nil }
    let stale = f.stale
    f.stale = false
    if clash || (stale && !fresh) {
        p.closing = false
        f.note = "This event changed elsewhere. Your change is kept, and replaces theirs when you press Return or close this."
    }
    if f.all != all_was { ui.pop_host.render() } else { desk_form_update() }
    // A save refused for a change to other things: the person's changes go on top of it now.
    if stale && fresh && !clash { desk_commit(f.typing) }
}
fn desk_focus(id){
    let r = desk_row_by_id(id)
    // An event a route opens waits for an open popover to close.
    if r == nil || dk.pop != nil {
        dk.want = id
        return
    }
    dk.want = ""
    desk_jump(r.sd)
    dk.sel = r.id
    dk.sel_row = r
    desk_draw_all()
    desk_open_event(r, r.sd, desk_from_event(r, r.sd))
    dk.pop.status = dk.want_status
    dk.want_status = ""
    if dk.pop.status != "" { ui.pop_host.render() }
}
fn desk_scrim_tap(){
    if dk.pop == nil || dk.pop.mode == "delete" || dk.zone_find != nil || time_now() - dk.zone_shut_at < 0.1 { return }
    // A press away from a pop-up over the popover closes only the pop-up, as on a Mac.
    if dk.menu != nil || time_now() - dk.menu_shut_at < 0.1 { return }
    desk_done()
}
// Escape or a click away saves before closing. A refused change stays visible
// until it is retried or the person explicitly discards it.
fn desk_done(){
    let p = dk.pop
    if p == nil { return }
    if p.mode == "delete" {
        desk_keep()
        return
    }
    let f = dk.form
    if f == nil {
        desk_close_popover()
        return
    }
    if f.gone || f.error != "" { return }
    f.typing = ""
    p.closing = true
    desk_commit("")
}
fn desk_glance(){
    let f = dk.form
    if dk.pop == nil || dk.pop.row == nil || f == nil || dk.busy { return }
    if desk_dirty(f) {
        // The card shows the event as it is saved: what was changed is saved first.
        f.glance = true
        f.typing = ""
        desk_commit("")
        return
    }
    desk_glance_now()
}
fn desk_glance_now(){
    let p = dk.pop
    if p == nil || p.row == nil || dk.busy { return }
    let n = p.n
    let id = p.row.id
    dk.busy = true
    host.request("calendar.notify", {event: id}, fn(r){
        dk.busy = false
        let said = if r.is_ok { "Event shown in Glance." } else { r.error }
        let open = dk.pop != nil && dk.pop.n == n && dk.pop.mode == "edit"
        if r.is_ok {
            // Undo of a new event takes its card too, and Redo can't put the card back: making
            // this one is no longer undone. Its later edits still are.
            dk.undo.retain(|t| t.kind != "add" || t.id != id)
            dk.redo.retain(|t| t.kind != "add" || t.id != id)
            if open && dk.form != nil && dk.form.step != nil && dk.form.step.kind == "add" { dk.form.step = nil }
        }
        if open {
            dk.pop.status = said
            try { ui.detail_status.set_text(said) } catch { nil }
        }
    })
}
// Delete, as on a Mac: the event goes at once, and Edit > Undo puts it back as it was, its id
// and its Glance card too (`calendar.restore_event`, which keeps what a remove took while
// the shell runs). Other desktops' styles ask first, in an alert, and can't undo it.
fn desk_delete_of(r, date){
    if !ui_unified { desk_ask_delete_of(r, date) return }
    if desk_covered() || dk.busy { return }
    desk_select(r, date)
    desk_delete_now(r)
}
fn desk_delete_now(r){
    if dk.busy { return }
    dk.busy = true
    host.request("calendar.remove_event", {id: r.id expected: r.raw}, fn(answer){
        dk.busy = false
        if !answer.is_ok {
            if answer.error == "This event changed elsewhere. Reload before deleting it." {
                dk.sig = ""
                desk_load()
                desk_add_failed({kind: "delete-changed"})
            } else {
                desk_add_failed({kind: "delete" event: r})
            }
            return
        }
        desk_push_step({kind: "delete" id: r.id a: nil b: nil ev: r.raw})
        if dk.sel == r.id {
            dk.sel = ""
            dk.sel_row = nil
        }
        dk.sig = ""
        desk_load()
    })
}
// The alert: other desktops' styles.
fn desk_ask_delete_of(r, date){
    if desk_covered() { return }
    desk_select(r, date)
    let at = desk_place(desk_from_event(r, date), cal_edit_w, cal_edit_h)
    dk.form = nil
    dk.pop_n = dk.pop_n + 1
    dk.pop = {n: dk.pop_n mode: "delete" row: r date: date x: at.x y: at.y side: at.side aim: at.aim edge: at.edge status: "" closing: false when: false from: nil}
    desk_pop_show()
}
fn desk_keep(){
    let p = dk.pop
    if p == nil || p.mode != "delete" { return }
    desk_close_popover()
}
fn desk_delete(){
    let p = dk.pop
    if dk.busy || p == nil || p.mode != "delete" { return }
    let r = p.row
    let n = p.n
    dk.busy = true
    host.request("calendar.remove_event", {id: r.id expected: r.raw}, fn(answer){
        dk.busy = false
        let open = dk.pop != nil && dk.pop.n == n
        if !answer.is_ok {
            // The event changed or went: it opens as it is now, and says why.
            if open {
                desk_form_from(dk.pop.row)
                dk.form.note = desk_said(answer.error)
                dk.pop.mode = "edit"
                ui.pop_host.render()
            }
            dk.sig = ""
            desk_load()
            return
        }
        desk_no_undo()
        if dk.sel == r.id {
            dk.sel = ""
            dk.sel_row = nil
        }
        if open { desk_close_popover() }
        dk.sig = ""
        desk_load()
    })
}

// ---- the editor -------------------------------------------------------------------------
// An event as its popover shows it, and as the person types it.
fn desk_vals(r){
    let zone = try { r.raw.timezone } catch { "" }
    {title: r.title place: cal_text(r.raw.location) notes: cal_text(r.raw.notes) all: r.all
        sd: r.sd st: if r.all { "9:00 AM" } else { cal_time(r.sm) }
        ed: r.ed et: if r.all { "10:00 AM" } else { if r.em < 0 { "" } else { cal_time(r.em) } }
        zone: cal_text(zone) span: if r.em > r.sm && !r.multi { r.em - r.sm } else { 60 }}
}
fn desk_form_from(r){
    let v = desk_vals(r)
    dk.form = {raw: r.raw saved: v title: v.title place: v.place notes: v.notes all: v.all sd: v.sd st: v.st ed: v.ed et: v.et zone: v.zone span: v.span
        typing: "" again: false glance: false stale: false gone: false error: "" note: "" step: nil}
}
// An emptied title is "New Event", as on a Mac: the service keeps no event without one.
fn desk_title_of(text){
    let t = ("" + text).trim()
    if t == "" { "New Event" } else { t }
}
fn desk_clean(v){
    {title: desk_title_of(v.title) place: ("" + v.place).trim() notes: ("" + v.notes).trim() all: v.all sd: v.sd st: v.st ed: v.ed et: v.et zone: v.zone}
}
// What the popover holds, as it would be saved now. The field still being typed in keeps
// what is saved, and so do times that can't be kept yet (an end before the start).
fn desk_effective(f, keep){
    let v = desk_clean(f)
    let s = f.saved
    if keep == "title" { v.title = desk_title_of(s.title) }
    if keep == "place" { v.place = ("" + s.place).trim() }
    if keep == "notes" { v.notes = ("" + s.notes).trim() }
    if keep == "start" { v.st = s.st }
    if keep == "end" { v.et = s.et }
    if desk_when_problem(v) != "" {
        v.all = s.all
        v.sd = s.sd
        v.st = s.st
        v.ed = s.ed
        v.et = s.et
    }
    v
}
// As the service takes an event.
fn desk_args_of(v){
    let start = v.sd
    let end = ""
    if v.all {
        if v.ed != v.sd { end = v.ed }
    } else {
        start = cal_stamp(v.sd, cal_parse_time(v.st))
        if v.et.trim() != "" { end = cal_stamp(v.ed, cal_parse_time(v.et)) }
    }
    {title: v.title start: start end: end timezone: v.zone location: v.place notes: v.notes}
}
fn desk_saved_args(f){ desk_args_of(desk_clean(f.saved)) }
fn desk_dirty(f){ desk_args_of(desk_effective(f, "")).to_json() != desk_saved_args(f).to_json() }
// When an event is, to tell a change of it from another.
fn desk_when_sig(v){
    let e = if v.et.trim() == "" { -1 } else { cal_parse_time(v.et) }
    if v.all { "all " + v.sd + " " + v.ed + " " + v.zone } else { v.sd + " " + cal_parse_time(v.st) + " " + v.ed + " " + e + " " + v.zone }
}
fn desk_said(text){
    if text == "This event changed elsewhere. Reload before deleting it." {
        return "This event changed elsewhere. Look it over before deleting it."
    }
    if text.search("Calendar cannot keep events:") >= 0 || text.search("os error") >= 0 {
        return "Calendar couldn't update the event. Check storage and try again."
    }
    text
}
// What is wrong with the times, in words; nothing while they are only unfinished.
fn desk_when_problem(v){
    if cal_ord_of(v.ed) < cal_ord_of(v.sd) { return "The event ends before it starts." }
    if v.all { return "" }
    let s = cal_parse_time(v.st)
    if s < 0 { return "Enter a start time such as 9:00 AM." }
    if v.et.trim() == "" { return "" }
    let e = cal_parse_time(v.et)
    if e < 0 { return "Enter an end time such as 10:00 AM." }
    if v.ed == v.sd && e < s { return "The event ends before it starts." }
    ""
}
// The line under the fields: what is wrong, or what became of a change.
fn desk_status_of(f){
    if f.gone { return "This event is no longer in Calendar, so changes to it can't be saved." }
    let problem = desk_when_problem(f)
    if problem != "" { return problem }
    if f.error != "" { return f.error }
    f.note
}
fn desk_form_update(){
    let f = dk.form
    if f == nil || dk.pop == nil || dk.pop.mode != "edit" { return }
    let note = desk_status_of(f)
    try { ui.edit_status.set_text(note) } catch { nil }
    try { ui.status_box.set_visible(note != "") } catch { nil }
    try { ui.edit_actions.set_visible(f.error != "" || f.gone) } catch { nil }
    try { ui.edit_retry.set_visible(f.error != "" && !f.gone) } catch { nil }
}
fn desk_retry_edit(){
    let f = dk.form
    if f == nil || f.gone || dk.busy { return }
    f.error = ""
    f.typing = ""
    desk_form_update()
    ui.pop_host.render()
    desk_commit("")
}
fn desk_discard_failed_edit(){
    if dk.form == nil || dk.busy { return }
    desk_close_popover()
}
fn desk_put(name, text){
    if name == "title" { try { ui.e_title.set_text(text) } catch { nil } }
    else if name == "place" { try { ui.e_place.set_text(text) } catch { nil } }
    else if name == "notes" { try { ui.e_notes.set_text(text) } catch { nil } }
    else if name == "start" { try { ui.e_start.set_text(text) } catch { nil } }
    else { try { ui.e_end.set_text(text) } catch { nil } }
}
fn desk_put_when(f){
    try { ui.e_when.set_text(desk_when_line(f)) } catch { nil }
    try { ui.e_date.set_text(cal_long(f.sd)) } catch { nil }
    try { ui.e_end_date.set_text(cal_long(f.ed)) } catch { nil }
    try { ui.e_zone.set_text(cal_zone_name(f.zone)) } catch { nil }
    desk_put("start", f.st)
    desk_put("end", f.et)
}
// A field typed in. A field says nothing when it loses the keyboard, so starting on another
// one is when the one before is done with, and saved.
fn desk_leaving(f, which){
    if f.typing != which && f.typing != "" { desk_commit(which) }
    f.typing = which
    f.error = ""
}
fn desk_typed(which, text){
    let f = dk.form
    if f == nil { return }
    desk_leaving(f, which)
    if which == "title" { f.title = "" + text }
    else if which == "place" { f.place = "" + text }
    else { f.notes = "" + text }
    desk_form_update()
}
// Return: the field is done with, and saved. The keyboard goes back to the window, where
// Escape still closes the popover.
fn desk_returned(){
    let f = dk.form
    if f == nil { return }
    f.typing = ""
    desk_commit("")
    ui.cal_keys.focus()
    desk_unring()
}
// A field that gave up the keyboard can keep its focus ring on screen until the popover is
// drawn again (a hidden window shows it when nothing is saved): its words, put back, draw it.
fn desk_unring(){
    let f = dk.form
    if f == nil { return }
    desk_put("title", f.title)
    desk_put("place", f.place)
    desk_put("notes", f.notes)
    if !f.all {
        desk_put("start", f.st)
        desk_put("end", f.et)
    }
}
// A press on another of the popover's controls ends the typing, as on a Mac.
fn desk_done_typing(){
    let f = dk.form
    if f == nil || f.typing == "" { return }
    f.typing = ""
    desk_commit("")
}
// A control is used: it is saved at once, with what was typed. The keyboard goes back to the
// window, as after Return: a pressed control keeps no keys, and Escape still closes the popover.
fn desk_changed(){
    let f = dk.form
    if f == nil { return }
    f.typing = ""
    f.error = ""
    desk_form_update()
    desk_commit("")
    ui.cal_keys.focus()
    desk_unring()
}
fn desk_form_all(on){
    // The All-day row reads every press, also one that closed a pop-up over it.
    if dk.menu != nil || time_now() - dk.menu_shut_at < 0.1 { return }
    if dk.zone_find != nil || time_now() - dk.zone_shut_at < 0.1 { return }
    dk.form.all = on
    ui.pop_host.render()
    desk_changed()
}
// A start typed past the end takes the end along at the event's length, as Calendar
// does, so only an end a person put before the start is an error.
fn desk_start_typed(text){
    let f = dk.form
    if f == nil { return }
    desk_leaving(f, "start")
    f.st = "" + text
    let s = cal_parse_time(f.st)
    let e = cal_parse_time(f.et)
    if s >= 0 && e >= 0 && e < s && f.ed == f.sd {
        f.et = cal_time(min(1439, s + f.span))
        desk_put("end", f.et)
    }
    desk_form_update()
}
fn desk_end_typed(text){
    let f = dk.form
    if f == nil { return }
    desk_leaving(f, "end")
    f.et = "" + text
    let s = cal_parse_time(f.st)
    let e = cal_parse_time(f.et)
    if s >= 0 && e >= s { f.span = e - s }
    desk_form_update()
}
fn desk_step(which, by){
    let f = dk.form
    if which == "start" {
        let m = cal_parse_time(f.st)
        if m < 0 { m = 540 }
        let n = desk_stepped(m, by)
        let e = cal_parse_time(f.et)
        f.st = cal_time(n)
        desk_put("start", f.st)
        // The end keeps its distance from the start.
        if e >= 0 && f.ed == f.sd {
            f.et = cal_time(max(n, min(1439, e + n - m)))
            desk_put("end", f.et)
        }
    } else {
        let m = cal_parse_time(f.et)
        if m < 0 {
            m = cal_parse_time(f.st)
            if m < 0 { m = 540 }
        }
        f.et = cal_time(desk_stepped(m, by))
        desk_put("end", f.et)
        let s = cal_parse_time(f.st)
        let e = cal_parse_time(f.et)
        if s >= 0 && e >= s { f.span = e - s }
    }
    desk_changed()
}
fn desk_stepped(m, by){
    let n = if by > 0 { (floor(m / 15) + 1) * 15 } else { (0 - floor((0 - m) / 15) - 1) * 15 }
    max(0, min(1425, n))
}
// Each change is saved as it is made, as in Calendar. One write at a time: one asked for
// meanwhile follows it, with what the popover holds then.
fn desk_commit(keep){
    let f = dk.form
    let p = dk.pop
    if f == nil || p == nil || p.mode != "edit" || f.gone { return }
    if dk.busy {
        f.again = true
        return
    }
    f.again = false
    let args = desk_args_of(desk_effective(f, keep))
    if args.to_json() == desk_saved_args(f).to_json() {
        desk_committed(f, p)
        return
    }
    let before = f.raw
    let n = p.n
    args.id = before.id
    args.expected = before
    dk.busy = true
    host.request("calendar.update_event", args, fn(r){
        dk.busy = false
        let open = dk.pop != nil && dk.pop.n == n
        if !r.is_ok {
            if open { desk_refused(f, p, r.error) } else { desk_load() }
            return
        }
        let e = r.data.event
        desk_step_saved(f, before, e)
        let row = desk_row(e)
        f.raw = e
        f.saved = desk_vals(row)
        f.note = ""
        if dk.sel == e.id { dk.sel_row = row }
        dk.sig = ""
        desk_load()
        if !open { return }
        p.row = row
        desk_tidy(f)
        // The event is saved, but its Glance card could not follow: said beside Glance.
        let warning = try { r.data.card_warning } catch { nil }
        if warning != nil {
            p.status = "Saved. " + warning
            try { ui.detail_status.set_text(p.status) } catch { nil }
        }
        desk_form_update()
        desk_committed(f, p)
    })
}
// A time typed as "9:5 pm" reads back as Calendar writes it, once its field is done with.
fn desk_tidy(f){
    let s = f.saved
    if f.all || s.all { return }
    if f.typing != "start" && f.st != s.st && f.sd == s.sd && cal_parse_time(f.st) == cal_parse_time(s.st) {
        f.st = s.st
        desk_put("start", s.st)
    }
    if f.typing != "end" && f.et.trim() != "" && f.et != s.et && f.ed == s.ed && cal_parse_time(f.et) == cal_parse_time(s.et) {
        f.et = s.et
        desk_put("end", s.et)
    }
}
fn desk_committed(f, p){
    if f.again {
        f.again = false
        desk_commit(f.typing)
        return
    }
    if f.glance {
        f.glance = false
        desk_glance_now()
    }
    if p.closing { desk_closed(p) }
}
// The popover closes once what it holds is saved. An event moved off the selected day takes
// the selection along.
fn desk_closed(p){
    let r = p.row
    desk_close_popover()
    if r != nil && dk.sel == r.id {
        let o = cal_ord_of(dk.day)
        if o < cal_ord_of(r.sd) || o > cal_ord_of(r.ed) {
            desk_jump(r.sd)
            desk_draw_all()
        }
    }
}
// The service said no. A change made elsewhere is read, and the person's changes go on top of
// it; anything else is said under the fields, and a close then lets the change go.
fn desk_refused(f, p, why){
    f.again = false
    f.glance = false
    if why == "This event changed elsewhere. Reload it before saving your changes." {
        f.stale = true
    } else {
        p.closing = false
        if why == "This event is no longer in Calendar." { f.gone = true } else { f.error = desk_said(why) }
        desk_form_update()
        // A failure adds controls to the popover; keep those controls inside
        // the window even when the original event was close to its bottom.
        if p.side != "bottom" && p.y + desk_edit_h(f) > dk.h - 8 {
            p.y = max(cal_bar_h + 8, dk.h - desk_edit_h(f) - 8)
            p.side = ""
        }
        ui.pop_host.render()
    }
    dk.sig = ""
    desk_load()
}

// ---- a new event, Undo and Redo -------------------------------------------------------------
// A new event is made at once, as on a Mac: "New Event" at the time asked for and an hour
// long, or all day. Its popover opens on it with the title ready to type, and Undo takes the
// event away again. The service keeps no event without a title, so none is ever empty.
fn desk_new_event(date, mins, from){ desk_new_event_as(date, mins, from, false) }
fn desk_new_event_as(date, mins, from, all){
    if dk.pop != nil || dk.busy || dk.fresh != nil { return }
    // The toolbar can receive a press before the first boot turn selects a
    // day. Such a press means today, not an invalid empty date.
    if date == "" { date = desk_today() }
    let start = if all { date } else { cal_stamp(date, mins) }
    let end = if all { "" } else { cal_stamp(date, min(mins + 60, 1439)) }
    let intent = {kind: "new" date: date mins: mins all: all}
    dk.busy = true
    host.request("calendar.add_event", {title: "New Event" start: start end: end}, fn(r){
        dk.busy = false
        if !r.is_ok { desk_add_failed(intent) return }
        let s = {kind: "add" id: r.data.id a: nil b: nil ev: nil}
        desk_push_step(s)
        dk.fresh = {id: s.id step: s}
        dk.sel = s.id
        dk.sel_row = nil
        if dk.day != date { desk_jump(date) }
        dk.sig = ""
        desk_load()
    })
}
fn desk_add_failed(intent){
    dk.add_failure = intent
    desk_sync_failed_action()
}
fn desk_sync_failed_action(){
    let intent = desk_add_problem()
    ui.add_fail_layer.set_visible(intent != nil)
    if intent == nil { return }
    let title = "Couldn't Add Event"
    let note = "The event wasn't added. Check the time or available storage, then try again."
    if intent.kind == "undo" {
        title = "Couldn't Undo"
        note = "The change wasn't undone. Try again."
    } else if intent.kind == "redo" {
        title = "Couldn't Redo"
        note = "The change wasn't redone. Try again."
    } else if intent.kind == "cut" {
        title = "Couldn't Cut Event"
        note = "The event wasn't cut. Check Calendar and try again."
    } else if intent.kind == "cut-changed" {
        title = "Couldn't Cut Event"
        note = "The event changed or was removed. Review Calendar before trying again."
    } else if intent.kind == "delete" {
        title = "Couldn't Delete Event"
        note = "The event wasn't deleted. Check Calendar and try again."
    } else if intent.kind == "delete-changed" {
        title = "Couldn't Delete Event"
        note = "The event changed or was removed. Review Calendar before trying again."
    }
    let only_ok = intent.kind == "cut-changed" || intent.kind == "delete-changed"
    ui.add_fail_title.set_text(title)
    ui.add_fail_note.set_text(note)
    ui.add_fail_cancel.set_visible(!only_ok)
    ui.add_fail_retry.set_text(if only_ok { "OK" } else { "Try Again" })
}
fn desk_cancel_failed_add(){
    dk.add_failure = nil
    ui.add_fail_layer.set_visible(false)
    dk.shut_at = time_now()
    ui.cal_keys.focus()
}
fn desk_retry_failed_add(){
    let intent = desk_add_problem()
    if intent == nil || dk.busy { return }
    dk.add_failure = nil
    ui.add_fail_layer.set_visible(false)
    if intent.kind == "new" { desk_new_event_as(intent.date, intent.mins, nil, intent.all) }
    else if intent.kind == "copy" { desk_add_copy(intent.event, intent.start, intent.end) }
    else if intent.kind == "undo" { desk_undo_step() }
    else if intent.kind == "redo" { desk_redo_step() }
    else if intent.kind == "cut" { desk_cut_step(intent.event) }
    else if intent.kind == "delete" { desk_delete_now(intent.event) }
    dk.shut_at = time_now()
    ui.cal_keys.focus()
}
fn desk_open_fresh(){
    let n = dk.fresh
    let r = desk_row_by_id(n.id)
    if r == nil { return }
    dk.fresh = nil
    n.step.ev = r.raw
    if dk.pop != nil || dk.menu != nil { return }
    desk_open_as(r, r.sd, desk_from_event(r, r.sd), n.step)
}
// Edit > Undo and Redo, as on a Mac. A new event (made, pasted or duplicated) goes again; an
// edit goes back to the event as it was before its popover opened, exactly, as the service
// keeps it. A step whose event changed elsewhere since is refused, and the event says so.
// On a Mac a deleted or cut event comes back as it was, its id too; elsewhere it can't, so
// after one there is nothing to undo.
fn desk_push_step(s){
    dk.undo.push(s)
    if dk.undo.len() > 50 { dk.undo.remove(0) }
    dk.redo = []
}
fn desk_no_undo(){
    dk.undo = []
    dk.redo = []
}
// One step for each time a popover is open: the event before it, and after it.
fn desk_step_saved(f, before, after){
    let s = f.step
    if s == nil {
        f.step = {kind: "edit" id: after.id a: before b: after ev: nil}
        desk_push_step(f.step)
    } else if s.kind == "edit" {
        s.b = after
    } else {
        s.ev = after
    }
}
// A pasted or duplicated event as the store keeps it, once it is read.
fn desk_steps_read(){
    for s in dk.undo {
        if s.kind == "add" && s.ev == nil {
            let r = desk_row_by_id(s.id)
            if r != nil { s.ev = r.raw }
        }
    }
}
fn desk_args_raw(e){
    let zone = try { e.timezone } catch { "" }
    {title: e.title start: e.start end: cal_text(e.end) timezone: cal_text(zone) location: cal_text(e.location) notes: cal_text(e.notes)}
}
// A new event's step waits until the event is read back as the store keeps it.
fn desk_can_undo(){
    let n = dk.undo.len()
    if n == 0 { return false }
    let s = dk.undo[n - 1]
    s.kind != "add" || s.ev != nil
}
// A version conflict really invalidates the history for that event. A
// temporary service or storage error leaves the step available for retry.
fn desk_history_failed(s, word, error){
    if error == "This event changed elsewhere. Reload before deleting it." ||
       error == "This event changed elsewhere. Reload it before saving your changes." ||
       error == "This event is no longer in Calendar." ||
       error == "This event can't be put back." ||
       error == "This event is already in Calendar." {
        desk_step_failed(s, word)
    } else {
        desk_add_failed({kind: if word == "Undo" { "undo" } else { "redo" }})
    }
}
fn desk_undo(){
    if desk_covered() || dk.busy || !desk_can_undo() { return }
    desk_undo_step()
}
// Retry has just dismissed a sheet, so it deliberately bypasses the
// click-through guard while retaining the history and busy checks.
fn desk_undo_step(){
    if dk.busy || !desk_can_undo() { return }
    let s = dk.undo[dk.undo.len() - 1]
    dk.busy = true
    if s.kind == "delete" {
        host.request("calendar.restore_event", {id: s.id}, fn(r){
            dk.busy = false
            if !r.is_ok {
                desk_history_failed(s, "Undo", r.error)
                return
            }
            dk.undo.pop()
            dk.redo.push(s)
            desk_stepped_to(s.ev)
        })
        return
    }
    if s.kind == "add" {
        host.request("calendar.remove_event", {id: s.id expected: s.ev}, fn(r){
            dk.busy = false
            if !r.is_ok {
                desk_history_failed(s, "Undo", r.error)
                return
            }
            dk.undo.pop()
            dk.redo.push(s)
            if dk.sel == s.id {
                dk.sel = ""
                dk.sel_row = nil
            }
            dk.sig = ""
            desk_load()
        })
        return
    }
    let args = desk_args_raw(s.a)
    args.id = s.id
    args.expected = s.b
    host.request("calendar.update_event", args, fn(r){
        dk.busy = false
        if !r.is_ok {
            desk_history_failed(s, "Undo", r.error)
            return
        }
        dk.undo.pop()
        s.a = r.data.event
        dk.redo.push(s)
        desk_stepped_to(s.a)
    })
}
fn desk_redo(){
    if desk_covered() || dk.busy || dk.redo.len() == 0 { return }
    desk_redo_step()
}
fn desk_redo_step(){
    if dk.busy || dk.redo.len() == 0 { return }
    let s = dk.redo[dk.redo.len() - 1]
    dk.busy = true
    if s.kind == "delete" {
        host.request("calendar.remove_event", {id: s.id expected: s.ev}, fn(r){
            dk.busy = false
            if !r.is_ok {
                desk_history_failed(s, "Redo", r.error)
                return
            }
            dk.redo.pop()
            dk.undo.push(s)
            if dk.sel == s.id {
                dk.sel = ""
                dk.sel_row = nil
            }
            dk.sig = ""
            desk_load()
        })
        return
    }
    if s.kind == "add" {
        host.request("calendar.add_event", desk_args_raw(s.ev), fn(r){
            dk.busy = false
            if !r.is_ok {
                desk_history_failed(s, "Redo", r.error)
                return
            }
            dk.redo.pop()
            // Back with the same fields; the service gives it a new id, and the steps follow it.
            let old = s.id
            let id = r.data.id
            for t in dk.redo { desk_renamed(t, old, id) }
            desk_renamed(s, old, id)
            s.ev = nil
            dk.undo.push(s)
            dk.sel = id
            dk.sel_row = nil
            dk.sig = ""
            desk_load()
        })
        return
    }
    let args = desk_args_raw(s.b)
    args.id = s.id
    args.expected = s.a
    host.request("calendar.update_event", args, fn(r){
        dk.busy = false
        if !r.is_ok {
            desk_history_failed(s, "Redo", r.error)
            return
        }
        dk.redo.pop()
        s.b = r.data.event
        dk.undo.push(s)
        desk_stepped_to(s.b)
    })
}
// An undone or redone edit: the event is selected where it is now.
fn desk_stepped_to(e){
    let r = desk_row(e)
    dk.sel = r.id
    dk.sel_row = nil
    let o = cal_ord_of(dk.day)
    if o < cal_ord_of(r.sd) || o > cal_ord_of(r.ed) { desk_jump(r.sd) }
    dk.sig = ""
    desk_load()
}
// The event changed or went since the step: it stays as it is, its steps go, and its popover
// says why.
fn desk_step_failed(s, word){
    let id = s.id
    dk.undo.retain(|t| t.id != id)
    dk.redo.retain(|t| t.id != id)
    if desk_row_by_id(id) != nil {
        dk.want = id
        dk.want_status = "This event changed elsewhere, so " + word + " left it as it is."
    }
    dk.sig = ""
    desk_load()
}
fn desk_renamed(t, old, id){
    if t.id != old { return }
    t.id = id
    if t.a != nil { t.a = desk_raw_as(t.a, id) }
    if t.b != nil { t.b = desk_raw_as(t.b, id) }
    if t.ev != nil { t.ev = desk_raw_as(t.ev, id) }
}
fn desk_raw_as(e, id){
    let zone = try { e.timezone } catch { "" }
    {id: id title: e.title start: e.start end: e.end location: cal_text(e.location) notes: cal_text(e.notes) timezone: cal_text(zone)}
}

// ---- the editor's pop-ups ----------------------------------------------------------------
fn desk_row_y(i){ 14 + i * 36 }
fn desk_date_menu(kind){
    desk_done_typing()
    let f = dk.form
    let p = cal_parts(if kind == "start" { f.sd } else { f.ed })
    let row = if kind == "start" { 3 } else { 4 }
    let top = desk_pop_top()
    let y = top + desk_row_y(row) + 28 + 4
    if y + 222 > dk.h - 8 { y = top + desk_row_y(row) - 222 - 4 }
    dk.menu = {kind: kind x: dk.pop.x + 96 y: y cal_y: p.y cal_m: p.m start: 0}
    ui.menu_host.render()
    ui.menu_layer.set_visible(true)
}
// The time zone's pop-up, as Calendar's: Automatic and UTC, the zones in use (this
// event's, the ones chosen lately, those of the stored events), then Other….
fn cal_has(list, x){
    let hit = false
    for v in list { if v == x { hit = true } }
    hit
}
fn desk_zone_recent(){
    let out = []
    let here = dk.form.zone
    if here != "" && here != "UTC" { out.push(here) }
    for id in dk.zone_used {
        if id != "" && id != "UTC" && out.len() < 8 && !cal_has(out, id) { out.push(id) }
    }
    for e in dk.all {
        let zone = try { e.timezone } catch { "" }
        let id = cal_text(zone)
        if id != "" && id != "UTC" && out.len() < 8 && !cal_has(out, id) { out.push(id) }
    }
    out
}
fn desk_zone_menu(){
    desk_done_typing()
    let titles = ["Automatic", "UTC", "-"]
    let recent = desk_zone_recent()
    for id in recent { titles.push(cal_zone_name(id)) }
    if recent.len() > 0 { titles.push("-") }
    titles.push("Other…")
    ui.zone_pick.open_menu(titles, cal_zone_name(dk.form.zone))
}
fn desk_zone_chosen(title){
    if title == "Other…" { desk_zone_other() }
    else if title == "Automatic" { desk_zone_pick("") }
    else if title == "UTC" { desk_zone_pick("UTC") }
    else {
        let hit = ""
        for id in desk_zone_recent() { if hit == "" && cal_zone_name(id) == title { hit = id } }
        if hit != "" { desk_zone_pick(hit) }
    }
}
// Other…: a sheet that finds a city as it is typed. Return or a double click takes the
// highlighted one, Escape leaves the zone as it was.
fn desk_zone_matches(q){
    if q == "" { return cal_world }
    // Cities that start with what was typed come first.
    let starts = regex("^" + cal_escape(q), "i")
    let anywhere = regex(cal_escape(q), "i")
    let out = []
    let then = []
    for z in cal_world {
        if starts.test(z.city) { out.push(z) }
        else if anywhere.test(z.city) || anywhere.test(z.place) || anywhere.test(z.id) { then.push(z) }
    }
    for z in then { out.push(z) }
    out
}
fn desk_zone_index(rows, id){
    let at = -1
    for i z in rows { if at < 0 && z.id == id { at = i } }
    at
}
fn desk_zone_other(){
    let at = desk_zone_index(cal_world, dk.form.zone)
    dk.zone_find = {q: "" at: max(0, at) tap_at: 0 rows: cal_world}
    ui.zone_search.set_text("")
    ui.zone_rows.render()
    ui.zone_layer.set_visible(true)
    // The zone it has now is in view, and the keyboard is in the search field.
    let to = max(0, at * 24 - 80)
    start_timeout(0.05, || {
        try { ui.zone_scroll.set_scroll_y(to) } catch { nil }
        try { ui.zone_search.focus() } catch { nil }
    })
}
fn desk_zone_typed(text){
    let z = dk.zone_find
    if z == nil { return }
    let q = ("" + text).trim()
    if q == z.q { return }
    z.q = q
    z.rows = desk_zone_matches(q)
    z.at = 0
    ui.zone_rows.render()
    try { ui.zone_scroll.set_scroll_y(0) } catch { nil }
}
fn desk_zone_row(m, i, on){
    GestureView{width: Fill height: 24 on_tap: |x, y| desk_zone_tap(i)
        RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 8 right: 8} show_bg: true
            draw_bg +: {color: if on { ui_accent_row } else { #x00000000 } border_radius: 3.0}
            Label{clip_y: false padding: 0 width: Fill max_lines: 1 text_overflow: Ellipsis text: m.city
                draw_text +: {color: if on { #xffffff } else { ui_ink } text_style: theme.font_regular{font_size: 9.75}}}
            Label{clip_y: false padding: 0 max_lines: 1 text: m.place
                draw_text +: {color: if on { #xffffff } else { ui_muted } text_style: theme.font_regular{font_size: 8.25}}}
        }
    }
}
fn desk_zone_tap(i){
    let z = dk.zone_find
    if z == nil { return }
    let now = time_now()
    let again = z.at == i && now - z.tap_at < 0.45
    z.at = i
    z.tap_at = now
    if again { desk_zone_done() } else { ui.zone_rows.render() }
}
fn desk_zone_done(){
    let z = dk.zone_find
    if z == nil || z.at < 0 || z.at >= z.rows.len() { return }
    let id = z.rows[z.at].id
    desk_zone_close()
    desk_zone_pick(id)
}
fn desk_zone_close(){
    if dk.zone_find == nil { return }
    dk.zone_find = nil
    dk.zone_shut_at = time_now()
    ui.zone_layer.set_visible(false)
    ui.zone_rows.render()
    ui.cal_keys.focus()
}
fn desk_close_menu(){
    dk.menu_shut_at = time_now()
    dk.menu = nil
    ui.menu_layer.set_visible(false)
    ui.menu_host.render()
    ui.cal_keys.focus()
}
fn desk_menu_nav(by){
    let n = cal_month_add(dk.menu.cal_y, dk.menu.cal_m, by)
    dk.menu.cal_y = n.y
    dk.menu.cal_m = n.m
    ui.menu_host.render()
}
fn desk_menu_tap(i){
    if i < 7 { return }
    let date = cal_date_of(dk.menu.start + i - 7)
    let f = dk.form
    if dk.menu.kind == "start" {
        // The end moves along with the start.
        f.ed = cal_date_of(cal_ord_of(f.ed) + cal_ord_of(date) - cal_ord_of(f.sd))
        f.sd = date
        ui.e_date.set_text(cal_long(f.sd))
        ui.e_end_date.set_text(cal_long(f.ed))
    } else {
        f.ed = date
        ui.e_end_date.set_text(cal_long(f.ed))
        if !f.all && f.et.trim() == "" {
            f.et = f.st
            ui.e_end.set_text(f.et)
        }
    }
    desk_close_menu()
    desk_changed()
}
fn desk_zone_pick(id){
    if dk.form == nil { return }
    if id != "" {
        let used = [id]
        for u in dk.zone_used { if u != id && used.len() < 8 { used.push(u) } }
        dk.zone_used = used
    }
    dk.form.zone = id
    ui.e_zone.set_text(cal_zone_name(id))
    desk_close_menu()
    desk_changed()
}
fn desk_menu(){
    let m = dk.menu
    if m == nil { return View{width: 0 height: 0} }
    desk_date_picker(m)
}
fn desk_date_picker(m){
    let f = dk.form
    let picked = if m.kind == "start" { f.sd } else { f.ed }
    let first = cal_ord(m.cal_y, m.cal_m, 1)
    m.start = first - cal_col(first)
    let cells = []
    let o = m.start
    let i = 0
    while i < 42 {
        let c = cal_civil(o)
        cells.push({d: c.d in_month: c.m == m.cal_m date: cal_date(c.y, c.m, c.d)})
        o = o + 1
        i = i + 1
    }
    CalPop{width: 216 margin: Inset{left: m.x top: m.y} padding: 10 spacing: 4
        View{width: Fill height: 24 flow: Right align: Align{y: 0.5} padding: Inset{left: 4}
            Label{clip_y: false padding: 0 text: cal_month_names[m.cal_m - 1] + " " + m.cal_y draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75}}}
            View{width: Fill height: 1}
            CalMiniTool{draw_icon +: {svg: ui_icon("chevron-left")} on_click: || desk_menu_nav(-1)}
            CalMiniTool{draw_icon +: {svg: ui_icon("chevron-right")} on_click: || desk_menu_nav(1)}
        }
        View{width: 196 height: Fit flow: Flow.Right{wrap: true} new_batch: true on_item_tap: |i| desk_menu_tap(i)
            for name in cal_heads_letter {
                View{width: 28 height: 18 align: Align{x: 0.5 y: 0.5} CalSmallNum{text: name draw_text +: {color: ui_muted}}}
            }
            for c in cells {
                View{width: 28 height: 24 align: Align{x: 0.5 y: 0.5}
                    if c.date == picked {
                        CalSmallDisc{draw_bg +: {color: ui_accent_row} CalSmallNum{text: "" + c.d draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 8.25}}}}
                    } else if c.date == dk.today {
                        CalSmallNum{text: "" + c.d draw_text +: {color: cal_today_mark text_style: theme.font_bold{font_size: 8.25}}}
                    } else if c.in_month {
                        CalSmallNum{text: "" + c.d}
                    } else {
                        CalSmallNum{text: "" + c.d draw_text +: {color: cal_out}}
                    }
                }
            }
        }
    }
}

// ---- search -------------------------------------------------------------------------------
fn desk_search_changed(text){
    let q = ("" + text).trim()
    if q == dk.search { return }
    let was_on = dk.search != ""
    dk.search = q
    ui.search_x.set_visible(q != "")
    if q != "" { desk_find() }
    if was_on != (q != "") {
        desk_show()
        desk_draw_main()
    }
}
fn desk_search_clear(){
    ui.search.set_text("")
    desk_search_changed("")
}
fn cal_escape(text){
    let out = text
    for mark in ["\\" "." "*" "+" "?" "^" "$" "(" ")" "[" "]" "{" "}" "|"] {
        let parts = out.split(mark)
        if parts.len() > 1 { out = cal_join(parts, "\\" + mark) }
    }
    out
}
fn desk_find(){
    let re = regex(cal_escape(dk.search), "i")
    let out = []
    for r in dk.rows {
        if out.len() < 100 && (re.test(r.title) || re.test(r.raw.location) || re.test(r.raw.notes)) { out.push(r) }
    }
    dk.found = out
    ui.results.render()
}
fn desk_found_when(r){
    if r.all && !r.multi { return cal_long(r.sd) }
    if r.multi { return cal_long(r.sd) + " – " + cal_long(r.ed) }
    cal_long(r.sd) + " at " + cal_time(r.sm)
}
fn desk_found_tap(r, i){
    if desk_covered() { return }
    let now = time_now()
    let again = dk.tap_id == r.id && now - dk.tap_at < 0.45
    dk.tap_id = r.id
    dk.tap_at = now
    if again {
        dk.tap_id = ""
        desk_open_event(r, r.sd, desk_from_found(i))
        return
    }
    desk_jump(r.sd)
    dk.sel = r.id
    dk.sel_row = r
    desk_draw_all()
    ui.results.render()
    dk.tap_at = time_now()
}
fn desk_found_row(r, i){
    let on = dk.sel == r.id
    GestureView{width: Fill height: 44 on_tap: |x, y| desk_found_tap(r, i)
        menu: desk_event_menu_rows() menu_current: "My Calendar" on_menu: |title| desk_event_menu(r, r.sd, desk_from_found(i), title)
        View{width: Fill height: Fill flow: Overlay padding: Inset{left: 6 right: 6}
            RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} spacing: 7 show_bg: true
                draw_bg +: {color: if on { ui_accent_row } else { #x00000000 } border_radius: 3.0}
                Svg{width: 7 height: 7 animating: false draw_svg +: {svg: cal_dot color: if on { #xffffff } else { ui_link }}}
                View{width: Fill height: Fit flow: Down spacing: 2
                    UiRowTitle{text: r.title draw_text +: {color: if on { #xffffff } else { ui_ink }}}
                    UiRowNote{text: desk_found_when(r) draw_text +: {color: if on { #xffffff } else { ui_muted }}}
                }
            }
        }
    }
}
fn desk_toggle_cal(){
    if desk_covered() { return }
    dk.show_cal = !dk.show_cal
    ui.cal_box.render()
    desk_draw_all()
}
fn desk_retry(){
    dk.failed = ""
    desk_show()
    desk_load()
}

// ---- the parts ----------------------------------------------------------------------------
let CalNum = Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let CalNote = Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
let CalSmallNum = CalNote{draw_text +: {color: ui_ink}}
let CalDisc = RoundedView{width: 22 height: 22 align: Align{x: 0.5 y: 0.5} new_batch: true show_bg: true draw_bg +: {border_radius: 5.5}}
let CalSmallDisc = RoundedView{width: 18 height: 18 align: Align{x: 0.5 y: 0.5} new_batch: true show_bg: true draw_bg +: {border_radius: 4.5}}
let CalSmallDot = Svg{width: 7 height: 7 animating: false draw_svg +: {svg: cal_dot color: ui_link}}
// An event in a month's cell: a plain line with its calendar's dot; a whole day's is a
// tinted bar; the selected one is the accent, white on it.
let CalChipBase = ButtonFlat{width: Fill height: 18 margin: 0 padding: Inset{left: 5 right: 4} spacing: 0 align: Align{x: 0.0 y: 0.5}
    icon_walk: Walk{width: 0 height: 0} label_walk: Walk{width: Fill height: Fit}
    draw_bg +: {border_radius: 2.5 border_size: 0.0 color: #x00000000 color_hover: #x00000000 color_down: cal_tint color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink max_lines: 1 text_overflow: Ellipsis text_style: theme.font_regular{font_size: 8.25}}
}
let CalChip = CalChipBase{icon_walk: Walk{width: 7 height: 7} spacing: 5 padding: Inset{left: 4 right: 4} draw_icon +: {svg: cal_dot color: ui_link}}
let CalChipOn = CalChip{draw_bg +: {color: ui_accent_row color_hover: ui_accent_row color_down: ui_accent_row color_focus: ui_accent_row}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}
    draw_icon +: {color: #xffffff}}
let CalChipAll = CalChipBase{draw_bg +: {color: cal_tint color_hover: cal_tint color_down: cal_tint color_focus: cal_tint}}
let CalChipAllOn = CalChipBase{draw_bg +: {color: ui_accent_row color_hover: ui_accent_row color_down: ui_accent_row color_focus: ui_accent_row}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}}
let CalMore = CalChipBase{height: 16 padding: Inset{left: 16 right: 4} draw_text +: {color: ui_muted color_hover: ui_ink color_down: ui_ink color_focus: ui_muted}}
let CalWeek = View{width: Fill height: Fill flow: Right spacing: 1}
// Fills drawn before any text: the first of a shader in a new batch sets its layer.
let CalFillsFirst = RoundedView{width: 1 height: 1 margin: Inset{right: -1 bottom: -1} show_bg: true draw_bg +: {color: #x00000000}}
let CalTintDisc = RoundedView{width: 18 height: 18 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: cal_tint border_radius: 4.5}}
let CalHead = UiSideHead{padding: Inset{left: 4 top: 12 bottom: 4}}
let CalCol = View{width: Fill height: Fit flow: Down}
let CalYearTitle = ButtonFlat{width: Fill height: 22 margin: 0 padding: Inset{left: 5} align: Align{x: 0.0 y: 0.5} label_walk: Walk{width: Fill height: Fit}
    draw_bg +: {border_radius: 2.5 border_size: 0.0 color: #x00000000 color_hover: #x00000000 color_down: #x00000000 color_focus: #x00000000}
    draw_text +: {text_style: theme.font_bold{font_size: 9.75}}
}
let CalMiniTool = UiToolIcon{width: 22 height: 22 icon_walk: Walk{width: 13 height: 13} draw_icon +: {color: ui_muted}}
// The grouped ‹ Today › control, one face with hairlines between its parts.
let CalNavPart = ButtonFlat{height: Fill margin: 0 padding: 0 text: ""
    icon_walk: Walk{width: 14 height: 14}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
    draw_icon +: {color: ui_ink}
}
// A tool that shows a glyph and keeps its name for the tests and for anything that
// reads the widgets out; its words are never drawn.
let cal_no_text = #x00000000
let cal_seg_face = if ui_light { ui_button } else { mix(ui_page, ui_ink, 0.3) }
let CalSegOn = UiSegOn{draw_bg +: {color: cal_seg_face color_hover: cal_seg_face color_focus: cal_seg_face}}
let CalNamedTool = UiToolIcon{label_walk: Walk{width: 0 height: 0} draw_text +: {color: cal_no_text color_hover: cal_no_text color_down: cal_no_text color_focus: cal_no_text}}
let CalPop = RoundedShadowView{width: Fit height: Fit flow: Down new_batch: true cursor: MouseCursor.Default
    draw_bg +: {color: cal_pop_face border_size: 1.0 border_color: ui_border border_radius: 5.0 shadow_color: cal_shadow shadow_radius: 14.0 shadow_offset: vec2(0.0, 4.0)}}
let CalKey = UiFormKey{width: 72}
// The shared field's text sits 1.5 points above its label's baseline and a pop-up's.
let CalField = UiField{padding: Inset{left: 8 right: 8 top: 7.5 bottom: 4.5} on_escape: |text| desk_key("Escape", false, false)}
// A Mac popover's title, place and notes: words with no frame until they're clicked. The
// shared field's bevel is a gradient to a second colour: that one goes too, or it draws a
// grey frame round the words.
let CalBareField = CalField{height: 24 padding: Inset{left: 4 right: 4 top: 5 bottom: 4}
    draw_bg +: {color: #x00000000 color_hover: #x00000000 color_empty: #x00000000 color_down: #x00000000
        border_color: #x00000000 border_color_hover: #x00000000 border_color_empty: #x00000000 border_color_down: #x00000000
        border_color_2: #x00000000 border_color_2_hover: #x00000000 border_color_2_empty: #x00000000 border_color_2_down: #x00000000
        border_color_2_focus: ui_link}}
// A Mac popover's one line for when the event is: a click opens its rows (desk_when_expand).
let CalWhen = ButtonFlat{width: Fill height: 24 margin: 0 padding: Inset{left: 4 right: 4} align: Align{x: 0.0 y: 0.5} label_walk: Walk{width: Fill height: Fit}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
}
let CalTitleField = CalBareField{height: 32 padding: Inset{left: 4 right: 4 top: 5 bottom: 5}
    draw_text +: {text_style: theme.font_bold{font_size: 13.5}}}
let CalMenuRow = ButtonFlat{width: Fill height: 24 margin: 0 padding: Inset{left: 5 right: 10} spacing: 4 align: Align{x: 0.0 y: 0.5}
    icon_walk: Walk{width: 14 height: 14} label_walk: Walk{width: Fill height: Fit}
    draw_bg +: {border_radius: 2.5 border_size: 0.0 color: #x00000000 color_hover: ui_accent_row color_down: ui_accent_row color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: #xffffff color_down: #xffffff color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
    draw_icon +: {color: ui_ink}
}
let CalMenuPlain = CalMenuRow{padding: Inset{left: 23 right: 10} spacing: 0 icon_walk: Walk{width: 0 height: 0}}
let CalDanger = UiButton{draw_text +: {color: ui_danger color_hover: ui_danger color_down: ui_danger color_focus: ui_danger}}
let CalStepPart = ButtonFlat{width: Fill height: 13 margin: 0 padding: 0 text: "" icon_walk: Walk{width: 10 height: 10}
    draw_bg +: {border_radius: 2.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_icon +: {color: ui_ink}
}
fn cal_stepper(which){
    RoundedView{width: 18 height: 28 flow: Down align: Align{x: 0.5 y: 0.5} new_batch: true show_bg: true
        draw_bg +: {color: ui_button border_size: 1.0 border_color: ui_border border_radius: 3.0}
        CalStepPart{draw_icon +: {svg: ui_icon("chevron-up")} on_click: || desk_step(which, 15)}
        CalStepPart{draw_icon +: {svg: ui_icon("chevron-down")} on_click: || desk_step(which, -15)}
    }
}
// A Mac alert: a sheet from under the toolbar, the app's icon beside its words, the
// window dimmed under it until it is answered. (YouTube and Writer have the same parts.)
let CalDim = GestureView{width: Fill height: Fill on_tap: |x, y| {} on_long_press: |x, y| {}
    SolidView{width: Fill height: Fill draw_bg.color: ui_sheet_dim}
}
let CalSheetPlace = View{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: cal_bar_h + 1 left: 16 right: 16}}
let CalSheet = RoundedShadowView{height: Fit flow: Down spacing: 10 padding: Inset{left: 20 right: 20 top: 18 bottom: 16} cursor: MouseCursor.Default
    draw_bg +: {color: ui_surface border_size: 1.0 border_color: ui_border border_radius: 5.0 shadow_color: cal_shadow shadow_radius: 18.0 shadow_offset: vec2(0.0, 4.0)}}
let CalSheetTitle = Label{clip_y: false width: Fill padding: 0 flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75 line_spacing: 1.3}}}
let CalSheetNote = Label{clip_y: false width: Fill padding: 0 flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25 line_spacing: 1.3}}}
let CalSheetButtons = View{width: Fill height: Fit flow: Right spacing: 8 align: Align{x: 1.0 y: 0.5} margin: Inset{top: 6}}
// A Mac's alert never leaves one word alone on the last line of what it says: AppKit pushes
// the word before down to it. The Label can't, so the words are measured here as it will
// wrap them, 228 points wide (UiAlertPanel's), from PingFang SC's own advances for 32 to 126
// then “” and ‘’: the title's 13 px semibold and the words' 11 px regular.
let desk_alert_title_w = [4.33 4.33 6.34 7.80 7.80 12.95 9.76 3.65 4.33 4.33 6.71 7.87 3.58 7.87 3.58 6.50 7.80 5.33 7.80 7.80 7.80 7.80 7.80 7.19 7.80 7.80 3.58 3.58 7.87 7.87 7.87 7.25 11.26 8.83 8.97 9.52 9.36 8.35 7.57 9.83 9.57 3.34 6.99 9.28 7.70 11.74 9.52 10.08 8.52 10.08 9.06 8.46 8.00 9.54 8.57 12.39 8.63 8.98 8.31 4.33 6.50 4.33 7.09 6.50 4.33 7.44 7.83 7.29 7.83 7.37 4.91 7.83 7.50 3.58 3.59 7.19 3.30 11.49 7.55 7.80 7.83 7.83 4.86 6.83 4.71 7.57 6.58 10.10 6.98 6.84 6.58 4.33 2.78 4.33 6.50 7.98 4.84]
let desk_alert_note_w = [3.66 3.66 4.70 6.60 6.60 10.67 7.99 2.68 3.66 3.66 5.57 6.66 2.90 6.66 2.90 5.50 6.60 4.41 6.60 6.60 6.60 6.60 6.60 6.02 6.60 6.60 2.90 2.90 6.66 6.66 6.66 5.91 9.44 7.23 7.45 8.01 7.77 7.01 6.35 8.23 7.92 2.61 5.69 7.59 6.47 9.70 7.91 8.44 7.06 8.44 7.44 6.95 6.81 7.85 7.03 10.23 7.01 7.28 6.86 3.66 5.50 3.66 5.70 5.50 3.66 6.15 6.45 6.02 6.45 6.11 4.10 6.50 6.12 2.82 2.94 5.82 2.59 9.41 6.15 6.45 6.45 6.45 4.02 5.56 3.91 6.16 5.30 8.31 5.60 5.46 5.36 3.66 2.15 3.66 5.50 5.91 3.74]
fn desk_alert_word_w(word, widths, em){
    let w = 0
    for c in word.to_chars() {
        if c >= 32 && c <= 126 { w = w + widths[c - 32] }
        else if c == 8220 || c == 8221 { w = w + widths[95] }
        else if c == 8216 || c == 8217 { w = w + widths[96] }
        else { w = w + em }
    }
    w
}
fn desk_alert_para(para, widths, em){
    let words = para.split(" ")
    if words.len() < 3 { return para }
    let line_w = 0
    let line_n = 0
    let start = 0
    let before = -1
    for i word in words {
        let w = desk_alert_word_w(word, widths, em)
        if line_n > 0 && line_w + widths[0] + w > 228 {
            before = start
            start = i
            line_w = w
            line_n = 1
        } else {
            if line_n > 0 { line_w = line_w + widths[0] + w } else { line_w = w }
            line_n = line_n + 1
        }
    }
    // One word on the last line, and the line before it has one to spare.
    if before < 0 || line_n != 1 || start - before < 2 { return para }
    let out = ""
    for i word in words {
        if i == 0 { out = word }
        else if i == start - 1 { out = out + "\n" + word }
        else { out = out + " " + word }
    }
    out
}
// `title`: the alert's title (UiAlertTitle), else what it says (UiAlertNote). Elsewhere the
// words wrap as they fall: other desktops' sheets are wider.
fn desk_alert_words(text, title){
    if !ui_unified { return text }
    let widths = if title { desk_alert_title_w } else { desk_alert_note_w }
    let em = if title { 13 } else { 11 }
    let out = ""
    for p para in ("" + text).split("\n") {
        if p > 0 { out = out + "\n" }
        out = out + desk_alert_para(para, widths, em)
    }
    out
}
fn desk_alert(p){
    View{width: Fill height: Fill flow: Overlay
        CalDim{}
        CalSheetPlace{
            // A Mac's alerts share one layout (UiAlertPanel): the app's icon on top, the words
            // centred, two buttons side by side with the default on the right.
            if ui_unified {
                UiAlertPanel{
                    if ui_alert_icon { UiAlertIcon{app: "os.calendar" width: 64 height: 64} }
                    UiAlertTitle{text: desk_alert_words("Delete “" + p.row.title + "”?", true)}
                    UiAlertNote{text: "This removes the event from your calendar, and its card from Glance.\nYou can't undo this."}
                    UiAlertRow{
                        CalDanger{width: Fill reset_hover_on_click: true text: "Delete" on_click: || desk_delete()}
                        UiPrimary{width: Fill key_default: true key_cancel: true reset_hover_on_click: true text: "Cancel" on_click: || desk_keep()}
                    }
                }
            } else {
                CalSheet{width: if ui_alert_icon { 430 } else { 360 }
                    // A Mac alert: the app's icon beside its words.
                    View{width: Fill height: Fit flow: Right spacing: 14
                        if ui_alert_icon { UiAlertIcon{app: "os.calendar" width: 52 height: 52} }
                        View{width: Fill height: Fit flow: Down spacing: 6
                            CalSheetTitle{text: "Delete “" + p.row.title + "”?"}
                            CalSheetNote{text: "This removes the event from your calendar, and its card from Glance. You can't undo this."}
                        }
                    }
                    CalSheetButtons{
                        CalDanger{text: "Delete" on_click: || desk_delete()}
                        UiPrimary{key_default: true key_cancel: true text: "Cancel" on_click: || desk_keep()}
                    }
                }
            }
        }
    }
}
// The popover edits the event in place, as Calendar's does: no Save or Cancel. A typed field
// is saved on Return or once another is used, a control at once, the rest on close.
fn desk_editor(p, top){
    if ui_unified { return desk_editor_mac(p, top) }
    let f = dk.form
    let note = desk_status_of(f)
    CalPop{width: cal_edit_w nav_group: true margin: Inset{left: p.x top: top} padding: Inset{left: 16 right: 16 top: 14 bottom: 14} spacing: 8
        UiFormLine{
            CalKey{text: "Title:"}
            e_title := CalField{text: f.title empty_text: "New Event" on_change: |text| desk_typed("title", text) on_return: |text| desk_returned()}
        }
        UiFormLine{
            CalKey{text: "Location:"}
            e_place := CalField{text: f.place empty_text: "Add Location" on_change: |text| desk_typed("place", text) on_return: |text| desk_returned()}
        }
        UiFormLine{height: 28
            CalKey{text: "All-day:"}
            e_allday := GestureView{width: 20 height: 28 on_tap: |x, y| desk_form_all(!dk.form.all)
                View{width: Fill height: Fill flow: Right align: Align{y: 0.5} cal_check(f.all)}
            }
        }
        UiFormLine{
            CalKey{text: "Starts:"}
            View{width: 128 height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
                e_date := UiPopup{width: Fill text: cal_long(f.sd) on_click: || desk_date_menu("start")}
                UiPopupMark{}
            }
            if !f.all {
                View{width: Fill height: 28 flow: Right spacing: 3
                    e_start := CalField{text: f.st on_change: |text| desk_start_typed(text) on_return: |text| desk_returned()}
                    cal_stepper("start")
                }
            }
        }
        UiFormLine{
            CalKey{text: "Ends:"}
            View{width: 128 height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
                e_end_date := UiPopup{width: Fill text: cal_long(f.ed) on_click: || desk_date_menu("end")}
                UiPopupMark{}
            }
            if !f.all {
                View{width: Fill height: 28 flow: Right spacing: 3
                    e_end := CalField{text: f.et empty_text: "None" on_change: |text| desk_end_typed(text) on_return: |text| desk_returned()}
                    cal_stepper("end")
                }
            }
        }
        if !f.all {
            UiFormLine{
                CalKey{text: "Time zone:"}
                View{width: Fill height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
                    zone_pick := GestureView{width: Fill height: 28 menu_words_at: 10 on_menu: |title| desk_zone_chosen(title)
                        e_zone := UiPopup{width: Fill text: cal_zone_name(f.zone) on_click: || desk_zone_menu()}
                    }
                    UiPopupMark{}
                }
            }
        }
        UiFormLine{
            CalKey{text: "Glance:"}
            UiButton{text: "Show in Glance" on_click: || desk_glance()}
            detail_status := CalNote{width: Fill flow: Flow.Right{wrap: true} text: if p.status != "" { p.status } else { "Adds a card for this event." }}
        }
        View{width: Fill height: Fit flow: Right spacing: 8
            // A label's margin counts twice: this puts its baseline on the first line's.
            CalKey{margin: Inset{top: 3} text: "Notes:"}
            e_notes := CalField{is_multiline: true height: 70 text: f.notes empty_text: "Add Notes" on_change: |text| desk_typed("notes", text)}
        }
        // What is wrong with a change, or what became of it: there only when there is something to say.
        status_box := View{visible: note != "" width: Fill height: Fit flow: Down spacing: 6
            edit_status := CalNote{width: Fill flow: Flow.Right{wrap: true} text: note draw_text +: {color: ui_danger}}
            edit_actions := View{visible: f.error != "" || f.gone width: Fill height: Fit flow: Right spacing: 8 align: Align{x: 1.0 y: 0.5}
                UiButton{text: "Discard Changes" on_click: || desk_discard_failed_edit()}
                edit_retry := UiPrimary{visible: f.error != "" && !f.gone text: "Try Again" on_click: || desk_retry_edit()}
            }
        }
    }
}
// A Mac's popover, as Calendar's: the title first, large and bold, beside its calendar's
// colour, the place under it, then the date and time, Glance and the notes. The service
// keeps no repeat, alert or invitees, so the popover offers none. It stands as tall as
// the labelled one (cal_edit_h).
fn desk_editor_mac(p, top){
    let f = dk.form
    let note = desk_status_of(f)
    let when = desk_when_open()
    // As Calendar's: the title and the place as words, when in one line that opens its rows, then
    // the notes. Calendar's Alert, Repeat, Travel Time, Invitees, URL and Attachments rows are
    // left out: the calendar service keeps none of them.
    CalPop{width: cal_edit_w nav_group: true margin: Inset{left: p.x top: top} padding: Inset{left: 16 right: 16 top: 14 bottom: 14} spacing: 8
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            e_title := CalTitleField{text: f.title empty_text: "New Event" on_change: |text| desk_typed("title", text) on_return: |text| desk_returned()}
            RoundedView{width: 12 height: 12 margin: Inset{right: 2} show_bg: true draw_bg +: {color: ui_link border_radius: 3.0}}
        }
        e_place := CalBareField{text: f.place empty_text: "Add Location" on_change: |text| desk_typed("place", text) on_return: |text| desk_returned()}
        UiSep{}
        if !when {
            View{width: Fill height: Fit
                e_when := CalWhen{text: desk_when_line(f) on_click: || desk_when_expand()}
            }
        }
        if when {
            View{width: Fill height: Fit flow: Down spacing: 8
                UiFormLine{height: 28
                    CalKey{text: "All-day:"}
                    e_allday := GestureView{width: 20 height: 28 on_tap: |x, y| desk_form_all(!dk.form.all)
                        View{width: Fill height: Fill flow: Right align: Align{y: 0.5} cal_check(f.all)}
                    }
                }
                UiFormLine{
                    CalKey{text: "Starts:"}
                    View{width: 128 height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
                        e_date := UiPopup{width: Fill text: cal_long(f.sd) on_click: || desk_date_menu("start")}
                        UiPopupMark{}
                    }
                    if !f.all {
                        View{width: Fill height: 28 flow: Right spacing: 3
                            e_start := CalField{text: f.st on_change: |text| desk_start_typed(text) on_return: |text| desk_returned()}
                            cal_stepper("start")
                        }
                    }
                }
                UiFormLine{
                    CalKey{text: "Ends:"}
                    View{width: 128 height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
                        e_end_date := UiPopup{width: Fill text: cal_long(f.ed) on_click: || desk_date_menu("end")}
                        UiPopupMark{}
                    }
                    if !f.all {
                        View{width: Fill height: 28 flow: Right spacing: 3
                            e_end := CalField{text: f.et empty_text: "None" on_change: |text| desk_end_typed(text) on_return: |text| desk_returned()}
                            cal_stepper("end")
                        }
                    }
                }
                if !f.all {
                    UiFormLine{
                        CalKey{text: "Time zone:"}
                        View{width: Fill height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
                            zone_pick := GestureView{width: Fill height: 28 menu_words_at: 10 on_menu: |title| desk_zone_chosen(title)
                                e_zone := UiPopup{width: Fill text: cal_zone_name(f.zone) on_click: || desk_zone_menu()}
                            }
                            UiPopupMark{}
                        }
                    }
                }
            }
        }
        UiSep{}
        e_notes := CalBareField{is_multiline: true height: 52 text: f.notes empty_text: "Add Notes" on_change: |text| desk_typed("notes", text)}
        UiFormLine{
            CalKey{text: "Glance:"}
            UiButton{text: "Show in Glance" on_click: || desk_glance()}
            detail_status := CalNote{width: Fill flow: Flow.Right{wrap: true} text: if p.status != "" { p.status } else { "Adds a card for this event." }}
        }
        // What is wrong with a change, or what became of it: there only when there is something to say.
        status_box := View{visible: note != "" width: Fill height: Fit flow: Down spacing: 6
            edit_status := CalNote{width: Fill flow: Flow.Right{wrap: true} text: note draw_text +: {color: ui_danger}}
            edit_actions := View{visible: f.error != "" || f.gone width: Fill height: Fit flow: Right spacing: 8 align: Align{x: 1.0 y: 0.5}
                UiButton{text: "Discard Changes" on_click: || desk_discard_failed_edit()}
                edit_retry := UiPrimary{visible: f.error != "" && !f.gone text: "Try Again" on_click: || desk_retry_edit()}
            }
        }
    }
}
// A Mac popover's arrow: 20 points at its base, 10 out from the popover's edge.
fn desk_beak(p){
    if p.side == "bottom" {
        return View{width: 20 height: 10 flow: Overlay new_batch: true margin: Inset{left: p.aim - 10 top: p.edge - 1}
            Svg{width: 20 height: 10 animating: false draw_svg +: {svg: cal_beak_down color: ui_border}}
            Svg{width: 20 height: 10 margin: Inset{top: -1.4} animating: false draw_svg +: {svg: cal_beak_down color: cal_pop_face}}
        }
    }
    if p.side == "top" {
        return View{width: 20 height: 10 flow: Overlay new_batch: true margin: Inset{left: p.aim - 10 top: p.y - 9}
            Svg{width: 20 height: 10 animating: false draw_svg +: {svg: cal_beak_up color: ui_border}}
            Svg{width: 20 height: 10 margin: Inset{top: 1.4} animating: false draw_svg +: {svg: cal_beak_up color: cal_pop_face}}
        }
    }
    let top = p.aim - 10 - p.y
    if p.side == "" || top < 10 || top > desk_pop_height(p) - 30 { return View{width: 0 height: 0} }
    let left = p.side == "left"
    View{width: 10 height: 20 flow: Overlay new_batch: true margin: Inset{left: if left { p.x - 9 } else { p.x + cal_edit_w - 1 } top: p.y + top}
        Svg{width: 10 height: 20 animating: false draw_svg +: {svg: if left { cal_beak_left } else { cal_beak_right } color: ui_border}}
        Svg{width: 10 height: 20 margin: Inset{left: if left { 1.4 } else { -1.4 }} animating: false draw_svg +: {svg: if left { cal_beak_left } else { cal_beak_right } color: cal_pop_face}}
    }
}
fn desk_popover(){
    let p = dk.pop
    if p == nil { return View{width: 0 height: 0} }
    if p.mode == "delete" { return desk_alert(p) }
    if p.side == "bottom" {
        // Above what it is about: its lower edge stays on the beak however tall it grows.
        return View{width: Fill height: Fill flow: Overlay
            View{width: Fill height: Fill flow: Down align: Align{y: 1.0} padding: Inset{bottom: max(0, dk.h - p.edge)}
                desk_editor(p, 0)
            }
            desk_beak(p)
        }
    }
    View{width: Fill height: Fill flow: Overlay
        desk_editor(p, p.y)
        desk_beak(p)
    }
}
fn cal_check(on){
    if on {
        RoundedView{width: 14 height: 14 align: Align{x: 0.5 y: 0.5} new_batch: true show_bg: true draw_bg +: {color: ui_link border_radius: 2.0}
            Svg{width: 12 height: 12 animating: false draw_svg +: {svg: ui_icon("check") color: if ui_light { #xffffff } else { #x1e1e1e }}}
        }
    } else {
        RoundedView{width: 14 height: 14 show_bg: true draw_bg +: {color: ui_field border_size: 1.0 border_color: cal_box_line border_radius: 2.0}}
    }
}
fn desk_cal_box(){
    if dk.show_cal {
        RoundedView{width: 14 height: 14 align: Align{x: 0.5 y: 0.5} new_batch: true show_bg: true draw_bg +: {color: ui_link border_radius: 2.0}
            Svg{width: 12 height: 12 animating: false draw_svg +: {svg: ui_icon("check") color: if ui_light { #xffffff } else { #x1e1e1e }}}
        }
    } else {
        RoundedView{width: 14 height: 14 show_bg: true draw_bg +: {color: #x00000000 border_size: 1.0 border_color: ui_link border_radius: 2.0}}
    }
}

let DeskRoot = SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: ui_content
    cal_keys := GestureView{width: 1 height: 1 on_key: |key, cmd, shift| desk_key(key, cmd, shift)}
    View{width: Fill height: Fill flow: Right
        side_wrap := View{width: Fit height: Fill flow: Right
            UiSidebar{
                CalHead{text: "Calendars"}
                GestureView{width: Fill height: 28 on_tap: |x, y| desk_toggle_cal()
                    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 8 right: 8}
                        cal_box := View{width: 14 height: 14 on_render: || { desk_cal_box() }}
                        UiRowTitle{text: "My Calendar"}
                    }
                }
                // A Mac's Calendar lists its calendars here, with the month under them; the
                // day's events are in the grid. Another desktop keeps the day's list.
                if ui_unified {
                    View{width: Fill height: Fill}
                } else {
                    // Named in a pane of their own: a branch holds one widget.
                    View{width: Fill height: Fill flow: Down
                        day_title := CalHead{text: ""}
                        events_box := View{width: Fill height: Fill flow: Overlay
                            events_scroll := ScrollYView{width: Fill height: Fill flow: Down
                                events := View{width: Fill height: Fit flow: Down new_batch: true on_render: || {
                                    let rows = desk_agenda_rows()
                                    for i r in rows {
                                        if i > 0 { UiSep{margin: Inset{left: 8 right: 8}} }
                                        desk_agenda_row(r, i)
                                    }
                                    if rows.len() == 0 {
                                        View{width: Fill height: max(120, dk.h - 400) flow: Down align: Align{x: 0.5 y: 0.5} spacing: 4 padding: Inset{left: 12 right: 12}
                                            Label{clip_y: false padding: 0 text: if dk.show_cal { "No Events" } else { "Calendar Hidden" } draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75}}}
                                            CalNote{width: Fill align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: if dk.show_cal { "Double-click a day or click + to add one." } else { "Turn on My Calendar to see its events." }}
                                            if !dk.show_cal { UiButton{margin: Inset{top: 6} text: "Show Calendar" on_click: || desk_toggle_cal()} }
                                        }
                                    }
                                }}
                            }
                        }
                        UiSep{margin: Inset{top: 6 bottom: 6}}
                    }
                }
                View{width: Fill height: 22 flow: Right align: Align{y: 0.5} padding: Inset{left: 8}
                    mini_title := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 8.25}}}
                    View{width: Fill height: 1}
                    CalMiniTool{draw_icon +: {svg: ui_icon("chevron-left")} on_click: || desk_mini_nav(-1)}
                    CalMiniTool{draw_icon +: {svg: ui_icon("chevron-right")} on_click: || desk_mini_nav(1)}
                }
                mini := View{width: 189 height: Fit margin: Inset{left: 1} flow: Flow.Right{wrap: true} new_batch: true on_item_tap: |i| desk_mini_tap(i) on_render: || {
                    for name in cal_heads_letter {
                        View{width: 27 height: 18 align: Align{x: 0.5 y: 0.5} CalSmallNum{text: name draw_text +: {color: ui_muted}}}
                    }
                    for c in desk_mini_cells() { desk_small_cell(c, c.m == dk.mini_m, 27, 22, false) }
                }}
            }
            UiVSep{}
        }
        View{width: Fill height: Fill flow: Down
            UiToolbar{
                View{width: Fill height: Fill flow: Right align: Align{y: 0.5} spacing: 4
                    lights_room := View{visible: false width: 72 height: 1}
                    UiPaneTool{draw_icon +: {svg: ui_icon("sidebar")} on_click: || desk_toggle_side()}
                    CalNamedTool{text: "+ Event" draw_icon +: {svg: ui_icon("plus")} on_click: || desk_new_event(dk.day, 540, desk_from_tool())}
                }
                segs := UiSegments{new_batch: true on_render: || {
                    for v in cal_views {
                        if v.id == dk.view { CalSegOn{text: v.name on_click: || desk_set_view(v.id)} }
                        else { UiSeg{text: v.name on_click: || desk_set_view(v.id)} }
                    }
                }}
                View{width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5}
                    View{width: Fill{max: 170} height: 28 flow: Overlay align: Align{y: 0.5}
                        search := UiSearch{padding: Inset{left: 26 right: 8 top: 7.5 bottom: 4.5} empty_text: "Search" on_change: |text| desk_search_changed(text) on_escape: |text| { desk_search_clear(); ui.cal_keys.focus() }}
                        UiGlyph{width: 14 height: 14 margin: Inset{left: 8} draw_svg +: {svg: ui_icon("search")}}
                        View{width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5} padding: Inset{right: 4}
                            search_x := CalMiniTool{visible: false width: 24 height: 24 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: ui_icon("search-clear") color: ui_muted} on_click: || desk_search_clear()}
                        }
                    }
                }
            }
            UiSep{}
            View{width: Fill height: Fill flow: Right
                View{width: Fill height: Fill flow: Overlay
                    load_pane := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5}
                        Label{clip_y: false padding: 0 text: "Loading Your Calendar…" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
                    }
                    fail_pane := View{visible: false width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 6 padding: 24
                        Svg{width: 36 height: 36 margin: Inset{bottom: 4} animating: false draw_svg +: {svg: ui_icon("calendar") color: ui_muted}}
                        Label{clip_y: false padding: 0 text: "Can't Load Your Calendar" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 11.25}}}
                        fail_note := Label{clip_y: false padding: 0 text: "Calendar couldn't read your events." draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
                        UiButton{margin: Inset{top: 8} text: "Try Again" on_click: || desk_retry()}
                    }
                    View{width: Fill height: Fill flow: Down
                        head_pane := View{visible: false width: Fill height: cal_head_h flow: Right align: Align{y: 0.5} spacing: 6 padding: Inset{left: 14 right: 12}
                            month_title := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 16.5}}}
                            year_title := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 16.5}}}
                            View{width: Fill height: 1}
                            nav_box := RoundedView{width: Fit height: 28 flow: Right align: Align{y: 0.5} new_batch: true show_bg: true
                                draw_bg +: {color: ui_button border_size: 1.0 border_color: ui_border border_radius: 3.0}
                                on_render: || {
                                    CalNavPart{width: 28 draw_icon +: {svg: ui_icon("chevron-left")} on_click: || desk_nav(-1)}
                                    UiVSep{}
                                    CalNavPart{width: 58 text: "Today" on_click: || desk_goto(dk.today)}
                                    UiVSep{}
                                    CalNavPart{width: 28 draw_icon +: {svg: ui_icon("chevron-right")} on_click: || desk_nav(1)}
                                }
                            }
                        }
                        month_pane := View{visible: false width: Fill height: Fill flow: Down
                            View{width: Fill height: cal_days_h flow: Right spacing: 1
                                for name in cal_heads_short {
                                    View{width: Fill height: Fill align: Align{x: 1.0 y: 0.5} padding: Inset{right: 6} CalNote{text: name}}
                                }
                            }
                            UiSep{}
                            SolidView{width: Fill height: Fill flow: Down spacing: 1 new_batch: true draw_bg.color: ui_border
                                w0 := CalWeek{on_item_tap: |col| desk_cell_tap(0, col) on_render: || { for c in desk_cells(0) { desk_cell(c) } }}
                                w1 := CalWeek{on_item_tap: |col| desk_cell_tap(1, col) on_render: || { for c in desk_cells(1) { desk_cell(c) } }}
                                w2 := CalWeek{on_item_tap: |col| desk_cell_tap(2, col) on_render: || { for c in desk_cells(2) { desk_cell(c) } }}
                                w3 := CalWeek{on_item_tap: |col| desk_cell_tap(3, col) on_render: || { for c in desk_cells(3) { desk_cell(c) } }}
                                w4_wrap := View{width: Fill height: Fill
                                    w4 := CalWeek{on_item_tap: |col| desk_cell_tap(4, col) on_render: || { for c in desk_cells(4) { desk_cell(c) } }}
                                }
                                w5_wrap := View{width: Fill height: Fill
                                    w5 := CalWeek{on_item_tap: |col| desk_cell_tap(5, col) on_render: || { for c in desk_cells(5) { desk_cell(c) } }}
                                }
                            }
                        }
                        week_pane := View{visible: false width: Fill height: Fill flow: Down
                            wk_head_wrap := View{width: Fill height: 26
                                wk_head := View{width: Fill height: Fill flow: Right new_batch: true on_render: || {
                                    View{width: cal_gutter height: Fill}
                                    for c in dk.cols {
                                        let p = cal_civil(c.o)
                                        let date = c.date
                                        View{width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5} spacing: 4 padding: Inset{right: 6}
                                            CalNote{text: cal_day_short[cal_weekday(c.o)] draw_text +: {text_style: theme.font_regular{font_size: 9.75}}}
                                            desk_number("" + p.d, date, true)
                                        }
                                    }
                                }}
                            }
                            wk_all := View{width: Fill height: Fit flow: Right new_batch: true on_render: || {
                                View{width: cal_gutter height: Fit padding: Inset{top: 4 bottom: 4 right: 6} align: Align{x: 1.0}
                                    CalNote{text: "all-day"}
                                }
                                for c in dk.cols {
                                    let lines = desk_band_lines(c)
                                    let shown = if lines.len() > 3 { 2 } else { lines.len() }
                                    let hidden = 0
                                    for i r in lines { if i >= shown && r != nil { hidden = hidden + 1 } }
                                    let date = c.date
                                    View{width: Fill height: Fit flow: Down clip_x: false spacing: 1 padding: Inset{left: 2 right: 2 top: 2 bottom: 2}
                                        View{width: Fill height: 0}
                                        for i r in lines {
                                            if i < shown {
                                                if r == nil { View{width: Fill height: 18} } else { desk_bar(r, c, dk.cols.len() - 1, -1) }
                                            }
                                        }
                                        if hidden > 0 { CalMore{padding: Inset{left: 5} text: "+" + hidden + " more" on_click: || desk_show_day(date)} }
                                    }
                                }
                            }}
                            UiSep{}
                            wk_scroll := ScrollYView{width: Fill height: Fill flow: Down
                                View{width: Fill height: Fit flow: Overlay
                                    wk_lines := View{width: Fill height: Fit flow: Down on_render: || {
                                        for h in desk_hours() {
                                            View{width: Fill height: cal_hour flow: Right
                                                View{width: cal_gutter height: 16 flow: Right align: Align{x: 1.0 y: 0.5} padding: Inset{right: 6}
                                                    CalNote{text: if h == dk.near_hour { "" } else { cal_hour_label(h) }}
                                                }
                                                SolidView{width: Fill height: 1 margin: Inset{top: 8} draw_bg.color: cal_line}
                                            }
                                        }
                                        View{width: Fill height: 16}
                                    }}
                                    now_mark := View{width: cal_gutter height: Fit new_batch: true on_render: || { desk_now_label() }}
                                    View{width: Fill height: Fit flow: Right new_batch: true padding: Inset{left: cal_gutter}
                                        c0w := View{width: Fill height: Fit c0 := CalCol{on_render: || { desk_col_view(0) }}}
                                        c1w := View{width: Fill height: Fit c1 := CalCol{on_render: || { desk_col_view(1) }}}
                                        c2w := View{width: Fill height: Fit c2 := CalCol{on_render: || { desk_col_view(2) }}}
                                        c3w := View{width: Fill height: Fit c3 := CalCol{on_render: || { desk_col_view(3) }}}
                                        c4w := View{width: Fill height: Fit c4 := CalCol{on_render: || { desk_col_view(4) }}}
                                        c5w := View{width: Fill height: Fit c5 := CalCol{on_render: || { desk_col_view(5) }}}
                                        c6w := View{width: Fill height: Fit c6 := CalCol{on_render: || { desk_col_view(6) }}}
                                    }
                                }
                            }
                        }
                        year_pane := ScrollYView{visible: false width: Fill height: Fill flow: Down spacing: 14 padding: Inset{left: 20 right: 20 top: 2 bottom: 16}
                            View{width: Fill height: Fit flow: Right spacing: 22
                                y0 := CalCol{on_render: || { desk_year_month(1) }}
                                y1 := CalCol{on_render: || { desk_year_month(2) }}
                                y2 := CalCol{on_render: || { desk_year_month(3) }}
                                y3 := CalCol{on_render: || { desk_year_month(4) }}
                            }
                            View{width: Fill height: Fit flow: Right spacing: 22
                                y4 := CalCol{on_render: || { desk_year_month(5) }}
                                y5 := CalCol{on_render: || { desk_year_month(6) }}
                                y6 := CalCol{on_render: || { desk_year_month(7) }}
                                y7 := CalCol{on_render: || { desk_year_month(8) }}
                            }
                            View{width: Fill height: Fit flow: Right spacing: 22
                                y8 := CalCol{on_render: || { desk_year_month(9) }}
                                y9 := CalCol{on_render: || { desk_year_month(10) }}
                                y10 := CalCol{on_render: || { desk_year_month(11) }}
                                y11 := CalCol{on_render: || { desk_year_month(12) }}
                            }
                        }
                    }
                }
                // A Mac's Day view: the month and the chosen event beside the day (desk_day_info).
                day_info_wrap := View{visible: false width: Fit height: Fill flow: Right
                    UiVSep{}
                    SolidView{width: cal_info_w - 1 height: Fill flow: Down draw_bg.color: ui_content
                        day_info := View{width: Fill height: Fill flow: Down new_batch: true on_render: || { desk_day_info() }}
                    }
                }
                found_wrap := View{visible: false width: Fit height: Fill flow: Right
                    UiVSep{}
                    SolidView{width: 280 height: Fill flow: Down draw_bg.color: ui_content
                        ScrollYView{width: Fill height: Fill flow: Down
                            results := View{width: Fill height: Fit flow: Down new_batch: true padding: Inset{top: 6 bottom: 6} on_render: || {
                                for i r in dk.found {
                                    if i > 0 { UiSep{margin: Inset{left: 14 right: 14}} }
                                    desk_found_row(r, i)
                                }
                                if dk.found.len() == 0 {
                                    UiEmpty{height: max(200, dk.h - cal_bar_h - 13)
                                        glyph +: {draw_svg +: {svg: ui_icon("search")}}
                                        title +: {text: "No Results"}
                                        note +: {width: Fill align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: "No events match “" + dk.search + "”."}
                                        UiButton{margin: Inset{top: 8} text: "Clear Search" on_click: || desk_search_clear()}
                                    }
                                }
                            }}
                        }
                    }
                }
            }
        }
    }
    // Metal builds a shader's pipeline in the background on first use, and a draw skips
    // it until then: naming the popover's face here, as the window opens, keeps the first
    // popover from showing its words with nothing behind them.
    CalPop{visible: false width: 1 height: 1}
    pop_layer := View{visible: false width: Fill height: Fill flow: Overlay new_batch: true
        GestureView{width: Fill height: Fill on_tap: |x, y| desk_scrim_tap()
            View{width: Fill height: Fill}
        }
        pop_host := View{width: Fill height: Fill flow: Down on_render: || { desk_popover() }}
    }
    menu_layer := View{visible: false width: Fill height: Fill flow: Overlay new_batch: true
        GestureView{width: Fill height: Fill on_tap: |x, y| desk_close_menu()
            View{width: Fill height: Fill}
        }
        menu_host := View{width: Fill height: Fill flow: Down on_render: || { desk_menu() }}
    }
    zone_layer := View{visible: false width: Fill height: Fill flow: Overlay new_batch: true
        CalDim{}
        CalSheetPlace{
            CalSheet{width: 380
                CalSheetTitle{text: "Time Zone"}
                CalSheetNote{text: "Choose a city in the time zone this event keeps."}
                View{width: Fill height: 28 flow: Overlay align: Align{y: 0.5}
                    zone_search := UiSearch{padding: Inset{left: 26 right: 8 top: 7.5 bottom: 4.5} empty_text: "City or Country"
                        on_change: |text| desk_zone_typed(text) on_return: |text| desk_zone_done() on_escape: |text| desk_zone_close()}
                    UiGlyph{width: 14 height: 14 margin: Inset{left: 8} draw_svg +: {svg: ui_icon("search")}}
                }
                RoundedView{width: Fill height: 220 flow: Down new_batch: true show_bg: true
                    draw_bg +: {color: ui_field border_size: 1.0 border_color: ui_border border_radius: 4.0}
                    zone_scroll := ScrollYView{width: Fill height: Fill flow: Down
                        zone_rows := View{width: Fill height: Fit flow: Down padding: 4 new_batch: true on_render: || {
                            let z = dk.zone_find
                            if z == nil {
                                View{width: Fill height: 0}
                            } else if z.rows.len() == 0 {
                                View{width: Fill height: 200 flow: Down align: Align{x: 0.5 y: 0.5}
                                    Label{clip_y: false padding: 0 text: "No Results" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
                                }
                            } else {
                                View{width: Fill height: Fit flow: Down
                                    for i m in z.rows { desk_zone_row(m, i, i == z.at) }
                                }
                            }
                        }}
                    }
                }
                CalSheetButtons{
                    UiButton{key_cancel: true text: "Cancel" on_click: || desk_zone_close()}
                    UiPrimary{key_default: true text: "Choose" on_click: || desk_zone_done()}
                }
            }
        }
    }
    add_fail_layer := View{visible: false width: Fill height: Fill flow: Overlay new_batch: true
        CalDim{}
        CalSheetPlace{
            if ui_unified {
                UiAlertPanel{
                    if ui_alert_icon { UiAlertIcon{app: "os.calendar" width: 64 height: 64} }
                    add_fail_title := UiAlertTitle{text: "Couldn't Add Event"}
                    add_fail_note := UiAlertNote{text: "The event wasn't added. Check the time or available storage, then try again."}
                    UiAlertRow{
                        add_fail_cancel := UiButton{width: Fill key_cancel: true reset_hover_on_click: true text: "Cancel" on_click: || desk_cancel_failed_add()}
                        add_fail_retry := UiPrimary{width: Fill key_default: true reset_hover_on_click: true text: "Try Again" on_click: || desk_retry_failed_add()}
                    }
                }
            } else {
                CalSheet{width: if ui_alert_icon { 430 } else { 360 }
                    View{width: Fill height: Fit flow: Right spacing: 14
                        if ui_alert_icon { UiAlertIcon{app: "os.calendar" width: 52 height: 52} }
                        View{width: Fill height: Fit flow: Down spacing: 6
                            add_fail_title := CalSheetTitle{text: "Couldn't Add Event"}
                            add_fail_note := CalSheetNote{text: "The event wasn't added. Check the time or available storage, then try again."}
                        }
                    }
                    CalSheetButtons{
                        add_fail_cancel := UiButton{key_cancel: true text: "Cancel" on_click: || desk_cancel_failed_add()}
                        add_fail_retry := UiPrimary{key_default: true text: "Try Again" on_click: || desk_retry_failed_add()}
                    }
                }
            }
        }
    }
}

if ui_desk { DeskRoot{} } else { TouchRoot{} }
