{
  "schema": 1,
  "tools": [
    {
      "name": "calendar.events",
      "description": "List the person's calendar events, soonest first: id, title, start, end, location and notes. Times are local, like 2026-10-02T15:00. Filter with from and to (a time or a date); limit caps the list. Entries may include request_id for retry deduplication. These are OctoSense local events, not a Google Calendar account. A returned timezone belongs to that event; from/to filters use device local time unless RFC3339 offsets are supplied. This is the same store displayed by the Calendar app month/day views.",
      "input_schema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 32
          },
          "to": {
            "type": "string",
            "maxLength": 32
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "events"
        ]
      },
      "risk": "read",
      "background": true,
      "private_data": true,
      "implemented_by": "host-service",
      "shareable": true
    },
    {
      "name": "calendar.add_event",
      "description": "Add an event to the person's calendar. start (and end) are local times like 2026-10-02T15:00, or a date like 2026-10-02 for the whole day. Answers the new event's id. For retries supply the same stable request_id and exact event fields; it reuses the saved event. Changed fields with that key are refused instead of duplicating it. This is OctoSense local storage, not Google Calendar sync. Supply timezone (IANA, e.g. America/Los_Angeles) to preserve the event wall time independently of device settings. Missing timezone uses device local time. Do not guess an unspecified end.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "start": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "end": {
            "type": "string",
            "maxLength": 32
          },
          "location": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 600
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "title",
          "start"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "start": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service",
      "shareable": true
    },
    {
      "name": "calendar.update_event",
      "description": "Edit one saved Calendar event, keeping its id and original request_id. First read calendar.events and pass that exact event as expected; a stale snapshot is refused. Supply the full replacement title, start, end (omit if unknown), timezone, location and notes. This updates the same Calendar UI record and quietly refreshes its existing event cards. It does not send invites or sync Google Calendar.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "start": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "end": {
            "type": "string",
            "maxLength": 32
          },
          "location": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 600
          },
          "timezone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "expected": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "expected",
          "title",
          "start"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "event": {
            "type": "object"
          }
        },
        "required": [
          "event"
        ]
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service"
    },
    {
      "name": "calendar.remove_event",
      "description": "Remove an event from the person's calendar by its id (from calendar.events). It is gone for good, so the person approves it.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "removed": {
            "type": "boolean"
          }
        },
        "required": [
          "removed"
        ]
      },
      "risk": "destructive",
      "confirm": "host",
      "background": true,
      "implemented_by": "host-service"
    },
    {
      "name": "calendar.notify",
      "description": "Show an event on the person's glance screen as an event card, with a notification: name one of the calendar's events by its id (event), or give a title and when (a local time like 2026-10-02T15:00, or words), with a location and notes if any. Calendar draws the card. The same card_id replaces an earlier card. A saved event card opens that exact event in Calendar. An identical live saved-event publication is reused without another notification; edits in Calendar refresh its card.",
      "input_schema": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "maxLength": 80
          },
          "when": {
            "type": "string",
            "maxLength": 80
          },
          "location": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 600
          },
          "card_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string"
          },
          "replaced": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "integer"
          }
        },
        "required": [
          "card_id"
        ]
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service",
      "shareable": true
    },
    {
      "name": "calendar.agenda",
      "description": "Put the person's agenda on the glance screen: a card with the next three events within days (7 by default), with a notification. It replaces the previous agenda card.",
      "input_schema": {
        "type": "object",
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string"
          },
          "replaced": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "integer"
          }
        },
        "required": [
          "card_id"
        ]
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service"
    }
  ]
}
