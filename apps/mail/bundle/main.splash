// The compose sheet's form: a label in a right-aligned column, the field, a hairline.
let ComposeLine = View{width: Fill height: 32 flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 16 right: 16}}
let ComposeRule = UiSep{margin: Inset{left: 16 right: 16}}
