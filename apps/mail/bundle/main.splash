// BEGIN shared app interface
// Shared system-app interface. Run tools/sync-app-interface.py after editing.
// Bundles carry this prelude so they work in the contained standalone host too.
// Resolve the current theme after a host restyle, not a retained prelude alias.
let theme = mod.theme
// A desktop shell's style sheet says `ui_pointer = true`: the app gets pointer
// metrics and the Mac layouts (13-point text, 28-point controls, a sidebar and
// a toolbar). Anything else, a phone or a bare host, keeps the touch metrics.
let ui_desk = try { theme.ui_pointer == true } catch { false }
// A Mac's window has no title bar over an app that says so to the shell
// (crates/shell/src/clients.rs, unified_chrome): the app draws to the window's top
// edge, its toolbar is 52 points tall, and the lights sit over the leading 84 points
// of the toolbar, or over the top of a sidebar. Other desktops keep a title bar.
let ui_unified = ui_desk && try { theme.ui_unified == true } catch { false }
fn ui_by(touch, desk){ if ui_desk { desk } else { touch } }
let ui_ink = theme.color_text
let ui_page = theme.color_bg_app
let ui_light = dot(ui_ink, #x36b61200) < 0.5
let ui_surface = if ui_light { #xffffff } else { mix(ui_page, ui_ink, ui_by(0.06, 0.07)) }
let ui_field = if ui_desk && ui_light { #xffffff } else { mix(ui_page, ui_ink, ui_by(0.075, 0.07)) }
let ui_hover = mix(ui_page, ui_ink, ui_by(0.12, 0.07))
let ui_border = mix(ui_page, ui_ink, ui_by(0.22, 0.14))
let ui_muted = mix(ui_ink, ui_page, ui_by(0.24, 0.26))
// The Mac's system colours where the page is a Mac's, near white or near black;
// a retro style's mid-gray page keeps text that is mostly ink.
let ui_lum = dot(ui_page, #x36b61200)
let ui_mac = ui_desk && (ui_lum > 0.86 || ui_lum < 0.25)
let ui_link = if ui_mac { if ui_light { #x0060c0 } else { #x6cb8ff } } else { mix(ui_ink, #x356bce, 0.25) }
let ui_primary = ui_by(#x285cd6, #x0071e3)
let ui_success = if ui_mac { if ui_light { #x1a7030 } else { #x30d158 } } else { mix(ui_ink, #x28a55b, 0.20) }
let ui_danger = if ui_mac { if ui_light { #xc70012 } else { #xffa097 } } else { mix(ui_ink, #xe13b53, 0.20) }
// The Mac's surfaces: a sidebar and a toolbar a shade off the page, a selection
// in the sidebar's own gray, a push button's face.
let ui_sidebar = mix(ui_page, ui_ink, 0.03)
let ui_bar = if ui_light { #xededf0 } else { #x303033 }
let ui_selected = mix(ui_page, ui_ink, 0.11)
let ui_button = if ui_light { #xffffff } else { mix(ui_page, ui_ink, 0.16) }
// What a list or a document sits on: white in the light; in the dark, darker than
// the window around it, as a Mac's content is.
let ui_content = if ui_mac { if ui_light { #xffffff } else { #x1e1e1e } } else { ui_surface }
// A selected row: the accent when it is the row the person is on, white text on it.
let ui_accent_row = if ui_light { #x0064d2 } else { #x0a60c8 }
// A Mac dims the window behind a sheet, more in the dark; the shell's own sheets
// and the native apps' dim as much.
let ui_sheet_dim = if ui_light { #x00000024 } else { #x00000052 }
// A touch size in the type scale; on the desktop, the Mac's size for that role
// (Makepad's font_size is three quarters of a point).
fn ui_fs(n){
    if !ui_desk { return n }
    if n <= 12 { return 8.25 }
    if n <= 13 { return 9 }
    if n <= 16 { return 9.75 }
    if n <= 18 { return 11.25 }
    if n <= 21 { return 12.75 }
    if n <= 24 { return 13.5 }
    if n <= 28 { return 16.5 }
    19.5
}
let ui_icons = {}
fn ui_icon(name){
    let handle = ui_icons[name]
    if handle == nil {
        handle = http_resource("{{assets}}/icons/ui-" + name + ".svg")
        ui_icons[name] = handle
    }
    handle
}
let UiButton = ButtonFlat{height: ui_by(44, 28) margin: 0 padding: Inset{left: ui_by(14, 12) right: ui_by(14, 12)} spacing: 6
    icon_walk: Walk{width: 15 height: 15}
    draw_bg +: {border_radius: ui_by(12.0, 3.0) border_size: ui_by(0.0, 1.0) border_color: ui_border
        color: ui_by(#x00000000, ui_button) color_hover: ui_by(ui_hover, mix(ui_button, ui_ink, 0.04)) color_down: ui_by(ui_field, mix(ui_button, ui_ink, 0.1)) color_focus: ui_by(ui_hover, ui_button)}
    draw_text +: {color: ui_by(ui_link, ui_ink) color_hover: ui_by(ui_link, ui_ink) color_down: ui_by(ui_link, ui_ink) color_focus: ui_by(ui_link, ui_ink)
        text_style: ui_by(theme.font_bold{font_size: 14}, theme.font_regular{font_size: 9.75})}
    draw_icon +: {color: ui_ink}
}
let UiPrimary = UiButton{
    draw_bg +: {border_size: 0.0 color: ui_primary color_hover: ui_by(#x3468df, #x006edb) color_down: ui_by(#x204cb8, #x0060c0) color_focus: ui_by(#x204cb8, ui_primary)}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}
    draw_icon +: {color: #xffffff}
}
let UiPill = UiButton{height: ui_by(44, 24) padding: Inset{left: ui_by(14, 10) right: ui_by(14, 10)}
    draw_bg +: {color: ui_by(ui_surface, #x00000000) border_size: 0.0 border_radius: ui_by(22.0, 3.0)}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink}}
let UiField = TextInput{width: Fill height: ui_by(48, 28) margin: 0 padding: Inset{left: ui_by(14, 8) right: ui_by(14, 8) top: ui_by(12, 6) bottom: ui_by(12, 6)}
    draw_bg +: {color: ui_field color_hover: ui_field color_focus: ui_field color_empty: ui_field
        border_color: ui_border border_color_hover: ui_by(ui_link, ui_border) border_color_focus: ui_link border_color_empty: ui_border border_radius: ui_by(12.0, 3.0)}
    draw_text +: {color: ui_ink color_hover: ui_ink color_focus: ui_ink color_empty: ui_muted color_empty_hover: ui_muted color_empty_focus: ui_muted text_style: theme.font_regular{font_size: ui_by(15, 9.75)}}
    draw_selection.color: #x557dcc55
}
let UiCard = RoundedView{width: Fill height: Fit flow: Down spacing: ui_by(12, 8) padding: ui_by(20, 14)
    show_bg: true draw_bg +: {color: ui_surface border_radius: ui_by(16.0, 5.0) border_size: ui_by(0.0, 1.0) border_color: ui_by(#x00000000, ui_border)}}
let UiCaption = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: ui_by(13, 8.25) line_spacing: 1.4}}}
let UiTitle = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: ui_by(28, 16.5) line_spacing: 1.2}}}
// The Mac's parts. They are drawn on a desktop only; a phone keeps its pages.
// A shader's border_radius is half the corner it draws: 3 is a 6-point corner.
let UiSep = SolidView{width: Fill height: 1 draw_bg.color: ui_border}
let UiVSep = SolidView{width: 1 height: Fill draw_bg.color: ui_border}
let UiGlyph = Svg{width: 16 height: 16 animating: false draw_svg +: {color: ui_muted}}
let UiTool = ButtonFlat{height: 28 margin: 0 padding: Inset{left: 8 right: 8} spacing: 5 icon_walk: Walk{width: 16 height: 16}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
    draw_icon +: {color: ui_ink}
}
let UiToolIcon = UiTool{width: 30 padding: 0 spacing: 0 text: ""}
// A tool whose click hides it or the pane it sits on: it comes back unwashed.
let UiPaneTool = UiToolIcon{reset_hover_on_click: true}
// The clear button inside a search field, shown while it holds text.
let UiSearchClear = UiPaneTool{visible: false width: 24 height: 24 icon_walk: Walk{width: 14 height: 14}
    draw_bg +: {color_hover: #x00000000 color_down: #x00000000}
    draw_icon +: {svg: ui_icon("search-clear") color: ui_muted}}
let UiToolbar = SolidView{width: Fill height: if ui_unified { 52 } else { 40 } flow: Right align: Align{y: 0.5} spacing: 4 padding: Inset{left: 12 right: 10} draw_bg.color: ui_bar}
// A toolbar that starts at the window's leading edge, with no sidebar beside it.
let UiWindowToolbar = UiToolbar{padding: Inset{left: if ui_unified { 84 } else { 12 } right: 10}}
let UiBarTitle = Label{clip_y: false padding: 0 text: "" max_lines: 1 draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 11.25}}}
let UiBarSub = Label{clip_y: false padding: 0 text: "" max_lines: 1 draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
let UiSidebar = SolidView{width: 208 height: Fill flow: Down padding: Inset{left: 8 right: 8 top: if ui_unified { 52 } else { 8 } bottom: 8} spacing: 1 draw_bg.color: ui_sidebar}
let UiSideHead = Label{padding: Inset{left: 8 top: 12 bottom: 4} text: "" draw_text +: {color: ui_muted text_style: theme.font_bold{font_size: 8.25}}}
let UiSideRow = ButtonFlat{width: Fill height: 28 margin: 0 padding: Inset{left: 8 right: 8} spacing: 7 align: Align{x: 0.0 y: 0.5}
    icon_walk: Walk{width: 16 height: 16} label_walk: Walk{width: Fill height: Fit}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: #x00000000 color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
    draw_icon +: {color: ui_link}
}
let UiSideRowOn = UiSideRow{draw_bg +: {color: ui_selected color_hover: ui_selected color_focus: ui_selected}}
let UiSeg = ButtonFlat{height: 24 margin: 0 padding: Inset{left: 12 right: 12}
    draw_bg +: {border_radius: 2.5 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
}
let UiSegOn = UiSeg{draw_bg +: {color: ui_button color_hover: ui_button color_focus: ui_button border_size: 1.0 border_color: ui_border}}
let UiSegments = RoundedView{width: Fit height: 28 flow: Right align: Align{y: 0.5} spacing: 2 padding: 2 show_bg: true draw_bg +: {color: ui_selected border_radius: 3.5}}
let UiSearch = UiField{padding: Inset{left: 26 right: 8 top: 6 bottom: 6}}
let UiGroup = RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: ui_surface border_radius: 5.0 border_size: 1.0 border_color: ui_border}}
let UiFormRow = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 12 padding: Inset{left: 14 right: 14 top: 8 bottom: 8}}
let UiFormLabel = Label{clip_y: false padding: 0 width: Fill text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiListRow = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10 padding: Inset{left: 14 right: 14 top: 8 bottom: 8}}
// A two-line row of a list: a line in the body size, a line under it in the small.
let UiRowTitle = Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiRowNote = Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
// A form: the label right-aligned in a 110-point column to the left of its control.
let UiFormKey = Label{clip_y: false padding: 0 width: 110 text: "" align: Align{x: 1.0} draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiFormLine = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8}
// A pop-up button: the choice, and the up-down mark at its trailing edge (an
// Overlay of this over UiPopupMark).
let UiPopup = UiButton{padding: Inset{left: 10 right: 28} align: Align{x: 0.0 y: 0.5}}
let UiPopupMark = View{width: Fit height: Fit padding: Inset{right: 8} new_batch: true
    Svg{width: 13 height: 13 animating: false draw_svg +: {svg: ui_icon("updown") color: ui_muted}}}
// A small count or state beside a name.
let UiBadge = RoundedView{width: Fit height: Fit padding: Inset{left: 6 right: 6 top: 2 bottom: 2} new_batch: true show_bg: true draw_bg +: {color: mix(ui_surface, ui_ink, 0.1) border_radius: 2.5}}
let UiBadgeText = Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 8.25}}}
// A status bar along a window's bottom: small text on the bar's colour.
let UiFootBar = SolidView{width: Fill height: 24 flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 12 right: 12} draw_bg.color: ui_bar}
// An empty list or an empty window: a glyph, a title, a line, and, under them, what
// to do about it. Centred in what the empty state fills.
let UiEmpty = View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 6 padding: 24
    glyph := Svg{width: 36 height: 36 margin: Inset{bottom: 4} animating: false draw_svg +: {color: ui_muted}}
    title := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 11.25}}}
    note := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
}
// A Mac's alert carries its app's icon, as the native apps' alerts do: 64 points
// on top in the alert below. The shell draws it in its style's frame (`ReviewAppIcon`,
// crates/shell/src/connected_review.rs; `app` is the bundle's id, "os.writer"); a host
// without the shell has none, and the alert keeps its words alone.
let UiAlertIcon = try { mod.widgets.ReviewAppIcon } catch { nil }
let ui_alert_icon = ui_mac && UiAlertIcon != nil
// A Mac's alert as macOS has drawn it since 11 (Files' Empty Trash): 260 points
// wide, the app's 64-point icon on top, the title and its words centred under it,
// then the buttons. Two sit side by side, each as wide as the other, the default
// on the right (UiAlertRow, each button `width: Fill`); three or more stand one
// over another, the default on top (UiAlertStack). A host with no app icon shows
// the words alone. Off a Mac an app keeps its own sheet.
let UiAlertPanel = RoundedShadowView{width: 260 height: Fit flow: Down align: Align{x: 0.5} padding: Inset{left: 16 right: 16 top: 20 bottom: 16} new_batch: true cursor: MouseCursor.Default
    draw_bg +: {color: ui_surface border_size: 1.0 border_color: ui_border border_radius: 10.0 shadow_color: #x00000040 shadow_radius: 18.0 shadow_offset: vec2(0.0, 4.0)}}
// A Label's margin counts twice: 10 and 6 points between icon, title and words.
let UiAlertTitle = Label{clip_y: false width: Fill padding: 0 margin: Inset{top: 5} align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75 line_spacing: 1.3}}}
let UiAlertNote = Label{clip_y: false width: Fill padding: 0 margin: Inset{top: 3} align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 8.25 line_spacing: 1.3}}}
let UiAlertRow = View{width: Fill height: Fit flow: Right spacing: 8 margin: Inset{top: 16}}
let UiAlertStack = View{width: Fill height: Fit flow: Down spacing: 8 margin: Inset{top: 16}}
// END shared app interface
let account = nil          // {id, address}
let messages = []
let total = 0
let open_id = ""
let reading = nil
let open_loading = false
let open_generation = 0
let reply_message = ""
let compose_id = ""
let compose_revision = 0
let compose_generation = 0
let preparing_review = false
let busy = false
let folder = {id: "INBOX" name: "Inbox" role: "inbox"}
let folders = []
// The Mac's window: what the list shows, how the panes stand, which sheet is up.
let query = ""
let shown = []
// While a search is up on a Mac, its scope bar says where it looks: the mailbox in front ("box") or
// every mailbox ("all"). For every mailbox, each other one's messages, from this Mac's copy and then
// from the server, by mailbox (`gathered`) and in the sidebar's order (`elsewhere`), each row carrying
// the mailbox it lives in, so whatever is done with it is done there.
let search_in = "box"
let gathered = {}
let elsewhere = []
// The mailbox the open message lives in: the one in front, or where a search of every mailbox found it.
let open_box = ""
let unread = {}
let loaded = false
let failure = ""
let refused_words = "The mail server didn't accept your password."
let open_again = nil
let narrow = false
let tight = false
let reader_short = false
let window_w = 0
let side_wanted = true
let side_open = false
// A Mac's "Message sent" at the sidebar's foot: an older one's timeout leaves a newer one up.
let desk_sent_n = 0
// Mark All Messages as Read, while its requests are out.
let desk_reading_all = false
let sheet = ""
let rows_drawn = ""
let list_seen = 600
let list_keys_given = false
let folders_drawn = ""
let compose_head = ""
let compose_quote = ""
let compose_start = ""
let compose_state = ""
// A send that failed can still be tried again from the host's own sheet: until this window starts
// another, it listens for how that one ended.
let compose_retrying = ""
let compose_timer = nil
// A review may answer after restyling has replaced the desktop script run.
let desk_review_serial = 0
let desk_review_timer = nil
let desk_review_run = 0
if ui_desk {
    desk_review_run = try { mod.mail_desk_review_run } catch { 0 }
    if desk_review_run == nil { desk_review_run = 0 }
    desk_review_run = desk_review_run + 1
}
let compose_said = ""
let compose_said_bad = false
let compose_missing_attachments = false
// The original's quote level in a reply or a forward, as a Mac's Format > Quote Level sets it:
// a bar and a "> " a level, none at 0. Elsewhere it stays 1.
let compose_level = 1
// The exact fields submitted for review; later edits are not part of that send.
let compose_sent_to = ""
let compose_sent_cc = ""
let compose_sent_subject = ""
let compose_sent_body = ""
let signing_in = false
let moving = false
let then_compose = ""
let then_compose_for = ""
let delete_target = nil
let notice_title = ""
let notice_note = ""
let notice_back = ""
let files = []
let recalled = false
let account_timer = nil
// The New Message window: one at a time, over the message pane, with the mailboxes and the list still in reach.
let composing = false
let compose_ask = false
let compose_kind = ""
let compose_folder = "INBOX"
let send_ready = false
// On a Mac, the finished addresses of To and Cc as tokens, {address, name}; what's still being typed
// stays in the field. What each field held last tells a Backspace with nothing left to delete.
let to_list = []
let cc_list = []
let to_was = ""
let cc_was = ""
let TOKENS = 8
// Whether To and Cc hold tokens. The send, the answer to its review and the window's record ask this
// (missing, it reads as no tokens), so the shell's tests can run those functions on their own.
mod.mail_desk_tokens = ui_unified
// The touch composer keeps its unfinished message while the app is restyled.
let touch_composing = false
let touch_ask = false
let touch_original_to = ""
let touch_original_subject = ""
let touch_original_body = ""
let touch_note = ""
let touch_offer_sent = false
let touch_checking_sent = false
let touch_sent_request = 0
let touch_review_timer = nil
let touch_waiting = false
let touch_sent_to = ""
let touch_sent_subject = ""
let touch_sent_body = ""
let touch_status_timer = nil
let touch_status_busy = false
let touch_status_started = 0
let touch_status_serial = 0
// Only the latest script run may poll a review; an earlier run may still
// deliver the callback that opens it after an appearance change.
let touch_run = 0
if !ui_desk {
    touch_run = try { mod.mail_touch_run } catch { 0 }
    if touch_run == nil { touch_run = 0 }
    touch_run = touch_run + 1
    mod.mail_touch_run = touch_run
}
// What the window had open when Mail last quit: the account, the mailbox, the message
// and what was being written. Mail's own storage, never another app's.
let WINDOW_FILE = "common/mail-window.json"
let kept_window = nil
let folder_kept = false
let then_open = ""
let restored = false
let keep_timer = nil
let keep_error = try { mod.mail_keep_error == true } catch { false }

fn touch_remove_blocking(){
    if ui_desk { return false }
    let saved = try { mod.mail_touch_remove } catch { nil }
    saved != nil
}
fn status(text){ ui.status.set_text(text) }
fn pane(name){
    if ui_desk {
        // The Mac's three columns stay up: the last holds the message, or says
        // why there is none.
        ui.no_account.set_visible(name == "welcome")
        ui.no_message.set_visible(name == "inbox")
        ui.loading_message.set_visible(name == "loading")
        ui.open_failed.set_visible(name == "failed")
        ui.reader.set_visible(name == "reader")
        return
    }
    ui.welcome.set_visible(name == "welcome")
    ui.inbox.set_visible(name == "inbox")
    ui.reader.set_visible(name == "reader")
    ui.composer.set_visible(name == "composer")
    ui.folders.set_visible(name == "folders")
    let saved = try { mod.mail_touch_compose } catch { nil }
    let browsing = if saved == nil { false } else { try { saved.browsing == true } catch { false } }
    if name == "inbox" {
        ui.touch_inbox_compose.set_text(if browsing { "Return to Message" } else { "Compose" })
        ui.touch_account_controls.set_visible(!browsing)
    }
    if name == "reader" {
        ui.touch_reply.set_visible(!browsing)
        ui.touch_reader_return.set_visible(browsing)
    }
}
fn load_accounts(){
    if !ui_desk && !touch_current() { return }
    if ui_desk && desk_recall() {
        restored = true
        return
    }
    if ui_desk && !restored { kept_window = desk_kept() }
    let account_generation = try { mod.mail_touch_account_generation } catch { 0 }
    if account_generation == nil { account_generation = 0 }
    host.request("mail.accounts", {}, fn(r){
        if !ui_desk && !touch_current() { return }
        let current_generation = try { mod.mail_touch_account_generation } catch { 0 }
        if current_generation == nil { current_generation = 0 }
        if !ui_desk && current_generation != account_generation { return }
        if r.is_ok && r.data.len() > 0 {
            account = r.data[0]
            if !ui_desk {
                let remembered = try { mod.mail_touch_compose } catch { nil }
                if remembered != nil {
                    for candidate in r.data { if candidate.id == remembered.account { account = candidate } }
                }
                mod.mail_touch_account = {id: account.id address: account.address}
            }
            ui.address.set_text(account.address)
            if ui_desk {
                // A sign-in or reconnect starts a new mailbox session.
                desk_next_sync_request()
                busy = false
                reading = nil
                open_id = ""
                desk_reopen()
            }
            if ui_desk || !touch_restore() { pane("inbox") }
            if !ui_desk { touch_restore_remove() }
            list()
            sync()
            load_folders()
        } else {
            let removing = if ui_desk { nil } else { try { mod.mail_touch_remove } catch { nil } }
            if removing != nil && !(try { removing.closing == true } catch { false }) {
                account = removing.account_data
                ui.address.set_text(account.address)
                pane("inbox")
                touch_restore_remove()
            } else {
                if !ui_desk && r.is_ok { mod.mail_touch_account = nil }
                pane("welcome")
            }
        }
        if ui_desk {
            restored = true
            desk_refresh()
        }
    })
}
fn desk_sign_in(args){
    ui.welcome_note.set_text("")
    signing_in = true
    desk_remember()
    host.request("mail.add_account", args, fn(r){
        signing_in = false
        desk_remember()
        if r.is_ok { load_accounts() }
        // Closing the sheet needs no answer here.
        else if !regex("cancelled|replaced").test("" + r.error) { ui.welcome_note.set_text("" + r.error) }
    })
}
fn add_account(){
    if !ui_desk && touch_remove_blocking() { return }
    if ui_desk {
        desk_sign_in({})
        return
    }
    ui.welcome_note.set_text("Sign in on the sheet OctoSense shows.")
    status("Sign in on the sheet OctoSense shows.")
    host.request("mail.add_account", {}, fn(r){
        if r.is_ok {
            // The sign-in sheet can outlive an appearance change. Its retained
            // handler must be able to finish loading the newly added account.
            if !touch_current() { touch_claim_run() }
            load_accounts()
        } else { ui.welcome_note.set_text(r.error) status(r.error) }
    })
}
// Desktop mailbox requests can outlive a switch to another folder or account.
// Each new request supersedes the earlier one, including on a return to the
// same folder. Keep the serials across an appearance change.
fn desk_next_list_request(){
    let n = try { mod.mail_desk_list_request } catch { 0 }
    if n == nil { n = 0 }
    mod.mail_desk_list_request = n + 1
    n + 1
}
fn desk_next_sync_request(){
    let n = try { mod.mail_desk_sync_request } catch { 0 }
    if n == nil { n = 0 }
    mod.mail_desk_sync_request = n + 1
    n + 1
}
fn sync(){
    if account == nil || busy { return }
    if !ui_desk && touch_remove_blocking() { return }
    busy = true
    if ui_desk {
        let request_account = account.id
        let request_folder = folder.id
        let request = desk_next_sync_request()
        failure = ""
        desk_bar()
        desk_states()
        host.request("mail.sync", {account: account.id folder: folder.id}, fn(r){
            let current = try { mod.mail_desk_sync_request } catch { nil }
            if current != request || account == nil || account.id != request_account || folder.id != request_folder { return }
            busy = false
            if r.is_ok { list() }
            else {
                failure = plain_failure(r.error)
                loaded = true
                desk_list()
            }
        })
        return
    }
    let request_account = account.id
    let request_folder = folder.id
    let request_navigation = try { mod.mail_touch_folder_generation } catch { 0 }
    status("Checking for mail…")
    host.request("mail.sync", {account: account.id folder: folder.id}, fn(r){
        busy = false
        let navigation = try { mod.mail_touch_folder_generation } catch { 0 }
        if account == nil || account.id != request_account || folder.id != request_folder || navigation != request_navigation { return }
        if r.is_ok {
            if r.data.new == 1 { status("1 new message") }
            else if r.data.new > 0 { status("" + r.data.new + " new messages") }
            else { status("Up to date") }
            list()
        } else { status(r.error) }
    })
}
fn list(){
    if account == nil { return }
    let request_account = account.id
    let request_folder = folder.id
    let request_navigation = try { mod.mail_touch_folder_generation } catch { 0 }
    let request = if ui_desk { desk_next_list_request() } else { 0 }
    host.request("mail.list", {account: account.id folder: folder.id offset: 0 limit: 100}, fn(r){
        if ui_desk {
            let current = try { mod.mail_desk_list_request } catch { nil }
            if current != request || account == nil || account.id != request_account || folder.id != request_folder { return }
        } else {
            let navigation = try { mod.mail_touch_folder_generation } catch { 0 }
            if account == nil || account.id != request_account || folder.id != request_folder || navigation != request_navigation { return }
        }
        if r.is_ok {
            if ui_desk {
                // A mailbox the person has left since asking.
                if r.data.folder != folder.id { return }
                messages = r.data.messages
                total = r.data.total
                loaded = true
                desk_list()
                // The message that was open when Mail quit opens again once its mailbox is listed.
                if then_open != "" {
                    let wanted = then_open
                    then_open = ""
                    for m in messages { if m.id == wanted { open_message(m) } }
                }
                return
            }
            messages = r.data.messages
            total = r.data.total
            ui.rows.render()
        } else if ui_desk {
            failure = plain_failure(r.error)
            loaded = true
            desk_list()
        } else { status(r.error) }
    })
}
fn touch_next_folder_generation(){
    let latest = try { mod.mail_touch_folder_generation } catch { 0 }
    if latest == nil { latest = 0 }
    mod.mail_touch_folder_generation = latest + 1
}
fn touch_forget_reading(){
    let latest = try { mod.mail_touch_read_generation } catch { 0 }
    if latest == nil { latest = 0 }
    mod.mail_touch_read_generation = latest + 1
    mod.mail_touch_reading = nil
}
fn open_message(m){
    if !ui_desk && touch_remove_blocking() { return }
    open_id = m.id
    let request_folder = folder.id
    let request_account = account.id
    let request_folder_data = folder
    let request_account_data = {id: account.id address: account.address}
    let touch_read_generation = 0
    if !ui_desk {
        touch_forget_reading()
        touch_read_generation = mod.mail_touch_read_generation
    }
    let generation = 0
    // Where it lives: the mailbox in front, or, found by a search of every mailbox, its own.
    let box = folder.id
    if ui_desk {
        box = desk_box(m)
        open_box = box
        open_generation = open_generation + 1
        generation = open_generation
        if then_compose_for != m.id { then_compose = "" then_compose_for = "" }
        // The previous message must not remain actionable while this one is
        // being read: its contents belong to a different selected row.
        reading = nil
        open_loading = true
        open_again = nil
        pane("loading")
        desk_tools()
        desk_rows()
        desk_remember()
    }
    host.request("mail.message", {account: account.id folder: box message: m.id}, fn(r){
        if ui_desk {
            // The person may have moved on since asking.
            if generation != open_generation || open_id != m.id || open_box != box || account == nil || account.id != request_account || folder.id != request_folder { return }
            open_loading = false
            if r.is_ok {
                reading = r.data
                // Archive, Delete, Reply and Save act on it where it lives.
                reading.box = box
                reading.box_name = desk_box_name(m)
                reading.box_role = desk_box_role(m)
                desk_show()
                desk_name_tokens()
                // The list may have been fetched again since the press.
                for x in messages { if x.id == m.id && box == folder.id { x.unread = false } }
                for x in elsewhere { if x.id == m.id && x.box == box { x.unread = false } }
                // Another mailbox's count in the sidebar goes down with it.
                if box != folder.id { count_unread() }
                desk_tools()
                desk_list()
                if then_compose != "" && then_compose_for == m.id {
                    let kind = then_compose
                    then_compose = ""
                    then_compose_for = ""
                    desk_compose(kind)
                }
            } else {
                reading = nil
                then_compose = ""
                then_compose_for = ""
                open_again = m
                pane("failed")
                desk_tools()
                desk_remember()
            }
            return
        }
        if touch_read_generation != mod.mail_touch_read_generation || touch_remove_blocking() { return }
        if r.is_ok {
            reading = r.data
            // The Reply control may still belong to the run before a restyle.
            mod.mail_touch_reading = {account: request_account account_data: request_account_data
                folder: request_folder_data id: m.id message: r.data}
            ui.r_subject.set_text(r.data.subject)
            ui.r_sender.set_text(r.data.sender + "  <" + r.data.address + ">")
            ui.r_time.set_text(r.data.time)
            // Formatted mail shows as the host rebuilt it: text, links and
            // lists, nothing remote.
            let formatted = r.data.html != ""
            ui.r_html.set_visible(formatted)
            ui.r_body.set_visible(!formatted)
            if formatted { ui.r_html.set_text(r.data.html) } else { ui.r_html.set_text("") ui.r_body.set_text(r.data.body) }
            let names = ""
            for a in r.data.attachments {
                if names != "" { names = names + ", " }
                names = names + a.filename + " (" + kb(a.size) + ")"
            }
            ui.r_attachments.set_visible(names != "")
            ui.r_attachments.set_text("Attachments: " + names)
            pane("reader")
            m.unread = false
        } else { status(r.error) }
    })
}
fn compose(to, subject, body){
    if touch_remove_blocking() { return false }
    // The retained inbox can receive a press before the new run's account
    // request returns. Reuse only the account last confirmed by the host.
    if account == nil { account = try { mod.mail_touch_account } catch { nil } }
    if account == nil { status("Loading your account…") return false }
    let previous = try { mod.mail_touch_compose } catch { nil }
    if previous != nil && account != nil && previous.account == account.id {
        // An older retained inbox must not replace an unfinished message.
        if (try { previous.browsing == true } catch { false }) { touch_return_message() }
        else { touch_claim_run() touch_restore() }
        return false
    }
    touch_claim_run()
    reply_message = ""
    compose_id = ""
    compose_retrying = ""
    compose_revision = 0
    touch_next_generation()
    preparing_review = false
    touch_composing = false
    touch_ask = false
    touch_original_to = to
    touch_original_subject = subject
    touch_original_body = body
    touch_note = ""
    touch_offer_sent = false
    touch_checking_sent = false
    touch_sent_request = 0
    touch_waiting = false
    touch_sent_to = ""
    touch_sent_subject = ""
    touch_sent_body = ""
    ui.c_to.set_text(to)
    ui.c_subject.set_text(subject)
    ui.c_body.set_text(body)
    ui.c_note.set_text("")
    ui.touch_discard.set_visible(false)
    touch_composing = true
    touch_sync_review()
    pane("composer")
    touch_remember()
    true
}
fn touch_stop_review_watch(){
    if touch_review_timer != nil {
        stop_timer(touch_review_timer)
        touch_review_timer = nil
    }
}
fn touch_current(){
    let current = try { mod.mail_touch_run } catch { nil }
    current == touch_run
}
// Appearance reapply can restore the old mod snapshot after the new script
// starts. Claim only if no later run has already taken over.
fn touch_claim_boot(){
    let current = try { mod.mail_touch_run } catch { 0 }
    if current == nil { current = 0 }
    if current < touch_run { mod.mail_touch_run = touch_run }
}
fn touch_claim_run(){
    touch_stop_review_watch()
    touch_stop_status_watch()
    let latest = try { mod.mail_touch_run } catch { 0 }
    if latest == nil { latest = 0 }
    touch_run = latest + 1
    mod.mail_touch_run = touch_run
}
fn touch_next_generation(){
    let latest = try { mod.mail_touch_generation } catch { 0 }
    if latest == nil { latest = 0 }
    compose_generation = latest + 1
    mod.mail_touch_generation = compose_generation
}
// A retained widget can handle input after a new run has evaluated. Give
// that handler the current review state before it acts on the draft.
fn touch_adopt(){
    let saved = try { mod.mail_touch_compose } catch { nil }
    if saved == nil { return false }
    if account == nil { account = try { saved.account_data } catch { nil } }
    if account == nil || saved.account != account.id { return false }
    if touch_composing && compose_generation != saved.generation { return false }
    if touch_current() && touch_composing && saved.generation == compose_generation { return true }
    folder = saved.folder
    open_id = saved.open
    reply_message = saved.reply
    compose_generation = saved.generation
    touch_composing = true
    preparing_review = saved.preparing
    touch_waiting = try { saved.waiting == true } catch { false }
    touch_offer_sent = try { saved.offer_sent == true } catch { false }
    touch_checking_sent = try { saved.checking_sent == true } catch { false }
    touch_sent_request = try { saved.sent_request } catch { 0 }
    compose_id = saved.compose_id
    compose_revision = saved.revision
    touch_original_to = saved.original_to
    touch_original_subject = saved.original_subject
    touch_original_body = saved.original_body
    touch_sent_to = try { saved.sent_to } catch { saved.to }
    touch_sent_subject = try { saved.sent_subject } catch { saved.subject }
    touch_sent_body = try { saved.sent_body } catch { saved.body }
    touch_ask = saved.asking
    touch_note = saved.note
    ui.c_note.set_text(touch_note)
    touch_sync_review()
    if touch_current() {
        if preparing_review { touch_watch_review() }
        else if touch_waiting { touch_watch_status() }
    }
    true
}
fn touch_sync_review(){
    let blocked = preparing_review || touch_waiting || touch_checking_sent
    ui.touch_review_on.set_visible(!blocked)
    ui.touch_review_off.set_visible(blocked)
    ui.touch_check_sent.set_visible(touch_offer_sent && !touch_checking_sent)
    ui.touch_check_sent_off.set_visible(touch_offer_sent && touch_checking_sent)
}
fn touch_stop_status_watch(){
    if touch_status_timer != nil {
        stop_timer(touch_status_timer)
        touch_status_timer = nil
    }
    touch_status_busy = false
    touch_status_serial = touch_status_serial + 1
}
fn touch_watch_status(){
    if touch_status_timer == nil { touch_status_timer = start_interval(1.0, || touch_poll_status()) }
}
// Status calls may finish after a switch, another review, or a discarded
// composer. Only the current run and its current request can change the UI.
fn touch_poll_status(){
    let saved = try { mod.mail_touch_compose } catch { nil }
    if !touch_current() || !touch_composing || !touch_waiting || account == nil || compose_id == "" ||
        saved == nil || saved.account != account.id || saved.generation != compose_generation {
        touch_stop_status_watch()
        return
    }
    if touch_status_busy && time_now() - touch_status_started < 10 { return }
    touch_status_busy = true
    touch_status_started = time_now()
    touch_status_serial = touch_status_serial + 1
    let serial = touch_status_serial
    let generation = compose_generation
    let request_account = account.id
    let request_id = compose_id
    host.request("mail.compose_status", {account: request_account compose_id: request_id}, fn(r){
        if !touch_current() || serial != touch_status_serial { return }
        touch_status_busy = false
        let saved = try { mod.mail_touch_compose } catch { nil }
        if !touch_composing || !touch_waiting || account == nil || account.id != request_account ||
            compose_generation != generation || compose_id != request_id || saved == nil ||
            saved.account != request_account || saved.generation != generation { return }
        if r.is_ok { touch_status_result(r.data.status) }
        else {
            touch_note = "Mail couldn't check the send status. Check your connection."
            ui.c_note.set_text(touch_note)
            touch_remember()
        }
    })
}
fn touch_status_result(state){
    if state != "awaiting_approval" && state != "sending" { touch_offer_sent = state == "outcome_unknown" }
    if state == "awaiting_approval" { touch_note = "Waiting for your approval." }
    else if state == "sending" { touch_note = "Sending…" }
    else if state == "accepted" {
        let unchanged = ui.c_to.text() == touch_sent_to && ui.c_subject.text() == touch_sent_subject && ui.c_body.text() == touch_sent_body
        touch_waiting = false
        touch_stop_status_watch()
        if unchanged {
            touch_discard_message()
            status("Message sent")
            return
        }
        compose_id = ""
        compose_revision = 0
        touch_note = "Message sent. Your newer changes weren't sent."
    } else if state == "draft" {
        touch_waiting = false
        touch_stop_status_watch()
        touch_note = "Not sent. You can change the message and try again."
    } else if state == "failed_before_delivery" || state == "outcome_unknown" {
        touch_waiting = false
        touch_stop_status_watch()
        compose_id = ""
        compose_revision = 0
        if state == "outcome_unknown" { touch_note = "Mail can't tell whether this was sent. Check Sent before you try again." }
        else { touch_note = "Not sent: the mail server didn't take it. Check the addresses and try again." }
    } else { return }
    ui.c_note.set_text(touch_note)
    touch_sync_review()
    if touch_ask { touch_discard_words() }
    touch_remember()
}
// The host can finish opening its review after an appearance change. The old
// callback records only the result; the current composer picks it up here.
fn touch_follow_review(){
    if !touch_current() || !touch_composing || !preparing_review {
        touch_stop_review_watch()
        return
    }
    let saved = try { mod.mail_touch_compose } catch { nil }
    if saved == nil || account == nil || saved.account != account.id || saved.generation != compose_generation {
        touch_stop_review_watch()
        return
    }
    if !saved.preparing {
        preparing_review = false
        touch_waiting = try { saved.waiting == true } catch { false }
        compose_id = saved.compose_id
        compose_revision = saved.revision
        reply_message = saved.reply
        touch_note = saved.note
        ui.c_note.set_text(touch_note)
        touch_sync_review()
        if touch_ask { touch_discard_words() }
        touch_stop_review_watch()
        if touch_waiting { touch_watch_status() }
    }
}
fn touch_watch_review(){
    if touch_review_timer == nil { touch_review_timer = start_interval(0.4, || touch_follow_review()) }
}
fn touch_remember(){
    if ui_desk { return }
    let current = try { mod.mail_touch_compose } catch { nil }
    if current != nil && (try { current.browsing == true } catch { false }) { return }
    if account == nil || !touch_composing || (current != nil && current.generation != compose_generation) {
        if !touch_adopt() { return }
    }
    if !touch_current() {
        let saved = try { mod.mail_touch_compose } catch { nil }
        if saved == nil || saved.account != account.id || saved.generation != compose_generation { return }
        saved.to = ui.c_to.text()
        saved.subject = ui.c_subject.text()
        saved.body = ui.c_body.text()
        saved.asking = touch_ask
        mod.mail_touch_compose = saved
        return
    }
    if preparing_review { touch_follow_review() }
    mod.mail_touch_compose = {account: account.id account_data: {id: account.id address: account.address} folder: folder open: open_id reply: reply_message
        to: ui.c_to.text() subject: ui.c_subject.text() body: ui.c_body.text()
        original_to: touch_original_to original_subject: touch_original_subject original_body: touch_original_body
        asking: touch_ask note: touch_note compose_id: compose_id revision: compose_revision
        generation: compose_generation preparing: preparing_review waiting: touch_waiting
        offer_sent: touch_offer_sent checking_sent: touch_checking_sent sent_request: touch_sent_request browsing: false
        sent_to: touch_sent_to sent_subject: touch_sent_subject sent_body: touch_sent_body}
}
fn touch_restore(){
    let saved = try { mod.mail_touch_compose } catch { nil }
    if !touch_current() || saved == nil || account == nil || saved.account != account.id { return false }
    folder = saved.folder
    open_id = saved.open
    reply_message = saved.reply
    compose_id = saved.compose_id
    compose_revision = saved.revision
    compose_generation = saved.generation
    let latest = try { mod.mail_touch_generation } catch { 0 }
    if latest == nil || latest < compose_generation { mod.mail_touch_generation = compose_generation }
    preparing_review = saved.preparing
    touch_waiting = try { saved.waiting == true } catch { false }
    touch_offer_sent = try { saved.offer_sent == true } catch { false }
    touch_checking_sent = try { saved.checking_sent == true } catch { false }
    touch_sent_request = try { saved.sent_request } catch { 0 }
    touch_sent_to = try { saved.sent_to } catch { saved.to }
    touch_sent_subject = try { saved.sent_subject } catch { saved.subject }
    touch_sent_body = try { saved.sent_body } catch { saved.body }
    touch_original_to = saved.original_to
    touch_original_subject = saved.original_subject
    touch_original_body = saved.original_body
    touch_note = saved.note
    touch_ask = saved.asking
    touch_composing = false
    ui.c_to.set_text(saved.to)
    ui.c_subject.set_text(saved.subject)
    ui.c_body.set_text(saved.body)
    ui.c_note.set_text(touch_note)
    if touch_ask { touch_discard_words() }
    ui.touch_discard.set_visible(touch_ask)
    touch_composing = true
    touch_sync_review()
    let browsing = try { saved.browsing == true } catch { false }
    if browsing {
        folder = try { saved.browse_folder } catch { saved.folder }
        touch_next_folder_generation()
        ui.title.set_text(folder.name)
        pane("inbox")
    } else { pane("composer") }
    if preparing_review { touch_watch_review() }
    else if touch_waiting { touch_watch_status() }
    true
}
// Looking in Sent keeps this message in memory, including its original reply
// source. The mailbox request may finish after a restyle or a discard.
fn touch_check_sent(){
    if !touch_adopt() || !touch_offer_sent || touch_checking_sent || account == nil { return }
    if !touch_current() { touch_claim_run() }
    touch_checking_sent = true
    let latest = try { mod.mail_touch_sent_serial } catch { 0 }
    if latest == nil { latest = 0 }
    touch_sent_request = latest + 1
    mod.mail_touch_sent_serial = touch_sent_request
    touch_note = "Opening Sent…"
    ui.c_note.set_text(touch_note)
    touch_sync_review()
    touch_remember()
    let generation = compose_generation
    let request_account = account.id
    let serial = touch_sent_request
    host.request("mail.folders", {account: request_account}, fn(r){
        touch_finish_sent(request_account, generation, serial, r)
    })
    start_timeout(10.0, || touch_finish_sent(request_account, generation, serial, {is_ok: false}))
}
fn touch_finish_sent(request_account, generation, serial, r){
    let saved = try { mod.mail_touch_compose } catch { nil }
    if saved == nil || saved.account != request_account || saved.generation != generation ||
        !(try { saved.checking_sent == true } catch { false }) || saved.sent_request != serial { return }
    if !touch_current() {
        touch_claim_run()
        if !touch_restore() { return }
    } else if !touch_adopt() { return }
    touch_checking_sent = false
    let sent = nil
    if r.is_ok {
        for f in r.data { if sent == nil && (try { f.role == "sent" } catch { false }) { sent = f } }
        for f in r.data { if sent == nil && regex("^sent", "i").test("" + f.name) { sent = f } }
    }
    if sent == nil {
        touch_note = if r.is_ok { "Mail can't tell whether this was sent. Couldn't find Sent for this account." } else { "Mail can't tell whether this was sent. Couldn't open Sent; check your connection and try again." }
        ui.c_note.set_text(touch_note)
        touch_sync_review()
        touch_remember()
        return
    }
    touch_note = "Mail can't tell whether this was sent. Check Sent before you try again."
    ui.c_note.set_text(touch_note)
    touch_sync_review()
    touch_remember()
    saved = try { mod.mail_touch_compose } catch { nil }
    if saved == nil || saved.generation != generation || saved.account != request_account { return }
    saved.browsing = true
    saved.browse_folder = sent
    mod.mail_touch_compose = saved
    open_folder(sent)
}
fn touch_return_message(){
    let saved = try { mod.mail_touch_compose } catch { nil }
    if saved == nil || !(try { saved.browsing == true } catch { false }) || !touch_adopt() { return }
    saved.browsing = false
    mod.mail_touch_compose = saved
    if !touch_current() { touch_claim_run() }
    touch_forget_reading()
    if !touch_restore() { return }
    // Refresh the original mailbox underneath the editor, not the Sent list.
    touch_next_folder_generation()
    ui.title.set_text(folder.name)
    messages = []
    ui.rows.render()
    list()
    sync()
}
fn touch_compose_action(){
    if touch_remove_blocking() { return }
    let saved = try { mod.mail_touch_compose } catch { nil }
    if saved != nil && (try { saved.browsing == true } catch { false }) { touch_return_message() }
    else { compose("", "", "") }
}
fn touch_cancel(){
    if !touch_adopt() || touch_ask { return }
    if preparing_review || touch_waiting || ui.c_to.text() != touch_original_to ||
        ui.c_subject.text() != touch_original_subject || ui.c_body.text() != touch_original_body {
        touch_ask = true
        touch_discard_words()
        ui.touch_discard.set_visible(true)
        touch_remember()
    } else { touch_discard_message() }
}
fn touch_discard_words(){
    let note = "Your changes won't be kept."
    if preparing_review || touch_waiting { note = "Your changes won't be kept. This doesn't cancel a send review." }
    ui.touch_discard_note.set_text(note)
}
fn touch_keep_editing(){
    if !touch_adopt() { return }
    touch_ask = false
    ui.touch_discard.set_visible(false)
    touch_remember()
}
fn touch_discard_message(){
    if !touch_adopt() { return }
    touch_composing = false
    touch_ask = false
    touch_stop_review_watch()
    touch_stop_status_watch()
    touch_next_generation()
    preparing_review = false
    touch_waiting = false
    mod.mail_touch_compose = nil
    ui.touch_discard.set_visible(false)
    back_to_inbox()
}
fn reply(){
    if touch_remove_blocking() { return }
    let saved = try { mod.mail_touch_reading } catch { nil }
    if saved == nil || (account != nil && account.id != saved.account) { return }
    if account == nil { account = saved.account_data }
    folder = saved.folder
    open_id = saved.id
    reading = saved.message
    if reading == nil { return }
    let subject = reading.subject
    if subject.search("Re:") != 0 { subject = "Re: " + subject }
    if !compose(reading.address, subject, "\n\n> " + reading.body.replace("\n", "\n> ")) { return }
    reply_message = open_id
    touch_remember()
}
fn send(){
    if !touch_adopt() || account == nil || preparing_review || touch_waiting || touch_checking_sent { return }
    if !touch_current() { touch_claim_run() }
    touch_offer_sent = false
    preparing_review = true
    let generation = compose_generation
    let request_account = account.id
    touch_sent_to = ui.c_to.text()
    touch_sent_subject = ui.c_subject.text()
    touch_sent_body = ui.c_body.text()
    touch_note = "Preparing review…"
    ui.c_note.set_text(touch_note)
    touch_sync_review()
    // Mark the saved request pending before reconciling it: the previous
    // snapshot described an idle composer, not a completed new request.
    let saved = try { mod.mail_touch_compose } catch { nil }
    if saved != nil && saved.generation == generation {
        saved.preparing = true
        saved.note = touch_note
        mod.mail_touch_compose = saved
    }
    touch_remember()
    touch_watch_review()
    let args = {account: account.id to: ui.c_to.text() subject: ui.c_subject.text() body: ui.c_body.text() folder: folder.id message: reply_message}
    // A first send has no draft to revise yet.
    if compose_id != "" {
        args.compose_id = compose_id
        args.expected_revision = compose_revision
    }
    host.request("mail.review_send", args, fn(r){
        if generation != compose_generation { return }
        let saved = try { mod.mail_touch_compose } catch { nil }
        if saved == nil || saved.generation != generation || saved.account != request_account { return }
        if r.is_ok {
            saved.compose_id = r.data.compose_id
            saved.revision = r.data.revision
            saved.waiting = true
            saved.note = "Waiting for your approval."
        } else if args.message != "" && saved.compose_id == "" && regex("no such reply source", "i").test("" + r.error) {
            // The source was moved or deleted. The person can review the same
            // words as a new message, without implying it remains threaded.
            saved.reply = ""
            saved.waiting = false
            saved.note = "The original message is no longer available. Review this as a new message."
        } else {
            saved.waiting = false
            saved.note = plain_send_failure(r.error)
        }
        saved.preparing = false
        mod.mail_touch_compose = saved
        if touch_current() { touch_follow_review() }
    })
}
fn touch_restore_remove(){
    if ui_desk { return false }
    let saved = try { mod.mail_touch_remove } catch { nil }
    let draft = try { mod.mail_touch_compose } catch { nil }
    if saved == nil || draft != nil || (try { saved.closing == true } catch { false }) { return false }
    if account == nil { account = saved.account_data }
    if account == nil || account.id != saved.account { return false }
    ui.touch_remove_error.set_text(saved.note)
    ui.touch_remove_error.set_visible(saved.note != "")
    ui.touch_remove_progress.set_text(saved.progress)
    ui.touch_remove_progress.set_visible(saved.pending)
    ui.touch_remove_confirm.set_visible(!saved.pending)
    ui.touch_remove_confirm_off.set_visible(saved.pending)
    ui.touch_remove_keep.set_visible(!saved.pending)
    ui.touch_remove_keep_off.set_visible(saved.pending)
    ui.touch_remove_overlay.set_visible(true)
    true
}
fn touch_ask_remove(){
    let draft = try { mod.mail_touch_compose } catch { nil }
    if draft != nil { return }
    let active = try { mod.mail_touch_account } catch { nil }
    if active != nil { account = active }
    if account == nil { return }
    let existing = try { mod.mail_touch_remove } catch { nil }
    if existing != nil { touch_restore_remove() return }
    if !touch_current() { touch_claim_run() }
    // A message requested from the inbox before this sheet opened must not
    // take over the screen after the person decides to keep the account.
    touch_forget_reading()
    let latest = try { mod.mail_touch_remove_generation } catch { 0 }
    if latest == nil { latest = 0 }
    mod.mail_touch_remove_generation = latest + 1
    mod.mail_touch_remove = {account: account.id account_data: {id: account.id address: account.address}
        generation: latest + 1 serial: 0 pending: false note: "" progress: ""}
    touch_restore_remove()
}
fn touch_keep_account(){
    let saved = try { mod.mail_touch_remove } catch { nil }
    if saved == nil || saved.pending || (try { saved.closing == true } catch { false }) { return }
    saved.closing = true
    mod.mail_touch_remove = saved
    touch_hide_remove(saved.generation)
}
// Keep the shield through the click that closed the sheet, so the same
// release cannot activate a message underneath it.
fn touch_hide_remove(generation){
    start_timeout(0.1, || {
        let current = try { mod.mail_touch_remove } catch { nil }
        if current != nil && current.generation == generation &&
            (try { current.closing == true } catch { false }) {
            mod.mail_touch_remove = nil
            ui.touch_remove_overlay.set_visible(false)
        }
    })
}
fn touch_confirm_remove(){
    let saved = try { mod.mail_touch_remove } catch { nil }
    if saved == nil || saved.pending || (try { saved.closing == true } catch { false }) { return }
    if !touch_current() { touch_claim_run() }
    account = saved.account_data
    let latest = try { mod.mail_touch_remove_serial } catch { 0 }
    if latest == nil { latest = 0 }
    mod.mail_touch_remove_serial = latest + 1
    saved.serial = latest + 1
    saved.pending = true
    saved.note = ""
    saved.progress = "Removing account…"
    mod.mail_touch_remove = saved
    touch_restore_remove()
    let request_account = saved.account
    let generation = saved.generation
    let serial = saved.serial
    remove_account()
    start_timeout(10.0, || touch_remove_slow(request_account, generation, serial))
}
fn touch_remove_slow(request_account, generation, serial){
    let saved = try { mod.mail_touch_remove } catch { nil }
    if saved == nil || saved.account != request_account || saved.generation != generation ||
        saved.serial != serial || !saved.pending { return }
    saved.progress = "Removal is taking longer than expected. It may still finish."
    mod.mail_touch_remove = saved
    if !touch_current() { touch_claim_run() }
    account = saved.account_data
    pane("inbox")
    touch_restore_remove()
}
fn touch_remove_finished(request_account, generation, serial, r){
    let saved = try { mod.mail_touch_remove } catch { nil }
    if saved == nil || saved.account != request_account || saved.generation != generation ||
        saved.serial != serial || !saved.pending { return }
    if !touch_current() { touch_claim_run() }
    account = saved.account_data
    if !r.is_ok {
        saved.pending = false
        saved.note = "Mail couldn't finish removing this account. Try again."
        saved.progress = ""
        mod.mail_touch_remove = saved
        ui.address.set_text(account.address)
        pane("inbox")
        touch_restore_remove()
        return
    }
    next_folders_request()
    saved.pending = false
    saved.closing = true
    mod.mail_touch_remove = saved
    let account_generation = try { mod.mail_touch_account_generation } catch { 0 }
    if account_generation == nil { account_generation = 0 }
    mod.mail_touch_account_generation = account_generation + 1
    mod.mail_touch_account = nil
    mod.mail_touch_compose = nil
    touch_forget_reading()
    touch_next_folder_generation()
    touch_composing = false
    touch_waiting = false
    touch_checking_sent = false
    touch_offer_sent = false
    touch_stop_review_watch()
    touch_stop_status_watch()
    account = nil
    messages = []
    folders = []
    folder = {id: "INBOX" name: "Inbox" role: "inbox"}
    open_id = ""
    ui.title.set_text("Inbox")
    ui.welcome_note.set_text("")
    touch_hide_remove(generation)
    pane("welcome")
}
fn remove_account(){
    if account == nil { return }
    let request_account = account.id
    let generation = 0
    let serial = 0
    if !ui_desk {
        let saved = try { mod.mail_touch_remove } catch { nil }
        if saved == nil || !saved.pending || saved.account != request_account { return }
        generation = saved.generation
        serial = saved.serial
    }
    host.request("mail.remove_account", {account: account.id}, fn(r){
        if !ui_desk { touch_remove_finished(request_account, generation, serial, r) return }
        if !r.is_ok {
            ui.remove_note.set_text("Mail couldn't remove this account. Try again.")
            return
        }
        if account == nil || account.id != request_account { return }
        next_folders_request()
        desk_next_sync_request()
        busy = false
        account = nil
        messages = []
        folders = []
        folder = {id: "INBOX" name: "Inbox" role: "inbox"}
        if ui_desk {
            open_id = ""
            reading = nil
            open_loading = false
            open_generation = open_generation + 1
            then_compose = ""
            then_compose_for = ""
            open_again = nil
            then_open = ""
            unread = {}
            failure = ""
            loaded = false
            search_in = "box"
            gathered = {}
            elsewhere = []
            desk_next_gather()
            ui.box_title.set_text("Inbox")
            desk_scope_bar()
            if composing { compose_close() }
            // Nothing of the account stays: not the window it had open, nor what was being written.
            try { fs.remove(WINDOW_FILE) } catch { nil }
            desk_sheet("")
            pane("welcome")
            desk_refresh()
            return
        }
    })
}
fn back_to_inbox(){
    if !ui_desk && touch_remove_blocking() { return }
    if !ui_desk { touch_forget_reading() }
    pane("inbox")
    ui.rows.render()
}
fn kb(n){
    if n > 1000000 { return "" + floor(n / 100000) / 10 + " MB" }
    return "" + (floor(n / 1000) + 1) + " KB"
}
fn next_folders_request(){
    let n = try { mod.mail_folders_request } catch { 0 }
    if n == nil { n = 0 }
    mod.mail_folders_request = n + 1
    n + 1
}
fn load_folders(){
    if account == nil { return }
    let request_account = account.id
    let request = next_folders_request()
    host.request("mail.folders", {account: request_account}, fn(r){
        let current = try { mod.mail_folders_request } catch { nil }
        if current != request || account == nil || account.id != request_account { return }
        if r.is_ok {
            folders = r.data
            if ui_desk {
                // A mailbox kept from the last time that the server no longer has: the Inbox instead.
                if folder_kept {
                    folder_kept = false
                    let found = false
                    for f in folders { if f.id == folder.id { found = true } }
                    if !found && folders.len() > 0 {
                        let inbox = folders[0]
                        for f in folders { if f.role == "inbox" { inbox = f } }
                        open_folder(inbox)
                    }
                }
                desk_folders()
                desk_rows()
                desk_remember()
                count_unread()
            } else { ui.folder_rows.render() }
        }
    })
}
fn show_folders(){
    if !ui_desk && touch_remove_blocking() { return }
    pane("folders"); ui.folder_rows.render()
}
fn open_folder(f){
    if ui_desk {
        if sheet != "" { return }
        // A pending sync belongs to the old mailbox and must not keep the new
        // one from refreshing or overwrite its state when it finishes.
        desk_next_sync_request()
        busy = false
        folder = f
        // A search goes on in the mailbox chosen, as a Mac's Mail's does.
        search_in = "box"
        gathered = {}
        elsewhere = []
        desk_next_gather()
        messages = []
        open_id = ""
        reading = nil
        open_loading = false
        open_generation = open_generation + 1
        then_compose = ""
        then_compose_for = ""
        open_again = nil
        loaded = false
        failure = ""
        total = 0
        ui.box_title.set_text(f.name)
        desk_scope_bar()
        pane("inbox")
        desk_tools()
        desk_list()
        if account != nil {
            list()
            sync()
        }
        return
    }
    if touch_remove_blocking() { return }
    touch_forget_reading()
    touch_next_folder_generation()
    let saved = try { mod.mail_touch_compose } catch { nil }
    if saved != nil && (try { saved.browsing == true } catch { false }) {
        saved.browse_folder = f
        mod.mail_touch_compose = saved
    }
    folder = f
    messages = []
    open_id = ""
    ui.title.set_text(f.name)
    pane("inbox")
    ui.rows.render()
    list()
    sync()
}

// What the rest of this file leaves to the Mac's window: its panes, its toolbar
// and its sheets. Nothing below runs on a phone.
let months = ["Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"]
let capitals = {a: "A" b: "B" c: "C" d: "D" e: "E" f: "F" g: "G" h: "H" i: "I" j: "J" k: "K" l: "L" m: "M"
    n: "N" o: "O" p: "P" q: "Q" r: "R" s: "S" t: "T" u: "U" v: "V" w: "W" x: "X" y: "Y" z: "Z"}
let specials = ["\\" "." "*" "+" "?" "(" ")" "[" "]" "{" "}" "|" "^" "$"]
fn plural(n, one){
    if n == 1 { return "1 " + one }
    "" + n + " " + one + "s"
}
fn sender_name(m){
    let name = ("" + m.sender).trim()
    if name == "" { return "" + m.address }
    name
}
// The names (or, without one, the addresses) a To line holds, with commas between.
fn recipient_names(list){
    let names = ""
    for one in list.replace(regex(";", "g"), ",").split(",") {
        let parts = one.trim().split("<")
        let name = parts[0].replace(regex("\"", "g"), "").trim()
        if name == "" && parts.len() > 1 { name = parts[1].replace(regex(">", "g"), "").trim() }
        if name != "" {
            if names != "" { names = names + ", " }
            names = names + name
        }
    }
    names
}
// Whom a desk row names: its sender, or in Sent and Drafts whom it was written to,
// as Mail's Sent mailbox lists them.
fn row_name(m){
    let role = desk_box_role(m)
    if role != "sent" && role != "drafts" { return sender_name(m) }
    let names = if m.to == nil { "" } else { recipient_names("" + m.to) }
    if names == "" { return sender_name(m) }
    names
}
fn first_letter(word){
    let found = regex("^(.)").exec(word)
    if found == nil { return "" }
    let letter = found.captures[1]
    let capital = capitals[letter]
    if capital != nil { return capital }
    letter
}
fn initials_of(name){
    let words = ("" + name).trim().split(regex("\\s+"))
    if words.len() < 2 { return first_letter(words[0]) }
    first_letter(words[0]) + first_letter(words[words.len() - 1])
}
// "Sep 25, 2026 at 9:00 AM" in this Mac's time zone, from the date the message
// carries; the list's short date when it carries none that reads.
fn when(m){
    let iso = "" + m.date
    let at = regex("^([0-9]+)-([0-9]+)-([0-9]+)[T ]([0-9]+):([0-9]+)").exec(iso)
    if at == nil { return "" + m.time }
    let y = at.captures[1].to_f64()
    let mo = at.captures[2].to_f64()
    let d = at.captures[3].to_f64()
    let h = at.captures[4].to_f64()
    let mi = at.captures[5].to_f64()
    // Days from the civil calendar to 1970.
    let yy = if mo <= 2 { y - 1 } else { y }
    let era = floor(yy / 400)
    let yoe = yy - era * 400
    let mp = if mo > 2 { mo - 3 } else { mo + 9 }
    let doy = floor((153 * mp + 2) / 5) + d - 1
    let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
    let t = (era * 146097 + doe - 719468) * 86400 + h * 3600 + mi * 60
    let zone = regex("([+-])([0-9][0-9]):?([0-9][0-9])$").exec(iso)
    if zone != nil {
        let off = zone.captures[2].to_f64() * 3600 + zone.captures[3].to_f64() * 60
        if zone.captures[1] == "+" { t = t - off } else { t = t + off }
    }
    let l = local_time(t)
    let hour = l.hour % 12
    if hour == 0 { hour = 12 }
    let minute = if l.minute < 10 { "0" + l.minute } else { "" + l.minute }
    let half = if l.hour < 12 { " AM" } else { " PM" }
    months[l.month - 1] + " " + l.day + ", " + l.year + " at " + hour + ":" + minute + half
}
// A preview that opens with the subject says it twice.
fn row_preview(m){
    let text = ("" + m.preview).trim()
    let rest = text.strip_prefix("" + m.subject)
    if rest != text { text = rest.trim() }
    text
}
fn plain_failure(error){
    if regex("password|sign.?in|login|auth|rejected", "i").test("" + error) { return refused_words }
    "Check your connection and try again."
}
fn plain_send_failure(error){
    let e = "" + error
    if regex("isn't an email address|at most|Enter a recipient", "i").test(e) { return e }
    if regex("Subject must", "i").test(e) { return "This subject is too long." }
    if regex("body must", "i").test(e) { return "This message is too long to send. Shorten it and try again." }
    "Mail couldn't prepare this message. Try again."
}
fn escape(text){
    let out = "" + text
    for c in specials {
        let parts = out.split(c)
        if parts.len() > 1 {
            let joined = parts[0]
            for i in parts.len() - 1 { joined = joined + "\\" + c + parts[i + 1] }
            out = joined
        }
    }
    out
}
// What a search reads in a message: who it's from and to, its subject and its first words.
fn desk_words(m){
    let written_to = if m.to == nil { "" } else { "" + m.to }
    "" + m.sender + "\n" + m.address + "\n" + written_to + "\n" + m.subject + "\n" + m.preview
}
fn find_messages(){
    if query == "" { return messages }
    let wanted = regex(escape(query), "i")
    let found = []
    for m in messages {
        let written_to = if m.to == nil { "" } else { "" + m.to }
        if wanted.test("" + m.sender) || wanted.test("" + m.address) || wanted.test(written_to) || wanted.test("" + m.subject) || wanted.test("" + m.preview) { found.push(m) }
    }
    if !desk_all() { return found }
    // Then every other mailbox's, in the sidebar's order. Gmail keeps a message in its mailboxes and
    // in All Mail at once, and All Mail comes last: a message is listed once.
    let gmail = desk_role("all") != nil
    let seen = {}
    for m in found { if gmail { seen[desk_same(m)] = true } }
    for m in elsewhere {
        if wanted.test(m.words) {
            let key = desk_same(m)
            if !gmail || seen[key] == nil {
                if gmail { seen[key] = true }
                found.push(m)
            }
        }
    }
    found
}
fn desk_same(m){ "" + m.address + "\n" + m.subject + "\n" + m.time }
fn set_query(text){
    let was = query
    query = ("" + text).trim()
    ui.search_clear.set_visible(query != "")
    // A new search of every mailbox looks through them again.
    if ui_unified && was == "" && query != "" && search_in == "all" { desk_gather() }
    desk_scope_bar()
    desk_list()
}
// The mailbox a listed message lives in: the one in front, or, for one a search of every mailbox
// found, its own. Reading a field a message doesn't carry stops a function: these ask first.
fn desk_box(m){
    let box = try { m.box } catch { nil }
    if box == nil { return folder.id }
    box
}
fn desk_box_name(m){
    let name = try { m.box_name } catch { nil }
    if name == nil { return folder.name }
    name
}
fn desk_box_role(m){
    let role = try { m.box_role } catch { nil }
    if role == nil { return desk_role_of(folder) }
    "" + role
}
fn desk_role_of(f){ try { "" + f.role } catch { "" } }
// The open message: its id, and where it lives.
fn desk_is_open(m){ open_id != "" && m.id == open_id && desk_box(m) == open_box }
fn desk_same_row(a, b){ a.id == b.id && desk_box(a) == desk_box(b) }
// A Mac's search scope bar, while a search is up: All Mailboxes, or the mailbox in front.
fn desk_all(){ ui_unified && query != "" && search_in == "all" }
fn desk_scope(to){
    if !ui_unified || sheet != "" || signing_in || to == search_in { return }
    search_in = to
    if search_in == "all" { desk_gather() }
    desk_scope_bar()
    desk_list()
}
fn desk_scope_bar(){
    if !ui_unified { return }
    let all = search_in == "all"
    ui.scope_bar.set_visible(query != "")
    ui.scope_all.set_visible(!all)
    ui.scope_all_on.set_visible(all)
    ui.scope_box.set_text(folder.name)
    ui.scope_box_on.set_text(folder.name)
    ui.scope_box.set_visible(all)
    ui.scope_box_on.set_visible(!all)
    ui.list_none_note.set_text(if all { "No messages in any mailbox match your search." } else { "No messages in this mailbox match your search." })
}
fn desk_next_gather(){
    let n = try { mod.mail_desk_gather } catch { 0 }
    if n == nil { n = 0 }
    mod.mail_desk_gather = n + 1
    n + 1
}
// A search of every mailbox looks through each other one: this Mac's copy at once, then the
// server's, a mailbox at a time. A mailbox's rows stay listed until its new list comes.
fn desk_gather(){
    if !ui_unified || account == nil { return }
    let g = {request: desk_next_gather() account: account.id front: folder.id}
    let boxes = []
    for f in folders { if f.id != folder.id { boxes.push(f) } }
    // The mailbox now in front lists its own.
    gathered[folder.id] = nil
    desk_order()
    for f in boxes { desk_gather_list(g, f, 0, []) }
    desk_gather_sync(g, boxes, 0)
}
fn desk_gathering(g){
    let current = try { mod.mail_desk_gather } catch { nil }
    current == g.request && account != nil && account.id == g.account && folder.id == g.front && desk_all()
}
// A mailbox's messages, 200 at a time up to 600, each with where it lives and what a search reads.
fn desk_gather_list(g, f, offset, got){
    host.request("mail.list", {account: g.account folder: f.id offset: offset limit: 200}, fn(r){
        if !desk_gathering(g) || !r.is_ok || r.data.folder != f.id { return }
        for m in r.data.messages {
            m.box = f.id
            m.box_name = f.name
            m.box_role = desk_role_of(f)
            m.words = desk_words(m)
            got.push(m)
        }
        if offset + 200 < r.data.total && offset + 200 < 600 { return desk_gather_list(g, f, offset + 200, got) }
        gathered[f.id] = got
        desk_order()
        desk_list()
    })
}
// What the server has that this Mac hasn't yet, one mailbox after another.
fn desk_gather_sync(g, boxes, i){
    if i >= boxes.len() || !desk_gathering(g) { return }
    let f = boxes[i]
    host.request("mail.sync", {account: g.account folder: f.id}, fn(r){
        if !desk_gathering(g) { return }
        if r.is_ok && r.data.new > 0 { desk_gather_list(g, f, 0, []) }
        desk_gather_sync(g, boxes, i + 1)
    })
}
// The other mailboxes' messages in the sidebar's order, Gmail's All Mail last.
fn desk_order(){
    let rows = []
    for pass in 2 {
        for f in folders {
            let got = if f.id == folder.id { nil } else { gathered[f.id] }
            if got == nil || (pass == 1) != (desk_role_of(f) == "all") { got = [] }
            for m in got { rows.push(m) }
        }
    }
    elsewhere = rows
}
fn clear_query(){
    if sheet != "" { return }
    ui.search.set_text("")
    set_query("")
}
// The toolbar's line under the mailbox's name.
fn desk_bar(){
    let note = ""
    if account != nil {
        // With nothing listed yet, the list says so itself.
        if busy {
            if shown.len() > 0 { note = "Checking for Mail…" }
        }
        else if query != "" { note = plural(shown.len(), "result") }
        else if failure != "" && total == 0 { note = "" }
        else if loaded {
            let count = 0
            for m in messages { if m.unread { count = count + 1 } }
            note = plural(total, "message")
            if count > 0 { note = note + ", " + count + " unread" }
            // Beside the lights, or in a narrow window, the bar hasn't the room for both.
            // A sidebar pushing the list over leaves it the window's width, except on a
            // Mac, where the message keeps its place beside the list.
            let short = if narrow { !side_open || ui_unified } else { !side_wanted }
            if short && count > 0 { note = count + " unread" }
        }
    }
    ui.status.set_text(note)
    ui.status.set_visible(note != "")
}
// What the list says when it has no rows, and the bar under rows it could not refresh.
fn desk_states(){
    let name = ""
    if shown.len() == 0 {
        if query != "" { name = "none" }
        // The message pane holds the one thing to do; a second empty state beside it says nothing.
        else if account == nil { name = "" }
        else if failure != "" { name = "failed" }
        else if !loaded || busy { name = "loading" }
        else { name = "empty" }
    }
    ui.list_keys.set_visible(name == "")
    ui.list_loading.set_visible(name == "loading")
    ui.list_empty.set_visible(name == "empty")
    // Only the Inbox is waiting for anything: Sent, Archive and Trash fill by what you do.
    ui.list_empty_note.set_visible(folder.id == "INBOX")
    ui.list_empty_get.set_visible(folder.id == "INBOX")
    ui.list_none.set_visible(name == "none")
    ui.list_failed.set_visible(name == "failed")
    ui.list_failed_note.set_text(failure)
    ui.fail_bar.set_visible(failure != "" && shown.len() > 0)
    // Trying again can't help when the password is what was refused.
    let refused = failure == refused_words
    ui.failed_try.set_visible(!refused)
    ui.failed_reconnect.set_visible(refused)
    ui.fail_note.set_text(if refused { "Password not accepted." } else { "Can't get new mail." })
    ui.fail_try.set_visible(!refused)
    ui.fail_reconnect.set_visible(refused)
}
fn desk_list(){
    if ui_desk && !list_keys_given {
        list_keys_given = true
        ui.list_keys.focus()
    }
    shown = find_messages()
    // A search that leaves the open message out of the list leaves the viewer empty, as Mail's does,
    // and so does leaving a search of every mailbox with another mailbox's message open.
    if ui_desk && open_id != "" && !composing && (query != "" || open_box != folder.id) {
        let listed = false
        for m in shown { if desk_is_open(m) { listed = true } }
        if !listed {
            open_id = ""
            reading = nil
            open_loading = false
            open_generation = open_generation + 1
            then_compose = ""
            then_compose_for = ""
            open_again = nil
            pane("inbox")
            desk_tools()
        }
    }
    if account != nil && loaded {
        let count = 0
        for m in messages { if m.unread { count = count + 1 } }
        unread[folder.id] = count
    }
    desk_bar()
    desk_states()
    desk_rows()
    desk_folders()
    // Tokens that came back as addresses alone take their names once the mail that knows them is listed.
    desk_name_tokens()
    desk_remember()
}
// Drawing a list again builds its rows afresh, and a press held on a row being replaced
// is lost: a list is drawn again only when it would look different. Replies to a fetch
// usually change nothing. A message keeps its words, so its id and whether it's been
// read say how its row looks.
fn desk_rows(){
    // A row's menu says what can be done with it: writing, and the other mailboxes to move it to.
    let everywhere = desk_all()
    let looks = folder.id + "/" + open_id + "@" + open_box + (if composing { "/c" } else { "/" }) + folders.len() + (if everywhere { "/all" } else { "" })
    for m in shown { looks = looks + (if m.unread { "\n*" } else { "\n" }) + (if m.flagged == true { "!" } else { "" }) + m.id + (if everywhere { "@" + desk_box(m) } else { "" }) }
    if looks == rows_drawn { return false }
    rows_drawn = looks
    ui.rows.render()
}
fn desk_folders(){
    let looks = folder.id + "/" + folder.name
    for f in folders {
        let count = unread[f.id]
        looks = looks + "\n" + f.id + "/" + f.name + "/"
        if count != nil { looks = looks + count }
    }
    if looks == folders_drawn { return false }
    folders_drawn = looks
    ui.folder_rows.render()
}
// What each other mailbox has unread, from what this Mac already holds.
fn count_unread(){
    for f in folders {
        if f.id != folder.id {
            host.request("mail.list", {account: account.id folder: f.id offset: 0 limit: 200}, fn(r){
                if r.is_ok {
                    let count = 0
                    for m in r.data.messages { if m.unread { count = count + 1 } }
                    unread[f.id] = count
                    desk_folders()
                }
            })
        }
    }
}
// A tool that can act now and its dim twin.
fn desk_tools(){
    let writes = account != nil
    let reads = reading != nil
    // One message is written at a time: while its window is up, these wait for it.
    let answers = reads && !composing
    ui.get_on.set_visible(writes)
    ui.get_off.set_visible(!writes)
    ui.new_on.set_visible(writes && !composing)
    ui.new_off.set_visible(!writes || composing)
    ui.reply_on.set_visible(answers)
    ui.reply_off.set_visible(!answers)
    let others = answers && reading.reply_all_cc != nil && reading.reply_all_cc != ""
    // A tight window keeps the search field whole: these two stay in the Message menu.
    ui.reply_all_on.set_visible(others && !tight)
    ui.reply_all_off.set_visible(!others && !tight)
    ui.forward_on.set_visible(answers && !tight)
    ui.forward_off.set_visible(!answers && !tight)
    ui.more_tool.set_visible(answers && tight)
    let keeps = reads && desk_can_archive()
    ui.archive_on.set_visible(keeps)
    ui.archive_off.set_visible(!keeps)
    ui.delete_on.set_visible(reads)
    ui.delete_off.set_visible(!reads)
}
fn desk_role(role){
    for f in folders { if f.role == role { return f } }
    nil
}
// Gmail's archive is All Mail, and a message already there stays: by the mailbox it lives in.
fn desk_can_archive_for(m){
    let role = desk_box_role(m)
    role != "archive" && role != "all" && (desk_role("archive") != nil || desk_role("all") != nil)
}
fn desk_can_archive(){ desk_can_archive_for(reading) }
// Where Archive and Delete put a message.
fn desk_role_target(role){
    if role == "trash" { return desk_role("trash") }
    let archive = desk_role("archive")
    if archive == nil { archive = desk_role("all") }
    archive
}
fn desk_notice(title, note, back){
    notice_title = title
    notice_note = note
    notice_back = back
    ui.notice_title.set_text(title)
    ui.notice_note.set_text(note)
    desk_sheet("notice")
}
fn desk_move(m, role){
    if moving { return }
    moving = true
    let from = folder.id
    // From the mailbox it lives in, which a search of every mailbox may not have in front.
    host.request("mail.move", {account: account.id folder: desk_box(m) message: m.id to: role}, fn(r){
        moving = false
        if !r.is_ok {
            let e = "" + r.error
            let note = if regex("no Archive|no Trash", "i").test(e) { e } else { "Check your connection and try again." }
            desk_notice(if role == "trash" { "Mail Couldn't Delete This Message" } else { "Mail Couldn't Archive This Message" }, note, "")
            return
        }
        // The person may have left this mailbox since asking.
        if folder.id == from { desk_moved(m, desk_role_target(role)) }
    })
}
// What was open gives way to the message after it, as in a Mac's Mail. `to` is where it went.
fn desk_moved(m, to){
    let next = nil
    let was_open = desk_is_open(m)
    if was_open {
        let at = -1
        for i in shown.len() { if desk_same_row(shown[i], m) { at = i } }
        if at >= 0 && at + 1 < shown.len() { next = shown[at + 1] }
        else if at > 0 { next = shown[at - 1] }
        reading = nil
        open_id = ""
        open_loading = false
        open_generation = open_generation + 1
        then_compose = ""
        then_compose_for = ""
        open_again = nil
        pane("inbox")
    }
    let home = desk_box(m)
    if home == folder.id {
        let kept = []
        for x in messages { if x.id != m.id { kept.push(x) } }
        messages = kept
        if total > 0 { total = total - 1 }
    } else {
        let kept = []
        let got = gathered[home]
        if got == nil { got = [] }
        for x in got { if x.id != m.id { kept.push(x) } }
        gathered[home] = kept
        desk_order()
    }
    desk_tools()
    desk_list()
    count_unread()
    // Moved into the mailbox in front, it's listed there once the server has it; a search of every
    // mailbox finds it again where it went.
    if to != nil && to.id == folder.id && home != folder.id { sync() }
    if desk_all() { desk_gather() }
    if next != nil { open_message(next) }
}
// From the trash, or with no trash to go to, a message is gone for good: ask first.
fn desk_delete(m){
    let trash = desk_role("trash")
    if trash == nil || trash.id == desk_box(m) {
        delete_target = m
        desk_sheet("delete")
        return
    }
    desk_move(m, "trash")
}
fn desk_delete_for_good(){
    let m = delete_target
    delete_target = nil
    desk_sheet("")
    if m != nil { desk_move(m, "trash") }
}
// A row's right-click menu, as a Mac's Mail has it: answer, mark, move. A Mac's
// Move to is a submenu; a script app's menu is one level, so each mailbox is a row.
fn desk_row_titles(m){
    let titles = []
    if !composing { titles = ["Reply", "Reply All", "Forward", "-"] }
    titles.push(if m.unread { "Mark as Read" } else { "Mark as Unread" })
    titles.push(if m.flagged == true { "Unflag" } else { "Flag" })
    // Archive and Delete below stand for the Archive and Trash mailboxes, and mail isn't moved
    // into Sent or Drafts, nor into the mailbox it's in.
    let archives = desk_can_archive_for(m)
    let home = desk_box(m)
    let others = []
    for f in folders {
        let stood_for = f.role == "trash" || (archives && (f.role == "archive" || f.role == "all"))
        if f.id != home && !stood_for && f.role != "sent" && f.role != "drafts" { others.push(f) }
    }
    if others.len() > 0 {
        titles.push("-")
        for f in others { titles.push("Move to " + f.name) }
    }
    titles.push("-")
    if archives { titles.push("Archive") }
    titles.push("Delete")
    titles
}
fn desk_row_menu(m, title){
    if sheet != "" || signing_in || account == nil { return }
    if title == "Archive" { return desk_move(m, "archive") }
    if title == "Delete" { return desk_delete(m) }
    if title == "Mark as Unread" || title == "Mark as Read" { return desk_mark(m, "unread", title == "Mark as Unread") }
    if title == "Flag" || title == "Unflag" { return desk_mark(m, "flagged", title == "Flag") }
    for f in folders {
        if f.id != desk_box(m) && title == "Move to " + f.name { return desk_move_to(m, f) }
    }
    if composing || (title != "Reply" && title != "Reply All" && title != "Forward") { return }
    let kind = if title == "Reply All" { "reply_all" } else if title == "Forward" { "forward" } else { "reply" }
    // A reply quotes the whole message: it opens first.
    if desk_is_open(m) && reading != nil { return desk_compose(kind) }
    then_compose = kind
    then_compose_for = m.id
    open_message(m)
}
// Mark as Unread (or Read), Flag (or Unflag): this Mac's copy at once, then the server's.
fn desk_mark(m, what, on){
    // In the mailbox it lives in.
    let home = desk_box(m)
    let args = {account: account.id folder: home message: m.id}
    args[what] = on
    let from = folder.id
    host.request("mail.mark", args, fn(r){
        if !r.is_ok {
            desk_notice("Mail Couldn't Change This Message", "Check your connection and try again.", "")
            return
        }
        if folder.id != from { return }
        for x in messages { if home == folder.id && x.id == m.id { x[what] = on } }
        for x in elsewhere { if x.id == m.id && x.box == home { x[what] = on } }
        if home != folder.id { count_unread() }
        desk_list()
    })
}
fn desk_mark_open(what){
    let m = desk_open_row()
    if m == nil { return }
    if what == "unread" { desk_mark(m, "unread", !m.unread) } else { desk_mark(m, "flagged", m.flagged != true) }
}
// Move to another mailbox: the message leaves this list as it does for Archive.
fn desk_move_to(m, f){
    if moving { return }
    moving = true
    let from = folder.id
    host.request("mail.move", {account: account.id folder: desk_box(m) message: m.id target: f.id}, fn(r){
        moving = false
        if !r.is_ok {
            let e = "" + r.error
            let note = if regex("no longer on the mail server|only an inbox|can't move", "i").test(e) { e } else { "Check your connection and try again." }
            desk_notice("Mail Couldn't Move This Message", note, "")
            return
        }
        if folder.id == from { desk_moved(m, f) }
    })
}
// A file goes to the service's staging, into Mail's storage between script turns,
// and out through the Mac's own save panel. Nothing here opens what a stranger sent.
fn desk_save_note(text){
    ui.r_save_note.set_text(text)
    ui.r_save_note.set_visible(text != "")
}
fn desk_save(i){
    if reading == nil || sheet != "" { return }
    desk_save_note("")
    host.request("mail.attachment", {account: account.id folder: desk_box(reading) message: open_id index: i}, fn(r){
        if !r.is_ok { return desk_save_note("Mail couldn't get this attachment. Check your connection and try again.") }
        host.request("mail.attachment_keep", {}, fn(kept){
            if !kept.is_ok { return desk_save_note("Mail couldn't get this attachment. Check your connection and try again.") }
            host.request("files.export", {path: kept.data.path name: kept.data.name}, fn(done){
                fs.remove(kept.data.path)
                if !done.is_ok { desk_save_note("Mail couldn't save this attachment. Try again.") }
            })
        })
    })
}
// The message header offers one menu for its attachments. Number multiple
// files so repeated names keep distinct save actions without scanning the list.
fn desk_attachment_titles(){
    let titles = []
    for i a in files {
        let name = "" + a.filename
        if name == "" { name = "Attachment" }
        if files.len() > 1 { name = "" + (i + 1) + ". " + name }
        titles.push(name)
    }
    titles
}
// "2 Attachments, 523 KB" over a Mac's attachment tiles.
fn attachment_words(){
    let bytes = 0
    for a in files { if a.size != nil { bytes = bytes + a.size } }
    plural(files.len(), "Attachment") + ", " + kb(bytes)
}
// The kind a document icon carries on its page, "PDF" for "Notes.pdf".
let lower_letters = ["a" "b" "c" "d" "e" "f" "g" "h" "i" "j" "k" "l" "m" "n" "o" "p" "q" "r" "s" "t" "u" "v" "w" "x" "y" "z"]
// A copy's " (2)" after the name keeps its kind.
fn file_kind(name){
    let found = regex("\\.([A-Za-z0-9]{1,4})( \\([0-9]+\\))?$").exec("" + name)
    if found == nil { return "" }
    let kind = found.captures[1]
    for letter in lower_letters { kind = kind.replace(regex(letter, "g"), capitals[letter]) }
    kind
}
fn desk_attachment_menu(title){
    for i name in desk_attachment_titles() { if title == name { desk_save(i); return } }
}
fn desk_refresh(){
    // A Mac's Mail keeps its account in Settings… (Command-comma), not under the mailboxes.
    ui.side_foot.set_visible(account != nil && !ui_unified)
    desk_scope_bar()
    sync_keep_warning()
    desk_tools()
    desk_list()
}
// The panes that fit. A narrow window drops the sidebar first; asked for it there, the
// sidebar pushes the list over. On a Mac the list and the message both stay, narrower,
// as Mail keeps them, and the sidebar stays until it's put away; elsewhere the message
// steps aside, and the sidebar folds away again once a message is chosen.
fn desk_layout(){
    let docked = !narrow && side_wanted
    let pushed = narrow && side_open
    let beside = docked || pushed
    let steps_aside = pushed && !ui_unified
    ui.side_gap.set_visible(beside)
    ui.side_layer.set_visible(beside)
    ui.list_sep.set_visible(!steps_aside)
    ui.reader_column.set_visible(!steps_aside)
    ui.lights_gap.set_visible(ui_unified && !beside)
    desk_room()
    desk_remember()
}
// Where a Mac's New Message window starts: over the message pane where that pane has room
// to write in (480 points), otherwise over the list too, as Mail's floats over its viewer.
// The columns share the window as DeskRoot lays them out: the list 320 points and the
// message the rest, both giving way (the list most) below 601 points.
fn desk_compose_left(){
    if window_w <= 0 { return 0 }
    let beside = if narrow { side_open } else { side_wanted }
    let room = window_w - if beside { 209 } else { 0 }
    let pane = room - 321
    if room < 601 {
        let list = max(200, 320 - (601 - room) * 320 / 390)
        pane = room - 1 - list
    }
    let left = window_w - max(pane, min(room, 504))
    // A strip of the list under 80 points beside the window would read as a sliver: the window
    // covers the list then and reaches over the sidebar's edge, its mailboxes still in sight.
    if beside && left + 12 - 209 < 80 { left = 157 }
    left
}
// The message's toolbar keeps its search field whole: with less room, Reply All and
// Forward move behind its » menu. A Mac's sidebar beside the list takes 210 points.
fn desk_room(){
    if window_w <= 0 { return }
    if ui_unified { ui.compose_gap.render() }
    let beside = if narrow { side_open } else { side_wanted }
    let room = window_w - if ui_unified && beside { 210 } else { 0 }
    if (room < 720) != tight {
        tight = room < 720
        desk_tools()
    }
    // A Mac's message pane under about 300 points (the sidebar pushing at 700): see reader_when.
    let short = ui_unified && room < 600
    if short != reader_short {
        reader_short = short
        if reading != nil { ui.r_time.set_text(reader_when(reading)) }
    }
}
// A narrow message pane keeps the sender's name whole: its time is the list's "Sep 25",
// and the full one comes back with the room.
fn reader_when(m){
    let full = when(m)
    if !reader_short { return full }
    let day = regex("^([A-Z][a-z]+ [0-9]+), ").exec(full)
    if day == nil { return full }
    day.captures[1]
}
fn desk_fold(){
    if !narrow || !side_open { return }
    side_open = false
    desk_layout()
    desk_bar()
}
// Choosing a message, writing one over it or showing Sent folds a narrow window's sidebar
// only where the message stepped aside for it: a Mac's stays until it's put away.
fn desk_fold_for_message(){
    if !ui_unified { desk_fold() }
}
fn toggle_sidebar(){
    if sheet != "" { return }
    if narrow { side_open = !side_open } else { side_wanted = !side_wanted }
    desk_layout()
    desk_bar()
}
fn on_app_resize(width, height){
    if !ui_desk || width <= 0 { return }
    list_seen = height - if ui_unified { 53 } else { 41 }
    let small = width < 900
    if small != narrow {
        // A window that grows wide keeps the sidebar it was showing.
        if !small && side_open { side_wanted = true }
        narrow = small
        side_open = false
        desk_layout()
        desk_bar()
    }
    window_w = width
    desk_room()
}
fn desk_sheet(name){
    // The keyboard comes back to the list.
    if name == "" && sheet != "" { ui.list_keys.focus() }
    sheet = name
    ui.sheets.set_visible(name != "")
    ui.search_block.set_visible(name != "")
    // A Mac's Settings window is a window of its own: Mail's stays undimmed behind it.
    if ui_unified { ui.sheet_dims.set_visible(name != "account") }
    ui.account_sheet.set_visible(name == "account")
    ui.remove_alert.set_visible(name == "remove")
    ui.delete_alert.set_visible(name == "delete")
    ui.notice_alert.set_visible(name == "notice")
    desk_remember()
}
// A press reaches a row under a sheet too: rows wait for it, here and under the host's.
fn row_clicked(m){
    if sheet == "" && !signing_in {
        ui.list_keys.focus()
        desk_fold_for_message()
        open_message(m)
    }
}
// The keyboard moves through the list, and answers as a Mac's Mail does.
fn desk_list_key(key, cmd, shift){
    if sheet != "" || signing_in || account == nil { return }
    let others = reading != nil && reading.reply_all_cc != nil && reading.reply_all_cc != ""
    if key == "KeyN" && cmd {
        if shift { get_mail() } else { desk_compose("new") }
        return
    }
    if key == "KeyR" && cmd {
        desk_compose(if shift && others { "reply_all" } else { "reply" })
        return
    }
    if key == "KeyF" && cmd && shift {
        desk_compose("forward")
        return
    }
    if key == "KeyU" && cmd && shift {
        desk_mark_open("unread")
        return
    }
    if key == "KeyL" && cmd && shift {
        desk_mark_open("flagged")
        return
    }
    if cmd && key != "Backspace" { return }
    let at = -1
    for i in shown.len() { if desk_is_open(shown[i]) { at = i } }
    if key == "ArrowDown" || key == "ArrowUp" {
        let to = if at < 0 { 0 } else if key == "ArrowDown" { at + 1 } else { at - 1 }
        if to >= 0 && to < shown.len() {
            desk_fold_for_message()
            desk_reveal(to)
            open_message(shown[to])
        }
    } else if (key == "Backspace" || key == "Delete") && at >= 0 {
        desk_delete(shown[at])
    }
}
fn desk_open_row(){
    for m in shown { if desk_is_open(m) { return m } }
    nil
}
// A Mac's menu bar asks for these while Mail is in front.
fn app_menus(){
    let free = sheet == "" && !signing_in && account != nil
    let m = if free { desk_open_row() } else { nil }
    let open = m != nil
    let answers = open && reading != nil && !composing
    let others = answers && reading != nil && reading.reply_all_cc != nil && reading.reply_all_cc != ""
    let side = if narrow { side_open } else { side_wanted }
    let rows = [
        {menu: "App" title: "Settings…" key: "cmd+," command: "settings" enabled: free}
        {menu: "File" title: "New Message" key: "cmd+N" command: "new" enabled: free && !composing}
    ]
    // A Mac's Mail saves the message in view as a file; this one writes it as plain text.
    // New Viewer Window, Open Message and Print… aren't here: a script app has one window,
    // and no print service.
    if ui_unified {
        rows.push({menu: "File"})
        rows.push({menu: "File" title: "Save As…" key: "shift+cmd+S" command: "save_as" enabled: answers})
    }
    rows.push({menu: "Edit" title: "Find…" key: "cmd+F" command: "find" enabled: free})
    rows.push({menu: "View" title: if side { "Hide Sidebar" } else { "Show Sidebar" } key: "ctrl+cmd+S" command: "sidebar" enabled: sheet == ""})
    // A Mac's Mail gets every account's new mail at once; this one has the one account.
    rows.push({menu: "Mailbox" title: if ui_unified { "Get All New Mail" } else { "Get Mail" } key: "shift+cmd+N" command: "get" enabled: free})
    // New Mailbox… and Erase Deleted Items aren't here: the mail service makes no mailbox and
    // erases nothing in one go.
    if ui_unified {
        rows.push({menu: "Mailbox"})
        rows.push({menu: "Mailbox" title: "Mark All Messages as Read" command: "read_all" enabled: free && desk_can_read_all()})
    }
    let message_rows = [
        {menu: "Message" title: "Send" key: "shift+cmd+D" command: "send" enabled: free && composing && send_ready && !compose_ask}
        {menu: "Message"}
        {menu: "Message" title: "Reply" key: "cmd+R" command: "reply" enabled: answers}
        {menu: "Message" title: "Reply All" key: "shift+cmd+R" command: "reply_all" enabled: others}
        {menu: "Message" title: "Forward" key: "shift+cmd+F" command: "forward" enabled: answers}
        {menu: "Message"}
        {menu: "Message" title: if open && m.unread { "Mark as Read" } else { "Mark as Unread" } key: "shift+cmd+U" command: "mark" enabled: open}
        {menu: "Message" title: if open && m.flagged == true { "Unflag" } else { "Flag" } key: "shift+cmd+L" command: "flag" enabled: open}
        {menu: "Message"}
        {menu: "Message" title: "Archive" key: "ctrl+cmd+A" command: "archive" enabled: open && desk_can_archive_for(m)}
        {menu: "Message" title: "Delete" command: "delete" enabled: open}
    ]
    for row in message_rows { rows.push(row) }
    // A Mac's Format menu, as far as a plain-text message goes: the original's quote level in a
    // reply or a forward. Fonts, styles, alignment and lists have nothing to act on in plain
    // text, and the field tells a script nothing of its selection, so no row acts on that.
    if ui_unified {
        let quoting = free && composing && compose_head != "" && !compose_ask && !preparing_review &&
            compose_state != "awaiting_approval" && compose_state != "sending"
        rows.push({menu: "Format" submenu: "Quote Level" title: "Increase" command: "quote_more" enabled: quoting && compose_level < 3})
        rows.push({menu: "Format" submenu: "Quote Level" title: "Decrease" command: "quote_less" enabled: quoting && compose_level > 0})
    }
    rows
}
fn on_menu_command(command){
    if command == "sidebar" { toggle_sidebar(); return }
    if sheet != "" || signing_in || account == nil { return }
    if command == "send" {
        if composing && send_ready && !compose_ask { compose_send() }
        return
    }
    let m = desk_open_row()
    if command == "new" { desk_compose("new") }
    else if command == "settings" { open_account() }
    else if command == "find" { ui.search.focus() }
    else if command == "get" { get_mail() }
    else if command == "read_all" { desk_read_all() }
    else if command == "quote_more" { desk_quote_level(1) }
    else if command == "quote_less" { desk_quote_level(-1) }
    else if m == nil { return }
    else if command == "save_as" { desk_save_as() }
    else if command == "reply" || command == "reply_all" || command == "forward" { desk_compose(command) }
    else if command == "mark" { desk_mark(m, "unread", !m.unread) }
    else if command == "flag" { desk_mark(m, "flagged", m.flagged != true) }
    else if command == "archive" { if desk_can_archive_for(m) { desk_move(m, "archive") } }
    else if command == "delete" { desk_delete(m) }
}
// Mark All Messages as Read: the mailbox in front, all of it listed here, with some unread.
// A mailbox longer than the list holds is left as it is rather than half marked.
fn desk_can_read_all(){
    if desk_reading_all || !loaded || busy || query != "" || messages.len() < total { return false }
    for x in messages { if x.unread { return true } }
    false
}
// One message after another, as Mark as Read marks one: this Mac's copy, then the server's.
fn desk_read_all(){
    if sheet != "" || account == nil || !desk_can_read_all() { return }
    let ids = []
    for x in messages { if x.unread { ids.push(x.id) } }
    desk_reading_all = true
    desk_read_next(account.id, folder.id, ids, 0)
}
fn desk_read_next(owner, box, ids, i){
    if i >= ids.len() || account == nil || account.id != owner {
        desk_reading_all = false
        return
    }
    let id = ids[i]
    host.request("mail.mark", {account: owner folder: box message: id unread: false}, fn(r){
        if !r.is_ok {
            desk_reading_all = false
            desk_notice("Mail Couldn't Change These Messages", "Check your connection and try again.", "")
            return
        }
        if folder.id == box {
            for x in messages { if x.id == id { x.unread = false } }
            desk_list()
        }
        desk_read_next(owner, box, ids, i + 1)
    })
}
// Save As…: the message in view as a plain-text file, through the Mac's own Save panel, as a
// Mac's Mail saves one in its Plain Text format. Nothing of it stays in Mail's storage.
let SAVE_AS_FILE = "common/mail-save-as.txt"
fn desk_save_as(){
    if reading == nil || sheet != "" || composing { return }
    let m = reading
    let text = "From: " + sender_line(m) + "\nSubject: " + m.subject + "\nDate: " + when(m)
    if m.to != nil && ("" + m.to) != "" { text = text + "\nTo: " + m.to }
    if m.cc != nil && ("" + m.cc) != "" { text = text + "\nCc: " + m.cc }
    text = text + "\n\n" + m.body + "\n"
    let wrote = try {
        fs.write(SAVE_AS_FILE, text)
        true
    } catch { false }
    if !wrote {
        desk_notice("Mail Couldn't Save This Message", "Check that this device has room and try again.", "")
        return
    }
    host.request("files.export", {path: SAVE_AS_FILE name: desk_save_name(m)}, fn(r){
        let exported = r.is_ok
        // A refusal answers inside the request, where only the first widget call lands.
        start_timeout(0.01, || {
            try { fs.remove(SAVE_AS_FILE) } catch { nil }
            if !exported { desk_notice("Mail Couldn't Save This Message", "OctoSense couldn't open the Save panel. Try again.", "") }
        })
    })
}
// The panel's name for it: the subject, without what a file name can't hold, at most 100 characters.
fn desk_save_name(m){
    let name = ("" + m.subject).replace(regex("[/\\\\:]", "g"), "-").replace(regex("[\\r\\n\\t]", "g"), " ").trim()
    let cut = regex("^([\\s\\S]{0,100})").exec(name)
    if cut != nil { name = cut.captures[1].trim() }
    if name == "" { name = "Untitled" }
    name + ".txt"
}
// Format > Quote Level on a Mac: the original's quote, one level more or less, in the window and
// in what's sent. Not while a send is out: the review has the words it was given.
fn desk_quote_level(by){
    if !composing || compose_head == "" || compose_ask || preparing_review { return }
    if compose_state == "awaiting_approval" || compose_state == "sending" { return }
    let level = compose_level + by
    if level < 0 || level > 3 { return }
    compose_level = level
    desk_quote_show()
    desk_remember()
}
// The original in the window, at its level: a bar a level, and at 0 the words as they are.
fn desk_quote_show(){
    ui.c_quote_head.set_text(compose_head)
    ui.c_quote_text.set_text(compose_quote)
    if !ui_unified { return }
    ui.c_quote_head0.set_text(compose_head)
    ui.c_quote_text0.set_text(compose_quote)
    ui.c_quote_head2.set_text(compose_head)
    ui.c_quote_text2.set_text(compose_quote)
    ui.c_quote_head3.set_text(compose_head)
    ui.c_quote_text3.set_text(compose_quote)
    ui.c_q0.set_visible(compose_level == 0)
    ui.c_q1.set_visible(compose_level == 1)
    ui.c_q2.set_visible(compose_level == 2)
    ui.c_q3.set_visible(compose_level == 3)
}
// Each line of the original after "> " a level, as plain-text mail quotes.
fn desk_quoted(text, level){
    if level <= 0 { return text }
    let mark = ""
    for i in level { mark = mark + "> " }
    mark + text.replace(regex("\n", "g"), "\n" + mark)
}
// Sent: the list keeps its count, as a Mac's Mail does, and the foot of the sidebar says so
// where that Mail offers Undo Send. This one can't take a message back (the host sends it once
// it's approved), so the foot only says it went. With the sidebar hidden, the bar says it.
fn desk_sent_said(){
    desk_sent_n = desk_sent_n + 1
    let ticket = desk_sent_n
    let beside = if narrow { side_open } else { side_wanted }
    if beside {
        ui.sent_foot.set_visible(true)
        start_timeout(6.0, || { if ticket == desk_sent_n { ui.sent_foot.set_visible(false) } })
        desk_bar()
        return
    }
    ui.status.set_text("Message sent")
    ui.status.set_visible(true)
    start_timeout(4.0, || desk_bar())
}
// A row is 80 points and its rule 1, under the list's 8.
fn desk_reveal(i){
    let top = 8 + i * 81
    let y = ui.rows.scroll_y()
    if top - 8 < y {
        ui.rows.set_scroll_y(top - 8)
    } else if top + 88 > y + list_seen {
        ui.rows.set_scroll_y(top + 88 - list_seen)
    }
}
fn get_mail(){
    if sheet == "" { sync() }
}
fn try_again(){
    if sheet != "" || account == nil { return }
    failure = ""
    sync()
}
fn open_retry(){
    if open_again != nil { open_message(open_again) }
}
// The service takes a message of 8 KB; a long quote ends at a line.
fn fit_quote(text){
    let whole = "" + text
    if whole.len() <= 5600 { return whole }
    let out = ""
    for line in whole.split("\n") {
        if out.len() + line.len() + 1 > 5600 { break }
        out = out + line + "\n"
    }
    out + "…"
}
fn sender_line(m){ sender_name(m) + " <" + m.address + ">" }
fn compose_note(text, bad){
    compose_said = text
    compose_said_bad = bad
    ui.c_note.set_text(text)
    ui.c_error.set_text(text)
    ui.c_note.set_visible(!bad && text != "")
    ui.c_error.set_visible(bad && text != "")
    ui.c_foot.set_visible(text != "")
    desk_remember()
}
fn desk_more_rows(){
    let others = reading != nil && reading.reply_all_cc != nil && reading.reply_all_cc != ""
    if others { return ["Reply All", "Forward"] }
    ["Forward"]
}
// A New Message window over the message pane: the mailboxes, the list and the message
// stay where they were, as a Mac's Mail leaves its viewer when it opens one.
fn desk_compose(kind){
    if account == nil || sheet != "" || composing { return }
    if kind != "new" && reading == nil { return }
    desk_fold_for_message()
    reply_message = ""
    compose_id = ""
    compose_retrying = ""
    compose_revision = 0
    compose_generation = compose_generation + 1
    preparing_review = false
    compose_state = ""
    compose_head = ""
    compose_quote = ""
    compose_unwatch()
    let to = ""
    let cc = ""
    let subject = ""
    let note = ""
    compose_missing_attachments = false
    if kind == "reply" || kind == "reply_all" {
        to = reading.reply_to
        if to == nil || to == "" { to = reading.address }
        if kind == "reply_all" { cc = reading.reply_all_cc }
        subject = reading.subject
        if subject.search("Re:") != 0 { subject = "Re: " + subject }
        reply_message = open_id
        compose_head = "On " + when(reading) + ", " + sender_line(reading) + " wrote:"
        compose_quote = fit_quote(reading.body)
    }
    if kind == "forward" {
        subject = reading.subject
        if subject.search("Fwd:") != 0 { subject = "Fwd: " + subject }
        compose_head = "Begin forwarded message:"
        compose_quote = "From: " + sender_line(reading) + "\nSubject: " + reading.subject + "\nDate: " + when(reading) + "\n\n" + fit_quote(reading.body)
        compose_missing_attachments = reading.attachments.len() > 0
    }
    desk_set_addresses("to", to)
    desk_set_addresses("cc", cc)
    ui.c_subject.set_text(subject)
    ui.c_from.set_text(account.address)
    ui.c_body.set_text("")
    ui.c_new_body.set_text("")
    ui.c_new.set_visible(compose_head == "")
    ui.c_thread.set_visible(compose_head != "")
    compose_level = 1
    desk_quote_show()
    compose_kind = kind
    // A reply answers the message in the mailbox it lives in.
    compose_folder = if kind == "new" { folder.id } else { desk_box(reading) }
    composing = true
    compose_note(note, false)
    compose_start = desk_to_text() + "\n" + desk_cc_text() + "\n" + subject
    compose_window(true)
    compose_changed()
    if kind == "reply" || kind == "reply_all" { ui.c_body.focus() } else { ui.c_to.focus() }
}
// The window up or put away, and what waits on it.
fn compose_window(up){
    composing = up
    compose_ask = false
    ui.compose_ask.set_visible(false)
    ui.c_missing_attachments.set_visible(up && compose_missing_attachments)
    ui.compose_layer.set_visible(up)
    sync_keep_warning()
    desk_tools()
    desk_rows()
    desk_remember()
}
// What was written when Mail quit, in its window again. A send that was waiting for
// the person's approval waits for Send again: the host's review didn't outlive the quit.
fn desk_compose_again(c){
    reply_message = c.reply
    compose_kind = c.kind
    compose_folder = c.folder
    compose_id = ""
    compose_retrying = ""
    compose_revision = 0
    compose_generation = compose_generation + 1
    preparing_review = false
    compose_state = ""
    compose_head = c.head
    compose_quote = c.quote
    compose_start = c.start
    // Older saved windows kept this warning in the transient status line.
    compose_missing_attachments = (try { c.missing_attachments == true } catch { false }) || (c.kind == "forward" && c.said == "Attachments aren't forwarded.")
    compose_unwatch()
    desk_set_addresses("to", c.to)
    desk_set_addresses("cc", c.cc)
    ui.c_subject.set_text(c.subject)
    ui.c_from.set_text(account.address)
    if compose_head == "" {
        ui.c_new_body.set_text(c.body)
        ui.c_body.set_text("")
    } else {
        ui.c_body.set_text(c.body)
        ui.c_new_body.set_text("")
    }
    ui.c_new.set_visible(compose_head == "")
    ui.c_thread.set_visible(compose_head != "")
    let level = try { c.level } catch { nil }
    compose_level = if level == nil { 1 } else { level }
    desk_quote_show()
    let said = c.said
    let bad = c.bad
    if said == "Attachments aren't forwarded." { said = "" }
    if c.state == "sending" || c.state == "outcome_unknown" {
        said = "Mail can't tell whether this was sent. Check Sent before you send it again."
        bad = true
    } else if c.state == "awaiting_approval" {
        said = ""
        bad = false
    }
    composing = true
    compose_note(said, bad)
    compose_window(true)
    compose_changed()
}
fn compose_typed(){
    if compose_head == "" { return ui.c_new_body.text() }
    ui.c_body.text()
}
// How many addresses a field holds, or -1 when one of them isn't an address.
fn address_count(list){
    let count = 0
    for one in ("" + list).replace(regex(";", "g"), ",").split(",") {
        let plain = one.trim()
        if plain != "" {
            if !regex("^[^\\s@,;<>]+@[^\\s@,;<>]+$").test(plain) { return -1 }
            count = count + 1
        }
    }
    count
}
// A Mac's To and Cc hold their finished addresses as tokens, by name where Mail knows one. The words
// sent, kept and shown in the host's review are those addresses in order, then what's still typed:
// what the field said before it had tokens.
fn desk_valid(address){ regex("^[^\\s@,;<>]+@[^\\s@,;<>]+$").test("" + address) }
fn desk_tokens(which){ if which == "cc" { cc_list } else { to_list } }
fn desk_typed(which){ if which == "cc" { ui.c_cc.text() } else { ui.c_to.text() } }
fn desk_addresses(which){
    let typed = desk_typed(which)
    if !ui_unified { return typed }
    let out = ""
    for t in desk_tokens(which) { out = if out == "" { "" + t.address } else { out + ", " + t.address } }
    let rest = ("" + typed).trim()
    if rest != "" { out = if out == "" { rest } else { out + ", " + rest } }
    out
}
fn desk_to_text(){ desk_addresses("to") }
fn desk_cc_text(){ desk_addresses("cc") }
// The names in a list of "Name <address>", for an address.
fn desk_name_in(list, wanted){
    for one in ("" + list).replace(regex(";", "g"), ",").split(",") {
        let named = regex("^(.*)<([^<>]*)>$").exec(one.trim())
        if named != nil && wanted.test(named.captures[2].trim()) {
            let name = named.captures[1].replace(regex("\"", "g"), "").trim()
            if name != "" { return name }
        }
    }
    ""
}
fn desk_name_of(m, wanted){
    let sender = ("" + m.sender).trim()
    if sender != "" && wanted.test("" + m.address) { return sender }
    let written_to = try { m.to } catch { nil }
    if written_to == nil { return "" }
    desk_name_in(written_to, wanted)
}
// Whom Mail knows by an address: the open message's people, then the mail it lists (the first 200
// a search of every mailbox found, which keeps a field's keystroke quick).
fn desk_known_name(address){
    let wanted = regex("^" + escape(address) + "$", "i")
    if reading != nil {
        let copied = try { reading.cc } catch { "" }
        let name = desk_name_of(reading, wanted)
        if name == "" { name = desk_name_in(copied, wanted) }
        if name != "" { return name }
    }
    for m in messages {
        let name = desk_name_of(m, wanted)
        if name != "" { return name }
    }
    let count = if elsewhere.len() < 200 { elsewhere.len() } else { 200 }
    for i in count {
        let name = desk_name_of(elsewhere[i], wanted)
        if name != "" { return name }
    }
    ""
}
// "Name <address>" or an address alone, as a token; nil for what isn't an address.
fn desk_token(part){
    let one = ("" + part).trim()
    if one == "" { return nil }
    let name = ""
    let address = one
    let named = regex("^(.*)<([^<>]*)>$").exec(one)
    if named != nil {
        name = named.captures[1].replace(regex("\"", "g"), "").trim()
        address = named.captures[2].trim()
    }
    if !desk_valid(address) { return nil }
    if name == "" { name = desk_known_name(address) }
    return {address: address name: name}
}
fn desk_listed(list, address){
    let wanted = regex("^" + escape(address) + "$", "i")
    for t in list { if wanted.test("" + t.address) { return true } }
    false
}
fn desk_set_typed(which, text){
    if which == "cc" {
        ui.c_cc.set_text(text)
        cc_was = text
    } else {
        ui.c_to.set_text(text)
        to_was = text
    }
}
// A field's addresses from words: each address a token, up to the first part that isn't one, which
// stays as typed with what follows it.
fn desk_set_addresses(which, text){
    let words = if text == nil { "" } else { "" + text }
    if !ui_unified {
        if which == "cc" { ui.c_cc.set_text(words) } else { ui.c_to.set_text(words) }
        return
    }
    let list = []
    let rest = ""
    for one in words.replace(regex(";", "g"), ",").split(",") {
        let part = one.trim()
        if part != "" {
            let t = if rest == "" { desk_token(part) } else { nil }
            if t != nil && list.len() < TOKENS {
                if !desk_listed(list, t.address) { list.push(t) }
            } else { rest = if rest == "" { part } else { rest + ", " + part } }
        }
    }
    if which == "cc" { cc_list = list } else { to_list = list }
    desk_set_typed(which, rest)
    desk_draw_tokens(which)
}
// Typing in To or Cc. A comma or semicolon finishes what's before it; a Backspace with nothing
// typed takes the last token whole, as a Mac's address field does.
fn desk_address_typed(which, text){
    if !ui_unified { return compose_changed() }
    let typed = "" + text
    let was = if which == "cc" { cc_was } else { to_was }
    let list = desk_tokens(which)
    if typed == "" && was == "" {
        if list.len() > 0 {
            list.pop()
            desk_draw_tokens(which)
        }
    } else if regex("[,;]").test(typed) {
        let parts = typed.replace(regex(";", "g"), ",").split(",")
        let left = ""
        for i in parts.len() - 1 {
            let part = parts[i].trim()
            if part != "" {
                let t = if left == "" { desk_token(part) } else { nil }
                if t != nil && list.len() < TOKENS {
                    if !desk_listed(list, t.address) { list.push(t) }
                } else { left = left + part + ", " }
            }
        }
        let rest = left + parts[parts.len() - 1].trim()
        if rest != typed {
            desk_set_typed(which, rest)
            desk_draw_tokens(which)
        } else if which == "cc" { cc_was = typed } else { to_was = typed }
    } else if which == "cc" { cc_was = typed } else { to_was = typed }
    // Moving on to the other field finishes the address left in that one.
    let other = if which == "cc" { "to" } else { "cc" }
    desk_settle(other)
    compose_changed()
}
// After an appearance switch: the tokens as they were, and the typing after them. A window kept
// before tokens has only the words.
fn desk_restore_addresses(which, list, rest, words){
    if list == nil || rest == nil { return desk_set_addresses(which, words) }
    let kept = []
    for t in list { kept.push({address: "" + t.address name: "" + t.name}) }
    if which == "cc" { cc_list = kept } else { to_list = kept }
    desk_set_typed(which, "" + rest)
    desk_draw_tokens(which)
}
// An address typed in full and left (Return, Tab, the other field, the subject or the message)
// becomes a token. Send reads what is typed as it is (desk_to_text), so it needs none.
fn desk_settle(which){
    if !ui_unified { return false }
    let typed = ("" + desk_typed(which)).trim()
    if typed == "" || regex("[,;]").test(typed) { return false }
    let list = desk_tokens(which)
    let t = desk_token(typed)
    if t == nil || list.len() >= TOKENS { return false }
    if !desk_listed(list, t.address) { list.push(t) }
    desk_set_typed(which, "")
    desk_draw_tokens(which)
    true
}
fn desk_settle_both(){
    desk_settle("to")
    desk_settle("cc")
}
// Return keeps the keyboard in the field, which a single-line field gives up first.
fn desk_address_return(which){
    desk_settle(which)
    compose_changed()
    if which == "cc" { ui.c_cc.focus() } else { ui.c_to.focus() }
}
// Tab goes down the form, as it did before the field had tokens.
fn desk_address_tab(which, shift){
    desk_settle(which)
    compose_changed()
    if which == "cc" {
        if shift { ui.c_to.focus() } else { ui.c_subject.focus() }
    } else if shift {
        if compose_head == "" { ui.c_new_body.focus() } else { ui.c_body.focus() }
    } else { ui.c_cc.focus() }
}
fn desk_subject_typed(){
    desk_settle_both()
    compose_changed()
}
fn desk_body_typed(){
    desk_settle_both()
    desk_remember()
}
// A token's menu: Remove Address takes that one out.
fn desk_token_menu(which, i, title){
    if !composing || compose_ask || sheet != "" || title != "Remove Address" { return }
    let list = desk_tokens(which)
    if i >= list.len() { return }
    list.remove(i)
    desk_draw_tokens(which)
    compose_changed()
}
// A token that came back as an address alone, after a quit, takes its name once the mail that
// knows it is listed or open.
fn desk_name_tokens(){
    if !ui_unified || !composing { return false }
    for which in ["to", "cc"] {
        let named = false
        for t in desk_tokens(which) {
            if ("" + t.name) == "" {
                let name = desk_known_name(t.address)
                if name != "" {
                    t.name = name
                    named = true
                }
            }
        }
        if named { desk_draw_tokens(which) }
    }
    true
}
fn desk_token_words(t){
    let name = ("" + t.name).trim()
    if name != "" { return name }
    "" + t.address
}
// The token slots, by their names: a script can't name a widget it makes up.
fn desk_slot(which, i, words){
    let on = words != ""
    if which == "cc" {
        if i == 0 { ui.cc_t0.set_visible(on) ui.cc_n0.set_text(words) }
        else if i == 1 { ui.cc_t1.set_visible(on) ui.cc_n1.set_text(words) }
        else if i == 2 { ui.cc_t2.set_visible(on) ui.cc_n2.set_text(words) }
        else if i == 3 { ui.cc_t3.set_visible(on) ui.cc_n3.set_text(words) }
        else if i == 4 { ui.cc_t4.set_visible(on) ui.cc_n4.set_text(words) }
        else if i == 5 { ui.cc_t5.set_visible(on) ui.cc_n5.set_text(words) }
        else if i == 6 { ui.cc_t6.set_visible(on) ui.cc_n6.set_text(words) }
        else if i == 7 { ui.cc_t7.set_visible(on) ui.cc_n7.set_text(words) }
    } else {
        if i == 0 { ui.to_t0.set_visible(on) ui.to_n0.set_text(words) }
        else if i == 1 { ui.to_t1.set_visible(on) ui.to_n1.set_text(words) }
        else if i == 2 { ui.to_t2.set_visible(on) ui.to_n2.set_text(words) }
        else if i == 3 { ui.to_t3.set_visible(on) ui.to_n3.set_text(words) }
        else if i == 4 { ui.to_t4.set_visible(on) ui.to_n4.set_text(words) }
        else if i == 5 { ui.to_t5.set_visible(on) ui.to_n5.set_text(words) }
        else if i == 6 { ui.to_t6.set_visible(on) ui.to_n6.set_text(words) }
        else if i == 7 { ui.to_t7.set_visible(on) ui.to_n7.set_text(words) }
    }
}
fn desk_draw_tokens(which){
    if !ui_unified { return false }
    let list = desk_tokens(which)
    for i in TOKENS {
        let words = if i < list.len() { desk_token_words(list[i]) } else { "" }
        desk_slot(which, i, words)
    }
    true
}
// Send waits for someone to write to, and for the last try to be answered.
fn compose_changed(){
    let ready = !preparing_review && address_count(desk_to_text()) > 0 && address_count(desk_cc_text()) >= 0
    send_ready = ready
    ui.send_on.set_visible(ready)
    ui.send_off.set_visible(!ready)
    let subject = ui.c_subject.text().trim()
    if subject == "" { subject = "New Message" }
    ui.c_title.set_text(subject)
    desk_remember()
}
fn compose_close(){
    compose_generation = compose_generation + 1
    preparing_review = false
    compose_retrying = ""
    desk_review_stop()
    mod.mail_desk_review = nil
    desk_review_serial = 0
    compose_unwatch()
    compose_window(false)
    // The keyboard comes back to the list.
    ui.list_keys.focus()
}
// The window's close button: what was written isn't lost to a stray click.
fn compose_cancel(){
    if !composing || compose_ask { return }
    if compose_typed().trim() != "" || desk_to_text() + "\n" + desk_cc_text() + "\n" + ui.c_subject.text() != compose_start {
        compose_asking(true)
    } else { compose_close() }
}
fn compose_asking(on){
    compose_ask = on
    compose_discard_words()
    ui.compose_ask.set_visible(on)
    desk_remember()
}
fn compose_discard_words(){
    let note = "Your changes won't be kept."
    if compose_state == "sending" {
        note = "Closing this window won't cancel a send in progress. Your changes won't be kept."
    } else if compose_state == "outcome_unknown" {
        note = "Mail can't tell whether this was sent. Your changes won't be kept."
        if preparing_review {
            note = "Mail can't tell whether the earlier message was sent. Closing won't cancel the new send review. Your changes won't be kept."
        }
    } else if preparing_review || compose_state == "awaiting_approval" {
        note = "Your changes won't be kept. This doesn't cancel a send review."
    }
    ui.compose_discard_note.set_text(note)
}
fn compose_body(){
    let typed = compose_typed()
    if compose_head == "" { return typed }
    let quote = desk_quoted(compose_quote, compose_level)
    if typed.trim() == "" { return compose_head + "\n\n" + quote }
    typed + "\n\n" + compose_head + "\n\n" + quote
}
fn desk_review_current(){
    let current = try { mod.mail_desk_review_run } catch { nil }
    current == desk_review_run
}
fn desk_review_stop(){
    if desk_review_timer != nil {
        stop_timer(desk_review_timer)
        desk_review_timer = nil
    }
}
fn desk_review_watch(){
    if desk_review_timer == nil { desk_review_timer = start_interval(0.4, || desk_review_follow()) }
}
// The host's callback writes only its result. The current run consumes it,
// leaving any words typed since the request untouched.
fn desk_review_follow(){
    if !desk_review_current() || !composing || !preparing_review || account == nil {
        desk_review_stop()
        return
    }
    let saved = try { mod.mail_desk_review } catch { nil }
    if saved == nil || saved.serial != desk_review_serial || saved.account != account.id {
        desk_review_stop()
        return
    }
    if saved.pending { return }
    mod.mail_desk_review = nil
    desk_review_stop()
    desk_review_serial = 0
    if saved.kind == "ok" {
        compose_id = saved.compose_id
        compose_revision = saved.revision
        compose_state = "awaiting_approval"
        compose_note("Waiting for your approval.", false)
        compose_watch()
    } else if saved.kind == "missing" {
        reply_message = ""
        preparing_review = false
        compose_changed()
        compose_note("The original message is no longer available. Review this as a new message.", true)
    } else {
        preparing_review = false
        compose_changed()
        compose_note(saved.note, true)
    }
    if compose_ask { compose_discard_words() }
}
fn compose_send(){
    if preparing_review || !composing { return }
    // A Mac's To and Cc hold their finished addresses as tokens: their words are those addresses,
    // then what's still typed (desk_to_text), as the field said before it had tokens.
    let unified = try { mod.mail_desk_tokens == true } catch { false }
    let to_words = if unified { desk_to_text() } else { ui.c_to.text() }
    let cc_words = if unified { desk_cc_text() } else { ui.c_cc.text() }
    preparing_review = true
    compose_retrying = ""
    compose_sent_to = to_words
    compose_sent_cc = cc_words
    compose_sent_subject = ui.c_subject.text()
    compose_sent_body = compose_typed()
    let serial = try { mod.mail_desk_review_serial } catch { 0 }
    if serial == nil { serial = 0 }
    desk_review_serial = serial + 1
    mod.mail_desk_review_serial = desk_review_serial
    mod.mail_desk_review = {serial: desk_review_serial account: account.id pending: true kind: "" compose_id: "" revision: 0 note: ""}
    compose_changed()
    let generation = compose_generation
    compose_note("Preparing to send…", false)
    // A reply answers the message in the mailbox it was written from, wherever the list has gone since.
    let args = {account: account.id to: to_words.trim() cc: cc_words.trim() subject: ui.c_subject.text() body: compose_body() folder: compose_folder message: reply_message}
    if compose_id != "" {
        args.compose_id = compose_id
        args.expected_revision = compose_revision
    }
    desk_review_watch()
    compose_review(args, generation)
}
fn compose_review(args, generation){
    let serial = desk_review_serial
    let request_account = args.account
    let missing_reply = args.message != "" && compose_id == ""
    host.request("mail.review_send", args, fn(r){
        let saved = try { mod.mail_desk_review } catch { nil }
        if saved == nil || saved.serial != serial || saved.account != request_account || !saved.pending { return }
        if r.is_ok {
            saved.kind = "ok"
            saved.compose_id = r.data.compose_id
            saved.revision = r.data.revision
        } else if missing_reply && regex("no such reply source", "i").test("" + r.error) {
            saved.kind = "missing"
        } else {
            saved.kind = "error"
            saved.note = plain_send_failure(r.error)
        }
        saved.pending = false
        mod.mail_desk_review = saved
    })
}
fn compose_unwatch(){
    if compose_timer != nil {
        stop_timer(compose_timer)
        compose_timer = nil
    }
}
// The approval happens on the host's own sheet: this only hears how it went.
fn compose_watch(){
    compose_unwatch()
    let generation = compose_generation
    compose_timer = start_interval(1.0, || {
        if !desk_review_current() || generation != compose_generation || account == nil { return }
        let request_account = account.id
        let request_id = if compose_id != "" { compose_id } else { compose_retrying }
        if request_id == "" { return }
        host.request("mail.compose_status", {account: request_account compose_id: request_id}, fn(r){
            if r.is_ok && desk_review_current() && generation == compose_generation && account != nil && account.id == request_account && (compose_id == request_id || compose_retrying == request_id) {
                // The host's sheet offered Show Sent, on a send it can't vouch for.
                let asked = try { r.data.show_sent == true } catch { false }
                if asked { desk_show_sent() }
                compose_heard(r.data.status)
            }
        })
    })
}
fn compose_heard(state){
    if state == compose_state { return }
    compose_state = state
    if state == "sending" { compose_note("Sending…", false) }
    if state == "accepted" {
        let unified = try { mod.mail_desk_tokens == true } catch { false }
        let to_words = if unified { desk_to_text() } else { ui.c_to.text() }
        let cc_words = if unified { desk_cc_text() } else { ui.c_cc.text() }
        let unchanged = to_words == compose_sent_to && cc_words == compose_sent_cc &&
            ui.c_subject.text() == compose_sent_subject && compose_typed() == compose_sent_body
        if unchanged {
            compose_close()
            // A Mac's Mail keeps the list's count and says so under the mailboxes.
            if unified { desk_sent_said() }
            else {
                ui.status.set_text("Message sent")
                ui.status.set_visible(true)
                start_timeout(4.0, || desk_bar())
            }
        } else {
            // The host sent the reviewed snapshot, not edits made afterward.
            compose_unwatch()
            compose_id = ""
            compose_revision = 0
            compose_retrying = ""
            compose_state = ""
            preparing_review = false
            compose_changed()
            compose_note("Message sent. Your newer changes weren't sent.", false)
        }
        return
    }
    if state == "draft" {
        compose_unwatch()
        // A second try called off says nothing about the first: its note stands.
        let second_try = compose_retrying != ""
        compose_retrying = ""
        preparing_review = false
        compose_changed()
        if !second_try { compose_note("Not sent. You can change the message and send it again.", false) }
    }
    if state == "failed_before_delivery" || state == "outcome_unknown" {
        preparing_review = false
        if compose_id != "" { compose_retrying = compose_id }
        compose_id = ""
        compose_revision = 0
        compose_changed()
        // The host's sheet is up saying so: this stays beside the message once it's gone.
        if state == "outcome_unknown" { compose_note("Mail can't tell whether this was sent. Check Sent before you send it again.", true) }
        else { compose_note("Not sent: the mail server didn't take it. Check the addresses and try again.", true) }
    }
    if compose_ask { compose_discard_words() }
}
// Sent, where the person can see whether a message went. The message being written stays.
fn desk_show_sent(){
    let sent = desk_role("sent")
    if sent == nil {
        for f in folders { if sent == nil && regex("^sent", "i").test("" + f.name) { sent = f } }
    }
    if sent == nil || sheet != "" { return }
    desk_fold_for_message()
    if folder.id == sent.id { sync() } else { open_folder(sent) }
}
fn open_account(){
    if sheet != "" || account == nil { return }
    desk_account_words()
    desk_sheet("account")
}
fn desk_account_words(){
    ui.acct_address.set_text(account.address)
    if ui_unified { ui.acct_name.set_text(account.address) }
}
// A press on Mail's window beside its Settings window: Settings goes once the press is over, so
// the row or the tool under it doesn't act on it (a Mac's first press only brings a window forward).
fn desk_settings_away(){
    start_timeout(0.01, || { if sheet == "account" { desk_sheet("") } })
}
fn reconnect(){
    desk_sheet("")
    desk_sign_in({account: account.id})
}
fn desk_remove_words(){
    ui.remove_title.set_text("Remove " + account.address + "?")
    ui.remove_note.set_text("Its messages and saved password are removed from this device. Your mail on the server stays as it is.")
}
fn confirm_remove(){
    desk_remove_words()
    desk_sheet("remove")
}
// The reader's fields for the message in `reading`.
fn desk_show(){
    let m = reading
    let name = sender_name(m)
    ui.r_subject.set_text(m.subject)
    ui.r_sender.set_text(name)
    ui.r_where.set_text(m.address + "  ·  " + desk_box_name(m) + " — " + account.address)
    let written_to = "" + m.to
    let copied = "" + m.cc
    ui.r_to.set_text("To: " + written_to)
    ui.r_to.set_visible(m.to != nil && written_to != "")
    ui.r_cc.set_text("Cc: " + copied)
    ui.r_cc.set_visible(m.cc != nil && copied != "")
    ui.r_initials.set_text(initials_of(name))
    ui.r_time.set_text(reader_when(m))
    // Formatted mail shows as the host rebuilt it: text, links and lists, nothing remote.
    let formatted = m.html != ""
    ui.r_html.set_visible(formatted)
    ui.r_body.set_visible(!formatted)
    if formatted { ui.r_html.set_text(m.html) } else { ui.r_html.set_text("") ui.r_body.set_text(m.body) }
    files = m.attachments
    ui.r_attach.set_visible(files.len() > 0)
    // A Mac's one Save menu heads the attachments; elsewhere it sits by the time.
    ui.r_attach_menu.set_visible(files.len() > 0 && !ui_unified)
    if ui_unified { ui.r_attach_count.set_text(attachment_words()) }
    ui.r_files.render()
    desk_save_note("")
    pane("reader")
}
// An appearance switch runs this whole script again, and every `let` with it; `mod`
// outlives the run, so what the person was doing comes back from there.
fn desk_remember(){
    // Until this run has looked, what's kept belongs to the run before it.
    if !recalled { return }
    mod.mail_desk = {account: account signing: signing_in folder: folder folders: folders messages: messages total: total
        open_id: open_id reading: reading open_again: open_again open_loading: open_loading then_compose: then_compose then_compose_for: then_compose_for query: query unread: unread loaded: loaded failure: failure
        narrow: narrow tight: tight side_wanted: side_wanted side_open: side_open sheet: sheet
        composing: composing asking: compose_ask kind: compose_kind compose_folder: compose_folder
        reply_message: reply_message compose_id: compose_id compose_retrying: compose_retrying compose_revision: compose_revision preparing: preparing_review generation: compose_generation review_serial: desk_review_serial
        head: compose_head quote: compose_quote level: compose_level start: compose_start state: compose_state timer: compose_timer missing_attachments: compose_missing_attachments
        sent_to: compose_sent_to sent_cc: compose_sent_cc sent_subject: compose_sent_subject sent_body: compose_sent_body
        said: compose_said said_bad: compose_said_bad to: desk_to_text() cc: desk_cc_text() subject: ui.c_subject.text() body: compose_typed()
        to_list: to_list cc_list: cc_list to_rest: ui.c_to.text() cc_rest: ui.c_cc.text()
        search_in: search_in gathered: gathered elsewhere: elsewhere open_box: open_box
        delete_target: delete_target notice_title: notice_title notice_note: notice_note notice_back: notice_back}
    desk_keep()
}
// Across a quit too: what the window shows goes to Mail's storage a moment after it
// changes, and comes back when Mail opens on the same account.
fn desk_keep(){
    if !restored || account == nil || keep_timer != nil { return }
    keep_timer = start_timeout(0.4, || desk_keep_now())
}
// A failed window save can also leave an older message behind after Discard.
// Keep the warning where it is visible both inside and outside the composer.
fn sync_keep_warning(){
    ui.keep_warning.set_visible(keep_error && account != nil && !composing)
    ui.c_keep_warning.set_visible(keep_error && account != nil && composing)
}
fn desk_retry_keep(){
    if keep_timer != nil {
        stop_timer(keep_timer)
        keep_timer = nil
    }
    desk_keep_now()
}
fn desk_keep_now(){
    keep_timer = nil
    if !restored || account == nil { return }
    let c = nil
    if composing {
        // To and Cc as words: on a Mac, the tokens' addresses and then what's typed.
        let unified = try { mod.mail_desk_tokens == true } catch { false }
        let to_words = if unified { desk_to_text() } else { ui.c_to.text() }
        let cc_words = if unified { desk_cc_text() } else { ui.c_cc.text() }
        c = {kind: compose_kind reply: reply_message folder: compose_folder head: compose_head quote: compose_quote start: compose_start missing_attachments: compose_missing_attachments
            to: to_words cc: cc_words subject: ui.c_subject.text() body: compose_typed() said: compose_said bad: compose_said_bad state: compose_state}
        // The quote's level is a Mac's (Format > Quote Level).
        if unified { c.level = compose_level }
    }
    // A message still to be opened again counts as open.
    let v = {account: account.id folder: folder open: if then_open != "" { then_open } else { open_id } side: side_wanted compose: c}
    let stored = try {
        fs.write(WINDOW_FILE, v.to_json())
        true
    } catch { false }
    keep_error = !stored
    mod.mail_keep_error = keep_error
    sync_keep_warning()
}
fn desk_kept(){
    let there = try { fs.exists(WINDOW_FILE) } catch { false }
    if !there { return nil }
    try { fs.read(WINDOW_FILE).parse_json() } catch { nil }
}
// The window as it was, on the account it was for: its mailbox, its message, its sidebar,
// and the message being written.
fn desk_reopen(){
    let v = kept_window
    kept_window = nil
    if v == nil || v.account != account.id { return }
    if v.folder != nil && v.folder.id != nil && v.folder.id != "" {
        folder = v.folder
        folder_kept = true
        ui.box_title.set_text(folder.name)
    }
    side_wanted = v.side != false
    then_open = if v.open == nil { "" } else { "" + v.open }
    desk_layout()
    if v.compose != nil { desk_compose_again(v.compose) }
}
// A sheet that outlived its run answers that run: this one looks for the account itself.
fn desk_wait_account(){
    account_timer = start_interval(1.0, || {
        if account != nil {
            stop_timer(account_timer)
            return
        }
        host.request("mail.accounts", {}, fn(r){
            if account == nil && r.is_ok && r.data.len() > 0 { load_accounts() }
        })
    })
}
fn desk_recall(){
    if recalled { return false }
    recalled = true
    let v = try { mod["mail_desk"] } catch { nil }
    if v == nil { return false }
    // A sheet up across a switch stays visible, so nothing asks its own batch to repaint
    // and it would keep the old appearance. A change of visibility repaints the whole window.
    let up = ui.sheets.is_visible()
    ui.sheets.set_visible(!up)
    ui.sheets.set_visible(up)
    side_wanted = v.side_wanted
    side_open = v.side_open
    narrow = v.narrow
    tight = v.tight
    if v.account == nil {
        if v.signing { desk_wait_account() }
        desk_layout()
        return false
    }
    account = v.account
    folder = v.folder
    folders = v.folders
    messages = v.messages
    total = v.total
    open_id = v.open_id
    reading = v.reading
    open_again = v.open_again
    open_loading = try { v.open_loading == true } catch { false }
    then_compose = try { v.then_compose } catch { "" }
    then_compose_for = try { v.then_compose_for } catch { "" }
    query = v.query
    unread = v.unread
    loaded = v.loaded
    failure = v.failure
    // The search's scope, what it found in the other mailboxes, and where the open message lives.
    search_in = try { v.search_in } catch { nil }
    if search_in == nil { search_in = "box" }
    gathered = try { v.gathered } catch { nil }
    if gathered == nil { gathered = {} }
    elsewhere = try { v.elsewhere } catch { nil }
    if elsewhere == nil { elsewhere = [] }
    open_box = try { v.open_box } catch { nil }
    if open_box == nil || open_box == "" { open_box = folder.id }
    ui.address.set_text(account.address)
    ui.box_title.set_text(folder.name)
    ui.search_clear.set_visible(query != "")
    if reading != nil { desk_show() }
    else if open_loading {
        let pending = nil
        for m in messages { if m.id == open_id && open_box == folder.id { pending = m } }
        for m in elsewhere { if m.id == open_id && m.box == open_box { pending = m } }
        if pending != nil { open_message(pending) } else { open_loading = false pane("inbox") }
    }
    else if open_again != nil { pane("failed") }
    else { pane("inbox") }
    desk_layout()
    desk_refresh()
    desk_resume(v)
    list()
    // A search of every mailbox goes on looking.
    if desk_all() { desk_gather() }
    true
}
// The sheet that was up, with what it held.
fn desk_resume(v){
    delete_target = v.delete_target
    notice_title = v.notice_title
    notice_note = v.notice_note
    notice_back = v.notice_back
    if v.sheet == "notice" {
        ui.notice_title.set_text(notice_title)
        ui.notice_note.set_text(notice_note)
    }
    if v.composing {
        compose_kind = v.kind
        compose_folder = v.compose_folder
        reply_message = v.reply_message
        compose_id = v.compose_id
        compose_retrying = v.compose_retrying
        compose_revision = v.compose_revision
        preparing_review = v.preparing
        compose_generation = try { v.generation } catch { 0 }
        if compose_generation == nil { compose_generation = 0 }
        desk_review_serial = try { v.review_serial } catch { 0 }
        if desk_review_serial == nil { desk_review_serial = 0 }
        compose_head = v.head
        compose_quote = v.quote
        compose_start = v.start
        compose_state = v.state
        compose_missing_attachments = (try { v.missing_attachments == true } catch { false }) || (v.kind == "forward" && v.said == "Attachments aren't forwarded.")
        if v.timer != nil { stop_timer(v.timer) }
        if ui_unified {
            // The tokens as they were, and what was still being typed after them.
            let to_kept = try { v.to_list } catch { nil }
            let to_rest = try { v.to_rest } catch { nil }
            let cc_kept = try { v.cc_list } catch { nil }
            let cc_rest = try { v.cc_rest } catch { nil }
            desk_restore_addresses("to", to_kept, to_rest, v.to)
            desk_restore_addresses("cc", cc_kept, cc_rest, v.cc)
        } else {
            if ui.c_to.text() != v.to { ui.c_to.set_text(v.to) }
            if ui.c_cc.text() != v.cc { ui.c_cc.set_text(v.cc) }
        }
        if ui.c_subject.text() != v.subject { ui.c_subject.set_text(v.subject) }
        if compose_head == "" {
            if ui.c_new_body.text() != v.body { ui.c_new_body.set_text(v.body) }
        } else if ui.c_body.text() != v.body { ui.c_body.set_text(v.body) }
        ui.c_from.set_text(account.address)
        ui.c_new.set_visible(compose_head == "")
        ui.c_thread.set_visible(compose_head != "")
        let level = try { v.level } catch { nil }
        compose_level = if level == nil { 1 } else { level }
        desk_quote_show()
        compose_sent_to = try { v.sent_to } catch { nil }
        compose_sent_cc = try { v.sent_cc } catch { nil }
        compose_sent_subject = try { v.sent_subject } catch { nil }
        compose_sent_body = try { v.sent_body } catch { nil }
        if compose_sent_to == nil { compose_sent_to = desk_to_text() }
        if compose_sent_cc == nil { compose_sent_cc = desk_cc_text() }
        if compose_sent_subject == nil { compose_sent_subject = ui.c_subject.text() }
        if compose_sent_body == nil { compose_sent_body = compose_typed() }
        composing = true
        let said = v.said
        if said == "Attachments aren't forwarded." { said = "" }
        compose_note(said, v.said_bad)
        compose_window(true)
        compose_asking(v.asking)
        compose_changed()
        if preparing_review && desk_review_serial != 0 { desk_review_watch() }
        if compose_state == "awaiting_approval" || compose_state == "sending" || compose_retrying != "" { compose_watch() }
    }
    if v.sheet == "account" { desk_account_words() }
    if v.sheet == "remove" { desk_remove_words() }
    desk_sheet(v.sheet)
}
// Restore an in-memory message as soon as a new appearance has drawn. Account
// discovery still refreshes it afterward, but need not block the editor.
fn touch_early_restore_remove(expected_generation){
    if ui_desk || expected_generation == nil { return false }
    let saved = try { mod.mail_touch_remove } catch { nil }
    if saved == nil || saved.generation != expected_generation || saved.account_data.id != saved.account ||
        (try { saved.closing == true } catch { false }) { return false }
    if !touch_current() { touch_claim_run() }
    account = saved.account_data
    ui.address.set_text(account.address)
    pane("inbox")
    touch_restore_remove()
}
fn touch_early_restore(expected_generation){
    if ui_desk { return false }
    if expected_generation == nil { return touch_early_restore_remove(touch_boot_remove_generation) }
    let saved = try { mod.mail_touch_compose } catch { nil }
    if saved == nil || saved.generation != expected_generation { return false }
    let remembered_account = try { saved.account_data } catch { nil }
    if remembered_account == nil || remembered_account.id != saved.account { return false }
    if !touch_current() { touch_claim_run() }
    account = remembered_account
    ui.address.set_text(account.address)
    touch_restore()
}
let touch_boot_generation = try { mod.mail_touch_compose.generation } catch { nil }
let touch_boot_remove_generation = try { mod.mail_touch_remove.generation } catch { nil }
start_timeout(0.05, || {
    if ui_desk { mod.mail_desk_review_run = desk_review_run }
    else {
        touch_claim_boot()
        touch_early_restore(touch_boot_generation)
    }
    load_accounts()
})

