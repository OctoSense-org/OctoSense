let ComposeField = UiField{height: 28 padding: Inset{left: 0 right: 0 top: 6 bottom: 6} empty_text: ""
    draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000 border_size: 0.0
        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000}}
let ComposeBody = ComposeField{is_multiline: true keeps_tab: true padding: Inset{left: 16 right: 16 top: 12 bottom: 12}
    draw_text +: {text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.4}}}
// Room to type over a quote: a Mac's Mail leaves two lines above it.
let compose_lead = if ui_unified { 60 } else { 96 }
// The New Message window: a window's face, corners and shadow, its title bar as tall
// as the main window's toolbar.
let compose_bar_h = if ui_unified { 52 } else { 40 }
let compose_bar_low = if ui_unified { 40 } else { 28 }
let window_shadow = if ui_light { #x00000040 } else { #x000000a0 }
let MailWindow = RoundedShadowView{flow: Overlay new_batch: true cursor: MouseCursor.Default padding: 1
    draw_bg +: {color: ui_content border_size: 1.0 border_color: ui_border border_radius: 5.0 shadow_color: window_shadow shadow_radius: 20.0 shadow_offset: vec2(0.0, 8.0)}}
// Its lights, as the shell draws a panel's: the red one closes, the other two rest gray.
let light_idle = if ui_light { #xd0d0d4 } else { #x525256 }
let MailCloseLight = ButtonFlat{width: 12 height: 12 margin: 0 padding: 0 text: "" reset_hover_on_click: true
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #xff5f56 color_hover: #xff5f56 color_down: #xe0483f color_focus: #xff5f56}}
let MailLight = RoundedView{width: 12 height: 12 show_bg: true draw_bg +: {color: light_idle border_radius: 3.0}}
// A flagged message's flag, in the Mac's red.
let flag_red = if ui_light { #xff3b30 } else { #xff453a }
// A Mac's search scope bar: All Mailboxes or the mailbox in front, the chosen one on a gray face.
let MailScope = ButtonFlat{height: 22 margin: 0 padding: Inset{left: 9 right: 9}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9}}}
let MailScopeOn = MailScope{draw_bg +: {color: ui_selected color_hover: ui_selected color_down: ui_selected color_focus: ui_selected}}
// An address token, as a Mac's Mail draws one: a capsule in the accent's tint, the name on it.
let token_face = if ui_light { mix(#xffffff, ui_link, 0.14) } else { mix(#x1e1e1e, ui_link, 0.28) }
let ComposeKeyBox = View{width: 56 height: 28 flow: Right align: Align{y: 0.5}}
// No spacing: a field that fills what a row leaves is laid out without it and would wrap
// under the tokens; each token keeps 4 points to its right instead.
let ComposeTokens = View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 0}
let MailToken = GestureView{visible: false width: Fit height: 28 margin: Inset{right: 4} flow: Right align: Align{y: 0.5} cursor: MouseCursor.Default menu: ["Remove Address"]}
let MailTokenFace = RoundedView{width: Fit height: 20 flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} new_batch: true show_bg: true draw_bg +: {color: token_face border_radius: 5.0}}
let MailTokenText = Label{clip_y: false padding: 0 max_width: 220 text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}

// The original's words in a reply's or a forward's quote.
let MailQuoteWords = Label{clip_y: false padding: 0 width: Fill text: "" flow: Flow.Right{wrap: true} draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
// A New Message window: its own title bar, the lights at its corner (the red one closes it),
// Send beside them. A script app has one window, so this one is drawn inside it: over the
// message pane, or on a Mac floating over the viewer (DeskRoot's compose_gap).
let MailCompose = View{visible: false width: Fill height: Fill flow: Overlay align: Align{x: 0.5} padding: Inset{left: 12 right: 12 top: 10 bottom: 12}
    compose_window := MailWindow{width: Fill max_width: 640 height: Fill nav_group: true
        View{width: Fill height: Fill flow: Down
            View{width: Fill height: compose_bar_h flow: Overlay
                RoundedView{width: Fill height: Fill show_bg: true draw_bg +: {color: ui_bar border_radius: 4.5}}
                SolidView{width: Fill height: compose_bar_low margin: Inset{top: 12} draw_bg.color: ui_bar}
                View{width: Fill height: Fill flow: Right align: Align{y: 0.5} spacing: 4 padding: Inset{left: if ui_unified { 19 } else { 8 } right: 10}
                    if ui_unified {
                        View{width: Fit height: Fit flow: Right spacing: 8 margin: Inset{right: 14}
                            compose_close := MailCloseLight{on_click: || compose_cancel()}
                            MailLight{}
                            MailLight{}
                        }
                    } else {
                        View{width: Fit height: Fit
                            compose_close := MailTool{draw_icon +: {svg: mail_icon("xmark")} on_click: || compose_cancel()}
                        }
                    }
                    send_off := MailToolOff{draw_icon +: {svg: mail_icon("send")}}
                    send_on := MailTool{visible: false draw_icon +: {svg: mail_icon("send")} on_click: || compose_send()}
                    c_title := UiBarTitle{width: Fill margin: Inset{left: 6 right: 8} text: "New Message" text_overflow: Ellipsis}
                }
            }
            UiSep{}
            // A Mac's address fields: a finished address is a token, by name where Mail
            // knows one, and the typing goes on after the tokens.
            if ui_unified {
                View{width: Fill height: Fit flow: Down
                    ComposeLine{height: Fit align: Align{y: 0.0} padding: Inset{left: 16 right: 16 top: 2 bottom: 2}
                        ComposeKeyBox{ComposeKey{text: "To:"}}
                        ComposeTokens{
                            to_t0 := MailToken{on_menu: |title| desk_token_menu("to", 0, title) MailTokenFace{to_n0 := MailTokenText{}}}
                            to_t1 := MailToken{on_menu: |title| desk_token_menu("to", 1, title) MailTokenFace{to_n1 := MailTokenText{}}}
                            to_t2 := MailToken{on_menu: |title| desk_token_menu("to", 2, title) MailTokenFace{to_n2 := MailTokenText{}}}
                            to_t3 := MailToken{on_menu: |title| desk_token_menu("to", 3, title) MailTokenFace{to_n3 := MailTokenText{}}}
                            to_t4 := MailToken{on_menu: |title| desk_token_menu("to", 4, title) MailTokenFace{to_n4 := MailTokenText{}}}
                            to_t5 := MailToken{on_menu: |title| desk_token_menu("to", 5, title) MailTokenFace{to_n5 := MailTokenText{}}}
                            to_t6 := MailToken{on_menu: |title| desk_token_menu("to", 6, title) MailTokenFace{to_n6 := MailTokenText{}}}
                            to_t7 := MailToken{on_menu: |title| desk_token_menu("to", 7, title) MailTokenFace{to_n7 := MailTokenText{}}}
                            c_to := ComposeField{width: Fill{min: 90} on_change: |text| desk_address_typed("to", text) on_return: |text| desk_address_return("to") on_tab: |text, shift| desk_address_tab("to", shift)}
                        }
                    }
                    ComposeRule{}
                    ComposeLine{height: Fit align: Align{y: 0.0} padding: Inset{left: 16 right: 16 top: 2 bottom: 2}
                        ComposeKeyBox{ComposeKey{text: "Cc:"}}
                        ComposeTokens{
                            cc_t0 := MailToken{on_menu: |title| desk_token_menu("cc", 0, title) MailTokenFace{cc_n0 := MailTokenText{}}}
                            cc_t1 := MailToken{on_menu: |title| desk_token_menu("cc", 1, title) MailTokenFace{cc_n1 := MailTokenText{}}}
                            cc_t2 := MailToken{on_menu: |title| desk_token_menu("cc", 2, title) MailTokenFace{cc_n2 := MailTokenText{}}}
                            cc_t3 := MailToken{on_menu: |title| desk_token_menu("cc", 3, title) MailTokenFace{cc_n3 := MailTokenText{}}}
                            cc_t4 := MailToken{on_menu: |title| desk_token_menu("cc", 4, title) MailTokenFace{cc_n4 := MailTokenText{}}}
                            cc_t5 := MailToken{on_menu: |title| desk_token_menu("cc", 5, title) MailTokenFace{cc_n5 := MailTokenText{}}}
                            cc_t6 := MailToken{on_menu: |title| desk_token_menu("cc", 6, title) MailTokenFace{cc_n6 := MailTokenText{}}}
                            cc_t7 := MailToken{on_menu: |title| desk_token_menu("cc", 7, title) MailTokenFace{cc_n7 := MailTokenText{}}}
                            c_cc := ComposeField{width: Fill{min: 90} on_change: |text| desk_address_typed("cc", text) on_return: |text| desk_address_return("cc") on_tab: |text, shift| desk_address_tab("cc", shift)}
                        }
                    }
                }
            } else {
                View{width: Fill height: Fit flow: Down
                    ComposeLine{
                        ComposeKey{text: "To:"}
                        c_to := ComposeField{on_change: |text| compose_changed()}
                    }
                    ComposeRule{}
                    ComposeLine{
                        ComposeKey{text: "Cc:"}
                        c_cc := ComposeField{on_change: |text| compose_changed()}
                    }
                }
            }
            ComposeRule{}
            ComposeLine{
                ComposeKey{text: "Subject:"}
                c_subject := ComposeField{on_change: |text| desk_subject_typed()}
            }
            ComposeRule{}
            ComposeLine{
                ComposeKey{text: "From:"}
                c_from := ComposeText{}
            }
            UiSep{}
            // This is part of the message being composed, not
            // a transient send status: it remains visible when
            // the host review opens or the window is restored.
            c_missing_attachments := View{visible: false width: Fill height: Fit flow: Down
                SolidView{width: Fill height: Fit padding: Inset{left: 16 right: 16 top: 8 bottom: 8} draw_bg.color: ui_bar
                    Label{clip_y: false padding: 0 width: Fill text: "Original attachments aren't included." flow: Flow.Right{wrap: true} draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
                }
                UiSep{}
            }
            c_keep_warning := View{visible: false width: Fill height: Fit flow: Down
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 16 right: 16 top: 8 bottom: 8}
                    Label{clip_y: false padding: 0 width: Fill text: "Recent changes may be lost if Mail closes. Check storage." flow: Flow.Right{wrap: true} draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
                    c_keep_try := UiButton{text: "Try Again" on_click: || desk_retry_keep()}
                }
                UiSep{}
            }
            // A text field can't hide itself: the view around it can.
            c_new := View{visible: false width: Fill height: Fill
                c_new_body := ComposeBody{height: Fill on_change: |text| desk_body_typed()}
            }
            c_thread := ScrollYView{visible: false width: Fill height: Fill flow: Down
                c_body := ComposeBody{height: Fit min_height: compose_lead on_change: |text| desk_body_typed()}
                View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 bottom: 16}
                    c_q1 := SolidView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 12}
                        draw_bg +: {bar: uniform(ui_link) pixel: fn(){
                            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
                            sdf.box(0.0, 0.0, 2.0, self.rect_size.y, 1.0)
                            return sdf.fill(self.bar)
                        }}
                        c_quote_head := Label{clip_y: false padding: 0 width: Fill text: "" flow: Flow.Right{wrap: true} draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
                        c_quote_text := Label{clip_y: false padding: 0 width: Fill text: "" flow: Flow.Right{wrap: true} draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.4}}}
                    }
                    // The same words at the other quote levels a Mac's Format menu sets: none, two, three.
                    if ui_unified {
                        View{width: Fill height: Fit flow: Down
                            c_q0 := View{visible: false width: Fill height: Fit flow: Down spacing: 8
                                c_quote_head0 := MailQuoteWords{draw_text +: {color: ui_ink}}
                                c_quote_text0 := MailQuoteWords{draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.4}}}
                            }
                            c_q2 := SolidView{visible: false width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 17}
                                draw_bg +: {bar: uniform(ui_link) pixel: fn(){
                                    let sdf = Sdf2d.viewport(self.pos * self.rect_size)
                                    sdf.box(0.0, 0.0, 2.0, self.rect_size.y, 1.0)
                                    sdf.box(5.0, 0.0, 2.0, self.rect_size.y, 1.0)
                                    return sdf.fill(self.bar)
                                }}
                                c_quote_head2 := MailQuoteWords{}
                                c_quote_text2 := MailQuoteWords{draw_text +: {text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.4}}}
                            }
                            c_q3 := SolidView{visible: false width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 22}
                                draw_bg +: {bar: uniform(ui_link) pixel: fn(){
                                    let sdf = Sdf2d.viewport(self.pos * self.rect_size)
                                    sdf.box(0.0, 0.0, 2.0, self.rect_size.y, 1.0)
                                    sdf.box(5.0, 0.0, 2.0, self.rect_size.y, 1.0)
                                    sdf.box(10.0, 0.0, 2.0, self.rect_size.y, 1.0)
                                    return sdf.fill(self.bar)
                                }}
                                c_quote_head3 := MailQuoteWords{}
                                c_quote_text3 := MailQuoteWords{draw_text +: {text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.4}}}
                            }
                        }
                    }
                }
            }
            c_foot := View{visible: false width: Fill height: Fit flow: Down
                UiSep{}
                View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 9 bottom: 9}
                    c_note := Label{clip_y: false padding: 0 width: Fill text: "" flow: Flow.Right{wrap: true} draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                    c_error := Label{visible: false clip_y: false padding: 0 width: Fill text: "" flow: Flow.Right{wrap: true} draw_text +: {color: ui_danger text_style: theme.font_regular{font_size: 8.25}}}
                }
            }
        }
        // Closing it with words in it asks first, on a sheet of its own.
        compose_ask := View{visible: false width: Fill height: Fill flow: Overlay
            GestureView{width: Fill height: Fill cursor: MouseCursor.Default on_tap: |x, y| {}
                RoundedView{width: Fill height: Fill new_batch: true show_bg: true draw_bg +: {color: sheet_dim border_radius: 4.5}}
            }
            View{width: Fill height: Fit flow: Down align: Align{x: 0.5} padding: Inset{top: compose_bar_h left: 14 right: 14}
                // A Mac's alert, as the system draws one (UiAlertPanel): the app's icon on
                // top, the words centred under it, Discard and Keep Editing side by side.
                if ui_unified {
                    UiAlertPanel{
                        if ui_alert_icon { UiAlertIcon{app: "os.mail" width: 64 height: 64} }
                        UiAlertTitle{text: "Discard this message?"}
                        compose_discard_note := UiAlertNote{text: "Your changes won't be kept."}
                        UiAlertRow{
                            UiButton{width: Fill reset_hover_on_click: true text: "Discard" on_click: || compose_close()}
                            UiPrimary{width: Fill key_default: true key_cancel: true reset_hover_on_click: true text: "Keep Editing" on_click: || compose_asking(false)}
                        }
                    }
                } else {
                    MailPanel{width: Fill max_width: if ui_alert_icon { 420 } else { 340 } height: Fit spacing: 6 padding: Inset{left: 20 right: 20 top: 18 bottom: 16}
                        // A Mac alert: the app's icon beside its words.
                        View{width: Fill height: Fit flow: Right spacing: 14
                            if ui_alert_icon { UiAlertIcon{app: "os.mail" width: 52 height: 52} }
                            View{width: Fill height: Fit flow: Down spacing: 6
                                SheetTitle{text: "Discard this message?"}
                                compose_discard_note := SheetNote{text: "Your changes won't be kept."}
                            }
                        }
                        SheetButtons{
                            UiButton{text: "Discard" on_click: || compose_close()}
                            UiPrimary{key_default: true key_cancel: true text: "Keep Editing" on_click: || compose_asking(false)}
                        }
                    }
                }
            }
        }
    }
}
let DeskRoot = SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: ui_page
    columns := View{width: Fill height: Fill flow: Right
        // The sidebar's room while it's beside the list: it stands in a layer of its own.
        side_gap := View{width: 209 height: Fill}
        // 320 points beside the message; all the window leaves when the message steps aside
        // for a sidebar in a narrow window.
        inbox := View{width: Fill{weight: 0.000001 basis: 320 shrink: 1.0} min_width: 200 height: Fill flow: Down
            UiToolbar{
                lights_gap := View{visible: false width: 72 height: 1}
                sidebar_tool := MailTool{draw_icon +: {svg: mail_icon("sidebar")} on_click: || toggle_sidebar()}
                View{width: Fill height: Fit flow: Down spacing: 1 margin: Inset{left: 2}
                    box_title := UiBarTitle{width: Fill text: "Inbox" text_overflow: Ellipsis}
                    status := UiBarSub{visible: false width: Fill text: "" text_overflow: Ellipsis}
                }
                get_on := MailTool{visible: false draw_icon +: {svg: mail_icon("envelope")} on_click: || get_mail()}
                get_off := MailToolOff{draw_icon +: {svg: mail_icon("envelope")}}
                new_on := MailTool{visible: false draw_icon +: {svg: mail_icon("compose")} on_click: || desk_compose("new")}
                new_off := MailToolOff{draw_icon +: {svg: mail_icon("compose")}}
            }
            UiSep{}
            // While a search is up, where it looks, as a Mac's Mail says under its toolbar.
            scope_bar := View{visible: false width: Fill height: Fit flow: Down
                SolidView{width: Fill height: 32 flow: Right align: Align{y: 0.5} spacing: 2 padding: Inset{left: 10 right: 10} draw_bg.color: ui_content
                    scope_all := MailScope{text: "All Mailboxes" on_click: || desk_scope("all")}
                    scope_all_on := MailScopeOn{visible: false text: "All Mailboxes"}
                    scope_box := MailScope{visible: false text: "Inbox" on_click: || desk_scope("box")}
                    scope_box_on := MailScopeOn{text: "Inbox"}
                }
                UiSep{}
            }
            keep_warning := View{visible: false width: Fill height: Fit flow: Down
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 12 right: 8 top: 8 bottom: 8}
                    Label{clip_y: false padding: 0 width: Fill text: "Mail couldn't save its window. An older state may return after reopening. Check storage." flow: Flow.Right{wrap: true} draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 8.25}}}
                    keep_try := UiButton{text: "Try Again" on_click: || desk_retry_keep()}
                }
                UiSep{}
            }
            SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: ui_content
                // render() re-applies what's declared here: a list that says nothing stays up, empty.
                list_keys := GestureView{width: Fill height: Fill cursor: MouseCursor.Default on_key: |key, cmd, shift| desk_list_key(key, cmd, shift)
                rows := ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 8 right: 8 top: 8 bottom: 8} on_render: || {
                    // A render that makes nothing leaves the last rows up.
                    if shown.len() == 0 { View{width: 1 height: 1} }
                    // A search of every mailbox says on each row where it lives.
                    let everywhere = desk_all()
                    let chosen = -1
                    for i in shown.len() { if desk_is_open(shown[i]) { chosen = i } }
                    for i in shown.len() {
                        let m = shown[i]
                        let on = i == chosen
                        GestureView{width: Fill height: 80 cursor: MouseCursor.Default on_tap: |x, y| row_clicked(m) menu: desk_row_titles(m) on_menu: |title| desk_row_menu(m, title)
                            RoundedView{width: Fill height: Fill flow: Right new_batch: true show_bg: true draw_bg +: {color: if on { ui_accent_row } else { #x00000000 } border_radius: 4.0}
                                View{width: 18 height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: 13}
                                    if m.unread { RoundedView{width: 8 height: 8 new_batch: true show_bg: true draw_bg +: {color: if on { #xffffff } else { ui_link } border_radius: 2.0}} }
                                }
                                View{width: Fill height: Fill flow: Down spacing: 1 padding: Inset{right: 10 top: 9}
                                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 1.0}
                                        // Every name in bold, as Mail sets them; the dot says it's unread.
                                        Label{clip_y: false padding: 0 width: Fill text: row_name(m) max_lines: 1 text_overflow: Ellipsis draw_text +: {color: if on { #xffffff } else { ui_ink } text_style: if ui_unified || m.unread { row_bold } else { row_plain }}}
                                        if m.flagged == true { Svg{width: 11 height: 11 margin: Inset{bottom: 2} animating: false draw_svg +: {svg: mail_icon("flag") color: if on { #xffffff } else { flag_red } preserve_viewbox: true}} }
                                        Label{clip_y: false padding: 0 text: m.time draw_text +: {color: if on { on_accent } else { ui_muted } text_style: theme.font_regular{font_size: 8.25}}}
                                    }
                                    if everywhere {
                                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 1.0}
                                            Label{clip_y: false padding: 0 width: Fill text: m.subject max_lines: 1 text_overflow: Ellipsis draw_text +: {color: if on { #xffffff } else { ui_ink } text_style: theme.font_regular{font_size: 9}}}
                                            Label{clip_y: false padding: 0 text: desk_box_name(m) max_lines: 1 draw_text +: {color: if on { on_accent } else { ui_muted } text_style: theme.font_regular{font_size: 8.25}}}
                                        }
                                    } else {
                                        Label{clip_y: false padding: 0 width: Fill text: m.subject max_lines: 1 text_overflow: Ellipsis draw_text +: {color: if on { #xffffff } else { ui_ink } text_style: theme.font_regular{font_size: 9}}}
                                    }
                                    Label{clip_y: false padding: 0 width: Fill text: row_preview(m) max_lines: 2 text_overflow: Ellipsis draw_text +: {color: if on { on_accent } else { ui_muted } text_style: theme.font_regular{font_size: 9}}}
                                }
                            }
                        }
                        if i < shown.len() - 1 {
                            if on || i + 1 == chosen { View{width: Fill height: 1} }
                            else { UiSep{margin: Inset{left: 18 right: 10}} }
                        }
                    }
                }}
                }
                list_loading := MailEmptyPane{spacing: 8
                    LoadingSpinner{width: 18 height: 18 draw_bg +: {color: ui_muted stroke_width: 2.0}}
                    Label{clip_y: false padding: 0 text: "Checking for Mail…" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
                }
                list_empty := MailEmptyPane{visible: false
                    MailEmptyGlyph{margin: Inset{bottom: 4} draw_svg +: {svg: mail_icon("tray")}}
                    MailEmptyTitle{text: "No Messages"}
                    list_empty_note := MailEmptyNote{text: "New mail appears here when it arrives."}
                    list_empty_get := UiButton{margin: Inset{top: 8} text: "Get Mail" on_click: || get_mail()}
                }
                list_none := MailEmptyPane{visible: false
                    MailEmptyGlyph{margin: Inset{bottom: 4} draw_svg +: {svg: ui_icon("search") preserve_viewbox: false}}
                    MailEmptyTitle{text: "No Results"}
                    list_none_note := MailEmptyNote{text: "No messages in this mailbox match your search."}
                    UiButton{margin: Inset{top: 8} text: "Clear Search" on_click: || clear_query()}
                }
                list_failed := MailEmptyPane{visible: false
                    MailEmptyGlyph{margin: Inset{bottom: 4} draw_svg +: {svg: mail_icon("envelope")}}
                    MailEmptyTitle{text: "Can't Get Mail"}
                    list_failed_note := MailEmptyNote{}
                    failed_try := UiButton{margin: Inset{top: 8} text: "Try Again" on_click: || try_again()}
                    failed_reconnect := UiButton{visible: false margin: Inset{top: 8} text: "Reconnect Account…" on_click: || reconnect()}
                }
            }
            fail_bar := SolidView{visible: false width: Fill height: Fit flow: Down draw_bg.color: ui_bar
                UiSep{}
                View{width: Fill height: 36 flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 12 right: 8}
                    fail_note := Label{clip_y: false padding: 0 width: Fill text: "Can't get new mail." max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                    fail_try := UiButton{height: 24 padding: Inset{left: 10 right: 10} text: "Try Again" on_click: || try_again()}
                    fail_reconnect := UiButton{visible: false height: 24 padding: Inset{left: 10 right: 10} text: "Reconnect Account…" on_click: || reconnect()}
                }
            }
        }
        list_sep := UiVSep{}
        // The message: the rest of the window, and with a narrow window's sidebar out, at least
        // as wide as the list gives way for (280 points, down to 200 in the narrowest).
        reader_column := View{width: Fill{weight: 1.0 basis: 280 shrink: 0.25} min_width: 200 height: Fill flow: Down
            UiToolbar{
                reply_on := MailTool{visible: false draw_icon +: {svg: mail_icon("reply")} on_click: || desk_compose("reply")}
                reply_off := MailToolOff{draw_icon +: {svg: mail_icon("reply")}}
                reply_all_on := MailTool{visible: false draw_icon +: {svg: mail_icon("reply-all")} on_click: || desk_compose("reply_all")}
                reply_all_off := MailToolOff{draw_icon +: {svg: mail_icon("reply-all")}}
                forward_on := MailTool{visible: false draw_icon +: {svg: mail_icon("forward")} on_click: || desk_compose("forward")}
                forward_off := MailToolOff{draw_icon +: {svg: mail_icon("forward")}}
                // What a tight window's toolbar has no room for, as a Mac's toolbar overflows.
                more_tool := GestureView{visible: false width: Fit height: Fit on_menu: |title| desk_compose(if title == "Reply All" { "reply_all" } else { "forward" })
                    UiTool{reset_hover_on_click: true text: "»" on_click: || ui.more_tool.open_menu(desk_more_rows())}
                }
                View{width: 8 height: 1}
                archive_on := MailTool{visible: false draw_icon +: {svg: mail_icon("archive")} on_click: || { if sheet == "" { desk_move(reading, "archive") } }}
                archive_off := MailToolOff{draw_icon +: {svg: mail_icon("archive")}}
                delete_on := MailTool{visible: false draw_icon +: {svg: mail_icon("trash")} on_click: || { if sheet == "" { desk_delete(reading) } }}
                delete_off := MailToolOff{draw_icon +: {svg: mail_icon("trash")}}
                // The search field keeps to the trailing edge, and gives way first in a narrow window.
                View{width: Fill height: 28 flow: Right align: Align{x: 1.0 y: 0.5}
                    View{width: Fill max_width: 180 height: 28 flow: Overlay align: Align{y: 0.5}
                        search := UiSearch{empty_text: "Search" on_change: |text| set_query(text) on_escape: |text| { clear_query(); ui.list_keys.focus() }}
                        UiGlyph{width: 14 height: 14 margin: Inset{left: 8} draw_svg +: {svg: ui_icon("search")}}
                        search_clear := View{visible: false width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5}
                            search_clear_tool := UiPaneTool{width: 24 height: 24 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: ui_icon("search-clear") color: ui_muted} on_click: || clear_query()}
                        }
                        search_block := GestureView{visible: false width: Fill height: Fill cursor: MouseCursor.Default on_tap: |x, y| {}}
                    }
                }
            }
            UiSep{}
            SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: ui_content
                no_account := MailEmptyPane{visible: false
                    MailEmptyGlyph{margin: Inset{bottom: 4} draw_svg +: {svg: mail_icon("envelope")}}
                    MailEmptyTitle{text: "No Mail Account"}
                    MailEmptyNote{text: "Add an account to read and send mail."}
                    UiPrimary{margin: Inset{top: 8} text: "Add Account…" on_click: || add_account()}
                    welcome_note := MailEmptyNote{margin: Inset{top: 4} draw_text +: {color: ui_danger}}
                }
                no_message := MailEmptyPane{visible: false
                    if ui_unified {
                        MailNoPick{text: "No Message Selected"}
                    } else {
                        MailEmptyGlyph{margin: Inset{bottom: 4} draw_svg +: {svg: mail_icon("envelope")}}
                        MailEmptyTitle{text: "No Message Selected"}
                    }
                }
                loading_message := MailEmptyPane{visible: false
                    LoadingSpinner{width: 18 height: 18 draw_bg +: {color: ui_muted stroke_width: 2.0}}
                    MailEmptyNote{margin: Inset{top: 8} text: "Loading Message…"}
                }
                open_failed := MailEmptyPane{visible: false
                    MailEmptyGlyph{margin: Inset{bottom: 4} draw_svg +: {svg: mail_icon("envelope")}}
                    MailEmptyTitle{text: "Can't Open This Message"}
                    MailEmptyNote{text: "It may have moved on the mail server."}
                    UiButton{margin: Inset{top: 8} text: "Try Again" on_click: || open_retry()}
                }
                reader := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 16 bottom: 24}
                    View{width: Fill height: Fit flow: Right spacing: 12
                        RoundedView{width: 36 height: 36 flow: Down align: Align{x: 0.5 y: 0.5} new_batch: true show_bg: true draw_bg +: {color: #x6e6e73 border_radius: 9.0}
                            r_initials := Label{clip_y: false padding: 0 text: "" draw_text +: {color: #xffffff text_style: theme.font_regular{font_size: 9.75}}}
                        }
                        View{width: Fill height: Fit flow: Down spacing: 2
                            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 1.0}
                                r_sender := Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75}}}
                                r_time := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                                r_attach_menu := GestureView{visible: false width: Fit height: Fit on_menu: |title| desk_attachment_menu(title)
                                    UiButton{text: "Save…" on_click: || ui.r_attach_menu.open_menu(desk_attachment_titles())}
                                }
                            }
                            r_subject := Label{clip_y: false padding: 0 width: Fill text: "" flow: Flow.Right{wrap: true} draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
                            r_where := Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                            r_to := Label{visible: false clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                            r_cc := Label{visible: false clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                        }
                    }
                    UiSep{margin: Inset{top: 12 bottom: 14}}
                    r_attach := View{visible: false width: Fill height: Fit flow: Down spacing: 4 margin: Inset{bottom: 12}
                        // A Mac's attachments, as Mail shows them: "N Attachments" and one Save menu
                        // over the files, each a document with its kind on the page, its name and
                        // size under it. A click saves it through the Mac's save panel, as its button
                        // did; nothing here opens what a stranger sent.
                        if ui_unified {
                            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5} margin: Inset{bottom: 6}
                                UiGlyph{width: 14 height: 14 draw_svg +: {svg: mail_icon("attach") preserve_viewbox: true}}
                                r_attach_count := Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                                r_attach_save := GestureView{width: Fit height: Fit on_menu: |title| desk_attachment_menu(title)
                                    UiButton{text: "Save…" on_click: || ui.r_attach_save.open_menu(desk_attachment_titles())}
                                }
                            }
                        }
                        r_files := View{width: Fill height: Fit flow: if ui_unified { Flow.Right{wrap: true} } else { Down } spacing: if ui_unified { 8 } else { 4 } on_render: || {
                            for i in files.len() {
                                let a = files[i]
                                if ui_unified {
                                    GestureView{width: 112 height: Fit cursor: MouseCursor.Default on_tap: |x, y| desk_save(i) menu: ["Save Attachment…"] on_menu: |title| desk_save(i)
                                        View{width: Fill height: Fit flow: Down align: Align{x: 0.5} spacing: 2 padding: Inset{top: 2 bottom: 4 left: 4 right: 4}
                                            View{width: 32 height: 40 flow: Overlay margin: Inset{bottom: 3}
                                                Svg{width: 32 height: 40 animating: false draw_svg +: {svg: mail_icon("file-page") color: file_page preserve_viewbox: true}}
                                                Svg{width: 32 height: 40 animating: false draw_svg +: {svg: mail_icon("file-edge") color: file_edge preserve_viewbox: true}}
                                                View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0} padding: Inset{bottom: 6}
                                                    Label{clip_y: false padding: 0 text: file_kind(a.filename) max_lines: 1 draw_text +: {color: file_kind_ink text_style: theme.font_bold{font_size: 5.25}}}
                                                }
                                            }
                                            Label{clip_y: false padding: 0 width: Fill text: a.filename align: Align{x: 0.5} flow: Flow.Right{wrap: true} max_lines: 2 text_overflow: Ellipsis
                                                draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 8.25 line_spacing: 1.2}}}
                                            Label{clip_y: false padding: 0 text: kb(a.size) max_lines: 1 draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                                        }
                                    }
                                } else {
                                    View{width: Fill height: 28 flow: Right spacing: 4 align: Align{y: 0.5}
                                        UiGlyph{width: 18 height: 18 draw_svg +: {svg: mail_icon("attach") preserve_viewbox: true}}
                                        UiButton{width: Fill max_width: 240 text: a.filename on_click: || desk_save(i)}
                                        Label{clip_y: false padding: 0 margin: Inset{left: 6} width: Fit text: kb(a.size) max_lines: 1 draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                                    }
                                }
                            }
                        }}
                        r_save_note := Label{visible: false clip_y: false padding: 0 width: Fill text: "" flow: Flow.Right{wrap: true} draw_text +: {color: ui_danger text_style: theme.font_regular{font_size: 8.25}}}
                    }
                    r_body := Label{padding: 0 width: Fill text: "" flow: Flow.Right{wrap: true} draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.4}}}
                    r_html := Html{width: Fill height: Fit padding: 0 font_color: ui_ink font_size: 9.75
                        draw_text +: {color: ui_ink}
                        a +: {color: ui_link pressed_color: ui_ink}
                        text_style_normal +: {font_size: 9.75} text_style_bold +: {font_size: 9.75}
                        text_style_italic +: {font_size: 9.75} text_style_bold_italic +: {font_size: 9.75} text_style_fixed +: {font_size: 9}}
                }
                // A New Message window, over the message pane: its own title bar, the lights at its
                // corner (the red one closes it), Send beside them. The mailboxes and the list stay
                // where they were. A script app has one window, so this one is drawn inside it.
                // A Mac's floats over the viewer instead, at the window's own level (DeskRoot).
                if !ui_unified {
                    View{width: Fill height: Fill
                        compose_layer := MailCompose{}
                    }
                }
            }
        }
    }
    side_layer := View{width: Fit height: Fill flow: Right new_batch: true
        sidebar := UiSidebar{
            UiSideHead{padding: Inset{left: 4 top: 0 bottom: 4} text: "Mailboxes"}
            folder_rows := ScrollYView{width: Fill height: Fill flow: Down spacing: 1 on_render: || {
                if folders.len() == 0 {
                    MailSideOn{text: folder.name draw_icon +: {svg: mail_icon("tray")}}
                }
                for f in folders {
                    let count = unread[f.id]
                    View{width: Fill height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
                        if f.id == folder.id { MailSideOn{text: f.name draw_icon +: {svg: mail_icon(folder_icon(f))} on_click: || open_folder(f)} }
                        else { MailSide{text: f.name draw_icon +: {svg: mail_icon(folder_icon(f))} on_click: || open_folder(f)} }
                        if count != nil && count > 0 {
                            Label{clip_y: false padding: 0 margin: Inset{right: 8} text: "" + count draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9}}}
                        }
                    }
                }
            }}
            // Where a Mac's Mail offers Undo Send, a moment after a message goes (desk_sent_said).
            sent_foot := View{visible: false width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6 padding: Inset{left: 8 top: 6 bottom: 2}
                UiGlyph{width: 14 height: 14 draw_svg +: {svg: mail_icon("send") preserve_viewbox: true}}
                Label{clip_y: false padding: 0 width: Fill text: "Message sent" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9}}}
            }
            side_foot := View{visible: false width: Fill height: Fit flow: Down
                UiSep{margin: Inset{top: 6 bottom: 4}}
                View{width: Fill height: 28 flow: Right align: Align{y: 0.5} spacing: 2 padding: Inset{left: 8}
                    address := Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
                    account_tool := MailTool{draw_icon +: {svg: mail_icon("gear")} on_click: || open_account()}
                }
            }
        }
        UiVSep{}
    }
    // A Mac's New Message window floats over the viewer, as Mail's does: over the message pane,
    // and over the list too where that pane is too narrow to write in (desk_compose_left), then
    // over the sidebar's edge: it is drawn over the sidebar's layer. Its top sits over the list's
    // first row, so no edge of a chosen row shows above it.
    if ui_unified {
        View{width: Fill height: Fill flow: Right new_batch: true
            compose_gap := View{width: Fit height: Fill on_render: || { View{width: desk_compose_left() height: 1} }}
            View{width: Fill height: Fill flow: Down
                View{width: Fill height: 47}
                compose_layer := MailCompose{}
            }
        }
    }
    sheets := View{visible: false width: Fill height: Fill flow: Overlay
        // The toolbar's band stays the window's to drag; its tools wait for the sheet.
        sheet_dims := View{width: Fill height: Fill flow: Down
            SolidView{width: Fill height: if ui_unified { 52 } else { 0 } new_batch: true draw_bg.color: sheet_dim}
            MailDim{}
        }
        account_sheet := View{visible: false width: Fill height: Fill flow: Overlay
            // A Mac's Mail keeps an account in its Settings window (Mail > Settings…, Command-comma),
            // on the Accounts tab: a window, drawn inside Mail's as New Message is, with Mail's own
            // undimmed behind it. A press on Mail's window brings that forward on a Mac: here the
            // Settings window goes, and the press does nothing more (desk_settings_away).
            if ui_unified {
                View{width: Fill height: Fill flow: Down
                    View{width: Fill height: 52}
                    GestureView{width: Fill height: Fill cursor: MouseCursor.Default on_tap: |x, y| desk_settings_away()}
                }
                View{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{left: 16 right: 16 top: 69 bottom: 24}
                    GestureView{width: Fit height: Fit cursor: MouseCursor.Default on_tap: |x, y| {}
                        settings_window := MailWindow{width: 520 height: Fit nav_group: true
                            View{width: Fill height: Fit flow: Down
                                // Its lights and title, and under them its tabs, on the bar's face. This
                                // Mail has settings for its account only: Accounts is its one tab.
                                View{width: Fill height: 84 flow: Overlay
                                    RoundedView{width: Fill height: Fill show_bg: true draw_bg +: {color: ui_bar border_radius: 4.5}}
                                    SolidView{width: Fill height: 72 margin: Inset{top: 12} draw_bg.color: ui_bar}
                                    View{width: Fill height: 30 flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 13}
                                        acct_close := MailCloseLight{key_cancel: true on_click: || desk_sheet("")}
                                        MailLight{}
                                        MailLight{}
                                    }
                                    View{width: Fill height: 30 align: Align{x: 0.5 y: 0.5}
                                        acct_title := UiBarTitle{text: "Accounts" draw_text +: {text_style: theme.font_bold{font_size: 9.75}}}
                                    }
                                    View{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: 31}
                                        RoundedView{width: Fit height: 47 flow: Down align: Align{x: 0.5 y: 0.5} spacing: 3 padding: Inset{left: 10 right: 10} show_bg: true draw_bg +: {color: ui_selected border_radius: 6.0}
                                            UiGlyph{width: 22 height: 22 draw_svg +: {svg: mail_icon("at") color: ui_link preserve_viewbox: true}}
                                            Label{clip_y: false padding: 0 text: "Accounts" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 8.25}}}
                                        }
                                    }
                                }
                                UiSep{}
                                View{width: Fill height: Fit flow: Right spacing: 18 padding: Inset{left: 20 right: 20 top: 18 bottom: 20}
                                    // The accounts: this Mail's one, chosen. Its − removes it; with one account
                                    // there is no + to add another.
                                    View{width: 168 height: Fit flow: Down
                                        RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: ui_content border_size: 1.0 border_color: ui_border border_radius: 4.0}
                                            View{width: Fill height: 150 flow: Down padding: 4
                                                RoundedView{width: Fill height: 36 flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 8 right: 8} show_bg: true draw_bg +: {color: ui_accent_row border_radius: 4.0}
                                                    UiGlyph{width: 18 height: 18 draw_svg +: {svg: mail_icon("envelope") color: #xffffff preserve_viewbox: true}}
                                                    acct_name := Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 9}}}
                                                }
                                            }
                                            // Its − sits on the list's foot, under a line, as a Mac's lists in Settings keep theirs.
                                            SolidView{width: Fill height: 1 draw_bg.color: ui_border}
                                            View{width: Fill height: 24 flow: Right align: Align{y: 0.5} padding: Inset{left: 3}
                                                acct_remove := UiToolIcon{width: 24 height: 20 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: ui_icon("minus") color: ui_ink preserve_viewbox: true} on_click: || confirm_remove()}
                                            }
                                        }
                                    }
                                    // What this Mail knows of the account; its servers are OctoSense's to keep.
                                    View{width: Fill height: Fit flow: Down spacing: 10
                                        SheetTitle{text: "Account Information"}
                                        UiFormLine{
                                            UiFormKey{width: 100 text: "Email Address:"}
                                            acct_address := ComposeText{margin: 0}
                                        }
                                        UiFormLine{
                                            UiFormKey{width: 100 text: "Server Settings:"}
                                            UiButton{text: "Reconnect Account…" on_click: || reconnect()}
                                        }
                                        SheetNote{text: "OctoSense keeps the account's servers, user name and password: Reconnect Account… opens its sign-in sheet."}
                                    }
                                }
                            }
                        }
                    }
                }
            } else {
                MailPlace{
                    MailPanel{width: 460 height: Fit spacing: 10 padding: Inset{left: 20 right: 20 top: 18 bottom: 16}
                        SheetTitle{text: "Account Settings"}
                        UiFormLine{margin: Inset{top: 4}
                            UiFormKey{width: 90 text: "Email address:"}
                            acct_address := ComposeText{margin: 0}
                        }
                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5} margin: Inset{top: 6}
                            UiButton{text: "Remove Account…" on_click: || confirm_remove()}
                            View{width: Fill height: 1}
                            UiButton{text: "Reconnect Account…" on_click: || reconnect()}
                            UiPrimary{key_default: true key_cancel: true text: "Done" padding: Inset{left: 18 right: 18} on_click: || desk_sheet("")}
                        }
                    }
                }
            }
        }
        delete_alert := View{visible: false width: Fill height: Fill flow: Overlay
            MailPlace{
                // A Mac's alerts share one layout (UiAlertPanel): the app's icon on top, the
                // words centred, two buttons side by side with the default on the right.
                if ui_unified {
                    UiAlertPanel{
                        if ui_alert_icon { UiAlertIcon{app: "os.mail" width: 64 height: 64} }
                        UiAlertTitle{text: "Delete This Message Permanently?"}
                        UiAlertNote{text: "You can't undo this."}
                        UiAlertRow{
                            UiButton{width: Fill reset_hover_on_click: true text: "Delete" draw_text +: {color: ui_danger color_hover: ui_danger color_down: ui_danger color_focus: ui_danger} on_click: || desk_delete_for_good()}
                            UiPrimary{width: Fill key_default: true key_cancel: true reset_hover_on_click: true text: "Cancel" on_click: || desk_sheet("")}
                        }
                    }
                } else {
                    MailPanel{width: if ui_alert_icon { 420 } else { 340 } height: Fit spacing: 6 padding: Inset{left: 20 right: 20 top: 18 bottom: 16}
                        // A Mac alert: the app's icon beside its words.
                        View{width: Fill height: Fit flow: Right spacing: 14
                            if ui_alert_icon { UiAlertIcon{app: "os.mail" width: 52 height: 52} }
                            View{width: Fill height: Fit flow: Down spacing: 6
                                SheetTitle{text: "Delete This Message Permanently?"}
                                SheetNote{text: "You can't undo this."}
                            }
                        }
                        SheetButtons{
                            UiButton{text: "Delete" draw_text +: {color: ui_danger color_hover: ui_danger color_down: ui_danger color_focus: ui_danger} on_click: || desk_delete_for_good()}
                            UiPrimary{key_default: true key_cancel: true text: "Cancel" padding: Inset{left: 18 right: 18} on_click: || desk_sheet("")}
                        }
                    }
                }
            }
        }
        notice_alert := View{visible: false width: Fill height: Fill flow: Overlay
            MailPlace{
                if ui_unified {
                    UiAlertPanel{
                        if ui_alert_icon { UiAlertIcon{app: "os.mail" width: 64 height: 64} }
                        notice_title := UiAlertTitle{}
                        notice_note := UiAlertNote{}
                        UiAlertRow{
                            UiPrimary{width: Fill key_default: true key_cancel: true reset_hover_on_click: true text: "OK" on_click: || desk_sheet(notice_back)}
                        }
                    }
                } else {
                    MailPanel{width: if ui_alert_icon { 420 } else { 340 } height: Fit spacing: 6 padding: Inset{left: 20 right: 20 top: 18 bottom: 16}
                        View{width: Fill height: Fit flow: Right spacing: 14
                            if ui_alert_icon { UiAlertIcon{app: "os.mail" width: 52 height: 52} }
                            View{width: Fill height: Fit flow: Down spacing: 6
                                notice_title := SheetTitle{}
                                notice_note := SheetNote{}
                            }
                        }
                        SheetButtons{
                            UiPrimary{key_default: true key_cancel: true text: "OK" padding: Inset{left: 24 right: 24} on_click: || desk_sheet(notice_back)}
                        }
                    }
                }
            }
        }
        remove_alert := View{visible: false width: Fill height: Fill flow: Overlay
            MailPlace{
                // "Remove Account" is wider than half an alert, so the two buttons stand one
                // over the other, the default (Cancel) on top, as AppKit stacks them.
                if ui_unified {
                    UiAlertPanel{
                        if ui_alert_icon { UiAlertIcon{app: "os.mail" width: 64 height: 64} }
                        remove_title := UiAlertTitle{}
                        remove_note := UiAlertNote{}
                        UiAlertStack{
                            UiPrimary{width: Fill key_default: true key_cancel: true reset_hover_on_click: true text: "Cancel" on_click: || desk_sheet("account")}
                            UiButton{width: Fill reset_hover_on_click: true text: "Remove Account" draw_text +: {color: ui_danger color_hover: ui_danger color_down: ui_danger color_focus: ui_danger} on_click: || remove_account()}
                        }
                    }
                } else {
                    MailPanel{width: if ui_alert_icon { 450 } else { 380 } height: Fit spacing: 6 padding: Inset{left: 20 right: 20 top: 18 bottom: 16}
                        View{width: Fill height: Fit flow: Right spacing: 14
                            if ui_alert_icon { UiAlertIcon{app: "os.mail" width: 52 height: 52} }
                            View{width: Fill height: Fit flow: Down spacing: 6
                                remove_title := SheetTitle{}
                                remove_note := SheetNote{}
                            }
                        }
                        SheetButtons{
                            UiButton{text: "Remove Account" draw_text +: {color: ui_danger color_hover: ui_danger color_down: ui_danger color_focus: ui_danger} on_click: || remove_account()}
                            UiPrimary{key_default: true key_cancel: true text: "Cancel" padding: Inset{left: 18 right: 18} on_click: || desk_sheet("account")}
                        }
                    }
                }
            }
        }
    }
}

if ui_desk { DeskRoot{} } else { TouchRoot{} }
