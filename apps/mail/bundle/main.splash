// The Mac's Mail: mailboxes, the message list, the message, a sheet to write in.
// A phone keeps its stacked pages above.
let mail_icons = {}
fn mail_icon(name){
    if !ui_desk { return nil }
    let handle = mail_icons[name]
    if handle == nil {
        handle = http_resource("{{assets}}/icons/mail-" + name + ".svg")
        mail_icons[name] = handle
    }
    handle
}
fn folder_icon(f){
    let role = "" + f.role + " " + f.name
    if regex("inbox", "i").test(role) { return "tray" }
    if regex("sent", "i").test(role) { return "send" }
    if regex("draft", "i").test(role) { return "doc" }
    if regex("junk|spam", "i").test(role) { return "junk" }
    if regex("trash|bin|deleted", "i").test(role) { return "trash" }
    if regex("archive|all", "i").test(role) { return "archive" }
    if regex("flag|star", "i").test(role) { return "star" }
    "folder"
}
