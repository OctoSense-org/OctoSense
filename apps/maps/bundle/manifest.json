{
  "schema": 1,
  "id": "os.maps",
  "version": "1.0.0",
  "name": "Maps",
  "integrity": {
    "bundle_blake3": ""
  },
  "capabilities": [
    "storage",
    "net",
    "location",
    "web",
    "glance"
  ],
  "requires": [
    "host-api-v1"
  ],
  "network": {
    "hosts": [
      "photon.komoot.io",
      "router.project-osrm.org",
      "overpass-api.de",
      "overpass.kumi.systems",
      "overpass.openstreetmap.fr",
      "makepad.nl"
    ]
  },
  "agent": {
    "profile": "read-only",
    "tools": [
      "ask_user_question"
    ],
    "model": {
      "needs": [
        "tool_calling"
      ]
    }
  },
  "window": {
    "width": 1120,
    "height": 740
  },
  "schema_minor": 1
}
