let service_fetching = false
// A run where a source failed (the network not up yet, say) is tried again
// on its own: after 15 s, then 30 s, 1 min … at most every 15 min.
let retry_delay = 15
let retry_armed = false
// The touch reader can show either the story or its discussion. Retry the
// page the person was actually viewing, not always the original story.
let touch_url = ""
let months = ["January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December"]
let days = ["Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"]
let specials = ["\\" "." "*" "+" "?" "(" ")" "[" "]" "{" "}" "|" "^" "$"]
// What the Mac's window adds: how wide it is, the sidebar, what has been read, and
// the state of the page beside the list. A phone never touches these.
let short_months = ["Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec"]
let desk_width = 0
let desk_height = 0
let desk_side = true
