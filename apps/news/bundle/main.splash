// BEGIN shared app interface
// Shared system-app interface. Run tools/sync-app-interface.py after editing.
// Bundles carry this prelude so they work in the contained standalone host too.
// Resolve the current theme after a host restyle, not a retained prelude alias.
let theme = mod.theme
let ui_ink = theme.color_text
let ui_page = theme.color_bg_app
let ui_light = dot(ui_ink, #x36b61200) < 0.5
let ui_surface = if ui_light { #xffffff } else { mix(ui_page, ui_ink, 0.06) }
let ui_field = mix(ui_page, ui_ink, 0.075)
let ui_hover = mix(ui_page, ui_ink, 0.12)
let ui_border = mix(ui_page, ui_ink, 0.22)
let ui_muted = mix(ui_ink, ui_page, 0.24)
let ui_link = mix(ui_ink, #x356bce, 0.25)
let ui_primary = #x285cd6
let ui_success = mix(ui_ink, #x28a55b, 0.20)
let ui_danger = mix(ui_ink, #xe13b53, 0.20)
let UiButton = ButtonFlat{height: 44 margin: 0 padding: Inset{left: 14 right: 14}
    draw_bg +: {border_radius: 12.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_field color_focus: ui_hover}
    draw_text +: {color: ui_link color_hover: ui_link color_down: ui_link color_focus: ui_link text_style: theme.font_bold{font_size: 14}}
}
let UiPrimary = UiButton{
    draw_bg +: {color: ui_primary color_hover: #x3468df color_down: #x204cb8 color_focus: #x204cb8}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}
}
let UiPill = UiButton{draw_bg +: {color: ui_surface border_radius: 22.0} draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink}}
let UiField = TextInput{width: Fill height: 48 margin: 0 padding: Inset{left: 14 right: 14 top: 12 bottom: 12}
    draw_bg +: {color: ui_field color_hover: ui_field color_focus: ui_field color_empty: ui_field
        border_color: ui_border border_color_hover: ui_link border_color_focus: ui_link border_color_empty: ui_border border_radius: 12.0}
    draw_text +: {color: ui_ink color_hover: ui_ink color_focus: ui_ink color_empty: ui_muted color_empty_hover: ui_muted color_empty_focus: ui_muted text_style: theme.font_regular{font_size: 15}}
    draw_selection.color: #x557dcc55
}
let UiCard = RoundedView{width: Fill height: Fit flow: Down spacing: 12 padding: 20
    show_bg: true draw_bg +: {color: ui_surface border_radius: 16.0}}
let UiCaption = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 13 line_spacing: 1.4}}}
let UiTitle = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 28 line_spacing: 1.2}}}
// END shared app interface
let sources = [
    {id: "hn" label: "Hacker News" kind: "hn" url: "https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=30"}
    {id: "techmeme" label: "TechMeme" kind: "digest" url: "https://www.techmeme.com/feed.xml"}
    {id: "google" label: "Google News" kind: "google" url: "https://news.google.com/rss?hl=en-US&gl=US&ceid=US:en"}
]
let tabs = [
    {id: "today" label: "Today"}
    {id: "saved" label: "Saved"}
    {id: "hn" label: "HN"}
    {id: "techmeme" label: "TechMeme"}
    {id: "google" label: "Google"}
]
let rows_by = {hn: [] techmeme: [] google: []}
let failed_by = {hn: false techmeme: false google: false}
let saved = []
let tab = "today"
let query = ""
let busy = false
let updated = 0
let reading = nil
// Where stories come from: the host's `news` service when this shell offers
// it (it fetches on a timer and keeps the stories, so News opens from its
// cache), else this script's own fetch, as in shells without the service.
// TODO(App-Hub#18): the shells register the service, but manifest.json does
// not request `news` yet: App Hub's pinned admission does not know the
// capability. Add it once App Hub is repinned past OctoSense-App-Hub#18.
let use_service = false
let service_waiting = 0
let service_relist = false
let service_follow_until = 0
let service_fetching = false
// A run where a source failed (the network not up yet, say) is tried again
// on its own: after 15 s, then 30 s, 1 min … at most every 15 min.
let retry_delay = 15
let retry_armed = false
let months = ["January" "February" "March" "April" "May" "June" "July" "August" "September" "October" "November" "December"]
let days = ["Sunday" "Monday" "Tuesday" "Wednesday" "Thursday" "Friday" "Saturday"]
let specials = ["\\" "." "*" "+" "?" "(" ")" "[" "]" "{" "}" "|" "^" "$"]

// ADR 0004 §11: the app's data is its account folder (a system app acts for
// the device), the folder its agent works in; what it can fetch again is
// cache/. A file an earlier build kept at the top of the jail moves on first
// use: the old one is removed only once the copy reads back the same; if the
// copy fails the app keeps using the old file and tries again next time.
let DATA = "accounts/device/"
fn moved(name, path){
    if fs.exists(path) || !fs.exists(name) { return path }
    let data = fs.read(name)
    fs.write(path, data)
    if fs.exists(path) && fs.read(path) == data {
        fs.remove(name)
        return path
    }
    if fs.exists(path) { fs.remove(path) }
    return name
}
fn data_path(name){ return moved(name, DATA + name) }
fn cache_path(name){ return moved(name, "cache/" + name) }

fn fetch(url){
    let p = promise()
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "OctoSense-News/1.0"}}) do net.HttpEvents{
        on_response: |res| p.resolve(res)
        on_error: |_err| p.resolve(nil)
    }
    p
}

// Hacker News through Algolia: one page with points, comments and times.
fn hn_rows(body){
    let out = []
    let data = body.parse_json()
    if data == nil || data.hits == nil { return out }
    for hit in data.hits {
        if hit.title == nil || hit.title == "" { continue }
        let discussion = "https://news.ycombinator.com/item?id=" + hit.objectID
        let link = discussion
        if hit.url != nil && hit.url != "" { link = hit.url }
        let published = 0
        if hit.created_at_i != nil { published = hit.created_at_i }
        out.push({title: hit.title link: link source: "Hacker News" published: published summary: ""
            image: "" discussion: discussion points: hit.points comments: hit.num_comments})
    }
    out
}

// RSS or Atom, in the same row shape as Hacker News's.
fn feed_rows(body, s){
    let items = body.parse_feed(s.kind)
    if items == nil { return nil }
    let out = []
    for it in items {
        let source = it.source
        if source == "" { source = s.label }
        out.push({title: it.title link: it.link source: source published: it.published summary: it.summary
            image: it.image discussion: "" points: nil comments: nil})
    }
    out
}

fn load_source(s){
    let res = fetch(s.url).await()
    if res == nil || res.status_code >= 400 || res.body == nil {
        failed_by[s.id] = true
        return
    }
    let body = res.body.to_string()
    let rows = nil
    if s.kind == "hn" { rows = hn_rows(body) } else { rows = feed_rows(body, s) }
    if rows == nil || rows.len() == 0 {
        failed_by[s.id] = true
        return
    }
    rows_by[s.id] = rows
    failed_by[s.id] = false
    fs.write(cache_path("cache_" + s.id + ".json"), rows.to_json())
}

// The wait before the next retry after `delay`: twice as long, at most
// 15 minutes.
fn next_retry_delay(delay){
    let next = delay * 2
    if next > 900 { next = 900 }
    next
}

fn any_failed(){
    for s in sources { if failed_by[s.id] { return true } }
    false
}

// After a run: a failed source is fetched again later, sooner at first.
fn schedule_retry(){
    if !any_failed() {
        retry_delay = 15
        return
    }
    if retry_armed { return }
    retry_armed = true
    let wait = retry_delay
    retry_delay = next_retry_delay(retry_delay)
    start_timeout(wait, || {
        retry_armed = false
        refresh_due()
    })
}

// The person's Refresh (and News opening): the service fetches a failed
// source again at once.
fn refresh(){ refresh_with(false) }

// A timer's run (the retry, the 15-minute interval): only what is due, so a
// failing or rate-limited source keeps its back-off.
fn refresh_due(){ refresh_with(true) }

fn refresh_with(due){
    if busy { return }
    if use_service { refresh_service(due); return }
    busy = true
    sync_status()
    for s in sources {
        load_source(s)
    }
    ui.list.render()
    busy = false
    updated = time_now()
    sync_status()
    ui.tile_list.render()
    schedule_retry()
}

// A story as the news service keeps it, in this script's row shape. The
// service leaves out the fields a story does not have (`image`,
// `discussion`, `points`, `comments`), and reading a missing field is an
// error here, not nil: `optional` reads one that may be missing.
fn optional(it, key, fallback){
    let value = try { it[key] } catch { nil }
    if value == nil { return fallback }
    value
}

fn service_row(it){
    let row = {title: it.title link: it.url source: it.source published: it.published summary: it.summary
        image: optional(it, "image", "") discussion: optional(it, "discussion", "")
        points: optional(it, "points", nil) comments: optional(it, "comments", nil)}
    row
}

// Each tab shows exactly its source's latest fetch, in the source's order.
fn list_service(){
    service_waiting = sources.len()
    for s in sources {
        host.request("news.list", {feed: s.id current: true limit: 30}, fn(r){
            if r.is_ok {
                let rows = []
                for it in r.data.items { rows.push(service_row(it)) }
                if rows.len() > 0 {
                    rows_by[s.id] = rows
                    fs.write(cache_path("cache_" + s.id + ".json"), rows.to_json())
                }
                failed_by[s.id] = r.data.feed_error != nil
                if r.data.updated > updated { updated = r.data.updated }
            } else {
                // Granted but not answered (no service registered): fetch here.
                use_service = false
            }
            service_waiting = service_waiting - 1
            if service_waiting == 0 { listed_service() }
        })
    }
}

fn listed_service(){
    busy = false
    if !use_service {
        refresh()
        return
    }
    ui.list.render()
    sync_status()
    ui.tile_list.render()
    schedule_retry()
    if service_relist {
        service_relist = false
        busy = true
        list_service()
    }
}

// Show what the service has now, ask it to fetch what is due, then show that.
fn refresh_service(due){
    busy = true
    sync_status()
    list_service()
    if !due { service_follow_until = time_now() + 60 }
    host.request("news.refresh", {due: due}, fn(r){
        if !use_service { return }
        // The host can already be fetching at app startup. Its busy reply is
        // not completion; follow it with due-only requests until it finishes.
        // These respect source intervals and never force another network run.
        service_fetching = r.is_ok && optional(r.data, "busy", false) && time_now() < service_follow_until
        if busy { service_relist = true }
        else {
            busy = true
            list_service()
        }
    })
}

fn load_state(){
    if fs.exists(data_path("saved.json")) {
        let v = fs.read(data_path("saved.json")).parse_json()
        if v != nil { saved = v }
    }
    for s in sources {
        let name = "cache_" + s.id + ".json"
        if fs.exists(cache_path(name)) {
            let v = fs.read(cache_path(name)).parse_json()
            if v != nil { rows_by[s.id] = v }
        }
    }
}

// All: the first row of each source, then the second, and so on, so every
// source keeps its own ranking and none floods the list.
fn today_rows(){
    let out = []
    for i in 30 {
        for s in sources {
            let rows = rows_by[s.id]
            if i < rows.len() { out.push(rows[i]) }
        }
    }
    out
}

fn escape(text){
    let out = text
    for c in specials { out = out.replace(c, "\\" + c) }
    out
}

fn visible_rows(){
    let rows = []
    if tab == "today" { rows = today_rows() }
    else if tab == "saved" { rows = saved }
    else { rows = rows_by[tab] }
    if query == "" { return rows }
    let re = regex(escape(query), "i")
    let out = []
    for r in rows {
        if re.test(r.title) || re.test(r.summary) || re.test(r.source) { out.push(r) }
    }
    out
}

fn ago(secs){
    if secs == nil || secs <= 0 { return "" }
    let d = time_now() - secs
    if d < 60 { return "now" }
    if d < 3600 { return "" + floor(d / 60) + "m" }
    if d < 86400 { return "" + floor(d / 3600) + "h" }
    "" + floor(d / 86400) + "d"
}

fn meta(r){
    let line = r.source
    let a = ago(r.published)
    if a != "" { line = line + "  ·  " + a }
    if r.points != nil { line = line + "  ·  " + r.points + " points" }
    if r.comments != nil { line = line + "  ·  " + r.comments + " comments" }
    line
}

fn date_line(){
    let t = local_time()
    days[t.weekday] + ", " + months[t.month - 1] + " " + t.day
}

fn sync_status(){
    let text = ""
    if busy || service_fetching { text = "Updating…" }
    else if tab != "today" && tab != "saved" && failed_by[tab] && rows_by[tab].len() == 0 {
        text = "Couldn't load this source. Tap Refresh to try again."
    }
    else if updated > 0 { text = "Updated " + ago(updated) + " ago" }
    if text == "Updated now ago" { text = "Updated just now" }
    ui.status.set_text(text)
}

fn pick(id){
    tab = id
    ui.tabbar.render()
    ui.list.render()
    sync_status()
}

fn set_query(text){
    query = ("" + text).trim()
    ui.list.render()
}

fn is_saved(link){
    for s in saved { if s.link == link { return true } }
    false
}

fn toggle_save(r){
    if is_saved(r.link) { saved.retain(|s| s.link != r.link) } else { saved.push(r) }
    fs.write(data_path("saved.json"), saved.to_json())
    sync_reader_bar()
    if tab == "saved" { ui.list.render() }
}

fn sync_reader_bar(){
    if reading == nil { return }
    if is_saved(reading.link) { ui.save.set_text("Saved") } else { ui.save.set_text("Save") }
}

fn open_story(r){
    reading = r
    ui.reader_title.set_text(r.source)
    ui.reader_fail.set_text("")
    sync_reader_bar()
    ui.comments.set_visible(r.discussion != "" && r.discussion != r.link)
    ui.reader_pane.set_visible(true)
    ui.main.set_visible(false)
    ui.reader.open(r.link)
}

fn open_comments(){
    if reading != nil && reading.discussion != "" { ui.reader.open(reading.discussion) }
}

fn close_story(){
    ui.reader.close()
    ui.main.set_visible(true)
    ui.reader_pane.set_visible(false)
    reading = nil
}

fn empty_text(){
    if busy || service_fetching { return "Loading your headlines…" }
    if query != "" { return "No stories match your search." }
    if tab == "saved" { return "Long-press a story, or tap Save while reading, to keep it here." }
    "No stories yet."
}

fn boot(){
    ui.date.set_text(date_line())
    load_state()
    ui.tabbar.render()
    ui.list.render()
    ui.tile_list.render()
    use_service = host.has("news")
    refresh()
}
start_timeout(0.05, || boot())
start_interval(900, || refresh_due())
start_interval(2, || {
    if use_service && service_fetching && !busy { refresh_due() }
})

let ink = ui_ink
let secondary = ui_muted
let accent = ui_link
let ground = ui_page

// The source tabs sit on the page, which shows the host's light or dark
// background: their text, and the open tab's pill, follow the theme.
let TabButton = UiPill{}
let TabButtonActive = TabButton{
    draw_bg +: {color: theme.color_text color_hover: theme.color_text color_down: theme.color_text}
    draw_text +: {color: theme.color_bg_app color_hover: theme.color_bg_app color_down: theme.color_bg_app}
}
let BarButton = UiButton{}

let StoryHead = View{width: Fill height: Fit flow: Down spacing: 7
    meta := Label{width: Fill text: "" max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 13}
    title := Label{width: Fill text: "" max_lines: 3 text_overflow: Ellipsis draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16 line_spacing: 1.2}}
}
let StoryText = StoryHead{
    summary := Label{width: Fill text: "" max_lines: 2 draw_text.color: ui_muted draw_text.text_style.font_size: 13}
}
let StoryCard = RoundedView{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.0}
    padding: Inset{top: 18 bottom: 18 left: 18 right: 18}
    new_batch: true show_bg: true draw_bg.color: ui_surface draw_bg.border_radius: 16.0
}
let CardText = StoryCard{text := StoryText{}}
let CardHead = StoryCard{text := StoryHead{}}
let CardTextImage = StoryCard{text := StoryText{} thumb := Image{width: 76 height: 76 fit: ImageFit.CropToFill}}
let CardHeadImage = StoryCard{text := StoryHead{} thumb := Image{width: 76 height: 76 fit: ImageFit.CropToFill}}

HostedView{width: Fill height: Fill
    full: View{width: Fill height: Fill flow: Overlay align: Align{x: 0.5} show_bg: true draw_bg.color: ground
        main := View{width: Fill max_width: 960 height: Fill flow: Down
            View{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 18 right: 12 top: 14 bottom: 6}
                View{width: Fill height: Fit flow: Down spacing: 2
                    date := Label{text: "" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 13}}
                    Label{text: "News" draw_text.color: theme.color_text draw_text.text_style: theme.font_bold{font_size: 32}}
                }
                BarButton{text: "Refresh" on_click: || refresh()}
            }
            View{width: Fill height: Fit padding: Inset{left: 16 right: 16 bottom: 8}
                search := UiField{width: Fill height: 48 empty_text: "Search stories"
                    on_change: |text| set_query(text)
                    draw_bg +: {color: ui_field color_hover: ui_field color_focus: ui_field color_empty: ui_field
                        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000
                        border_radius: 10.0}
                    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
                }
            }
            tabbar := ScrollXView{width: Fill height: 60 flow: Right spacing: 4 padding: Inset{left: 12 right: 12 top: 4 bottom: 8}
                on_render: || {
                    for t in tabs {
                        if t.id == tab { TabButtonActive{text: t.label on_click: || pick(t.id)} }
                        else { TabButton{text: t.label on_click: || pick(t.id)} }
                    }
                }
            }
            status := Label{width: Fill padding: Inset{left: 18 right: 18 bottom: 6} text: "Loading your headlines…" draw_text.color: secondary draw_text.text_style.font_size: 13}
            list := ScrollYView{width: Fill height: Fill flow: Down spacing: 12 padding: Inset{left: 16 right: 16 bottom: 28}
                on_render: || {
                    let rows = visible_rows()
                    if rows.len() == 0 {
                        View{width: Fill height: 200 align: Align{x: 0.5 y: 0.5}
                            Label{width: Fill text: empty_text() draw_text.color: secondary draw_text.text_style.font_size: 13}
                        };
                    }
                    else for r in rows {
                        GestureView{width: Fill height: Fit
                            on_tap: |x, y| open_story(r)
                            on_long_press: |x, y| toggle_save(r)
                            if r.image != "" && r.summary != "" {
                                CardTextImage{text.meta.text: meta(r) text.title.text: r.title text.summary.text: r.summary thumb.src: http_resource(r.image)}
                            } else if r.image != "" {
                                CardHeadImage{text.meta.text: meta(r) text.title.text: r.title thumb.src: http_resource(r.image)}
                            } else if r.summary != "" {
                                CardText{text.meta.text: meta(r) text.title.text: r.title text.summary.text: r.summary}
                            } else {
                                CardHead{text.meta.text: meta(r) text.title.text: r.title}
                            }
                        }
                    }
                }
            }
        }
        reader_pane := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true show_bg: true draw_bg.color: ui_surface
            View{width: Fill height: 52 flow: Right align: Align{y: 0.5} padding: Inset{left: 4 right: 8} spacing: 4
                BarButton{text: "‹ News" on_click: || close_story()}
                View{width: Fill height: 1}
                reader_title := Label{visible: false width: Fill text: "" max_lines: 1 align: Align{x: 0.5}
                    draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                comments := BarButton{text: "Comments" on_click: || open_comments()}
                save := BarButton{text: "Save" on_click: || { if reading != nil { toggle_save(reading) } }}
            }
            reader_fail := Label{width: Fill padding: Inset{left: 18 right: 18} text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
            reader := WebReader{width: Fill height: Fill on_error: || ui.reader_fail.set_text(ui.reader.error())}
        }
    }
    tile: View{width: Fill height: Fill flow: Down padding: Inset{left: 14 right: 14 top: 12 bottom: 12} spacing: 8
        new_batch: true show_bg: true draw_bg.color: ui_surface
        Label{text: "News" draw_text.color: accent draw_text.text_style: theme.font_bold{font_size: 13}}
        tile_list := View{width: Fill height: Fill flow: Down spacing: 8 on_render: || {
            let rows = today_rows()
            if rows.len() == 0 { Label{text: "Headlines appear here." draw_text.color: secondary draw_text.text_style.font_size: 13} }
            else for i r in rows {
                if i < 3 {
                    View{width: Fill height: Fit flow: Down spacing: 1
                        Label{width: Fill text: r.source max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 13}
                        Label{width: Fill text: r.title max_lines: 2 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                }
            }
        }}
    }
}
