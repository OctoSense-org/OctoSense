{
  "schema": 1,
  "tools": [
    {
      "name": "news.list",
      "description": "List the stories the device collected from News's feeds and followed topics, newest first. Filter by topic, language, feed or time; page with limit and offset.",
      "input_schema": {
        "type": "object",
        "properties": {
          "since": { "type": "integer", "description": "Only stories fetched at or after this Unix time." },
          "topic": { "type": "string", "maxLength": 200 },
          "lang": { "type": "string", "maxLength": 16 },
          "feed": { "type": "string", "maxLength": 200 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "offset": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "total": { "type": "integer" },
          "offset": { "type": "integer" },
          "items": { "type": "array", "items": { "type": "object" } }
        },
        "required": ["total", "items"]
      },
      "risk": "read",
      "shareable": true,
      "implemented_by": "host-service"
    },
    {
      "name": "news.read",
      "description": "Read one collected story by its id: the story and its stored summary.",
      "input_schema": {
        "type": "object",
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "required": ["id"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": { "item": { "type": "object" }, "text": { "type": "string" } },
        "required": ["item"]
      },
      "risk": "read",
      "shareable": true,
      "implemented_by": "host-service"
    },
    {
      "name": "news.notify",
      "description": "Tell the person something now: put a notice card from News on the glance screen and show a notification. Give a short title (at most 80 characters) and the text (at most 600 characters); News draws the card. Use it when the person or the system agent asks News to notify them, or when stories need the person's attention. The same card_id replaces an earlier notice.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "body": { "type": "string", "minLength": 1, "maxLength": 600 },
          "card_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100 }
        },
        "required": ["title", "body"],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": { "card_id": { "type": "string" }, "replaced": { "type": "boolean" }, "expires_at": { "type": "integer" } },
        "required": ["card_id"]
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service"
    }
  ]
}
