// BEGIN shared app interface
// Shared system-app interface. Run tools/sync-app-interface.py after editing.
// Bundles carry this prelude so they work in the contained standalone host too.
// Resolve the current theme after a host restyle, not a retained prelude alias.
let theme = mod.theme
let ui_ink = theme.color_text
let ui_page = theme.color_bg_app
let ui_light = dot(ui_ink, #x36b61200) < 0.5
let ui_surface = if ui_light { #xffffff } else { mix(ui_page, ui_ink, 0.06) }
let ui_field = mix(ui_page, ui_ink, 0.075)
let ui_hover = mix(ui_page, ui_ink, 0.12)
let ui_border = mix(ui_page, ui_ink, 0.22)
let ui_muted = mix(ui_ink, ui_page, 0.24)
let ui_link = mix(ui_ink, #x356bce, 0.25)
let ui_primary = #x285cd6
let ui_success = mix(ui_ink, #x28a55b, 0.20)
let ui_danger = mix(ui_ink, #xe13b53, 0.20)
let UiButton = ButtonFlat{height: 44 margin: 0 padding: Inset{left: 14 right: 14}
    draw_bg +: {border_radius: 12.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_field color_focus: ui_hover}
    draw_text +: {color: ui_link color_hover: ui_link color_down: ui_link color_focus: ui_link text_style: theme.font_bold{font_size: 14}}
}
let UiPrimary = UiButton{
    draw_bg +: {color: ui_primary color_hover: #x3468df color_down: #x204cb8 color_focus: #x204cb8}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}
}
let UiPill = UiButton{draw_bg +: {color: ui_surface border_radius: 22.0} draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink}}
let UiField = TextInput{width: Fill height: 48 margin: 0 padding: Inset{left: 14 right: 14 top: 12 bottom: 12}
    draw_bg +: {color: ui_field color_hover: ui_field color_focus: ui_field color_empty: ui_field
        border_color: ui_border border_color_hover: ui_link border_color_focus: ui_link border_color_empty: ui_border border_radius: 12.0}
    draw_text +: {color: ui_ink color_hover: ui_ink color_focus: ui_ink color_empty: ui_muted color_empty_hover: ui_muted color_empty_focus: ui_muted text_style: theme.font_regular{font_size: 15}}
    draw_selection.color: #x557dcc55
}
let UiCard = RoundedView{width: Fill height: Fit flow: Down spacing: 12 padding: 20
    show_bg: true draw_bg +: {color: ui_surface border_radius: 16.0}}
let UiCaption = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 13 line_spacing: 1.4}}}
let UiTitle = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 28 line_spacing: 1.2}}}
// END shared app interface
// PDF Tools v2: read, find, review, fill and sign, organize, combine and edit
// the PDFs in this app's own storage, on the desktop's pdf engine (pdfcraft,
// ADR 0013). Rebuilt from the approved designs in apps/pdftools/design (BRIEF.md,
// the generated screens in source/, the pixel maps in map/) through OctoSense App
// Flow: every region, size and colour below comes from those maps.
//
// The engine: every call is host.request("pdf.<method>") on the contract in
// apps/pdftools/design/SERVICE.md, and nothing else. A PDF opens once per tab (pdf.open
// gives a handle); renders, finds, comments, fields, page changes and text
// edits name that handle, Undo and Redo use the engine's history, and Save
// writes the PDF back. This script never reads a PDF itself.
//
// Storage (64 MiB, the system ceiling): the PDFs in accounts/device/library/,
// the library index in accounts/device/library.json (title, pages, size, when
// it was last opened, its page and zoom, its cover), and the page renders the
// engine writes in its own cache (.cache/pages/, at most 16 MiB).
//
// Engine work runs on the shell's UI thread until #399 lands, so pages render
// one at a time at screen resolution and are kept, thumbnails fill in one by
// one, and a change re-renders only the pages on show.
//
// The runtime gives script apps no scroll position and no keyboard events.
// So the canvas shows a run of pages starting at the page you went to (a
// thumbnail, the outline, a find result, ‹ and ›), and every shortcut the
// brief lists is a button.

let LIBRARY = "accounts/device/library"
let INDEX = "accounts/device/library.json"
let CACHE = ".cache/pages"
// What an imported PDF is called: the import names its destination first.
let IMPORT_NAME = "Imported PDF"
// The app's storage: App Hub's system ceiling (no storage.max_bytes). The
// status line reads the real numbers from files.status; this is for a host
// that doesn't say.
let QUOTA = 67108864
// What the pdf service allows: 8 open documents, 2 to 16 files per merge,
// 512 pages named in one call.
let MAX_OPEN = 8
let MAX_MERGE = 16
let MAX_NAMED = 512
// Pages in the canvas's run, and how many render ahead of the current one.
let RUN = 8
let AHEAD = 2
// Render pixels per point at 100%: the designs' 100% is one PDF point per
// layout point, drawn at twice that for a high-density screen.
let DENSITY = 2
let THUMB_DPI = 24
let GRID_DPI = 48
let COVER_DPI = 48
// The thumbnails the Pages panel and the Pages grid list at a time.
let THUMB_WINDOW = 40
let ZOOMS = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0]
// The window's regions, in points, as measured on the approved designs
// (design/map/02-reading.json and the others).
let TAB_H = 53
let MODE_H = 54
let RAIL_W = 84
let PANEL_W = 204
let LIST_W = 288
let RIGHT_W = 360
let THREAD_W = 424
let STATUS_H = 44
let PAGE_TOP = 13
let PAGE_GAP = 13
// Comment colours: the four dots of the Comment tool row.
let MARKS = ["yellow", "green", "blue", "pink"]
let MARK_HEX = {yellow: "#ffd84d" green: "#5cb85c" blue: "#2d7ff9" pink: "#f0609e"}
// The Edit panel's text colours (design 08), as pdf.edit_text takes them,
// and its alignments, as it names them (SERVICE.md "Edit").
let TEXT_COLOURS = [{name: "Black" hex: "#000000"}, {name: "Dark grey" hex: "#4b4f54"}, {name: "Blue" hex: "#1a5fb4"}, {name: "Red" hex: "#c01c28"}, {name: "Green" hex: "#26a269"}, {name: "Orange" hex: "#e66100"}]
let ALIGNS = ["left", "center", "right", "justify"]
let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
let MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

// ---- the library's rules: pure functions, tested from Rust by
// crates/shell/src/pdftools_model_tests.rs (everything up to start_timeout) --

// A missing key reads as `fallback` (as News, Photos and Wasm Lab do it).
fn optional(it, key, fallback){
    let value = try { it[key] } catch { nil }
    if value == nil { return fallback }
    value
}
fn pick(c, a, b){ if c { return a } b }
fn plural(n, one, many){ if n == 1 { return "1 " + one } "" + n + " " + many }
fn is_pdf(name){ regex("\\.pdf$", "i").test(name) }
fn stem(name){ name.replace(regex("\\.pdf$", "i"), "") }
fn has(list, x){
    for v in list { if v == x { return true } }
    false
}
fn position(list, x){
    for i v in list { if v == x { return i } }
    -1
}
fn size_text(bytes){
    if bytes == nil { return "" }
    if bytes < 1024 { return plural(bytes, "byte", "bytes") }
    if bytes < 1048576 { return "" + round(bytes / 1024) + " KB" }
    "" + floor(bytes / 104857.6) / 10 + " MB"
}
// "14.6 of 64 MB used": what the app's storage holds, against what it may
// hold. Under 1 MB it counts in kilobytes ("90 KB of 64 MB used").
fn used_text(bytes, quota){
    let quota_part = " of " + round(quota / 1048576) + " MB used"
    if bytes < 1048576 { return size_text(bytes) + quota_part }
    "" + floor(bytes / 104857.6) / 10 + quota_part
}
// What files.status says the app's storage holds and may hold, or nil when
// it doesn't say (no storage, or a shell from before it did).
fn usage_from(data){
    let used = optional(data, "used_bytes", nil)
    let quota = optional(data, "quota_bytes", nil)
    if used == nil || quota == nil || quota <= 0 { return nil }
    {used: used quota: quota}
}

// A library row: the file, and what the index kept about it (`known`, or
// nil): its pages and size, its title (otherwise its name), when it was last
// opened, the page and zoom it was left at, and its cover.
fn doc_from(name, known){
    let d = {name: name path: LIBRARY + "/" + name title: stem(name) pages: nil bytes: nil opened: 0 page: 1 zoom: nil cover: "" error: "" locked: false}
    if known != nil {
        d.pages = optional(known, "pages", nil)
        d.bytes = optional(known, "bytes", nil)
        d.title = optional(known, "title", d.title)
        d.opened = optional(known, "opened", 0)
        d.page = optional(known, "page", 1)
        d.zoom = optional(known, "zoom", nil)
        d.cover = optional(known, "cover", "")
    }
    d
}
// What the index keeps about a file: what the engine said (pages, size), and
// its title when that is not the file's own name.
fn index_entry(pages, bytes, title, name){
    pick(title == stem(name), {pages: pages bytes: bytes}, {pages: pages bytes: bytes title: title})
}
// The title of a PDF opened from the device: the chosen file's name as
// files.import reports it (`shown`), without ".pdf" and unlike every title
// in `taken`, else the name the file is stored under ("Imported PDF 2").
fn title_for_import(shown, name, taken){
    if shown == nil { return stem(name) }
    let t = ("" + shown).trim().replace(regex("\\.pdf$", "i"), "").trim()
    if t == "" { return stem(name) }
    if !has(taken, t) { return t }
    let n = 2
    loop {
        let candidate = t + " (" + n + ")"
        if !has(taken, candidate) { return candidate }
        n = n + 1
    }
}
// The title of a part the engine split from a PDF (`part`, named after the
// file: "Imported PDF-part2.pdf"): after the PDF's title ("Lease
// 2026-part2"), or nil when the PDF shows its file name, as the part then does.
fn title_for_part(title, name, part){
    if title == stem(name) { return nil }
    title + stem(part).replace(stem(name), "")
}
// The pages a range such as "1-4, 9" names in a PDF of `total` pages, in
// its order, or nil when it names no page or one the PDF doesn't have.
// Empty, or "all", is every page.
fn range_pages(text, total){
    let t = ("" + text).trim().replace(regex("[–—]", "g"), "-")
    let out = []
    if t == "" || regex("^all$", "i").test(t) {
        for i in total { out.push(i + 1) }
        return out
    }
    // No return inside the loop: an else-if chain returning from a loop
    // inside a for broke the script VM's stack ("pop_stack_value on empty
    // stack") on this runtime.
    let bad = false
    for part in t.split(",") {
        let p = part.trim()
        if p != "" {
            let ends = p.split("-")
            let a = ends[0].trim().to_f64()
            let b = a
            if ends.len() == 2 { b = ends[1].trim().to_f64() }
            if ends.len() > 2 || !(a >= 1) || !(b >= a) || b > total || floor(a) != a || floor(b) != b { bad = true }
            if !bad { for k in b - a + 1 { out.push(a + k) } }
        }
    }
    if bad || out.len() == 0 { return nil }
    out
}
// A range as the engine takes it: "" (every page) stays "", "1–4" becomes "1-4".
fn range_arg(text){ ("" + text).trim().replace(regex("[–—]", "g"), "-") }
// A find snippet ("… strong [[revenue]] …") as HTML, its match in bold.
fn snippet_html(s){
    let safe = ("" + s).replace(regex("&", "g"), "&amp;").replace(regex("<", "g"), "&lt;").replace(regex(">", "g"), "&gt;")
    safe.replace(regex("\\[\\[", "g"), "<b>").replace(regex("\\]\\]", "g"), "</b>")
}
// Two letters for an avatar: "Jun Park" → "JP" (the first letters of the
// first and last words).
fn first_letter(word){
    let m = regex("^(.)").exec(word)
    if m == nil { return "" }
    m.captures[1]
}
fn initials_of(name){
    let words = []
    for w in ("" + name).trim().split(" ") { if w != "" { words.push(w) } }
    if words.len() == 0 { return "?" }
    if words.len() == 1 { return first_letter(words[0]) }
    first_letter(words[0]) + first_letter(words[words.len() - 1])
}
// When something happened, as the designs say it: "today", "yesterday",
// "3 Oct", or the year for an older date.
fn day_text(t, now_t){
    if t == nil || t <= 0 { return "" }
    let a = local_time(t)
    let b = local_time(now_t)
    if a.year == b.year && a.month == b.month && a.day == b.day { return "today" }
    let y = local_time(now_t - 86400)
    if a.year == y.year && a.month == y.month && a.day == y.day { return "yesterday" }
    if a.year == b.year { return "" + a.day + " " + MONTHS[a.month - 1] }
    "" + a.day + " " + MONTHS[a.month - 1] + " " + a.year
}
fn two(n){ pick(n < 10, "0" + n, "" + n) }
// A comment's date as the service reports it, this device's local time
// ("2026-10-10T10:12"; SERVICE.md "Comments": it reads the date the file
// writes and converts it from its zone), as its parts, or nil when the file
// wrote something else (shown as it is). A PDF date the service passed on
// ("D:20261010101200") reads the same way.
fn comment_time(date){
    let s = "" + date
    let m = regex("^D?:?([0-9][0-9][0-9][0-9])-?([0-9][0-9])-?([0-9][0-9])[T ]?([0-9][0-9])?:?([0-9][0-9])?").exec(s)
    if m == nil { return nil }
    {year: m.captures[1].to_f64() month: m.captures[2].to_f64() day: m.captures[3].to_f64()
        hour: optional(m.captures, 4, "0").to_f64() minute: optional(m.captures, 5, "0").to_f64()}
}
// "Today 10:12", "Yesterday", "3 Oct": a comment's date beside its author.
fn comment_when(date, now_t){
    let c = comment_time(date)
    if c == nil { return "" + date }
    let b = local_time(now_t)
    let y = local_time(now_t - 86400)
    let hm = pick(c.hour >= 0, " " + two(c.hour) + ":" + two(c.minute), "")
    if c.year == b.year && c.month == b.month && c.day == b.day { return "Today" + hm }
    if c.year == y.year && c.month == y.month && c.day == y.day { return "Yesterday" }
    "" + c.day + " " + MONTHS[c.month - 1]
}
// Today, as Fill & Sign's date: "10 October 2026".
fn date_text(t){
    let a = local_time(t)
    "" + a.day + " " + MONTH_NAMES[a.month - 1] + " " + a.year
}

// How far apart the smallest and largest of `values` are.
fn spread(values){
    if values.len() == 0 { return 0 }
    let lo = values[0]
    let hi = values[0]
    for v in values {
        lo = min(lo, v)
        hi = max(hi, v)
    }
    hi - lo
}
// A paragraph's alignment as its lines show it, for the Edit panel's
// Alignment: `boxes` are its lines' [x, y, w, h] from pdf.lines, top to
// bottom. Lines that start together are flush left, or justified when every
// line but the last also ends together (three lines at least: two might
// just happen to); lines centred on one point are centred, and lines that
// end together flush right. The engine reports no alignment and sets an
// edited paragraph flush left unless told otherwise (SERVICE.md "Edit"), so
// an edit sends what this finds unless the person picks another.
fn guess_align(boxes){
    if boxes.len() < 2 { return "left" }
    let lefts = []
    let rights = []
    let centres = []
    for b in boxes {
        lefts.push(b[0])
        rights.push(b[0] + b[2])
        centres.push(b[0] + b[2] / 2)
    }
    if spread(lefts) <= 1.5 {
        let full = []
        for i r in rights { if i < rights.len() - 1 { full.push(r) } }
        if boxes.len() >= 3 && spread(full) <= 1.5 { return "justify" }
        return "left"
    }
    if spread(centres) <= 1.5 { return "center" }
    if spread(rights) <= 1.5 { return "right" }
    "left"
}
// pdf.edit_text's arguments for the paragraph edit `e`: its text and its
// alignment always (the engine sets a paragraph flush left when none is
// named), its colour only when the person chose one.
fn edit_args(doc, e){
    let args = {doc: doc page: e.page paragraph: e.n text: e.draft align: e.align}
    if e.color != nil { args.color = e.color }
    args
}
// Whether the edit `e` changes anything: its text, alignment or colour.
fn edit_changes(e){ e.draft != e.text || e.align != e.align0 || e.color != nil }
// A text colour's name in the Edit panel: "Its own colour" until one is chosen.
fn colour_name(hex){
    if hex == nil { return "Its own colour" }
    for c in TEXT_COLOURS { if c.hex == hex { return c.name } }
    hex
}

start_timeout(0.05, || boot())

// ---- appearance -----------------------------------------------------------
// The shared interface above decides light or dark (`ui_light`, from the
// theme the shell sets; a switch runs this file again). The values are the
// designs': light from the light screens, dark from 09-dark-reading, as
// design/map/ records them. Pages stay white in both.
let assets = "{{assets}}"
let pt_accent = if ui_light { #x116cdc } else { #x2f75d8 }
let pt_accent_hover = if ui_light { #x2a7de6 } else { #x3d82e0 }
let pt_accent_down = if ui_light { #x0c5bbd } else { #x2565c2 }
let pt_link = if ui_light { #x1c6ce0 } else { #x4d91e3 }
let pt_tabs = if ui_light { #xf4f4f5 } else { #x191e21 }
let pt_tab_on = if ui_light { #xffffff } else { #x232a2e }
let pt_bar = if ui_light { #xffffff } else { #x232a2e }
let pt_rail = if ui_light { #xffffff } else { #x1e252a }
let pt_panel = if ui_light { #xffffff } else { #x192025 }
let pt_head = if ui_light { #xffffff } else { #x1f262b }
let pt_desk = if ui_light { #xeceded } else { #x191f24 }
let pt_status = if ui_light { #xffffff } else { #x1b2226 }
let pt_pill = if ui_light { #xffffff } else { #x282d32 }
let pt_card = if ui_light { #xffffff } else { #x232a2e }
let pt_card_top = if ui_light { #xf7f8f9 } else { #x1e252a }
let pt_home = if ui_light { #xf7f8f9 } else { #x191f24 }
let pt_line = if ui_light { #xe1e2e3 } else { #x383d41 }
let pt_line_soft = if ui_light { #xececee } else { #x2c3236 }
let pt_thumb_line = if ui_light { #xd3d5d9 } else { #x464b50 }
let pt_tint = if ui_light { #xe9f2fe } else { #x275294 }
let pt_tint_line = if ui_light { #xcfe0fa } else { #x34619f }
let pt_tint_ink = if ui_light { #x2f6fd0 } else { #xbac7dd }
let pt_select = if ui_light { #xeff5fc } else { #x22344d }
let pt_field = if ui_light { #xffffff } else { #x1e2429 }
let pt_field_line = if ui_light { #xdcdcde } else { #x3c4043 }
let pt_hover = if ui_light { #xf1f2f3 } else { #x2b3237 }
let pt_ink = if ui_light { #x37393c } else { #xd5d7d8 }
let pt_ink2 = if ui_light { #x55575b } else { #xb0b2b4 }
let pt_muted = if ui_light { #x76787c } else { #x9a9da0 }
let pt_faint = if ui_light { #x9c9da0 } else { #x7d8184 }
let pt_icon = if ui_light { #x5b5d61 } else { #xa9acae }
let pt_green = if ui_light { #x49b039 } else { #x38a540 }
let pt_green_tint = if ui_light { #xeffbf4 } else { #x1f3326 }
let pt_orange = if ui_light { #xf2a20d } else { #xe39a1c }
let pt_red = if ui_light { #xe5534f } else { #xf06a66 }
let pt_red_tint = if ui_light { #xfef3f2 } else { #x3a2426 }
let pt_shadow = if ui_light { #x00000022 } else { #x00000070 }
let pt_scrim = #x00000059
let pt_hit = #xffd84d6b
let pt_hit_on = #xffa62a8c
let pt_field_box = if ui_light { #x2d7ff914 } else { #x2d7ff922 }

// ---- templates ------------------------------------------------------------

let Text = Label{padding: 0 text: "" draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 12}}}
let TextB = Label{padding: 0 text: "" draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 12}}}
let Small = Label{padding: 0 text: "" draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
let Wrap = Label{padding: 0 width: Fill padding: 0 flow: Flow.Right{wrap: true} text: "" draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 12 line_spacing: 1.45}}}
let Code = Label{padding: 0 width: Fill padding: 0 flow: Flow.Right{wrap: true} text: "" draw_text +: {color: pt_muted text_style: theme.font_code{font_size: 10}}}
// A plain View paints no background in the contained host: lines are SolidViews.
let Line = SolidView{width: Fill height: 1 draw_bg.color: pt_line}
let VLine = SolidView{width: 1 height: Fill draw_bg.color: pt_line}
let Gap = View{width: Fill height: 1}
let Ico = Svg{width: 18 height: 18 animating: false draw_svg +: {color: pt_icon}}
// Buttons: flat text and icon buttons, the primary blue one, the outlined one.
let Flat = ButtonFlat{height: 32 margin: 0 padding: Inset{left: 10 right: 10} spacing: 8
    icon_walk: Walk{width: 18 height: 18}
    draw_bg +: {border_radius: 6.0 border_size: 0.0 color: #x00000000 color_hover: pt_hover color_down: pt_line_soft color_focus: #x00000000}
    draw_text +: {color: pt_ink2 color_hover: pt_ink color_down: pt_ink color_focus: pt_ink2 text_style: theme.font_regular{font_size: 12}}
    draw_icon +: {color: pt_icon}
}
let IconBtn = Flat{width: 34 height: 34 padding: 0 spacing: 0 text: ""}
let Primary = Flat{height: 34 padding: Inset{left: 16 right: 16}
    draw_bg +: {border_radius: 5.0 color: pt_accent color_hover: pt_accent_hover color_down: pt_accent_down color_focus: pt_accent}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}
    draw_icon +: {color: #xffffff}
}
let Outline = Flat{height: 34 padding: Inset{left: 14 right: 14}
    draw_bg +: {border_radius: 5.0 border_size: 1.0 border_color: pt_line color: pt_card color_hover: pt_hover color_down: pt_line_soft color_focus: pt_card}
    draw_text +: {color: pt_ink color_hover: pt_ink color_down: pt_ink color_focus: pt_ink}
}
let LinkBtn = Flat{padding: Inset{left: 6 right: 6} draw_text +: {color: pt_link color_hover: pt_link color_down: pt_link color_focus: pt_link}}
let DangerBtn = Primary{draw_bg +: {color: #xd23a4f color_hover: #xdc4b5f color_down: #xb52d40 color_focus: #xd23a4f}}
let Field = TextInput{width: Fill height: 36 margin: 0 padding: Inset{left: 10 right: 10 top: 8 bottom: 8}
    draw_bg +: {color: pt_field color_hover: pt_field color_focus: pt_field color_empty: pt_field
        border_color: pt_field_line border_color_hover: pt_accent border_color_focus: pt_accent border_color_empty: pt_field_line border_radius: 5.0}
    draw_text +: {color: pt_ink color_hover: pt_ink color_focus: pt_ink color_empty: pt_faint color_empty_hover: pt_faint color_empty_focus: pt_faint text_style: theme.font_regular{font_size: 12}}
    draw_selection.color: #x557dcc55
}
let Card = RoundedView{width: Fill height: Fit flow: Down show_bg: true
    draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 6.0}}
let Dot = RoundedView{width: 10 height: 10 show_bg: true draw_bg +: {color: pt_green border_radius: 5.0}}

// ---- state ----------------------------------------------------------------
// Everything PDF Tools remembers is one object kept on `mod`. A switch
// between light and dark runs this file again to restyle it: the runtime
// keeps the `mod` entries this file made, but every `let` starts over (#440).
let st = try { mod.pdftools } catch { nil }
if st == nil {
    st = {
        booted: false
        screen: "home"        // home | doc
        docs: []              // the library, most recently opened first
        index: {}             // file name -> what library.json keeps
        tabs: []              // the open documents (new_tab)
        cur: -1               // the tab on show; -1 on Home
        engine: ""            // "" until the engine answers; ok | missing | old
        engine_note: ""       // the host's words when it isn't there
        files_known: false    // files.status answered
        files_ok: false       // this device copies a chosen file in
        max_import: 0
        used: -1              // what the app's storage holds (files.status); -1 until it says
        quota: 0              // and what it may hold
        storage_due: false    // a files.status question is on its way
        importing: false
        alert: nil            // {head detail note}: why something failed, on Home
        space_full: false     // the last write found no room
        width: 1536           // the app's size: on_app_resize (card-host sends none)
        height: 1024
        busy: false           // a background render is out
        covers: {}            // file name -> image of its first page
        cover_tried: {}
        blank: false          // the canvas's first half of a jump (go_page)
        jump_n: 0
        confirm: nil          // the tab whose unsaved changes the closing question is about
        note_n: 0
        resize_n: 0
        icons: {}             // icon name -> its handle, made once
        who: {author: "" initials: ""} // who comments and signs (library.json)
        naming: false         // the Comment as field is open
        name_draft: ""
        removing: ""          // the PDF whose removal Home asks about
        busy_at: 0            // when the background render went out
        heartbeat: nil        // the interval below, made once
        index_dirty: false    // library.json waits for the heartbeat
    }
    mod.pdftools = st
}
// The heartbeat (below), started again by every run of this file.
if st.heartbeat != nil { stop_timer(st.heartbeat) }
st.heartbeat = start_interval(2, || heartbeat())

// ---- small helpers that need the state -----------------------------------

fn icon(name){
    let h = optional(st.icons, name, nil)
    if h == nil {
        h = http_resource(assets + "/icons/" + name + ".svg")
        st.icons[name] = h
    }
    h
}
fn cur_tab(){
    if st.screen != "doc" || st.cur < 0 || st.cur >= st.tabs.len() { return nil }
    st.tabs[st.cur]
}
fn tab_named(name){
    for t in st.tabs { if t.name == name { return t } }
    nil
}
fn tab_index(t){
    for i x in st.tabs { if x.name == t.name { return i } }
    -1
}
fn doc_named(name){
    for d in st.docs { if d.name == name { return d } }
    nil
}
fn shown_name(title){ title + ".pdf" }
fn note(text){
    st.note_n = st.note_n + 1
    let n = st.note_n
    ui.banner_text.set_text(text)
    ui.banner.set_visible(text != "")
    if text != "" { start_timeout(8, || { if n == st.note_n { ui.banner.set_visible(false) } }) }
}

// ---- the engine -------------------------------------------------------------

// One call to the pdf engine. `done` gets {is_ok data error}, always on a
// later turn: a refusal answers inside host.request itself, where only the
// first widget call of the callback lands.
fn engine(method, args, done){
    host.request("pdf." + method, args, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || done(answer))
    })
}
fn missing(error){
    let e = "" + error
    e.search("was not granted") >= 0 || e.search("no service answers") >= 0
}
// The engine is there but older than this contract: the shells refuse the
// v2 methods until the service lands.
fn outdated(error){ ("" + error).search("is not a method") >= 0 }
// True when `a` failed because the engine is not there for this app.
fn engine_gone(a){
    if a.is_ok { st.engine = "ok" return false }
    if missing(a.error) {
        st.engine = "missing"
        st.engine_note = "" + a.error
        return true
    }
    false
}
fn outdated_open(a){
    if a.is_ok || !outdated(a.error) { return false }
    st.engine = "old"
    st.engine_note = "" + a.error
    true
}
// An error without the "pdf.open: " the service may put first; then its
// stable code (SERVICE.md: not_found, damaged, protected, storage_full, …)
// and the words for a person after it.
fn err_text(e){ ("" + e).replace(regex("^pdf\\.[a-z_]+: "), "") }
fn err_code(e){
    let m = regex("^([a-z_]+): ").exec(err_text(e))
    if m == nil { return "" }
    m.captures[1]
}
fn err_words(e){
    let s = err_text(e)
    if err_code(e) == "" { return s }
    s.replace(regex("^[a-z_]+: "), "")
}
fn storage_full(e){
    let s = "" + e
    err_code(e) == "storage_full" || s.search("bytes left in this storage") >= 0 || s.search("app storage is full") >= 0 || s.search("too many files") >= 0
}
// Every engine write: a refusal for room shows until a write succeeds or a
// PDF is removed.
fn wrote(a){
    storage_later()
    if a.is_ok { st.space_full = false return }
    if storage_full(a.error) { st.space_full = true }
}
fn engine_headline(){
    if st.engine == "old" { return "This OctoSense's PDF engine is older than PDF Tools" }
    if st.engine_note.search("was not granted") >= 0 { return "PDF Tools can't use the PDF engine" }
    "This device has no PDF engine"
}
fn engine_detail(){
    if st.engine == "old" { return "Reading, search, comments, forms and page changes need the engine's newer methods. Your PDFs stay safe in PDF Tools' storage." }
    if st.engine_note.search("was not granted") >= 0 { return "This OctoSense doesn't let PDF Tools use it. Your PDFs stay safe in PDF Tools' storage." }
    "Pages come from the engine, and PDF Tools needs the OctoSense desktop, which has it. Your PDFs stay safe in this app's storage."
}
// What went wrong with a call a person made, in words, for the banner.
fn action_failed(what, e){
    if missing(e) { return engine_headline() + "." }
    if outdated(e) { return "This OctoSense's PDF engine can't " + what + " yet." }
    if storage_full(e) { return "There isn't room in PDF Tools' storage. Remove a PDF to make room." }
    let code = err_code(e)
    if code == "unknown_doc" { return "This PDF was closed by the engine. Close its tab and open it again." }
    "Couldn't " + what + ": " + err_words(e)
}

// ---- the library ----------------------------------------------------------

fn load_index(){
    if !fs.exists(INDEX) { return }
    let v = try { fs.read(INDEX).parse_json() } catch { nil }
    if v != nil && optional(v, "version", 0) == 1 {
        st.index = optional(v, "docs", {})
        let who = optional(v, "who", nil)
        if who != nil { st.who = {author: optional(who, "author", "") initials: optional(who, "initials", "")} }
    }
}
fn save_index(){
    st.index_dirty = false
    try { fs.write(INDEX, {version: 1 docs: st.index who: st.who}.to_json()) } catch {}
}
fn entry_of(d){
    let e = index_entry(d.pages, d.bytes, d.title, d.name)
    if d.opened > 0 { e.opened = d.opened }
    if d.page > 1 { e.page = d.page }
    if d.zoom != nil { e.zoom = d.zoom }
    if d.cover != "" { e.cover = d.cover }
    e
}
fn remember(d){
    st.index[d.name] = entry_of(d)
    // The heartbeat writes it (at most every 2 s), so a tap or a page turn
    // never waits on the disk: one handler has 64 ms of wall-clock time.
    st.index_dirty = true
}
fn forget(name){
    let kept = {}
    for k v in st.index { if k != name { kept[k] = v } }
    st.index = kept
    save_index()
    let covers = {}
    for k v in st.covers { if k != name { covers[k] = v } }
    st.covers = covers
    let tried = {}
    for k v in st.cover_tried { if k != name { tried[k] = v } }
    st.cover_tried = tried
}
fn scan_library(){
    let found = []
    if fs.exists(LIBRARY) {
        for name in fs.list(LIBRARY) {
            if is_pdf(name) {
                let d = doc_from(name, optional(st.index, name, nil))
                let old = doc_named(name)
                if old != nil {
                    d.error = old.error
                    d.locked = old.locked
                }
                found.push(d)
            }
        }
    }
    // Most recently opened first; the runtime has no sort.
    let out = []
    for d in found {
        let at = out.len()
        for i x in out { if at == out.len() && d.opened > x.opened { at = i } }
        let next = []
        for i x in out {
            if i == at { next.push(d) }
            next.push(x)
        }
        if at == out.len() { next.push(d) }
        out = next
    }
    st.docs = out
}
fn library_bytes(){
    let total = 0
    for d in st.docs { if d.bytes != nil { total = total + d.bytes } }
    total
}
fn unique_name(base){
    if !fs.exists(LIBRARY + "/" + base + ".pdf") { return base }
    let n = 2
    loop {
        if !fs.exists(LIBRARY + "/" + base + " " + n + ".pdf") { return base + " " + n }
        n = n + 1
    }
}
// Removing a PDF from PDF Tools asks once more, on its card. One with
// unsaved changes in a tab stays until that tab is closed.
fn ask_remove(d){
    st.removing = d.name
    render_home()
}
fn remove_doc(d){
    st.removing = ""
    let t = tab_named(d.name)
    if t != nil && t.edited {
        note("Close “" + shown_name(d.title) + "” first: it has changes that aren't saved.")
        render_home()
        return
    }
    let finish = || {
        try { fs.remove(d.path) } catch {}
        if fs.exists(d.path) {
            note("Couldn't remove “" + shown_name(d.title) + "”.")
            render_home()
            return
        }
        // Its cover, kept in the pdf service's cache folder, goes with it.
        if d.cover.search(".cache/covers/") == 0 { try { fs.remove(d.cover) } catch {} }
        forget(d.name)
        storage_later()
        st.space_full = false
        scan_library()
        render_home()
        render_status()
        note("Removed “" + shown_name(d.title) + "” from PDF Tools.")
    }
    if t != nil && t.doc != nil {
        engine("close", {doc: t.doc discard: true}, fn(a){
            let kept = []
            for x in st.tabs { if x.name != t.name { kept.push(x) } }
            st.tabs = kept
            t.state = "closed"
            render_tabs()
            finish()
        })
        return
    }
    finish()
}
fn doc_failed(d, e){
    if err_code(e) == "protected" { d.locked = true return }
    d.error = err_words(e)
}
fn doc_meta(d){
    if d.locked { return "Protected with a password" }
    if d.error != "" { return "Couldn't open this PDF" }
    if d.pages == nil { return pick(st.engine == "missing" || st.engine == "old", "PDF", "Reading…") }
    let line = plural(d.pages, "page", "pages")
    if d.bytes != nil { line = line + "  ·  " + size_text(d.bytes) }
    line
}
// Today and yesterday, once per Home render: local_time is not free, and a
// render has 64 ms for every card.
fn days_now(){
    let now_t = time_now()
    {today: local_time(now_t) yesterday: local_time(now_t - 86400)}
}
fn same_day(a, b){ a.year == b.year && a.month == b.month && a.day == b.day }
fn opened_text(d, days){
    if d.opened == nil || d.opened <= 0 { return "Not opened yet" }
    let a = local_time(d.opened)
    if same_day(a, days.today) { return "Opened today" }
    if same_day(a, days.yesterday) { return "Opened yesterday" }
    if a.year == days.today.year { return "Opened " + a.day + " " + MONTHS[a.month - 1] }
    "Opened " + a.day + " " + MONTHS[a.month - 1] + " " + a.year
}

// Each PDF's cover (its first page) and its pages and size, one engine call
// at a time. A cover is kept in the pdf service's cache across closes and
// runs (pdf.cover), and its path in library.json, so a start with every
// cover kept asks the engine nothing; pages and size come once (pdf.info).
fn needs_cover(d){
    if d.error != "" || d.locked || optional(st.cover_tried, d.name, nil) != nil { return false }
    optional(st.covers, d.name, nil) == nil || d.cover == "" || d.pages == nil || d.bytes == nil
}
fn cover_next(){
    if st.busy || st.engine == "missing" || st.engine == "old" { return false }
    for d in st.docs {
        if needs_cover(d) {
            read_cover(d)
            return true
        }
    }
    false
}
fn read_cover(d){
    st.cover_tried[d.name] = true
    if d.cover != "" && fs.exists(d.cover) {
        let src = try { binary_resource(fs.read_bytes(d.cover)) } catch { nil }
        if src != nil { st.covers[d.name] = src }
    }
    st.busy = true
    st.busy_at = time_now()
    if optional(st.covers, d.name, nil) != nil && d.cover != "" {
        if d.pages != nil && d.bytes != nil {
            cover_done()
            return
        }
        doc_facts(d)
        return
    }
    engine("cover", {path: d.path dpi: COVER_DPI}, fn(a){
        if engine_gone(a) {
            st.busy = false
            render_home()
            return
        }
        wrote(a)
        if !a.is_ok {
            // A damaged or locked PDF says so on its card; a shell without
            // covers, or a full storage, leaves the card without one.
            if !outdated(a.error) && !storage_full(a.error) { doc_failed(d, a.error) }
            cover_done()
            return
        }
        let path = optional(a.data, "path", "")
        let src = try { binary_resource(fs.read_bytes(path)) } catch { nil }
        if src != nil {
            st.covers[d.name] = src
            d.cover = path
        }
        if d.pages == nil || d.bytes == nil {
            doc_facts(d)
            return
        }
        remember(d)
        cover_done()
    })
}
// A PDF's pages and size, read once from the file (the library keeps them).
fn doc_facts(d){
    engine("info", {path: d.path}, fn(i){
        if i.is_ok {
            d.bytes = optional(i.data, "file_size", d.bytes)
            d.pages = optional(i.data, "pages", []).len()
        } else if !outdated(i.error) {
            doc_failed(d, i.error)
        }
        remember(d)
        cover_done()
    })
}
// A saved PDF's cover is out of date: Home asks for its new one, keeping the
// old picture until it comes (the service drops the old file then).
fn stale_cover(d){
    d.cover = ""
    let tried = {}
    for k v in st.cover_tried { if k != d.name { tried[k] = v } }
    st.cover_tried = tried
}
fn cover_done(){
    st.busy = false
    render_home()
    render_status()
    start_timeout(0.02, || pump())
}

// ---- opening a PDF from this device ---------------------------------------

// What the shell's files service offers, asked once without opening anything.
fn check_files(){
    host.request("files.status", {}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data}
        start_timeout(0.01, || {
            st.files_known = true
            if answer.is_ok {
                st.files_ok = optional(answer.data, "import_supported", false) && optional(answer.data, "storage_granted", false)
                st.max_import = optional(answer.data, "max_import_bytes", 0)
                took_usage(answer.data)
            }
            render_home()
        })
    })
}
// The status line's numbers, from files.status: what the app's storage
// holds, this service's renders and covers included, and what it may hold.
fn took_usage(data){
    let u = usage_from(data)
    if u == nil { return }
    st.used = u.used
    st.quota = u.quota
}
// Ask files.status again a moment after a write: one question for a burst of
// writes (a page turn renders several pages).
fn storage_later(){
    if st.storage_due { return }
    st.storage_due = true
    start_timeout(0.8, || {
        host.request("files.status", {}, fn(r){
            let answer = {is_ok: r.is_ok data: r.data}
            start_timeout(0.01, || {
                st.storage_due = false
                if answer.is_ok { took_usage(answer.data) }
                render_status()
            })
        })
    })
}
fn import_limit(){ pick(st.max_import > 0, "Up to " + size_text(st.max_import), "") }
// The host's refusal, said for a person; its own words go below it.
fn import_refusal(error){
    let e = "" + error
    if e.search("foreground_required") >= 0 { return "Bring PDF Tools to the front, then choose the file again." }
    if e.search("busy") >= 0 { return "Another file is still being added. Try again in a moment." }
    if storage_full(e) { return "PDF Tools' storage is full. Remove a PDF to make room, then try again." }
    if e.search("too large") >= 0 || e.search("exceeds the byte limit") >= 0 { return "That file is too big to add. " + import_limit() + " can be added." }
    if e.search("permission_denied") >= 0 { return "OctoSense didn't let PDF Tools open files from this device." }
    if e.search("unsupported_platform") >= 0 { return "This device can't add files to PDF Tools." }
    if e.search("already exists") >= 0 { return "A file of the same name appeared while you chose. Try again." }
    "OctoSense couldn't copy the file in."
}
// The person chooses a file in the host's own dialog; it is copied into a
// new library file the app named first, titled with the chosen file's name,
// and opens in a tab.
fn open_from_device(){
    if st.importing { return }
    if !st.files_ok {
        note("This OctoSense can't open files from the device for PDF Tools.")
        return
    }
    let name = unique_name(IMPORT_NAME) + ".pdf"
    st.importing = true
    st.alert = nil
    render_home()
    host.request("files.import", {path: LIBRARY + "/" + name}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || imported(name, answer))
    })
}
fn imported(name, a){
    st.importing = false
    if !a.is_ok {
        st.alert = {head: "Couldn't open a PDF from this device" detail: import_refusal(a.error) note: "" + a.error}
        if storage_full(a.error) { st.space_full = true }
        show()
        return
    }
    if optional(a.data, "cancelled", false) { render_home() return }
    storage_later()
    forget(name)
    let taken = []
    for d in st.docs { taken.push(d.title) }
    let title = title_for_import(optional(a.data, "name", nil), name, taken)
    st.index[name] = {title: title bytes: optional(a.data, "bytes", nil)}
    save_index()
    scan_library()
    let d = doc_named(name)
    if d == nil { render_home() return }
    open_doc(d)
}

// ---- documents --------------------------------------------------------------

fn new_tab(d){
    {name: d.name path: d.path title: d.title doc: nil state: "opening" error: ""
        pages: 0 sizes: [] outline: [] can_edit: true
        edited: false can_undo: false can_redo: false saving: false
        mode: "read" panel: "pages" panel_kept: "pages" zoom: 1.0 fit: "" zoom_auto: true
        anchor: 1 page: 1
        renders: {} failed: {} thumbs: {} thumb_failed: {} grid: {} grid_failed: {} tile: 1.0
        find: nil finding: false
        comments: nil comments_state: "" thread: nil tool: "highlight" color: "yellow" reply: "" status_menu: false head_menu: false pending: nil
        fields: nil fields_state: "" field: nil field_text: "" field_on: false show_fields: true place: nil place_text: ""
        selected: [] drag: nil inserting: false
        lines: {} edit: nil
        outline_open: {}
        combine: nil}
}
fn open_doc(d){
    let t = tab_named(d.name)
    if t != nil {
        show_tab(tab_index(t))
        return
    }
    if st.tabs.len() >= MAX_OPEN {
        note("PDF Tools keeps up to " + MAX_OPEN + " PDFs open. Close one to open another.")
        return
    }
    t = new_tab(d)
    st.tabs.push(t)
    d.opened = time_now()
    remember(d)
    scan_library()
    show_tab(st.tabs.len() - 1)
    load_tab(t)
}
fn load_tab(t){
    t.state = "opening"
    engine("open", {path: t.path}, fn(a){
        if tab_index(t) < 0 {
            if a.is_ok { engine("close", {doc: a.data.doc discard: true}, fn(c){}) }
            return
        }
        if engine_gone(a) || outdated_open(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        if !a.is_ok {
            let code = err_code(a.error)
            if code == "protected" { t.state = "protected" }
            else if code == "too_many_open" { t.state = "full" }
            else {
                t.state = "damaged"
                t.error = err_words(a.error)
            }
            let d = doc_named(t.name)
            if d != nil && code != "too_many_open" { doc_failed(d, a.error) }
            refresh_doc()
            return
        }
        let v = a.data
        t.doc = v.doc
        t.pages = optional(v, "pages", 0)
        t.sizes = optional(v, "sizes", [])
        t.outline = optional(v, "outline", [])
        t.can_edit = optional(v, "can_edit", true)
        t.state = "ready"
        let d = doc_named(t.name)
        t.page = 1
        t.zoom = start_zoom(t)
        if d != nil {
            d.pages = t.pages
            d.error = ""
            d.locked = false
            t.page = clamp(d.page, 1, max(1, t.pages))
            if d.zoom != nil {
                t.zoom = d.zoom
                t.zoom_auto = false
            }
            remember(d)
        }
        refresh_doc()
        go_page(t, t.page)
    })
}
fn show_tab(i){
    st.screen = "doc"
    st.cur = i
    show()
    pump()
}
fn go_home(){
    st.screen = "home"
    scan_library()
    storage_later()
    show()
    pump()
}
// Closing a tab with unsaved changes asks first (st.confirm).
fn ask_close(t){
    if t.edited {
        st.confirm = t.name
        render_dialog()
        return
    }
    close_tab(t, false)
}
fn close_tab(t, discard){
    st.confirm = nil
    render_dialog()
    let finish = || {
        let i = tab_index(t)
        if i < 0 { return }
        let kept = []
        for x in st.tabs { if x.name != t.name { kept.push(x) } }
        st.tabs = kept
        t.state = "closed"
        if st.tabs.len() == 0 { go_home() return }
        if st.screen == "doc" { show_tab(min(i, st.tabs.len() - 1)) } else { render_tabs() }
    }
    if t.doc == nil { finish() return }
    engine("close", {doc: t.doc discard: discard}, fn(a){
        if !a.is_ok && err_code(a.error) == "unsaved" {
            st.confirm = t.name
            render_dialog()
            return
        }
        finish()
    })
}
fn save_and_close(t){
    st.confirm = nil
    render_dialog()
    save(t, || close_tab(t, false))
}

// ---- the canvas: a run of pages from the page you went to ------------------

fn page_pt(t, p){
    let s = optional(t.sizes, p - 1, nil)
    if s == nil { return [612, 792] }
    [s[0], s[1]]
}
fn page_box(t, p){
    let s = page_pt(t, p)
    [round(s[0] * t.zoom), round(s[1] * t.zoom)]
}
fn run_end(t){ min(t.pages, t.anchor + RUN - 1) }
// The dpi a page renders at for the zoom: screen resolution, within the
// service's 24 to 300 dpi and 16 megapixels.
fn render_dpi(t){
    let s = page_pt(t, t.page)
    let cap = floor(72 * sqrt(16000000 / max(1, s[0] * s[1])))
    clamp(min(round(72 * t.zoom * DENSITY), cap), 24, 300)
}
fn page_src(t, p){
    let r = optional(t.renders, "p" + p, nil)
    if r == nil { return nil }
    r.src
}
fn needs_render(t, p){
    let r = optional(t.renders, "p" + p, nil)
    let dpi = render_dpi(t)
    if optional(t.failed, "p" + p, nil) == dpi { return false }
    r == nil || r.dpi != dpi
}
// Show page `p`: the canvas starts its run there. The runtime gives script
// apps no scroll position, so the run is drawn empty first (the scroll clamps
// to the top on that frame), then filled.
fn go_page(t, p){
    if t.pages < 1 { return }
    let n = clamp(p, 1, t.pages)
    t.page = n
    t.anchor = n
    remember_place(t)
    st.blank = true
    render_canvas()
    render_pill()
    render_panel()
    st.jump_n = st.jump_n + 1
    let g = st.jump_n
    start_timeout(0.12, || {
        if g != st.jump_n { return }
        st.blank = false
        render_canvas()
        pump()
    })
}
fn remember_place(t){
    let d = doc_named(t.name)
    if d == nil { return }
    d.page = t.page
    // A zoom the person chose is kept; the automatic one is worked out again.
    d.zoom = nil
    if !t.zoom_auto { d.zoom = t.zoom }
    remember(d)
}
fn step_page(t, delta){ go_page(t, t.page + delta) }

// ---- zoom -----------------------------------------------------------------

fn left_open(t){ t.panel != "" && t.mode != "pages" && t.mode != "combine" && !(narrow() && right_open(t)) }
fn right_open(t){ t.mode == "comment" || t.mode == "fill" || t.mode == "edit" }
fn panel_w(t){ pick(t.panel == "pages", PANEL_W, LIST_W) }
// In a narrow window (the desktop's default) both right panels take 320,
// so the page keeps its room.
fn right_w(t){ pick(narrow(), 320, pick(t.mode == "comment", THREAD_W, RIGHT_W)) }
// Below this width a right panel takes the left panel's place.
fn narrow(){ st.width < 1180 }
fn canvas_w(){
    let t = cur_tab()
    let w = st.width - RAIL_W - 1
    if t != nil {
        if left_open(t) { w = w - panel_w(t) - 1 }
        if right_open(t) { w = w - right_w(t) - 1 }
    }
    max(240, w)
}
fn canvas_h(){ max(240, st.height - TAB_H - MODE_H - STATUS_H - 2) }
fn fit_width_zoom(t){
    let s = page_pt(t, t.page)
    (canvas_w() - 48) / s[0]
}
fn fit_page_zoom(t){
    let s = page_pt(t, t.page)
    min((canvas_w() - 48) / s[0], (canvas_h() - PAGE_TOP - 80) / s[1])
}
fn start_zoom(t){ clamp(floor(fit_width_zoom(t) * 100) / 100, 0.25, 1.0) }
fn set_zoom(t, z, fit){
    t.zoom = clamp(floor(z * 100 + 0.5) / 100, 0.25, 4.0)
    t.fit = fit
    t.zoom_auto = false
    go_page(t, t.page)
}
// In Pages mode the pill's zoom is the tiles' size.
let TILES = [0.6, 0.8, 1.0, 1.2, 1.4, 1.6]
fn zoom_step(t, dir){
    if t.mode == "pages" {
        let i = position(TILES, t.tile)
        if i < 0 { i = 2 }
        t.tile = TILES[clamp(i + dir, 0, TILES.len() - 1)]
        render_grid()
        render_pill()
        return
    }
    let next = t.zoom
    if dir > 0 {
        let found = false
        for v in ZOOMS { if !found && v > t.zoom + 0.001 { next = v found = true } }
    } else {
        for v in ZOOMS { if v < t.zoom - 0.001 { next = v } }
    }
    set_zoom(t, next, "")
}
fn zoom_text(t){ "" + round(pick(t.mode == "pages", t.tile, t.zoom) * 100) + "%" }
// A new window size keeps a fitted zoom fitted.
fn refit(t){
    if t.fit == "width" { t.zoom = clamp(floor(fit_width_zoom(t) * 100) / 100, 0.25, 4.0) }
    if t.fit == "page" { t.zoom = clamp(floor(fit_page_zoom(t) * 100) / 100, 0.25, 4.0) }
}

// ---- the render pump: one engine render at a time ---------------------------

fn pump(){
    // A render that never answered (its callback lost to a script budget
    // abort under load) frees the pump after 30 s.
    if st.busy && time_now() - st.busy_at > 30 { st.busy = false }
    if st.busy || st.engine == "missing" || st.engine == "old" { return }
    let t = cur_tab()
    if t != nil && t.state == "ready" && t.doc != nil && !st.blank {
        if t.mode == "pages" {
            if grid_next(t) { return }
        } else if t.mode != "combine" {
            if run_next(t, AHEAD + 1) { return }
            if left_open(t) && t.panel == "pages" && thumb_next(t, 8) { return }
            if run_next(t, RUN) { return }
            if left_open(t) && t.panel == "pages" && thumb_next(t, THUMB_WINDOW) { return }
        }
    }
    if st.screen == "home" { cover_next() }
}
fn run_next(t, n){
    for i in n {
        let p = t.anchor + i
        if p <= run_end(t) && needs_render(t, p) {
            render_page(t, p)
            return true
        }
    }
    false
}
fn render_page(t, p){
    let dpi = render_dpi(t)
    st.busy = true
    st.busy_at = time_now()
    engine("page", {doc: t.doc page: p dpi: dpi}, fn(a){
        st.busy = false
        if engine_gone(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        wrote(a)
        if a.is_ok {
            let src = try { binary_resource(fs.read_bytes(optional(a.data, "path", ""))) } catch { nil }
            if src != nil { t.renders["p" + p] = {src: src dpi: dpi} } else { t.failed["p" + p] = dpi }
        } else { t.failed["p" + p] = dpi }
        trim_renders(t)
        if cur_tab() == t && t.edit == nil && !st.blank { render_canvas() }
        if st.space_full { render_status() }
        start_timeout(0.02, || pump())
    })
}
// Keep the run's renders and a page either side; the rest go.
fn trim_renders(t){
    let kept = {}
    let n = 0
    for k v in t.renders {
        let p = k.replace("p", "").to_f64()
        if p >= t.anchor - 1 && p <= run_end(t) + 1 {
            kept[k] = v
            n = n + 1
        }
    }
    t.renders = kept
}
// Everything drawn of a document is stale after a change the engine made.
fn invalidate(t){
    t.renders = {}
    t.failed = {}
    t.thumbs = {}
    t.thumb_failed = {}
    t.grid = {}
    t.grid_failed = {}
    t.lines = {}
    t.find = nil
    start_timeout(0.05, || pump())
}
// Only page `p` changed (a comment, a filled field, an edited paragraph).
fn invalidate_page(t, p){
    let keep = |m| {
        let out = {}
        for k v in m { if k != "p" + p { out[k] = v } }
        out
    }
    t.renders = keep(t.renders)
    t.failed = keep(t.failed)
    t.thumbs = keep(t.thumbs)
    t.thumb_failed = keep(t.thumb_failed)
    t.grid = keep(t.grid)
    t.grid_failed = keep(t.grid_failed)
    t.lines = keep(t.lines)
    start_timeout(0.05, || pump())
}

// ---- thumbnails: the Pages panel and the Pages grid ---------------------------

fn window_start(t){ max(1, min(t.page - 8, t.pages - THUMB_WINDOW + 1)) }
fn window_end(t){ min(t.pages, window_start(t) + THUMB_WINDOW - 1) }
fn thumb_next(t, n){
    let first = max(window_start(t), t.page - 2)
    for i in n {
        let p = first + i
        if p <= window_end(t) && optional(t.thumbs, "p" + p, nil) == nil && optional(t.thumb_failed, "p" + p, nil) == nil {
            render_thumb(t, p, false)
            return true
        }
    }
    for i in window_end(t) - window_start(t) + 1 {
        let p = window_start(t) + i
        if i < n && optional(t.thumbs, "p" + p, nil) == nil && optional(t.thumb_failed, "p" + p, nil) == nil {
            render_thumb(t, p, false)
            return true
        }
    }
    false
}
fn grid_next(t){
    for i in window_end(t) - window_start(t) + 1 {
        let p = window_start(t) + i
        if optional(t.grid, "p" + p, nil) == nil && optional(t.grid_failed, "p" + p, nil) == nil {
            render_thumb(t, p, true)
            return true
        }
    }
    false
}
fn render_thumb(t, p, big){
    st.busy = true
    st.busy_at = time_now()
    engine("page", {doc: t.doc page: p dpi: pick(big, GRID_DPI, THUMB_DPI)}, fn(a){
        st.busy = false
        if engine_gone(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        wrote(a)
        let src = nil
        if a.is_ok { src = try { binary_resource(fs.read_bytes(optional(a.data, "path", ""))) } catch { nil } }
        if big {
            if src != nil { t.grid["p" + p] = src } else { t.grid_failed["p" + p] = true }
            if cur_tab() == t && t.mode == "pages" { render_grid() }
        } else {
            if src != nil { t.thumbs["p" + p] = src } else { t.thumb_failed["p" + p] = true }
            if cur_tab() == t { ui.thumbs.render() }
        }
        start_timeout(0.02, || pump())
    })
}

// ---- find -----------------------------------------------------------------

fn find_text(text){
    let t = cur_tab()
    let q = ("" + text).trim()
    if t == nil || t.state != "ready" { return }
    if q == "" {
        end_find(t)
        return
    }
    t.finding = true
    t.find = {query: q total: 0 matches: [] cur: 0 error: "" by_page: {} pages: []}
    t.panel = "search"
    let refit = auto_fit(t)
    show()
    if refit { go_page(t, t.page) }
    engine("find", {doc: t.doc query: q limit: 200}, fn(a){
        t.finding = false
        if !a.is_ok {
            t.find.error = action_failed("search this PDF", a.error)
            show()
            return
        }
        t.find.total = optional(a.data, "total", 0)
        t.find.matches = optional(a.data, "matches", [])
        // Matches by page, once: every page drawn looks up its own.
        let by_page = {}
        let pages = []
        for i m in t.find.matches {
            let key = "p" + m.page
            if optional(by_page, key, nil) == nil {
                by_page[key] = []
                pages.push(m.page)
            }
            by_page[key].push(i)
        }
        t.find.by_page = by_page
        t.find.pages = pages
        show()
        if t.find.matches.len() > 0 { go_match(t, 0) }
    })
}
fn end_find(t){
    t.find = nil
    t.finding = false
    if t.panel == "search" { t.panel = "pages" }
    let refit = auto_fit(t)
    show()
    if refit { go_page(t, t.page) }
}
fn go_match(t, i){
    let n = t.find.matches.len()
    if n == 0 { return }
    t.find.cur = pick(i < 0, n - 1, pick(i >= n, 0, i))
    let m = t.find.matches[t.find.cur]
    render_toolrow()
    ui.results.render()
    if m.page != t.page || m.page != t.anchor { go_page(t, m.page) } else { render_canvas() }
}
fn find_pages(t){ t.find.pages }
fn page_matches(t, p){ optional(t.find.by_page, "p" + p, []) }
fn find_summary(t){
    if t.finding { return "Searching…" }
    if t.find.error != "" { return t.find.error }
    if t.find.total == 0 { return "No matches for “" + t.find.query + "”" }
    plural(t.find.total, "match", "matches") + " on " + plural(find_pages(t).len(), "page", "pages")
}

// ---- changes the engine keeps: state, undo, redo, save -------------------

// After a change: what the engine now says about edits and history.
fn changed(t){
    t.edited = true
    t.can_undo = true
    t.can_redo = false
    engine("state", {doc: t.doc}, fn(a){
        if a.is_ok {
            t.edited = optional(a.data, "edited", t.edited)
            t.can_undo = optional(a.data, "can_undo", t.can_undo)
            t.can_redo = optional(a.data, "can_redo", t.can_redo)
            let pages = optional(a.data, "pages", t.pages)
            if pages != t.pages { t.pages = pages }
        }
        render_actions()
        render_status()
        render_tabs()
    })
    render_actions()
    render_status()
}
fn undo(t, redo){
    if t == nil || t.doc == nil { return }
    if redo && !t.can_redo { return }
    if !redo && !t.can_undo { return }
    engine(pick(redo, "redo", "undo"), {doc: t.doc}, fn(a){
        if !a.is_ok {
            note(action_failed(pick(redo, "redo", "undo"), a.error))
            return
        }
        t.edited = optional(a.data, "edited", true)
        t.can_undo = optional(a.data, "can_undo", false)
        t.can_redo = optional(a.data, "can_redo", false)
        // Which pages changed isn't said: draw the run again, and reread
        // what the panels show.
        invalidate(t)
        t.comments = nil
        t.fields = nil
        t.edit = nil
        reload_shape(t)
    })
}
// The document's pages and sizes again after a change that may move them.
fn reload_shape(t){
    engine("info", {doc: t.doc}, fn(a){
        if a.is_ok {
            let pages = optional(a.data, "pages", [])
            if pages.len() > 0 {
                let sizes = []
                for pg in pages { sizes.push([optional(pg, "width", 612), optional(pg, "height", 792)]) }
                t.sizes = sizes
                t.pages = pages.len()
            }
        }
        if t.mode == "comment" { load_comments(t) }
        if t.mode == "fill" { load_fields(t) }
        show()
        go_page(t, min(t.page, max(1, t.pages)))
    })
}
fn save(t, then){
    if t == nil || t.doc == nil || t.saving { return }
    t.saving = true
    render_status()
    engine("save", {doc: t.doc}, fn(a){
        t.saving = false
        wrote(a)
        if !a.is_ok {
            note(action_failed("save", a.error))
            render_status()
            return
        }
        t.edited = false
        let d = doc_named(t.name)
        if d != nil {
            d.bytes = optional(a.data, "bytes", d.bytes)
            stale_cover(d)
            remember(d)
        }
        render_status()
        render_tabs()
        render_actions()
        if then != nil { then() }
    })
}

// ---- taps on a page ---------------------------------------------------------

// `x` and `y` are in the page's points (origin top left, y down, rotation
// applied), as the engine's geometry is.
fn page_tap(t, p, x, y){
    t.page = p
    render_pill()
    if t.mode == "comment" { comment_tap(t, p, x, y, false) return }
    if t.mode == "fill" { fill_tap(t, p, x, y) return }
    if t.mode == "edit" { edit_tap(t, p, x, y) return }
    render_panel()
}
fn page_double_tap(t, p, x, y){
    if t.mode == "comment" { comment_tap(t, p, x, y, true) }
}
fn inside(r, x, y){ x >= r[0] && x <= r[0] + r[2] && y >= r[1] && y <= r[1] + r[3] }
// The text lines and paragraphs of page `p`, read once (pdf.lines).
fn with_lines(t, p, done){
    let known = optional(t.lines, "p" + p, nil)
    if known != nil {
        done(known)
        return
    }
    engine("lines", {doc: t.doc page: p}, fn(a){
        if !a.is_ok {
            note(action_failed("read this page's text", a.error))
            return
        }
        t.lines["p" + p] = a.data
        done(a.data)
    })
}

// ---- comments ---------------------------------------------------------------

fn load_comments(t){
    t.comments_state = "loading"
    render_right()
    engine("comments", {doc: t.doc}, fn(a){
        if !a.is_ok {
            t.comments_state = action_failed("read the comments", a.error)
            render_right()
            return
        }
        t.comments = optional(a.data, "comments", [])
        t.comments_state = ""
        if t.thread == nil && t.comments.len() > 0 { t.thread = t.comments[0].id }
        render_right()
        ui.notes.render()
        render_canvas()
    })
}
fn comment_named(t, id){
    if t.comments == nil { return nil }
    for c in t.comments { if c.id == id { return c } }
    nil
}
// Highlight, underline or strike out the line under the pointer (a double
// tap takes its paragraph); a note or a text box waits for its words.
fn comment_tap(t, p, x, y, paragraph){
    if st.who.author == "" {
        st.naming = true
        render_right()
        note("Type the name your comments show, under Comment as, first.")
        return
    }
    if t.tool == "note" || t.tool == "textbox" {
        t.pending = {page: p at: [x, y] type: t.tool}
        t.reply = ""
        render_right()
        return
    }
    with_lines(t, p, |lines| {
        let hit = nil
        let list = pick(paragraph, optional(lines, "paragraphs", []), optional(lines, "lines", []))
        for l in list { if hit == nil && inside(l.box, x, y) { hit = l } }
        if hit == nil {
            note("Tap a line of text to " + pick(t.tool == "highlight", "highlight", pick(t.tool == "underline", "underline", "strike out")) + " it.")
            return
        }
        let args = {doc: t.doc op: "add" page: p type: pick(t.tool == "strike", "strikeout", t.tool) rects: [hit.box] color: optional(MARK_HEX, t.color, "#ffd84d") author: st.who.author}
        engine("comment", args, fn(a){
            wrote(a)
            if !a.is_ok {
                note(action_failed("add the comment", a.error))
                return
            }
            t.thread = optional(a.data, "id", nil)
            invalidate_page(t, p)
            changed(t)
            load_comments(t)
            render_canvas()
        })
    })
}
fn post_pending(t){
    let text = t.reply.trim()
    if t.pending == nil || text == "" { return }
    let p = t.pending
    engine("comment", {doc: t.doc op: "add" page: p.page type: p.type at: p.at color: optional(MARK_HEX, t.color, "#ffd84d") text: text author: st.who.author}, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("add the note", a.error))
            return
        }
        t.pending = nil
        t.reply = ""
        t.thread = optional(a.data, "id", nil)
        invalidate_page(t, p.page)
        changed(t)
        load_comments(t)
        render_canvas()
    })
}
fn post_reply(t){
    let text = t.reply.trim()
    let c = comment_named(t, t.thread)
    if c == nil || text == "" { return }
    // A highlight with no words yet takes them as its own text.
    let edit = optional(c, "text", "") == "" && optional(c, "replies", []).len() == 0
    let args = {doc: t.doc op: "reply" id: c.id text: text author: st.who.author}
    if edit { args = {doc: t.doc op: "edit" id: c.id text: text} }
    engine("comment", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("post the reply", a.error))
            return
        }
        t.reply = ""
        changed(t)
        load_comments(t)
    })
}
fn set_status(t, status){
    let c = comment_named(t, t.thread)
    if c == nil { return }
    t.status_menu = false
    engine("comment", {doc: t.doc op: "status" id: c.id status: status}, fn(a){
        if !a.is_ok {
            note(action_failed("change the status", a.error))
            render_right()
            return
        }
        changed(t)
        load_comments(t)
    })
}
fn delete_comment(t){
    let c = comment_named(t, t.thread)
    t.head_menu = false
    if c == nil { render_right() return }
    engine("comment", {doc: t.doc op: "delete" id: c.id}, fn(a){
        if !a.is_ok {
            note(action_failed("delete the comment", a.error))
            render_right()
            return
        }
        t.thread = nil
        invalidate_page(t, c.page)
        changed(t)
        load_comments(t)
        render_canvas()
    })
}
fn open_thread(t, c){
    t.thread = c.id
    t.status_menu = false
    t.pending = nil
    if t.mode != "comment" { set_mode(t, "comment") }
    if c.page != t.page { go_page(t, c.page) }
    render_right()
    render_canvas()
}
fn set_author(text){
    let name = ("" + text).trim()
    if name == "" { return }
    st.who.author = name
    st.naming = false
    save_index()
    render_right()
}
fn status_label(s){
    if s == "accepted" { return "Accepted" }
    if s == "rejected" { return "Rejected" }
    if s == "cancelled" { return "Cancelled" }
    if s == "completed" { return "Completed" }
    ""
}

// ---- Fill & Sign --------------------------------------------------------------

fn load_fields(t){
    t.fields_state = "loading"
    render_right()
    render_toolrow()
    engine("fields", {doc: t.doc}, fn(a){
        if !a.is_ok {
            t.fields_state = action_failed("read the form", a.error)
            render_right()
            render_toolrow()
            return
        }
        t.fields = optional(a.data, "fields", [])
        t.fields_state = ""
        render_right()
        render_toolrow()
        render_canvas()
    })
}
fn field_named(t, name){
    if t.fields == nil { return nil }
    for f in t.fields { if f.name == name { return f } }
    nil
}
fn field_empty(f){
    let v = optional(f, "value", nil)
    v == nil || v == false || ("" + v).trim() == "" || v == "Off"
}
fn field_shown(f){
    let v = optional(f, "value", nil)
    if v == true { return "Checked" }
    if v == false || v == nil { return "" }
    "" + v
}
fn read_only(f){ optional(f, "read_only", false) == true }
fn empty_required(t){
    let n = 0
    if t.fields == nil { return 0 }
    for f in t.fields { if optional(f, "required", false) && !read_only(f) && field_empty(f) { n = n + 1 } }
    n
}
fn form_summary(t){
    if t.fields_state == "loading" { return "Reading the form…" }
    if t.fields_state != "" { return t.fields_state }
    if t.place != nil { return place_hint(t) }
    if t.fields == nil || t.fields.len() == 0 { return "This PDF has no form fields. Add text, a date or your initials where they go." }
    let line = "This form has " + plural(t.fields.len(), "field", "fields") + "."
    let empty = empty_required(t)
    if empty > 0 { line = line + " " + plural(empty, "required field is", "required fields are") + " empty." }
    line
}
fn select_field(t, f){
    if read_only(f) {
        note("“" + f.name + "” can't be changed: the form keeps it read-only.")
        return
    }
    t.field = f.name
    t.field_text = field_shown(f)
    t.field_on = optional(f, "value", false) == true
    t.place = nil
    if f.page != t.page && (f.page < t.anchor || f.page > run_end(t)) { go_page(t, f.page) }
    render_right()
    render_canvas()
    render_toolrow()
}
fn fill_field(t){
    let f = field_named(t, t.field)
    if f == nil { return }
    let values = {}
    let kind = "" + optional(f, "type", "text")
    if kind == "checkbox" || kind == "check" { values[f.name] = t.field_on } else { values[f.name] = t.field_text }
    engine("fill", {doc: t.doc values: values}, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("fill the field", a.error))
            return
        }
        t.field = nil
        invalidate_page(t, f.page)
        changed(t)
        load_fields(t)
    })
}
fn fill_tap(t, p, x, y){
    if t.place != nil {
        place_mark(t, p, x, y)
        return
    }
    if t.fields == nil { return }
    for f in t.fields {
        if f.page == p && inside(f.rect, x, y) {
            select_field(t, f)
            return
        }
    }
}
fn start_place(t, kind){
    t.field = nil
    t.place = {kind: kind}
    if kind == "initials" { t.place_text = st.who.initials } else { t.place_text = "" }
    render_right()
    render_toolrow()
}
fn place_hint(t){
    if t.place.kind == "initials" { return "Tap the page where your initials go." }
    if t.place.kind == "date" { return "Tap the page where the date goes." }
    "Tap the page where the text goes."
}
fn place_mark(t, p, x, y){
    let text = t.place_text.trim()
    if text == "" && t.place.kind != "date" {
        note(pick(t.place.kind == "initials", "Type your initials first.", "Type the text first."))
        return
    }
    if t.place.kind == "initials" {
        st.who.initials = text
        save_index()
    }
    let args = {doc: t.doc page: p kind: t.place.kind at: [x, y] text: text}
    if t.place.kind == "date" { args = {doc: t.doc page: p kind: "date" at: [x, y]} }
    engine("fill_sign", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("place it", a.error))
            return
        }
        t.place = nil
        invalidate_page(t, p)
        changed(t)
        render_right()
        render_toolrow()
        render_canvas()
        pump()
    })
}

// ---- Pages: rotate, delete, move, insert, extract --------------------------

fn toggle_select(t, p){
    if has(t.selected, p) { t.selected.retain(|x| x != p) } else { t.selected.push(p) }
    t.page = p
    render_grid()
    render_toolrow()
    render_pill()
}
// The selection in page order, at most what one call may name.
fn chosen(t){
    let out = []
    for i in t.pages { if has(t.selected, i + 1) && out.len() < MAX_NAMED { out.push(i + 1) } }
    out
}
fn page_op(t, args, what, done){
    args.doc = t.doc
    engine("pages", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed(what, a.error))
            return
        }
        changed(t)
        done(a.data)
    })
}
fn rotate(t, angle){
    let pages = chosen(t)
    if pages.len() == 0 { note("Choose pages to rotate.") return }
    page_op(t, {op: "rotate" pages: pages angle: angle}, "rotate the pages", |v| {
        for p in pages { invalidate_page(t, p) }
        reload_shape(t)
    })
}
fn delete_pages(t){
    let pages = chosen(t)
    if pages.len() == 0 { note("Choose pages to delete.") return }
    if pages.len() >= t.pages { note("A PDF keeps at least one page.") return }
    page_op(t, {op: "delete" pages: pages}, "delete the pages", |v| {
        invalidate(t)
        t.selected = []
        reload_shape(t)
    })
}
fn extract_pages(t){
    let pages = chosen(t)
    if pages.len() == 0 { note("Choose pages to extract.") return }
    let name = unique_name(t.title + " pages") + ".pdf"
    page_op(t, {op: "extract" pages: pages out: LIBRARY + "/" + name}, "extract the pages", |v| {
        scan_library()
        let d = doc_named(name)
        if d != nil {
            d.pages = pages.len()
            remember(d)
        }
        note("Extracted " + plural(pages.len(), "page", "pages") + " into “" + stem(name) + "”. It's on Home.")
    })
}
fn insert_file(t, d){
    let after = t.pages
    let pages = chosen(t)
    if pages.len() > 0 { after = pages[pages.len() - 1] }
    t.inserting = false
    page_op(t, {op: "insert_file" path: d.path at: after + 1}, "insert the pages", |v| {
        invalidate(t)
        t.selected = []
        reload_shape(t)
        note("Inserted “" + d.title + "” after page " + after + ".")
    })
}
// Drag a page tile to move it: the pan's offset, in tiles, decides where.
fn tile_w(t){ round(190 * t.tile) }
fn tile_h(t){ round(tile_w(t) * 1.32) }
fn grid_cols(t){ max(1, floor((canvas_w() - 40 + 30) / (tile_w(t) + 36))) }
fn drag_target(t, p, dx, dy){
    let cols = grid_cols(t)
    let col = (p - window_start(t)) % cols
    let row = floor((p - window_start(t)) / cols)
    let c = clamp(round(col + dx / (tile_w(t) + 30)), 0, cols - 1)
    let r = max(0, row + round(dy / (tile_h(t) + 46)))
    clamp(window_start(t) + r * cols + c, 1, t.pages)
}
fn tile_pan(t, p, dx, dy, phase){
    if phase == 0 {
        t.drag = {page: p to: p}
        render_toolrow()
        return
    }
    if t.drag == nil { return }
    let to = drag_target(t, p, dx, dy)
    if phase == 1 {
        if to != t.drag.to {
            t.drag.to = to
            render_grid()
        }
        return
    }
    t.drag = nil
    if to == p {
        render_grid()
        return
    }
    let pages = pick(has(t.selected, p), chosen(t), [p])
    page_op(t, {op: "move" pages: pages to: to}, "move the pages", |v| {
        invalidate(t)
        t.selected = []
        reload_shape(t)
    })
}

// ---- Combine ------------------------------------------------------------------

fn start_combine(t){
    if t.combine != nil { return }
    let d = doc_named(t.name)
    t.combine = {items: [] name: unique_name(t.title + " combined") busy: false error: "" adding: false editing: -1}
    if d != nil { t.combine.items.push({name: d.name title: d.title pages: t.pages range: ""}) }
}
fn combine_add(t, d){
    let c = t.combine
    if c.items.len() >= MAX_MERGE {
        note("PDF Tools combines up to " + MAX_MERGE + " PDFs at a time.")
        return
    }
    c.items.push({name: d.name title: d.title pages: d.pages range: ""})
    c.adding = false
    render_combine()
}
fn combine_remove(t, i){
    let c = t.combine
    let kept = []
    for k it in c.items { if k != i { kept.push(it) } }
    c.items = kept
    render_combine()
}
fn combine_move(t, i, dy){
    let c = t.combine
    let j = clamp(i + round(dy / 113), 0, c.items.len() - 1)
    if j == i { return }
    let moving = c.items[i]
    let rest = []
    for k it in c.items { if k != i { rest.push(it) } }
    let out = []
    for k it in rest {
        if k == j { out.push(moving) }
        out.push(it)
    }
    if j >= rest.len() { out.push(moving) }
    c.items = out
    render_combine()
}
fn item_pages(it){
    let total = it.pages
    if total == nil {
        let d = doc_named(it.name)
        if d != nil { total = d.pages }
    }
    if total == nil { return nil }
    range_pages(it.range, total)
}
fn item_count(it){
    let pages = item_pages(it)
    if pages == nil { return nil }
    pages.len()
}
fn combine_total(t){
    let total = 0
    for it in t.combine.items {
        let n = item_count(it)
        if n == nil { return nil }
        total = total + n
    }
    total
}
fn combine_problem(t){
    let c = t.combine
    if c.items.len() < 2 { return "Add another PDF to combine." }
    for it in c.items { if item_count(it) == nil { return "Check the pages of “" + it.title + "”: use numbers and ranges such as 1-4, 9." } }
    if c.name.trim() == "" { return "Give the new PDF a name." }
    if c.name.search("/") >= 0 { return "A name can't contain “/”." }
    if fs.exists(LIBRARY + "/" + c.name.trim() + ".pdf") { return "A PDF with this name is already in PDF Tools." }
    ""
}
fn do_combine(t){
    let c = t.combine
    if c.busy { return }
    let problem = combine_problem(t)
    if problem != "" {
        c.error = problem
        render_combine()
        return
    }
    let paths = []
    for it in c.items {
        let path = LIBRARY + "/" + it.name
        if range_arg(it.range) == "" { paths.push(path) } else { paths.push({path: path pages: range_arg(it.range)}) }
    }
    let name = c.name.trim() + ".pdf"
    c.busy = true
    c.error = ""
    render_combine()
    engine("merge", {paths: paths out: LIBRARY + "/" + name}, fn(a){
        c.busy = false
        wrote(a)
        if !a.is_ok {
            c.error = action_failed("combine them", a.error)
            render_combine()
            return
        }
        let total = combine_total(t)
        st.index[name] = {pages: total bytes: optional(a.data, "bytes", nil)}
        save_index()
        scan_library()
        let d = doc_named(name)
        t.combine = nil
        set_mode(t, "read")
        note("Combined into “" + stem(name) + "”, " + plural(total, "page", "pages") + ".")
        if d != nil { open_doc(d) }
    })
}

// ---- Edit -------------------------------------------------------------------

fn edit_tap(t, p, x, y){
    if !t.can_edit {
        note("This PDF doesn't allow editing.")
        return
    }
    with_lines(t, p, |lines| {
        let hit = nil
        for g in optional(lines, "paragraphs", []) { if hit == nil && inside(g.box, x, y) { hit = g } }
        if hit == nil {
            note("Click a paragraph of text to edit it.")
            return
        }
        // Its lines' boxes show how it is aligned (guess_align).
        let boxes = []
        for n in optional(hit, "lines", []) {
            for l in optional(lines, "lines", []) { if l.n == n { boxes.push(l.box) } }
        }
        let align = guess_align(boxes)
        t.edit = {page: p n: hit.n box: hit.box text: hit.text draft: hit.text font: optional(hit, "font", "") size: optional(hit, "size", 0)
            align: align align0: align color: nil colours: false}
        render_canvas()
        render_right()
    })
}
fn apply_edit(t){
    let e = t.edit
    if e == nil { return }
    if !edit_changes(e) {
        t.edit = nil
        render_canvas()
        render_right()
        return
    }
    engine("edit_text", edit_args(t.doc, e), fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("change the text", a.error))
            return
        }
        t.edit = nil
        invalidate_page(t, e.page)
        changed(t)
        render_right()
        render_canvas()
        pump()
    })
}
fn cancel_edit(t){
    t.edit = nil
    render_canvas()
    render_right()
}
fn set_align(t, a){
    if t == nil || t.edit == nil { return }
    t.edit.align = a
    render_right()
}
// `hex` nil: the paragraph keeps its own colour.
fn set_colour(t, hex){
    if t == nil || t.edit == nil { return }
    t.edit.color = hex
    t.edit.colours = false
    render_right()
}
fn toggle_colours(t){
    if t == nil || t.edit == nil { return }
    t.edit.colours = !t.edit.colours
    render_right()
}
fn font_text(e){
    let size = pick(e.size > 0, "" + round(e.size * 10) / 10 + " pt", "")
    if e.font == "" { return size }
    if size == "" { return e.font }
    e.font + "  ·  " + size
}

// ---- modes and panels ---------------------------------------------------------

fn set_mode(t, m){
    if t.mode == m { return }
    // Comment and Edit start with the left panel folded (04-comment,
    // 08-edit); leaving them brings it back.
    let wide = |x| x == "comment" || x == "edit"
    if wide(m) && !wide(t.mode) {
        t.panel_kept = t.panel
        t.panel = ""
    }
    if !wide(m) && wide(t.mode) && t.panel == "" { t.panel = t.panel_kept }
    t.mode = m
    t.place = nil
    t.pending = nil
    t.drag = nil
    if m != "edit" { t.edit = nil }
    if m == "comment" && t.comments == nil { load_comments(t) }
    if m == "fill" && t.fields == nil { load_fields(t) }
    if m == "combine" { start_combine(t) }
    // Until the person zooms, the page fits the canvas the mode leaves it,
    // up to 100%.
    if t.zoom_auto && t.fit == "" { t.zoom = start_zoom(t) }
    show()
    if m != "pages" && m != "combine" { go_page(t, t.page) }
    pump()
}
fn set_panel(t, p){
    t.panel = pick(t.panel == p, "", p)
    if t.panel == "comments" && t.comments == nil { load_comments(t) }
    show()
    if auto_fit(t) { go_page(t, t.page) }
    pump()
}
// The automatic zoom worked out again for the canvas there is now: whether
// it changed.
fn auto_fit(t){
    if !t.zoom_auto || t.fit != "" || t.state != "ready" { return false }
    let z = start_zoom(t)
    if z == t.zoom { return false }
    t.zoom = z
    true
}

// ---- size --------------------------------------------------------------------

// The shell calls this when the app's window changes size, on every frame
// of its open animation too (Photos does the same): settle, then lay out.
fn on_app_resize(width, height){
    if width <= 0 { return }
    if abs(width - st.width) < 2 && abs(height - st.height) < 2 { return }
    st.width = width
    st.height = height
    st.resize_n = st.resize_n + 1
    let n = st.resize_n
    start_timeout(0.3, || {
        if n != st.resize_n || !st.booted { return }
        let t = cur_tab()
        if t != nil && t.state == "ready" && t.fit != "" {
            refit(t)
            go_page(t, t.page)
        }
        if t != nil && auto_fit(t) { go_page(t, t.page) }
        show()
    })
}

// ---- drawing: each region renders on its own ----------------------------------

fn render_tabs(){ ui.tabs.render() }
fn render_home(){ if st.screen == "home" { ui.home_pane.render() render_status() } }
fn render_modebar(){ ui.modebar.render() }
fn render_actions(){ ui.modebar.render() }
fn render_canvas(){ ui.canvas.render() }
fn render_pill(){ ui.pill.render() }
fn render_toolrow(){ ui.toolrow.render() }
fn render_grid(){ ui.grid.render() }
fn render_combine(){ ui.combine.render() }
fn render_status(){ ui.status.render() }
fn render_dialog(){
    ui.dialog_box.set_visible(st.confirm != nil)
    ui.dialog.render()
}
fn render_right(){
    ui.right_thread.render()
    ui.right_side.render()
}
fn render_panel(){
    ui.panel_head.render()
    ui.thumbs.render()
    ui.list_head.render()
    ui.outline.render()
    ui.notes.render()
    ui.results.render()
}
fn refresh_doc(){
    if st.screen != "doc" { render_tabs() return }
    show()
}
// Which regions show, then every region drawn again.
fn show(){
    let t = cur_tab()
    let doc = t != nil
    ui.home.set_visible(!doc)
    ui.doc.set_visible(doc)
    if doc {
        let ready = t.state == "ready"
        ui.panel_narrow.set_visible(ready && left_open(t) && t.panel == "pages")
        ui.panel_wide.set_visible(ready && left_open(t) && t.panel != "pages")
        ui.line_left.set_visible(ready && left_open(t))
        ui.thumbs.set_visible(t.panel == "pages")
        ui.outline_box.set_visible(t.panel == "outline")
        ui.notes_box.set_visible(t.panel == "comments")
        ui.results_box.set_visible(t.panel == "search")
        ui.right_thread_box.set_visible(ready && t.mode == "comment")
        ui.right_side_box.set_visible(ready && (t.mode == "fill" || t.mode == "edit"))
        ui.line_right.set_visible(ready && right_open(t))
        ui.canvas.set_visible(ready && t.mode != "pages" && t.mode != "combine")
        ui.grid_box.set_visible(ready && t.mode == "pages")
        ui.combine_box.set_visible(ready && t.mode == "combine")
        ui.notice_box.set_visible(!ready)
        ui.pill.set_visible(ready && t.mode != "combine")
        ui.notice.render()
        render_modebar()
        ui.rail.render()
        render_panel()
        render_toolrow()
        render_right()
        if ready && t.mode == "pages" { render_grid() }
        if ready && t.mode == "combine" { render_combine() }
        if ready && t.mode != "pages" && t.mode != "combine" { render_canvas() }
        render_pill()
    } else {
        ui.home_pane.render()
    }
    render_tabs()
    render_status()
    render_dialog()
}

// Every 2 s: a boot that a script budget abort cut short starts again, and
// the pump picks up work an aborted callback left (Quick Deck needed the
// same under machine load). Made once: a restyle runs this file again.
fn heartbeat(){
    if !st.booted { boot() return }
    if optional(st, "index_dirty", false) { save_index() }
    pump()
}
fn boot(){
    if st.booted {
        resume()
        return
    }
    load_index()
    scan_library()
    st.booted = true
    show()
    check_files()
    pump()
}
// After a restyle: the same screen, every region drawn with the new look.
fn resume(){
    show()
    pump()
}

// ---- views: each returns one widget, drawn by a region's on_render ----------
// Sizes and spacing are the maps' (design/map/NN-*.json), in points.

// Each mode's column width: its label plus 16 pt either side (02-reading).
let MODES = [{id: "read" label: "Read" w: 69}, {id: "comment" label: "Comment" w: 101}, {id: "fill" label: "Fill & Sign" w: 100}, {id: "pages" label: "Pages" w: 78}, {id: "combine" label: "Combine" w: 99}, {id: "edit" label: "Edit" w: 61}]

// The document tabs: Home while it shows, one tab per open PDF, then Open.
fn tabs_view(){
    View{width: Fill height: Fill flow: Overlay
        View{width: Fill height: Fill flow: Down align: Align{y: 1.0}
            Line{}
        }
        View{width: Fill height: Fill flow: Right padding: Inset{left: 13 right: 13 top: 11} spacing: 2
            if st.screen == "home" { home_tab() }
            for i t in st.tabs { doc_tab(i, t) }
            View{width: Fit height: 42 flow: Right align: Align{y: 0.5} padding: Inset{left: 6}
                Outline{height: 36 padding: Inset{left: 12 right: 14} spacing: 6 text: "Open" icon_walk: Walk{width: 16 height: 16}
                    draw_icon +: {svg: icon("plus") color: pt_ink2}
                    draw_bg +: {color: pick(st.screen == "home", pt_tabs, pt_bar)}
                    on_click: || go_home()}
            }
        }
    }
}
// A tab is 48 pt tall from the row's top padding: the row clips its last 6,
// so the open tab's rounded bottom and border disappear into the mode bar.
let Tab = RoundedView{width: Fit height: 48 flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 8 bottom: 6} spacing: 9 show_bg: true
    draw_bg +: {color: #x00000000 border_size: 0.0 border_color: pt_line border_radius: 6.0}}
fn home_tab(){
    Tab{width: 188 padding: Inset{left: 16 right: 12 bottom: 6} spacing: 10 flow: Overlay draw_bg +: {color: pt_tab_on border_size: 1.0}
        View{width: Fill height: Fill flow: Right align: Align{y: 0.5} spacing: 10
            Ico{width: 18 height: 18 draw_svg +: {svg: icon("home") color: pt_ink}}
            Label{padding: 0 text: "Home" draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 12}}}
        }
        View{width: Fill height: Fill flow: Down align: Align{y: 1.0} padding: Inset{left: -10 right: -6 bottom: 2}
            SolidView{width: Fill height: 2 draw_bg.color: pt_accent}
        }
    }
}
// The title's room: the tabs share the row, at most 190 pt each.
// A tab's title width: what the row leaves after its padding (26), Open
// (100) and the Home tab (190), shared by the open tabs, less each tab's
// icon, close cross and padding (86), so Open always shows.
fn tab_text_w(){ clamp(floor((st.width - 126 - pick(st.screen == "home", 190, 0)) / max(1, st.tabs.len())) - 86, 20, 190) }
fn doc_tab(i, t){
    let on = st.screen == "doc" && i == st.cur
    let title = shown_name(t.title) + pick(t.edited, " •", "")
    let long = title.len() * 6.7 > tab_text_w()
    GestureView{width: Fit height: 48 cursor: MouseCursor.Hand on_tap: |x, y| show_tab(i)
        Tab{draw_bg +: {color: pick(on, pt_tab_on, #x00000000) border_size: pick(on, 1.0, 0.0)}
            Ico{width: 16 height: 16 draw_svg +: {svg: icon("file-pdf") color: pick(on, pt_ink2, pt_muted)}}
            if long { Label{padding: 0 width: tab_text_w() max_lines: 1 text_overflow: TextOverflow.Ellipsis text: title draw_text +: {color: pick(on, pt_ink, pt_muted) text_style: theme.font_regular{font_size: 12}}} }
            if !long { Label{padding: 0 text: title draw_text +: {color: pick(on, pt_ink, pt_muted) text_style: theme.font_regular{font_size: 12}}} }
            IconBtn{width: 26 height: 26 icon_walk: Walk{width: 13 height: 13} draw_icon +: {svg: icon("close") color: pt_muted}
                on_click: || ask_close(t)}
        }
    }
}

// The mode bar: modes, search, Undo, Redo, Save.
fn modebar_view(){
    let t = cur_tab()
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 15 right: 19}
        for m in MODES { mode_tab(t, m) }
        // The search field takes what the row leaves, at most 344 (02-reading),
        // on the right.
        View{width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5} padding: Inset{left: 16}
            if t != nil && t.state == "ready" { search_field(t) }
        }
        View{width: 14 height: 1}
        IconBtn{icon_walk: Walk{width: 20 height: 20} draw_icon +: {svg: icon("undo") color: pick(t != nil && t.can_undo, pt_icon, pt_faint)} on_click: || undo(cur_tab(), false)}
        IconBtn{margin: Inset{left: 4} icon_walk: Walk{width: 20 height: 20} draw_icon +: {svg: icon("redo") color: pick(t != nil && t.can_redo, pt_icon, pt_faint)} on_click: || undo(cur_tab(), true)}
        SolidView{width: 1 height: 26 margin: Inset{left: 12 right: 14} draw_bg.color: pt_line}
        Primary{width: pick(narrow(), 100, 128) height: 33 spacing: 9 text: pick(t != nil && t.saving, "Saving…", "Save") icon_walk: Walk{width: 17 height: 17}
            draw_icon +: {svg: icon("save")} draw_text +: {text_style: theme.font_regular{font_size: 11.5}}
            on_click: || save(cur_tab(), nil)}
    }
}
fn mode_tab(t, m){
    let on = t != nil && t.mode == m.id
    // A narrow window (the desktop's default) trims each tab's padding,
    // so the search field keeps room for its words.
    View{width: m.w - pick(narrow(), 16, 0) height: Fill flow: Down align: Align{x: 0.5}
        Flat{width: Fill height: Fill padding: Inset{left: 6 right: 6} text: m.label
            draw_bg +: {color_hover: #x00000000 color_down: #x00000000}
            draw_text +: {color: pick(on, pt_link, pt_ink2) color_hover: pick(on, pt_link, pt_ink) color_down: pt_link color_focus: pick(on, pt_link, pt_ink2) text_style: theme.font_regular{font_size: 12}}
            on_click: || { let x = cur_tab() if x != nil && x.state == "ready" { set_mode(x, m.id) } }}
        SolidView{width: Fill height: 3 margin: pick(narrow(), Inset{left: 8 right: 8 bottom: 1}, Inset{left: 16 right: 16 bottom: 1}) draw_bg.color: pick(on, pt_accent, #x00000000)}
    }
}
fn search_field(t){
    let q = ""
    if t.find != nil { q = t.find.query }
    RoundedView{width: Fill max_width: 344 height: 35 flow: Overlay show_bg: true
        draw_bg +: {color: pt_field border_size: 1.0 border_color: pt_field_line border_radius: 5.0}
        View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 6}
            Ico{width: 18 height: 18 draw_svg +: {svg: icon("search") color: pt_muted}}
            Gap{}
            if q != "" {
                IconBtn{width: 26 height: 26 icon_walk: Walk{width: 13 height: 13} draw_icon +: {svg: icon("close") color: pt_muted} on_click: || end_find(cur_tab())}
            }
        }
        search := TextInput{width: Fill height: Fill margin: Inset{left: 36 right: pick(q != "", 34, 8)} padding: Inset{left: 4 right: 4 top: 9 bottom: 8}
            text: q empty_text: "Search in document"
            on_return: |text| find_text(text)
            draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000
                border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000
                border_size: 0.0}
            draw_text +: {color: pt_ink color_hover: pt_ink color_focus: pt_ink color_empty: pt_faint color_empty_hover: pt_faint color_empty_focus: pt_faint text_style: theme.font_regular{font_size: 12}}
            draw_selection.color: #x557dcc55}
    }
}

// The rail: Pages, Outline, Comments, Search.
fn rail_view(){
    let t = cur_tab()
    View{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: 13} spacing: 8
        rail_item(t, "pages", "page", "Pages")
        rail_item(t, "outline", "outline", "Outline")
        rail_item(t, "comments", "comment", "Comments")
        rail_item(t, "search", "search", "Search")
    }
}
fn rail_on(t, id){
    if t == nil { return false }
    if t.mode == "pages" { return id == "pages" }
    left_open(t) && t.panel == id
}
fn rail_tap(id){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return }
    if t.mode == "pages" || t.mode == "combine" {
        t.panel = id
        set_mode(t, "read")
        return
    }
    if narrow() && right_open(t) { set_mode(t, "read") }
    set_panel(t, id)
}
fn rail_item(t, id, ic, label){
    let on = rail_on(t, id)
    GestureView{width: 69 height: 77 cursor: MouseCursor.Hand on_tap: |x, y| rail_tap(id)
        RoundedView{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 7 show_bg: true
            draw_bg +: {color: pick(on, pt_tint, #x00000000) border_radius: 6.0}
            Ico{width: 26 height: 26 draw_svg +: {svg: icon(ic) color: pick(on, pt_tint_ink, pt_icon)}}
            Label{padding: 0 text: label draw_text +: {color: pick(on, pt_tint_ink, pt_muted) text_style: theme.font_regular{font_size: 10.5}}}
        }
    }
}

// The left panel's head: its title and a cross that folds it away.
fn head_row(title, line){
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: 46 flow: Right align: Align{y: 0.5} padding: Inset{left: 15 right: 8}
            Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: title draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 13}}}
            IconBtn{width: 30 height: 30 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("close") color: pt_muted}
                on_click: || { let t = cur_tab() if t != nil { set_panel(t, t.panel) } }}
        }
        if line { Line{draw_bg.color: pt_line_soft} }
    }
}
fn panel_head_view(){ head_row("Pages", false) }
fn list_head_view(){
    let t = cur_tab()
    if t == nil { return View{width: Fill height: 1} }
    if t.panel == "outline" { return head_row("Outline", true) }
    if t.panel == "comments" { return head_row("Comments", true) }
    if t.find == nil { return head_row("Search", true) }
    head_row(find_summary(t), true)
}

// Pages panel: thumbnails, filled in one at a time.
fn thumbs_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let first = window_start(t)
    let last = window_end(t)
    View{width: Fill height: Fit flow: Down padding: Inset{top: 2 bottom: 20} spacing: 14
        if first > 1 {
            LinkBtn{margin: Inset{left: 46} text: "‹ Pages 1–" + (first - 1) on_click: || go_page(cur_tab(), max(1, window_start(cur_tab()) - 20))}
        }
        for i in last - first + 1 { thumb_row(t, first + i) }
        if last < t.pages {
            LinkBtn{margin: Inset{left: 46} text: "Pages " + (last + 1) + "–" + t.pages + " ›" on_click: || go_page(cur_tab(), window_end(cur_tab()) + 1)}
        }
    }
}
fn thumb_row(t, p){
    let s = page_pt(t, p)
    let h = round(91 * s[1] / max(1, s[0]))
    let on = p == t.page
    let src = optional(t.thumbs, "p" + p, nil)
    GestureView{width: Fill height: Fit flow: Right align: Align{y: 1.0} padding: Inset{left: 52} spacing: 4 cursor: MouseCursor.Hand
        on_tap: |x, y| go_page(cur_tab(), p)
        RoundedView{width: 99 height: h + 8 padding: 3 show_bg: true
            draw_bg +: {color: #x00000000 border_size: pick(on, 2.0, 0.0) border_color: pt_accent border_radius: 3.0}
            RoundedView{width: 91 height: h padding: 1 show_bg: true draw_bg +: {color: #xffffff border_size: 1.0 border_color: pt_thumb_line border_radius: 0.5}
                if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
            }
        }
        Label{padding: 0 text: "" + p draw_text +: {color: pick(on, pt_accent, pt_muted) text_style: theme.font_regular{font_size: 11.5}}}
    }
}

// Outline panel: the document's bookmarks as a tree.
fn flat_outline(t, items, depth, out){
    for it in items {
        let kids = optional(it, "children", [])
        let key = "" + depth + "/" + optional(it, "title", "") + "/" + optional(it, "page", 0)
        out.push({title: optional(it, "title", "") page: optional(it, "page", 1) depth: depth key: key kids: kids.len()})
        if kids.len() > 0 && optional(t.outline_open, key, true) { flat_outline(t, kids, depth + 1, out) }
    }
    out
}
fn outline_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let rows = flat_outline(t, t.outline, 0, [])
    let reached = 0
    for r in rows { if r.page <= t.page && r.page > reached { reached = r.page } }
    let at = -1
    for i r in rows { if at < 0 && r.page == reached { at = i } }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 6 right: 8 top: 8 bottom: 20} spacing: 0
        if rows.len() == 0 { View{width: Fill height: Fit padding: Inset{left: 10 top: 8} Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "This PDF has no outline." draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5}}}} }
        for i r in rows { outline_row(t, r, i == at) }
    }
}
fn outline_row(t, r, on){
    let open = optional(t.outline_open, r.key, true)
    GestureView{width: Fill height: 42 cursor: MouseCursor.Hand on_tap: |x, y| go_page(cur_tab(), r.page)
        RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 2 + r.depth * 36 right: 8} spacing: 6 show_bg: true
            draw_bg +: {color: pick(on, pt_accent, #x00000000) border_radius: 4.0}
            if r.kids > 0 {
                IconBtn{width: 16 height: 24 icon_walk: Walk{width: 11 height: 11}
                    draw_icon +: {svg: icon(pick(open, "triangle-down", "triangle-right")) color: pick(on, #xffffff, pt_muted)}
                    on_click: || { let x = cur_tab() x.outline_open[r.key] = !open ui.outline.render() }}
            }
            if r.kids == 0 { View{width: 16 height: 1} }
            Ico{width: 18 height: 18 draw_svg +: {svg: icon("bookmark") color: pick(on, #xffffff, pt_icon)}}
            Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: r.title draw_text +: {color: pick(on, #xffffff, pt_ink2) text_style: theme.font_regular{font_size: 12}}}
        }
    }
}

// Comments panel: every comment, newest page order as the engine lists them.
fn notes_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 8 right: 8 top: 8 bottom: 20} spacing: 6
        if t.comments == nil || t.comments_state != "" {
            View{width: Fill height: Fit padding: Inset{left: 8 top: 6} Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: pick(t.comments_state == "" || t.comments_state == "loading", "Reading the comments…", t.comments_state) draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5}}}}
        }
        if t.comments != nil && t.comments.len() == 0 {
            View{width: Fill height: Fit padding: Inset{left: 8 top: 6} Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "No comments yet. Choose Comment to highlight text or add a note." draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5}}}}
        }
        if t.comments != nil { for c in t.comments { note_row(t, c) } }
    }
}
fn note_row(t, c){
    let on = t.thread == c.id
    GestureView{width: Fill height: Fit cursor: MouseCursor.Hand on_tap: |x, y| open_thread(cur_tab(), c)
        RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 10 right: 10 top: 9 bottom: 10} spacing: 4 show_bg: true
            draw_bg +: {color: pick(on, pt_select, #x00000000) border_size: pick(on, 1.0, 0.0) border_color: pt_tint_line border_radius: 4.0}
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                RoundedView{width: 10 height: 10 show_bg: true draw_bg +: {color: mark_color(optional(c, "color", "")) border_radius: 5.0}}
                Label{padding: 0 text: "Page " + c.page draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 11.5}}}
                Gap{}
                Label{padding: 0 text: optional(c, "author", "") max_lines: 1 text_overflow: TextOverflow.Ellipsis draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
            }
            if optional(c, "text", "") != "" {
                Label{padding: 0 width: Fill max_lines: 2 flow: Flow.Right{wrap: true} text: c.text draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 11.5 line_spacing: 1.35}}}
            }
        }
    }
}
// A comment's colour as the engine reports it ("#RRGGBB"), as the nearest of
// the four dots (a comment made elsewhere can have any colour).
// "#1A2B3C" → the byte at `at` (0, 2 or 4), or -1.
let HEX_DIGITS = "0123456789abcdef0123456789ABCDEF"
fn hex_byte(s, at){
    let m = regex("^#?([0-9A-Fa-f])([0-9A-Fa-f])([0-9A-Fa-f])([0-9A-Fa-f])([0-9A-Fa-f])([0-9A-Fa-f])$").exec(s)
    if m == nil { return -1 }
    (HEX_DIGITS.search(m.captures[at + 1]) % 16) * 16 + HEX_DIGITS.search(m.captures[at + 2]) % 16
}
fn mark_of(c){
    let s = ("" + c).trim()
    if s == "yellow" || s == "green" || s == "blue" || s == "pink" { return s }
    let r = hex_byte(s, 0)
    let g = hex_byte(s, 2)
    let b = hex_byte(s, 4)
    if r < 0 { return "yellow" }
    if b > r && b > g { return "blue" }
    if g > r && g >= b { return "green" }
    if r > 200 && g > 170 && b < 170 { return "yellow" }
    if r > g && b > g { return "pink" }
    "yellow"
}
fn mark_color(c){
    let m = mark_of(c)
    if m == "green" { return #x5cb85c }
    if m == "blue" { return #x2d7ff9 }
    if m == "pink" { return #xf0609e }
    #xf5c518
}

// Search panel: the matches, grouped by page, the current one marked.
fn results_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    if t.find == nil {
        return View{width: Fill height: Fit padding: Inset{left: 16 right: 16 top: 10}
            Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "Type a word or phrase in Search in document, then press Return." draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5 line_spacing: 1.4}}}
        }
    }
    let current = nil
    if t.find.matches.len() > 0 { current = t.find.matches[t.find.cur].page }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 4 right: 16 top: 0 bottom: 24} spacing: 0
        for p in find_pages(t) { result_group(t, p, p == current) }
    }
}
fn result_group(t, p, on){
    let count = page_matches(t, p).len()
    RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 12 right: 12 top: 12 bottom: 12} spacing: 8 show_bg: true
        draw_bg +: {color: pick(on, pt_select, #x00000000) border_size: pick(on, 1.5, 0.0) border_color: pt_accent border_radius: 4.0}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            Label{padding: 0 text: "Page " + p draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 12}}}
            Gap{}
            Label{padding: 0 text: plural(count, "match", "matches") draw_text +: {color: pt_faint text_style: theme.font_regular{font_size: 10.5}}}
        }
        for i in page_matches(t, p) {
            if i > 0 && t.find.matches[i - 1].page == p { Line{draw_bg.color: pt_line_soft} }
            if true {
                GestureView{width: Fill height: Fit flow: Right align: Align{y: 0.5} cursor: MouseCursor.Hand on_tap: |x, y| go_match(cur_tab(), i)
                    Html{width: Fill height: Fit padding: 0 body: snippet_html(optional(t.find.matches[i], "snippet", ""))
                        font_color: pick(i == t.find.cur, pt_ink, pt_ink2) font_size: 11.5
                        draw_text +: {color: pick(i == t.find.cur, pt_ink, pt_ink2)}
                        text_style_normal +: {font_size: 11.5} text_style_bold +: {font_size: 11.5}}
                    if on && i == t.find.cur { Ico{width: 16 height: 16 margin: Inset{left: 6} draw_svg +: {svg: icon("chevron-right") color: pt_muted}} }
                }
            }
        }
        if !on { Line{margin: Inset{top: 4} draw_bg.color: pt_line_soft} }
    }
}

// Above the canvas: the find bar, the Comment tools, the form banner, the
// Pages actions.
fn toolrow_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 0} }
    if t.mode == "comment" { return comment_tools(t) }
    if t.mode == "fill" { return form_banner(t) }
    if t.mode == "pages" { return pages_actions(t) }
    if t.find != nil && t.mode != "combine" { return find_bar(t) }
    View{width: Fill height: 0}
}
fn bar_row(height, color){
    SolidView{width: Fill height: height flow: Right align: Align{y: 0.5} draw_bg.color: color}
}
fn find_bar(t){
    let n = t.find.matches.len()
    View{width: Fill height: Fit flow: Down
        SolidView{width: Fill height: 50 flow: Right align: Align{x: 0.5 y: 0.5} spacing: 8 draw_bg.color: pt_bar
            RoundedView{width: 104 height: 38 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: pt_field border_size: 1.0 border_color: pt_field_line border_radius: 5.0}
                Label{padding: 0 text: pick(n == 0, pick(t.finding, "…", "0 of 0"), "" + (t.find.cur + 1) + " of " + n) draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
            }
            Outline{width: 38 height: 38 padding: 0 spacing: 0 text: "" icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("arrow-up") color: pt_ink2} on_click: || go_match(cur_tab(), cur_tab().find.cur - 1)}
            Outline{width: 38 height: 38 padding: 0 spacing: 0 text: "" icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("arrow-down") color: pt_ink2} on_click: || go_match(cur_tab(), cur_tab().find.cur + 1)}
            Outline{height: 38 margin: Inset{left: 4} text: "Done" on_click: || end_find(cur_tab())}
        }
        Line{}
    }
}
fn tool_btn(t, id, ic, label){
    let on = t.tool == id
    let compact = canvas_w() < 900
    Flat{height: 37 padding: pick(compact, Inset{left: 9 right: 9}, Inset{left: 12 right: 14}) spacing: pick(compact, 0, 9) text: pick(compact, "", label) icon_walk: Walk{width: 20 height: 20}
        draw_icon +: {svg: icon(ic) color: pick(on, pt_link, pt_icon)}
        draw_bg +: {color: pick(on, pt_tint, #x00000000) border_size: pick(on, 1.0, 0.0) border_color: pt_tint_line color_hover: pick(on, pt_tint, pt_hover)}
        draw_text +: {color: pick(on, pt_link, pt_ink2) color_hover: pick(on, pt_link, pt_ink) color_focus: pick(on, pt_link, pt_ink2)}
        on_click: || { let x = cur_tab() x.tool = id x.pending = nil render_toolrow() render_right() }}
}
fn comment_tools(t){
    View{width: Fill height: Fit flow: Down
        SolidView{width: Fill height: 61 flow: Right align: Align{y: 0.5} padding: Inset{left: 22 right: 22} spacing: pick(canvas_w() < 900, 8, 22) draw_bg.color: pt_bar
            tool_btn(t, "highlight", "highlight", "Highlight")
            tool_btn(t, "underline", "underline", "Underline")
            tool_btn(t, "strike", "strike", "Strike out")
            tool_btn(t, "note", "note", "Note")
            tool_btn(t, "textbox", "textbox", "Text box")
            View{width: 40 height: 1}
            View{width: Fit height: Fit flow: Right spacing: 12
                for m in MARKS { mark_dot(t, m) }
            }
        }
        Line{}
    }
}
fn mark_dot(t, m){
    let on = t.color == m
    GestureView{width: 30 height: 30 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Hand on_tap: |x, y| { let c = cur_tab() c.color = m render_toolrow() }
        RoundedView{width: 30 height: 30 align: Align{x: 0.5 y: 0.5} show_bg: true
            draw_bg +: {color: #x00000000 border_size: pick(on, 2.0, 0.0) border_color: pt_accent border_radius: 15.0}
            RoundedView{width: 19 height: 19 show_bg: true draw_bg +: {color: mark_color(m) border_radius: 9.5}}
        }
    }
}
fn form_banner(t){
    View{width: Fill height: Fit flow: Down
        SolidView{width: Fill height: 48 flow: Right align: Align{y: 0.5} padding: Inset{left: 22 right: 22} spacing: 12 draw_bg.color: pt_select
            RoundedView{width: 22 height: 22 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: pt_accent border_radius: 11.0}
                Label{padding: 0 text: "i" draw_text +: {color: #xffffff text_style: theme.font_bold{font_size: 11}}}
            }
            Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: form_summary(t) draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
            if t.place != nil { Outline{height: 30 text: "Cancel" on_click: || { let x = cur_tab() x.place = nil render_toolrow() render_right() }} }
            if t.place == nil && t.fields != nil && t.fields.len() > 0 {
                Label{padding: 0 text: "Highlight fields" draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
                Toggle{text: "" active: t.show_fields on_click: |active| { let x = cur_tab() x.show_fields = active render_canvas() }
                    draw_bg +: {size: 22.0 border_size: 0.0 border_radius: 5.0 color: pt_field_line color_hover: pt_field_line color_active: pt_accent color_focus: pt_field_line
                        mark_color: #xffffff mark_color_hover: #xffffff mark_color_active: #xffffff mark_color_active_hover: #xffffff}}
            }
        }
        Line{}
    }
}
fn pages_actions(t){
    let n = chosen(t).len()
    let hint = "Drag pages to reorder"
    if t.drag != nil { hint = "Drop to move page " + t.drag.page }
    View{width: Fill height: Fit flow: Down
        SolidView{width: Fill height: 52 flow: Right align: Align{y: 0.5} padding: Inset{left: 26 right: 26} spacing: 14 draw_bg.color: pt_bar
            Label{padding: 0 width: 110 text: pick(n == 0, "None selected", "" + n + " selected") draw_text +: {color: pick(n == 0, pt_muted, pt_link) text_style: theme.font_bold{font_size: 12}}}
            Flat{text: "Rotate left" draw_icon +: {svg: icon("rotate-left")} on_click: || rotate(cur_tab(), -90)}
            Flat{text: "Rotate right" draw_icon +: {svg: icon("rotate-right")} on_click: || rotate(cur_tab(), 90)}
            SolidView{width: 1 height: 24 draw_bg.color: pt_line}
            Flat{text: "Delete" draw_icon +: {svg: icon("trash")} on_click: || delete_pages(cur_tab())}
            Flat{text: "Extract" draw_icon +: {svg: icon("extract")} on_click: || extract_pages(cur_tab())}
            Flat{text: "Insert from file" draw_icon +: {svg: icon("insert")} on_click: || { let x = cur_tab() x.inserting = !x.inserting render_toolrow() }}
            Gap{}
            // In a narrow window the hint gives the buttons its room.
            if canvas_w() >= 1000 || t.drag != nil {
                Label{padding: 0 text: hint draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12}}}
            }
        }
        if t.inserting { insert_strip(t) }
        Line{}
    }
}
fn insert_strip(t){
    let ch = chosen(t)
    let after = "the last page"
    if ch.len() > 0 { after = "page " + ch[ch.len() - 1] }
    View{width: Fill height: Fit flow: Down
        Line{draw_bg.color: pt_line_soft}
        SolidView{width: Fill height: Fit flow: Flow.Right{wrap: true} align: Align{y: 0.5} padding: Inset{left: 26 right: 26 top: 8 bottom: 8} spacing: 8 draw_bg.color: pt_bar
            Label{padding: 0 text: "Insert after " + after + ":" draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
            for d in st.docs {
                if d.name != t.name && d.error == "" && !d.locked {
                    Outline{height: 30 text: shown_name(d.title) draw_icon +: {svg: icon("file-pdf")} icon_walk: Walk{width: 15 height: 15} on_click: || insert_file(cur_tab(), d)}
                }
            }
            if st.docs.len() < 2 { Label{padding: 0 text: "Open another PDF first: it appears here." draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12}}} }
        }
    }
}

// The canvas: the run of pages, each the engine's render, with what the
// mode puts over it.
fn canvas_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" || st.blank { return View{width: 10 height: 1} }
    View{width: Fit height: Fit flow: Down spacing: PAGE_GAP align: Align{x: 0.5}
        for i in run_end(t) - t.anchor + 1 { page_view(t, t.anchor + i) }
        if run_end(t) < t.pages {
            View{width: Fit height: Fit padding: Inset{top: 8}
                Outline{text: "Continue with page " + (run_end(t) + 1) icon_walk: Walk{width: 16 height: 16} draw_icon +: {svg: icon("arrow-down")} on_click: || go_page(cur_tab(), run_end(cur_tab()) + 1)}
            }
        }
    }
}
fn page_view(t, p){
    let box = page_box(t, p)
    let k = t.zoom
    let src = page_src(t, p)
    let failed = optional(t.failed, "p" + p, nil) != nil && src == nil
    RectShadowView{width: box[0] height: box[1] flow: Overlay
        draw_bg +: {color: #xffffff shadow_color: pt_shadow shadow_radius: 7.0 shadow_offset: vec2(0.0, 1.5)}
        if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
        if src == nil {
            View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 10
                if !failed { LoadingSpinner{width: 26 height: 26} }
                Label{padding: 0 text: pick(failed, "Couldn't draw page " + p, "Rendering page " + p + "…") draw_text +: {color: #x8a8c90 text_style: theme.font_regular{font_size: 11.5}}}
            }
        }
        if t.find != nil { for i in page_matches(t, p) { for r in t.find.matches[i].rects { hit_box(r, k, i == t.find.cur) } } }
        if t.mode == "comment" { comment_marks(t, p, k) }
        if t.mode == "fill" && t.show_fields && t.fields != nil { for f in t.fields { if f.page == p { field_box(t, f, k) } } }
        GestureView{width: Fill height: Fill cursor: pick(t.mode == "read", MouseCursor.Default, MouseCursor.Hand)
            on_tap: |x, y| page_tap(cur_tab(), p, x / k, y / k)
            on_double_tap: |x, y| page_double_tap(cur_tab(), p, x / k, y / k)}
        if t.mode == "edit" && t.edit != nil && t.edit.page == p { edit_box(t, k) }
    }
}
fn hit_box(r, k, on){
    RoundedView{margin: Inset{left: r[0] * k - 1 top: r[1] * k - 1} width: r[2] * k + 2 height: r[3] * k + 2 show_bg: true
        draw_bg +: {color: pick(on, pt_hit_on, pt_hit) border_size: pick(on, 1.5, 0.0) border_color: #xf0a020 border_radius: 2.0}}
}
fn comment_marks(t, p, k){
    View{width: Fill height: Fill flow: Overlay
        if t.comments != nil {
            for c in t.comments {
                if c.page == p && c.id == t.thread {
                    for r in optional(c, "rects", []) {
                        RoundedView{margin: Inset{left: r[0] * k - 3 top: r[1] * k - 3} width: r[2] * k + 6 height: r[3] * k + 6 show_bg: true
                            draw_bg +: {color: #x00000000 border_size: 1.5 border_color: pt_accent border_radius: 3.0}}
                    }
                }
            }
        }
        if t.pending != nil && t.pending.page == p {
            RoundedView{margin: Inset{left: t.pending.at[0] * k - 13 top: t.pending.at[1] * k - 13} width: 26 height: 26 align: Align{x: 0.5 y: 0.5} show_bg: true
                draw_bg +: {color: #xf5c518 border_size: 1.0 border_color: #xc79a00 border_radius: 4.0}
                Ico{width: 16 height: 16 draw_svg +: {svg: icon("note") color: #x5a4600}}
            }
        }
    }
}
fn field_box(t, f, k){
    let r = f.rect
    let on = t.field == f.name
    let need = optional(f, "required", false) && field_empty(f)
    RoundedView{margin: Inset{left: r[0] * k top: r[1] * k} width: r[2] * k height: r[3] * k show_bg: true
        draw_bg +: {color: pick(need, #xe5534f12, pt_field_box) border_size: pick(on, 2.0, 1.0) border_color: pick(need, #xe5534f, pick(on, #x116cdc, #x7fa6dd)) border_radius: 2.0}}
}
// The editor is at least the paragraph's box, and grows down to hold its
// text: the app's sans is wider than most PDF faces, so it wraps into more
// lines (the line count is estimated from an average glyph width).
fn edit_height(e, k){
    let em = max(8, e.size * k * 0.75) * 1.32
    let inner = max(40, e.box[2] * k)
    let lines = ceil(e.draft.len() * em * 0.56 / inner) + e.draft.split("\n").len() - 1
    max(e.box[3] * k + 16, lines * em * 1.3 + 22)
}
fn edit_box(t, k){
    let e = t.edit
    let b = e.box
    View{margin: Inset{left: b[0] * k - 8 top: b[1] * k - 8} width: b[2] * k + 16 height: edit_height(e, k) flow: Overlay
        RoundedView{width: Fill height: Fill show_bg: true draw_bg +: {color: #xffffff border_size: 1.5 border_color: #x2171ef border_radius: 0.0}}
        TextInput{width: Fill height: Fill margin: 6 padding: 2 is_multiline: true text: e.draft
            on_change: |text| { let x = cur_tab() if x != nil && x.edit != nil { x.edit.draft = text } }
            draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xffffff
                border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000
                border_size: 0.0}
            draw_text +: {color: #x111111 color_hover: #x111111 color_focus: #x111111 color_empty: #x888888 text_style: theme.font_regular{font_size: max(8, e.size * k * 0.75) line_spacing: 1.3}}
            draw_selection.color: #x557dcc55}
        handle(0, 0) handle(0.5, 0) handle(1, 0) handle(0, 1) handle(0.5, 1) handle(1, 1)
    }
}
fn handle(ax, ay){
    View{width: Fill height: Fill align: Align{x: ax y: ay}
        RoundedView{width: 8 height: 8 show_bg: true draw_bg +: {color: #xffffff border_size: 1.5 border_color: #x2171ef border_radius: 1.0}}
    }
}

// The floating pill: page, previous, next, zoom, fit width, fit page.
fn pill_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" || t.mode == "combine" { return View{width: 1 height: 1} }
    RoundedShadowView{width: Fit height: 53 flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 4
        draw_bg +: {color: pt_pill border_size: 1.0 border_color: pt_line border_radius: 26.5 shadow_color: pt_shadow shadow_radius: 10.0 shadow_offset: vec2(0.0, 2.0)}
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("chevron-left") color: pt_icon} on_click: || step_page(cur_tab(), -1)}
        View{width: 78 height: Fit align: Align{x: 0.5}
            Label{padding: 0 text: "" + t.page + " / " + t.pages draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
        }
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("chevron-right") color: pt_icon} on_click: || step_page(cur_tab(), 1)}
        SolidView{width: 1 height: 28 margin: Inset{left: 12 right: 12} draw_bg.color: pt_line}
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("minus") color: pt_icon} on_click: || zoom_step(cur_tab(), -1)}
        View{width: 66 height: Fit align: Align{x: 0.5}
            Label{padding: 0 text: zoom_text(t) draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
        }
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("plus") color: pt_icon} on_click: || zoom_step(cur_tab(), 1)}
        if t.mode != "pages" {
            SolidView{width: 1 height: 28 margin: Inset{left: 12 right: 12} draw_bg.color: pt_line}
            IconBtn{icon_walk: Walk{width: 21 height: 21} draw_icon +: {svg: icon("fit-width") color: pick(t.fit == "width", pt_accent, pt_icon)} on_click: || { let x = cur_tab() set_zoom(x, fit_width_zoom(x), "width") }}
            IconBtn{margin: Inset{left: 6} icon_walk: Walk{width: 21 height: 21} draw_icon +: {svg: icon("fit-page") color: pick(t.fit == "page", pt_accent, pt_icon)} on_click: || { let x = cur_tab() set_zoom(x, fit_page_zoom(x), "page") }}
        }
    }
}

// Pages mode: every page as a large thumbnail; tap to choose, drag to move.
fn grid_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let cols = grid_cols(t)
    let first = window_start(t)
    let last = window_end(t)
    let rows = ceil((last - first + 1) / cols)
    View{width: Fill height: Fit flow: Down spacing: 26 align: Align{x: 0.5}
        if first > 1 { LinkBtn{text: "‹ Pages 1–" + (first - 1) on_click: || { let x = cur_tab() x.page = max(1, window_start(x) - 20) render_grid() pump() }} }
        for r in rows {
            View{width: Fit height: Fit flow: Right spacing: 30
                for c in cols {
                    if first + r * cols + c <= last { tile_view(t, first + r * cols + c) }
                }
            }
        }
        if last < t.pages { LinkBtn{text: "Pages " + (last + 1) + "–" + t.pages + " ›" on_click: || { let x = cur_tab() x.page = window_end(x) + 1 render_grid() pump() }} }
    }
}
fn tile_view(t, p){
    let s = page_pt(t, p)
    let w = tile_w(t)
    let h = round(w * s[1] / max(1, s[0]))
    let on = has(t.selected, p)
    let src = optional(t.grid, "p" + p, nil)
    let marker = t.drag != nil && t.drag.to == p && t.drag.page != p
    View{width: Fit height: Fit flow: Right spacing: 0
        if marker { drop_marker(h) }
        GestureView{width: w + 6 height: Fit flow: Down align: Align{x: 0.5} spacing: 8 cursor: MouseCursor.Hand
            on_tap: |x, y| toggle_select(cur_tab(), p)
            on_pan: |dx, dy, phase| tile_pan(cur_tab(), p, dx, dy, phase)
            RoundedView{width: w + 6 height: h + 6 padding: 2 flow: Overlay show_bg: true
                draw_bg +: {color: #x00000000 border_size: pick(on, 2.0, 0.0) border_color: pt_accent border_radius: 3.0}
                RectShadowView{width: w height: h margin: 1 draw_bg +: {color: #xffffff shadow_color: pt_shadow shadow_radius: 4.0 shadow_offset: vec2(0.0, 1.0)}
                    if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
                }
                if on {
                    View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0} padding: 10
                        RoundedView{width: 22 height: 22 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: pt_accent border_size: 1.5 border_color: #xffffff border_radius: 11.0}
                            Ico{width: 13 height: 13 draw_svg +: {svg: icon("check") color: #xffffff}}
                        }
                    }
                }
            }
            Label{padding: 0 text: "" + p draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12.5}}}
        }
    }
}
fn drop_marker(h){
    View{width: 16 height: h + 6 flow: Down align: Align{x: 0.5} margin: Inset{left: -23}
        SolidView{width: 9 height: 2 draw_bg.color: pt_accent}
        View{width: 2 height: Fill flow: Down spacing: 4
            for i in floor((h - 4) / 10) { SolidView{width: 2 height: 6 draw_bg.color: pt_accent} }
        }
        SolidView{width: 9 height: 2 draw_bg.color: pt_accent}
    }
}

// Combine: PDFs in order, each with its pages, into one new PDF.
fn combine_view(){
    let t = cur_tab()
    if t == nil || t.combine == nil { return View{width: Fill height: 1} }
    let c = t.combine
    let total = combine_total(t)
    RoundedShadowView{width: Fill max_width: 717 height: Fit flow: Down padding: Inset{left: 24 right: 24 top: 34 bottom: 24}
        draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 7.0 shadow_color: pt_shadow shadow_radius: 8.0 shadow_offset: vec2(0.0, 1.0)}
        View{width: Fit height: Fit padding: Inset{left: 16 bottom: 22} Label{padding: 0 text: "Combine files" draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 16}}}}
        RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 3.0}
            for i it in c.items {
                combine_row(t, i, it)
                Line{draw_bg.color: pt_line_soft}
            }
            GestureView{width: Fill height: 60 padding: Inset{left: 8 right: 8 top: 9 bottom: 9} cursor: MouseCursor.Hand on_tap: |x, y| { let x = cur_tab() x.combine.adding = !x.combine.adding render_combine() }
                dashed_box()
            }
            if c.adding { add_list(t) }
        }
        Line{margin: Inset{top: 18 bottom: 20}}
        Label{padding: 0 text: pick(total == nil, "Check the pages of each PDF", "One PDF of " + plural(total, "page", "pages")) draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 13}}}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} margin: Inset{top: 22} spacing: 18
            Label{padding: 0 text: "Name" draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
            Field{width: 310 height: 40 text: c.name empty_text: "Name of the new PDF" on_change: |text| { let x = cur_tab() x.combine.name = text }}
        }
        if c.error != "" {
            View{width: Fill height: Fit padding: Inset{top: 14} Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: c.error draw_text +: {color: pt_red text_style: theme.font_regular{font_size: 12}}}}
        }
        View{width: Fill height: Fit flow: Right margin: Inset{top: 14}
            Gap{}
            Primary{width: 140 height: 46 spacing: 10 text: pick(c.busy, "Combining…", "Combine") icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("combine")}
                draw_text +: {text_style: theme.font_regular{font_size: 13}}
                on_click: || do_combine(cur_tab())}
        }
    }
}
fn dashed_box(){
    View{width: Fill height: Fill flow: Overlay
        View{width: Fill height: Fill flow: Down
            View{width: Fill height: 1 flow: Right spacing: 4 for i in 120 { SolidView{width: 5 height: 1 draw_bg.color: pt_accent} }}
            View{width: Fill height: Fill flow: Right
                View{width: 1 height: Fill flow: Down spacing: 4 for i in 8 { SolidView{width: 1 height: 5 draw_bg.color: pt_accent} }}
                Gap{}
                View{width: 1 height: Fill flow: Down spacing: 4 for i in 8 { SolidView{width: 1 height: 5 draw_bg.color: pt_accent} }}
            }
            View{width: Fill height: 1 flow: Right spacing: 4 for i in 120 { SolidView{width: 5 height: 1 draw_bg.color: pt_accent} }}
        }
        View{width: Fill height: Fill flow: Right align: Align{x: 0.5 y: 0.5} spacing: 10
            Ico{width: 17 height: 17 draw_svg +: {svg: icon("plus") color: pt_link}}
            Label{padding: 0 text: "Add files" draw_text +: {color: pt_link text_style: theme.font_regular{font_size: 13}}}
        }
    }
}
fn add_list(t){
    View{width: Fill height: Fit flow: Down padding: Inset{left: 12 right: 12 bottom: 10} spacing: 2
        for d in st.docs {
            if !combine_has(t, d.name) && d.error == "" && !d.locked {
                GestureView{width: Fill height: 38 flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} spacing: 10 cursor: MouseCursor.Hand on_tap: |x, y| combine_add(cur_tab(), d)
                    Ico{width: 16 height: 16 draw_svg +: {svg: icon("file-pdf") color: pt_red}}
                    Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: shown_name(d.title) draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 12}}}
                    Label{padding: 0 text: doc_meta(d) draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
                }
            }
        }
        GestureView{width: Fill height: 38 flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} spacing: 10 cursor: MouseCursor.Hand on_tap: |x, y| open_from_device()
            Ico{width: 16 height: 16 draw_svg +: {svg: icon("folder") color: pt_link}}
            Label{padding: 0 text: "Open a PDF from this device" draw_text +: {color: pt_link text_style: theme.font_regular{font_size: 12}}}
        }
    }
}
fn combine_has(t, name){
    for it in t.combine.items { if it.name == name { return true } }
    false
}
fn combine_row(t, i, it){
    let src = optional(st.covers, it.name, nil)
    let n = item_count(it)
    View{width: Fill height: 113 flow: Right align: Align{y: 0.5} padding: Inset{left: 10 right: 18} spacing: 18
        GestureView{width: 26 height: 60 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Grab
            on_pan: |dx, dy, phase| { if phase == 2 { combine_move(cur_tab(), i, dy) } }
            Ico{width: 20 height: 20 draw_svg +: {svg: icon("grip") color: pt_icon}}
        }
        RoundedView{width: 70 height: 94 padding: 1 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: #xffffff border_size: 1.0 border_color: pt_thumb_line border_radius: 0.5}
            if src != nil { Image{width: Fill height: Fill fit: ImageFit.Smallest src: src} }
        }
        Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: shown_name(it.title) draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 13}}}
        RoundedView{width: 178 height: 42 flow: Overlay show_bg: true draw_bg +: {color: pt_field border_size: 1.0 border_color: pick(n == nil, pt_red, pt_field_line) border_radius: 4.0}
            TextInput{width: Fill height: Fill padding: Inset{left: 12 right: 76 top: 11 bottom: 10} text: it.range empty_text: "All"
                on_change: |text| { let x = cur_tab() x.combine.items[i].range = text start_timeout(0.6, || render_combine()) }
                draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000
                    border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000
                border_size: 0.0}
                draw_text +: {color: pt_ink2 color_hover: pt_ink2 color_focus: pt_ink color_empty: pt_ink2 color_empty_hover: pt_ink2 color_empty_focus: pt_faint text_style: theme.font_regular{font_size: 12}}
                draw_selection.color: #x557dcc55}
            View{width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5} padding: Inset{right: 12}
                Label{padding: 0 text: pick(n == nil, "(?)", "(" + plural(n, "page", "pages") + ")") draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5}}}
            }
        }
        IconBtn{icon_walk: Walk{width: 16 height: 16} draw_icon +: {svg: icon("close") color: pt_icon} on_click: || combine_remove(cur_tab(), i)}
    }
}

// The right panel in Comment mode: the threads.
fn thread_panel(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let count = 0
    if t.comments != nil { count = t.comments.len() }
    View{width: right_w(t) height: Fill flow: Down
        View{width: Fill height: 60 flow: Right align: Align{y: 0.5} padding: Inset{left: 20 right: 12} spacing: 10
            Label{padding: 0 text: "Comments" draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 14}}}
            RoundedView{width: Fit height: 24 align: Align{x: 0.5 y: 0.5} padding: Inset{left: 8 right: 8} show_bg: true draw_bg +: {color: pt_hover border_radius: 12.0}
                Label{padding: 0 text: "" + count draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 11.5}}}
            }
            Gap{}
            IconBtn{icon_walk: Walk{width: 20 height: 20} draw_icon +: {svg: icon("more") color: pt_icon} on_click: || { let x = cur_tab() x.head_menu = !x.head_menu render_right() }}
        }
        Line{draw_bg.color: pt_line_soft}
        if st.who.author == "" || st.naming { author_card() }
        if t.head_menu {
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} padding: Inset{left: 16 right: 16 top: 8 bottom: 8} spacing: 8
                if st.who.author != "" {
                    Outline{height: 30 text: "Comment as " + st.who.author + "…" on_click: || { let x = cur_tab() x.head_menu = false st.naming = true st.name_draft = st.who.author render_right() }}
                }
                if t.thread != nil { DangerBtn{height: 30 text: "Delete this comment" on_click: || delete_comment(cur_tab())} }
                Outline{height: 30 text: "Cancel" on_click: || { let x = cur_tab() x.head_menu = false render_right() }}
            }
        }
        ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 12 right: 12 top: 16 bottom: 24} spacing: 14
            if t.pending != nil { pending_card(t) }
            if t.comments == nil {
                View{width: Fill height: Fit padding: Inset{left: 8} Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: pick(t.comments_state == "" || t.comments_state == "loading", "Reading the comments…", t.comments_state) draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12}}}}
            }
            if t.comments != nil && t.comments.len() == 0 && t.pending == nil {
                View{width: Fill height: Fit padding: Inset{left: 8} Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: comment_hint(t) draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12 line_spacing: 1.4}}}}
            }
            if t.comments != nil { for c in t.comments { thread_card(t, c) } }
        }
    }
}
// Comments carry the person's name; asked once, kept in library.json.
fn author_card(){
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 14 bottom: 14} spacing: 8
        Label{padding: 0 text: "Comment as" draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
            Field{text: st.name_draft empty_text: "Your name" on_change: |text| { st.name_draft = text } on_return: |text| set_author(text)}
            Primary{height: 36 text: "Save" on_click: || set_author(st.name_draft)}
        }
        Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "Your comments and replies show this name." draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5}}}
    }
}
fn comment_hint(t){
    if t.tool == "note" || t.tool == "textbox" { return "No comments yet. Tap the page where the " + pick(t.tool == "note", "note", "text box") + " goes." }
    "No comments yet. Tap a line of text to " + pick(t.tool == "highlight", "highlight", pick(t.tool == "underline", "underline", "strike out")) + " it; tap twice for its paragraph."
}
fn avatar(name){
    RoundedView{width: 34 height: 34 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: avatar_color(name) border_radius: 17.0}
        Label{padding: 0 text: initials_of(name) draw_text +: {color: #x2a3140 text_style: theme.font_regular{font_size: 11.5}}}
    }
}
fn avatar_color(name){
    let n = ("" + name).len() % 4
    if n == 0 { return #xc6def0 }
    if n == 1 { return #xe9e0f6 }
    if n == 2 { return #xf4dadf }
    #xd9ecd9
}
fn message(author, date, text, indent){
    View{width: Fill height: Fit flow: Right padding: Inset{left: indent} spacing: 16
        avatar(author)
        View{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{top: 6}
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: pick(author == "", "Comment", author) draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 13}}}
                Label{padding: 0 text: comment_when(date, time_now()) draw_text +: {color: pt_faint text_style: theme.font_regular{font_size: 11.5}}}
            }
            if text != "" { Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: text draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12.5 line_spacing: 1.45}}} }
        }
    }
}
fn thread_card(t, c){
    let open = t.thread == c.id
    let st_label = status_label(optional(c, "status", ""))
    RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 7.0}
        GestureView{width: Fill height: 50 flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 14} spacing: 12 cursor: MouseCursor.Hand
            on_tap: |x, y| { let x = cur_tab() if x.thread == c.id { x.thread = nil render_right() render_canvas() } else { open_thread(x, c) } }
            RoundedView{width: 16 height: 16 show_bg: true draw_bg +: {color: mark_color(optional(c, "color", "")) border_radius: 8.0}}
            Label{padding: 0 text: "Page " + c.page draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12.5}}}
            Gap{}
            if !open { Label{padding: 0 text: comment_when(optional(c, "date", ""), time_now()) draw_text +: {color: pt_faint text_style: theme.font_regular{font_size: 11.5}}} }
            Ico{width: 18 height: 18 draw_svg +: {svg: icon(pick(open, "chevron-up", "chevron-down")) color: pt_icon}}
        }
        if !open {
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 18 bottom: 14} spacing: 16
                avatar(optional(c, "author", ""))
                Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: pick(optional(c, "author", "") == "", "Comment", optional(c, "author", "")) draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 13}}}
            }
        }
        if open {
            Line{draw_bg.color: pt_line_soft}
            View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 18 top: 14 bottom: 16} spacing: 18
                message(optional(c, "author", ""), optional(c, "date", ""), optional(c, "text", ""), 0)
                for r in optional(c, "replies", []) { message(optional(r, "author", ""), optional(r, "date", ""), optional(r, "text", ""), 50) }
                View{width: Fill height: Fit flow: Right padding: Inset{left: 50} spacing: 8
                    Flat{height: 28 padding: Inset{left: 10 right: 10} text: pick(st_label == "", "Set status", st_label)
                        draw_bg +: {color: pick(st_label == "", #x00000000, pt_green_tint) border_size: 1.0 border_color: pick(st_label == "", pt_line, pt_green) border_radius: 3.0}
                        draw_text +: {color: pick(st_label == "", pt_muted, pt_green) color_hover: pick(st_label == "", pt_ink, pt_green) text_style: theme.font_regular{font_size: 11.5}}
                        on_click: || { let x = cur_tab() x.status_menu = !x.status_menu render_right() }}
                }
                if t.status_menu {
                    View{width: Fill height: Fit flow: Flow.Right{wrap: true} padding: Inset{left: 50} spacing: 6
                        for s in ["accepted", "rejected", "completed", "cancelled", "none"] {
                            Outline{height: 28 padding: Inset{left: 10 right: 10} text: pick(s == "none", "None", status_label(s)) draw_text +: {text_style: theme.font_regular{font_size: 11.5}} on_click: || set_status(cur_tab(), s)}
                        }
                    }
                }
                reply_box(t, "Reply...", || post_reply(cur_tab()))
            }
        }
    }
}
fn reply_box(t, hint, post){
    RoundedView{width: Fill height: 66 flow: Right align: Align{y: 0.5} padding: Inset{left: 4 right: 12} show_bg: true
        draw_bg +: {color: pt_field border_size: 1.0 border_color: pt_field_line border_radius: 5.0}
        TextInput{width: Fill height: Fill padding: Inset{left: 10 right: 10 top: 14 bottom: 12} text: t.reply empty_text: hint
            on_change: |text| { let x = cur_tab() x.reply = text }
            on_return: |text| { let x = cur_tab() x.reply = text post() }
            draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000
                border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000
                border_size: 0.0}
            draw_text +: {color: pt_ink color_hover: pt_ink color_focus: pt_ink color_empty: pt_faint color_empty_hover: pt_faint color_empty_focus: pt_faint text_style: theme.font_regular{font_size: 12.5}}
            draw_selection.color: #x557dcc55}
        Primary{width: 62 height: 35 padding: 0 text: "Post" on_click: || post()}
    }
}
fn pending_card(t){
    RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 14 show_bg: true draw_bg +: {color: pt_card border_size: 1.5 border_color: pt_accent border_radius: 7.0}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 12
            RoundedView{width: 16 height: 16 show_bg: true draw_bg +: {color: mark_color(t.color) border_radius: 8.0}}
            Label{padding: 0 width: Fill text: "New " + pick(t.pending.type == "note", "note", "text box") + " on page " + t.pending.page draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12.5}}}
            IconBtn{width: 28 height: 28 icon_walk: Walk{width: 13 height: 13} draw_icon +: {svg: icon("close") color: pt_muted} on_click: || { let x = cur_tab() x.pending = nil render_right() render_canvas() }}
        }
        reply_box(t, pick(t.pending.type == "note", "Write the note...", "Write the text..."), || post_pending(cur_tab()))
    }
}

// The right panel in Fill & Sign and Edit.
fn side_panel(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    if t.mode == "edit" { return edit_panel(t) }
    fields_panel(t)
}
fn fields_panel(t){
    View{width: right_w(t) height: Fill flow: Down
        View{width: Fill height: 50 flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 12}
            Label{padding: 0 width: Fill text: "Fields" draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 13}}}
        }
        Line{draw_bg.color: pt_line_soft}
        View{width: Fill height: 46 flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 16}
            Label{padding: 0 width: 162 text: "Field name" draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
            Label{padding: 0 text: "Value" draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
        }
        Line{draw_bg.color: pt_line_soft}
        ScrollYView{width: Fill height: Fill flow: Down padding: Inset{top: 4 bottom: 8}
            if t.fields_state != "" {
                View{width: Fill height: Fit padding: Inset{left: 16 top: 10 right: 16} Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: pick(t.fields_state == "loading", "Reading the form…", t.fields_state) draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12}}}}
            }
            if t.fields != nil && t.fields.len() == 0 {
                View{width: Fill height: Fit padding: Inset{left: 16 top: 10 right: 16} Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "This PDF has no form fields." draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12}}}}
            }
            if t.fields != nil { for f in t.fields { field_row(t, f) } }
        }
        Line{draw_bg.color: pt_line_soft}
        View{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 28 bottom: 28} spacing: 16
            if t.place != nil { place_editor(t) }
            place_btn(t, "text", "text", "Add text")
            place_btn(t, "date", "calendar", "Add date")
            place_btn(t, "initials", "", "Add initials")
        }
    }
}
fn field_row(t, f){
    let on = t.field == f.name
    let need = optional(f, "required", false)
    let empty = field_empty(f)
    View{width: Fill height: Fit flow: Down
        GestureView{width: Fill height: 47 flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 16} cursor: MouseCursor.Hand on_tap: |x, y| select_field(cur_tab(), f)
            Label{padding: 0 width: 162 max_lines: 1 text_overflow: TextOverflow.Ellipsis text: optional(f, "name", "") + pick(need, " *", "") draw_text +: {color: pick(need && empty, pt_red, pt_ink2) text_style: theme.font_regular{font_size: 12.5}}}
            Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: pick(empty, "Empty", field_shown(f)) + pick(read_only(f), "  (read-only)", "") draw_text +: {color: pick(empty, pt_faint, pt_ink2) text_style: theme.font_regular{font_size: 12.5}}}
        }
        if on {
            View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 bottom: 12} spacing: 8
                field_editor(t, f)
                View{width: Fill height: Fit flow: Right spacing: 8
                    Primary{height: 32 text: "Apply" on_click: || fill_field(cur_tab())}
                    Outline{height: 32 text: "Cancel" on_click: || { let x = cur_tab() x.field = nil render_right() render_canvas() }}
                }
            }
        }
    }
}
fn field_editor(t, f){
    let kind = "" + optional(f, "type", "text")
    let options = optional(f, "options", [])
    if kind == "checkbox" || kind == "check" {
        return View{width: Fill height: Fit flow: Right spacing: 8
            Outline{height: 32 text: "Checked" draw_bg +: {color: pick(t.field_on, pt_tint, pt_card)} on_click: || { let x = cur_tab() x.field_on = true render_right() }}
            Outline{height: 32 text: "Not checked" draw_bg +: {color: pick(!t.field_on, pt_tint, pt_card)} on_click: || { let x = cur_tab() x.field_on = false render_right() }}
        }
    }
    if options.len() > 0 {
        return View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
            for o in options {
                Outline{height: 30 text: "" + optional(o, "label", optional(o, "value", "")) draw_bg +: {color: pick(t.field_text == "" + optional(o, "value", ""), pt_tint, pt_card)}
                    on_click: || { let x = cur_tab() x.field_text = "" + optional(o, "value", "") render_right() }}
            }
        }
    }
    Field{text: t.field_text empty_text: "Type the value" on_change: |text| { let x = cur_tab() x.field_text = text } on_return: |text| { let x = cur_tab() x.field_text = text fill_field(x) }}
}

fn place_btn(t, kind, ic, label){
    let on = t.place != nil && t.place.kind == kind
    View{width: Fill height: 43 flow: Overlay
        Outline{width: Fill height: 43 padding: Inset{left: 14 right: 14} spacing: 12 text: pick(kind == "initials", "", label) icon_walk: Walk{width: 20 height: 20}
            draw_icon +: {svg: pick(ic == "", nil, icon(pick(ic == "", "text", ic))) color: pt_ink2}
            draw_bg +: {color: pick(on, pt_tint, pt_card) border_color: pick(on, pt_accent, #x7fa6dd) border_size: 1.0}
            draw_text +: {text_style: theme.font_regular{font_size: 12.5}}
            align: Align{x: 0.0 y: 0.5}
            on_click: || start_place(cur_tab(), kind)}
        if kind == "initials" {
            View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14} spacing: 12
                if st.who.initials == "" { Ico{width: 20 height: 20 draw_svg +: {svg: icon("text") color: pt_ink2}} }
                if st.who.initials != "" { Label{padding: 0 text: st.who.initials draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 13.5}}} }
                Label{padding: 0 text: label draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 12.5}}}
            }
        }
    }
}
fn place_editor(t){
    if t.place.kind == "date" {
        return View{width: Fill height: Fit flow: Down spacing: 8
            Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "The engine writes today's date where you tap." draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
        }
    }
    View{width: Fill height: Fit flow: Down spacing: 8
        Label{padding: 0 text: pick(t.place.kind == "initials", "Your initials", "The text") draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
        Field{text: t.place_text empty_text: pick(t.place.kind == "initials", "Initials", "Text") on_change: |text| { let x = cur_tab() x.place_text = text }}
        Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: place_hint(t) draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5}}}
    }
}
fn edit_panel(t){
    View{width: right_w(t) height: Fill flow: Down padding: 14
        RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 6.0}
            View{width: Fill height: 54 flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 8}
                Label{padding: 0 width: Fill text: "Edit text" draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 12.5}}}
                if t.edit != nil { IconBtn{icon_walk: Walk{width: 15 height: 15} draw_icon +: {svg: icon("close") color: pt_icon} on_click: || cancel_edit(cur_tab())} }
            }
            Line{draw_bg.color: pt_line_soft}
            if t.edit == nil {
                View{width: Fill height: Fit padding: 16 Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: pick(t.can_edit, "Click a paragraph on the page to edit its text.", "This PDF doesn't allow editing.") draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12 line_spacing: 1.4}}}}
            }
            if t.edit != nil {
                View{width: Fill height: 52 flow: Right align: Align{y: 0.5} padding: Inset{left: 16}
                    Label{padding: 0 text: "Paragraph " + t.edit.n draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12.5}}}
                }
                Line{draw_bg.color: pt_line_soft}
                View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 18 bottom: 20} spacing: 10
                    Label{padding: 0 text: "Font" draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
                    RoundedView{width: Fill height: 40 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 12} show_bg: true draw_bg +: {color: pt_field border_size: 1.0 border_color: pt_field_line border_radius: 4.0}
                        Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: font_text(t.edit) draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
                    }
                    View{width: Fill height: Fit padding: Inset{top: 14} Label{padding: 0 text: "Alignment" draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}}
                    align_segments(t.edit)
                    View{width: Fill height: Fit padding: Inset{top: 14} Label{padding: 0 text: "Colour" draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}}
                    colour_box(t.edit)
                    if t.edit.colours { colour_list(t.edit) }
                    View{width: Fill height: Fit flow: Right margin: Inset{top: 22} spacing: 14
                        Primary{width: Fill height: 37 text: "Apply" on_click: || apply_edit(cur_tab())}
                        Outline{width: Fill height: 37 text: "Cancel" on_click: || cancel_edit(cur_tab())}
                    }
                }
            }
        }
    }
}

// Alignment: four segments (left, centre, right, justify), the paragraph's
// own (guess_align) chosen until another is tapped.
fn align_segments(e){
    RoundedView{width: Fill height: 40 flow: Right padding: 2 spacing: 2 show_bg: true draw_bg +: {color: pt_field border_size: 1.0 border_color: pt_field_line border_radius: 4.0}
        for a in ALIGNS {
            GestureView{width: Fill height: Fill cursor: MouseCursor.Hand on_tap: |x, y| set_align(cur_tab(), a)
                RoundedView{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} show_bg: true
                    draw_bg +: {color: pick(e.align == a, pt_select, pt_field) border_size: 1.0 border_color: pick(e.align == a, pt_accent, pt_field) border_radius: 3.0}
                    Ico{width: 20 height: 20 draw_svg +: {svg: icon("align-" + a) color: pick(e.align == a, pt_accent, pt_icon)}}
                }
            }
        }
    }
}
// A text colour as the Edit panel shows it (TEXT_COLOURS).
fn text_swatch(hex){
    if hex == "#4b4f54" { return #x4b4f54 }
    if hex == "#1a5fb4" { return #x1a5fb4 }
    if hex == "#c01c28" { return #xc01c28 }
    if hex == "#26a269" { return #x26a269 }
    if hex == "#e66100" { return #xe66100 }
    #x000000
}
// A colour's square; an empty one for the paragraph's own colour, which the
// engine doesn't report.
fn swatch(hex){
    if hex == nil {
        return RoundedView{width: 22 height: 22 show_bg: true draw_bg +: {color: pt_field border_size: 1.0 border_color: pt_thumb_line border_radius: 4.0}}
    }
    RoundedView{width: 22 height: 22 show_bg: true draw_bg +: {color: text_swatch(hex) border_size: 1.0 border_color: pt_thumb_line border_radius: 4.0}}
}
// Colour: the chosen colour in a box that opens the list below it (the
// runtime gives a script no pop-up menu).
fn colour_box(e){
    GestureView{width: Fill height: 40 cursor: MouseCursor.Hand on_tap: |x, y| toggle_colours(cur_tab())
        RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 9 right: 12} spacing: 12 show_bg: true draw_bg +: {color: pt_field border_size: 1.0 border_color: pick(e.colours, pt_accent, pt_field_line) border_radius: 4.0}
            swatch(e.color)
            Label{padding: 0 width: Fill text: colour_name(e.color) draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 12}}}
            Ico{width: 16 height: 16 draw_svg +: {svg: icon(pick(e.colours, "chevron-up", "chevron-down")) color: pt_icon}}
        }
    }
}
// The colours the box opens: one row of squares, the paragraph's own first
// (the panel is short in a small window; the box names the one chosen).
fn colour_chip(e, hex){
    GestureView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Hand on_tap: |x, y| set_colour(cur_tab(), hex)
        RoundedView{width: 36 height: 36 align: Align{x: 0.5 y: 0.5} show_bg: true
            draw_bg +: {color: pick(e.color == hex, pt_select, pt_field) border_size: 1.0 border_color: pick(e.color == hex, pt_accent, pt_field_line) border_radius: 4.0}
            swatch(hex)
        }
    }
}
fn colour_list(e){
    View{width: Fill height: Fit flow: Right spacing: 6
        colour_chip(e, nil)
        for c in TEXT_COLOURS { colour_chip(e, c.hex) }
    }
}

// What a tab shows when its PDF isn't open: opening, damaged, protected,
// no engine, too many open.
fn notice_view(){
    let t = cur_tab()
    if t == nil || t.state == "ready" { return View{width: 1 height: 1} }
    if t.state == "opening" {
        return View{width: Fit height: Fit flow: Down align: Align{x: 0.5} spacing: 12
            LoadingSpinner{width: 30 height: 30}
            Label{padding: 0 text: "Opening " + shown_name(t.title) + "…" draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12.5}}}
        }
    }
    let head = "Couldn't open this PDF"
    let detail = t.error
    let ic = "warning"
    if t.state == "protected" {
        head = "This PDF is protected with a password"
        detail = "PDF Tools doesn't open password-protected PDFs yet: OctoSense keeps passwords on its own sheets, and there isn't one for PDFs."
        ic = "lock"
    }
    if t.state == "missing" {
        head = engine_headline()
        detail = engine_detail()
    }
    if t.state == "full" {
        head = "PDF Tools has " + MAX_OPEN + " PDFs open"
        detail = "Close another PDF's tab, then open this one again."
    }
    RoundedShadowView{width: 460 height: Fit flow: Down padding: 28 spacing: 12
        draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 8.0 shadow_color: pt_shadow shadow_radius: 8.0 shadow_offset: vec2(0.0, 1.0)}
        Ico{width: 30 height: 30 draw_svg +: {svg: icon(ic) color: pick(ic == "lock", pt_icon, pt_red)}}
        Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: head draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 15}}}
        if t.state == "damaged" { Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "It may be damaged, or not a PDF at all. The engine said:" draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12 line_spacing: 1.4}}} }
        if detail != "" { Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: detail draw_text +: {color: pick(t.state == "damaged", pt_ink2, pt_muted) text_style: pick(t.state == "damaged", theme.font_code{font_size: 11}, theme.font_regular{font_size: 12 line_spacing: 1.4})}} }
        if t.state == "missing" && st.engine_note != "" { Code{text: st.engine_note} }
        View{width: Fill height: Fit flow: Right margin: Inset{top: 8} spacing: 10
            Outline{text: "Close this tab" on_click: || close_tab(cur_tab(), true)}
            if t.state == "full" { Primary{text: "Try again" on_click: || load_tab(cur_tab())} }
        }
    }
}

// Home: open a PDF from this device, and the recent ones.
fn home_cols(){ pick(st.width < 940, 2, 3) }
fn home_view(){
    let cols = home_cols()
    let days = days_now()
    View{width: Fill height: Fit flow: Down align: Align{x: 0.5} padding: Inset{top: 31 bottom: 48 left: 24 right: 24}
        Ico{width: 46 height: 54 draw_svg +: {svg: icon("pdf-hero") color: pt_accent}}
        View{width: Fit height: Fit padding: Inset{top: 13} Label{padding: 0 text: "PDF Tools" draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 28}}}}
        View{width: Fit height: Fit flow: Right align: Align{y: 0.5} margin: Inset{top: 22} spacing: 20
            Primary{height: 51 padding: Inset{left: 28 right: 34} spacing: 14 icon_walk: Walk{width: 24 height: 24} draw_icon +: {svg: icon("folder")}
                text: pick(st.importing, "Choosing a PDF…", "Open a PDF from this device")
                draw_text +: {text_style: theme.font_regular{font_size: 13.5}}
                on_click: || open_from_device()}
            if st.files_ok && import_limit() != "" { Label{padding: 0 text: import_limit() draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5}}} }
            if st.files_known && !st.files_ok { Label{padding: 0 text: "Not available here" draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11.5}}} }
        }
        if st.engine == "missing" || st.engine == "old" { home_alert(engine_headline(), engine_detail(), st.engine_note, false) }
        if st.alert != nil { home_alert(st.alert.head, st.alert.detail, st.alert.note, true) }
        if st.space_full { home_alert("PDF Tools' storage is full", "Remove a PDF to make room: page pictures and new PDFs can't be saved until there's space.", "", false) }
        if st.docs.len() == 0 {
            RoundedView{width: 520 height: Fit flow: Down align: Align{x: 0.5} margin: Inset{top: 40} padding: 28 spacing: 10 show_bg: true
                draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 6.0}
                Label{padding: 0 text: "No PDFs here yet" draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 15}}}
                Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} align: Align{x: 0.5} text: "Open a PDF from this device to read it, search it, comment on it, fill and sign it, or rearrange its pages. PDF Tools keeps its own copy." draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12 line_spacing: 1.45}}}
            }
        }
        if st.docs.len() > 0 {
            View{width: cols * 268 + (cols - 1) * 23 height: Fit flow: Down margin: Inset{top: 34} spacing: 13
                View{width: Fit height: Fit padding: Inset{left: 2 bottom: 3} Label{padding: 0 text: "Recent" draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 15}}}}
                for r in ceil(st.docs.len() / cols) {
                    View{width: Fill height: Fit flow: Right spacing: 23
                        for c in cols { if r * cols + c < st.docs.len() { doc_card(st.docs[r * cols + c], days) } }
                    }
                }
            }
        }
    }
}
fn home_alert(head, detail, code, dismiss){
    RoundedView{width: 640 height: Fit flow: Right margin: Inset{top: 22} padding: 18 spacing: 14 show_bg: true
        draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 6.0}
        Ico{width: 22 height: 22 draw_svg +: {svg: icon("warning") color: pt_red}}
        View{width: Fill height: Fit flow: Down spacing: 6
            Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: head draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 13}}}
            Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: detail draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12 line_spacing: 1.4}}}
            if code != "" { Code{text: code} }
        }
        if dismiss { Outline{height: 30 text: "OK" on_click: || { st.alert = nil render_home() }} }
    }
}
fn doc_card(d, days){
    let src = optional(st.covers, d.name, nil)
    GestureView{width: 268 height: Fit cursor: MouseCursor.Hand on_tap: |x, y| open_doc(d)
        RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 3.0}
            View{width: Fill height: 207 flow: Down align: Align{x: 0.5} padding: Inset{top: 19}
                RoundedView{width: 209 height: 188 padding: 1 show_bg: true draw_bg +: {color: #xffffff border_size: 1.0 border_color: pt_thumb_line border_radius: 0.0}
                    if src != nil { Image{width: 207 height: Fit fit: ImageFit.Horizontal src: src} }
                    if src == nil {
                        View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
                            Ico{width: 34 height: 34 draw_svg +: {svg: icon(pick(d.locked, "lock", pick(d.error != "", "warning", "file-pdf"))) color: #xb0b3b8}}
                        }
                    }
                }
            }
            Line{}
            View{width: Fill height: Fit flow: Down padding: Inset{left: 14 right: 12 top: 13 bottom: 12} spacing: 6
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
                    Ico{width: 18 height: 18 draw_svg +: {svg: icon("file-pdf") color: pt_red}}
                    Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: shown_name(d.title) draw_text +: {color: pt_ink text_style: theme.font_regular{font_size: 12}}}
                }
                View{width: Fit height: Fit padding: Inset{left: 28} Label{padding: 0 max_lines: 1 text_overflow: TextOverflow.Ellipsis text: doc_meta(d) draw_text +: {color: pick(d.error != "", pt_red, pt_muted) text_style: theme.font_regular{font_size: 11}}}}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 28}
                    Label{padding: 0 width: Fill text: opened_text(d, days) draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
                    IconBtn{width: 24 height: 22 icon_walk: Walk{width: 15 height: 15} draw_icon +: {svg: icon("trash") color: pt_faint} on_click: || ask_remove(d)}
                }
                if st.removing == d.name {
                    View{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{top: 6}
                        Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "Remove it from PDF Tools' storage?" draw_text +: {color: pt_ink2 text_style: theme.font_regular{font_size: 11.5}}}
                        View{width: Fill height: Fit flow: Right spacing: 8
                            DangerBtn{height: 28 text: "Remove" on_click: || remove_doc(d)}
                            Outline{height: 28 text: "Keep" on_click: || { st.removing = "" render_home() }}
                        }
                    }
                }
            }
        }
    }
}

// What the status line says of the storage: files.status's numbers, or,
// from a host that doesn't give them, the library's PDFs against the
// system ceiling; and how much of the bar that fills.
fn storage_text(){
    if st.used >= 0 && st.quota > 0 { return used_text(st.used, st.quota) }
    used_text(library_bytes(), QUOTA)
}
fn storage_share(){
    if st.used >= 0 && st.quota > 0 { return min(1, st.used / st.quota) }
    min(1, library_bytes() / QUOTA)
}
// The status line: whether the open PDF is saved, and the storage used.
fn status_view(){
    let t = cur_tab()
    let used = storage_text()
    if t == nil {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 20 right: 29} spacing: 20
            Label{padding: 0 text: used draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
            RoundedView{width: Fill max_width: 1110 height: 6 flow: Right show_bg: true draw_bg +: {color: pt_line_soft border_radius: 3.0}
                RoundedView{width: max(6, floor(storage_share() * min(1110, st.width - 230))) height: Fill show_bg: true draw_bg +: {color: pick(st.space_full, pt_red, pt_accent) border_radius: 3.0}}
            }
        }
    }
    let state = pick(t.saving, "Saving…", pick(t.edited, "Edited", "Saved"))
    if t.state != "ready" { state = "" }
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 33 right: 29} spacing: 11
        if state != "" { RoundedView{width: 12 height: 12 show_bg: true draw_bg +: {color: pick(t.edited || t.saving, pt_orange, pt_green) border_radius: 6.0}} }
        Label{padding: 0 text: state draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
        if st.space_full { View{width: Fit height: Fit padding: Inset{left: 12} Label{padding: 0 text: "Storage is full: remove a PDF to make room" draw_text +: {color: pt_red text_style: theme.font_regular{font_size: 11}}}} }
        Gap{}
        Label{padding: 0 text: used draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 11}}}
    }
}

// Closing a tab with unsaved changes.
fn dialog_view(){
    let t = nil
    if st.confirm != nil { t = tab_named(st.confirm) }
    if t == nil { return View{width: 1 height: 1} }
    View{width: Fill height: Fill flow: Overlay
        GestureView{width: Fill height: Fill on_tap: |x, y| {}
            SolidView{width: Fill height: Fill draw_bg.color: pt_scrim}
        }
        View{width: Fill height: Fill align: Align{x: 0.5 y: 0.4}
            RoundedShadowView{width: 440 height: Fit flow: Down padding: 26 spacing: 12
                draw_bg +: {color: pt_card border_size: 1.0 border_color: pt_line border_radius: 8.0 shadow_color: #x00000044 shadow_radius: 18.0 shadow_offset: vec2(0.0, 4.0)}
                Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "Save the changes to “" + shown_name(t.title) + "”?" draw_text +: {color: pt_ink text_style: theme.font_bold{font_size: 14}}}
                Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "Your changes are in PDF Tools' open copy. If you close without saving, they're lost." draw_text +: {color: pt_muted text_style: theme.font_regular{font_size: 12 line_spacing: 1.4}}}
                View{width: Fill height: Fit flow: Right margin: Inset{top: 10} spacing: 10
                    Outline{text: "Don't save" on_click: || close_tab(tab_named(st.confirm), true)}
                    Gap{}
                    Outline{text: "Cancel" on_click: || { st.confirm = nil render_dialog() }}
                    Primary{text: "Save" on_click: || save_and_close(tab_named(st.confirm))}
                }
            }
        }
    }
}

// ---- the window -------------------------------------------------------------

SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: pt_desk
    View{width: Fill height: Fill flow: Down
        tabs := SolidView{width: Fill height: TAB_H draw_bg.color: pt_tabs on_render: || { tabs_view() }}
        home := SolidView{width: Fill height: Fill flow: Down draw_bg.color: pt_home
            home_pane := ScrollYView{width: Fill height: Fill flow: Down on_render: || { home_view() }}
        }
        doc := View{visible: false width: Fill height: Fill flow: Down
            modebar := SolidView{width: Fill height: MODE_H draw_bg.color: pt_bar on_render: || { modebar_view() }}
            Line{}
            View{width: Fill height: Fill flow: Right
                rail := SolidView{width: RAIL_W height: Fill draw_bg.color: pt_rail on_render: || { rail_view() }}
                VLine{}
                panel_narrow := SolidView{visible: false width: PANEL_W height: Fill flow: Down draw_bg.color: pt_panel
                    panel_head := View{width: Fill height: Fit on_render: || { panel_head_view() }}
                    thumbs := ScrollYView{width: Fill height: Fill flow: Down on_render: || { thumbs_view() }}
                }
                panel_wide := SolidView{visible: false width: LIST_W height: Fill flow: Down draw_bg.color: pt_panel
                    list_head := View{width: Fill height: Fit on_render: || { list_head_view() }}
                    // A view whose on_render starts hidden stays hidden: each
                    // region shows and hides through a wrapper.
                    outline_box := View{visible: false width: Fill height: Fill
                        outline := ScrollYView{width: Fill height: Fill flow: Down on_render: || { outline_view() }}
                    }
                    notes_box := View{visible: false width: Fill height: Fill
                        notes := ScrollYView{width: Fill height: Fill flow: Down on_render: || { notes_view() }}
                    }
                    results_box := View{visible: false width: Fill height: Fill
                        results := ScrollYView{width: Fill height: Fill flow: Down on_render: || { results_view() }}
                    }
                }
                line_left := VLine{visible: false}
                View{width: Fill height: Fill flow: Down
                    toolrow := View{width: Fill height: Fit flow: Down on_render: || { toolrow_view() }}
                    View{width: Fill height: Fill flow: Overlay
                        canvas := ScrollXYView{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: PAGE_TOP bottom: 92 left: 24 right: 24} on_render: || { canvas_view() }}
                        grid_box := View{visible: false width: Fill height: Fill
                            grid := ScrollYView{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 14 bottom: 92} on_render: || { grid_view() }}
                        }
                        combine_box := View{visible: false width: Fill height: Fill
                            combine := ScrollYView{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: 42 bottom: 40 left: 24 right: 24} on_render: || { combine_view() }}
                        }
                        notice_box := View{visible: false width: Fill height: Fill
                            notice := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.4} padding: 24 on_render: || { notice_view() }}
                        }
                        pill := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0} padding: Inset{bottom: 12} on_render: || { pill_view() }}
                    }
                }
                line_right := VLine{visible: false}
                // Each right panel is as wide as its content says (right_w).
                right_thread_box := View{visible: false width: Fit height: Fill
                    right_thread := SolidView{width: Fit height: Fill flow: Down draw_bg.color: pt_panel on_render: || { thread_panel() }}
                }
                right_side_box := View{visible: false width: Fit height: Fill
                    right_side := SolidView{width: Fit height: Fill flow: Down draw_bg.color: pt_panel on_render: || { side_panel() }}
                }
            }
        }
        Line{}
        status := SolidView{width: Fill height: STATUS_H draw_bg.color: pt_status on_render: || { status_view() }}
    }
    banner := View{visible: false width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0} padding: Inset{left: 16 right: 16 bottom: 84}
        RoundedView{width: Fill max_width: 560 height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 6 top: 6 bottom: 6}
            new_batch: true show_bg: true draw_bg +: {color: #x1c1c1eee border_radius: 10.0}
            banner_text := Label{padding: 0 width: Fill padding: 0 flow: Flow.Right{wrap: true} text: "" draw_text +: {color: #xffffff text_style: theme.font_regular{font_size: 12 line_spacing: 1.35}}}
            ButtonFlat{height: 40 padding: Inset{left: 12 right: 12} text: "OK" on_click: || note("")
                draw_bg +: {color: #x00000000 color_focus: #x00000000 color_hover: #xffffff22 color_down: #xffffff33 border_size: 0.0}
                draw_text +: {color: #x64d2ff color_focus: #x64d2ff color_hover: #x64d2ff color_down: #x64d2ff text_style: theme.font_bold{font_size: 12}}}
        }
    }
    dialog_box := View{visible: false width: Fill height: Fill
        dialog := View{width: Fill height: Fill flow: Overlay on_render: || { dialog_view() }}
    }
}
