// BEGIN shared app interface
// Shared system-app interface. Run tools/sync-app-interface.py after editing.
// Bundles carry this prelude so they work in the contained standalone host too.
// Resolve the current theme after a host restyle, not a retained prelude alias.
let theme = mod.theme
// A desktop shell's style sheet says `ui_pointer = true`: the app gets pointer
// metrics and the Mac layouts (13-point text, 28-point controls, a sidebar and
// a toolbar). Anything else, a phone or a bare host, keeps the touch metrics.
let ui_desk = try { theme.ui_pointer == true } catch { false }
// A Mac's window has no title bar over an app that says so to the shell
// (crates/shell/src/clients.rs, unified_chrome): the app draws to the window's top
// edge, its toolbar is 52 points tall, and the lights sit over the leading 84 points
// of the toolbar, or over the top of a sidebar. Other desktops keep a title bar.
let ui_unified = ui_desk && try { theme.ui_unified == true } catch { false }
fn ui_by(touch, desk){ if ui_desk { desk } else { touch } }
let ui_ink = theme.color_text
let ui_page = theme.color_bg_app
let ui_light = dot(ui_ink, #x36b61200) < 0.5
let ui_surface = if ui_light { #xffffff } else { mix(ui_page, ui_ink, ui_by(0.06, 0.07)) }
let ui_field = if ui_desk && ui_light { #xffffff } else { mix(ui_page, ui_ink, ui_by(0.075, 0.07)) }
let ui_hover = mix(ui_page, ui_ink, ui_by(0.12, 0.07))
let ui_border = mix(ui_page, ui_ink, ui_by(0.22, 0.14))
let ui_muted = mix(ui_ink, ui_page, ui_by(0.24, 0.26))
// The Mac's system colours where the page is a Mac's, near white or near black;
// a retro style's mid-gray page keeps text that is mostly ink.
let ui_lum = dot(ui_page, #x36b61200)
let ui_mac = ui_desk && (ui_lum > 0.86 || ui_lum < 0.25)
let ui_link = if ui_mac { if ui_light { #x0060c0 } else { #x6cb8ff } } else { mix(ui_ink, #x356bce, 0.25) }
let ui_primary = ui_by(#x285cd6, #x0071e3)
let ui_success = if ui_mac { if ui_light { #x1a7030 } else { #x30d158 } } else { mix(ui_ink, #x28a55b, 0.20) }
let ui_danger = if ui_mac { if ui_light { #xc70012 } else { #xffa097 } } else { mix(ui_ink, #xe13b53, 0.20) }
// The Mac's surfaces: a sidebar and a toolbar a shade off the page, a selection
// in the sidebar's own gray, a push button's face.
let ui_sidebar = mix(ui_page, ui_ink, 0.03)
let ui_bar = if ui_light { #xededf0 } else { #x303033 }
let ui_selected = mix(ui_page, ui_ink, 0.11)
let ui_button = if ui_light { #xffffff } else { mix(ui_page, ui_ink, 0.16) }
// What a list or a document sits on: white in the light; in the dark, darker than
// the window around it, as a Mac's content is.
let ui_content = if ui_mac { if ui_light { #xffffff } else { #x1e1e1e } } else { ui_surface }
// A selected row: the accent when it is the row the person is on, white text on it.
let ui_accent_row = if ui_light { #x0064d2 } else { #x0a60c8 }
// A Mac dims the window behind a sheet, more in the dark; the shell's own sheets
// and the native apps' dim as much.
let ui_sheet_dim = if ui_light { #x00000024 } else { #x00000052 }
// A touch size in the type scale; on the desktop, the Mac's size for that role
// (Makepad's font_size is three quarters of a point).
fn ui_fs(n){
    if !ui_desk { return n }
    if n <= 12 { return 8.25 }
    if n <= 13 { return 9 }
    if n <= 16 { return 9.75 }
    if n <= 18 { return 11.25 }
    if n <= 21 { return 12.75 }
    if n <= 24 { return 13.5 }
    if n <= 28 { return 16.5 }
    19.5
}
let ui_icons = {}
fn ui_icon(name){
    let handle = ui_icons[name]
    if handle == nil {
        handle = http_resource("{{assets}}/icons/ui-" + name + ".svg")
        ui_icons[name] = handle
    }
    handle
}
let UiButton = ButtonFlat{height: ui_by(44, 28) margin: 0 padding: Inset{left: ui_by(14, 12) right: ui_by(14, 12)} spacing: 6
    icon_walk: Walk{width: 15 height: 15}
    draw_bg +: {border_radius: ui_by(12.0, 3.0) border_size: ui_by(0.0, 1.0) border_color: ui_border
        color: ui_by(#x00000000, ui_button) color_hover: ui_by(ui_hover, mix(ui_button, ui_ink, 0.04)) color_down: ui_by(ui_field, mix(ui_button, ui_ink, 0.1)) color_focus: ui_by(ui_hover, ui_button)}
    draw_text +: {color: ui_by(ui_link, ui_ink) color_hover: ui_by(ui_link, ui_ink) color_down: ui_by(ui_link, ui_ink) color_focus: ui_by(ui_link, ui_ink)
        text_style: ui_by(theme.font_bold{font_size: 14}, theme.font_regular{font_size: 9.75})}
    draw_icon +: {color: ui_ink}
}
let UiPrimary = UiButton{
    draw_bg +: {border_size: 0.0 color: ui_primary color_hover: ui_by(#x3468df, #x006edb) color_down: ui_by(#x204cb8, #x0060c0) color_focus: ui_by(#x204cb8, ui_primary)}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}
    draw_icon +: {color: #xffffff}
}
let UiPill = UiButton{height: ui_by(44, 24) padding: Inset{left: ui_by(14, 10) right: ui_by(14, 10)}
    draw_bg +: {color: ui_by(ui_surface, #x00000000) border_size: 0.0 border_radius: ui_by(22.0, 3.0)}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink}}
let UiField = TextInput{width: Fill height: ui_by(48, 28) margin: 0 padding: Inset{left: ui_by(14, 8) right: ui_by(14, 8) top: ui_by(12, 6) bottom: ui_by(12, 6)}
    draw_bg +: {color: ui_field color_hover: ui_field color_focus: ui_field color_empty: ui_field
        border_color: ui_border border_color_hover: ui_by(ui_link, ui_border) border_color_focus: ui_link border_color_empty: ui_border border_radius: ui_by(12.0, 3.0)}
    draw_text +: {color: ui_ink color_hover: ui_ink color_focus: ui_ink color_empty: ui_muted color_empty_hover: ui_muted color_empty_focus: ui_muted text_style: theme.font_regular{font_size: ui_by(15, 9.75)}}
    draw_selection.color: #x557dcc55
}
let UiCard = RoundedView{width: Fill height: Fit flow: Down spacing: ui_by(12, 8) padding: ui_by(20, 14)
    show_bg: true draw_bg +: {color: ui_surface border_radius: ui_by(16.0, 5.0) border_size: ui_by(0.0, 1.0) border_color: ui_by(#x00000000, ui_border)}}
let UiCaption = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: ui_by(13, 8.25) line_spacing: 1.4}}}
let UiTitle = Label{padding: 0 flow: Flow.Right{wrap: true} width: Fill draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: ui_by(28, 16.5) line_spacing: 1.2}}}
// The Mac's parts. They are drawn on a desktop only; a phone keeps its pages.
// A shader's border_radius is half the corner it draws: 3 is a 6-point corner.
let UiSep = SolidView{width: Fill height: 1 draw_bg.color: ui_border}
let UiVSep = SolidView{width: 1 height: Fill draw_bg.color: ui_border}
let UiGlyph = Svg{width: 16 height: 16 animating: false draw_svg +: {color: ui_muted}}
let UiTool = ButtonFlat{height: 28 margin: 0 padding: Inset{left: 8 right: 8} spacing: 5 icon_walk: Walk{width: 16 height: 16}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
    draw_icon +: {color: ui_ink}
}
let UiToolIcon = UiTool{width: 30 padding: 0 spacing: 0 text: ""}
// A tool whose click hides it or the pane it sits on: it comes back unwashed.
let UiPaneTool = UiToolIcon{reset_hover_on_click: true}
// The clear button inside a search field, shown while it holds text.
let UiSearchClear = UiPaneTool{visible: false width: 24 height: 24 icon_walk: Walk{width: 14 height: 14}
    draw_bg +: {color_hover: #x00000000 color_down: #x00000000}
    draw_icon +: {svg: ui_icon("search-clear") color: ui_muted}}
let UiToolbar = SolidView{width: Fill height: if ui_unified { 52 } else { 40 } flow: Right align: Align{y: 0.5} spacing: 4 padding: Inset{left: 12 right: 10} draw_bg.color: ui_bar}
// A toolbar that starts at the window's leading edge, with no sidebar beside it.
let UiWindowToolbar = UiToolbar{padding: Inset{left: if ui_unified { 84 } else { 12 } right: 10}}
let UiBarTitle = Label{clip_y: false padding: 0 text: "" max_lines: 1 draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 11.25}}}
let UiBarSub = Label{clip_y: false padding: 0 text: "" max_lines: 1 draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
let UiSidebar = SolidView{width: 208 height: Fill flow: Down padding: Inset{left: 8 right: 8 top: if ui_unified { 52 } else { 8 } bottom: 8} spacing: 1 draw_bg.color: ui_sidebar}
let UiSideHead = Label{padding: Inset{left: 8 top: 12 bottom: 4} text: "" draw_text +: {color: ui_muted text_style: theme.font_bold{font_size: 8.25}}}
let UiSideRow = ButtonFlat{width: Fill height: 28 margin: 0 padding: Inset{left: 8 right: 8} spacing: 7 align: Align{x: 0.0 y: 0.5}
    icon_walk: Walk{width: 16 height: 16} label_walk: Walk{width: Fill height: Fit}
    draw_bg +: {border_radius: 3.0 border_size: 0.0 color: #x00000000 color_hover: #x00000000 color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
    draw_icon +: {color: ui_link}
}
let UiSideRowOn = UiSideRow{draw_bg +: {color: ui_selected color_hover: ui_selected color_focus: ui_selected}}
let UiSeg = ButtonFlat{height: 24 margin: 0 padding: Inset{left: 12 right: 12}
    draw_bg +: {border_radius: 2.5 border_size: 0.0 color: #x00000000 color_hover: ui_hover color_down: ui_selected color_focus: #x00000000}
    draw_text +: {color: ui_ink color_hover: ui_ink color_down: ui_ink color_focus: ui_ink text_style: theme.font_regular{font_size: 9.75}}
}
let UiSegOn = UiSeg{draw_bg +: {color: ui_button color_hover: ui_button color_focus: ui_button border_size: 1.0 border_color: ui_border}}
let UiSegments = RoundedView{width: Fit height: 28 flow: Right align: Align{y: 0.5} spacing: 2 padding: 2 show_bg: true draw_bg +: {color: ui_selected border_radius: 3.5}}
let UiSearch = UiField{padding: Inset{left: 26 right: 8 top: 6 bottom: 6}}
let UiGroup = RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: ui_surface border_radius: 5.0 border_size: 1.0 border_color: ui_border}}
let UiFormRow = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 12 padding: Inset{left: 14 right: 14 top: 8 bottom: 8}}
let UiFormLabel = Label{clip_y: false padding: 0 width: Fill text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiListRow = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10 padding: Inset{left: 14 right: 14 top: 8 bottom: 8}}
// A two-line row of a list: a line in the body size, a line under it in the small.
let UiRowTitle = Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiRowNote = Label{clip_y: false padding: 0 width: Fill text: "" max_lines: 1 text_overflow: Ellipsis draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
// A form: the label right-aligned in a 110-point column to the left of its control.
let UiFormKey = Label{clip_y: false padding: 0 width: 110 text: "" align: Align{x: 1.0} draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let UiFormLine = View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8}
// A pop-up button: the choice, and the up-down mark at its trailing edge (an
// Overlay of this over UiPopupMark).
let UiPopup = UiButton{padding: Inset{left: 10 right: 28} align: Align{x: 0.0 y: 0.5}}
let UiPopupMark = View{width: Fit height: Fit padding: Inset{right: 8} new_batch: true
    Svg{width: 13 height: 13 animating: false draw_svg +: {svg: ui_icon("updown") color: ui_muted}}}
// A small count or state beside a name.
let UiBadge = RoundedView{width: Fit height: Fit padding: Inset{left: 6 right: 6 top: 2 bottom: 2} new_batch: true show_bg: true draw_bg +: {color: mix(ui_surface, ui_ink, 0.1) border_radius: 2.5}}
let UiBadgeText = Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 8.25}}}
// A status bar along a window's bottom: small text on the bar's colour.
let UiFootBar = SolidView{width: Fill height: 24 flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 12 right: 12} draw_bg.color: ui_bar}
// An empty list or an empty window: a glyph, a title, a line, and, under them, what
// to do about it. Centred in what the empty state fills.
let UiEmpty = View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 6 padding: 24
    glyph := Svg{width: 36 height: 36 margin: Inset{bottom: 4} animating: false draw_svg +: {color: ui_muted}}
    title := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 11.25}}}
    note := Label{clip_y: false padding: 0 text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
}
// A Mac's alert carries its app's icon, as the native apps' alerts do: 64 points
// on top in the alert below. The shell draws it in its style's frame (`ReviewAppIcon`,
// crates/shell/src/connected_review.rs; `app` is the bundle's id, "os.writer"); a host
// without the shell has none, and the alert keeps its words alone.
let UiAlertIcon = try { mod.widgets.ReviewAppIcon } catch { nil }
let ui_alert_icon = ui_mac && UiAlertIcon != nil
// A Mac's alert as macOS has drawn it since 11 (Files' Empty Trash): 260 points
// wide, the app's 64-point icon on top, the title and its words centred under it,
// then the buttons. Two sit side by side, each as wide as the other, the default
// on the right (UiAlertRow, each button `width: Fill`); three or more stand one
// over another, the default on top (UiAlertStack). A host with no app icon shows
// the words alone. Off a Mac an app keeps its own sheet.
let UiAlertPanel = RoundedShadowView{width: 260 height: Fit flow: Down align: Align{x: 0.5} padding: Inset{left: 16 right: 16 top: 20 bottom: 16} new_batch: true cursor: MouseCursor.Default
    draw_bg +: {color: ui_surface border_size: 1.0 border_color: ui_border border_radius: 10.0 shadow_color: #x00000040 shadow_radius: 18.0 shadow_offset: vec2(0.0, 4.0)}}
// A Label's margin counts twice: 10 and 6 points between icon, title and words.
let UiAlertTitle = Label{clip_y: false width: Fill padding: 0 margin: Inset{top: 5} align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75 line_spacing: 1.3}}}
let UiAlertNote = Label{clip_y: false width: Fill padding: 0 margin: Inset{top: 3} align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 8.25 line_spacing: 1.3}}}
let UiAlertRow = View{width: Fill height: Fit flow: Right spacing: 8 margin: Inset{top: 16}}
let UiAlertStack = View{width: Fill height: Fit flow: Down spacing: 8 margin: Inset{top: 16}}
// END shared app interface
// PDF Tools v2: read, find, review, fill and sign, organize, combine and edit
// the PDFs in this app's own storage, on the desktop's pdf engine (pdfcraft,
// ADR 0013). Rebuilt from the approved designs in apps/pdftools/design (BRIEF.md,
// the generated screens in source/, the pixel maps in map/) through OctoSense App
// Flow, then restyled to the Mac look in apps/AGENTS.md, with Preview as its
// model: the regions are the designs', their sizes and colours the shared ones.
//
// The engine: every call is host.request("pdf.<method>") on the contract in
// apps/pdftools/design/SERVICE.md, and nothing else. A PDF opens once per tab (pdf.open
// gives a handle); renders, finds, comments, fields, page changes and text
// edits name that handle, Undo and Redo use the engine's history, and Save
// writes the PDF back. This script never reads a PDF itself.
//
// Storage (64 MiB, the system ceiling): the PDFs in accounts/device/library/,
// the library index in accounts/device/library.json (title, pages, size, when
// it was last opened, its page and zoom, its cover), and the page renders the
// engine writes in its own cache (.cache/pages/, at most 16 MiB).
//
// Engine work runs on the shell's UI thread until #399 lands, so pages render
// one at a time at screen resolution and are kept, thumbnails fill in one by
// one, and a change re-renders only the pages on show.
//
// The canvas shows a run of pages starting at the page you went to (a
// thumbnail, the outline, a find result, ‹ and ›). The keys (app_key) and the Mac's
// menu bar (app_menus) reach what the toolbar does.

let LIBRARY = "accounts/device/library"
let INDEX = "accounts/device/library.json"
let CACHE = ".cache/pages"
// What an imported PDF is called: the import names its destination first.
let IMPORT_NAME = "Imported PDF"
// The app's storage: App Hub's system ceiling (no storage.max_bytes). The
// status line reads the real numbers from files.status; this is for a host
// that doesn't say.
let QUOTA = 67108864
// What the pdf service allows: 8 open documents, 2 to 16 files per merge,
// 512 pages named in one call.
let MAX_OPEN = 8
let MAX_MERGE = 16
let MAX_NAMED = 512
// Pages in the canvas's run, and how many render ahead of the current one.
let RUN = 8
let AHEAD = 2
// Render pixels per point at 100%: the designs' 100% is one PDF point per
// layout point, drawn at twice that for a high-density screen.
let DENSITY = 2
let THUMB_DPI = 24
let GRID_DPI = 48
let COVER_DPI = 48
// The thumbnails the Pages panel and the Pages grid list at a time.
let THUMB_WINDOW = 40
let ZOOMS = [0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0]
// The window's bars as measured on the approved designs (design/map/), in
// points: what canvas_size and combine_fits below are held to by the model
// tests. The Mac look's own measures are with the templates (BAR_H and the rest).
let TAB_H = 53
let MODE_H = 54
let RAIL_W = 84
let STATUS_H = 44
// Comment colours: the four dots of the Comment tool row.
let MARKS = ["yellow", "green", "blue", "pink"]
let MARK_HEX = {yellow: "#ffd84d" green: "#5cb85c" blue: "#2d7ff9" pink: "#f0609e"}
// The Edit panel's text colours (design 08), as pdf.edit_text takes them,
// and its alignments, as it names them (SERVICE.md "Edit").
let TEXT_COLOURS = [{name: "Black" hex: "#000000"}, {name: "Dark grey" hex: "#4b4f54"}, {name: "Blue" hex: "#1a5fb4"}, {name: "Red" hex: "#c01c28"}, {name: "Green" hex: "#26a269"}, {name: "Orange" hex: "#e66100"}]
let ALIGNS = ["left", "center", "right", "justify"]
// The sidebar's views (02-reading): Pages, Outline and Comments, chosen in the
// pop-up at its head. Search lives in the toolbar alone ("Search in document"): its
// results take the sidebar while a search runs, and give it back when the search ends.
let RAIL = [{id: "pages" icon: "page" label: "Pages"}, {id: "outline" icon: "outline" label: "Outline"}, {id: "comments" icon: "comment" label: "Comments"}]
let MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
let MONTH_NAMES = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]

// ---- the library's rules: pure functions, tested from Rust by
// crates/shell/src/pdftools_model_tests.rs (everything up to start_timeout) --

// A missing key reads as `fallback` (as News, Photos and Wasm Lab do it).
fn optional(it, key, fallback){
    let value = try { it[key] } catch { nil }
    if value == nil { return fallback }
    value
}
fn pick(c, a, b){ if c { return a } b }
fn plural(n, one, many){ if n == 1 { return "1 " + one } "" + n + " " + many }
fn is_pdf(name){ regex("\\.pdf$", "i").test(name) }
fn stem(name){ name.replace(regex("\\.pdf$", "i"), "") }
fn has(list, x){
    for v in list { if v == x { return true } }
    false
}
fn position(list, x){
    for i v in list { if v == x { return i } }
    -1
}
fn size_text(bytes){
    if bytes == nil { return "" }
    if bytes < 1024 { return plural(bytes, "byte", "bytes") }
    if bytes < 1048576 { return "" + round(bytes / 1024) + " KB" }
    "" + floor(bytes / 104857.6) / 10 + " MB"
}
// "49.4 MB available": what the app's storage still has room for, as Finder's
// status bar says of a disk. Under 1 MB it counts in kilobytes.
fn available_text(bytes, quota){
    size_text(max(0, quota - bytes)) + " available"
}
// What files.status says the app's storage holds and may hold, or nil when
// it doesn't say (no storage, or a shell from before it did).
fn usage_from(data){
    let used = optional(data, "used_bytes", nil)
    let quota = optional(data, "quota_bytes", nil)
    if used == nil || quota == nil || quota <= 0 { return nil }
    {used: used quota: quota}
}

// A library row: the file, and what the index kept about it (`known`, or
// nil): its pages and size, its title (otherwise its name), when it was last
// opened, the page and zoom it was left at, and its cover.
fn doc_from(name, known){
    let d = {name: name path: LIBRARY + "/" + name title: stem(name) pages: nil bytes: nil opened: 0 page: 1 zoom: nil cover: "" error: "" locked: false}
    if known != nil {
        d.pages = optional(known, "pages", nil)
        d.bytes = optional(known, "bytes", nil)
        d.title = optional(known, "title", d.title)
        d.opened = optional(known, "opened", 0)
        d.page = optional(known, "page", 1)
        d.zoom = optional(known, "zoom", nil)
        d.cover = optional(known, "cover", "")
    }
    d
}
// What the index keeps about a file: what the engine said (pages, size), and
// its title when that is not the file's own name.
fn index_entry(pages, bytes, title, name){
    pick(title == stem(name), {pages: pages bytes: bytes}, {pages: pages bytes: bytes title: title})
}
// The title of a PDF opened from the device: the chosen file's name as
// files.import reports it (`shown`), without ".pdf" and unlike every title
// in `taken`, else the name the file is stored under ("Imported PDF 2").
fn title_for_import(shown, name, taken){
    if shown == nil { return stem(name) }
    let t = ("" + shown).trim().replace(regex("\\.pdf$", "i"), "").trim()
    if t == "" { return stem(name) }
    if !has(taken, t) { return t }
    let n = 2
    loop {
        let candidate = t + " (" + n + ")"
        if !has(taken, candidate) { return candidate }
        n = n + 1
    }
}
// The title of a part the engine split from a PDF (`part`, named after the
// file: "Imported PDF-part2.pdf"): after the PDF's title ("Lease
// 2026-part2"), or nil when the PDF shows its file name, as the part then does.
fn title_for_part(title, name, part){
    if title == stem(name) { return nil }
    title + stem(part).replace(stem(name), "")
}
// The pages a range such as "1-4, 9" names in a PDF of `total` pages, in
// its order, or nil when it names no page or one the PDF doesn't have.
// Empty, or "all", is every page.
fn range_pages(text, total){
    let t = ("" + text).trim().replace(regex("[–—]", "g"), "-")
    let out = []
    if t == "" || regex("^all$", "i").test(t) {
        for i in total { out.push(i + 1) }
        return out
    }
    // No return inside the loop: an else-if chain returning from a loop
    // inside a for broke the script VM's stack ("pop_stack_value on empty
    // stack") on this runtime.
    let bad = false
    for part in t.split(",") {
        let p = part.trim()
        if p != "" {
            let ends = p.split("-")
            let a = ends[0].trim().to_f64()
            let b = a
            if ends.len() == 2 { b = ends[1].trim().to_f64() }
            if ends.len() > 2 || !(a >= 1) || !(b >= a) || b > total || floor(a) != a || floor(b) != b { bad = true }
            if !bad { for k in b - a + 1 { out.push(a + k) } }
        }
    }
    if bad || out.len() == 0 { return nil }
    out
}
// A range as the engine takes it: "" (every page) stays "", "1–4" becomes "1-4".
fn range_arg(text){ ("" + text).trim().replace(regex("[–—]", "g"), "-") }
// A find snippet ("… strong [[revenue]] …") as HTML, its match in bold.
fn snippet_html(s){
    let safe = ("" + s).replace(regex("&", "g"), "&amp;").replace(regex("<", "g"), "&lt;").replace(regex(">", "g"), "&gt;")
    safe.replace(regex("\\[\\[", "g"), "<b>").replace(regex("\\]\\]", "g"), "</b>")
}
// Two letters for an avatar: "Jun Park" → "JP" (the first letters of the
// first and last words).
fn first_letter(word){
    let m = regex("^(.)").exec(word)
    if m == nil { return "" }
    m.captures[1]
}
fn initials_of(name){
    let words = []
    for w in ("" + name).trim().split(" ") { if w != "" { words.push(w) } }
    if words.len() == 0 { return "?" }
    if words.len() == 1 { return first_letter(words[0]) }
    first_letter(words[0]) + first_letter(words[words.len() - 1])
}
// When something happened, as the designs say it: "today", "yesterday",
// "3 Oct", or the year for an older date.
fn day_text(t, now_t){
    if t == nil || t <= 0 { return "" }
    let a = local_time(t)
    let b = local_time(now_t)
    if a.year == b.year && a.month == b.month && a.day == b.day { return "today" }
    let y = local_time(now_t - 86400)
    if a.year == y.year && a.month == y.month && a.day == y.day { return "yesterday" }
    if a.year == b.year { return "" + a.day + " " + MONTHS[a.month - 1] }
    "" + a.day + " " + MONTHS[a.month - 1] + " " + a.year
}
fn two(n){ pick(n < 10, "0" + n, "" + n) }
// A comment's date as the service reports it, this device's local time
// ("2026-10-10T10:12"; SERVICE.md "Comments": it reads the date the file
// writes and converts it from its zone), as its parts, or nil when the file
// wrote something else (shown as it is). A PDF date the service passed on
// ("D:20261010101200") reads the same way.
fn comment_time(date){
    let s = "" + date
    let m = regex("^D?:?([0-9][0-9][0-9][0-9])-?([0-9][0-9])-?([0-9][0-9])[T ]?([0-9][0-9])?:?([0-9][0-9])?").exec(s)
    if m == nil { return nil }
    {year: m.captures[1].to_f64() month: m.captures[2].to_f64() day: m.captures[3].to_f64()
        hour: optional(m.captures, 4, "0").to_f64() minute: optional(m.captures, 5, "0").to_f64()}
}
// "3:45 PM".
fn clock_text(hour, minute){
    let h = hour % 12
    if h == 0 { h = 12 }
    "" + h + ":" + two(minute) + pick(hour < 12, " AM", " PM")
}
// "Today 3:45 PM", "Yesterday", "Oct 3", "Oct 3, 2025": a comment's date beside its author.
fn comment_when(date, now_t){
    let c = comment_time(date)
    if c == nil { return "" + date }
    let b = local_time(now_t)
    let y = local_time(now_t - 86400)
    if c.year == b.year && c.month == b.month && c.day == b.day { return "Today " + clock_text(c.hour, c.minute) }
    if c.year == y.year && c.month == y.month && c.day == y.day { return "Yesterday" }
    let day = MONTHS[c.month - 1] + " " + c.day
    if c.year == b.year { return day }
    day + ", " + c.year
}
// Today, as Fill & Sign's date: "October 10, 2026".
fn date_text(t){
    let a = local_time(t)
    MONTH_NAMES[a.month - 1] + " " + a.day + ", " + a.year
}

// How far apart the smallest and largest of `values` are.
fn spread(values){
    if values.len() == 0 { return 0 }
    let lo = values[0]
    let hi = values[0]
    for v in values {
        lo = min(lo, v)
        hi = max(hi, v)
    }
    hi - lo
}
// A paragraph's alignment as its lines show it, for the Edit panel's
// Alignment: `boxes` are its lines' [x, y, w, h] from pdf.lines, top to
// bottom. Lines that start together are flush left, or justified when every
// line but the last also ends together (three lines at least: two might
// just happen to); lines centred on one point are centred, and lines that
// end together flush right. The engine reports no alignment and sets an
// edited paragraph flush left unless told otherwise (SERVICE.md "Edit"), so
// an edit sends what this finds unless the person picks another.
fn guess_align(boxes){
    if boxes.len() < 2 { return "left" }
    let lefts = []
    let rights = []
    let centres = []
    for b in boxes {
        lefts.push(b[0])
        rights.push(b[0] + b[2])
        centres.push(b[0] + b[2] / 2)
    }
    if spread(lefts) <= 1.5 {
        let full = []
        for i r in rights { if i < rights.len() - 1 { full.push(r) } }
        if boxes.len() >= 3 && spread(full) <= 1.5 { return "justify" }
        return "left"
    }
    if spread(centres) <= 1.5 { return "center" }
    if spread(rights) <= 1.5 { return "right" }
    "left"
}
// pdf.edit_text's arguments for the paragraph edit `e`: its text and its
// alignment always (the engine sets a paragraph flush left when none is
// named), its colour only when the person chose one.
fn edit_args(doc, e){
    let args = {doc: doc page: e.page paragraph: e.n text: e.draft align: e.align}
    if e.color != nil { args.color = e.color }
    args
}
// (The Mac look's Combine pane keeps its foot in view and scrolls its list at
// any height, so the app no longer asks these two; the model tests still do.)
// The Combine card's list in points (design 06's measures): each PDF's row
// (113) and its line, the Add files row (60), and, while it is open, the
// list of PDFs to add (`adding_rows`, each 38 and a gap), in a box with a
// border.
fn combine_list_h(items, adding_rows){
    let h = items * 114 + 60 + 2
    if adding_rows > 0 { h = h + 10 + adding_rows * 40 }
    h
}
// Whether a Combine card with a list `list_h` tall fits an app `height`
// tall as designed: below the tab row, the mode bar and above the status
// line, within the card's margins (42 and 40), beside its own padding,
// title, the total, Name, a refusal (`error`) and the button (279, and 30).
// When it does not, the list scrolls inside the card and the rest stays.
fn combine_fits(list_h, height, error){
    list_h <= height - TAB_H - MODE_H - STATUS_H - 82 - 279 - pick(error, 30, 0)
}
// Whether the edit `e` changes anything: its text, alignment or colour.
fn edit_changes(e){ e.draft != e.text || e.align != e.align0 || e.color != nil }
// The left side a search gives back when it ends: what it showed before the
// results took it (a panel, or "" when it was folded away), else Pages.
fn panel_after_find(from){
    if from == "" || from == "pages" || from == "outline" || from == "comments" { return from }
    "pages"
}
// Whether the sidebar's view `id` is the one on: Pages in the Pages mode; otherwise
// the open panel's own view, so none while the panel shows search results.
fn rail_lit(id, mode, panel, open){
    if mode == "pages" { return id == "pages" }
    open && panel == id
}
// Read mode (the user: "there is no full screen read mode?"): which of the
// document's regions show. In Read mode, the pages alone with the bar at their foot
// that leaves it (`exit`). (`rail`: the sidebar's view pop-up, which goes with the panels.)
fn chrome_for(reading){
    {tabs: !reading modebar: !reading rail: !reading panels: !reading right: !reading toolrow: !reading status: !reading exit: reading}
}
// The canvas a document's pages get, in points: the window less the rail,
// the left panel (`left`, with its line; 0 when folded), the right panel
// (`right`, likewise), the tab row, the mode bar and the status line, as the
// designs measure them; in Read mode, the whole window. (canvas_box works out
// the rest for the Mac look's slimmer bars.)
fn canvas_size(width, height, reading, left, right){
    if reading { return [max(240, width), max(240, height)] }
    [max(240, width - RAIL_W - 1 - left - right), max(240, height - TAB_H - MODE_H - STATUS_H - 2)]
}
// The zoom a document takes when its canvas changes (entering or leaving
// Read mode): a fitted zoom fits the new canvas (`fit_w` and `fit_p` are the
// fits there), the automatic one is worked out again (`start`), and a zoom
// the person chose stays.
fn kept_zoom(zoom, zoom_auto, fit, fit_w, fit_p, start){
    if fit == "width" { return clamp(floor(fit_w * 100) / 100, 0.25, 4.0) }
    if fit == "page" { return clamp(floor(fit_p * 100) / 100, 0.25, 4.0) }
    if zoom_auto { return start }
    zoom
}
// A text colour's name in the Edit panel: "Its own color" until one is chosen.
fn colour_name(hex){
    if hex == nil { return "Its own color" }
    for c in TEXT_COLOURS { if c.hex == hex { return c.name } }
    hex
}
// A font's name for a person. The engine names a font as the PDF does: a
// subset with its six-letter tag ("ABCDEF+Menlo-Regular"), an unnamed one
// (a web browser's Type 3 fonts) as "", and its own Japanese fallback as
// "Shippori Mincho Type3".
fn font_label(font){
    let f = "" + font
    if f == "" { return "Unnamed font" }
    f.replace(regex("^[A-Z][A-Z][A-Z][A-Z][A-Z][A-Z]\\+"), "").replace(regex(" Type3$"), "").replace(regex("-", "g"), " ")
}
// The Edit panel's Font box: the paragraph's font and its size.
fn font_text(e){
    let size = pick(e.size > 0, "" + round(e.size * 10) / 10 + " pt", "")
    if size == "" { return font_label(e.font) }
    font_label(e.font) + "  ·  " + size
}
// What an edit is checked for (pdf.edit_check): its text, alignment and
// colour as they stand.
fn edit_key(e){ e.draft + "\n" + e.align + "\n" + pick(e.color == nil, "", e.color) }
// What an edit would change besides its words, from what pdf.edit_check
// answered (`check`; nil before it answers, or from an engine without the
// check): another font, text over its neighbours, text off the page.
fn edit_risks(check){
    let out = []
    if check == nil { return out }
    if !optional(check, "keeps_font", true) {
        out.push("Set in " + font_label(optional(check, "font", "")) + ": this paragraph's font can't show all of this text.")
    }
    let covers = optional(check, "covers", 0)
    if covers > 0 { out.push("Longer than its box: it runs into " + plural(covers, "line", "lines") + " of text nearby.") }
    if optional(check, "off_page", false) { out.push("Part of it falls off the page.") }
    out
}
// Apply says "Apply anyway" while the check has something to say.
fn apply_label(e){ pick(e.check_error == "" && edit_risks(e.check).len() > 0, "Apply anyway", "Apply") }
// How many pieces the PDF keeps the line of paragraph `n` in: the
// paragraphs (from pdf.lines) on its line (their boxes overlap by half their
// height) that follow on from it end to end (a gap under half the text's
// size), it included. A web browser prints a title whose glyphs span several
// fonts as one piece per font, and the engine reads each piece as a
// paragraph.
fn line_pieces(paragraphs, n){
    let own = nil
    for p in paragraphs { if p.n == n { own = p } }
    if own == nil { return 1 }
    let row = []
    for p in paragraphs {
        let top = max(p.box[1], own.box[1])
        let bottom = min(p.box[1] + p.box[3], own.box[1] + own.box[3])
        if bottom - top > min(p.box[3], own.box[3]) * 0.5 { row.push(p) }
    }
    let lo = own.box[0]
    let hi = own.box[0] + own.box[2]
    let taken = [own.n]
    let grew = true
    loop {
        if !grew { break }
        grew = false
        for p in row {
            let gap = max(optional(p, "size", 0), optional(own, "size", 0)) * 0.5
            if !has(taken, p.n) && p.box[0] <= hi + gap && p.box[0] + p.box[2] >= lo - gap {
                taken.push(p.n)
                lo = min(lo, p.box[0])
                hi = max(hi, p.box[0] + p.box[2])
                grew = true
            }
        }
    }
    taken.len()
}
// The note for a paragraph that is one piece of a line, or "".
fn pieces_note(pieces){
    if pieces < 2 { return "" }
    "The PDF stores this line in " + pieces + " pieces: only this one changes."
}

start_timeout(0.05, || boot())

// ---- appearance -----------------------------------------------------------
// The shared interface above decides light or dark (`ui_light`, from the
// theme the shell sets; a switch runs this file again) and gives this app its
// surfaces, text and accent: the Mac look in apps/AGENTS.md. A literal colour
// below is one a PDF's page demands: the paper stays white in both
// appearances, so what the app draws on it keeps its colour in both.
let assets = "{{assets}}"
let pt_clear = #x00000000
let pt_paper = #xffffff
let pt_paper_ink = #x6e6e73
let pt_paper_text = #x1d1d1f
let pt_shadow = if ui_light { #x00000029 } else { #x00000073 }
let pt_hit = #xffd84d6b
let pt_hit_on = #xffa62a8c
let pt_hit_line = #xf0a020
let pt_box = #x0071e314
let pt_box_line = #x0071e380
let pt_box_need = #xd7001512
let pt_box_red = #xd70015
let pt_on_page = #x0071e3
let pt_pin = #xf5c518
let pt_pin_line = #xc79a00
let pt_pin_ink = #x5a4600
let pt_select = #x557dcc55
// Besides the page: the tab strip behind the open tab, a tool with nothing to
// do just now, the dim behind an alert, and the Mac's orange for a warning.
let pt_tabs = mix(ui_bar, ui_ink, 0.06)
let pt_off = mix(ui_muted, ui_bar, 0.5)
let pt_scrim = #x0000004d
let pt_warn = if ui_light { #xf08a00 } else { #xff9f0a }
// A segmented control's chosen segment: in dark, lighter than the shared face,
// which barely stands off its track.
let pt_seg_on = if ui_light { ui_button } else { mix(ui_page, ui_ink, 0.28) }
// A comment's status on its push button: the Mac's green is 4.5:1 on the dark face only
// at its glyphs' cores, so the dark one is lighter (5.7:1 on 72,72,74).
let pt_status_ink = if ui_light { ui_success } else { #x6ce58a }
// The Mac look's measures, in points.
// The toolbar: in the unified window it is the window's top, and the lights sit at
// the start of it.
let BAR_H = if ui_unified { 52 } else { 40 }
let BAR_LEAD = if ui_unified { 84 } else { 8 }
let MODE_POP_W = 112
let TABS_H = 28
let ROW_H = 36
let FOOT_H = 22
let READ_BAR = 44
let THUMB_W = 104
let PANEL_W = 144
let LIST_W = 236
let RIGHT_W = 272
let THREAD_W = 296
let PAGE_TOP = 14
let PAGE_GAP = 12
let COVER_W = 128
let COVER_H = 190
let CARD_MIN = 164
let CARD_GAP = 16
let COMBINE_ROW = 52

// ---- templates ------------------------------------------------------------

// Type, in the Mac's sizes: body 9.75 (13 points), secondary 9, small 8.25.
let Body = Label{padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75}}}
let Bold = Label{padding: 0 text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75}}}
let Second = Label{padding: 0 text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9}}}
let Small = Label{padding: 0 text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25}}}
let One = Body{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis}
let Wrap = Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.3}}}
let Note = Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9 line_spacing: 1.3}}}
let Code = Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_muted text_style: theme.font_code{font_size: 8.25}}}
let SideHead = Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: "" draw_text +: {color: ui_muted text_style: theme.font_bold{font_size: 8.25}}}
let Gap = View{width: Fill height: 1}
let Ico = UiGlyph
// An icon button in a row, smaller than a toolbar's.
let IconBtn = UiToolIcon{width: 24 icon_walk: Walk{width: 8 height: 8} draw_icon +: {color: ui_muted}}
// PDF Tools is desktop only: its push buttons and fields keep the Mac's height
// in a bare host too (card-host).
let Outline = UiButton{height: 28 padding: Inset{left: 12 right: 12}}
let Primary = UiPrimary{height: 28 padding: Inset{left: 14 right: 14}}
let pt_danger = if ui_light { ui_danger } else { #xffa29b }
// On a chosen row the shared red falls just under 4.5:1 in light.
let pt_row_danger = if ui_light { #xb80011 } else { ui_danger }
let DangerBtn = Outline{reset_hover_on_click: true draw_text +: {color: pt_danger color_hover: pt_danger color_down: pt_danger color_focus: pt_danger}}
// A default that can't be pressed yet: the push face, its words dimmed (a script can't
// switch a button off, so the two sit side by side and one shows).
let PrimaryOff = Outline{enabled: false draw_bg +: {color_hover: ui_button color_down: ui_button color_focus: ui_button}
    draw_text +: {color: ui_muted color_hover: ui_muted color_down: ui_muted color_focus: ui_muted}}
// A sheet: it comes down from under the toolbar over a dimmed window.
let SheetDim = GestureView{width: Fill height: Fill on_tap: |x, y| {}
    SolidView{width: Fill height: Fill new_batch: true draw_bg.color: ui_sheet_dim}
}
let SheetPlace = View{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: BAR_H + 1 left: 16 right: 16}}
let SheetPanel = RoundedShadowView{height: Fit flow: Down spacing: 10 padding: Inset{left: 20 right: 20 top: 18 bottom: 16} new_batch: true cursor: MouseCursor.Default
    draw_bg +: {color: ui_surface border_size: 1.0 border_color: ui_border border_radius: 5.0 shadow_color: pt_shadow shadow_radius: 18.0 shadow_offset: vec2(0.0, 4.0)}}
let SheetTitle = Label{clip_y: false width: Fill padding: 0 flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 9.75 line_spacing: 1.3}}}
let SheetNote = Label{clip_y: false width: Fill padding: 0 flow: Flow.Right{wrap: true} text: "" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 8.25 line_spacing: 1.3}}}
let SheetButtons = View{width: Fill height: Fit flow: Right spacing: 8 align: Align{x: 1.0 y: 0.5} margin: Inset{top: 6}}
let LinkBtn = UiTool{draw_text +: {color: ui_link color_hover: ui_link color_down: ui_link color_focus: ui_link}}
let Field = UiField{height: 28}
// A field with no face of its own, on a face drawn around it.
let BareInput = TextInput{
    draw_bg +: {color: pt_clear color_hover: pt_clear color_focus: pt_clear color_empty: pt_clear
        border_color: pt_clear border_color_hover: pt_clear border_color_focus: pt_clear border_color_empty: pt_clear
        border_size: 0.0}
    draw_selection.color: pt_select
}
// Scroll views a press can drag, with the shell's own scrollers.
let ScrollY = ScrollYView{scroll_bars: ScrollBars{show_scroll_x: false show_scroll_y: true scroll_bar_y: ScrollBar{drag_scrolling: true}}}
let ScrollXY = ScrollXYView{scroll_bars: ScrollBars{show_scroll_x: true show_scroll_y: true scroll_bar_x: ScrollBar{drag_scrolling: true} scroll_bar_y: ScrollBar{drag_scrolling: true}}}
let SegOn = UiSegOn{draw_bg +: {color: pt_seg_on color_hover: pt_seg_on color_focus: pt_seg_on}}
// A find match: the page's own picture of that spot, tinted, so the highlight lies
// under the text as a marker's does. `image_pan` and `image_scale` choose the spot
// (fractions of the page); `on` is the current match, stronger and ringed.
let FindMark = Image{fit: ImageFit.Stretch
    draw_bg +: {
        tint_off: uniform(#xffec9e)
        tint_on: uniform(#xffc53d)
        ring_color: uniform(#xc98500)
        on: instance(0.0)
        pixel: fn(){
            let sdf = Sdf2d.viewport(self.pos * self.rect_size)
            sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, 2.0)
            let c = self.get_color()
            sdf.fill(vec4(c.rgb * mix(self.tint_off.rgb, self.tint_on.rgb, self.on), 1.0))
            sdf.box(0.5, 0.5, self.rect_size.x - 1.0, self.rect_size.y - 1.0, 1.75)
            sdf.stroke(vec4(self.ring_color.rgb, self.on), 1.0)
            return sdf.result
        }
    }
}
// The hairline box that holds a value in an inspector.
let ValueBox = RoundedView{width: Fill height: 28 flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} spacing: 6 show_bg: true
    draw_bg +: {color: ui_field border_size: 1.0 border_color: ui_border border_radius: 3.0}}

// ---- state ----------------------------------------------------------------
// Everything PDF Tools remembers is one object kept on `mod`. A switch
// between light and dark runs this file again to restyle it: the runtime
// keeps the `mod` entries this file made, but every `let` starts over (#440).
let st = try { mod.pdftools } catch { nil }
if st == nil {
    st = {
        booted: false
        screen: "home"        // home | doc
        docs: []              // the library, most recently opened first
        index: {}             // file name -> what library.json keeps
        tabs: []              // the open documents (new_tab)
        cur: -1               // the tab on show; -1 on Home
        engine: ""            // "" until the engine answers; ok | missing | old
        engine_note: ""       // the host's words when it isn't there
        files_known: false    // files.status answered
        files_ok: false       // this device copies a chosen file in
        max_import: 0
        used: -1              // what the app's storage holds (files.status); -1 until it says
        quota: 0              // and what it may hold
        storage_due: false    // a files.status question is on its way
        importing: false
        alert: nil            // {head detail note}: why something failed, on Home
        space_full: false     // the last write found no room
        width: pick(ui_unified, 1180, 1536)    // the app's size: on_app_resize (card-host sends none)
        height: pick(ui_unified, 740, 1024)
        busy: false           // a background render is out
        covers: {}            // file name -> image of its first page
        cover_tried: {}
        blank: false          // the canvas's first half of a jump (go_page)
        jump_n: 0
        confirm: nil          // the tab whose unsaved changes the closing question is about
        note_n: 0
        said: ""              // a desktop's note, in the status bar for a while
        resize_n: 0
        icons: {}             // icon name -> its handle, made once
        who: {author: "" initials: ""} // who comments and signs (library.json)
        naming: false         // the Comment as field is open
        name_draft: ""
        removing: ""          // the PDF whose removal Home asks about
        busy_at: 0            // when the background render went out
        heartbeat: nil        // the interval below, made once
        index_dirty: false    // library.json waits for the heartbeat
        screen_full: false    // the shell has the window in full screen for Read mode (on_app_fullscreen)
        home_at: -1           // the card the keys are on, on Home; -1 until they move
        insert_into: ""       // the tab a PDF chosen on this device goes into (Insert from File…)
        page_watch: nil       // the interval below, made once
        tile_tapped: 0        // the page tile clicked last, and when: a tile drawn again forgets
        tile_tapped_at: 0
        scroll_seen: -1       // the canvas's place when the page was last worked out
        files_out: false      // this device saves a copy where the person says (files.export)
        going: false          // Go to Page's sheet is up
        go_text: ""           // what its field holds
        go_bad: false         // what was typed there is no page of the PDF
        open_sheet: false     // a Mac's Open sheet: the PDFs in PDF Tools' storage (File > Open…)
        open_pick: ""         // the row picked on it
        open_for: ""          // the tab whose Combine the sheet adds to; "" opens a PDF
        combine_into: ""      // the tab whose Combine a PDF chosen on this device goes into
        recent_cleared: 0     // File > Open Recent > Clear Menu: PDFs opened before then aren't listed
        click_key: ""         // the row clicked last, and when: a list drawn again forgets a first click
        click_at: 0
    }
    mod.pdftools = st
}
// A sheet over the window. A GestureView answers a press that lands inside it whatever
// lies on top, so while one is up, and for a moment after (the press that closes it
// still comes up), the pages and the lists under it don't answer.
let pt_modal = st.confirm != nil || st.removing != "" || st.going || st.open_sheet
// A Mac's menu bar and the keys of its rows wait for a sheet while it's up. The moment
// after is for the press that closed it, and a key or a menu is never that press: a
// Command-W just after a double click opened a PDF closed the window, its Close Tab
// still off.
fn menus_wait(){
    if ui_unified { return st.confirm != nil || st.removing != "" || st.going || st.open_sheet }
    pt_modal
}
fn sync_modal(){
    if st.confirm != nil || st.removing != "" || st.going || st.open_sheet {
        pt_modal = true
        return
    }
    start_timeout(0.15, || {
        if st.confirm == nil && st.removing == "" && !st.going && !st.open_sheet { pt_modal = false }
    })
}
// The heartbeat and the page's watch (below), started again by every run of this file.
if st.heartbeat != nil { stop_timer(st.heartbeat) }
st.heartbeat = start_interval(2, || heartbeat())
if st.page_watch != nil { stop_timer(st.page_watch) }
st.page_watch = start_interval(0.25, || watch_page())

// ---- small helpers that need the state -----------------------------------

fn icon(name){
    let h = optional(st.icons, name, nil)
    if h == nil {
        h = http_resource(assets + "/icons/" + name + ".svg")
        st.icons[name] = h
    }
    h
}
fn cur_tab(){
    if st.screen != "doc" || st.cur < 0 || st.cur >= st.tabs.len() { return nil }
    st.tabs[st.cur]
}
fn showing_tab(t){
    let current = cur_tab()
    current != nil && t != nil && current.name == t.name && current.doc == t.doc
}
fn tab_named(name){
    for t in st.tabs { if t.name == name { return t } }
    nil
}
fn tab_index(t){
    for i x in st.tabs { if x.name == t.name { return i } }
    -1
}
fn doc_named(name){
    for d in st.docs { if d.name == name { return d } }
    nil
}
fn shown_name(title){ title + ".pdf" }
// A result said in the status bar belongs to the document and the mode it came from:
// a switch of tab or mode ends it.
fn unsay(){
    if !ui_desk || st.said == "" { return }
    st.note_n = st.note_n + 1
    st.said = ""
}
fn note(text){
    st.note_n = st.note_n + 1
    let n = st.note_n
    // A desktop says it in the window's status bar for a while, as a Mac app
    // mentions a result, with nothing to dismiss; a phone shows its banner.
    if ui_desk {
        st.said = text
        render_status()
        if text != "" { start_timeout(8, || { if n == st.note_n { st.said = "" render_status() } }) }
        return
    }
    ui.banner_text.set_text(text)
    ui.banner.set_visible(text != "")
    if text != "" { start_timeout(8, || { if n == st.note_n { ui.banner.set_visible(false) } }) }
}

// ---- the engine -------------------------------------------------------------

// One call to the pdf engine. `done` gets {is_ok data error}, always on a
// later turn: a refusal answers inside host.request itself, where only the
// first widget call of the callback lands.
fn engine(method, args, done){
    host.request("pdf." + method, args, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || done(answer))
    })
}
fn missing(error){
    let e = "" + error
    e.search("was not granted") >= 0 || e.search("no service answers") >= 0
}
// The engine is there but older than this contract: the shells refuse the
// v2 methods until the service lands.
fn outdated(error){ ("" + error).search("is not a method") >= 0 }
// True when `a` failed because the engine is not there for this app.
fn engine_gone(a){
    if a.is_ok { st.engine = "ok" return false }
    if missing(a.error) {
        st.engine = "missing"
        st.engine_note = "" + a.error
        return true
    }
    false
}
fn outdated_open(a){
    if a.is_ok || !outdated(a.error) { return false }
    st.engine = "old"
    st.engine_note = "" + a.error
    true
}
// An error without the "pdf.open: " the service may put first; then its
// stable code (SERVICE.md: not_found, damaged, protected, storage_full, …)
// and the words for a person after it.
fn err_text(e){ ("" + e).replace(regex("^pdf\\.[a-z_]+: "), "") }
fn err_code(e){
    let m = regex("^([a-z_]+): ").exec(err_text(e))
    if m == nil { return "" }
    m.captures[1]
}
fn err_words(e){
    let s = err_text(e)
    if err_code(e) == "" { return s }
    s.replace(regex("^[a-z_]+: "), "")
}
fn storage_full(e){
    let s = "" + e
    err_code(e) == "storage_full" || s.search("bytes left in this storage") >= 0 || s.search("app storage is full") >= 0 || s.search("too many files") >= 0
}
// Every engine write: a refusal for room shows until a write succeeds or a
// PDF is removed.
fn wrote(a){
    storage_later()
    if a.is_ok { st.space_full = false return }
    if storage_full(a.error) { st.space_full = true }
}
fn engine_headline(){
    if st.engine == "old" { return "PDF Tools Needs a Newer OctoSense" }
    if st.engine_note.search("was not granted") >= 0 { return "PDF Tools Can't Read PDFs Here" }
    "PDF Tools Can't Read PDFs on This Device"
}
fn engine_detail(){
    if st.engine == "old" { return "Reading, search, comments, forms and page changes need an update. Your PDFs stay safe in PDF Tools' storage." }
    if st.engine_note.search("was not granted") >= 0 { return "This OctoSense doesn't let PDF Tools open PDFs. Your PDFs stay safe in PDF Tools' storage." }
    // A desktop's OctoSense comes with the PDF engine; one without it is incomplete.
    if ui_desk { return "Reinstall OctoSense to read, search, comment, fill forms and change pages. Your PDFs stay safe in PDF Tools' storage." }
    "PDF Tools needs the OctoSense desktop to draw pages. Your PDFs stay safe in this app's storage."
}
// What went wrong with a call a person made, in words, for the banner.
fn action_failed(what, e){
    if missing(e) { return engine_detail() }
    if outdated(e) { return "This OctoSense can't " + what + " yet." }
    if storage_full(e) { return "There isn't room in PDF Tools' storage. Remove a PDF to make room." }
    let code = err_code(e)
    if code == "unknown_doc" { return "This PDF closed unexpectedly. Close its tab and open it again." }
    "Couldn't " + what + ": " + err_words(e)
}
fn save_problem_text(e){
    if missing(e) || outdated(e) || storage_full(e) || err_code(e) == "unknown_doc" { return action_failed("save", e) }
    let words = err_words(e)
    if words.search("last change was undone") >= 0 {
        return "The PDF couldn't be saved, and its last change was undone. Redo it, then try again."
    }
    if words.search("Permission denied") >= 0 || words.search("Operation not permitted") >= 0 {
        return "Can't save. Check storage permissions, then try again."
    }
    "Couldn't save this PDF. Try again."
}
fn newer_save_note(){ "Earlier changes were saved. Your newer changes aren't saved yet." }
fn draft_save_note(){ "Earlier changes were saved. Finish or discard the current edit." }

// ---- the library ----------------------------------------------------------

fn load_index(){
    if !fs.exists(INDEX) { return }
    let v = try { fs.read(INDEX).parse_json() } catch { nil }
    if v != nil && optional(v, "version", 0) == 1 {
        st.index = optional(v, "docs", {})
        let who = optional(v, "who", nil)
        if who != nil { st.who = {author: optional(who, "author", "") initials: optional(who, "initials", "")} }
        st.recent_cleared = optional(v, "recent_cleared", 0)
    }
}
fn save_index(){
    st.index_dirty = false
    try { fs.write(INDEX, {version: 1 docs: st.index who: st.who recent_cleared: st.recent_cleared}.to_json()) } catch { nil }
}
fn entry_of(d){
    let e = index_entry(d.pages, d.bytes, d.title, d.name)
    if d.opened > 0 { e.opened = d.opened }
    if d.page > 1 { e.page = d.page }
    if d.zoom != nil { e.zoom = d.zoom }
    if d.cover != "" { e.cover = d.cover }
    e
}
fn remember(d){
    st.index[d.name] = entry_of(d)
    // The heartbeat writes it (at most every 2 s), so a tap or a page turn
    // never waits on the disk: one handler has 64 ms of wall-clock time.
    st.index_dirty = true
}
fn forget(name){
    let kept = {}
    for k v in st.index { if k != name { kept[k] = v } }
    st.index = kept
    save_index()
    let covers = {}
    for k v in st.covers { if k != name { covers[k] = v } }
    st.covers = covers
    let tried = {}
    for k v in st.cover_tried { if k != name { tried[k] = v } }
    st.cover_tried = tried
}
fn scan_library(){
    let found = []
    if fs.exists(LIBRARY) {
        for name in fs.list(LIBRARY) {
            if is_pdf(name) {
                let d = doc_from(name, optional(st.index, name, nil))
                let old = doc_named(name)
                if old != nil {
                    d.error = old.error
                    d.locked = old.locked
                }
                found.push(d)
            }
        }
    }
    // Most recently opened first; the runtime has no sort.
    let out = []
    for d in found {
        let at = out.len()
        for i x in out { if at == out.len() && d.opened > x.opened { at = i } }
        let next = []
        for i x in out {
            if i == at { next.push(d) }
            next.push(x)
        }
        if at == out.len() { next.push(d) }
        out = next
    }
    st.docs = out
}
fn library_bytes(){
    let total = 0
    for d in st.docs { if d.bytes != nil { total = total + d.bytes } }
    total
}
fn unique_name(base){
    if !fs.exists(LIBRARY + "/" + base + ".pdf") { return base }
    let n = 2
    loop {
        if !fs.exists(LIBRARY + "/" + base + " " + n + ".pdf") { return base + " " + n }
        n = n + 1
    }
}
// Removing a PDF from PDF Tools asks once more, on a sheet. One with
// unsaved changes in a tab stays until that tab is closed.
fn ask_remove(d){
    st.removing = d.name
    render_dialog()
}
fn remove_doc(d){
    st.removing = ""
    render_dialog()
    let t = tab_named(d.name)
    if t != nil && t.edited {
        note("Close “" + shown_name(d.title) + "” first: it has changes that aren't saved.")
        render_home()
        return
    }
    let finish = || {
        try { fs.remove(d.path) } catch { nil }
        if fs.exists(d.path) {
            note("Couldn't remove “" + shown_name(d.title) + "”.")
            render_home()
            return
        }
        // Its cover, kept in the pdf service's cache folder, goes with it.
        if d.cover.search(".cache/covers/") == 0 { try { fs.remove(d.cover) } catch { nil } }
        forget(d.name)
        storage_later()
        st.space_full = false
        scan_library()
        render_home()
        render_status()
        note("Removed “" + shown_name(d.title) + "” from PDF Tools.")
    }
    if t != nil && t.doc != nil {
        engine("close", {doc: t.doc discard: true}, fn(a){
            let kept = []
            for x in st.tabs { if x.name != t.name { kept.push(x) } }
            st.tabs = kept
            t.state = "closed"
            render_tabs()
            finish()
        })
        return
    }
    finish()
}
fn doc_failed(d, e){
    if err_code(e) == "protected" { d.locked = true return }
    d.error = err_words(e)
}
fn doc_meta(d){
    if d.locked { return "Protected with a password" }
    if d.error != "" { return "Couldn't open this PDF" }
    if d.pages == nil { return pick(st.engine == "missing" || st.engine == "old", "PDF", "Reading…") }
    let line = plural(d.pages, "page", "pages")
    if d.bytes != nil { line = line + "  ·  " + size_text(d.bytes) }
    line
}
// Today and yesterday, once per Home render: local_time is not free, and a
// render has 64 ms for every card.
fn days_now(){
    let now_t = time_now()
    {today: local_time(now_t) yesterday: local_time(now_t - 86400)}
}
fn same_day(a, b){ a.year == b.year && a.month == b.month && a.day == b.day }
fn opened_text(d, days){
    if d.opened == nil || d.opened <= 0 { return "Not opened yet" }
    let a = local_time(d.opened)
    if same_day(a, days.today) { return "Opened today" }
    if same_day(a, days.yesterday) { return "Opened yesterday" }
    if a.year == days.today.year { return "Opened " + MONTHS[a.month - 1] + " " + a.day }
    "Opened " + MONTHS[a.month - 1] + " " + a.day + ", " + a.year
}

// Each PDF's cover (its first page) and its pages and size, one engine call
// at a time. Once a start, Home asks pdf.cover for each of the first
// SHOWN_COVERS PDFs it shows: the service keeps at most that many covers, and
// asking for more would evict the ones Home shows first. A kept cover answers
// from its file alone (a stat and a 24-byte read), and the picture kept in
// library.json shows meanwhile. A cover at another path is a PDF that
// changed since (a save, a replacement): its pages and size are read again
// (pdf.info), as they are for a PDF beyond the first ones that has none.
let SHOWN_COVERS = 32
fn cover_next(){
    if st.busy || st.engine == "missing" || st.engine == "old" { return false }
    for i d in st.docs {
        if d.error == "" && !d.locked && optional(st.cover_tried, d.name, nil) == nil {
            if i < SHOWN_COVERS {
                read_cover(d)
                return true
            }
            if d.pages == nil || d.bytes == nil {
                st.cover_tried[d.name] = true
                st.busy = true
                st.busy_at = time_now()
                doc_facts(d)
                return true
            }
        }
    }
    false
}
fn read_cover(d){
    st.cover_tried[d.name] = true
    if optional(st.covers, d.name, nil) == nil && d.cover != "" && fs.exists(d.cover) {
        let src = try { binary_resource(fs.read_bytes(d.cover)) } catch { nil }
        if src != nil {
            st.covers[d.name] = src
            render_home()
        }
    }
    st.busy = true
    st.busy_at = time_now()
    engine("cover", {path: d.path dpi: COVER_DPI}, fn(a){
        if engine_gone(a) {
            st.busy = false
            render_home()
            return
        }
        wrote(a)
        if !a.is_ok {
            // A damaged or locked PDF says so on its card. No room
            // (storage_full), a first page too large to draw small
            // (too_large), or a shell without covers leaves the card without
            // one, and its pages and size still come from the file (pdf.info
            // writes nothing).
            let e = a.error
            if !outdated(e) && !storage_full(e) && err_code(e) != "too_large" {
                doc_failed(d, e)
                cover_done()
                return
            }
            if d.pages == nil || d.bytes == nil {
                doc_facts(d)
                return
            }
            cover_done()
            return
        }
        let path = optional(a.data, "path", "")
        let moved = path != d.cover
        if moved || optional(st.covers, d.name, nil) == nil {
            let src = try { binary_resource(fs.read_bytes(path)) } catch { nil }
            if src != nil { st.covers[d.name] = src }
        }
        d.cover = path
        if moved || d.pages == nil || d.bytes == nil {
            doc_facts(d)
            return
        }
        cover_done()
    })
}
// A PDF's pages and size, from the file (the library keeps them).
fn doc_facts(d){
    engine("info", {path: d.path}, fn(i){
        if i.is_ok {
            d.bytes = optional(i.data, "file_size", d.bytes)
            d.pages = optional(i.data, "pages", []).len()
        } else if !outdated(i.error) {
            doc_failed(d, i.error)
        }
        remember(d)
        cover_done()
    })
}
// A saved PDF changed: its kept cover is out of date, so library.json names
// none, and Home asks pdf.cover for it again, whose new path makes it read
// the pages and size again too; the old picture shows until the new one comes
// (the service drops the old file then).
fn stale_cover(d){
    d.cover = ""
    let tried = {}
    for k v in st.cover_tried { if k != d.name { tried[k] = v } }
    st.cover_tried = tried
}
fn cover_done(){
    st.busy = false
    if st.open_sheet { render_dialog() }
    render_home()
    render_status()
    start_timeout(0.02, || pump())
}

// ---- opening a PDF from this device ---------------------------------------

// What the shell's files service offers, asked once without opening anything.
fn check_files(){
    host.request("files.status", {}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data}
        start_timeout(0.01, || {
            st.files_known = true
            if answer.is_ok {
                st.files_ok = optional(answer.data, "import_supported", false) && optional(answer.data, "storage_granted", false)
                st.files_out = optional(answer.data, "export_supported", false) && optional(answer.data, "storage_granted", false)
                st.max_import = optional(answer.data, "max_import_bytes", 0)
                took_usage(answer.data)
            }
            render_home()
        })
    })
}
// The status line's numbers, from files.status: what the app's storage
// holds, this service's renders and covers included, and what it may hold.
fn took_usage(data){
    let u = usage_from(data)
    if u == nil { return }
    st.used = u.used
    st.quota = u.quota
}
// Ask files.status again a moment after a write: one question for a burst of
// writes (a page turn renders several pages).
fn storage_later(){
    if st.storage_due { return }
    st.storage_due = true
    start_timeout(0.8, || {
        host.request("files.status", {}, fn(r){
            let answer = {is_ok: r.is_ok data: r.data}
            start_timeout(0.01, || {
                st.storage_due = false
                if answer.is_ok { took_usage(answer.data) }
                render_status()
            })
        })
    })
}
fn import_limit(){ pick(st.max_import > 0, "Up to " + size_text(st.max_import), "") }
// The host's refusal, said for a person. Its own words go below only when there are none to say it in.
let IMPORT_UNKNOWN = "OctoSense couldn't copy the file in."
fn import_refusal(error){
    let e = "" + error
    if e.search("foreground_required") >= 0 { return "Bring PDF Tools to the front, then choose the file again." }
    if e.search("busy") >= 0 { return "Another file is still being added. Try again in a moment." }
    if storage_full(e) { return "PDF Tools' storage is full. Remove a PDF to make room, then try again." }
    if e.search("too large") >= 0 || e.search("exceeds the byte limit") >= 0 { return "That file is too big to add. " + import_limit() + " can be added." }
    if e.search("permission_denied") >= 0 { return "OctoSense didn't let PDF Tools open files from this device." }
    if e.search("unsupported_platform") >= 0 { return "This device can't add files to PDF Tools." }
    if e.search("already exists") >= 0 { return "A file of the same name appeared while you chose. Try again." }
    IMPORT_UNKNOWN
}
// The person chooses a file in the host's own dialog; it is copied into a
// new library file the app named first, titled with the chosen file's name,
// and opens in a tab.
fn open_from_device(){
    if st.importing { return }
    if !st.files_ok {
        note("This OctoSense can't open files from the device for PDF Tools.")
        return
    }
    let name = unique_name(IMPORT_NAME) + ".pdf"
    st.importing = true
    st.alert = nil
    render_home()
    host.request("files.import", {path: LIBRARY + "/" + name}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || imported(name, answer))
    })
}
fn imported(name, a){
    st.importing = false
    let into = st.insert_into
    st.insert_into = ""
    let combine_into = st.combine_into
    st.combine_into = ""
    if !a.is_ok {
        if storage_full(a.error) { st.space_full = true }
        // Home has room to say why; a document says it in the banner.
        if st.screen != "home" {
            note(import_refusal(a.error))
            render_modebar()
            return
        }
        let refusal = import_refusal(a.error)
        st.alert = {head: "Couldn't open a PDF from this device" detail: refusal note: pick(refusal == IMPORT_UNKNOWN, "" + a.error, "")}
        show()
        return
    }
    if optional(a.data, "cancelled", false) {
        render_home()
        render_modebar()
        return
    }
    storage_later()
    forget(name)
    let taken = []
    for d in st.docs { taken.push(d.title) }
    let title = title_for_import(optional(a.data, "name", nil), name, taken)
    st.index[name] = {title: title bytes: optional(a.data, "bytes", nil)}
    save_index()
    scan_library()
    let d = doc_named(name)
    if d == nil { render_home() return }
    let ct = tab_named(combine_into)
    if combine_into != "" && ct != nil && ct.combine != nil {
        combine_add(ct, d)
        render_modebar()
        return
    }
    let t = tab_named(into)
    if into != "" && t != nil && t.doc != nil {
        insert_file(t, d)
        render_modebar()
        return
    }
    open_doc(d)
}

// ---- documents --------------------------------------------------------------

fn new_tab(d){
    {name: d.name path: d.path title: d.title doc: nil state: "opening" error: ""
        pages: 0 sizes: [] outline: [] can_edit: true
        edited: false can_undo: false can_redo: false saving: false history_wait: "" history_problem: nil field_focus_n: 0 field_focus_pending: false
        mode: "read" panel: "pages" panel_kept: "pages" zoom: 1.0 fit: "" zoom_auto: true
        anchor: 1 page: 1
        renders: {} failed: {} thumbs: {} thumb_failed: {} grid: {} grid_failed: {} tile: 1.0
        thumb_stale: {} grid_stale: {} thumb_prev: {}
        find: nil finding: false find_from: nil find_n: 0 reading: false side_off: false find_side: false
        comments: nil comments_state: "" thread: nil tool: "highlight" color: "yellow" reply: "" pending: nil comment_wait: false comment_delete_wait: false comment_delete_problem: nil comment_problem: ""
        fields: nil fields_state: "" field: nil field_text: "" field_typing: false show_fields: true place: nil place_text: ""
        field_wait: false field_retry: nil field_problem: "" save_problem: "" change_n: 0
        selected: [] sel_from: 0 sel_base: [] drag: nil win: 1 find_draft: ""
        lines: {} edit: nil edit_wait: false edit_problem: "" read_sel: 0
        outline_open: {}
        combine: nil}
}
fn open_doc(d){
    st.home_at = -1
    let t = tab_named(d.name)
    if t != nil {
        show_tab(tab_index(t))
        return
    }
    if st.tabs.len() >= MAX_OPEN {
        note("PDF Tools keeps up to " + MAX_OPEN + " PDFs open. Close one to open another.")
        return
    }
    t = new_tab(d)
    st.tabs.push(t)
    d.opened = time_now()
    remember(d)
    scan_library()
    show_tab(st.tabs.len() - 1)
    load_tab(t)
}
// What pdf.open's refusal says about the next try (SERVICE.md's codes): a file the
// engine can't read, one that isn't in storage, one over a cap or a request it refuses
// stays that way, so it gets OK alone. A password is "protected", too many open is
// "full", and anything else (no code: a service that didn't answer in time, a full
// storage, a code this app doesn't know) may work next time: "failed", with Try Again.
fn open_lasting(code){ code == "damaged" || code == "not_found" || code == "too_large" || code == "invalid" }
fn load_tab(t){
    t.state = "opening"
    engine("open", {path: t.path}, fn(a){
        if tab_index(t) < 0 {
            if a.is_ok { engine("close", {doc: a.data.doc discard: true}, fn(c){}) }
            return
        }
        if engine_gone(a) || outdated_open(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        if !a.is_ok {
            let code = err_code(a.error)
            if code == "protected" { t.state = "protected" }
            else if code == "too_many_open" { t.state = "full" }
            else if open_lasting(code) {
                t.state = "damaged"
                t.error = err_words(a.error)
            } else {
                t.state = "failed"
                t.error = err_words(a.error)
            }
            // Only a lasting refusal marks the PDF on Home.
            let d = doc_named(t.name)
            if d != nil && t.state != "full" && t.state != "failed" { doc_failed(d, a.error) }
            refresh_doc()
            return
        }
        let v = a.data
        t.doc = v.doc
        t.pages = optional(v, "pages", 0)
        t.sizes = optional(v, "sizes", [])
        t.outline = optional(v, "outline", [])
        t.can_edit = optional(v, "can_edit", true)
        t.state = "ready"
        let d = doc_named(t.name)
        t.page = 1
        t.zoom = start_zoom(t)
        if d != nil {
            d.pages = t.pages
            d.error = ""
            d.locked = false
            t.page = clamp(d.page, 1, max(1, t.pages))
            if d.zoom != nil {
                t.zoom = d.zoom
                t.zoom_auto = false
            }
            remember(d)
        }
        refresh_doc()
        go_page(t, t.page)
    })
}
fn show_tab(i){
    let current = cur_tab()
    let switched = st.screen != "doc" || st.cur != i
    if field_guard(current) { return }
    if current != nil && field_handoff(current, nil, "continue", || show_tab(i)) { return }
    commit_field(current)
    if st.screen != "doc" || st.cur != i { unsay() }
    st.screen = "doc"
    st.cur = i
    let t = cur_tab()
    let refit_now = t != nil && auto_fit(t)
    show()
    if refit_now { go_page(t, t.page) } else {
        // A held editor belongs to this tab, while the canvas may still hold
        // the previous document. Restore it when actually switching tabs.
        if switched && t != nil && t.state == "ready" && t.mode != "pages" && t.mode != "combine" && canvas_held(t) { render_canvas() }
        reveal_thumb_later()
    }
    pump()
    ui.keys.focus()
}
fn go_home(){
    let current = cur_tab()
    if field_guard(current) { return }
    if current != nil && field_handoff(current, nil, "continue", || go_home()) { return }
    commit_field(current)
    if st.screen != "home" { unsay() }
    st.screen = "home"
    scan_library()
    storage_later()
    show()
    pump()
    ui.keys.focus()
}
// Closing a tab with unsaved changes asks first (st.confirm).
fn ask_close(t){
    if history_guard(t) { return }
    if edit_guard(t) { return }
    if comment_delete_guard(t) { return }
    if field_guard(cur_tab()) { return }
    if field_guard(t) { return }
    if field_handoff(t, nil, "close", nil) { return }
    if comment_busy(t) { note("The comment is still being posted.") return }
    if pending_draft(t) { note("Finish or discard the current edit before closing.") return }
    commit_field(t)
    if t.edited {
        st.confirm = t.name
        render_dialog()
        return
    }
    close_tab(t, false)
}
fn close_tab(t, discard){
    st.confirm = nil
    render_dialog()
    let finish = || {
        let i = tab_index(t)
        if i < 0 { return }
        let current = cur_tab()
        let kept = []
        for x in st.tabs { if x.name != t.name { kept.push(x) } }
        st.tabs = kept
        t.state = "closed"
        if st.tabs.len() == 0 { go_home() return }
        if st.screen == "doc" {
            // A save-and-close can finish after the person has moved to
            // another document. Keep that document and its keyboard focus.
            if current != nil && current.name != t.name {
                let at = tab_index(current)
                if at >= 0 {
                    st.cur = at
                    render_tabs()
                    render_status()
                    return
                }
            }
            show_tab(min(i, st.tabs.len() - 1))
        } else { render_tabs() render_status() }
    }
    if t.doc == nil { finish() return }
    engine("close", {doc: t.doc discard: discard}, fn(a){
        if !a.is_ok && err_code(a.error) == "unsaved" {
            st.confirm = t.name
            render_dialog()
            return
        }
        finish()
    })
}
fn save_and_close(t){
    st.confirm = nil
    render_dialog()
    save(t, || close_tab(t, false))
}

// ---- the canvas: a run of pages from the page you went to ------------------

fn page_pt(t, p){
    let s = optional(t.sizes, p - 1, nil)
    if s == nil { return [612, 792] }
    [s[0], s[1]]
}
fn page_box(t, p){
    let s = page_pt(t, p)
    [round(s[0] * t.zoom), round(s[1] * t.zoom)]
}
fn run_end(t){ min(t.pages, t.anchor + RUN - 1) }
// The dpi a page renders at for the zoom: screen resolution, within the
// service's 24 to 300 dpi and 16 megapixels.
fn render_dpi(t){
    let s = page_pt(t, t.page)
    let cap = floor(72 * sqrt(16000000 / max(1, s[0] * s[1])))
    clamp(min(round(72 * t.zoom * DENSITY), cap), 24, 300)
}
fn page_src(t, p){
    let r = optional(t.renders, "p" + p, nil)
    if r == nil { return nil }
    r.src
}
fn needs_render(t, p){
    let r = optional(t.renders, "p" + p, nil)
    let dpi = render_dpi(t)
    if optional(t.failed, "p" + p, nil) == dpi { return false }
    r == nil || r.dpi != dpi
}
// Show page `p`: the canvas starts its run there. The runtime gives script
// apps no scroll position, so the run is drawn empty first (the scroll clamps
// to the top on that frame), then filled.
fn go_page(t, p){
    // Re-rendering the current page is needed for resize/auto-fit, even when
    // an editor is waiting for a field change to finish.
    if t.pages < 1 { return }
    let n = clamp(p, 1, t.pages)
    if n != t.page {
        if history_guard(t) { return }
        if edit_guard(t) { return }
        if field_guard(t) { return }
        if field_handoff(t, nil, "continue", || go_page(t, n)) { return }
    }
    show_page(t, n)
}
// Also used to bring an unapplied editor back into view after a refusal.
fn show_page(t, n){
    t.page = n
    t.anchor = n
    remember_place(t)
    st.blank = true
    render_canvas()
    render_counter()
    render_panel()
    st.jump_n = st.jump_n + 1
    let g = st.jump_n
    start_timeout(0.12, || {
        if g != st.jump_n { return }
        st.blank = false
        render_canvas()
        reveal_thumb(cur_tab())
        pump()
    })
}
fn remember_place(t){
    let d = doc_named(t.name)
    if d == nil { return }
    d.page = t.page
    // A zoom the person chose is kept; the automatic one is worked out again.
    d.zoom = nil
    if !t.zoom_auto { d.zoom = t.zoom }
    remember(d)
}
fn step_page(t, delta){ go_page(t, t.page + delta) }

// ---- zoom -----------------------------------------------------------------

fn left_open(t){ t.panel != "" && !t.side_off && t.mode != "pages" && t.mode != "combine" && !(narrow() && right_open(t)) }
fn right_open(t){ t.mode == "comment" || t.mode == "fill" || t.mode == "edit" }
fn panel_w(t){ pick(t.panel == "pages", PANEL_W, LIST_W) }
// In a narrow window both inspectors take 256, so the page keeps its room.
fn right_w(t){ pick(narrow(), 256, pick(t.mode == "comment", THREAD_W, RIGHT_W)) }
// Below this width an inspector takes the left panel's place.
fn narrow(){ st.width < 980 }
// Below this width Save shows its icon alone; under narrow() the modes fold into a
// pop-up (modebar_view), and sooner when the document's name needs their room.
fn tight(){ st.width < 1120 }
// The toolbar's room goes to the document's whole name first, as Preview's title
// keeps it: the modes' segments draw 12 points a side, then 8, then fold into a
// pop-up before the name gives way (mode_pad says 12, 8 or 0). The other tools take
// what modebar_view and pagebar_view give them; the segments measure 425 and 377
// points, and a name's bold 15-point letters are taken at 8.6 points each.
fn name_w(title){ ceil(("" + title).len() * 8.6) + 4 }
fn mode_pad(t){
    if narrow() { return 0 }
    let pages = BAR_LEAD + 30 + 8 + 26 + pick(t.pages >= 100, 68, 46) + 26 + 8 + 26 + 40 + 26
    let save = pick(tight(), 30, pick(t.saving, 76, 62))
    // A Mac's toolbar ends with the search field: Read mode's full screen is the window's own.
    let room = st.width - pages - (search_w() + pick(ui_unified, 6, 36)) - (12 + 56 + save + 6) - 24 - name_w(t.title)
    if room >= 425 { return 12 }
    if room >= 377 { return 8 }
    0
}
// The search field takes what the toolbar's other tools leave, after the document's name,
// and never less than its words need (176) until the window is tight.
fn search_w(){
    if narrow() { return clamp(st.width - 564, 110, 200) }
    if tight() { return clamp(st.width - 834, 120, 180) }
    clamp(st.width - 1004, 176, 200)
}
// "Search in document" where the field has room for it, else "Search".
fn search_words(){ pick(narrow() || search_w() < 176, "Search", "Search in document") }
// The canvas a document's pages get: the window less what's beside it (the
// sidebar, the inspector) and the bars (the toolbar, the tab strip, the status bar, a
// tool row, with their lines). In Read mode, the window above Read mode's bar.
fn canvas_box(){
    let t = cur_tab()
    if t == nil || reading_on(t) {
        let whole = canvas_size(st.width, st.height, true, 0, 0)
        return [whole[0], max(240, whole[1] - pick(t != nil, READ_BAR + 1, 0))]
    }
    let beside = 0
    if left_open(t) { beside = beside + panel_w(t) + 1 }
    if right_open(t) { beside = beside + right_w(t) + 1 }
    [max(240, st.width - beside), max(240, st.height - BAR_H - TABS_H - FOOT_H - 2 - toolrow_h(t))]
}
fn canvas_w(){ canvas_box()[0] }
fn canvas_h(){ canvas_box()[1] }
fn fit_width_zoom(t){
    let s = page_pt(t, t.page)
    (canvas_w() - 48) / s[0]
}
fn fit_page_zoom(t){
    let s = page_pt(t, t.page)
    min((canvas_w() - 48) / s[0], (canvas_h() - PAGE_TOP - 14) / s[1])
}
fn start_zoom(t){ clamp(floor(fit_width_zoom(t) * 100) / 100, 0.25, 1.0) }
fn set_zoom(t, z, fit){
    t.zoom = clamp(floor(z * 100 + 0.5) / 100, 0.25, 4.0)
    t.fit = fit
    t.zoom_auto = false
    go_page(t, t.page)
}
// In Pages mode the toolbar's zoom is the tiles' size.
let TILES = [0.6, 0.8, 1.0, 1.2, 1.4, 1.6]
fn zoom_step(t, dir){
    if t.mode == "pages" {
        let i = position(TILES, t.tile)
        if i < 0 { i = 2 }
        t.tile = TILES[clamp(i + dir, 0, TILES.len() - 1)]
        render_grid()
        render_counter()
        return
    }
    let next = t.zoom
    if dir > 0 {
        let found = false
        for v in ZOOMS { if !found && v > t.zoom + 0.001 { next = v found = true } }
    } else {
        for v in ZOOMS { if v < t.zoom - 0.001 { next = v } }
    }
    set_zoom(t, next, "")
}
fn zoom_text(t){ "" + round(pick(t.mode == "pages", t.tile, t.zoom) * 100) + "%" }
// The toolbar's page and zoom tools: Combine has no page to turn or zoom, and
// Pages no page to fit.
fn page_step(delta){
    let t = cur_tab()
    if t != nil && t.mode != "combine" {
        if t.mode == "pages" {
            t.page = clamp(t.page + delta, 1, t.pages)
            render_grid()
            render_counter()
            return
        }
        step_page(t, delta)
    }
}
fn zoom_by(dir){
    let t = cur_tab()
    if t != nil && t.mode != "combine" { zoom_step(t, dir) }
}
fn fit_to(kind){
    let t = cur_tab()
    if t == nil || t.mode == "pages" || t.mode == "combine" { return }
    set_zoom(t, pick(kind == "width", fit_width_zoom(t), fit_page_zoom(t)), kind)
}
// Whether this mode and window leave room for the sidebar: Pages and Combine have the
// whole canvas, and in a narrow window an inspector takes its place.
fn side_can(t){ t != nil && t.state == "ready" && !reading_on(t) && t.mode != "pages" && t.mode != "combine" && !(narrow() && right_open(t)) }
// The toolbar's sidebar button, as in Preview: the sidebar goes, and comes back showing
// what it showed.
fn toggle_side(t){
    if !side_can(t) { return }
    if left_open(t) {
        // Comment and Edit keep their sidebar folded by a panel of none, which leaving
        // them gives back (set_mode); the other modes by side_off, which stays.
        if t.mode == "comment" || t.mode == "edit" {
            t.panel_kept = t.panel
            t.panel = ""
        } else {
            t.side_off = true
        }
    } else {
        t.side_off = false
        if t.panel == "" { t.panel = pick(t.panel_kept == "" || t.panel_kept == "search", "pages", t.panel_kept) }
    }
    show()
    if auto_fit(t) { go_page(t, t.page) }
    reveal_thumb_later()
    pump()
}
// The sidebar's pop-up, or the View menu: this view in the sidebar. Where the sidebar
// can't show, Read mode gives it its place.
fn side_show(t, id){
    if t == nil || t.state != "ready" { return }
    t.side_off = false
    t.panel = id
    if id == "comments" && t.comments == nil { load_comments(t) }
    if !side_can(t) {
        if reading_on(t) { leave_reading(t) }
        if !side_can(t) { set_mode(t, "read") }
        return
    }
    show()
    if auto_fit(t) { go_page(t, t.page) }
    reveal_thumb_later()
    pump()
}
fn side_titles(){
    let out = []
    for r in RAIL { out.push(r.label) }
    out
}
fn side_title(id){
    for r in RAIL { if r.id == id { return r.label } }
    "Pages"
}
fn side_chosen(title){
    if pt_modal { return }
    for r in RAIL { if r.label == title { side_show(cur_tab(), r.id) } }
    ui.keys.focus()
}
// A new window size keeps a fitted zoom fitted.
fn refit(t){
    if t.fit == "width" { t.zoom = clamp(floor(fit_width_zoom(t) * 100) / 100, 0.25, 4.0) }
    if t.fit == "page" { t.zoom = clamp(floor(fit_page_zoom(t) * 100) / 100, 0.25, 4.0) }
}

// ---- Read mode ----------------------------------------------------------------

// Whether tab `t` shows its pages alone (its PDF open and ready).
fn reading_on(t){ t != nil && optional(t, "reading", false) && t.state == "ready" }
// From the toolbar's full-screen button: the same page, and the zoom
// the person chose, or the fit, worked out for the whole window (kept_zoom).
// The click also asks the shell to put the window in full screen
// (window.fullscreen). Where it can't (no click it counts, a host with no
// window service, such as card-host), Read mode fills the window as before,
// and the answer is not shown.
fn enter_reading(t){
    if t == nil || t.state != "ready" || t.mode == "pages" || t.mode == "combine" { return }
    if history_guard(t) { return }
    if edit_guard(t) { return }
    if field_guard(t) { return }
    if field_handoff(t, nil, "continue", || enter_reading(t)) { return }
    commit_field(t)
    t.reading = true
    reading_zoom(t)
    show()
    go_page(t, t.page)
    host.request("window.fullscreen", {on: true}, fn(r){})
}
// The shell's word that the window's full screen started or ended: when
// Esc or another window ends it, Read mode ends too. One that starts
// after Read mode already ended goes straight back.
fn on_app_fullscreen(on){
    st.screen_full = on
    if on { screen_back() } else { leave_reading(cur_tab()) }
}
// The full screen Read mode asked for goes back once Read mode is over,
// however it ended (show() asks after every change).
fn screen_back(){
    if !optional(st, "screen_full", false) || reading_on(cur_tab()) { return }
    st.screen_full = false
    host.request("window.fullscreen", {on: false}, fn(r){})
}
// From Read mode's bar, or the Esc key, or the shell's Esc (on_app_fullscreen): the
// page and zoom it left Read mode with.
fn leave_reading(t){
    if t == nil || !optional(t, "reading", false) { return }
    t.reading = false
    t.read_sel = 0
    reading_zoom(t)
    show()
    go_page(t, t.page)
}
fn reading_zoom(t){
    t.zoom = kept_zoom(t.zoom, t.zoom_auto, t.fit, fit_width_zoom(t), fit_page_zoom(t), start_zoom(t))
}

// ---- the render pump: one engine render at a time ---------------------------

fn pump(){
    // A render that never answered (its callback lost to a script budget
    // abort under load) frees the pump after 30 s.
    if st.busy && time_now() - st.busy_at > 30 { st.busy = false }
    if st.busy || st.engine == "missing" || st.engine == "old" { return }
    let t = cur_tab()
    if t != nil && t.state == "ready" && t.doc != nil && !st.blank {
        if t.mode == "pages" {
            if grid_next(t) { return }
        } else if t.mode != "combine" {
            if run_next(t, AHEAD + 1) { return }
            if left_open(t) && t.panel == "pages" && thumb_next(t, 8) { return }
            if run_next(t, RUN) { return }
            if left_open(t) && t.panel == "pages" && thumb_next(t, THUMB_WINDOW) { return }
        }
    }
    if st.screen == "home" || st.open_sheet { cover_next() }
}
fn run_next(t, n){
    for i in n {
        let p = t.anchor + i
        if p <= run_end(t) && needs_render(t, p) {
            render_page(t, p)
            return true
        }
    }
    false
}
fn render_page(t, p){
    let dpi = render_dpi(t)
    st.busy = true
    st.busy_at = time_now()
    engine("page", {doc: t.doc page: p dpi: dpi}, fn(a){
        st.busy = false
        if engine_gone(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        wrote(a)
        if a.is_ok {
            let src = try { binary_resource(fs.read_bytes(optional(a.data, "path", ""))) } catch { nil }
            if src != nil { t.renders["p" + p] = {src: src dpi: dpi} } else { t.failed["p" + p] = dpi }
        } else { t.failed["p" + p] = dpi }
        trim_renders(t)
        if cur_tab() == t && !canvas_held(t) && !st.blank { render_canvas() }
        if st.space_full { render_status() }
        start_timeout(0.02, || pump())
    })
}
// Drawing the canvas again would take the keyboard from what is being typed on it.
fn canvas_held(t){ t.edit != nil || t.field_typing }
// Keep the run's renders and a page either side; the rest go.
fn trim_renders(t){
    let kept = {}
    let n = 0
    for k v in t.renders {
        let p = k.replace("p", "").to_f64()
        if p >= t.anchor - 1 && p <= run_end(t) + 1 {
            kept[k] = v
            n = n + 1
        }
    }
    t.renders = kept
}
// Everything drawn of a document is stale after a change the engine made.
fn invalidate(t){
    t.renders = {}
    t.failed = {}
    t.thumbs = {}
    t.thumb_failed = {}
    t.thumb_stale = {}
    t.thumb_prev = {}
    t.grid = {}
    t.grid_failed = {}
    t.grid_stale = {}
    t.lines = {}
    // Its matches are stale: the search ends, and the left side goes back.
    drop_find(t)
    start_timeout(0.05, || pump())
}
// Only page `p` changed (a comment, a filled field, an edited paragraph). The page
// keeps its old picture until the new one comes, so it never blinks.
fn invalidate_page(t, p){
    let keep = |m| {
        let out = {}
        for k v in m { if k != "p" + p { out[k] = v } }
        out
    }
    let shown = optional(t.renders, "p" + p, nil)
    if shown != nil { shown.dpi = -1 }
    t.failed = keep(t.failed)
    // Its thumbnails keep their pictures too, marked to draw again.
    if optional(t.thumbs, "p" + p, nil) != nil { t.thumb_stale["p" + p] = true }
    t.thumb_failed = keep(t.thumb_failed)
    if optional(t.grid, "p" + p, nil) != nil { t.grid_stale["p" + p] = true }
    t.grid_failed = keep(t.grid_failed)
    t.lines = keep(t.lines)
    start_timeout(0.05, || pump())
}

// ---- thumbnails: the Pages panel and the Pages grid ---------------------------

// The window holds while the page stays in it, so a click on a thumbnail doesn't move
// the thumbnails under the pointer.
fn window_start(t){
    let s = optional(t, "win", 1)
    if t.page < s || t.page >= s + THUMB_WINDOW || s > max(1, t.pages - THUMB_WINDOW + 1) {
        s = max(1, min(t.page - 8, t.pages - THUMB_WINDOW + 1))
        t.win = s
    }
    s
}
fn window_end(t){ min(t.pages, window_start(t) + THUMB_WINDOW - 1) }
// A thumbnail to draw: one never drawn, or one whose page changed since (its old
// picture shows until then), unless drawing it failed.
fn thumb_due(have, stale, failed, p){
    let k = "p" + p
    (optional(have, k, nil) == nil || optional(stale, k, false) == true) && optional(failed, k, nil) == nil
}
fn thumb_next(t, n){
    let first = max(window_start(t), t.page - 2)
    for i in n {
        let p = first + i
        if p <= window_end(t) && thumb_due(t.thumbs, t.thumb_stale, t.thumb_failed, p) {
            render_thumb(t, p, false)
            return true
        }
    }
    for i in window_end(t) - window_start(t) + 1 {
        let p = window_start(t) + i
        if i < n && thumb_due(t.thumbs, t.thumb_stale, t.thumb_failed, p) {
            render_thumb(t, p, false)
            return true
        }
    }
    false
}
fn grid_next(t){
    for i in window_end(t) - window_start(t) + 1 {
        let p = window_start(t) + i
        if thumb_due(t.grid, t.grid_stale, t.grid_failed, p) {
            render_thumb(t, p, true)
            return true
        }
    }
    false
}
fn thumb_prev_done(t, p){
    if optional(t.thumb_prev, "p" + p, nil) == nil { return }
    let out = {}
    for k v in t.thumb_prev { if k != "p" + p { out[k] = v } }
    t.thumb_prev = out
    if cur_tab() == t { ui.thumbs.render() }
}
fn render_thumb(t, p, big){
    st.busy = true
    st.busy_at = time_now()
    engine("page", {doc: t.doc page: p dpi: pick(big, GRID_DPI, THUMB_DPI)}, fn(a){
        st.busy = false
        if engine_gone(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        wrote(a)
        let src = nil
        if a.is_ok { src = try { binary_resource(fs.read_bytes(optional(a.data, "path", ""))) } catch { nil } }
        if big {
            if src != nil { t.grid["p" + p] = src } else { t.grid_failed["p" + p] = true }
            t.grid_stale["p" + p] = false
            if cur_tab() == t && t.mode == "pages" { render_grid() }
        } else {
            if src != nil {
                // The old picture stays over the new one while it decodes (a fresh image
                // draws grey until then), and goes after.
                let old = optional(t.thumbs, "p" + p, nil)
                if old != nil {
                    t.thumb_prev["p" + p] = old
                    start_timeout(0.4, || thumb_prev_done(t, p))
                }
                t.thumbs["p" + p] = src
            } else { t.thumb_failed["p" + p] = true }
            t.thumb_stale["p" + p] = false
            if cur_tab() == t { ui.thumbs.render() }
        }
        start_timeout(0.02, || pump())
    })
}

// ---- find -----------------------------------------------------------------

fn find_text(text){
    let t = cur_tab()
    let q = ("" + text).trim()
    if t == nil || t.state != "ready" { return }
    if q == "" {
        end_find(t)
        return
    }
    t.find_draft = q
    // A search may finish after another search or after Find was closed.
    // Its answer belongs only to the request that made the current results.
    t.find_n = optional(t, "find_n", 0) + 1
    let n = t.find_n
    t.finding = true
    t.find = {query: q total: 0 matches: [] cur: 0 error: "" by_page: {} pages: []}
    // What the left side showed before the results took it: a new query
    // while they show keeps it.
    if t.panel != "search" { t.find_from = t.panel }
    t.panel = "search"
    // The results show even with the sidebar off; it goes again with them.
    if t.side_off {
        t.side_off = false
        t.find_side = true
    }
    let refit = auto_fit(t)
    show()
    if refit { go_page(t, t.page) }
    engine("find", {doc: t.doc query: q limit: 200}, fn(a){
        if t.state != "ready" || optional(t, "find_n", 0) != n || t.find == nil { return }
        t.finding = false
        if !a.is_ok {
            t.find.error = action_failed("search this PDF", a.error)
            show()
            return
        }
        t.find.total = optional(a.data, "total", 0)
        t.find.matches = optional(a.data, "matches", [])
        // Matches by page, once: every page drawn looks up its own.
        let by_page = {}
        let pages = []
        for i m in t.find.matches {
            let key = "p" + m.page
            if optional(by_page, key, nil) == nil {
                by_page[key] = []
                pages.push(m.page)
            }
            by_page[key].push(i)
        }
        t.find.by_page = by_page
        t.find.pages = pages
        show()
        if t.find.matches.len() > 0 { go_match(t, 0) }
    })
}
// The search ends: its highlights go, and the left side shows what it did
// before (panel_after_find), now or when Comment or Edit gives it back.
// Draws nothing.
fn drop_find(t){
    t.find_n = optional(t, "find_n", 0) + 1
    t.find = nil
    t.finding = false
    t.find_draft = ""
    let back = panel_after_find(optional(t, "find_from", nil))
    if t.panel == "search" { t.panel = back }
    if t.panel_kept == "search" { t.panel_kept = back }
    t.find_from = nil
    if t.find_side {
        t.find_side = false
        t.side_off = true
    }
}
// Done, the results' cross, the field's cross or an empty query.
fn end_find(t){
    drop_find(t)
    let refit = auto_fit(t)
    show()
    if refit { go_page(t, t.page) }
}
fn go_match(t, i){
    let n = t.find.matches.len()
    if n == 0 { return }
    t.find.cur = pick(i < 0, n - 1, pick(i >= n, 0, i))
    let m = t.find.matches[t.find.cur]
    render_toolrow()
    ui.results.render()
    if m.page != t.page || m.page != t.anchor { go_page(t, m.page) } else { render_canvas() }
}
fn find_pages(t){ t.find.pages }
fn page_matches(t, p){ optional(t.find.by_page, "p" + p, []) }
fn find_summary(t){
    if t.finding { return "Searching…" }
    if t.find.error != "" { return t.find.error }
    if t.find.total == 0 { return "No matches for “" + t.find.query + "”" }
    plural(t.find.total, "match", "matches") + " on " + plural(find_pages(t).len(), "page", "pages")
}

// ---- changes the engine keeps: state, undo, redo, save -------------------

// After a change: what the engine now says about edits and history.
fn changed(t){
    t.change_n = optional(t, "change_n", 0) + 1
    let change = t.change_n
    t.edited = true
    t.can_undo = true
    t.can_redo = false
    engine("state", {doc: t.doc}, fn(a){
        if optional(t, "change_n", 0) != change || t.saving || history_busy(t) { return }
        if a.is_ok {
            t.edited = optional(a.data, "edited", t.edited)
            t.can_undo = optional(a.data, "can_undo", t.can_undo)
            t.can_redo = optional(a.data, "can_redo", t.can_redo)
            let pages = optional(a.data, "pages", t.pages)
            if pages != t.pages { t.pages = pages }
        }
        if showing_tab(t) { render_actions() render_status() }
        render_tabs()
    })
    if showing_tab(t) { render_actions() render_status() }
    render_tabs()
}
fn undo(t, redo){
    if t == nil || t.doc == nil { return }
    if history_guard(t) { return }
    if t.saving { note("Wait for saving to finish before using Undo or Redo.") return }
    if field_guard(t) { return }
    if field_handoff(t, nil, "continue", || undo(t, redo)) { return }
    if draft_guard(t, "using Undo or Redo") { return }
    commit_field(t)
    if redo && !t.can_redo { return }
    if !redo && !t.can_undo { return }
    t.history_wait = pick(redo, "redo", "undo")
    t.history_problem = nil
    render_actions()
    render_status()
    render_canvas()
    render_right()
    render_toolrow()
    engine(pick(redo, "redo", "undo"), {doc: t.doc}, fn(a){
        if !a.is_ok {
            t.history_wait = ""
            t.history_problem = {text: action_failed(pick(redo, "redo", "undo"), a.error) redo: redo}
            if showing_tab(t) { render_actions() render_canvas() render_right() render_toolrow() }
            render_status()
            return
        }
        t.change_n = optional(t, "change_n", 0) + 1
        t.edited = optional(a.data, "edited", true)
        t.can_undo = optional(a.data, "can_undo", false)
        t.can_redo = optional(a.data, "can_redo", false)
        // Which pages changed isn't said: draw the run again, and reread
        // what the panels show.
        invalidate(t)
        t.comments = nil
        t.fields = nil
        t.edit = nil
        reload_shape(t, || { t.history_wait = "" })
    })
}
// The document's pages and sizes again after a change that may move them.
fn reload_shape(t, done){
    engine("info", {doc: t.doc}, fn(a){
        if a.is_ok {
            let pages = optional(a.data, "pages", [])
            if pages.len() > 0 {
                let sizes = []
                for pg in pages { sizes.push([optional(pg, "width", 612), optional(pg, "height", 792)]) }
                t.sizes = sizes
                t.pages = pages.len()
            }
        }
        if t.mode == "comment" { load_comments(t) }
        if t.mode == "fill" { load_fields(t) }
        if done != nil { done() }
        let page = min(t.page, max(1, t.pages))
        if showing_tab(t) { show() go_page(t, page) }
        else { t.page = page t.anchor = page render_tabs() }
    })
}
fn save(t, then){
    if t == nil || t.doc == nil || t.saving { return }
    if history_guard(t) { return }
    if edit_guard(t) { return }
    if comment_delete_guard(t) { return }
    if field_guard(t) { return }
    if field_handoff(t, nil, "save", then) { return }
    if comment_busy(t) { note("The comment is still being posted.") return }
    let field_was_open = t.field != nil
    commit_field(t)
    if field_was_open { render_canvas() render_right() render_toolrow() }
    t.saving = true
    t.save_problem = ""
    let saving_change = optional(t, "change_n", 0)
    render_actions()
    render_status()
    engine("save", {doc: t.doc}, fn(a){
        t.saving = false
        wrote(a)
        if !a.is_ok {
            t.save_problem = save_problem_text(a.error)
            render_actions()
            render_status()
            return
        }
        t.save_problem = ""
        let newer = optional(t, "change_n", 0) != saving_change
        let pending_field = field_dirty(t) || (try { t.field_wait == true } catch { false })
        let draft = pending_draft(t)
        // A state response sent before this save must not overwrite its result.
        t.change_n = optional(t, "change_n", 0) + 1
        t.edited = newer
        let d = doc_named(t.name)
        if d != nil {
            d.bytes = optional(a.data, "bytes", d.bytes)
            // Its pages as the open document has them (a page deleted and
            // saved is gone from Home and Combine too).
            if t.pages > 0 { d.pages = t.pages }
            stale_cover(d)
            remember(d)
        }
        render_status()
        render_tabs()
        render_actions()
        if newer || pending_field || draft {
            note(pick(draft, draft_save_note(), newer_save_note()))
            return
        }
        if st.said == newer_save_note() || st.said == draft_save_note() { unsay() render_status() }
        if then != nil { then() }
    })
}

// ---- taps on a page ---------------------------------------------------------

// `x` and `y` are in the page's points (origin top left, y down, rotation
// applied), as the engine's geometry is.
fn page_tap(t, p, x, y){
    if history_guard(t) { return }
    if edit_guard(t) { return }
    if field_guard(t) { return }
    t.page = p
    render_counter()
    ui.keys.focus()
    // Read mode reads: a tap marks, fills or edits nothing, and lets a Select All go.
    if reading_on(t) {
        read_unselect(t)
        return
    }
    if t.mode == "comment" { comment_tap(t, p, x, y, false) return }
    if t.mode == "fill" { fill_tap(t, p, x, y) return }
    if t.mode == "edit" { edit_tap(t, p, x, y) return }
    read_unselect(t)
    render_panel()
}
fn page_double_tap(t, p, x, y){
    if history_guard(t) { return }
    if reading_on(t) { return }
    if t.mode == "comment" { comment_tap(t, p, x, y, true) }
}
fn inside(r, x, y){ x >= r[0] && x <= r[0] + r[2] && y >= r[1] && y <= r[1] + r[3] }
// The text lines and paragraphs of page `p`, read once (pdf.lines).
fn with_lines(t, p, done){
    let known = optional(t.lines, "p" + p, nil)
    if known != nil {
        done(known)
        return
    }
    engine("lines", {doc: t.doc page: p}, fn(a){
        if !a.is_ok {
            note(action_failed("read this page's text", a.error))
            return
        }
        t.lines["p" + p] = a.data
        done(a.data)
    })
}

// ---- comments ---------------------------------------------------------------

fn load_comments(t){
    t.comments_state = "loading"
    if showing_tab(t) { render_right() }
    if optional(t, "comment_delete_problem", nil) != nil { render_status() }
    engine("comments", {doc: t.doc}, fn(a){
        if !a.is_ok {
            t.comments_state = action_failed("read the comments", a.error)
            if showing_tab(t) { render_right() }
            if optional(t, "comment_delete_problem", nil) != nil { render_status() }
            return
        }
        t.comments = optional(a.data, "comments", [])
        t.comments_state = ""
        if t.thread == nil && t.comments.len() > 0 { t.thread = t.comments[0].id }
        if showing_tab(t) { render_right() ui.notes.render() if !canvas_held(t) { render_canvas() } }
        if optional(t, "comment_delete_problem", nil) != nil { render_status() }
    })
}
fn comment_named(t, id){
    if t.comments == nil { return nil }
    for c in t.comments { if c.id == id { return c } }
    nil
}
// Highlight, underline or strike out the line under the pointer (a double
// tap takes its paragraph); a note or a text box waits for its words.
fn comment_tap(t, p, x, y, paragraph){
    if draft_guard(t, "starting another comment") { return }
    if st.who.author == "" {
        st.naming = true
        render_right()
        note("Type the name your comments show, under Comment as, first.")
        return
    }
    if t.tool == "note" || t.tool == "textbox" {
        t.pending = {page: p at: [x, y] type: t.tool}
        t.reply = ""
        render_right()
        render_canvas()
        return
    }
    with_lines(t, p, |lines| {
        let hit = nil
        let list = pick(paragraph, optional(lines, "paragraphs", []), optional(lines, "lines", []))
        for l in list { if hit == nil && inside(l.box, x, y) { hit = l } }
        if hit == nil {
            note("Click a line of text to " + pick(t.tool == "highlight", "highlight", pick(t.tool == "underline", "underline", "strike out")) + " it.")
            return
        }
        let args = {doc: t.doc op: "add" page: p type: pick(t.tool == "strike", "strikeout", t.tool) rects: [hit.box] color: optional(MARK_HEX, t.color, "#ffd84d") author: st.who.author}
        engine("comment", args, fn(a){
            wrote(a)
            if !a.is_ok {
                note(action_failed("add the comment", a.error))
                return
            }
            t.thread = optional(a.data, "id", nil)
            invalidate_page(t, p)
            changed(t)
            load_comments(t)
            render_canvas()
        })
    })
}
fn post_pending(t){
    if history_guard(t) { return }
    if comment_delete_guard(t) { return }
    if comment_busy(t) { note("The comment is still being posted.") return }
    let submitted = t.reply
    let text = submitted.trim()
    if t.pending == nil || text == "" { return }
    let p = t.pending
    t.comment_wait = true
    t.comment_problem = ""
    render_right()
    render_status()
    engine("comment", {doc: t.doc op: "add" page: p.page type: p.type at: p.at color: optional(MARK_HEX, t.color, "#ffd84d") text: text author: st.who.author}, fn(a){
        t.comment_wait = false
        wrote(a)
        if !a.is_ok {
            t.comment_problem = action_failed("add the note", a.error)
            if showing_tab(t) { render_right() }
            render_status()
            render_tabs()
            return
        }
        let newer = t.reply != submitted && t.reply.trim() != ""
        t.pending = nil
        if !newer { t.reply = "" }
        t.thread = optional(a.data, "id", nil)
        invalidate_page(t, p.page)
        changed(t)
        load_comments(t)
        if showing_tab(t) { render_canvas() }
        if newer { note("Your note was posted. Your newer text is a draft reply.") }
    })
}
fn post_reply(t){
    if history_guard(t) { return }
    if comment_delete_guard(t) { return }
    if comment_busy(t) { note("The comment is still being posted.") return }
    let submitted = t.reply
    let text = submitted.trim()
    let c = comment_named(t, t.thread)
    if c == nil || text == "" { return }
    // A highlight with no words yet takes them as its own text.
    let edit = optional(c, "text", "") == "" && optional(c, "replies", []).len() == 0
    let args = {doc: t.doc op: "reply" id: c.id text: text author: st.who.author}
    if edit { args = {doc: t.doc op: "edit" id: c.id text: text} }
    t.comment_wait = true
    t.comment_problem = ""
    render_right()
    render_status()
    engine("comment", args, fn(a){
        t.comment_wait = false
        wrote(a)
        if !a.is_ok {
            t.comment_problem = action_failed("post the reply", a.error)
            if showing_tab(t) { render_right() }
            render_status()
            render_tabs()
            return
        }
        let newer = t.reply != submitted && t.reply.trim() != ""
        if !newer { t.reply = "" }
        changed(t)
        load_comments(t)
        if newer { note("Your reply was posted. Your newer text is still a draft.") }
    })
}
fn retry_comment(t){
    if t == nil || comment_busy(t) { return }
    if t.pending != nil { post_pending(t) }
    else if t.thread != nil { post_reply(t) }
}
fn set_status(t, status){
    if history_guard(t) { return }
    if comment_delete_guard(t) { return }
    if comment_busy(t) { note("The comment is still being posted.") return }
    let c = comment_named(t, t.thread)
    if c == nil { return }
    engine("comment", {doc: t.doc op: "status" id: c.id status: status}, fn(a){
        if !a.is_ok {
            note(action_failed("change the status", a.error))
            if showing_tab(t) { render_right() }
            return
        }
        changed(t)
        load_comments(t)
    })
}
fn delete_comment(t){
    if draft_guard(t, "deleting a comment") { return }
    if t.saving { note("Wait for saving to finish before deleting a comment.") return }
    let c = comment_named(t, t.thread)
    if c == nil { render_right() return }
    t.comment_delete_wait = true
    t.comment_delete_problem = nil
    if showing_tab(t) { render_right() render_actions() render_toolrow() }
    render_status()
    engine("comment", {doc: t.doc op: "delete" id: c.id}, fn(a){
        t.comment_delete_wait = false
        if !a.is_ok {
            t.comment_delete_problem = {id: c.id text: action_failed("delete the comment", a.error)}
            if showing_tab(t) { render_right() render_actions() render_toolrow() }
            render_status()
            return
        }
        t.thread = nil
        t.comments = nil
        invalidate_page(t, c.page)
        changed(t)
        load_comments(t)
        if showing_tab(t) { render_actions() render_toolrow() }
        render_status()
        if showing_tab(t) && !canvas_held(t) { render_canvas() }
    })
}
fn retry_comment_delete(t){
    if t == nil { return }
    let problem = try { t.comment_delete_problem } catch { nil }
    if problem == nil || draft_guard(t, "retrying deletion") { return }
    if t.comments == nil { return }
    let c = comment_named(t, problem.id)
    if c == nil {
        t.comment_delete_problem = nil
        note("That comment is no longer available.")
        render_status()
        return
    }
    t.thread = c.id
    delete_comment(t)
}
fn open_thread(t, c){
    if draft_guard(t, "opening another comment") { return }
    t.thread = c.id
    t.pending = nil
    if t.mode != "comment" { set_mode(t, "comment") }
    if c.page != t.page { go_page(t, c.page) }
    render_right()
    render_canvas()
}
fn set_author(text){
    let name = ("" + text).trim()
    if name == "" { return }
    st.who.author = name
    st.naming = false
    save_index()
    render_right()
    ui.keys.focus()
}
fn status_label(s){
    if s == "accepted" { return "Accepted" }
    if s == "rejected" { return "Rejected" }
    if s == "cancelled" { return "Cancelled" }
    if s == "completed" { return "Completed" }
    ""
}

// ---- Fill & Sign --------------------------------------------------------------

fn load_fields(t){
    t.fields_state = "loading"
    if showing_tab(t) { render_right() render_toolrow() }
    engine("fields", {doc: t.doc}, fn(a){
        if !a.is_ok {
            t.fields_state = action_failed("read the form", a.error)
            if showing_tab(t) { render_right() render_toolrow() }
            return
        }
        t.fields = optional(a.data, "fields", [])
        t.fields_state = ""
        if showing_tab(t) { render_right() render_toolrow() if !canvas_held(t) { render_canvas() } }
    })
}
fn field_named(t, name){
    if t.fields == nil { return nil }
    for f in t.fields { if f.name == name { return f } }
    nil
}
fn field_empty(f){
    let v = optional(f, "value", nil)
    v == nil || v == false || ("" + v).trim() == "" || v == "Off"
}
fn field_shown(f){
    let v = optional(f, "value", nil)
    if v == true { return "Checked" }
    if v == false || v == nil { return "" }
    "" + v
}
fn field_dirty(t){
    if t == nil || !t.field_typing { return false }
    let f = field_named(t, t.field)
    f != nil && t.field_text != field_shown(f)
}
// These editors have text which has not yet been applied to the open PDF.
fn comment_busy(t){
    if t == nil { return false }
    try { t.comment_wait == true } catch { false }
}
fn comment_delete_busy(t){
    if t == nil { return false }
    try { t.comment_delete_wait == true } catch { false }
}
fn comment_delete_guard(t){
    if !comment_delete_busy(t) { return false }
    note("The comment is still being deleted.")
    true
}
fn history_busy(t){
    if t == nil { return false }
    try { t.history_wait != "" } catch { false }
}
fn history_guard(t){
    if !history_busy(t) { return false }
    note("Undo or Redo is still in progress.")
    true
}
fn edit_busy(t){
    if t == nil { return false }
    try { t.edit_wait == true } catch { false }
}
fn edit_guard(t){
    if !edit_busy(t) { return false }
    note("The text is still being applied.")
    true
}
fn pending_draft(t){
    if t == nil { return false }
    if comment_busy(t) { return true }
    let edit = try { t.edit } catch { nil }
    if edit != nil && edit_changes(edit) { return true }
    let reply = try { t.reply } catch { "" }
    if t.mode == "comment" && reply.trim() != "" && (t.pending != nil || t.thread != nil) { return true }
    let place = try { t.place } catch { nil }
    if t.mode == "fill" && place != nil && place.kind != "date" && t.place_text.trim() != "" { return true }
    false
}
fn draft_guard(t, action){
    if history_guard(t) { return true }
    if edit_guard(t) { return true }
    if comment_delete_guard(t) { return true }
    if comment_busy(t) { note("The comment is still being posted.") return true }
    if !pending_draft(t) { return false }
    note("Finish or discard the current edit before " + action + ".")
    true
}
// Redraw only the indicators when an editor becomes nonempty or is cleared.
fn draft_changed(t, was){
    if was != pending_draft(t) { render_status() render_tabs() }
}
// Keep an editor's text until the engine has accepted it before moving to
// another field or closing the document.
fn field_guard(t){
    if t == nil { return false }
    let pending = try { t.field_wait == true } catch { false }
    let retry = try { t.field_retry } catch { nil }
    if pending { note("The field is still being applied.") return true }
    if retry != nil { note("Try Again or discard the field's changes first.") return true }
    false
}
// Continue the original interaction once the current text is safe. A page
// click and an index row have different checkbox/choice behavior.
fn field_after_handoff(t, f, action, then){
    if action == "view" { view_field(t, f) }
    else if action == "close" { ask_close(t) }
    else if action == "save" { save(t, then) }
    else if action == "finish" { close_field(t, true) }
    else if action == "continue" { if then != nil { then() } }
    else { select_field_action(t, f, action) }
}
fn field_handoff(t, f, action, then){
    let active = if t.field_typing { field_named(t, t.field) } else { nil }
    if active == nil || t.field_text == field_shown(active) { return false }
    let value = t.field_text
    t.field_wait = true
    t.field_retry = {field: f action: action then: then}
    t.field_problem = ""
    render_actions()
    render_status()
    let values = {}
    values[active.name] = value
    engine("fill", {doc: t.doc values: values}, fn(a){
        t.field_wait = false
        wrote(a)
        if !a.is_ok {
            t.field_problem = "Field not applied. Your text is still in the editor."
            render_actions()
            render_status()
            reveal_failed_field(t, active)
            return
        }
        active.value = value
        render_right()
        invalidate_page(t, active.page)
        changed(t)
        if t.field != active.name || t.field_text != value {
            t.field_problem = "Newer field changes haven't been applied."
            render_actions()
            render_status()
            reveal_failed_field(t, active)
            return
        }
        t.field_retry = nil
        t.field_problem = ""
        render_actions()
        render_status()
        field_after_handoff(t, f, action, then)
    })
    true
}
fn retry_field(t){
    if t == nil { return }
    let pending = try { t.field_wait == true } catch { false }
    if pending { note("The field is still being applied.") return }
    let retry = try { t.field_retry } catch { nil }
    if retry == nil { return }
    let then = optional(retry, "then", nil)
    if field_handoff(t, retry.field, retry.action, then) { return }
    t.field_retry = nil
    t.field_problem = ""
    render_actions()
    render_status()
    field_after_handoff(t, retry.field, retry.action, then)
}
fn read_only(f){ optional(f, "read_only", false) == true }
fn empty_required(t){
    let n = 0
    if t.fields == nil { return 0 }
    for f in t.fields { if optional(f, "required", false) && !read_only(f) && field_empty(f) { n = n + 1 } }
    n
}
fn form_summary(t){
    if t.fields_state == "loading" { return "Reading the form…" }
    if t.fields_state != "" { return t.fields_state }
    if t.place != nil && canvas_w() < 560 { return place_hint(t) }
    if t.fields == nil || t.fields.len() == 0 { return "This PDF has no form fields. Add text, a date or your initials where they go." }
    let line = "This form has " + plural(t.fields.len(), "field", "fields") + "."
    let empty = empty_required(t)
    if empty > 0 { line = line + " " + plural(empty, "required field is", "required fields are") + " empty." }
    line
}
fn is_check(f){
    let kind = "" + optional(f, "type", "text")
    kind == "checkbox" || kind == "check"
}
fn is_choice(f){ optional(f, "options", []).len() > 0 }
// A signature wants a certificate, and a button runs the form's own script: neither
// fills in here.
fn fillable(f){
    let kind = "" + optional(f, "type", "text")
    kind != "signature" && kind != "button"
}
// A field's value goes on its page where the person works, as in Preview: text and
// choices type or choose on the page (field_input, field_choice), and a check box
// turns over at a click. The inspector lists them, as an index.
fn select_field(t, f){
    select_field_action(t, f, "select")
}
fn select_field_action(t, f, action){
    if field_guard(t) { return }
    if draft_guard(t, "opening a field") { return }
    if read_only(f) {
        note("“" + f.name + "” can't be changed: the form keeps it read-only.")
        return
    }
    if !fillable(f) {
        note("PDF Tools can't sign “" + f.name + "”. Add Text or Add Initials put words on the page.")
        return
    }
    if field_handoff(t, f, action, nil) { return }
    commit_field(t)
    t.field = f.name
    t.field_text = field_shown(f)
    t.field_typing = !is_check(f) && !is_choice(f)
    t.place = nil
    let jump = f.page < t.anchor || f.page > run_end(t)
    if f.page != t.page { t.page = f.page }
    if jump { go_page(t, f.page) } else {
        render_canvas()
        render_counter()
    }
    render_right()
    render_toolrow()
    // The field that takes the keyboard has to be drawn first.
    let wait = pick(jump, 0.2, 0.05)
    t.field_focus_n = optional(t, "field_focus_n", 0) + 1
    t.field_focus_pending = true
    let focus_n = t.field_focus_n
    let doc = t.doc
    let name = f.name
    start_timeout(wait, || focus_selected_field(doc, name, focus_n, 0))
    if action == "tap" && is_check(f) { flip_check(t, f) }
    if (action == "tap" || action == "row") && is_choice(f) { open_choice(t, f) }
}
// A render or appearance change can temporarily remove the editor after the
// selection. Retry briefly, but only while this is still the same selection.
fn focus_selected_field(doc, name, focus_n, attempt){
    let current = cur_tab()
    if current == nil || current.doc != doc || current.mode != "fill" || current.field != name || reading_on(current) { return }
    if pt_modal || history_busy(current) { return }
    if optional(current, "field_focus_n", 0) != focus_n { return }
    if !optional(current, "field_focus_pending", false) { return }
    // The person may have clicked an empty search field while this focus was pending.
    let search_has_focus = try { ui.search.has_focus() } catch { false }
    if search_has_focus { current.field_focus_pending = false return }
    let active = field_named(current, name)
    if active == nil || active.page < current.anchor || active.page > run_end(current) { return }
    reveal_field(current, active)
    if !current.field_typing { current.field_focus_pending = false ui.keys.focus() return }
    let focused = try { ui.field_input.focus() true } catch { false }
    if focused || attempt >= 3 { current.field_focus_pending = false }
    else { start_timeout(0.1, || focus_selected_field(doc, name, focus_n, attempt + 1)) }
}
// The field comes into view, when the keys or the list went to it.
fn reveal_field(t, f){
    if f.page < t.anchor || f.page > run_end(t) { return }
    let y = PAGE_TOP
    for i in f.page - t.anchor { y = y + page_box(t, t.anchor + i)[1] + PAGE_GAP }
    let top = y + f.rect[1] * t.zoom
    let bottom = top + f.rect[3] * t.zoom
    let now = ui.canvas.scroll_y()
    let room = canvas_h()
    if bottom + 24 > now + room {
        ui.canvas.set_scroll_y(bottom + 24 - room)
    } else if top - 24 < now {
        ui.canvas.set_scroll_y(max(0, top - 24))
    }
}
// A scroll can move away from the editor while a write is pending. On refusal,
// bring that editor back rather than pointing to text outside the viewport.
fn reveal_failed_field(t, f){
    let x = cur_tab()
    if x == nil || x.doc != t.doc || x.field != f.name { return }
    if f.page >= t.anchor && f.page <= run_end(t) {
        reveal_field(t, f)
        return
    }
    show_page(t, f.page)
    let jump = st.jump_n
    let doc = t.doc
    let name = f.name
    start_timeout(0.2, || {
        let current = cur_tab()
        if current == nil || current.doc != doc || current.field != name || st.jump_n != jump { return }
        let active = field_named(current, name)
        if active != nil { reveal_field(current, active) }
    })
}
// A click on a field: a check box turns over, a choice opens its menu at once.
fn tap_field(t, f){
    select_field_action(t, f, "tap")
}
fn flip_check(t, f){
    write_field(t, f, field_empty(f))
    render_canvas()
}
fn open_choice(t, f){
    start_timeout(0.08, || {
        if t.field != f.name { return }
        let titles = []
        for o in optional(f, "options", []) { titles.push(option_title(o)) }
        ui.field_pick.open_menu(titles, option_shown(f))
    })
}
fn option_title(o){ "" + optional(o, "label", optional(o, "value", "")) }
fn option_shown(f){
    let v = "" + optional(f, "value", "")
    for o in optional(f, "options", []) { if "" + optional(o, "value", "") == v { return option_title(o) } }
    v
}
fn choice_chosen(t, f, title){
    if t == nil || pt_modal { return }
    for o in optional(f, "options", []) {
        if option_title(o) == title { write_field(t, f, "" + optional(o, "value", "")) }
    }
    render_canvas()
    ui.keys.focus()
}
// The value goes to the engine, and shows at once: the page's own picture follows.
fn write_field(t, f, value){
    if history_guard(t) { return }
    let before = optional(f, "value", nil)
    f.value = value
    let values = {}
    values[f.name] = value
    engine("fill", {doc: t.doc values: values}, fn(a){
        wrote(a)
        if !a.is_ok {
            f.value = before
            note(action_failed("fill the field", a.error))
            render_right()
            if !canvas_held(t) { render_canvas() }
            return
        }
        invalidate_page(t, f.page)
        changed(t)
    })
    render_right()
    render_toolrow()
}
// What the field being typed in holds goes in: it was left for another field, the
// page, another mode or tab, Undo, Save or Close. Nothing is drawn here.
fn commit_field(t){
    if t == nil || t.field == nil { return }
    let f = field_named(t, t.field)
    let typing = t.field_typing
    t.field_focus_pending = false
    t.field = nil
    t.field_typing = false
    if f != nil && typing && t.field_text != field_shown(f) { write_field(t, f, t.field_text) }
}
// Return, or Esc (which leaves the value as it was): the field closes and the keys go
// back to the page.
fn close_field(t, keep){
    if t == nil || t.field == nil { return }
    let pending = try { t.field_wait == true } catch { false }
    if pending { note("The field is still being applied.") return }
    let retry = try { t.field_retry } catch { nil }
    if retry != nil && keep { retry_field(t) return }
    if retry != nil {
        t.field_retry = nil
        t.field_problem = ""
        render_status()
    }
    if keep && field_handoff(t, nil, "finish", nil) { return }
    if keep { commit_field(t) }
    t.field_focus_pending = false
    t.field = nil
    t.field_typing = false
    render_canvas()
    render_right()
    render_toolrow()
    render_actions()
    render_status()
    render_tabs()
    ui.keys.focus()
}
// Tab and Shift-Tab: the next field that fills in, in the form's own order.
fn next_field(t, name, back){
    let list = []
    for f in t.fields { if !read_only(f) && fillable(f) { list.push(f) } }
    if list.len() == 0 { return nil }
    let at = -1
    for i f in list { if f.name == name { at = i } }
    if at < 0 { return list[0] }
    list[(at + pick(back, list.len() - 1, 1)) % list.len()]
}
fn tab_field(t, text, back){
    if t == nil || t.field == nil { return }
    t.field_text = text
    let next = next_field(t, t.field, back)
    if next == nil || next.name == t.field {
        close_field(t, true)
        return
    }
    select_field(t, next)
}
fn fill_tap(t, p, x, y){
    if t.place != nil {
        place_mark(t, p, x, y)
        return
    }
    if t.fields == nil { return }
    let hit = nil
    for f in t.fields { if hit == nil && f.page == p && inside(f.rect, x, y) { hit = f } }
    if hit != nil {
        tap_field(t, hit)
        return
    }
    close_field(t, true)
}
fn field_row_menu(f){
    if read_only(f) || !fillable(f) { return ["Go to Field"] }
    ["Go to Field", "-", "Clear Field"]
}
fn field_row_chosen(t, f, title){
    if t == nil || pt_modal { return }
    if history_guard(t) { return }
    if title == "Go to Field" {
        if read_only(f) || !fillable(f) { view_field(t, f) } else { select_field(t, f) }
    }
    if title == "Clear Field" && !field_empty(f) {
        if field_guard(t) { return }
        if t.field == f.name { close_field(t, false) }
        write_field(t, f, pick(is_check(f), false, ""))
        if !canvas_held(t) { render_canvas() }
    }
}
fn start_place(t, kind){
    if field_guard(t) { return }
    if field_handoff(t, nil, "continue", || start_place(t, kind)) { return }
    if draft_guard(t, "choosing another tool") { return }
    let was = pending_draft(t)
    close_field(t, true)
    t.place = {kind: kind}
    if kind == "initials" { t.place_text = st.who.initials } else { t.place_text = "" }
    draft_changed(t, was)
    render_right()
    render_toolrow()
    if kind != "date" { start_timeout(0.05, || { if t.place != nil { ui.place_field.focus() } }) }
}
fn end_place(t){
    let was = pending_draft(t)
    t.place = nil
    draft_changed(t, was)
    render_toolrow()
    render_right()
    ui.keys.focus()
}
fn place_hint(t){
    if t.place.kind == "initials" { return "Click the page where your initials go." }
    if t.place.kind == "date" { return "Click the page where the date goes." }
    "Click the page where the text goes."
}
fn place_mark(t, p, x, y){
    let text = t.place_text.trim()
    if text == "" && t.place.kind != "date" {
        note(pick(t.place.kind == "initials", "Type your initials first.", "Type the text first."))
        return
    }
    if t.place.kind == "initials" {
        st.who.initials = text
        save_index()
    }
    let args = {doc: t.doc page: p kind: t.place.kind at: [x, y] text: text}
    if t.place.kind == "date" { args = {doc: t.doc page: p kind: "date" at: [x, y]} }
    engine("fill_sign", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("place it", a.error))
            return
        }
        t.place = nil
        invalidate_page(t, p)
        changed(t)
        render_right()
        render_toolrow()
        render_canvas()
        pump()
        ui.keys.focus()
    })
}

// ---- Pages: rotate, delete, move, insert, extract --------------------------

// A click on a tile; two on the same one read that page.
fn tile_tap(t, p, cmd, shift){
    let now = time_now()
    let twice = !cmd && !shift && st.tile_tapped == p && now - st.tile_tapped_at < 0.4
    st.tile_tapped = p
    st.tile_tapped_at = now
    if twice {
        t.page = p
        set_mode(t, "read")
        ui.keys.focus()
        return
    }
    tile_click(t, p, cmd, shift)
}
// A click selects as a Mac's list does: one page; with Command, this one in or out;
// with Shift, the run from the last one clicked, kept with what Command had picked.
fn tile_click(t, p, cmd, shift){
    if shift && t.sel_from > 0 {
        let lo = min(t.sel_from, p)
        let hi = max(t.sel_from, p)
        let run = []
        for x in t.sel_base { if x < lo || x > hi { run.push(x) } }
        for i in hi - lo + 1 { run.push(lo + i) }
        t.selected = run
    } else if cmd {
        if has(t.selected, p) { t.selected.retain(|x| x != p) } else { t.selected.push(p) }
        t.sel_from = p
        let base = []
        for x in t.selected { if x != p { base.push(x) } }
        t.sel_base = base
    } else {
        t.selected = [p]
        t.sel_from = p
        t.sel_base = []
    }
    t.page = p
    render_grid()
    render_toolrow()
    render_counter()
    ui.keys.focus()
}
// A click beside the pages clears the selection.
fn grid_clear(t){
    if t == nil { return }
    t.selected = []
    t.sel_from = 0
    render_grid()
    render_toolrow()
    ui.keys.focus()
}
// A tile's or a thumbnail's menu acts on the selection if the page is in it, otherwise
// on that page alone, which a tile's menu selects first, as a Mac's list does.
let PAGE_MENU = ["Rotate Left", "Rotate Right", "-", "Delete", "Extract"]
fn page_menu(t, p, title){
    if t == nil || pt_modal { return }
    let pages = [p]
    if t.mode == "pages" {
        if !has(t.selected, p) {
            t.selected = [p]
            t.sel_from = p
            render_grid()
            render_toolrow()
        }
        pages = chosen(t)
    }
    if title == "Rotate Left" { rotate_pages(t, pages, -90) }
    if title == "Rotate Right" { rotate_pages(t, pages, 90) }
    if title == "Delete" { delete_these(t, pages) }
    if title == "Extract" { extract_these(t, pages) }
}
// The selection in page order, at most what one call may name.
fn chosen(t){
    let out = []
    for i in t.pages { if has(t.selected, i + 1) && out.len() < MAX_NAMED { out.push(i + 1) } }
    out
}
fn page_op(t, args, what, done){
    if draft_guard(t, "changing pages") { return }
    args.doc = t.doc
    engine("pages", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed(what, a.error))
            return
        }
        changed(t)
        done(a.data)
    })
}
fn rotate(t, angle){ rotate_pages(t, chosen(t), angle) }
fn rotate_pages(t, pages, angle){
    if pages.len() == 0 { note("Choose pages to rotate.") return }
    page_op(t, {op: "rotate" pages: pages angle: angle}, "rotate the pages", |v| {
        for p in pages { invalidate_page(t, p) }
        reload_shape(t, nil)
    })
}
fn delete_pages(t){ delete_these(t, chosen(t)) }
fn delete_these(t, pages){
    if pages.len() == 0 { note("Choose pages to delete.") return }
    if pages.len() >= t.pages { note("A PDF keeps at least one page.") return }
    page_op(t, {op: "delete" pages: pages}, "delete the pages", |v| {
        invalidate(t)
        t.selected = []
        t.sel_from = 0
        reload_shape(t, nil)
    })
}
fn extract_pages(t){ extract_these(t, chosen(t)) }
fn extract_these(t, pages){
    if pages.len() == 0 { note("Choose pages to extract.") return }
    let name = unique_name(t.title + " pages") + ".pdf"
    page_op(t, {op: "extract" pages: pages out: LIBRARY + "/" + name}, "extract the pages", |v| {
        scan_library()
        let d = doc_named(name)
        if d != nil {
            d.pages = pages.len()
            remember(d)
        }
        note("Extracted " + plural(pages.len(), "page", "pages") + " into “" + stem(name) + "”. It's on Home.")
    })
}
// Insert from File…: this library's other PDFs, or one from the device, which joins
// the library and goes in.
// A PDF from this device: "Import…" on a Mac, where Open… lists the PDFs in PDF Tools.
let IMPORT_WORD = pick(ui_unified, "Import…", "Open PDF…")
fn insert_titles(t){
    let out = []
    for d in st.docs {
        if d.name != t.name && d.error == "" && !d.locked { out.push(shown_name(d.title)) }
    }
    if st.files_ok {
        if out.len() > 0 { out.push("-") }
        out.push(IMPORT_WORD)
    }
    out
}
fn insert_chosen(t, title){
    if t == nil || pt_modal { return }
    if title == IMPORT_WORD {
        st.insert_into = t.name
        open_from_device()
        return
    }
    for d in st.docs { if shown_name(d.title) == title && d.name != t.name { insert_file(t, d) } }
}
fn insert_file(t, d){
    let after = t.pages
    let pages = chosen(t)
    if pages.len() > 0 { after = pages[pages.len() - 1] }
    page_op(t, {op: "insert_file" path: d.path at: after + 1}, "insert the pages", |v| {
        invalidate(t)
        t.selected = []
        t.sel_from = 0
        reload_shape(t, nil)
        note("Inserted “" + d.title + "” after page " + after + ".")
    })
}
// Drag a page tile to move it: the pan's offset, in tiles, decides where.
fn tile_w(t){ round(150 * t.tile) }
fn tile_h(t){ round(tile_w(t) * 1.32) }
fn grid_cols(t){ max(1, floor((canvas_w() - 40 + 20) / (tile_w(t) + 32))) }
fn drag_target(t, p, dx, dy){
    let cols = grid_cols(t)
    let col = (p - window_start(t)) % cols
    let row = floor((p - window_start(t)) / cols)
    let c = clamp(round(col + dx / (tile_w(t) + 32)), 0, cols - 1)
    let r = max(0, row + round(dy / (tile_h(t) + 43)))
    clamp(window_start(t) + r * cols + c, 1, t.pages)
}
// While a press holds a tile, the grid can't be drawn again (a render that would
// replace what a press holds waits for it), so the drop's marker and the toolbar's
// words draw on their own.
fn tile_pan(t, p, dx, dy, phase){
    if phase == 0 {
        t.drag = {page: p to: p}
        render_toolrow()
        ui.drag_mark.render()
        return
    }
    if t.drag == nil { return }
    let to = drag_target(t, p, dx, dy)
    if phase == 1 {
        if to != t.drag.to {
            t.drag.to = to
            render_toolrow()
            ui.drag_mark.render()
        }
        return
    }
    t.drag = nil
    render_toolrow()
    ui.drag_mark.render()
    if to == p { return }
    let pages = pick(has(t.selected, p), chosen(t), [p])
    page_op(t, {op: "move" pages: pages to: to}, "move the pages", |v| {
        invalidate(t)
        t.selected = []
        t.sel_from = 0
        reload_shape(t, nil)
    })
}
// Where a tile sits in the grid's scroll, in points from the grid's top left.
fn tile_at(t, p){
    let cols = grid_cols(t)
    let row_w = cols * (tile_w(t) + 12) + (cols - 1) * 20
    let off = p - window_start(t)
    let x = max(20, floor((canvas_w() - row_w) / 2)) + (off % cols) * (tile_w(t) + 32)
    let y = 14 + pick(window_start(t) > 1, 42, 0) + floor(off / cols) * (tile_h(t) + 43)
    [x, y]
}
// The keys moved to `p`: its tile comes into view.
fn reveal_tile(t, p){
    let at = tile_at(t, p)
    let y = ui.grid.scroll_y()
    let h = tile_h(t) + 43
    if at[1] < y { ui.grid.set_scroll_y(max(0, at[1] - 8)) }
    if at[1] + h > y + canvas_h() { ui.grid.set_scroll_y(at[1] + h - canvas_h() + 8) }
}

// ---- Combine ------------------------------------------------------------------

fn start_combine(t){
    if t.combine != nil { return }
    let d = doc_named(t.name)
    t.combine = {items: [] name: unique_name(t.title + " combined") busy: false error: "" adding: false editing: -1 pick: -1}
    if d != nil { t.combine.items.push({name: d.name title: d.title pages: t.pages range: ""}) }
}
fn combine_add(t, d){
    let c = t.combine
    if c.items.len() >= MAX_MERGE {
        note("PDF Tools combines up to " + MAX_MERGE + " PDFs at a time.")
        return
    }
    c.items.push({name: d.name title: d.title pages: d.pages range: ""})
    c.adding = false
    c.error = ""
    render_combine()
}
fn combine_remove(t, i){
    let c = t.combine
    let kept = []
    for k it in c.items { if k != i { kept.push(it) } }
    c.items = kept
    c.error = ""
    render_combine()
}
fn combine_move(t, i, dy){
    let c = t.combine
    let j = clamp(i + round(dy / (COMBINE_ROW + 1)), 0, c.items.len() - 1)
    if j == i { return }
    let moving = c.items[i]
    let rest = []
    for k it in c.items { if k != i { rest.push(it) } }
    let out = []
    for k it in rest {
        if k == j { out.push(moving) }
        out.push(it)
    }
    if j >= rest.len() { out.push(moving) }
    c.items = out
    render_combine()
}
fn combine_row_menu(t, i, title){
    if t == nil || pt_modal { return }
    if title == "Remove" { combine_remove(t, i) }
    if title == "Move Up" { combine_move(t, i, -(COMBINE_ROW + 1)) }
    if title == "Move Down" { combine_move(t, i, COMBINE_ROW + 1) }
}
fn item_pages(it){
    let total = it.pages
    if total == nil {
        let d = doc_named(it.name)
        if d != nil { total = d.pages }
    }
    if total == nil { return nil }
    range_pages(it.range, total)
}
fn item_count(it){
    let pages = item_pages(it)
    if pages == nil { return nil }
    pages.len()
}
fn combine_total(t){
    let total = 0
    for it in t.combine.items {
        let n = item_count(it)
        if n == nil { return nil }
        total = total + n
    }
    total
}
fn combine_problem(t){
    let c = t.combine
    if c.items.len() < 2 { return "Add another PDF to combine." }
    for it in c.items { if item_count(it) == nil { return "Check the pages of “" + it.title + "”: use numbers and ranges such as 1-4, 9." } }
    if c.name.trim() == "" { return "Give the new PDF a name." }
    if c.name.search("/") >= 0 { return "A name can't contain “/”." }
    if fs.exists(LIBRARY + "/" + c.name.trim() + ".pdf") { return "A PDF with this name is already in PDF Tools." }
    ""
}
fn do_combine(t){
    let c = t.combine
    if c.busy { return }
    let problem = combine_problem(t)
    if problem != "" {
        c.error = problem
        render_combine()
        return
    }
    let paths = []
    for it in c.items {
        let path = LIBRARY + "/" + it.name
        if range_arg(it.range) == "" { paths.push(path) } else { paths.push({path: path pages: range_arg(it.range)}) }
    }
    let name = c.name.trim() + ".pdf"
    c.busy = true
    c.error = ""
    render_combine()
    engine("merge", {paths: paths out: LIBRARY + "/" + name}, fn(a){
        c.busy = false
        wrote(a)
        if !a.is_ok {
            c.error = action_failed("combine them", a.error)
            render_combine()
            return
        }
        let total = combine_total(t)
        st.index[name] = {pages: total bytes: optional(a.data, "bytes", nil)}
        save_index()
        scan_library()
        let d = doc_named(name)
        t.combine = nil
        set_mode(t, "read")
        if d != nil { open_doc(d) }
        note("Combined into “" + stem(name) + "”, " + plural(total, "page", "pages") + ".")
    })
}

// ---- Edit -------------------------------------------------------------------

fn edit_tap(t, p, x, y){
    if draft_guard(t, "editing another paragraph") { return }
    if !t.can_edit {
        note("This PDF doesn't allow editing.")
        return
    }
    with_lines(t, p, |lines| {
        let hit = nil
        for g in optional(lines, "paragraphs", []) { if hit == nil && inside(g.box, x, y) { hit = g } }
        if hit == nil {
            note("Click a paragraph of text to edit it.")
            return
        }
        // Its lines' boxes show how it is aligned (guess_align).
        let boxes = []
        for n in optional(hit, "lines", []) {
            for l in optional(lines, "lines", []) { if l.n == n { boxes.push(l.box) } }
        }
        let align = guess_align(boxes)
        // `check`: what pdf.edit_check said for the edit as it was
        // (`checked`, its edit_key), or why it can't be made (`check_error`).
        t.edit_problem = ""
        t.edit = {page: p n: hit.n box: hit.box text: hit.text draft: hit.text font: optional(hit, "font", "") size: optional(hit, "size", 0)
            align: align align0: align color: nil
            pieces: line_pieces(optional(lines, "paragraphs", []), hit.n)
            check: nil checked: "" check_error: "" check_n: 0 apply_after: ""}
        render_canvas()
        render_right()
        render_status()
        check_edit(t)
        start_timeout(0.05, || { if t.edit != nil { ui.edit_input.focus() } })
    })
}
// Ask the engine what the edit would do as it stands (pdf.edit_check): the
// right panel says it before Apply. A check that comes back for an older
// draft is dropped. When Apply is waiting on it (`apply_after`), the edit is
// made if there is nothing to say; otherwise the panel says it, and Apply
// (now "Apply anyway") makes it.
fn check_edit(t){
    let e = t.edit
    if e == nil || edit_busy(t) || history_busy(t) { return }
    let key = edit_key(e)
    engine("edit_check", edit_args(t.doc, e), fn(a){
        let now = t.edit
        if now == nil || edit_busy(t) || history_busy(t) || now.page != e.page || now.n != e.n || edit_key(now) != key { return }
        now.checked = key
        now.check = nil
        now.check_error = ""
        if a.is_ok { now.check = a.data } else { now.check_error = check_refusal(a.error) }
        let go = now.apply_after == key && now.check_error == "" && edit_risks(now.check).len() == 0
        now.apply_after = ""
        if showing_tab(t) { render_right() }
        if go { make_edit(t) }
    })
}
// A check's refusal in the engine's plain words (SERVICE.md: the code, then
// words for a person); nothing for an engine without the check (an older
// shell) or no engine, where Apply finds out.
fn check_refusal(error){
    if missing(error) || outdated(error) { return "" }
    err_words(error)
}
// Check again once typing (or a change of alignment or colour) pauses.
fn schedule_check(t){
    let e = t.edit
    if e == nil { return }
    e.check_n = e.check_n + 1
    let n = e.check_n
    start_timeout(0.6, || {
        let now = t.edit
        if now != nil && now.page == e.page && now.n == e.n && now.check_n == n { check_edit(t) }
    })
}
// Apply: an edit checked as it stands is made (the panel has said what it
// would do); one not checked yet is checked first.
fn apply_edit(t){
    if history_guard(t) { return }
    if edit_guard(t) { return }
    let e = t.edit
    if e == nil { return }
    if !edit_changes(e) {
        t.edit = nil
        t.edit_problem = ""
        render_canvas()
        render_right()
        render_status()
        render_tabs()
        return
    }
    let key = edit_key(e)
    if e.checked != key {
        e.apply_after = key
        check_edit(t)
        return
    }
    if e.check_error != "" {
        note("Couldn't change the text: " + e.check_error)
        return
    }
    make_edit(t)
}
fn make_edit(t){
    let e = t.edit
    if e == nil || edit_busy(t) || history_busy(t) { return }
    t.edit_wait = true
    t.edit_problem = ""
    render_canvas()
    render_right()
    render_status()
    engine("edit_text", edit_args(t.doc, e), fn(a){
        t.edit_wait = false
        wrote(a)
        if !a.is_ok {
            t.edit_problem = action_failed("change the text", a.error)
            if showing_tab(t) { render_canvas() render_right() render_status() }
            else { render_status() }
            return
        }
        t.edit = nil
        invalidate_page(t, e.page)
        changed(t)
        if showing_tab(t) { render_right() render_canvas() }
        pump()
    })
}
fn cancel_edit(t){
    if history_guard(t) { return }
    if edit_guard(t) { return }
    let was = pending_draft(t)
    t.edit = nil
    t.edit_problem = ""
    draft_changed(t, was)
    render_canvas()
    render_right()
    render_status()
    ui.keys.focus()
}
fn set_align(t, a){
    if t == nil || t.edit == nil { return }
    if history_guard(t) { return }
    if edit_guard(t) { return }
    let was = pending_draft(t)
    t.edit.align = a
    if !edit_changes(t.edit) { t.edit_problem = "" render_status() }
    draft_changed(t, was)
    render_right()
    schedule_check(t)
}
// `hex` nil: the paragraph keeps its own colour.
fn set_colour(t, hex){
    if t == nil || t.edit == nil { return }
    if history_guard(t) { return }
    if edit_guard(t) { return }
    let was = pending_draft(t)
    t.edit.color = hex
    if !edit_changes(t.edit) { t.edit_problem = "" render_status() }
    draft_changed(t, was)
    render_right()
    schedule_check(t)
}
fn colour_titles(){
    let out = [colour_shown(nil), "-"]
    for c in TEXT_COLOURS { out.push(colour_shown(c.hex)) }
    out
}
fn colour_chosen(title){
    let t = cur_tab()
    if t == nil || pt_modal { return }
    if title == colour_shown(nil) { set_colour(t, nil) }
    for c in TEXT_COLOURS { if colour_shown(c.hex) == title { set_colour(t, c.hex) } }
}

// ---- modes and panels ---------------------------------------------------------

fn set_mode(t, m){
    if t.mode == m { return }
    if field_guard(t) { return }
    if field_handoff(t, nil, "continue", || set_mode(t, m)) { return }
    if draft_guard(t, "changing modes") { return }
    commit_field(t)
    unsay()
    t.read_sel = 0
    // Comment and Edit start with the left panel folded (04-comment,
    // 08-edit); leaving them brings it back.
    let wide = |x| x == "comment" || x == "edit"
    if wide(m) && !wide(t.mode) {
        t.panel_kept = t.panel
        t.panel = ""
    }
    if !wide(m) && wide(t.mode) && t.panel == "" { t.panel = t.panel_kept }
    if t.mode == "edit" && m != "edit" { t.edit_problem = "" }
    if t.mode == "comment" && m != "comment" { t.comment_problem = "" }
    t.mode = m
    t.place = nil
    t.pending = nil
    t.drag = nil
    if m != "edit" { t.edit = nil }
    if m == "comment" && t.comments == nil { load_comments(t) }
    if m == "fill" && t.fields == nil { load_fields(t) }
    if m == "combine" { start_combine(t) }
    // Until the person zooms, the page fits the canvas the mode leaves it,
    // up to 100%.
    auto_fit(t)
    show()
    if m != "pages" && m != "combine" { go_page(t, t.page) }
    pump()
}
// The automatic zoom worked out again for the canvas there is now: whether
// it changed.
fn auto_fit(t){
    if t.state != "ready" { return false }
    let was = t.zoom
    if t.fit != "" { refit(t) }
    if t.fit == "" && t.zoom_auto { t.zoom = start_zoom(t) }
    t.zoom != was
}

// ---- size --------------------------------------------------------------------

// The shell calls this when the app's window changes size, on every frame
// of its open animation too (Photos does the same): settle, then lay out.
fn on_app_resize(width, height){
    if width <= 0 { return }
    if abs(width - st.width) < 2 && abs(height - st.height) < 2 { return }
    st.width = width
    st.height = height
    st.resize_n = st.resize_n + 1
    let n = st.resize_n
    start_timeout(0.3, || {
        if n != st.resize_n || !st.booted { return }
        let t = cur_tab()
        if t != nil && auto_fit(t) { go_page(t, t.page) }
        show()
    })
}

// ---- drawing: each region renders on its own ----------------------------------

// The tab strip shows once a PDF is open.
fn tabs_shown(){ chrome_for(reading_on(cur_tab())).tabs && st.tabs.len() > 0 }
fn render_tabs(){
    ui.tabs_box.set_visible(tabs_shown())
    ui.tabs.render()
}
// A sheet hangs from the foot of the window's top: under the toolbar, and under the
// tab bar while the tabs show, as AppKit hangs one below a window's tab bar.
fn sheet_top(){ BAR_H + 1 + pick(tabs_shown(), TABS_H + 1, 0) }
fn render_home(){
    if st.screen == "home" {
        ui.home_pane.render()
        render_modebar()
        render_status()
    }
}
fn render_modebar(){ ui.modebar.render() }
fn render_actions(){ ui.modebar.render() }
fn render_canvas(){ ui.canvas.render() }
fn render_counter(){
    // A Mac's page count is in the mode bar (mac_modebar); the sidebar's button stays here.
    ui.pagebar.render()
    if ui_unified { ui.modebar.render() }
    ui.read_bar.render()
}
fn render_toolrow(){ ui.toolrow.render() }
fn render_grid(){ ui.grid.render() }
fn render_combine(){
    ui.combine_list.render()
    ui.combine_tall_foot.render()
}
fn render_status(){ ui.status.render() }
fn render_dialog(){
    ui.dialog_box.set_visible(st.confirm != nil || st.removing != "" || st.going || st.open_sheet)
    ui.dialog.render()
    sync_modal()
}
fn render_right(){
    ui.right_thread.render()
    ui.right_side.render()
}
fn render_panel(){
    ui.panel_head.render()
    ui.thumbs.render()
    ui.list_head.render()
    ui.outline.render()
    ui.notes.render()
    ui.results.render()
}
fn refresh_doc(){
    if st.screen != "doc" { render_tabs() return }
    show()
}
// Which regions show, then every region drawn again.
fn show(){ show_with_search(true) }
fn show_with_search(refresh_search){
    let t = cur_tab()
    let doc = t != nil
    let c = chrome_for(reading_on(t))
    screen_back()
    ui.home.set_visible(!doc)
    ui.doc.set_visible(doc)
    ui.modebar_box.set_visible(c.modebar)
    ui.status_box.set_visible(c.status)
    if doc {
        let ready = t.state == "ready"
        let left = ready && c.panels && c.rail && left_open(t)
        ui.toolrow_box.set_visible(c.toolrow)
        ui.panel_narrow.set_visible(left && t.panel == "pages")
        ui.panel_wide.set_visible(left && t.panel != "pages")
        ui.line_left.set_visible(left)
        ui.thumbs.set_visible(t.panel == "pages")
        ui.outline_box.set_visible(t.panel == "outline")
        ui.notes_box.set_visible(t.panel == "comments")
        ui.results_box.set_visible(t.panel == "search")
        ui.right_thread_box.set_visible(ready && c.right && t.mode == "comment")
        ui.right_side_box.set_visible(ready && c.right && (t.mode == "fill" || t.mode == "edit"))
        ui.line_right.set_visible(ready && c.right && right_open(t))
        ui.canvas.set_visible(ready && t.mode != "pages" && t.mode != "combine")
        ui.grid_box.set_visible(ready && t.mode == "pages")
        ui.combine_box.set_visible(ready && t.mode == "combine")
        ui.notice_box.set_visible(!ready)
        ui.read_bar_box.set_visible(ready && c.exit)
        ui.notice.render()
        render_panel()
        render_toolrow()
        render_right()
        if ready && t.mode == "pages" { render_grid() }
        if ready && t.mode == "combine" { render_combine() }
        if ready && t.mode != "pages" && t.mode != "combine" && !canvas_held(t) { render_canvas() }
    } else {
        ui.home_pane.render()
    }
    render_modebar()
    if refresh_search { ui.search_tools.render() }
    render_counter()
    render_tabs()
    render_status()
    render_dialog()
}

// Every 2 s: a boot that a script budget abort cut short starts again, and
// the pump picks up work an aborted callback left (Quick Deck needed the
// same under machine load). Made once: a restyle runs this file again.
fn heartbeat(){
    if !st.booted { boot() return }
    if optional(st, "index_dirty", false) { save_index() }
    pump()
}
fn boot(){
    if st.booted {
        resume()
        return
    }
    load_index()
    scan_library()
    st.booted = true
    show()
    check_files()
    pump()
    ui.keys.focus()
}
// After a restyle: the same screen, every region drawn with the new look.
fn resume(){
    // The search view follows the new theme without being rebuilt. Keeping it
    // preserves its focused input and caret across an appearance change.
    show_with_search(false)
    pump()
    let t = cur_tab()
    let search_has_focus = try { ui.search.has_focus() } catch { false }
    if (t == nil || !t.field_typing) && !search_has_focus { ui.keys.focus() }
    if t != nil && t.mode == "fill" && t.field_typing && t.field != nil && optional(t, "field_focus_pending", false) && !pt_modal {
        let doc = t.doc
        let name = t.field
        let focus_n = optional(t, "field_focus_n", 0)
        start_timeout(0.15, || focus_selected_field(doc, name, focus_n, 0))
    }
}
// The page the toolbar counts follows the scroll: the one that crosses the line a third
// of the way down the canvas.
fn watch_page(){
    let t = cur_tab()
    if t == nil || t.state != "ready" || st.blank || t.mode == "pages" || t.mode == "combine" { return }
    let y = ui.canvas.scroll_y()
    if y == st.scroll_seen { return }
    st.scroll_seen = y
    let line = y + canvas_h() * 0.35
    let top = PAGE_TOP
    let at = t.anchor
    // At the top of the run, the page it starts with, however short.
    let found = y <= 1
    for i in run_end(t) - t.anchor + 1 {
        let p = t.anchor + i
        top = top + page_box(t, p)[1] + PAGE_GAP
        if !found {
            at = p
            found = top > line
        }
    }
    if at == t.page { return }
    t.page = at
    remember_place(t)
    render_counter()
    render_panel()
    reveal_thumb(t)
}
// The current page's thumbnail comes into view in the sidebar.
fn reveal_thumb_later(){ start_timeout(0.12, || reveal_thumb(cur_tab())) }
fn reveal_thumb(t){
    if t == nil || t.state != "ready" || !left_open(t) || t.panel != "pages" { return }
    let y = pick(window_start(t) > 1, 32, 0)
    for i in t.page - window_start(t) {
        let s = page_pt(t, window_start(t) + i)
        y = y + round(THUMB_W * s[1] / max(1, s[0])) + 34
    }
    let now = ui.thumbs.scroll_y()
    let s = page_pt(t, t.page)
    let h = round(THUMB_W * s[1] / max(1, s[0])) + 34
    let room = canvas_h() - 34
    if y < now { ui.thumbs.set_scroll_y(y) }
    if y + h > now + room { ui.thumbs.set_scroll_y(y + h - room) }
}

// ---- the keyboard: the page, the Pages grid and Home ---------------------------

fn app_key(key, cmd, shift){
    // Go to Page's buttons answer Return and Escape.
    if st.going { return }
    if st.removing != "" || st.confirm != nil {
        if key == "Escape" { cancel_sheet() }
        if key == "ReturnKey" && st.confirm != nil { save_and_close(tab_named(st.confirm)) }
        return
    }
    // The Open sheet's buttons answer Return and Escape.
    if st.open_sheet { return }
    let t = cur_tab()
    if t == nil {
        home_key(key, cmd)
        return
    }
    if t.state != "ready" || t.mode == "combine" { return }
    if t.mode == "pages" {
        pages_key(t, key, cmd, shift)
        return
    }
    if cmd { return }
    if t.mode == "fill" && field_key(t, key, shift) { return }
    if key == "Escape" {
        if reading_on(t) { leave_reading(t) return }
        if t.edit != nil { cancel_edit(t) return }
        if t.place != nil { end_place(t) return }
        if t.pending != nil {
            if comment_busy(t) { note("The comment is still being posted.") return }
            let was = pending_draft(t)
            t.pending = nil
            t.reply = ""
            t.comment_problem = ""
            draft_changed(t, was)
            render_status()
            render_right()
            render_canvas()
            return
        }
        if t.find != nil { end_find(t) }
        return
    }
    if key == "ArrowLeft" { step_page(t, -1) }
    if key == "ArrowRight" { step_page(t, 1) }
    if key == "ArrowUp" { canvas_by(t, -48) }
    if key == "ArrowDown" { canvas_by(t, 48) }
    if key == "PageUp" { canvas_by(t, 48 - canvas_h()) }
    if key == "PageDown" { canvas_by(t, canvas_h() - 48) }
    if key == "Space" { canvas_by(t, pick(shift, 48 - canvas_h(), canvas_h() - 48)) }
    if key == "Home" { go_page(t, 1) }
    if key == "End" { go_page(t, t.pages) }
}
// The run's height on the canvas.
fn run_height(t){
    let h = PAGE_TOP + 14
    for i in run_end(t) - t.anchor + 1 { h = h + page_box(t, t.anchor + i)[1] + PAGE_GAP }
    if run_end(t) < t.pages { h = h + 32 + PAGE_GAP }
    h
}
// Scroll the page by `dy`; past the run's end, the next run or the one before.
fn canvas_by(t, dy){
    let y = ui.canvas.scroll_y()
    let bottom = max(0, run_height(t) - canvas_h())
    if dy > 0 && y >= bottom - 1 {
        if run_end(t) < t.pages { go_page(t, run_end(t) + 1) }
        return
    }
    if dy < 0 && y <= 1 {
        if t.anchor > 1 { go_page(t, t.anchor - 1) }
        return
    }
    ui.canvas.set_scroll_y(clamp(y + dy, 0, bottom))
}
// A field that is on but not being typed in: a check box or a choice. (Tab with none
// on starts at the form's first.) True when the key was the field's.
fn field_key(t, key, shift){
    if key == "Tab" && t.fields != nil && t.place == nil {
        let next = next_field(t, pick(t.field == nil, "", t.field), shift)
        if next != nil { select_field(t, next) }
        return true
    }
    if t.field == nil { return false }
    let f = field_named(t, t.field)
    if f == nil { return false }
    if key == "Escape" {
        close_field(t, false)
        return true
    }
    if (key == "Space" || key == "ReturnKey") && is_check(f) {
        flip_check(t, f)
        return true
    }
    if (key == "Space" || key == "ReturnKey") && is_choice(f) {
        open_choice(t, f)
        return true
    }
    false
}
fn pages_key(t, key, cmd, shift){
    if cmd && key == "KeyA" {
        select_all_pages(t)
        return
    }
    if cmd { return }
    if key == "Backspace" || key == "Delete" {
        delete_pages(t)
        return
    }
    if key == "Escape" {
        grid_clear(t)
        return
    }
    if key == "ReturnKey" {
        set_mode(t, "read")
        return
    }
    let cols = grid_cols(t)
    let to = t.page
    if key == "ArrowLeft" { to = t.page - 1 }
    if key == "ArrowRight" { to = t.page + 1 }
    if key == "ArrowUp" { to = t.page - cols }
    if key == "ArrowDown" { to = t.page + cols }
    if to == t.page || to < 1 || to > t.pages { return }
    if t.sel_from == 0 {
        t.sel_from = t.page
        t.sel_base = []
    }
    tile_click(t, to, false, shift)
    reveal_tile(t, to)
}
fn select_all_pages(t){
    let all = []
    for i in min(t.pages, MAX_NAMED) { all.push(i + 1) }
    t.selected = all
    t.sel_from = 1
    t.sel_base = []
    render_grid()
    render_toolrow()
}
fn home_key(key, cmd){
    let n = st.docs.len()
    if n == 0 { return }
    let at = st.home_at
    if cmd {
        if key == "Backspace" && at >= 0 && at < n { ask_remove(st.docs[at]) }
        return
    }
    if key == "ReturnKey" {
        if at >= 0 && at < n { open_doc(st.docs[at]) }
        return
    }
    if key == "Escape" {
        st.home_at = -1
        render_home()
        return
    }
    let cols = home_cols()
    let to = at
    if key == "ArrowLeft" { to = max(at, 1) - 1 }
    if key == "ArrowRight" { to = at + 1 }
    if key == "ArrowUp" { to = max(at, cols) - cols }
    if key == "ArrowDown" { to = pick(at < 0, 0, at + cols) }
    if to == at || to >= n { return }
    st.home_at = to
    render_home()
    // Its row comes into view: a card's cover, its two lines and the row's gap.
    let row_h = COVER_H + 72
    let y = 34 + floor(to / cols) * row_h
    let now = ui.home_pane.scroll_y()
    let room = st.height - BAR_H - FOOT_H - pick(st.tabs.len() > 0, TABS_H + 1, 0) - 2
    if y < now { ui.home_pane.set_scroll_y(max(0, y - 34)) }
    if y + row_h > now + room { ui.home_pane.set_scroll_y(y + row_h - room) }
}

// ---- the Mac's menu bar: what the toolbar and the keys do, by name ---------------

fn app_menus(){
    let free = !menus_wait()
    let t = cur_tab()
    let open = t != nil
    let ready = free && open && t.state == "ready"
    let dirty = open && (t.edited || field_dirty(t))
    let field_blocked = if open { try { t.field_wait == true || t.field_retry != nil } catch { false } } else { false }
    let history_blocked = open && (history_busy(t) || comment_delete_busy(t))
    let reading = ready && reading_on(t)
    let tools = ready && !reading
    let paged = ready && t.mode != "combine"
    let viewing = ready && t.mode != "pages" && t.mode != "combine"
    let found = ready && t.find != nil && t.find.matches.len() > 0
    let pages_on = ready && t.mode == "pages"
    let some = pick(pages_on, ready && chosen(t).len() > 0, viewing)
    let side_on = ready && left_open(t)
    let panel = ""
    if side_on { panel = t.panel }
    let can_pick = free && st.files_ok && !st.importing
    let mode_is = |id| ready && t.mode == id
    let rows = [
        {menu: "File" title: "Open PDF…" key: "cmd+O" command: "open" enabled: can_pick}
        {menu: "File"}
        {menu: "File" title: "Save" key: "cmd+S" command: "save" enabled: ready && dirty && !t.saving && !field_blocked && !history_blocked}
        {menu: "File" title: "Export as PDF…" command: "export" enabled: ready && !t.saving && !history_blocked && st.files_out}
        {menu: "File" title: "Close Tab" key: pick(open, "cmd+W", "") command: "close" enabled: free && open}
        {menu: "Edit" title: "Undo" key: "cmd+Z" command: "undo" enabled: ready && t.can_undo && !t.saving && !history_blocked}
        {menu: "Edit" title: "Redo" key: "shift+cmd+Z" command: "redo" enabled: ready && t.can_redo && !t.saving && !history_blocked}
        {menu: "Edit" title: "Select All" key: "cmd+A" command: "select_all" enabled: pages_on}
        {menu: "Edit" title: "Find…" key: "cmd+F" command: "find" enabled: tools}
        {menu: "Edit" title: "Find Next" key: "cmd+G" command: "find_next" enabled: found}
        {menu: "Edit" title: "Find Previous" key: "shift+cmd+G" command: "find_previous" enabled: found}
        {menu: "View" title: pick(side_on, "Hide Sidebar", "Show Sidebar") key: "ctrl+cmd+S" command: "sidebar" enabled: ready && side_can(t)}
        {menu: "View"}
        {menu: "View" title: "Pages" key: "alt+cmd+2" command: "side_pages" enabled: ready checked: panel == "pages"}
        {menu: "View" title: "Outline" key: "alt+cmd+3" command: "side_outline" enabled: ready checked: panel == "outline"}
        {menu: "View" title: "Comments" key: "alt+cmd+4" command: "side_comments" enabled: ready checked: panel == "comments"}
        {menu: "View"}
        {menu: "View" title: "Actual Size" key: "cmd+0" command: "zoom_actual" enabled: viewing}
        {menu: "View" title: "Zoom In" key: "cmd+=" command: "zoom_in" enabled: paged}
        {menu: "View" title: "Zoom Out" key: "cmd+-" command: "zoom_out" enabled: paged}
        {menu: "View" title: "Fit Width" command: "fit_width" enabled: viewing}
        {menu: "View" title: "Fit Page" command: "fit_page" enabled: viewing}
        {menu: "View"}
        {menu: "View" title: "Highlight Fields" command: "highlight" enabled: mode_is("fill") checked: mode_is("fill") && t.show_fields}
        {menu: "View" title: pick(reading, "Exit Read Mode", "Enter Read Mode") key: "shift+cmd+F" command: "read_mode" enabled: viewing}
        {menu: "Go" title: "Previous Page" key: "alt+cmd+up" command: "page_previous" enabled: paged && t.page > 1}
        {menu: "Go" title: "Next Page" key: "alt+cmd+down" command: "page_next" enabled: paged && t.page < t.pages}
        {menu: "Go"}
        {menu: "Go" title: "First Page" key: "cmd+up" command: "page_first" enabled: viewing && t.page > 1}
        {menu: "Go" title: "Last Page" key: "cmd+down" command: "page_last" enabled: viewing && t.page < t.pages}
        {menu: "Go"}
        {menu: "Go" title: "Go to Page…" key: "alt+cmd+G" command: "go_to_page" enabled: viewing && t.pages > 1}
        {menu: "Tools" title: "Read" key: "cmd+1" command: "mode_read" enabled: tools checked: mode_is("read")}
        {menu: "Tools" title: "Comment" key: "cmd+2" command: "mode_comment" enabled: tools checked: mode_is("comment")}
        {menu: "Tools" title: "Fill & Sign" key: "cmd+3" command: "mode_fill" enabled: tools checked: mode_is("fill")}
        {menu: "Tools" title: "Pages" key: "cmd+4" command: "mode_pages" enabled: tools checked: mode_is("pages")}
        {menu: "Tools" title: "Combine" key: "cmd+5" command: "mode_combine" enabled: tools checked: mode_is("combine")}
        {menu: "Tools" title: "Edit" key: "cmd+6" command: "mode_edit" enabled: tools checked: mode_is("edit")}
        {menu: "Tools"}
        {menu: "Tools" title: "Rotate Left" key: "cmd+L" command: "rotate_left" enabled: tools && some}
        {menu: "Tools" title: "Rotate Right" key: "cmd+R" command: "rotate_right" enabled: tools && some}
        {menu: "Tools" title: "Delete Pages" command: "delete_pages" enabled: pages_on && some}
        {menu: "Tools" title: "Extract Pages" command: "extract_pages" enabled: pages_on && some}
    ]
    if ui_unified { return mac_menu_rows(rows, free, can_pick) }
    rows
}
// The current page, or in Pages the selection.
fn acting_pages(t){ pick(t.mode == "pages", chosen(t), [t.page]) }
fn on_menu_command(command){
    if menus_wait() { return }
    let t = cur_tab()
    if command == "open" {
        open_from_device()
        return
    }
    if mac_menu_command(command) { return }
    if t == nil { return }
    if command == "close" {
        ask_close(t)
        return
    }
    if t.state != "ready" { return }
    if command == "save" { save(t, nil) }
    if command == "export" { export_pdf(t) }
    if command == "go_to_page" { goto_open(t) }
    if command == "undo" { undo(t, false) }
    if command == "redo" { undo(t, true) }
    if command == "select_all" && reads_text(t) {
        read_select_all(t)
        return
    }
    if command == "copy_text" {
        read_copy(t)
        return
    }
    if command == "select_all" { select_all_pages(t) }
    if command == "find" { t.field_focus_pending = false ui.search.focus() }
    if command == "find_next" && t.find != nil { go_match(t, t.find.cur + 1) }
    if command == "find_previous" && t.find != nil { go_match(t, t.find.cur - 1) }
    if command == "sidebar" { toggle_side(t) }
    if command == "side_pages" { side_show(t, "pages") }
    if command == "side_outline" { side_show(t, "outline") }
    if command == "side_comments" { side_show(t, "comments") }
    if command == "zoom_actual" { set_zoom(t, 1.0, "") }
    if command == "zoom_in" { zoom_by(1) }
    if command == "zoom_out" { zoom_by(-1) }
    if command == "fit_width" { fit_to("width") }
    if command == "fit_page" { fit_to("page") }
    if command == "highlight" { toggle_highlight(t, !t.show_fields) }
    if command == "read_mode" {
        if reading_on(t) { leave_reading(t) } else { enter_reading(t) }
    }
    if command == "page_previous" { page_step(-1) }
    if command == "page_next" { page_step(1) }
    if command == "page_first" { go_page(t, 1) }
    if command == "page_last" { go_page(t, t.pages) }
    if command == "mode_read" { set_mode(t, "read") }
    if command == "mode_comment" { set_mode(t, "comment") }
    if command == "mode_fill" { set_mode(t, "fill") }
    if command == "mode_pages" { set_mode(t, "pages") }
    if command == "mode_combine" { set_mode(t, "combine") }
    if command == "mode_edit" { set_mode(t, "edit") }
    if command == "rotate_left" { rotate_pages(t, acting_pages(t), -90) }
    if command == "rotate_right" { rotate_pages(t, acting_pages(t), 90) }
    if command == "delete_pages" { delete_pages(t) }
    if command == "extract_pages" { extract_pages(t) }
}

// ---- views: each returns one widget, drawn by a region's on_render ----------
// The Mac look (apps/AGENTS.md), with Preview as its model: a toolbar with the
// tab strip under it, a sidebar, the canvas, and an inspector.

let MODES = [{id: "read" label: "Read"}, {id: "comment" label: "Comment"}, {id: "fill" label: "Fill & Sign"}, {id: "pages" label: "Pages"}, {id: "combine" label: "Combine"}, {id: "edit" label: "Edit"}]

// The tab strip, as Quick Deck's: Home, one tab per open PDF sharing the width, a title
// centred in each, and at the end the way to open another. A tab's close is the Mac's:
// nothing until the pointer is over its place, a dot there while it has unsaved changes.
fn tabs_view(){
    if ui_unified { return mac_tabs_view() }
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5}
        home_tab()
        for i t in st.tabs {
            SolidView{width: 1 height: Fill draw_bg.color: ui_border}
            doc_tab(i, t)
        }
        SolidView{width: 1 height: Fill draw_bg.color: ui_border}
        View{width: 34 height: Fill align: Align{x: 0.5 y: 0.5}
            IconBtn{width: 26 height: 22 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("plus") color: ui_muted}
                on_click: || go_home()}
        }
    }
}
fn tab_band(on){ pick(on, ui_bar, pt_tabs) }
fn home_tab(){
    let on = st.screen == "home"
    GestureView{width: 40 height: Fill flow: Overlay cursor: MouseCursor.Default on_tap: |x, y| { if pt_modal { return } go_home() }
        SolidView{width: Fill height: Fill draw_bg.color: tab_band(on)}
        View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
            Ico{width: 18 height: 18 draw_svg +: {svg: icon("home") color: pick(on, ui_ink, ui_muted)}}
        }
    }
}
fn tab_menu(t){
    if t.state == "ready" { return ["Close Tab", "-", "Save"] }
    ["Close Tab"]
}
fn tab_chosen(i, t, title){
    if pt_modal { return }
    if title == "Close Tab" {
        ask_close(t)
        return
    }
    if title == "Save" {
        let current = cur_tab()
        if field_guard(current) { return }
        if current != nil && field_handoff(current, nil, "continue", || tab_chosen(i, t, title)) { return }
    }
    show_tab(i)
    if title == "Save" { save(t, nil) }
}
// The close: "×" in the band's colour until the pointer is over it (a Button's text
// has a hover colour, its icon doesn't); its hover face hides the dot.
fn tab_close(t, band){
    View{width: 26 height: Fill flow: Overlay align: Align{x: 0.5 y: 0.5}
        if t.edited || field_dirty(t) || pending_draft(t) { Label{clip_y: false padding: 0 text: "•" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 11.25}}} }
        ButtonFlat{width: 18 height: 18 margin: 0 padding: 0 text: "×" align: Align{x: 0.5 y: 0.5}
            draw_bg +: {border_radius: 2.5 border_size: 0.0 color: pt_clear color_hover: band color_down: band color_focus: pt_clear}
            draw_text +: {color: pt_clear color_hover: ui_ink color_down: ui_ink color_focus: pt_clear text_style: theme.font_regular{font_size: 11.25}}
            on_click: || ask_close(t)}
    }
}
fn doc_tab(i, t){
    let on = st.screen == "doc" && i == st.cur
    let band = tab_band(on)
    GestureView{width: Fill height: Fill flow: Overlay cursor: MouseCursor.Default
        menu: tab_menu(t)
        on_menu: |title| tab_chosen(i, t, title)
        on_tap: |x, y| { if pt_modal { return } show_tab(i) }
        SolidView{width: Fill height: Fill draw_bg.color: band}
        View{width: Fill height: Fill align: Align{y: 0.5} padding: Inset{left: 30 right: 30}
            Label{clip_y: false padding: 0 width: Fill align: Align{x: 0.5} max_lines: 1 text_overflow: TextOverflow.Ellipsis text: shown_name(t.title) draw_text +: {color: pick(on, ui_ink, ui_muted) text_style: theme.font_regular{font_size: 9}}}
        }
        View{width: Fit height: Fill align: Align{y: 0.5} padding: Inset{left: 4}
            tab_close(t, band)
        }
    }
}

// ---- a Mac's way to its PDFs ---------------------------------------------------------
//
// On a Mac the tab bar holds the open PDFs only, as a Mac's window tabs hold documents.
// File > Open… (and the tab bar's +) lists the PDFs in PDF Tools' storage as an Open
// panel lists a folder, File > Open Recent the ones opened lately, and Import… brings in
// a PDF from this Mac. With no PDF open the window shows the library (home_view), and
// Combine's Add Files… takes its PDFs from the same sheet.
fn mac_tabs_view(){
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5}
        for i t in st.tabs {
            if i > 0 { SolidView{width: 1 height: Fill draw_bg.color: ui_border} }
            doc_tab(i, t)
        }
        SolidView{width: 1 height: Fill draw_bg.color: ui_border}
        View{width: 34 height: Fill align: Align{x: 0.5 y: 0.5}
            IconBtn{width: 26 height: 22 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("plus") color: ui_muted}
                on_click: || library_open()}
        }
    }
}
// A second click on the same row within half a second: a double click. A click that
// picks a row draws the sheet again, and the new rows forget the first click, so the
// sheet counts the clicks itself.
fn second_click(key){
    let now = time_now()
    let again = st.click_key == key && now - st.click_at < 0.5
    st.click_key = pick(again, "", key)
    st.click_at = now
    again
}
fn library_open(){
    if pt_modal { return }
    let t = cur_tab()
    if field_guard(t) { return }
    scan_library()
    st.open_sheet = true
    st.open_for = ""
    st.open_pick = ""
    render_dialog()
}
// Combine's Add Files…: the same sheet, listing the PDFs Combine can take.
fn library_open_for(t){
    if pt_modal || t == nil || t.combine == nil { return }
    scan_library()
    st.open_sheet = true
    st.open_for = t.name
    st.open_pick = ""
    render_dialog()
}
fn library_close(){
    st.open_sheet = false
    st.open_for = ""
    st.open_pick = ""
    render_dialog()
    ui.keys.focus()
}
fn library_chosen(name){
    let d = doc_named(name)
    if d == nil { return }
    let into = tab_named(st.open_for)
    let combine = st.open_for != "" && into != nil && into.combine != nil
    library_close()
    if combine {
        combine_add(into, d)
        return
    }
    open_doc(d)
}
// Import… on the sheet: a PDF from this Mac, opened, or added to the Combine it was for.
fn library_import(){
    let into = st.open_for
    library_close()
    st.combine_into = into
    open_from_device()
}
fn library_menu(d, title){
    if title == "Open" || title == "Add" { library_chosen(d.name) }
    if title == "Remove…" { ask_remove(d) }
}
fn library_list(){
    let t = tab_named(st.open_for)
    let out = []
    for d in st.docs {
        if st.open_for == "" || t == nil || t.combine == nil { out.push(d) }
        else if !combine_has(t, d.name) && d.error == "" && !d.locked { out.push(d) }
    }
    out
}
fn library_row(d, days){
    let picked = d.name == st.open_pick
    let ink = pick(picked, #xffffff, ui_ink)
    let sub = pick(picked, #xffffffd8, pick(d.error != "" || d.locked, ui_danger, ui_muted))
    let src = optional(st.covers, d.name, nil)
    GestureView{width: Fill height: 46 cursor: MouseCursor.Default
        menu: [pick(st.open_for == "", "Open", "Add"), "-", "Remove…"]
        on_menu: |title| library_menu(d, title)
        on_tap: |x, y| {
            if second_click("pdf:" + d.name) {
                library_chosen(d.name)
                return
            }
            st.open_pick = d.name
            render_dialog()
        }
        RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 6 right: 10} spacing: 10 show_bg: true
            draw_bg +: {color: pick(picked, ui_accent_row, pt_clear) border_radius: 4.0}
            RoundedView{width: 28 height: 36 padding: 1 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: pt_paper border_size: 1.0 border_color: ui_border border_radius: 0.5}
                if src != nil { Image{width: Fill height: Fill fit: ImageFit.Smallest src: src} }
                if src == nil { Ico{width: 16 height: 16 draw_svg +: {svg: icon(pick(d.locked, "lock", pick(d.error != "", "warning", "file-pdf"))) color: pt_paper_ink}} }
            }
            View{width: Fill height: Fit flow: Down spacing: 2
                Label{clip_y: false padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: shown_name(d.title) draw_text +: {color: ink text_style: theme.font_regular{font_size: 9.75}}}
                Label{clip_y: false padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: doc_meta(d) draw_text +: {color: sub text_style: theme.font_regular{font_size: 8.25}}}
            }
            Label{clip_y: false padding: 0 text: opened_text(d, days) draw_text +: {color: sub text_style: theme.font_regular{font_size: 8.25}}}
        }
    }
}
fn library_foot(){
    let adding = st.open_for != ""
    let picked = doc_named(st.open_pick)
    let can_import = !st.files_known || st.files_ok
    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8 margin: Inset{top: 4}
        if can_import { Outline{reset_hover_on_click: true text: pick(st.importing, "Choosing a PDF…", "Import…") on_click: || library_import()} }
        Gap{}
        Outline{key_cancel: true reset_hover_on_click: true text: "Cancel" on_click: || library_close()}
        if picked != nil { Primary{key_default: true reset_hover_on_click: true text: pick(adding, "Add", "Open") on_click: || library_chosen(st.open_pick)} }
        else { PrimaryOff{text: pick(adding, "Add", "Open")} }
    }
}
fn library_list_h(n){ clamp(n * 46 + 8, 140, max(140, min(368, st.height - sheet_top() - 200))) }
fn open_sheet_view(){
    let list = library_list()
    let days = days_now()
    let adding = st.open_for != ""
    View{width: Fill height: Fill flow: Overlay
        SheetDim{}
        SheetPlace{padding: Inset{top: sheet_top() left: 16 right: 16}
            SheetPanel{width: min(560, st.width - 40) nav_group: true
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    Bold{text: pick(adding, "Add a PDF to Combine", "Open a PDF")}
                    Gap{}
                    Small{text: storage_text()}
                }
                RoundedView{width: Fill height: library_list_h(list.len()) flow: Down show_bg: true draw_bg +: {color: ui_content border_size: 1.0 border_color: ui_border border_radius: 2.5}
                    ScrollY{width: Fill height: Fill flow: Down
                        if list.len() == 0 {
                            View{width: Fill height: 120 align: Align{x: 0.5 y: 0.5}
                                Second{text: pick(adding, "No Other PDFs to Add", "No PDFs Yet")}
                            }
                        }
                        if list.len() > 0 {
                            View{width: Fill height: Fit flow: Down padding: 4
                                for d in list { library_row(d, days) }
                            }
                        }
                    }
                }
                library_foot()
            }
        }
    }
}
// File > Open Recent: the ten PDFs opened last, newest first (st.docs is in that
// order), then Clear Menu.
fn recent_docs(){
    let out = []
    for d in st.docs { if out.len() < 10 && d.opened > 0 && d.opened > st.recent_cleared { out.push(d) } }
    out
}
fn recent_rows(off){
    let rows = []
    let list = recent_docs()
    for d in list { rows.push({menu: "File" submenu: "Open Recent" title: shown_name(d.title) command: "recent:" + d.name enabled: !off}) }
    if list.len() > 0 { rows.push({menu: "File" submenu: "Open Recent"}) }
    rows.push({menu: "File" submenu: "Open Recent" title: "Clear Menu" command: "recent_clear" enabled: !off && list.len() > 0})
    rows
}
// A Mac's File menu: Open… (the PDFs in PDF Tools), Open Recent, then Save, Export as
// PDF… and Close Tab, and Import… for a PDF on this Mac. The other menus are every
// desktop's.
fn mac_menu_rows(rows, free, can_pick){
    let out = [{menu: "File" title: "Open…" key: "cmd+O" command: "library" enabled: free}]
    for r in recent_rows(!free) { out.push(r) }
    out.push({menu: "File"})
    for r in rows {
        let c = optional(r, "command", "")
        if r.menu == "File" && (c == "save" || c == "export" || c == "close") { out.push(r) }
    }
    out.push({menu: "File"})
    out.push({menu: "File" title: "Import…" command: "open" enabled: can_pick})
    // Reading (the Read tool, or Read mode) Copy and Select All are the page's text, as
    // Preview's are (Select All takes the page's lines from the engine, pdf.lines; Copy
    // puts them on the clipboard).
    let t = cur_tab()
    let reading = free && reads_text(t)
    for r in rows {
        if r.menu != "File" {
            if r.menu == "Edit" && optional(r, "command", "") == "select_all" {
                out.push({menu: "Edit" title: "Copy" key: "cmd+C" command: "copy_text" enabled: reading && t.read_sel == t.page})
                out.push({menu: "Edit" title: "Select All" key: "cmd+A" command: "select_all" enabled: r.enabled || reading})
            } else {
                out.push(r)
            }
        }
    }
    out
}
// Where the page's text can be selected: the Read tool and Read mode.
fn reads_text(t){ t != nil && t.state == "ready" && (t.mode == "read" || reading_on(t)) }
// Select All, reading: the current page's lines of text, from the engine; a page that
// has none (a scan) says so.
fn read_select_all(t){
    let p = t.page
    with_lines(t, p, |lines| {
        if optional(lines, "lines", []).len() == 0 {
            note("Page " + p + " has no text to select: it may be a scanned picture.")
            return
        }
        t.read_sel = p
        render_canvas()
    })
}
fn read_unselect(t){
    if t.read_sel == 0 { return }
    t.read_sel = 0
    render_canvas()
}
fn read_lines(t, p){ optional(optional(t.lines, "p" + p, {}), "lines", []) }
// Copy: the selected page's lines, one to a line, onto the clipboard (the menu's choice is
// the person's act in the window, which the clipboard asks for).
fn read_copy(t){
    if !reads_text(t) || t.read_sel != t.page { return }
    let s = ""
    for l in read_lines(t, t.page) {
        if s != "" { s = s + "\n" }
        s = s + l.text
    }
    host.request("clipboard.write", {text: s}, fn(r){
        if !r.is_ok { note(action_failed("copy the page's text", r.error)) }
    })
}
// A selected line: the page's line box in the selection's tint.
fn sel_box(r, k){
    SolidView{margin: Inset{left: max(0, r[0] * k - 1) top: max(0, r[1] * k - 1)} width: r[2] * k + 2 height: r[3] * k + 2 draw_bg.color: pt_select}
}
fn mac_menu_command(command){
    if command == "library" { library_open() return true }
    if command == "recent_clear" {
        st.recent_cleared = time_now()
        save_index()
        return true
    }
    if ("" + command).search("recent:") == 0 {
        let d = doc_named(("" + command).strip_prefix("recent:"))
        if d != nil { open_doc(d) }
        return true
    }
    false
}

// The toolbar's left side, in a document: the sidebar, the page, the zoom. Combine has
// no page to turn or zoom: those tools are off. (Fit Width and Fit Page are View's.)
fn pagebar_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: 1 height: 1} }
    // A Mac's leading edge: the sidebar's button; the name and the page follow it (mac_modebar).
    if ui_unified {
        return View{width: Fit height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: BAR_LEAD}
            UiToolIcon{enabled: side_can(t) draw_icon +: {svg: ui_icon("sidebar") color: pick(side_can(t), ui_ink, pt_off)} on_click: || toggle_side(cur_tab())}
        }
    }
    let paged = t.mode != "combine"
    let ink = pick(paged, ui_ink, pt_off)
    View{width: Fit height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: BAR_LEAD}
        UiToolIcon{enabled: side_can(t) draw_icon +: {svg: ui_icon("sidebar") color: pick(side_can(t), ui_ink, pt_off)} on_click: || toggle_side(cur_tab())}
        View{width: 8 height: 1}
        UiToolIcon{enabled: paged width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("chevron-left") color: ink} on_click: || page_step(-1)}
        View{width: pick(t.pages >= 100, 68, 46) height: Fit align: Align{x: 0.5}
            Body{text: "" + t.page + " / " + t.pages draw_text +: {color: pick(paged, ui_ink, pt_off)}}
        }
        UiToolIcon{enabled: paged width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("chevron-right") color: ink} on_click: || page_step(1)}
        View{width: 8 height: 1}
        UiToolIcon{enabled: paged width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("minus") color: ink} on_click: || zoom_by(-1)}
        View{width: 40 height: Fit align: Align{x: 0.5}
            Body{text: zoom_text(t) draw_text +: {color: pick(paged, ui_ink, pt_off)}}
        }
        UiToolIcon{enabled: paged width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("plus") color: ink} on_click: || zoom_by(1)}
    }
}
// The rest of the toolbar: Home's, or the modes as a segmented control, Undo,
// Redo, Save, the search field and, last, Read mode's full screen. A PDF that isn't
// open has no pages to turn: the band says which file it is, and opens another.
fn modebar_view(){
    let t = cur_tab()
    if t == nil { return home_bar() }
    if t.state != "ready" {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: BAR_LEAD right: 8} spacing: 8
            UiBarTitle{width: Fill text_overflow: TextOverflow.Ellipsis text: shown_name(t.title)}
            open_tool()
        }
    }
    let dirty = t.edited || field_dirty(t)
    let field_blocked = (try { t.field_wait == true || t.field_retry != nil } catch { false }) || history_busy(t) || comment_delete_busy(t)
    let undo_on = t.can_undo && !t.saving && !history_busy(t) && !comment_delete_busy(t)
    let redo_on = t.can_redo && !t.saving && !history_busy(t) && !comment_delete_busy(t)
    if ui_unified { return mac_modebar(t, dirty, field_blocked, undo_on, redo_on) }
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{right: 6}
        // The document's name, as Preview's toolbar has it: it gives way first.
        View{width: Fill height: Fit padding: Inset{left: 12 right: 12}
            UiBarTitle{width: Fill text_overflow: TextOverflow.Ellipsis text: t.title}
        }
        if mode_pad(t) > 0 {
            UiSegments{new_batch: true
                for m in MODES { mode_seg(t, m) }
            }
        }
        if mode_pad(t) == 0 { mode_popup(t) }
        View{width: 12 height: 1}
        UiToolIcon{enabled: undo_on width: 28 draw_icon +: {svg: icon("undo") color: pick(undo_on, ui_ink, pt_off)} on_click: || undo(cur_tab(), false)}
        UiToolIcon{enabled: redo_on width: 28 draw_icon +: {svg: icon("redo") color: pick(redo_on, ui_ink, pt_off)} on_click: || undo(cur_tab(), true)}
        UiTool{enabled: dirty && !t.saving && !field_blocked width: pick(tight(), 30, pick(t.saving, 76, 62)) padding: pick(tight(), 0, Inset{left: 8 right: 8}) text: pick(tight(), "", pick(t.saving, "Saving…", "Save")) draw_icon +: {svg: icon("save") color: pick(dirty && !field_blocked, ui_ink, pt_off)}
            draw_text +: {color: pick(dirty && !field_blocked, ui_ink, pt_off)}
            on_click: || save(cur_tab(), nil)}
    }
}
// A Mac's toolbar, as Preview's: the sidebar's button (pagebar_view), the document's
// name with "— Edited" after it while there are unsaved changes, and the page; then,
// trailing, the zoom, the modes, Undo, Redo, Save and the search field. The name takes
// what the tools leave, up to its whole length; the modes give way first (mode_pad).
fn mac_title_w(t, dirty){
    let pager = 4 + 26 + pick(t.pages >= 100, 68, 46) + 26
    let zoom = 26 + 40 + 26
    let save = pick(tight(), 30, pick(t.saving, 76, 62))
    let pad = mode_pad(t)
    let modes = pick(pad == 12, 425, pick(pad == 8, 377, MODE_POP_W))
    let room = st.width - (BAR_LEAD + 30) - 16 - pick(dirty, 84, 0) - pager - 24 - zoom - 12 - modes - (12 + 56 + save + 6) - (search_w() + 6)
    min(name_w(t.title), max(0, room))
}
fn mac_modebar(t, dirty, field_blocked, undo_on, redo_on){
    let paged = t.mode != "combine"
    let ink = pick(paged, ui_ink, pt_off)
    let title_w = mac_title_w(t, dirty)
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{right: 6}
        if title_w >= 40 {
            View{width: Fit height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 10 right: 6} spacing: 6
                UiBarTitle{width: title_w text_overflow: TextOverflow.Ellipsis text: t.title}
                if dirty { Label{clip_y: false padding: 0 text: "— Edited" draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 11.25}}} }
            }
        }
        View{width: 4 height: 1}
        UiToolIcon{enabled: paged width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("chevron-left") color: ink} on_click: || page_step(-1)}
        View{width: pick(t.pages >= 100, 68, 46) height: Fit align: Align{x: 0.5}
            Body{text: "" + t.page + " / " + t.pages draw_text +: {color: pick(paged, ui_ink, pt_off)}}
        }
        UiToolIcon{enabled: paged width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("chevron-right") color: ink} on_click: || page_step(1)}
        Gap{}
        UiToolIcon{enabled: paged width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("minus") color: ink} on_click: || zoom_by(-1)}
        View{width: 40 height: Fit align: Align{x: 0.5}
            Body{text: zoom_text(t) draw_text +: {color: pick(paged, ui_ink, pt_off)}}
        }
        UiToolIcon{enabled: paged width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("plus") color: ink} on_click: || zoom_by(1)}
        View{width: 12 height: 1}
        if mode_pad(t) > 0 {
            UiSegments{new_batch: true
                for m in MODES { mode_seg(t, m) }
            }
        }
        if mode_pad(t) == 0 { mode_popup(t) }
        View{width: 12 height: 1}
        UiToolIcon{enabled: undo_on width: 28 draw_icon +: {svg: icon("undo") color: pick(undo_on, ui_ink, pt_off)} on_click: || undo(cur_tab(), false)}
        UiToolIcon{enabled: redo_on width: 28 draw_icon +: {svg: icon("redo") color: pick(redo_on, ui_ink, pt_off)} on_click: || undo(cur_tab(), true)}
        UiTool{enabled: dirty && !t.saving && !field_blocked width: pick(tight(), 30, pick(t.saving, 76, 62)) padding: pick(tight(), 0, Inset{left: 8 right: 8}) text: pick(tight(), "", pick(t.saving, "Saving…", "Save")) draw_icon +: {svg: icon("save") color: pick(dirty && !field_blocked, ui_ink, pt_off)}
            draw_text +: {color: pick(dirty && !field_blocked, ui_ink, pt_off)}
            on_click: || save(cur_tab(), nil)}
    }
}
// Search keeps its own view so action-state updates do not replace a focused input.
fn search_tools_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: 0 height: 1} }
    let full_off = t.mode == "pages" || t.mode == "combine"
    // A Mac's window has its own full screen (the green button) and Read mode is View's:
    // the toolbar ends with the search field, as Preview's does.
    if ui_unified {
        return View{width: Fit height: Fill flow: Right align: Align{y: 0.5} padding: Inset{right: 6}
            search_field(t)
        }
    }
    View{width: Fit height: Fill flow: Right align: Align{y: 0.5} padding: Inset{right: 6}
        search_field(t)
        View{width: 2 height: 1}
        UiToolIcon{enabled: !full_off width: 28 draw_icon +: {svg: icon("fullscreen") color: pick(full_off, pt_off, ui_ink)} on_click: || enter_reading(cur_tab())}
    }
}
// Opening a PDF, on Home's toolbar and on a tab whose PDF won't open.
fn open_tool(){
    View{width: Fit height: Fit flow: Right align: Align{y: 0.5} spacing: 8
        if st.files_known && !st.files_ok { Small{text: "Not available here"} }
        UiTool{text: pick(st.importing, "Choosing a PDF…", pick(ui_unified, "Import…", "Open PDF…")) draw_icon +: {svg: icon("folder")} on_click: || open_from_device()}
    }
}
fn mode_titles(){
    let out = []
    for m in MODES { out.push(m.label) }
    out
}
fn mode_label(id){
    for m in MODES { if m.id == id { return m.label } }
    "Read"
}
fn mode_chosen(title){
    if pt_modal { return }
    for m in MODES { if m.label == title { mode_click(m.id) } }
    ui.keys.focus()
}
// The modes, in a window too narrow for their segments: a pop-up, as a Mac's toolbar folds one.
fn mode_popup(t){
    let busy = history_busy(t) || comment_delete_busy(t)
    View{width: MODE_POP_W height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
        mode_pick := GestureView{width: Fill height: 28 menu_words_at: 10 on_menu: |title| mode_chosen(title)
            UiPopup{enabled: !busy width: Fill text: mode_label(t.mode)
                draw_text +: {color: pick(busy, pt_off, ui_ink) color_hover: pick(busy, pt_off, ui_ink) color_down: pick(busy, pt_off, ui_ink) color_focus: pick(busy, pt_off, ui_ink)}
                on_click: || ui.mode_pick.open_menu(mode_titles(), mode_label(cur_tab().mode))}
        }
        UiPopupMark{}
    }
}
fn mode_seg(t, m){
    let pad = mode_pad(t)
    if t.mode == m.id { return SegOn{padding: Inset{left: pad right: pad} text: m.label on_click: || mode_click(m.id)} }
    let busy = history_busy(t) || comment_delete_busy(t)
    UiSeg{enabled: !busy padding: Inset{left: pad right: pad} text: m.label
        draw_text +: {color: pick(busy, pt_off, ui_ink) color_hover: pick(busy, pt_off, ui_ink) color_down: pick(busy, pt_off, ui_ink) color_focus: pick(busy, pt_off, ui_ink)}
        on_click: || mode_click(m.id)}
}
fn mode_click(id){
    let x = cur_tab()
    if x != nil && x.state == "ready" { set_mode(x, id) }
}
fn search_field(t){
    let q = t.find_draft
    View{width: search_w() height: 28 flow: Overlay align: Align{y: 0.5}
        search := UiSearch{flow: Right height: 28 padding: Inset{left: 26 right: 24 top: 6 bottom: 6} text: q empty_text: search_words()
            on_change: |text| {
                let x = cur_tab()
                if x != nil { x.find_draft = text x.field_focus_pending = false }
                ui.search_clear.set_visible(text != "")
            }
            on_return: |text| find_text(text)
            on_escape: |text| {
                let x = cur_tab()
                if x != nil { end_find(x) }
                ui.keys.focus()
            }}
        Ico{width: 14 height: 14 margin: Inset{left: 8} draw_svg +: {svg: ui_icon("search")}}
        View{width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5} padding: Inset{right: 2}
            search_clear := UiSearchClear{visible: q != "" on_click: || {
                end_find(cur_tab())
                ui.keys.focus()
            }}
        }
    }
}
// Home's toolbar: the app's name and, as a tool, opening a PDF. (An empty
// library has the one button in its middle instead.)
fn home_bar(){
    let n = st.docs.len()
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: if ui_unified { 84 } else { 14 } right: 8} spacing: 8
        View{width: Fit height: Fit flow: Down spacing: 1
            UiBarTitle{text: "PDF Tools"}
            if n > 0 { UiBarSub{text: plural(n, "PDF", "PDFs")} }
        }
        Gap{}
        if n > 0 { open_tool() }
    }
}

// The sidebar's head: the pop-up that chooses its view, as Preview's; over search
// results, what they found, and a cross that ends the search.
fn head_row(title, ends_find){
    View{width: Fill height: 36 flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 4}
        SideHead{text: title}
        if ends_find { IconBtn{draw_icon +: {svg: icon("close")} on_click: || end_find(cur_tab())} }
    }
}
fn panel_head_view(){
    View{width: Fill height: 36 flow: Down align: Align{y: 0.5} padding: Inset{left: 8 right: 8}
        View{width: Fill height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
            side_pick_n := GestureView{width: Fill height: 28 menu_words_at: 10 on_menu: |title| side_chosen(title)
                UiPopup{width: Fill text: side_title("pages") on_click: || ui.side_pick_n.open_menu(side_titles(), side_title("pages"))}
            }
            UiPopupMark{}
        }
    }
}
fn list_head_view(){
    let t = cur_tab()
    if t == nil { return View{width: Fill height: 1} }
    if t.panel == "search" {
        if t.find == nil { return head_row("Search", true) }
        return head_row(find_summary(t), true)
    }
    let shown = side_title(t.panel)
    View{width: Fill height: 36 flow: Down align: Align{y: 0.5} padding: Inset{left: 8 right: 8}
        View{width: Fill height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
            side_pick_w := GestureView{width: Fill height: 28 menu_words_at: 10 on_menu: |title| side_chosen(title)
                UiPopup{width: Fill text: shown on_click: || ui.side_pick_w.open_menu(side_titles(), shown)}
            }
            UiPopupMark{}
        }
    }
}

// Pages panel: thumbnails, filled in one at a time, as in Preview's sidebar.
fn thumbs_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let first = window_start(t)
    let last = window_end(t)
    View{width: Fill height: Fit flow: Down align: Align{x: 0.5} padding: Inset{bottom: 12} spacing: 4
        if first > 1 {
            LinkBtn{text: "Pages 1–" + (first - 1) on_click: || go_page(cur_tab(), max(1, window_start(cur_tab()) - 20))}
        }
        for i in last - first + 1 { thumb_row(t, first + i) }
        if last < t.pages {
            LinkBtn{text: "Pages " + (last + 1) + "–" + t.pages on_click: || go_page(cur_tab(), window_end(cur_tab()) + 1)}
        }
    }
}
fn thumb_row(t, p){
    let s = page_pt(t, p)
    let h = round(THUMB_W * s[1] / max(1, s[0]))
    let on = p == t.page
    let src = optional(t.thumbs, "p" + p, nil)
    let prev = optional(t.thumb_prev, "p" + p, nil)
    GestureView{width: Fit height: Fit menu: PAGE_MENU on_menu: |title| page_menu(cur_tab(), p, title)
        on_tap: |x, y| {
            if pt_modal { return }
            go_page(cur_tab(), p)
            ui.keys.focus()
        }
        RoundedView{width: THUMB_W + 12 height: Fit flow: Down align: Align{x: 0.5} padding: Inset{left: 6 right: 6 top: 6 bottom: 4} spacing: 4 show_bg: true
            draw_bg +: {color: pick(on, ui_selected, pt_clear) border_radius: 3.0}
            RoundedView{width: THUMB_W height: h padding: 1 flow: Overlay show_bg: true draw_bg +: {color: pt_paper border_size: 1.0 border_color: ui_border border_radius: 0.5}
                if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
                if prev != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: prev} }
            }
            Small{text: "" + p draw_text +: {color: ui_ink}}
        }
    }
}

// Outline panel: the document's bookmarks as a tree.
fn flat_outline(t, items, depth, out){
    for it in items {
        let kids = optional(it, "children", [])
        let key = "" + depth + "/" + optional(it, "title", "") + "/" + optional(it, "page", 0)
        out.push({title: optional(it, "title", "") page: optional(it, "page", 1) depth: depth key: key kids: kids.len()})
        if kids.len() > 0 && optional(t.outline_open, key, true) { flat_outline(t, kids, depth + 1, out) }
    }
    out
}
fn outline_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let rows = flat_outline(t, t.outline, 0, [])
    let reached = 0
    for r in rows { if r.page <= t.page && r.page > reached { reached = r.page } }
    let at = -1
    for i r in rows { if at < 0 && r.page == reached { at = i } }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 8 right: 8 bottom: 12} spacing: 1
        if rows.len() == 0 { View{width: Fill height: Fit padding: Inset{left: 4 right: 4 top: 2} Note{text: "This PDF has no outline."}} }
        for i r in rows { outline_row(t, r, i == at) }
    }
}
fn outline_menu(r, open){
    let go = "Go to Page " + r.page
    if r.kids == 0 { return [go] }
    [go, "-", pick(open, "Collapse", "Expand")]
}
fn outline_chosen(r, open, title){
    let x = cur_tab()
    if x == nil || pt_modal { return }
    if title == "Collapse" || title == "Expand" {
        x.outline_open[r.key] = !open
        ui.outline.render()
        return
    }
    go_page(x, r.page)
}
fn outline_row(t, r, on){
    let open = optional(t.outline_open, r.key, true)
    GestureView{width: Fill height: 28 menu: outline_menu(r, open) on_menu: |title| outline_chosen(r, open, title)
        on_tap: |x, y| {
            if pt_modal { return }
            go_page(cur_tab(), r.page)
            ui.keys.focus()
        }
        RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 2 + r.depth * 14 right: 6} spacing: 4 show_bg: true
            draw_bg +: {color: pick(on, ui_selected, pt_clear) border_radius: 3.0}
            if r.kids > 0 {
                IconBtn{width: 14 height: 22 icon_walk: Walk{width: 9 height: 9} draw_icon +: {svg: icon(pick(open, "triangle-down", "triangle-right"))}
                    draw_bg +: {color_hover: pt_clear color_down: pt_clear}
                    on_click: || { let x = cur_tab() x.outline_open[r.key] = !open ui.outline.render() }}
            }
            if r.kids == 0 { View{width: 14 height: 1} }
            Ico{width: 14 height: 14 draw_svg +: {svg: icon("bookmark") color: ui_link}}
            One{text: r.title}
        }
    }
}

// Comments panel: every comment, newest page order as the engine lists them.
fn notes_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 8 right: 8 bottom: 12} spacing: 1
        if t.comments == nil || t.comments_state != "" {
            View{width: Fill height: Fit padding: Inset{left: 4 right: 4 top: 2} Note{text: pick(t.comments_state == "" || t.comments_state == "loading", "Reading the comments…", t.comments_state)}}
        }
        if t.comments != nil && t.comments.len() == 0 {
            View{width: Fill height: Fit padding: Inset{left: 4 right: 4 top: 2} Note{text: "No comments yet. Choose Comment to highlight text or add a note."}}
        }
        if t.comments != nil { for c in t.comments { note_row(t, c) } }
    }
}
// A comment's row or card, on a right click.
let COMMENT_MENU = ["Show Comment", "-", "Delete Comment"]
fn comment_chosen(c, title){
    let x = cur_tab()
    if x == nil || pt_modal { return }
    if comment_busy(x) { note("The comment is still being posted.") return }
    if title == "Show Comment" { open_thread(x, c) }
    if title == "Delete Comment" {
        if draft_guard(x, "deleting a comment") { return }
        x.thread = c.id
        delete_comment(x)
    }
}
fn note_row(t, c){
    let on = t.thread == c.id
    GestureView{width: Fill height: Fit menu: COMMENT_MENU on_menu: |title| comment_chosen(c, title)
        on_tap: |x, y| {
            if pt_modal { return }
            open_thread(cur_tab(), c)
        }
        RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 8 right: 8 top: 6 bottom: 6} spacing: 2 show_bg: true
            draw_bg +: {color: pick(on, ui_selected, pt_clear) border_radius: 3.0}
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                RoundedView{width: 8 height: 8 show_bg: true draw_bg +: {color: mark_color(optional(c, "color", "")) border_radius: 2.0}}
                Bold{text: "Page " + c.page}
                Gap{}
                Small{text: optional(c, "author", "") max_lines: 1 text_overflow: TextOverflow.Ellipsis}
            }
            if optional(c, "text", "") != "" {
                Label{padding: 0 width: Fill max_lines: 2 flow: Flow.Right{wrap: true} text: c.text draw_text +: {color: ui_muted text_style: theme.font_regular{font_size: 9 line_spacing: 1.25}}}
            }
        }
    }
}
// A comment's colour as the engine reports it ("#RRGGBB"), as the nearest of
// the four dots (a comment made elsewhere can have any colour).
// "#1A2B3C" → the byte at `at` (0, 2 or 4), or -1.
let HEX_DIGITS = "0123456789abcdef0123456789ABCDEF"
fn hex_byte(s, at){
    let m = regex("^#?([0-9A-Fa-f])([0-9A-Fa-f])([0-9A-Fa-f])([0-9A-Fa-f])([0-9A-Fa-f])([0-9A-Fa-f])$").exec(s)
    if m == nil { return -1 }
    (HEX_DIGITS.search(m.captures[at + 1]) % 16) * 16 + HEX_DIGITS.search(m.captures[at + 2]) % 16
}
fn mark_of(c){
    let s = ("" + c).trim()
    if s == "yellow" || s == "green" || s == "blue" || s == "pink" { return s }
    let r = hex_byte(s, 0)
    let g = hex_byte(s, 2)
    let b = hex_byte(s, 4)
    if r < 0 { return "yellow" }
    if b > r && b > g { return "blue" }
    if g > r && g >= b { return "green" }
    if r > 200 && g > 170 && b < 170 { return "yellow" }
    if r > g && b > g { return "pink" }
    "yellow"
}
fn mark_color(c){
    let m = mark_of(c)
    if m == "green" { return #x5cb85c }
    if m == "blue" { return #x2d7ff9 }
    if m == "pink" { return #xf0609e }
    #xf5c518
}

// Search panel: the matches, grouped by page, the current one marked.
fn results_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    if t.find == nil {
        return View{width: Fill height: Fit padding: Inset{left: 12 right: 12 top: 2}
            Note{text: "Type a word or phrase in the search field, then press Return."}
        }
    }
    let current = nil
    if t.find.matches.len() > 0 { current = t.find.matches[t.find.cur].page }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 8 right: 8 bottom: 12} spacing: 2
        for p in find_pages(t) { result_group(t, p, p == current) }
    }
}
fn result_group(t, p, on){
    let count = page_matches(t, p).len()
    RoundedView{width: Fill height: Fit flow: Down padding: Inset{left: 8 right: 8 top: 6 bottom: 8} spacing: 4 show_bg: true
        draw_bg +: {color: pick(on, ui_selected, pt_clear) border_radius: 3.0}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            Bold{text: "Page " + p}
            Gap{}
            Small{text: plural(count, "match", "matches")}
        }
        for i in page_matches(t, p) {
            GestureView{width: Fill height: Fit flow: Right align: Align{y: 0.5} menu: ["Go to Match"] on_menu: |title| go_match(cur_tab(), i)
                on_tap: |x, y| {
                    if pt_modal { return }
                    go_match(cur_tab(), i)
                    ui.keys.focus()
                }
                Html{width: Fill height: Fit padding: 0 body: snippet_html(optional(t.find.matches[i], "snippet", ""))
                    font_color: pick(i == t.find.cur, ui_ink, ui_muted) font_size: 9
                    draw_text +: {color: pick(i == t.find.cur, ui_ink, ui_muted)}
                    text_style_normal +: {font_size: 9} text_style_bold +: {font_size: 9}}
            }
        }
    }
}

// Under the toolbar, over the canvas: the find bar, the Comment tools, the
// form's note, the Pages actions, Combine's name.
fn toolrow_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 0} }
    if t.mode == "comment" { return comment_tools(t) }
    if t.mode == "fill" { return form_banner(t) }
    if t.mode == "pages" { return pages_actions(t) }
    if t.mode == "combine" { return combine_bar() }
    if t.find != nil { return find_bar(t) }
    View{width: Fill height: 0}
}
// How tall that row draws, for the canvas's room.
fn toolrow_h(t){
    if t == nil || t.state != "ready" { return 0 }
    if t.mode == "comment" || t.mode == "fill" || t.mode == "pages" || t.mode == "combine" || t.find != nil { return ROW_H + 1 }
    0
}
fn find_bar(t){
    let n = t.find.matches.len()
    View{width: Fill height: Fit flow: Down
        UiToolbar{height: ROW_H align: Align{x: 0.5 y: 0.5} padding: 0 spacing: 2 new_batch: true
            View{width: Fit height: Fit padding: Inset{right: 6}
                Second{text: pick(n == 0, pick(t.finding, "…", "0 of 0"), "" + (t.find.cur + 1) + " of " + n)}
            }
            // With nothing found the arrows have nowhere to go, and are dimmed, as a Mac's are.
            if n == 0 {
                UiToolIcon{width: 28 enabled: false icon_walk: Walk{width: 12 height: 12} draw_bg +: {color_disabled: #x00000000} draw_icon +: {svg: icon("arrow-up") color: mix(ui_page, ui_ink, 0.32)}}
                UiToolIcon{width: 28 enabled: false icon_walk: Walk{width: 12 height: 12} draw_bg +: {color_disabled: #x00000000} draw_icon +: {svg: icon("arrow-down") color: mix(ui_page, ui_ink, 0.32)}}
            } else {
                UiToolIcon{width: 28 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("arrow-up")} on_click: || go_match(cur_tab(), cur_tab().find.cur - 1)}
                UiToolIcon{width: 28 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("arrow-down")} on_click: || go_match(cur_tab(), cur_tab().find.cur + 1)}
            }
            Outline{margin: Inset{left: 6} text: "Done" on_click: || end_find(cur_tab())}
        }
        UiSep{}
    }
}
fn tool_btn(t, id, ic, label){
    let on = t.tool == id
    let compact = canvas_w() < 560
    let busy = history_busy(t) || comment_delete_busy(t)
    let ink = pick(busy, pt_off, ui_ink)
    UiTool{enabled: !busy spacing: pick(compact, 0, 5) text: pick(compact, "", label)
        draw_icon +: {svg: icon(ic) color: pick(busy, pt_off, pick(on, ui_link, ui_ink))}
        draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink}
        draw_bg +: {color: pick(on, ui_selected, pt_clear) color_hover: pick(on, ui_selected, ui_hover)}
        on_click: || { let x = cur_tab() if draft_guard(x, "choosing another tool") { return } x.tool = id x.pending = nil render_toolrow() render_right() }}
}
fn comment_tools(t){
    View{width: Fill height: Fit flow: Down
        UiToolbar{height: ROW_H padding: Inset{left: 10 right: 10} spacing: 2 new_batch: true
            tool_btn(t, "highlight", "highlight", "Highlight")
            tool_btn(t, "underline", "underline", "Underline")
            tool_btn(t, "strike", "strike", "Strike Out")
            tool_btn(t, "note", "note", "Note")
            tool_btn(t, "textbox", "textbox", "Text Box")
            View{width: 12 height: 1}
            View{width: Fit height: Fit flow: Right spacing: 2
                for m in MARKS { mark_dot(t, m) }
            }
        }
        UiSep{}
    }
}
fn mark_dot(t, m){
    let on = t.color == m
    GestureView{width: 22 height: 28 align: Align{x: 0.5 y: 0.5} on_tap: |x, y| { if pt_modal { return } let c = cur_tab() c.color = m render_toolrow() }
        RoundedView{width: 20 height: 20 align: Align{x: 0.5 y: 0.5} show_bg: true
            draw_bg +: {color: pt_clear border_size: pick(on, 1.5, 0.0) border_color: ui_ink border_radius: 5.0}
            RoundedView{width: 13 height: 13 show_bg: true draw_bg +: {color: mark_color(m) border_radius: 3.25}}
        }
    }
}
// Fill & Sign's row: what goes on the page anywhere (text, the date, initials), and
// what the form says. A click in a field on the page types in it.
fn place_tool(t, kind, ic, label, compact){
    let on = t.place != nil && t.place.kind == kind
    let ink = pick(history_busy(t), pt_off, ui_ink)
    UiTool{enabled: !history_busy(t) spacing: pick(compact, 0, 5) text: pick(compact, "", label)
        draw_icon +: {svg: icon(ic) color: pick(history_busy(t), pt_off, pick(on, ui_link, ui_ink))}
        draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink}
        draw_bg +: {color: pick(on, ui_selected, pt_clear) color_hover: pick(on, ui_selected, ui_hover)}
        on_click: || start_place(cur_tab(), kind)}
}
fn place_input(t){
    View{width: 110 height: 28 margin: Inset{right: 6} nav_group: true
        place_field := Field{text: t.place_text is_read_only: history_busy(t) empty_text: pick(t.place.kind == "initials", "Initials", "Text")
            on_change: |text| { let x = cur_tab() if history_busy(x) { return } let was = pending_draft(x) x.place_text = text draft_changed(x, was) }
            on_escape: |text| end_place(cur_tab())}
    }
}
fn form_banner(t){
    let compact = canvas_w() < 560
    View{width: Fill height: Fit flow: Down
        UiToolbar{height: ROW_H padding: Inset{left: 10 right: 12} spacing: 2 new_batch: true
            place_tool(t, "text", "text", "Add Text", compact)
            place_tool(t, "date", "calendar", "Add Date", compact)
            place_tool(t, "initials", "initials", "Add Initials", compact)
            UiVSep{height: 18 margin: Inset{left: 6 right: 8}}
            if t.place != nil && t.place.kind != "date" { place_input(t) }
            if t.place != nil && !compact { Second{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: place_hint(t) draw_text +: {color: ui_ink}} }
            if t.place == nil || compact { Gap{} }
            if t.place != nil { Outline{text: "Cancel" on_click: || end_place(cur_tab())} }
            // A toggle button, as Preview's: pressed in while the fields are lit.
            if t.place == nil && t.fields != nil && t.fields.len() > 0 {
                UiTool{reset_hover_on_click: true text: "Highlight Fields"
                    draw_icon +: {svg: icon("highlight") color: pick(t.show_fields, ui_link, ui_ink)}
                    draw_bg +: {color: pick(t.show_fields, ui_selected, pt_clear) color_hover: pick(t.show_fields, ui_selected, ui_hover)}
                    on_click: || {
                        let x = cur_tab()
                        if x != nil { toggle_highlight(x, !x.show_fields) }
                    }}
            }
        }
        UiSep{}
    }
}
fn toggle_highlight(t, on){
    if t == nil { return }
    if field_guard(t) { return }
    if field_handoff(t, nil, "continue", || toggle_highlight(t, on)) { return }
    close_field(t, true)
    t.show_fields = on
    render_canvas()
    render_toolrow()
}
fn pages_actions(t){
    let n = chosen(t).len()
    let ink = pick(n == 0, pt_off, ui_ink)
    let hint = "Drag pages to reorder"
    if t.drag != nil && t.drag.to != t.drag.page { hint = "Drop to move page " + t.drag.page + " to place " + t.drag.to }
    if t.drag != nil && t.drag.to == t.drag.page { hint = "Drop to move page " + t.drag.page }
    View{width: Fill height: Fit flow: Down
        UiToolbar{height: ROW_H padding: Inset{left: 14 right: 14} spacing: 2 new_batch: true
            View{width: 92 height: Fit Second{text: pick(n == 0, "None selected", "" + n + " selected") draw_text +: {color: pick(n == 0, ui_muted, ui_ink)}}}
            UiTool{text: "Rotate Left" draw_icon +: {svg: icon("rotate-left") color: ink} draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink} on_click: || rotate(cur_tab(), -90)}
            UiTool{text: "Rotate Right" draw_icon +: {svg: icon("rotate-right") color: ink} draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink} on_click: || rotate(cur_tab(), 90)}
            UiVSep{height: 18 margin: Inset{left: 6 right: 6}}
            UiTool{text: "Delete" draw_icon +: {svg: icon("trash") color: ink} draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink} on_click: || delete_pages(cur_tab())}
            UiTool{text: "Extract" draw_icon +: {svg: icon("extract") color: ink} draw_text +: {color: ink color_hover: ink color_down: ink color_focus: ink} on_click: || extract_pages(cur_tab())}
            insert_pick := GestureView{width: Fit height: 28 on_menu: |title| insert_chosen(cur_tab(), title)
                UiTool{text: "Insert from File…" draw_icon +: {svg: icon("insert")} on_click: || insert_open(cur_tab())}
            }
            Gap{}
            // In a narrow window the hint gives the buttons its room.
            if canvas_w() >= 760 || t.drag != nil { Small{text: hint} }
        }
        UiSep{}
    }
}
fn insert_open(t){
    if t == nil { return }
    let titles = insert_titles(t)
    if titles.len() == 0 {
        note("Open another PDF first: it appears here.")
        return
    }
    ui.insert_pick.open_menu(titles)
}
fn combine_bar(){
    View{width: Fill height: Fit flow: Down
        UiToolbar{height: ROW_H padding: Inset{left: 14 right: 14} spacing: 10 new_batch: true
            Bold{text: "Combine Files"}
            Small{text: "This PDF and others, in order: drag a grip to reorder"}
        }
        UiSep{}
    }
}

// The canvas: the run of pages, each the engine's render, with what the
// mode puts over it.
fn canvas_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" || st.blank { return View{width: 10 height: 1} }
    View{width: Fit height: Fit flow: Down spacing: PAGE_GAP align: Align{x: 0.5}
        for i in run_end(t) - t.anchor + 1 { page_view(t, t.anchor + i) }
        if run_end(t) < t.pages {
            View{width: Fit height: Fit padding: Inset{top: 4}
                Outline{text: "Continue with Page " + (run_end(t) + 1) icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("arrow-down")} on_click: || go_page(cur_tab(), run_end(cur_tab()) + 1)}
            }
        }
    }
}
fn page_view(t, p){
    let box = page_box(t, p)
    let k = t.zoom
    let rd = reading_on(t)
    let src = page_src(t, p)
    let failed = optional(t.failed, "p" + p, nil) != nil && src == nil
    RectShadowView{width: box[0] height: box[1] flow: Overlay
        draw_bg +: {color: pt_paper shadow_color: pt_shadow shadow_radius: 6.0 shadow_offset: vec2(0.0, 1.0)}
        if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
        if src == nil {
            View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 8
                if !failed { LoadingSpinner{width: 20 height: 20} }
                Second{text: pick(failed, "Couldn't draw page " + p, "Rendering page " + p + "…") draw_text +: {color: pt_paper_ink}}
            }
        }
        if t.find != nil && src != nil { for i in page_matches(t, p) { for r in t.find.matches[i].rects { hit_box(src, page_pt(t, p), r, k, i == t.find.cur) } } }
        if src != nil && t.read_sel == p && reads_text(t) { for l in read_lines(t, p) { sel_box(l.box, k) } }
        // Read mode shows the pages alone: no tool's marks over them.
        if t.mode == "comment" && !rd { comment_marks(t, p, k) }
        if t.mode == "fill" && !rd && t.show_fields && t.fields != nil { for f in t.fields { if f.page == p && t.field != f.name { field_box(t, f, k) } } }
        GestureView{width: Fill height: Fill cursor: pick(!rd && (t.mode == "comment" || t.mode == "edit"), MouseCursor.Text, MouseCursor.Default)
            on_tap: |x, y| { if pt_modal { return } page_tap(cur_tab(), p, x / k, y / k) }
            on_double_tap: |x, y| { if pt_modal { return } page_double_tap(cur_tab(), p, x / k, y / k) }}
        if t.mode == "fill" && !rd && t.field != nil { field_on_page(t, p, k) }
        if t.mode == "edit" && !rd && t.edit != nil && t.edit.page == p { edit_box(t, k) }
    }
}
// A match, under its text: the page's own picture of that spot, tinted (FindMark).
fn hit_box(src, s, r, k, on){
    let x = max(0, r[0] - 1)
    let y = max(0, r[1] - 1)
    let w = r[2] + 2
    let h = r[3] + 2
    FindMark{margin: Inset{left: x * k top: y * k} width: w * k height: h * k src: src
        draw_bg +: {image_scale: vec2(w / s[0], h / s[1]) image_pan: vec2(x / s[0], y / s[1]) on: pick(on, 1.0, 0.0)}}
}
fn comment_marks(t, p, k){
    View{width: Fill height: Fill flow: Overlay
        if t.comments != nil {
            for c in t.comments {
                if c.page == p && c.id == t.thread {
                    for r in optional(c, "rects", []) {
                        RoundedView{margin: Inset{left: r[0] * k - 3 top: r[1] * k - 3} width: r[2] * k + 6 height: r[3] * k + 6 show_bg: true
                            draw_bg +: {color: pt_clear border_size: 1.5 border_color: pt_on_page border_radius: 1.5}}
                    }
                }
            }
        }
        if t.pending != nil && t.pending.page == p {
            RoundedView{margin: Inset{left: t.pending.at[0] * k - 12 top: t.pending.at[1] * k - 12} width: 24 height: 24 align: Align{x: 0.5 y: 0.5} show_bg: true
                draw_bg +: {color: pt_pin border_size: 1.0 border_color: pt_pin_line border_radius: 2.0}
                Ico{width: 14 height: 14 draw_svg +: {svg: icon("note") color: pt_pin_ink}}
            }
        }
    }
}
// A form's words, in what its box holds: three fifths of its height, up to a text's
// size; in the type's 3/4-of-a-point units.
fn field_font(f, k){ clamp(min(f.rect[3] * 0.62, 12) * k * 0.75, 6, 36) }
// A field on its page, in Fill & Sign: its box, and what it holds now. The paper goes
// first: the page's own picture may say the same words.
fn field_box(t, f, k){
    let r = f.rect
    let need = optional(f, "required", false) && field_empty(f)
    let locked = read_only(f) || !fillable(f)
    RoundedView{margin: Inset{left: r[0] * k top: r[1] * k} width: r[2] * k height: r[3] * k flow: Right align: Align{y: pick(r[3] > 30, 0.0, 0.5)} padding: Inset{left: 3 right: 3 top: pick(r[3] > 30, 3, 0)} show_bg: true
        draw_bg +: {color: pick(need, mix(pt_paper, pt_box_red, 0.07), mix(pt_paper, pt_on_page, pick(locked, 0.02, 0.08))) border_size: 1.0 border_color: pick(need, pt_box_red, pick(locked, ui_border, pt_box_line)) border_radius: 1.0}
        if is_check(f) { if !field_empty(f) { View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} Ico{width: min(r[2], r[3]) * k * 0.8 height: min(r[2], r[3]) * k * 0.8 draw_svg +: {svg: icon("check") color: pt_paper_text}}} } }
        if !is_check(f) && !field_empty(f) && r[3] <= 30 {
            Label{clip_y: false padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: field_shown(f) draw_text +: {color: pick(locked, pt_paper_ink, pt_paper_text) text_style: theme.font_regular{font_size: field_font(f, k)}}}
        }
        if !is_check(f) && !field_empty(f) && r[3] > 30 {
            Label{clip_y: false padding: 0 width: Fill flow: Flow.Right{wrap: true} text: field_shown(f) draw_text +: {color: pick(locked, pt_paper_ink, pt_paper_text) text_style: theme.font_regular{font_size: field_font(f, k)}}}
        }
        if !is_check(f) && is_choice(f) {
            View{width: Fit height: Fill align: Align{y: 0.5} Ico{width: 11 height: 11 draw_svg +: {svg: ui_icon("updown") color: pt_paper_ink}}}
        }
    }
}
// The field the person is on, if it is on this page: a text field to type in where it
// sits, a choice with its menu, or a check box with a ring.
fn field_on_page(t, p, k){
    let f = field_named(t, t.field)
    if f == nil || f.page != p { return View{width: 1 height: 1} }
    if t.field_typing { return field_editor(t, f, k) }
    field_choice(t, f, k)
}
fn field_editor(t, f, k){
    let r = f.rect
    let tall = r[3] > 30
    let size = field_font(f, k)
    let pad_top = pick(tall, 3, max(0, (r[3] * k - size / 0.75 * 1.2) / 2 - 2))
    // The ring stands outside the field, as a Mac's focus ring does: the text stays where
    // the page draws it, clear of the ring.
    View{margin: Inset{left: max(0, r[0] * k - 2) top: max(0, r[1] * k - 2)} width: max(r[2] * k, 24) + 4 height: r[3] * k + 4 flow: Overlay nav_group: true
        RoundedView{width: Fill height: Fill new_batch: true show_bg: true draw_bg +: {color: pt_paper border_size: 2.0 border_color: pt_on_page border_radius: 3.0}}
        field_input := BareInput{width: Fill height: Fill padding: Inset{left: 5 right: 5 top: pad_top + 2 bottom: 0} is_multiline: tall text: t.field_text empty_text: pick(r[2] * k >= 96, "Type the value", "")
            on_change: |text| {
                let x = cur_tab()
                if x != nil {
                    let was_dirty = field_dirty(x)
                    x.field_text = text
                    if was_dirty != field_dirty(x) { render_actions() render_status() render_tabs() }
                }
            }
            on_return: |text| {
                let x = cur_tab()
                if x != nil { x.field_text = text }
                close_field(x, true)
            }
            on_escape: |text| close_field(cur_tab(), false)
            on_tab: |text, shift| tab_field(cur_tab(), text, shift)
            draw_bg +: {color: pt_clear color_hover: pt_clear color_focus: pt_clear color_empty: pt_clear}
            draw_cursor +: {color: pt_paper_text}
            draw_text +: {color: pt_paper_text color_hover: pt_paper_text color_focus: pt_paper_text color_empty: pt_paper_ink color_empty_hover: pt_paper_ink color_empty_focus: pt_paper_ink text_style: theme.font_regular{font_size: size}}}
    }
}
fn field_choice(t, f, k){
    let r = f.rect
    View{margin: Inset{left: max(0, r[0] * k - 2) top: max(0, r[1] * k - 2)} width: r[2] * k + 4 height: r[3] * k + 4 flow: Overlay
        field_box_on(t, f, k)
        field_pick := GestureView{width: Fill height: Fill
            on_tap: |x, y| {
                if pt_modal { return }
                if is_check(f) { flip_check(cur_tab(), f) } else { open_choice(cur_tab(), f) }
            }
            on_menu: |title| choice_chosen(cur_tab(), f, title)}
    }
}
fn field_box_on(t, f, k){
    let r = f.rect
    RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 5 right: 5} new_batch: true show_bg: true
        draw_bg +: {color: pt_paper border_size: 2.0 border_color: pt_on_page border_radius: 3.0}
        if is_check(f) { if !field_empty(f) { View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} Ico{width: min(r[2], r[3]) * k * 0.8 height: min(r[2], r[3]) * k * 0.8 draw_svg +: {svg: icon("check") color: pt_paper_text}}} } }
        if !is_check(f) {
            Label{clip_y: false padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: field_shown(f) draw_text +: {color: pt_paper_text text_style: theme.font_regular{font_size: field_font(f, k)}}}
            View{width: Fit height: Fill align: Align{y: 0.5} Ico{width: 11 height: 11 draw_svg +: {svg: ui_icon("updown") color: pt_paper_ink}}}
        }
    }
}
// Give a short paragraph room to edit without making the input narrower than
// the paragraph or extending the extra width past the edge of its page.
fn edit_width(t, e, k){
    max(e.box[2] * k + 16, min(180, max(24, (page_pt(t, e.page)[0] - e.box[0]) * k + 8)))
}
// Estimate enough height for the original text at the editor's width. The
// input keeps this size while typing so it retains focus and the caret.
fn edit_height(e, k, width){
    let em = max(8, e.size * k * 0.75) * 1.32
    let inner = max(40, width - 16)
    let lines = ceil(e.draft.len() * em * 0.56 / inner) + e.draft.split("\n").len() - 1
    max(88, max(e.box[3] * k + 16, lines * em * 1.3 + 22))
}
fn edit_box(t, k){
    let e = t.edit
    let b = e.box
    let width = edit_width(t, e, k)
    View{margin: Inset{left: b[0] * k - 8 top: b[1] * k - 8} width: width height: edit_height(e, k, width) flow: Overlay
        RoundedView{width: Fill height: Fill show_bg: true draw_bg +: {color: pt_paper border_size: 1.5 border_color: pt_on_page border_radius: 0.0}}
        edit_input := BareInput{width: Fill height: Fill margin: 6 padding: 2 is_multiline: true keeps_tab: true is_read_only: edit_busy(t) || history_busy(t) text: e.draft
            on_change: |text| { let x = cur_tab() if x != nil && x.edit != nil {
                if edit_busy(x) || history_busy(x) { return }
                let was = pending_draft(x)
                x.edit.draft = text
                if !edit_changes(x.edit) { x.edit_problem = "" render_status() }
                draft_changed(x, was)
                let can = x.edit.check_error == "" && edit_changes(x.edit)
                ui.edit_go.set_visible(can)
                ui.edit_off.set_visible(!can)
                schedule_check(x)
            } }
            on_escape: |text| cancel_edit(cur_tab())
            draw_cursor +: {color: pt_paper_text}
            draw_bg +: {color: pt_paper color_hover: pt_paper color_focus: pt_paper color_empty: pt_paper}
            draw_text +: {color: pt_paper_text color_hover: pt_paper_text color_focus: pt_paper_text color_empty: pt_paper_ink text_style: theme.font_regular{font_size: max(8, e.size * k * 0.75) line_spacing: 1.3}}}
        handle(0, 0) handle(0.5, 0) handle(1, 0) handle(0, 1) handle(0.5, 1) handle(1, 1)
    }
}
fn handle(ax, ay){
    View{width: Fill height: Fill align: Align{x: ax y: ay}
        RoundedView{width: 8 height: 8 show_bg: true draw_bg +: {color: pt_paper border_size: 1.5 border_color: pt_on_page border_radius: 1.0}}
    }
}

// Read mode's bar, at the foot of the pages and never over them: the toolbar's page
// and zoom, and the way back. (Everywhere else they are in the toolbar.)
fn read_bar_view(){
    let t = cur_tab()
    if t == nil || !reading_on(t) { return View{width: 1 height: 1} }
    View{width: Fill height: Fill flow: Right align: Align{x: 0.5 y: 0.5} padding: Inset{left: 6 right: 6}
        UiToolIcon{width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("chevron-left")} on_click: || step_page(cur_tab(), -1)}
        View{width: pick(t.pages >= 100, 68, 46) height: Fit align: Align{x: 0.5}
            Body{text: "" + t.page + " / " + t.pages}
        }
        UiToolIcon{width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("chevron-right")} on_click: || step_page(cur_tab(), 1)}
        UiVSep{height: 18 margin: Inset{left: 6 right: 6}}
        UiToolIcon{width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("minus")} on_click: || zoom_step(cur_tab(), -1)}
        View{width: 40 height: Fit align: Align{x: 0.5}
            Body{text: zoom_text(t)}
        }
        UiToolIcon{width: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("plus")} on_click: || zoom_step(cur_tab(), 1)}
        UiVSep{height: 18 margin: Inset{left: 6 right: 6}}
        UiToolIcon{width: 28 draw_icon +: {svg: icon("fit-width") color: pick(t.fit == "width", ui_link, ui_ink)} on_click: || fit_to("width")}
        UiToolIcon{width: 28 draw_icon +: {svg: icon("fit-page") color: pick(t.fit == "page", ui_link, ui_ink)} on_click: || fit_to("page")}
        UiVSep{height: 18 margin: Inset{left: 6 right: 6}}
        UiTool{text: "Exit Read Mode" draw_icon +: {svg: icon("fullscreen-exit")} on_click: || leave_reading(cur_tab())}
    }
}

// Pages mode: every page as a large thumbnail. Click to select, as in a Mac's list,
// drag to move, click twice to read that page.
fn grid_view(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let cols = grid_cols(t)
    let first = window_start(t)
    let last = window_end(t)
    let rows = ceil((last - first + 1) / cols)
    View{width: Fill height: Fit flow: Down spacing: 14 align: Align{x: 0.5}
        if first > 1 { LinkBtn{text: "Pages 1–" + (first - 1) on_click: || { let x = cur_tab() x.page = max(1, window_start(x) - 20) render_grid() pump() }} }
        for r in rows {
            View{width: cols * (tile_w(t) + 12) + (cols - 1) * 20 height: Fit flow: Right spacing: 20
                for c in cols {
                    if first + r * cols + c <= last { tile_view(t, first + r * cols + c) }
                }
            }
        }
        if last < t.pages { LinkBtn{text: "Pages " + (last + 1) + "–" + t.pages on_click: || { let x = cur_tab() x.page = window_end(x) + 1 render_grid() pump() }} }
    }
}
fn tile_view(t, p){
    let s = page_pt(t, p)
    let w = tile_w(t)
    let h = round(w * s[1] / max(1, s[0]))
    let on = has(t.selected, p)
    let src = optional(t.grid, "p" + p, nil)
    GestureView{width: w + 12 height: Fit flow: Down align: Align{x: 0.5} spacing: 4
        menu: PAGE_MENU
        on_menu: |title| page_menu(cur_tab(), p, title)
        on_tap: |x, y, cmd, shift| { if pt_modal { return } tile_tap(cur_tab(), p, cmd, shift) }
        on_pan: |dx, dy, phase| { if pt_modal { return } tile_pan(cur_tab(), p, dx, dy, phase) }
        RoundedView{width: w + 8 height: h + 8 padding: 4 show_bg: true
            draw_bg +: {color: pick(on, ui_selected, pt_clear) border_radius: 4.0}
            RectShadowView{width: w height: h draw_bg +: {color: pt_paper shadow_color: pt_shadow shadow_radius: 3.0 shadow_offset: vec2(0.0, 1.0)}
                if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
            }
        }
        RoundedView{width: Fit height: Fit padding: Inset{left: 6 right: 6 top: 1 bottom: 1} show_bg: true
            draw_bg +: {color: pick(on, ui_accent_row, pt_clear) border_radius: 3.0}
            Small{text: "" + p draw_text +: {color: pick(on, #xffffff, ui_muted)}}
        }
    }
}
// Where a dragged page would land: a line beside the tile, on its near side (the grid
// itself can't be drawn while a press holds a tile).
fn drag_mark_view(){
    let t = cur_tab()
    if t == nil || t.drag == nil || t.drag.to == t.drag.page { return View{width: 1 height: 1} }
    let at = tile_at(t, t.drag.to)
    let x = at[0] + pick(t.drag.to > t.drag.page, tile_w(t) + 15, -5)
    let y = max(0, at[1] - ui.grid.scroll_y())
    SolidView{margin: Inset{left: x top: y} width: 3 height: tile_h(t) + 8 draw_bg.color: ui_primary}
}

// Combine: PDFs in order, each with its pages, into one new PDF: a list on
// the white content that scrolls, in a scroll view of its own that keeps its
// place as the list is drawn again, and a foot that stays (the total, Name and
// the button).
fn tall_list_view(){
    let t = cur_tab()
    if t == nil || t.combine == nil { return View{width: Fill height: 1} }
    combine_items(t)
}
fn tall_foot_view(){
    let t = cur_tab()
    if t == nil || t.combine == nil { return View{width: Fill height: 1} }
    combine_foot(t)
}
fn combine_items(t){
    if ui_unified { return mac_combine_items(t) }
    let c = t.combine
    View{width: Fill height: Fit flow: Down
        for i it in c.items {
            combine_row(t, i, it)
            UiSep{margin: Inset{left: 76 right: 14}}
        }
        // A Mac's list adds rows from a push button at its foot.
        View{width: Fill height: 44 flow: Right align: Align{y: 0.5} padding: Inset{left: 14}
            Outline{text: "Add Files…" on_click: || { if pt_modal { return } let x = cur_tab() x.combine.adding = !x.combine.adding render_combine() }}
        }
        if c.adding { add_list(t) }
    }
}
// What the pane ends with: the total, the new PDF's name, a refusal, Combine.
fn combine_foot(t){
    let c = t.combine
    let total = combine_total(t)
    View{width: Fill height: Fit flow: Down
        UiSep{}
        if c.error != "" {
            View{width: Fill height: Fit padding: Inset{left: 14 right: 14 top: 6} Note{text: c.error draw_text +: {color: ui_danger}}}
        }
        View{width: Fill height: 44 flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 12} spacing: 8
            Second{text: pick(c.items.len() < 2, "Add another PDF to combine.", pick(total == nil, "Check the pages of each PDF", "One PDF of " + plural(total, "page", "pages"))) draw_text +: {color: ui_ink}}
            Gap{}
            Body{text: "Name:"}
            Field{width: 260 text: c.name empty_text: "Name of the new PDF" on_change: |text| { let x = cur_tab() x.combine.name = text }}
            if total == nil || c.busy || c.items.len() < 2 { PrimaryOff{text: pick(c.busy, "Combining…", "Combine")} }
            if total != nil && !c.busy && c.items.len() >= 2 { Primary{text: "Combine" on_click: || do_combine(cur_tab())} }
        }
    }
}
fn add_list(t){
    View{width: Fill height: Fit flow: Down padding: Inset{left: 68 right: 12 bottom: 8} spacing: 1
        for d in st.docs {
            if !combine_has(t, d.name) && d.error == "" && !d.locked {
                GestureView{width: Fill height: 28 flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} spacing: 6 on_tap: |x, y| { if pt_modal { return } combine_add(cur_tab(), d) }
                    Ico{width: 16 height: 16 draw_svg +: {svg: icon("file-pdf") color: ui_muted}}
                    One{text: shown_name(d.title)}
                    Small{text: doc_meta(d)}
                }
            }
        }
        GestureView{width: Fill height: 28 flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} spacing: 6 on_tap: |x, y| { if pt_modal { return } open_from_device() }
            Ico{width: 16 height: 16 draw_svg +: {svg: icon("folder") color: ui_link}}
            Body{text: "Open PDF…" draw_text +: {color: ui_link}}
        }
    }
}
fn combine_has(t, name){
    for it in t.combine.items { if it.name == name { return true } }
    false
}
fn combine_row(t, i, it){
    let src = optional(st.covers, it.name, nil)
    let n = item_count(it)
    GestureView{width: Fill height: COMBINE_ROW flow: Right align: Align{y: 0.5} padding: Inset{left: 8 right: 8} spacing: 10
        menu: ["Move Up", "Move Down", "-", "Remove"]
        on_menu: |title| combine_row_menu(cur_tab(), i, title)
        GestureView{width: 18 height: 36 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Grab
            on_pan: |dx, dy, phase| { if pt_modal { return } if phase == 2 { combine_move(cur_tab(), i, dy) } }
            Ico{width: 14 height: 14 draw_svg +: {svg: icon("grip")}}
        }
        RoundedView{width: 30 height: 40 padding: 1 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: pt_paper border_size: 1.0 border_color: ui_border border_radius: 0.5}
            if src != nil { Image{width: Fill height: Fill fit: ImageFit.Smallest src: src} }
        }
        One{text: shown_name(it.title)}
        RoundedView{width: 170 height: 28 flow: Overlay show_bg: true draw_bg +: {color: ui_field border_size: 1.0 border_color: pick(n == nil, ui_danger, ui_border) border_radius: 3.0}
            BareInput{width: Fill height: Fill padding: Inset{left: 8 right: 66 top: 6 bottom: 6} text: it.range empty_text: "All"
                on_change: |text| { let x = cur_tab() x.combine.items[i].range = text start_timeout(0.6, || render_combine()) }
                draw_text +: {color: ui_ink color_hover: ui_ink color_focus: ui_ink color_empty: ui_ink color_empty_hover: ui_ink color_empty_focus: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
            View{width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5} padding: Inset{right: 8}
                Small{text: pick(n == nil, "(?)", "(" + plural(n, "page", "pages") + ")")}
            }
        }
        IconBtn{draw_icon +: {svg: icon("close")} on_click: || combine_remove(cur_tab(), i)}
    }
}

// A Mac's Combine list: no grip and no ×. A click on a row away from its range picks it,
// Delete then takes it out (the arrow keys pick another), the row drags from there, and
// its right-click menu moves or removes it. Add Files… takes a PDF from the Open sheet.
fn mac_combine_items(t){
    let c = t.combine
    View{width: Fill height: Fit flow: Down
        for i it in c.items {
            mac_combine_row(t, i, it)
            UiSep{margin: Inset{left: 60 right: 14}}
        }
        View{width: Fill height: 44 flow: Right align: Align{y: 0.5} padding: Inset{left: 14}
            Outline{text: "Add Files…" on_click: || library_open_for(cur_tab())}
        }
    }
}
let COMBINE_MENU = ["Move Up", "Move Down", "-", "Remove"]
fn combine_menu_off(t, i){
    let off = []
    if i == 0 { off.push("Move Up") }
    if i >= t.combine.items.len() - 1 { off.push("Move Down") }
    off
}
fn mac_combine_row(t, i, it){
    let picked = optional(t.combine, "pick", -1) == i
    if picked {
        return View{width: Fill height: Fit
            combine_keys := GestureView{width: Fill height: Fit cursor: MouseCursor.Default
                menu: COMBINE_MENU menu_off: combine_menu_off(t, i)
                on_menu: |title| combine_row_menu(cur_tab(), i, title)
                on_tap: |x, y| combine_pick(cur_tab(), i)
                on_pan: |dx, dy, phase| combine_drag(cur_tab(), i, dy, phase)
                on_key: |key, cmd, shift| combine_key(cur_tab(), i, key)
                combine_face(t, i, it, true)
            }
        }
    }
    View{width: Fill height: Fit
        GestureView{width: Fill height: Fit cursor: MouseCursor.Default
            menu: COMBINE_MENU menu_off: combine_menu_off(t, i)
            on_menu: |title| combine_row_menu(cur_tab(), i, title)
            on_tap: |x, y| combine_pick(cur_tab(), i)
            on_pan: |dx, dy, phase| combine_drag(cur_tab(), i, dy, phase)
            combine_face(t, i, it, false)
        }
    }
}
fn combine_face(t, i, it, picked){
    let src = optional(st.covers, it.name, nil)
    let n = item_count(it)
    RoundedView{width: Fill height: COMBINE_ROW - 4 flow: Right align: Align{y: 0.5} margin: Inset{left: 6 right: 6 top: 2 bottom: 2} padding: Inset{left: 8 right: 10} spacing: 10 show_bg: true
        draw_bg +: {color: pick(picked, ui_selected, pt_clear) border_radius: 5.0}
        RoundedView{width: 30 height: 40 padding: 1 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: pt_paper border_size: 1.0 border_color: ui_border border_radius: 0.5}
            if src != nil { Image{width: Fill height: Fill fit: ImageFit.Smallest src: src} }
        }
        One{text: shown_name(it.title)}
        RoundedView{width: 170 height: 28 flow: Overlay show_bg: true draw_bg +: {color: ui_field border_size: 1.0 border_color: pick(n == nil, ui_danger, ui_border) border_radius: 3.0}
            BareInput{width: Fill height: Fill padding: Inset{left: 8 right: 66 top: 6 bottom: 6} text: it.range empty_text: "All"
                on_change: |text| { let x = cur_tab() x.combine.items[i].range = text start_timeout(0.6, || render_combine()) }
                draw_text +: {color: ui_ink color_hover: ui_ink color_focus: ui_ink color_empty: ui_ink color_empty_hover: ui_ink color_empty_focus: ui_muted text_style: theme.font_regular{font_size: 9.75}}}
            View{width: Fill height: Fill flow: Right align: Align{x: 1.0 y: 0.5} padding: Inset{right: 8}
                Small{text: pick(n == nil, "(?)", "(" + plural(n, "page", "pages") + ")")}
            }
        }
    }
}
fn combine_pick(t, i){
    if t == nil || t.combine == nil || pt_modal { return }
    t.combine.pick = i
    render_combine()
    start_timeout(0.05, || { try { ui.combine_keys.focus() } catch { nil } })
}
fn combine_drag(t, i, dy, phase){
    if t == nil || t.combine == nil || pt_modal || phase != 2 { return }
    t.combine.pick = -1
    combine_move(t, i, dy)
}
fn combine_key(t, i, key){
    if t == nil || t.combine == nil { return }
    let c = t.combine
    if key == "Backspace" || key == "Delete" {
        c.pick = -1
        combine_remove(t, i)
        return
    }
    if key == "Escape" {
        c.pick = -1
        render_combine()
        return
    }
    if key == "ArrowUp" && i > 0 { combine_pick(t, i - 1) }
    if key == "ArrowDown" && i < c.items.len() - 1 { combine_pick(t, i + 1) }
}

// The inspector in Comment mode: the threads.
fn thread_panel(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let count = 0
    if t.comments != nil { count = t.comments.len() }
    View{width: right_w(t) height: Fill flow: Down
        View{width: Fill height: ROW_H flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 6} spacing: 6
            Bold{text: "Comments"}
            Second{text: "" + count}
            Gap{}
            if st.who.author != "" || t.thread != nil {
                more_pick := GestureView{width: 28 height: 28 on_menu: |title| more_chosen(cur_tab(), title)
                    UiToolIcon{enabled: !comment_delete_busy(t) width: 28 icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("more") color: pick(comment_delete_busy(t), pt_off, ui_muted) preserve_viewbox: true} on_click: || ui.more_pick.open_menu(more_titles(cur_tab()))}
                }
            }
        }
        UiSep{}
        if st.who.author == "" || st.naming { author_card() }
        ScrollY{width: Fill height: Fill flow: Down padding: Inset{left: 10 right: 10 top: 10 bottom: 16} spacing: 8
            if t.pending != nil { pending_card(t) }
            if t.comments == nil {
                View{width: Fill height: Fit padding: Inset{left: 4 right: 4} Note{text: pick(t.comments_state == "" || t.comments_state == "loading", "Reading the comments…", t.comments_state)}}
            }
            if t.comments != nil && t.comments.len() == 0 && t.pending == nil {
                View{width: Fill height: Fit padding: Inset{left: 4 right: 4} Note{text: comment_hint(t)}}
            }
            if t.comments != nil { for c in t.comments { thread_card(t, c) } }
        }
    }
}
fn more_titles(t){
    let out = []
    if st.who.author != "" { out.push("Comment as " + st.who.author + "…") }
    if t != nil && t.thread != nil { out.push("Delete Comment") }
    out
}
fn more_chosen(t, title){
    if t == nil || pt_modal { return }
    if title == "Delete Comment" {
        delete_comment(t)
        return
    }
    st.naming = true
    st.name_draft = st.who.author
    render_right()
}
// Comments carry the person's name; asked once, kept in library.json.
fn author_card(){
    View{width: Fill height: Fit flow: Down nav_group: true
        View{width: Fill height: Fit flow: Down padding: Inset{left: 14 right: 14 top: 10 bottom: 10} spacing: 6
            Second{text: "Comment as"}
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                Field{text: st.name_draft empty_text: "Your name" on_change: |text| { st.name_draft = text swap_default(text, ui.author_go, ui.author_off) } on_return: |text| set_author(text)
                    on_escape: |text| {
                        st.naming = false
                        render_right()
                        ui.keys.focus()
                    }}
                author_go := Primary{visible: st.name_draft.trim() != "" text: "Save" on_click: || set_author(st.name_draft)}
                author_off := PrimaryOff{visible: st.name_draft.trim() == "" text: "Save"}
            }
            Small{width: Fill flow: Flow.Right{wrap: true} text: "Your comments and replies show this name."}
        }
        UiSep{}
    }
}
// The default of a field that wants some words: on once it has them.
fn swap_default(text, on, off){
    let has = ("" + text).trim() != ""
    on.set_visible(has)
    off.set_visible(!has)
}
fn comment_hint(t){
    if t.tool == "note" || t.tool == "textbox" { return "No comments yet. Click the page where the " + pick(t.tool == "note", "note", "text box") + " goes." }
    "No comments yet. Click a line of text to " + pick(t.tool == "highlight", "highlight", pick(t.tool == "underline", "underline", "strike out")) + " it; click twice for its paragraph."
}
// A monogram in the gray of a Mac's contact with no picture.
fn avatar(name){
    RoundedView{width: 24 height: 24 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: ui_selected border_radius: 6.0}
        Small{text: initials_of(name) draw_text +: {color: ui_ink}}
    }
}
fn message(author, date, text, indent){
    View{width: Fill height: Fit flow: Right padding: Inset{left: indent} spacing: 8
        avatar(author)
        View{width: Fill height: Fit flow: Down spacing: 2
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                Bold{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: pick(author == "", "Comment", author)}
                Small{text: comment_when(date, time_now())}
            }
            if text != "" { Wrap{text: text} }
        }
    }
}
let STATUSES = ["accepted", "rejected", "completed", "cancelled", "none"]
fn status_titles(){
    let out = []
    for s in STATUSES { out.push(pick(s == "none", "None", status_label(s))) }
    out
}
fn status_chosen(t, title){
    if t == nil || pt_modal { return }
    for s in STATUSES { if pick(s == "none", "None", status_label(s)) == title { set_status(t, s) } }
}
fn thread_card(t, c){
    let open = t.thread == c.id
    let st_label = status_label(optional(c, "status", ""))
    let tone = pick(st_label == "", ui_muted, pt_status_ink)
    let busy = history_busy(t) || comment_delete_busy(t)
    GestureView{width: Fill height: Fit menu: COMMENT_MENU on_menu: |title| comment_chosen(c, title)
    UiGroup{
        GestureView{width: Fill height: 30 flow: Right align: Align{y: 0.5} padding: Inset{left: 10 right: 8} spacing: 7
            on_tap: |x, y| { if pt_modal { return } let x = cur_tab() if x.thread == c.id { if draft_guard(x, "closing this comment") { return } x.thread = nil render_right() render_canvas() } else { open_thread(x, c) } }
            RoundedView{width: 10 height: 10 show_bg: true draw_bg +: {color: mark_color(optional(c, "color", "")) border_radius: 2.5}}
            Body{text: "Page " + c.page}
            Gap{}
            if !open { Small{text: comment_when(optional(c, "date", ""), time_now())} }
            Ico{width: 9 height: 9 draw_svg +: {svg: icon(pick(open, "chevron-up", "chevron-down")) color: ui_muted}}
        }
        if !open {
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 10 right: 10 bottom: 8} spacing: 8
                avatar(optional(c, "author", ""))
                Second{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: pick(optional(c, "author", "") == "", "Comment", optional(c, "author", ""))}
            }
        }
        if open {
            UiSep{}
            View{width: Fill height: Fit flow: Down padding: 10 spacing: 10
                message(optional(c, "author", ""), optional(c, "date", ""), optional(c, "text", ""), 0)
                for r in optional(c, "replies", []) { message(optional(r, "author", ""), optional(r, "date", ""), optional(r, "text", ""), 32) }
                View{width: Fill height: Fit flow: Right padding: Inset{left: 32}
                    status_pick := GestureView{width: Fit height: 28 on_menu: |title| status_chosen(cur_tab(), title)
                        Outline{enabled: !busy text: pick(st_label == "", "Set Status…", st_label)
                            draw_text +: {color: pick(busy, pt_off, tone) color_hover: pick(busy, pt_off, pick(st_label == "", ui_ink, pt_status_ink)) color_down: pick(busy, pt_off, pick(st_label == "", ui_ink, pt_status_ink)) color_focus: pick(busy, pt_off, tone)}
                            on_click: || ui.status_pick.open_menu(status_titles())}
                    }
                }
                reply_box(t, "Reply…", || post_reply(cur_tab()))
            }
        }
    }
    }
}
fn reply_box(t, hint, post){
    let blocked = history_busy(t) || comment_delete_busy(t)
    View{width: Fill height: 28 flow: Right align: Align{y: 0.5} spacing: 6 nav_group: true
        Field{text: t.reply is_read_only: blocked empty_text: pick(comment_delete_busy(t), "Deleting comment…", hint)
            draw_text +: {color_empty: pick(blocked, pt_off, ui_muted) color_empty_hover: pick(blocked, pt_off, ui_muted) color_empty_focus: pick(blocked, pt_off, ui_muted)}
            on_change: |text| { let x = cur_tab() if history_busy(x) || comment_delete_busy(x) { return } let was = pending_draft(x) x.reply = text draft_changed(x, was) if !comment_busy(x) { swap_default(text, ui.reply_go, ui.reply_off) } }
            on_return: |text| { let x = cur_tab() if history_busy(x) || comment_delete_guard(x) { return } x.reply = text post() }
            on_escape: |text| {
                let x = cur_tab()
                if comment_delete_guard(x) { return }
                if comment_busy(x) { note("The comment is still being posted.") return }
                let was = pending_draft(x)
                x.reply = ""
                x.pending = nil
                x.comment_problem = ""
                draft_changed(x, was)
                render_status()
                render_right()
                render_canvas()
                ui.keys.focus()
            }}
        reply_go := Primary{visible: !comment_busy(t) && !blocked && t.reply.trim() != "" padding: Inset{left: 10 right: 10} text: "Post" on_click: || post()}
        reply_off := PrimaryOff{visible: comment_busy(t) || blocked || t.reply.trim() == "" padding: Inset{left: 10 right: 10} text: pick(comment_busy(t), "Posting…", "Post")}
    }
}
fn pending_card(t){
    UiGroup{padding: 10 spacing: 8 draw_bg +: {border_color: ui_link}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 7
            RoundedView{width: 10 height: 10 show_bg: true draw_bg +: {color: mark_color(t.color) border_radius: 2.5}}
            Body{width: Fill text: "New " + pick(t.pending.type == "note", "note", "text box") + " on page " + t.pending.page}
            IconBtn{draw_icon +: {svg: icon("close")} on_click: || { let x = cur_tab() if comment_busy(x) { note("The comment is still being posted.") return } let was = pending_draft(x) x.pending = nil x.reply = "" x.comment_problem = "" draft_changed(x, was) render_status() render_right() render_canvas() }}
        }
        reply_box(t, pick(t.pending.type == "note", "Write the note…", "Write the text…"), || post_pending(cur_tab()))
    }
}

// The inspector in Fill & Sign and Edit.
fn side_panel(){
    let t = cur_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    if t.mode == "edit" { return edit_panel(t) }
    fields_panel(t)
}
// Fill & Sign's inspector: the form's fields, as an index. The filling is on the page.
fn fields_panel(t){
    View{width: right_w(t) height: Fill flow: Down
        View{width: Fill height: ROW_H flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14}
            Bold{width: Fill text: "Fields"}
        }
        UiSep{}
        View{width: Fill height: Fit padding: Inset{left: 14 right: 14 top: 8 bottom: 8}
            Note{text: form_summary(t)}
        }
        // A narrow window's inspector puts each value under its name, whole, so the
        // columns' heads go.
        if t.fields != nil && t.fields.len() > 0 && !narrow() {
            UiSep{}
            View{width: Fill height: 24 flow: Right spacing: 8 align: Align{y: 0.5} padding: Inset{left: 14 right: 14}
                Small{width: 122 text: "Field name"}
                Small{text: "Value"}
            }
            UiSep{}
        }
        if t.fields != nil && t.fields.len() > 0 && narrow() { UiSep{} }
        ScrollY{width: Fill height: Fill flow: Down padding: Inset{bottom: 6}
            if t.fields != nil { for f in t.fields { field_row(t, f) } }
        }
    }
}
fn field_row(t, f){
    if ui_unified { return mac_field_row(t, f) }
    let on = t.field == f.name
    let need = optional(f, "required", false)
    let empty = field_empty(f)
    GestureView{width: Fill height: pick(narrow(), 42, 28) menu: field_row_menu(f) on_menu: |title| field_row_chosen(cur_tab(), f, title)
        on_tap: |x, y| {
            if pt_modal { return }
            field_row_tap(cur_tab(), f)
        }
        RoundedView{width: Fill height: Fill flow: pick(narrow(), Flow.Down, Flow.Right) align: Align{y: 0.5} spacing: pick(narrow(), 1, 8) margin: Inset{left: 8 right: 8} padding: Inset{left: 6 right: 6} new_batch: true show_bg: true draw_bg +: {color: pick(on, ui_selected, pt_clear) border_radius: 5.0}
            Body{width: pick(narrow(), Fill, 122) max_lines: 1 text_overflow: TextOverflow.Ellipsis text: optional(f, "name", "") + pick(need, " *", "") draw_text +: {color: pick(need && empty, pick(on, pt_row_danger, ui_danger), pick(narrow(), ui_muted, ui_ink))}}
            Body{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: pick(empty, "Empty", field_shown(f)) + pick(read_only(f), "  (read-only)", "") draw_text +: {color: pick(empty, ui_muted, ui_ink)}}
        }
    }
}
// A Mac's index row: the whole value, wrapped under its column, as a Mac inspector's
// table widens its column for a long one.
fn mac_field_row(t, f){
    let on = t.field == f.name
    let need = optional(f, "required", false)
    let empty = field_empty(f)
    GestureView{width: Fill height: Fit menu: field_row_menu(f) on_menu: |title| field_row_chosen(cur_tab(), f, title)
        on_tap: |x, y| {
            if pt_modal { return }
            field_row_tap(cur_tab(), f)
        }
        RoundedView{width: Fill height: Fit flow: pick(narrow(), Flow.Down, Flow.Right) spacing: pick(narrow(), 1, 8) margin: Inset{left: 8 right: 8} padding: Inset{left: 6 right: 6 top: 6 bottom: 6} new_batch: true show_bg: true draw_bg +: {color: pick(on, ui_selected, pt_clear) border_radius: 5.0}
            Label{clip_y: false padding: 0 width: pick(narrow(), Fill, 122) flow: Flow.Right{wrap: true} text: optional(f, "name", "") + pick(need, " *", "") draw_text +: {color: pick(need && empty, pick(on, pt_row_danger, ui_danger), pick(narrow(), ui_muted, ui_ink)) text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.2}}}
            Label{clip_y: false padding: 0 width: Fill flow: Flow.Right{wrap: true} text: pick(empty, "Empty", field_shown(f)) + pick(read_only(f), " (read-only)", "") draw_text +: {color: pick(empty, ui_muted, ui_ink) text_style: theme.font_regular{font_size: 9.75 line_spacing: 1.2}}}
        }
    }
}
// Read-only and non-fillable fields still have a place on the page, even
// though selecting them must not open an editor.
fn view_field(t, f){
    if t == nil { return }
    if field_guard(t) { return }
    if draft_guard(t, "opening a field") { return }
    if field_handoff(t, f, "view", nil) { return }
    close_field(t, true)
    t.place = nil
    let doc = t.doc
    let page = f.page
    go_page(t, page)
    let jump = st.jump_n
    render_right()
    render_toolrow()
    start_timeout(0.2, || {
        let x = cur_tab()
        if x == nil || x.doc != doc || x.page != page || x.field != nil || st.jump_n != jump { return }
        reveal_field(x, f)
    })
}
// A row of the index goes to its field; a choice opens its menu there.
fn field_row_tap(t, f){
    if read_only(f) || !fillable(f) { view_field(t, f) return }
    select_field_action(t, f, "row")
}
// Edit's inspector: the paragraph's fields, which scroll, with Apply and
// Cancel staying in view at its foot.
fn edit_panel(t){
    View{width: right_w(t) height: Fill flow: Down
        edit_head(t)
        if t.edit == nil {
            View{width: Fill height: Fit padding: 14 Note{text: pick(t.can_edit, "Click a paragraph on the page to edit its text.", "This PDF doesn't allow editing.")}}
        }
        if t.edit != nil {
            ScrollY{width: Fill height: Fill flow: Down
                View{width: Fill height: Fit flow: Down padding: 14 spacing: 6
                    edit_fields(t.edit)
                }
            }
            UiSep{}
            View{width: Fill height: Fit flow: Down padding: 14
                edit_buttons(t)
            }
        }
    }
}
// The inspector's head: its title and the paragraph, and while one is open,
// its close cross.
fn edit_head(t){
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: ROW_H flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 6} spacing: 6
            Bold{text: "Edit Text"}
            if t.edit != nil { Second{width: Fill text: "Paragraph " + t.edit.n} }
            if t.edit == nil { Gap{} }
            if t.edit != nil { IconBtn{enabled: !edit_busy(t) && !history_busy(t) draw_icon +: {svg: icon("close") color: pick(edit_busy(t) || history_busy(t), pt_off, ui_muted)} on_click: || cancel_edit(cur_tab())} }
        }
        UiSep{}
    }
}
// Font (and what the edit would do, under it), Alignment and Colour.
fn edit_fields(e){
    View{width: Fill height: Fit flow: Down spacing: 6
        Second{text: "Font"}
        // Nothing to choose: on a desktop it reads as what it is, not as a field.
        if ui_desk { Body{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: font_text(e)} }
        else { ValueBox{
            Body{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: font_text(e)}
        } }
        if edit_says(e) { edit_notes(e) }
        View{width: Fill height: Fit padding: Inset{top: 6} Second{text: "Alignment"}}
        align_segments(e)
        View{width: Fill height: Fit padding: Inset{top: 6} Second{text: "Color"}}
        colour_box(e)
    }
}
// The default rightmost, Cancel to its left; what the engine won't do can't be pressed.
fn edit_buttons(t){
    let e = t.edit
    let applying = edit_busy(t)
    let busy = applying || history_busy(t)
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{x: 1.0 y: 0.5}
        if busy { PrimaryOff{text: "Cancel"} }
        else { Outline{text: "Cancel" on_click: || cancel_edit(cur_tab())} }
        edit_off := PrimaryOff{visible: busy || e.check_error != "" || !edit_changes(e) text: pick(applying, "Applying…", "Apply")}
        edit_go := Primary{visible: !busy && e.check_error == "" && edit_changes(e) text: pick(apply_label(e) == "Apply", "Apply", "Apply Anyway") on_click: || apply_edit(cur_tab())}
    }
}
// A colour's name, in the Mac's spelling.
fn colour_shown(hex){
    if hex == nil { return "Original Color" }
    let name = colour_name(hex)
    if name == "Dark grey" { return "Dark Gray" }
    name
}

// Whether the Edit panel has something to say about the edit before Apply.
fn edit_says(e){ e.check_error != "" || edit_risks(e.check).len() > 0 || e.pieces > 1 }
// What the edit would do, under the paragraph's font (pdf.edit_check): why
// the engine won't make it, or what changes besides the words (another font,
// text over its neighbours or off the page); and a line the PDF keeps in
// pieces.
fn edit_notes(e){
    View{width: Fill height: Fit flow: Down spacing: 6 padding: Inset{top: 2}
        if e.check_error != "" { edit_note("warning", ui_danger, e.check_error) }
        if e.check_error == "" { for r in edit_risks(e.check) { edit_note("warning", pt_warn, r) } }
        if e.pieces > 1 { edit_note("info", ui_muted, pieces_note(e.pieces)) }
    }
}
fn edit_note(ic, colour, text){
    View{width: Fill height: Fit flow: Right spacing: 6
        Ico{width: 13 height: 13 margin: Inset{top: 1} draw_svg +: {svg: icon(ic) color: colour}}
        Note{text: text draw_text +: {color: ui_ink}}
    }
}
// Alignment: a segmented control (left, centre, right, justify), the
// paragraph's own (guess_align) chosen until another is clicked.
fn align_segments(e){
    let busy = edit_busy(cur_tab()) || history_busy(cur_tab())
    RoundedView{width: Fill height: 28 flow: Right padding: 2 spacing: 2 show_bg: true draw_bg +: {color: ui_selected border_radius: 3.5}
        for a in ALIGNS {
            GestureView{width: Fill height: Fill on_tap: |x, y| { if pt_modal { return } set_align(cur_tab(), a) }
                RoundedView{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} show_bg: true
                    draw_bg +: {color: pick(e.align == a, pt_seg_on, pt_clear) border_size: pick(e.align == a, 1.0, 0.0) border_color: ui_border border_radius: 2.5}
                    Ico{width: 16 height: 16 draw_svg +: {svg: icon("align-" + a) color: pick(busy, pt_off, ui_ink)}}
                }
            }
        }
    }
}
// A text colour as the Edit panel shows it (TEXT_COLOURS).
fn text_swatch(hex){
    if hex == "#4b4f54" { return #x4b4f54 }
    if hex == "#1a5fb4" { return #x1a5fb4 }
    if hex == "#c01c28" { return #xc01c28 }
    if hex == "#26a269" { return #x26a269 }
    if hex == "#e66100" { return #xe66100 }
    #x000000
}
// A colour's square; an empty one for the paragraph's own colour, which the
// engine doesn't report.
fn swatch(hex){
    if hex == nil {
        return RoundedView{width: 16 height: 16 show_bg: true draw_bg +: {color: ui_field border_size: 1.0 border_color: ui_border border_radius: 2.0}}
    }
    RoundedView{width: 16 height: 16 show_bg: true draw_bg +: {color: text_swatch(hex) border_size: 1.0 border_color: ui_border border_radius: 2.0}}
}
// Colour: a pop-up of the colours, the chosen one's square in its face.
fn colour_box(e){
    let busy = edit_busy(cur_tab()) || history_busy(cur_tab())
    View{width: Fill height: 28 flow: Overlay align: Align{x: 1.0 y: 0.5}
        colour_pick := GestureView{width: Fill height: 28 menu_words_at: 32 on_menu: |title| colour_chosen(title)
            UiPopup{enabled: !busy width: Fill padding: Inset{left: 32 right: 28} text: colour_shown(e.color) draw_text +: {color: pick(busy, pt_off, ui_ink)} on_click: || { if edit_guard(cur_tab()) || history_guard(cur_tab()) { return } ui.colour_pick.open_menu(colour_titles(), colour_shown(cur_tab().edit.color)) }}
        }
        View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 9} new_batch: true swatch(e.color)}
        UiPopupMark{}
    }
}

// What a tab shows when its PDF isn't open: opening, damaged, protected,
// no engine, too many open.
fn notice_view(){
    let t = cur_tab()
    if t == nil || t.state == "ready" { return View{width: 1 height: 1} }
    if t.state == "opening" {
        return View{width: Fit height: Fit flow: Down align: Align{x: 0.5} spacing: 10
            LoadingSpinner{width: 22 height: 22}
            Second{text: "Opening " + shown_name(t.title) + "…"}
        }
    }
    let head = "Couldn't Open This PDF"
    let detail = "It may be damaged, or not a PDF at all."
    if t.state == "failed" { detail = "PDF Tools couldn't read it just now. Try again in a moment." }
    let ic = "warning"
    if t.state == "protected" {
        head = "This PDF Is Protected with a Password"
        detail = "PDF Tools can't open password-protected PDFs yet. Save a copy without the password, then open that."
        ic = "lock"
    }
    if t.state == "missing" {
        head = engine_headline()
        detail = engine_detail()
    }
    if t.state == "full" {
        head = "PDF Tools Has " + MAX_OPEN + " PDFs Open"
        detail = "Close another PDF's tab, then open this one again."
    }
    View{width: 420 height: Fit flow: Down align: Align{x: 0.5} spacing: 6
        Ico{width: 36 height: 36 margin: Inset{bottom: 4} draw_svg +: {svg: icon(ic) color: ui_muted}}
        Label{clip_y: false padding: 0 width: Fill flow: Flow.Right{wrap: true} align: Align{x: 0.5} text: head draw_text +: {color: ui_ink text_style: theme.font_bold{font_size: 11.25}}}
        Note{align: Align{x: 0.5} text: detail}
        // A file that can't be read says so once, with OK, as Preview says it; a read
        // that may work next time (too many open, a service that didn't answer) has
        // Try Again (open_lasting).
        View{width: Fit height: Fit flow: Right margin: Inset{top: 8} spacing: 8
            if t.state == "damaged" { Primary{padding: Inset{left: 26 right: 26} text: "OK" on_click: || close_tab(cur_tab(), true)} }
            if t.state != "damaged" { Outline{text: "Close Tab" on_click: || close_tab(cur_tab(), true)} }
            if t.state == "full" || t.state == "failed" { Primary{text: "Try Again" on_click: || { let x = cur_tab() load_tab(x) refresh_doc() }} }
        }
    }
}

// Home: the library, on the white content; the toolbar opens a PDF.
fn home_cols(){ max(2, floor((st.width - 40 + CARD_GAP) / (CARD_MIN + CARD_GAP))) }
fn card_w(){
    let cols = home_cols()
    floor((st.width - 40 - (cols - 1) * CARD_GAP) / cols)
}
fn home_view(){
    let cols = home_cols()
    let days = days_now()
    View{width: Fill height: Fit flow: Down padding: Inset{left: 20 right: 20 top: 14 bottom: 24}
        if st.engine == "missing" || st.engine == "old" { home_alert(engine_headline(), engine_detail(), "", false) }
        if st.alert != nil { home_alert(st.alert.head, st.alert.detail, st.alert.note, true) }
        if st.space_full { home_alert("PDF Tools' storage is full", "Remove a PDF to make room: page pictures and new PDFs can't be saved until there's space.", "", false) }
        if st.docs.len() == 0 { home_empty() }
        if st.docs.len() > 0 {
            View{width: Fill height: Fit padding: Inset{bottom: 6} SideHead{text: "Recent"}}
            View{width: Fill height: Fit flow: Down spacing: 18
                for r in ceil(st.docs.len() / cols) {
                    View{width: Fill height: Fit flow: Right spacing: CARD_GAP
                        for c in cols { if r * cols + c < st.docs.len() { doc_card(st.docs[r * cols + c], days, r * cols + c == st.home_at) } }
                    }
                }
            }
        }
    }
}
// An empty library: a line or two, and the one button.
fn home_empty(){
    UiEmpty{height: max(240, st.height - BAR_H - FOOT_H - 42)
        glyph +: {draw_svg +: {svg: icon("file-pdf")}}
        title +: {text: "No PDFs Yet"}
        note +: {width: Fill align: Align{x: 0.5} flow: Flow.Right{wrap: true} text: pick(ui_unified, "Import a PDF from this Mac to read, search, comment on, fill and sign, or rearrange it. PDF Tools keeps its own copy.", "Open a PDF to read, search, comment on, fill and sign, or rearrange it. PDF Tools keeps its own copy.")}
        UiPrimary{margin: Inset{top: 8} height: 28 padding: Inset{left: 14 right: 14} text: pick(st.importing, "Choosing a PDF…", pick(ui_unified, "Import…", "Open PDF…")) on_click: || open_from_device()}
        if st.files_ok && import_limit() != "" { Small{text: import_limit()} }
        if st.files_known && !st.files_ok { Small{text: "Not available here"} }
    }
}
fn home_alert(head, detail, code, dismiss){
    UiGroup{margin: Inset{bottom: 14} flow: Right padding: 10 spacing: 10
        Ico{width: 16 height: 16 draw_svg +: {svg: icon("warning") color: ui_danger}}
        View{width: Fill height: Fit flow: Down spacing: 3
            Wrap{text: head draw_text +: {text_style: theme.font_bold{font_size: 9.75 line_spacing: 1.3}}}
            Note{text: detail}
            if code != "" { Code{text: code} }
        }
        if dismiss { Outline{text: "OK" on_click: || { st.alert = nil render_home() }} }
    }
}
// A PDF as a Mac shows a document in icon view: its first page standing on a
// common line, and its name and facts centred under it.
fn card_chosen(d, title){
    if pt_modal { return }
    if title == "Open" { open_doc(d) }
    if title == "Remove…" { ask_remove(d) }
}
fn doc_card(d, days, on){
    let src = optional(st.covers, d.name, nil)
    // (A GestureView takes a press itself unless the button pressed lies inside
    // it, which a button flush with its edge may not: hence the padding.)
    GestureView{width: card_w() height: Fit flow: Down align: Align{x: 0.5} padding: Inset{right: 2 bottom: 2}
        menu: ["Open", "-", "Remove…"]
        on_menu: |title| card_chosen(d, title)
        on_tap: |x, y| { if pt_modal { return } open_doc(d) }
        View{width: Fill height: COVER_H flow: Down align: Align{x: 0.5 y: 1.0}
            // The card the keys are on stands on a highlight, as an icon does in Finder.
            RoundedView{width: COVER_W + 12 height: Fit padding: 6 show_bg: true draw_bg +: {color: pick(on, ui_selected, pt_clear) border_size: pick(on, 2.0, 0.0) border_color: ui_primary border_radius: 4.0}
                RectShadowView{width: COVER_W height: Fit
                    draw_bg +: {color: pt_paper shadow_color: pt_shadow shadow_radius: 4.0 shadow_offset: vec2(0.0, 1.0)}
                    if src != nil { Image{width: Fill height: Fit fit: ImageFit.Horizontal src: src} }
                    if src == nil {
                        View{width: Fill height: 168 align: Align{x: 0.5 y: 0.5}
                            Ico{width: 28 height: 28 draw_svg +: {svg: icon(pick(d.locked, "lock", pick(d.error != "", "warning", "file-pdf"))) color: pt_paper_ink}}
                        }
                    }
                }
            }
        }
        Body{width: Fill align: Align{x: 0.5} max_lines: 1 text_overflow: TextOverflow.Ellipsis margin: Inset{top: 4} text: shown_name(d.title)}
        Small{width: Fill align: Align{x: 0.5} max_lines: 1 text_overflow: TextOverflow.Ellipsis text: doc_meta(d) draw_text +: {color: pick(d.error != "", ui_danger, ui_muted)}}
        View{width: Fill height: 28 flow: Overlay
            View{width: Fill height: Fill flow: Right align: Align{x: 0.5 y: 0.5}
                Small{text: opened_text(d, days)}
            }
        }
    }
}

// What Home's status bar says, as Finder's does of a folder: how many PDFs,
// and the room left in the app's storage (files.status's numbers or, from a
// host that doesn't give them, the library's PDFs against the system ceiling).
fn storage_text(){
    let count = plural(st.docs.len(), "PDF", "PDFs")
    if st.used >= 0 && st.quota > 0 { return count + ", " + available_text(st.used, st.quota) }
    count + ", " + available_text(library_bytes(), QUOTA)
}
// A failed save stays visible when the person goes to another document or Home.
fn other_save_problem(current){
    for t in st.tabs {
        let problem = try { t.save_problem } catch { "" }
        if (current == nil || current.name != t.name) && problem != "" && !t.saving { return t }
    }
    nil
}
fn other_comment_problem(current){
    for t in st.tabs {
        let problem = try { t.comment_problem } catch { "" }
        if (current == nil || current.name != t.name) && problem != "" && !comment_busy(t) { return t }
    }
    nil
}
fn other_delete_problem(current){
    for t in st.tabs {
        let problem = try { t.comment_delete_problem } catch { nil }
        if (current == nil || current.name != t.name) && problem != nil && !comment_delete_busy(t) && !t.saving { return t }
    }
    nil
}
fn other_edit_problem(current){
    for t in st.tabs {
        let problem = try { t.edit_problem } catch { "" }
        if (current == nil || current.name != t.name) && problem != "" && !edit_busy(t) { return t }
    }
    nil
}
fn other_history_problem(current){
    for t in st.tabs {
        let problem = try { t.history_problem } catch { nil }
        if (current == nil || current.name != t.name) && problem != nil && !history_busy(t) && !t.saving { return t }
    }
    nil
}
fn other_problem_status(current, failed, problem){
    let dirty = if current == nil { false } else { current.edited || field_dirty(current) }
    let draft = pending_draft(current)
    let state = if current == nil || current.state != "ready" { "" } else { pick(current.saving, "Saving…", pick(dirty, "Edited", pick(draft, "Editing", "Saved"))) }
    // A Mac's title says "— Edited" (mac_modebar): the status bar says only what is under way.
    if ui_unified && current != nil && current.state == "ready" { state = pick(current.saving, "Saving…", pick(draft, "Editing", "")) }
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 8
        if state != "" && !ui_unified {
            RoundedView{width: 8 height: 8 show_bg: true draw_bg +: {color: pick(dirty || draft || current.saving, pt_warn, ui_success) border_radius: 2.0}}
        }
        if state != "" { Small{text: state} }
        Small{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: problem draw_text +: {color: ui_danger}}
        LinkBtn{height: 20 text: "Open PDF" on_click: || { let i = tab_index(failed) if i >= 0 { show_tab(i) } }}
    }
}
fn other_save_status(current, failed){ other_problem_status(current, failed, "Couldn't save “" + shown_name(failed.title) + "”.") }
fn other_comment_status(current, failed){ other_problem_status(current, failed, "Couldn't post in “" + shown_name(failed.title) + "”.") }
fn other_delete_status(current, failed){ other_problem_status(current, failed, "Couldn't delete a comment in “" + shown_name(failed.title) + "”.") }
fn other_edit_status(current, failed){ other_problem_status(current, failed, "Couldn't apply text in “" + shown_name(failed.title) + "”.") }
fn other_history_status(current, failed){ other_problem_status(current, failed, "Couldn't " + pick(failed.history_problem.redo, "redo", "undo") + " in “" + shown_name(failed.title) + "”.") }
// The status bar: Home's contents, or whether the open PDF is saved.
fn status_view(){
    let t = cur_tab()
    if t == nil {
        let failed = other_save_problem(nil)
        if failed != nil { return other_save_status(nil, failed) }
        let edit_failed = other_edit_problem(nil)
        if edit_failed != nil { return other_edit_status(nil, edit_failed) }
        let history_failed = other_history_problem(nil)
        if history_failed != nil { return other_history_status(nil, history_failed) }
        let delete_failed = other_delete_problem(nil)
        if delete_failed != nil { return other_delete_status(nil, delete_failed) }
        let comment_failed = other_comment_problem(nil)
        if comment_failed != nil { return other_comment_status(nil, comment_failed) }
        return View{width: Fill height: Fill flow: Right align: Align{x: 0.5 y: 0.5} padding: Inset{left: 14 right: 14}
            if st.said != "" { Small{text: st.said} }
            else { Small{text: storage_text() draw_text +: {color: pick(st.space_full, ui_danger, ui_muted)}} }
        }
    }
    let pending = try { t.field_wait == true } catch { false }
    let retry = try { t.field_retry } catch { nil }
    if pending || retry != nil {
        let problem = try { t.field_problem } catch { "" }
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 8
            Small{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: if pending { "Applying field…" } else { problem } draw_text +: {color: pick(pending, ui_muted, ui_danger)}}
            if !pending {
                LinkBtn{height: 20 text: "Discard Changes" on_click: || close_field(cur_tab(), false)}
                LinkBtn{height: 20 text: "Try Again" on_click: || retry_field(cur_tab())}
            }
        }
    }
    if edit_busy(t) {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14}
            Small{text: "Applying text…"}}
    }
    if history_busy(t) {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14}
            Small{text: pick(t.history_wait == "redo", "Redoing…", "Undoing…")}}
    }
    if comment_delete_busy(t) {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14}
            Small{text: "Deleting comment…"}}
    }
    let save_problem = try { t.save_problem } catch { "" }
    if !t.saving && save_problem != "" {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 8
            Small{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: save_problem draw_text +: {color: ui_danger}}
            LinkBtn{height: 20 text: "Try Again" on_click: || save(cur_tab(), nil)}
        }
    }
    let edit_problem = try { t.edit_problem } catch { "" }
    if !edit_busy(t) && edit_problem != "" {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 8
            Small{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: edit_problem draw_text +: {color: ui_danger}}
            if t.edit != nil && edit_changes(t.edit) { LinkBtn{height: 20 text: "Try Again" on_click: || apply_edit(cur_tab())} }
        }
    }
    let comment_problem = try { t.comment_problem } catch { "" }
    if !comment_busy(t) && comment_problem != "" {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 8
            Small{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: comment_problem draw_text +: {color: ui_danger}}
            if t.reply.trim() != "" { LinkBtn{height: 20 text: "Try Again" on_click: || retry_comment(cur_tab())} }
        }
    }
    let delete_problem = try { t.comment_delete_problem } catch { nil }
    if !comment_delete_busy(t) && !t.saving && delete_problem != nil {
        let draft = pending_draft(t)
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 8
            Small{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: delete_problem.text + pick(draft, " Finish or discard the current edit before retrying.", "") draw_text +: {color: ui_danger}}
            LinkBtn{height: 20 text: "Dismiss" on_click: || { let x = cur_tab() x.comment_delete_problem = nil render_status() }}
            if !draft && t.comments != nil { LinkBtn{height: 20 text: "Try Again" on_click: || retry_comment_delete(cur_tab())} }
            if !draft && t.comments == nil && t.comments_state != "loading" { LinkBtn{height: 20 text: "Reload Comments" on_click: || load_comments(cur_tab())} }
        }
    }
    let history_problem = try { t.history_problem } catch { nil }
    if !history_busy(t) && !t.saving && history_problem != nil {
        return View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 8
            Small{width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: history_problem.text draw_text +: {color: ui_danger}}
            LinkBtn{height: 20 text: "Dismiss" on_click: || { let x = cur_tab() x.history_problem = nil render_status() }}
            LinkBtn{height: 20 text: "Try Again" on_click: || { let x = cur_tab() let problem = x.history_problem if problem != nil { undo(x, problem.redo) } }}
        }
    }
    let failed = other_save_problem(t)
    if failed != nil { return other_save_status(t, failed) }
    let edit_failed = other_edit_problem(t)
    if edit_failed != nil { return other_edit_status(t, edit_failed) }
    let history_failed = other_history_problem(t)
    if history_failed != nil { return other_history_status(t, history_failed) }
    let delete_failed = other_delete_problem(t)
    if delete_failed != nil { return other_delete_status(t, delete_failed) }
    let comment_failed = other_comment_problem(t)
    if comment_failed != nil { return other_comment_status(t, comment_failed) }
    let dirty = t.edited || field_dirty(t)
    let draft = pending_draft(t)
    let state = pick(t.saving, "Saving…", pick(dirty, "Edited", pick(draft, "Editing", "Saved")))
    // A Mac's title says "— Edited" (mac_modebar), as Preview's does: the status bar says
    // only what is under way.
    if ui_unified { state = pick(t.saving, "Saving…", pick(draft, "Editing", "")) }
    if t.state != "ready" { state = "" }
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 14} spacing: 6
        if state != "" && !ui_unified { RoundedView{width: 8 height: 8 show_bg: true draw_bg +: {color: pick(dirty || draft || t.saving, pt_warn, ui_success) border_radius: 2.0}} }
        Small{text: state}
        if st.space_full { View{width: Fit height: Fit padding: Inset{left: 8} Small{text: "Storage is full: remove a PDF to make room" draw_text +: {color: ui_danger}}} }
        if st.said != "" { View{width: Fill height: Fit align: Align{x: 1.0} Small{text: st.said}} }
    }
}

// Closing a tab with unsaved changes asks first; so does removing a PDF. On a Mac
// each is the alert macOS has drawn since 11 (the shared UiAlert parts): the app's
// icon on top, the words centred under it, then the buttons, each as wide as the
// other: three stand one over another with the default, Save, on top; two sit side
// by side with the default on the right. Another desktop keeps its sheet.
fn dialog_view(){
    if st.going { return goto_view() }
    if st.removing != "" { return remove_view() }
    if st.open_sheet { return open_sheet_view() }
    let t = nil
    if st.confirm != nil { t = tab_named(st.confirm) }
    if t == nil { return View{width: 1 height: 1} }
    let head = "Save the changes to “" + shown_name(t.title) + "”?"
    let words = "Your changes are in PDF Tools' open copy. If you close without saving, they're lost."
    View{width: Fill height: Fill flow: Overlay
        SheetDim{}
        SheetPlace{padding: Inset{top: sheet_top() left: 16 right: 16}
            if ui_unified {
                UiAlertPanel{
                    if ui_alert_icon { UiAlertIcon{app: "os.pdftools" width: 64 height: 64} }
                    UiAlertTitle{text: head}
                    UiAlertNote{text: words}
                    UiAlertStack{
                        Primary{width: Fill reset_hover_on_click: true text: "Save" on_click: || save_and_close(tab_named(st.confirm))}
                        Outline{width: Fill reset_hover_on_click: true text: "Don't Save" on_click: || close_tab(tab_named(st.confirm), true)}
                        Outline{width: Fill reset_hover_on_click: true text: "Cancel" on_click: || cancel_sheet()}
                    }
                }
            } else {
                SheetPanel{width: if ui_alert_icon { 470 } else { 400 }
                    View{width: Fill height: Fit flow: Right spacing: 14
                        if ui_alert_icon { UiAlertIcon{app: "os.pdftools" width: 52 height: 52} }
                        View{width: Fill height: Fit flow: Down spacing: 10
                            SheetTitle{text: head}
                            SheetNote{text: words}
                        }
                    }
                    SheetButtons{
                        Outline{reset_hover_on_click: true text: "Don't Save" on_click: || close_tab(tab_named(st.confirm), true)}
                        Gap{}
                        Outline{reset_hover_on_click: true text: "Cancel" on_click: || cancel_sheet()}
                        Primary{reset_hover_on_click: true text: "Save" on_click: || save_and_close(tab_named(st.confirm))}
                    }
                }
            }
        }
    }
}
fn remove_view(){
    let d = doc_named(st.removing)
    if d == nil { return View{width: 1 height: 1} }
    let head = "Remove “" + shown_name(d.title) + "” from PDF Tools?"
    let words = "The copy in PDF Tools is deleted and its space is freed. The file you opened it from isn't affected."
    View{width: Fill height: Fill flow: Overlay
        SheetDim{}
        SheetPlace{padding: Inset{top: sheet_top() left: 16 right: 16}
            if ui_unified {
                UiAlertPanel{
                    if ui_alert_icon { UiAlertIcon{app: "os.pdftools" width: 64 height: 64} }
                    UiAlertTitle{text: head}
                    UiAlertNote{text: words}
                    UiAlertRow{
                        DangerBtn{width: Fill text: "Remove" on_click: || remove_doc(doc_named(st.removing))}
                        Primary{width: Fill key_default: true key_cancel: true reset_hover_on_click: true text: "Cancel" on_click: || cancel_sheet()}
                    }
                }
            } else {
                SheetPanel{width: if ui_alert_icon { 470 } else { 400 }
                    View{width: Fill height: Fit flow: Right spacing: 14
                        if ui_alert_icon { UiAlertIcon{app: "os.pdftools" width: 52 height: 52} }
                        View{width: Fill height: Fit flow: Down spacing: 10
                            SheetTitle{text: head}
                            SheetNote{text: words}
                        }
                    }
                    SheetButtons{
                        DangerBtn{text: "Remove" on_click: || remove_doc(doc_named(st.removing))}
                        Primary{key_default: true key_cancel: true reset_hover_on_click: true text: "Cancel" on_click: || cancel_sheet()}
                    }
                }
            }
        }
    }
}
fn cancel_sheet(){
    st.confirm = nil
    st.removing = ""
    render_dialog()
    ui.keys.focus()
}

// Go to Page…, as Preview's: a sheet with the page's number, chosen, to type over.
fn goto_open(t){
    if t == nil || t.state != "ready" || pt_modal || t.mode == "pages" || t.mode == "combine" { return }
    if field_guard(t) { return }
    if field_handoff(t, nil, "continue", || goto_open(t)) { return }
    commit_field(t)
    st.going = true
    st.go_text = "" + t.page
    st.go_bad = false
    render_dialog()
    start_timeout(0.05, || { if st.going { ui.goto_field.focus() } })
}
fn goto_close(){
    st.going = false
    st.go_bad = false
    render_dialog()
    ui.keys.focus()
}
fn goto_done(){
    let t = cur_tab()
    if t == nil {
        goto_close()
        return
    }
    let typed = ("" + st.go_text).trim()
    let n = try { typed.to_f64() } catch { nil }
    if typed == "" || n == nil || !(n >= 1 && n <= t.pages) || n != floor(n) {
        st.go_bad = true
        render_dialog()
        start_timeout(0.05, || { if st.going { ui.goto_field.focus() } })
        return
    }
    goto_close()
    go_page(t, n)
}
fn goto_view(){
    let t = cur_tab()
    if t == nil { return View{width: 1 height: 1} }
    View{width: Fill height: Fill flow: Overlay
        SheetDim{}
        SheetPlace{padding: Inset{top: sheet_top() left: 16 right: 16}
            SheetPanel{width: 300 nav_group: true
                SheetTitle{text: "Go to Page"}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                    Body{text: "Page:"}
                    View{width: 64 height: 28
                        goto_field := Field{text: st.go_text on_change: |text| { st.go_text = text }}
                    }
                    Second{text: "of " + t.pages}
                }
                if st.go_bad { SheetNote{text: "Type a page number from 1 to " + t.pages + "." draw_text +: {color: pt_danger}} }
                SheetButtons{
                    Outline{key_cancel: true reset_hover_on_click: true text: "Cancel" on_click: || goto_close()}
                    Primary{key_default: true reset_hover_on_click: true text: "Go" on_click: || goto_done()}
                }
            }
        }
    }
}

// Export as PDF…: a copy of the PDF where the person says (the shell's Save panel). An
// edited PDF is saved first, so the copy has the changes.
fn export_pdf(t){
    if t == nil || t.state != "ready" || t.saving || !st.files_out { return }
    if field_guard(t) { return }
    if draft_guard(t, "exporting") { return }
    if t.edited || field_dirty(t) {
        save(t, || export_pdf(t))
        return
    }
    host.request("files.export", {path: t.path name: shown_name(t.title)}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || exported(t, answer))
    })
}
fn exported(t, a){
    if !a.is_ok {
        note("Couldn't export “" + shown_name(t.title) + "”: " + err_words(a.error))
        return
    }
    if optional(a.data, "cancelled", false) == true { return }
    note("Exported “" + shown_name(t.title) + "”.")
}

// ---- the window -------------------------------------------------------------

SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: ui_page
    View{width: Fill height: Fill flow: Down
        // Read mode hides these regions through plain wrappers (a view
        // whose on_render starts hidden stays hidden).
        modebar_box := View{width: Fill height: Fit flow: Down
            UiToolbar{height: BAR_H padding: 0 spacing: 0
                pagebar := View{width: Fit height: Fill flow: Right on_render: || { pagebar_view() }}
                modebar := View{width: Fill height: Fill flow: Right on_render: || { modebar_view() }}
                search_tools := View{width: Fit height: Fill flow: Right on_render: || { search_tools_view() }}
            }
            UiSep{}
        }
        tabs_box := View{width: Fill height: Fit flow: Down
            tabs := SolidView{width: Fill height: TABS_H flow: Right draw_bg.color: pt_tabs on_render: || { tabs_view() }}
            UiSep{}
        }
        // The keys, for what is under the bars: the toolbar's band stays the window's, to
        // drag it by.
        keys := GestureView{width: Fill height: Fill flow: Down cursor: MouseCursor.Default on_key: |key, cmd, shift| app_key(key, cmd, shift)
        home := SolidView{width: Fill height: Fill flow: Down draw_bg.color: ui_surface
            home_pane := ScrollY{width: Fill height: Fill flow: Down on_render: || { home_view() }}
        }
        doc := View{visible: false width: Fill height: Fill flow: Right
            panel_narrow := UiSidebar{visible: false width: PANEL_W padding: 0 spacing: 0
                panel_head := View{width: Fill height: Fit on_render: || { panel_head_view() }}
                thumbs := ScrollY{width: Fill height: Fill flow: Down on_render: || { thumbs_view() }}
            }
            panel_wide := UiSidebar{visible: false width: LIST_W padding: 0 spacing: 0
                list_head := View{width: Fill height: Fit on_render: || { list_head_view() }}
                // A view whose on_render starts hidden stays hidden: each
                // region shows and hides through a wrapper.
                outline_box := View{visible: false width: Fill height: Fill
                    outline := ScrollY{width: Fill height: Fill flow: Down on_render: || { outline_view() }}
                }
                notes_box := View{visible: false width: Fill height: Fill
                    notes := ScrollY{width: Fill height: Fill flow: Down on_render: || { notes_view() }}
                }
                results_box := View{visible: false width: Fill height: Fill
                    results := ScrollY{width: Fill height: Fill flow: Down on_render: || { results_view() }}
                }
            }
            line_left := UiVSep{visible: false}
            View{width: Fill height: Fill flow: Down
                toolrow_box := View{width: Fill height: Fit
                    toolrow := View{width: Fill height: Fit flow: Down on_render: || { toolrow_view() }}
                }
                View{width: Fill height: Fill flow: Overlay
                    canvas := ScrollXY{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: PAGE_TOP bottom: 14 left: 24 right: 24} on_render: || { canvas_view() }}
                    grid_box := View{visible: false width: Fill height: Fill flow: Overlay
                        GestureView{width: Fill height: Fill on_tap: |x, y| { if pt_modal { return } grid_clear(cur_tab()) }
                            grid := ScrollY{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 14 bottom: 20} on_render: || { grid_view() }}
                        }
                        drag_mark := View{width: Fill height: Fill on_render: || { drag_mark_view() }}
                    }
                    // The list scrolls on the white content; its foot stays.
                    combine_box := SolidView{visible: false width: Fill height: Fill flow: Down draw_bg.color: ui_surface
                        combine_list := ScrollY{width: Fill height: Fill flow: Down on_render: || { tall_list_view() }}
                        combine_tall_foot := SolidView{width: Fill height: Fit flow: Down draw_bg.color: ui_bar on_render: || { tall_foot_view() }}
                    }
                    notice_box := View{visible: false width: Fill height: Fill
                        notice := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.4} padding: 24 on_render: || { notice_view() }}
                    }
                }
                read_bar_box := View{visible: false width: Fill height: Fit flow: Down
                    UiSep{}
                    read_bar := SolidView{width: Fill height: READ_BAR draw_bg.color: ui_bar on_render: || { read_bar_view() }}
                }
            }
            line_right := UiVSep{visible: false}
            // Each inspector is as wide as its content says (right_w).
            right_thread_box := View{visible: false width: Fit height: Fill
                right_thread := UiSidebar{width: Fit padding: 0 spacing: 0 on_render: || { thread_panel() }}
            }
            right_side_box := View{visible: false width: Fit height: Fill
                right_side := UiSidebar{width: Fit padding: 0 spacing: 0 on_render: || { side_panel() }}
            }
        }
        }
        status_box := View{width: Fill height: Fit flow: Down
            UiSep{}
            status := SolidView{width: Fill height: FOOT_H draw_bg.color: ui_bar on_render: || { status_view() }}
        }
    }
    banner := View{visible: false width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0} padding: Inset{left: 16 right: 16 bottom: 36}
        RoundedShadowView{width: Fill max_width: 520 height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 6 top: 5 bottom: 5} spacing: 8 new_batch: true
            draw_bg +: {color: ui_surface border_size: 1.0 border_color: ui_border border_radius: 5.0 shadow_color: pt_shadow shadow_radius: 12.0 shadow_offset: vec2(0.0, 3.0)}
            banner_text := Wrap{}
            UiTool{padding: Inset{left: 10 right: 10} text: "OK" draw_text +: {color: ui_link color_hover: ui_link color_down: ui_link color_focus: ui_link} on_click: || note("")}
        }
    }
    dialog_box := View{visible: false width: Fill height: Fill
        dialog := View{width: Fill height: Fill flow: Overlay on_render: || { dialog_view() }}
    }
}
