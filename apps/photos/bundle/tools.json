{
  "schema": 1,
  "tools": [
    {
      "name": "photos.notify",
      "description": "Tell the person something now: put a notice card from Photos on the glance screen and show a notification. Give a short title (at most 80 characters) and the text (at most 600 characters); Photos draws the card. Use it when the person or the system agent asks Photos to notify them. The same card_id replaces an earlier notice.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "card_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string"
          },
          "replaced": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "integer"
          }
        },
        "required": [
          "card_id"
        ]
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service"
    },
    {
      "name": "photos.info",
      "description": "Inspect an image or document in your workspace: width, height, layers, colour mode and format warnings, as JSON. Reads only. The path is relative to your workspace and cannot leave it; name a file that is there, not a gallery photo.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "width",
          "height"
        ]
      },
      "risk": "read",
      "implemented_by": "host-service"
    }
  ]
}
