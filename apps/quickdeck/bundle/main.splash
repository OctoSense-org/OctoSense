let qd_nav = if ui_light { #xffffff } else { #x151a1d }
let qd_desk = if ui_light { #xf2f4f5 } else { #x1b1e22 }
let qd_insp = if ui_light { #xffffff } else { #x161b1f }
let qd_status = if ui_light { #xffffff } else { #x151b1d }
// 10-dark-notes keeps the canvas pill light.
let qd_pill = if ui_light { #xffffff } else { #xf4f4f5 }
let qd_pill_ink = if ui_light { #x55575b } else { #x3b3e42 }
let qd_pill_icon = if ui_light { #x5b5d61 } else { #x45484c }
let qd_pill_line = if ui_light { #xe2e3e5 } else { #xd2d4d6 }
let qd_pill_tint = #xeaf2fd
let qd_pill_tint_line = #xb9d3f7
let qd_pill_link = #x1c6ce0
let qd_pill_hover = if ui_light { #xf1f2f3 } else { #xe4e5e7 }
let qd_home = if ui_light { #xf2f4f5 } else { #x1b1e22 }
let qd_card = if ui_light { #xffffff } else { #x22272b }
let qd_line = if ui_light { #xe2e3e5 } else { #x33383b }
let qd_line_soft = if ui_light { #xececee } else { #x2a2e31 }
let qd_thumb_line = if ui_light { #xd3d5d9 } else { #x3a3f43 }
let qd_tint = if ui_light { #xeaf2fd } else { #x17304d }
let qd_tint_line = if ui_light { #xb9d3f7 } else { #x2c5a92 }
let qd_select = if ui_light { #x2f6fdf } else { #x3b82f0 }
let qd_field = if ui_light { #xffffff } else { #x161c1f }
let qd_field_line = if ui_light { #xdcdde0 } else { #x383d40 }
let qd_hover = if ui_light { #xf1f2f3 } else { #x22272b }
let qd_ink = if ui_light { #x36393d } else { #xc9cbcd }
let qd_ink2 = if ui_light { #x55585c } else { #xb0b2b4 }
let qd_muted = if ui_light { #x76787c } else { #x868a8d }
let qd_faint = if ui_light { #x9c9da0 } else { #x63676a }
let qd_icon = if ui_light { #x5b5d61 } else { #xa3a6a9 }
let qd_green = if ui_light { #x3fa95a } else { #x20b376 }
let qd_orange = if ui_light { #xf2a20d } else { #xe39a1c }
let qd_red = if ui_light { #xe5534f } else { #xf06a66 }
let qd_red_tint = if ui_light { #xfdf0ef } else { #x3a2426 }
let qd_toggle_on = if ui_light { #x0f68d8 } else { #x1678e7 }
let qd_toggle_off = if ui_light { #xc5c9cc } else { #x3b4043 }
let qd_track = if ui_light { #xd2d2d3 } else { #x34393c }
let qd_shadow = if ui_light { #x00000022 } else { #x00000070 }
let qd_scrim = #x00000059
// Present's stage and its controls (08-present), the same in both.
let qd_stage = #x08090b
let qd_stage_pill = #x14181a
let qd_stage_line = #x34383b
let qd_stage_ink = #xd4d5d6
let qd_stage_muted = #x8a8d90
let qd_notes_strip = #x15191c

// ---- templates ------------------------------------------------------------

let Text = Label{padding: 0 text: "" draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 12}}}
let Wrap = Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12 line_spacing: 1.4}}}
let Code = Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "" draw_text +: {color: qd_muted text_style: theme.font_code{font_size: 10}}}
// A plain View paints no background in the contained host: lines are SolidViews.
let Line = SolidView{width: Fill height: 1 draw_bg.color: qd_line}
let VLine = SolidView{width: 1 height: Fill draw_bg.color: qd_line}
let Gap = View{width: Fill height: 1}
let Ico = Svg{width: 18 height: 18 animating: false draw_svg +: {color: qd_icon}}
// Buttons: flat text and icon buttons, the accent one, the outlined one.
let Flat = ButtonFlat{height: 32 margin: 0 padding: Inset{left: 10 right: 10} spacing: 8
    icon_walk: Walk{width: 18 height: 18}
    draw_bg +: {border_radius: 5.0 border_size: 0.0 color: #x00000000 color_hover: qd_hover color_down: qd_line_soft color_focus: #x00000000}
    draw_text +: {color: qd_ink2 color_hover: qd_ink color_down: qd_ink color_focus: qd_ink2 text_style: theme.font_regular{font_size: 12}}
    draw_icon +: {color: qd_icon}
}
let IconBtn = Flat{width: 32 height: 32 padding: 0 spacing: 0 text: ""}
let Primary = Flat{height: 34 padding: Inset{left: 16 right: 16}
    draw_bg +: {border_radius: 5.0 color: qd_accent color_hover: qd_accent_hover color_down: qd_accent_down color_focus: qd_accent}
    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff color_focus: #xffffff}
    draw_icon +: {color: #xffffff}
}
let Outline = Flat{height: 34 padding: Inset{left: 14 right: 14}
    draw_bg +: {border_radius: 5.0 border_size: 1.0 border_color: qd_field_line color: qd_card color_hover: qd_hover color_down: qd_line_soft color_focus: qd_card}
    draw_text +: {color: qd_ink color_hover: qd_ink color_down: qd_ink color_focus: qd_ink}
    draw_icon +: {color: qd_icon}
}
let LinkBtn = Flat{padding: Inset{left: 6 right: 6} draw_text +: {color: qd_link color_hover: qd_link color_down: qd_link color_focus: qd_link} draw_icon +: {color: qd_link}}
let DangerBtn = Primary{draw_bg +: {color: #xd23a4f color_hover: #xdc4b5f color_down: #xb52d40 color_focus: #xd23a4f}}
let Field = TextInput{width: Fill height: 36 margin: 0 padding: Inset{left: 10 right: 10 top: 8 bottom: 8}
    draw_bg +: {color: qd_field color_hover: qd_field color_focus: qd_field color_empty: qd_field
        border_color: qd_field_line border_color_hover: qd_accent border_color_focus: qd_accent border_color_empty: qd_field_line border_radius: 5.0}
    draw_text +: {color: qd_ink color_hover: qd_ink color_focus: qd_ink color_empty: qd_faint color_empty_hover: qd_faint color_empty_focus: qd_faint text_style: theme.font_regular{font_size: 12}}
    draw_selection.color: #x557dcc55
}
let QdToggle = Toggle{text: ""
    draw_bg +: {size: 20.0 border_size: 0.0 border_radius: 10.0 color: qd_toggle_off color_hover: qd_toggle_off color_active: qd_toggle_on color_focus: qd_toggle_off
        mark_color: #xffffff mark_color_hover: #xffffff mark_color_active: #xffffff mark_color_active_hover: #xffffff}}
let Card = RoundedView{width: Fill height: Fit flow: Down show_bg: true
    draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_line border_radius: 6.0}}

// ---- state ----------------------------------------------------------------
// Everything Quick Deck remembers is one object kept on `mod`. A switch
// between light and dark runs this file again to restyle it: the runtime
// keeps the `mod` entries this file made, but every `let` starts over (#440).
let st = try { mod.quickdeck_state } catch { nil }
// v1 kept another shape here.
if st != nil && optional(st, "v", 0) != 2 { st = nil }
if st == nil {
    st = {
        v: 2
        booted: false
        screen: "home"        // home | deck | outline
        lib: []               // the library, most recently edited first
        index: {}             // deck path -> what library.json keeps
        pictures: {}          // images/ file -> {name bytes}: what the picture strip lists
        show_notes: true      // Present shows the notes strip from the start
        v1_done: false        // v1's decks joined the library
        draft: nil            // New from an outline: its cards and choices
        tabs: []              // the open decks (new_tab) and the outline tab
        cur: -1               // the tab on show; -1 on Home
        engine: ""            // "" until the engine answers; ok | missing | old
        engine_note: ""       // the host's words when it isn't there
        themes: nil           // deck.themes: themes, colour schemes, font pairs
        fonts: nil            // deck.fonts: the families the engine draws
        shapes: nil           // deck.shapes: the preset gallery
        files_known: false    // files.status answered
        files_ok: false       // this device copies a chosen file in
        max_import: 0
        used: -1              // what the app's storage holds (files.status); -1 until it says
        quota: 0
        storage_due: false
        space_full: false     // the last write found no room
        importing: ""         // "" | pptx | picture: a files.import dialog is up
        alert: nil            // {head detail note}: why something failed, on Home
        width: 1536           // the app's size: on_app_resize (card-host sends none)
        height: 1024
        busy: false           // a background engine call is out
        busy_at: 0
        covers: {}            // deck path -> image of its first slide
        cover_tried: {}
        confirm: ""           // the tab whose unsaved changes the bar asks about
        removing: ""          // the deck Home asks about removing
        note_n: 0
        resize_n: 0
        icons: {}             // icon name -> its handle, made once
        heartbeat: nil        // the interval below, made once
        index_dirty: false    // library.json waits for the heartbeat
        present: nil          // the show going on
        next_key: 1
        insp_over: false      // a narrow window shows the inspector over the canvas
    }
    mod.quickdeck_state = st
}
// The heartbeat (below), started again by every run of this file.
if st.heartbeat != nil { stop_timer(st.heartbeat) }
st.heartbeat = start_interval(2, || heartbeat())

// ---- small helpers that need the state -----------------------------------

fn icon(name){
    let h = optional(st.icons, name, nil)
    if h == nil {
        h = http_resource(assets + "/icons/" + name + ".svg")
        st.icons[name] = h
    }
    h
}
// A colour the engine reports ("#1B7FA6") as a colour to draw with; `fallback`
// when it isn't one.
fn hex_color(s, fallback){
    let p = hex_parts(s)
    if p == nil { return fallback }
    vec4(p[0] / 255, p[1] / 255, p[2] / 255, 1.0)
}
fn cur_tab(){
    if st.screen == "home" || st.cur < 0 || st.cur >= st.tabs.len() { return nil }
    st.tabs[st.cur]
}
// The deck tab on show (not the outline page).
fn deck_tab(){
    let t = cur_tab()
    if t == nil || t.kind != "deck" { return nil }
    t
}
fn tab_index(t){
    for i x in st.tabs { if x.key == t.key { return i } }
    -1
}
fn tab_by_key(key){
    for t in st.tabs { if t.key == key { return t } }
    nil
}
fn tab_by_path(path){
    for t in st.tabs { if t.kind == "deck" && t.path == path { return t } }
    nil
}
fn deck_by_path(path){
    for d in st.lib { if d.path == path { return d } }
    nil
}
fn deck_tab_count(){
    let n = 0
    for t in st.tabs { if t.kind == "deck" && t.doc != nil { n = n + 1 } }
    n
}
fn note(text){
    st.note_n = st.note_n + 1
    let n = st.note_n
    ui.banner_text.set_text(text)
    ui.banner.set_visible(text != "")
    if text != "" { start_timeout(8, || { if n == st.note_n { ui.banner.set_visible(false) } }) }
}
fn narrow(){ st.width < WIDE }
fn nav_w(){ pick(narrow(), NAV_W_NARROW, NAV_W) }
fn titles_taken(){
    let out = []
    for d in st.lib { out.push(d.title) }
    out
}
// A deck file name for `title` that no file in decks/ has yet.
fn unique_file(title){
    let base = clean_title(title)
    if base == "" { base = UNTITLED }
    if !fs.exists(DECKS + "/" + base + ".deckcraft") { return base }
    let n = 2
    loop {
        if !fs.exists(DECKS + "/" + base + " " + n + ".deckcraft") { return base + " " + n }
        n = n + 1
    }
}
fn ensure_dir(dir){ if !fs.exists(dir) { try { fs.mkdir(dir) } catch {} } }

// ---- the engine -------------------------------------------------------------

// One call to the deck engine. `done` gets {is_ok data error}, always on a
// later turn: a refusal answers inside host.request itself, where only the
// first widget call of the callback lands.
fn engine(method, args, done){
    host.request("deck." + method, args, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || done(answer))
    })
}
fn missing(error){
    let e = "" + error
    e.search("was not granted") >= 0 || e.search("no service answers") >= 0 || e.search("system apps only") >= 0
}
// The engine is there but older than this contract: the shells refuse the
// v2 methods until the service lands.
fn outdated(error){ ("" + error).search("is not a method") >= 0 }
// True when `a` failed because the engine is not there for this app.
fn engine_gone(a){
    if a.is_ok { st.engine = "ok" return false }
    if missing(a.error) || outdated(a.error) {
        st.engine = pick(outdated(a.error), "old", "missing")
        st.engine_note = "" + a.error
        return true
    }
    false
}
fn storage_full(e){
    let s = "" + e
    err_code(e) == "storage_full" || s.search("bytes left in this storage") >= 0 || s.search("app storage is full") >= 0 || s.search("too many files") >= 0
}
// Every engine write: a refusal for room shows until a write succeeds or a
// deck or an export is removed.
fn wrote(a){
    storage_later()
    if a.is_ok { st.space_full = false return }
    if storage_full(a.error) {
        st.space_full = true
        render_storage()
    }
}
fn engine_headline(){
    if st.engine == "old" { return "This OctoSense's deck engine is older than Quick Deck" }
    "The deck engine isn't available here"
}
fn engine_detail(){
    if st.engine == "old" { return "Editing, Present and Export need the engine's newer methods. Your decks stay safe in Quick Deck's storage." }
    "Slides come from the deck engine, which runs in the OctoSense desktop. Your decks stay safe in Quick Deck's storage."
}
// What went wrong with a call a person made, in words, for the banner.
fn action_failed(what, e){
    if missing(e) || outdated(e) { return engine_headline() + "." }
    if storage_full(e) { return "Quick Deck's storage is full: remove a deck or an export to make room." }
    let code = err_code(e)
    if code == "unknown_doc" { return "The engine closed this deck. Close its tab and open it again." }
    if code == "unknown_id" { return "That's no longer on the slide (an undo may have removed it)." }
    if code == "too_large" { return "Couldn't " + what + ": it's more than the deck engine takes in one go. " + err_words(e) }
    "Couldn't " + what + ": " + err_words(e)
}
// The engine's catalogs: themes for Home and the Theme segment, then fonts
// and shapes when a screen first needs them.
fn ask_themes(){
    engine("themes", {}, fn(a){
        if engine_gone(a) { show() return }
        if a.is_ok { st.themes = a.data }
        show()
        pump()
    })
}
fn ask_fonts(){
    if st.fonts != nil { return }
    st.fonts = []
    engine("fonts", {}, fn(a){
        if a.is_ok { st.fonts = optional(a.data, "families", []) }
        render_inspector()
    })
}
fn ask_shapes(){
    if st.shapes != nil { return }
    st.shapes = []
    engine("shapes", {}, fn(a){
        if a.is_ok { st.shapes = optional(a.data, "presets", []) }
        render_strip()
    })
}
fn theme_list(){
    if st.themes == nil { return [] }
    optional(st.themes, "themes", [])
}
fn theme_named(name){
    for th in theme_list() { if th.name == name || optional(th, "label", "") == name { return th } }
    nil
}
// A theme's twelve colours (dk1, lt1, dk2, lt2, accent 1-6, links) as hex.
fn theme_colors(th){
    if th == nil { return [] }
    let c = optional(th, "colors", [])
    // A service may report the scheme as an object of its slots.
    let list = try { pick(c.len() >= 0, c, []) } catch { [] }
    list
}
fn slot(colors, i, fallback){ pick(i < colors.len(), "" + colors[i], fallback) }
// The colour swatches design 02 shows for a deck: its theme's dark 2, accents
// 1-5 and light 1 (Harbor: navy, blue, teal, yellow, orange, grey, white).
fn swatches_for(t){
    let c = theme_colors(theme_named(t.theme))
    if c.len() < 10 { return ["#000000", "#44546a", "#4472c4", "#ed7d31", "#a5a5a5", "#ffc000", "#ffffff"] }
    [slot(c, 2, "#000000"), slot(c, 4, "#4472c4"), slot(c, 5, "#ed7d31"), slot(c, 6, "#a5a5a5"), slot(c, 7, "#ffc000"), slot(c, 8, "#5b9bd5"), slot(c, 1, "#ffffff")]
}

// ---- the library ------------------------------------------------------------

fn load_index(){
    if !fs.exists(INDEX) { return }
    let v = try { fs.read(INDEX).parse_json() } catch { nil }
    if v == nil || optional(v, "version", 0) != 2 { return }
    st.index = optional(v, "decks", {})
    st.pictures = optional(v, "pictures", {})
    st.show_notes = optional(v, "show_notes", true)
    st.v1_done = optional(v, "v1_done", false)
    let draft = optional(v, "draft", nil)
    if draft != nil && st.draft == nil { st.draft = draft }
}
fn save_index(){
    st.index_dirty = false
    let draft = nil
    if st.draft != nil { draft = {cards: st.draft.cards topic: st.draft.topic count: st.draft.count theme: st.draft.theme size: st.draft.size} }
    try { fs.write(INDEX, {version: 2 decks: st.index pictures: st.pictures show_notes: st.show_notes v1_done: st.v1_done draft: draft}.to_json()) } catch {}
}
fn remember(d){
    st.index[d.path] = index_entry(d)
    // The heartbeat writes it (at most every 2 s), so a tap or a slide turn
    // never waits on the disk: one handler has 64 ms of wall-clock time.
    st.index_dirty = true
}
fn forget(path){
    let kept = {}
    for k v in st.index { if k != path { kept[k] = v } }
    st.index = kept
    let covers = {}
    for k v in st.covers { if k != path { covers[k] = v } }
    st.covers = covers
    let tried = {}
    for k v in st.cover_tried { if k != path { tried[k] = v } }
    st.cover_tried = tried
    save_index()
}
// v1's decks join the library once: each one's latest generation, titled
// with its outline's first slide.
fn adopt_v1(){
    if st.v1_done { return }
    st.v1_done = true
    if !fs.exists(V1_INDEX) { return }
    let v1 = try { fs.read(V1_INDEX).parse_json() } catch { nil }
    if v1 == nil { return }
    for e in v1_entries(v1) {
        if optional(st.index, e.path, nil) == nil && fs.exists(e.path) { st.index[e.path] = e }
    }
    save_index()
}
fn scan_library(){
    let found = []
    let seen = {}
    let add = |path| {
        if optional(seen, path, nil) == nil {
            seen[path] = true
            let d = deck_from(path, optional(st.index, path, nil))
            let old = deck_by_path(path)
            if old != nil {
                d.error = old.error
                d.state = old.state
            }
            found.push(d)
        }
    }
    if fs.exists(DECKS) { for name in fs.list(DECKS) { if is_deck(name) { add(DECKS + "/" + name) } } }
    if fs.exists(IMPORTS) { for name in fs.list(IMPORTS) { if is_pptx(name) { add(IMPORTS + "/" + name) } } }
    // v1's decks, in folders of their own.
    for key e in st.index {
        let path = "" + key
        if is_deck(path) && fs.exists(path) { add(path) }
    }
    st.lib = newest_first(found)
}
fn library_bytes(){
    let total = 0
    for d in st.lib { if d.bytes != nil { total = total + d.bytes } }
    total
}
// Today and yesterday, once per Home render: local_time is not free.
fn days_now(){
    let now_t = time_now()
    {today: local_time(now_t) yesterday: local_time(now_t - 86400)}
}
// Removing a deck asks once more, on its card. One with unsaved changes in a
// tab stays until that tab is closed.
fn ask_remove(d){
    st.removing = d.path
    render_home()
}
fn remove_deck(d){
    st.removing = ""
    let t = tab_by_path(d.path)
    if t != nil && t.edited {
        note("Close “" + d.title + "” first: it has changes that aren't saved.")
        render_home()
        return
    }
    let finish = || {
        try { fs.remove(d.path) } catch {}
        if fs.exists(d.path) {
            note("Couldn't remove “" + d.title + "”.")
            render_home()
            return
        }
        // Its cover, kept in the engine's cache, goes with it.
        if ("" + d.cover).search(".cache/covers/") == 0 { try { fs.remove(d.cover) } catch {} }
        for e in optional(d, "exports", []) { e.kept = true }
        forget(d.path)
        storage_later()
        st.space_full = false
        scan_library()
        render_home()
        render_status()
        note("Removed “" + d.title + "” from Quick Deck. Its exports stay in exports/.")
    }
    if t != nil && t.doc != nil {
        engine("close", {doc: t.doc discard: true}, fn(a){
            drop_tab(t)
            finish()
        })
        return
    }
    if t != nil { drop_tab(t) }
    finish()
}
// Duplicate a deck: the engine opens it and saves a copy under a new name,
// which becomes the copy's own file.
fn duplicate_deck(d){
    if st.engine != "ok" { note(engine_headline() + ".") return }
    let title = unique_title(d.title + " copy", titles_taken())
    let path = DECKS + "/" + unique_file(title) + ".deckcraft"
    ensure_dir(DECKS)
    engine("open", {path: d.path}, fn(a){
        if !a.is_ok {
            note(action_failed("duplicate “" + d.title + "”", a.error))
            return
        }
        let doc = a.data.doc
        engine("save", {doc: doc path: path}, fn(s){
            wrote(s)
            engine("close", {doc: doc discard: true}, fn(c){})
            if !s.is_ok {
                note(action_failed("duplicate “" + d.title + "”", s.error))
                return
            }
            let now = time_now()
            let e = {title: title created: now edited: now}
            let count = slide_count(optional(a.data, "slides", d.slides))
            if count != nil { e.slides = count }
            let bytes = optional(s.data, "bytes", nil)
            if bytes != nil { e.bytes = bytes }
            let theme = optional(a.data, "theme", d.theme)
            if theme != nil { e.theme = theme }
            st.index[path] = e
            save_index()
            scan_library()
            render_home()
            note("Made “" + title + "”.")
        })
    })
}
// deck.open reports `slides` as a count or as the list.
fn slide_count(v){
    if v == nil { return nil }
    let n = try { pick(v >= 0, v, nil) } catch { nil }
    if n != nil { return n }
    try { v.len() } catch { nil }
}
fn doc_meta(d){
    if d.state == "protected" { return "Protected with a password" }
    if d.state == "held" { return "Can't open this file" }
    if d.state == "unsupported" { return "Not a .pptx presentation" }
    if d.state != "" { return "Couldn't open this deck" }
    let m = deck_meta(d.slides, d.bytes)
    if m == "" { return pick(d.import, "PowerPoint presentation", "Deck") }
    m
}

// Each deck's cover (its first slide), one engine call at a time. A kept
// cover answers from its file alone, and the picture named in library.json
// shows meanwhile. A cover at another path is a deck that changed since.
let SHOWN_COVERS = 32
fn cover_next(){
    if st.busy || st.engine != "ok" { return false }
    for i d in st.lib {
        if i < SHOWN_COVERS && d.state == "" && optional(st.cover_tried, d.path, nil) == nil {
            read_cover(d)
            return true
        }
    }
    false
}
fn read_cover(d){
    // Marked as tried when it answers: a callback lost to a script budget
    // abort (a loaded machine) leaves the cover to be asked for again.
    if optional(st.covers, d.path, nil) == nil && d.cover != "" && fs.exists(d.cover) {
        let src = try { binary_resource(fs.read_bytes(d.cover)) } catch { nil }
        if src != nil {
            st.covers[d.path] = src
            render_home()
        }
    }
    busy_on()
    engine("cover", {path: d.path width: COVER_PX}, fn(a){
        st.busy = false
        st.cover_tried[d.path] = true
        if engine_gone(a) {
            render_home()
            return
        }
        wrote(a)
        if !a.is_ok {
            // A damaged, protected or held deck says so on its card; no room
            // or a shell without covers leaves the card without one.
            let code = err_code(a.error)
            if code == "damaged" || code == "protected" || code == "held" || code == "unsupported" {
                d.state = open_state(code)
                d.error = err_words(a.error)
            }
            cover_done()
            return
        }
        let path = optional(a.data, "path", "")
        if path != d.cover || optional(st.covers, d.path, nil) == nil {
            let src = try { binary_resource(fs.read_bytes(path)) } catch { nil }
            if src != nil { st.covers[d.path] = src }
        }
        if path != d.cover {
            d.cover = path
            remember(d)
        }
        cover_done()
    })
}
fn cover_done(){
    render_home()
    later_pump()
}
// A saved deck changed: its kept cover is out of date.
fn stale_cover(d){
    d.cover = ""
    let tried = {}
    for k v in st.cover_tried { if k != d.path { tried[k] = v } }
    st.cover_tried = tried
}

// ---- files from this device ---------------------------------------------------

// What the shell's files service offers, asked once without opening anything.
fn check_files(){
    host.request("files.status", {}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data}
        start_timeout(0.01, || {
            st.files_known = true
            if answer.is_ok {
                st.files_ok = optional(answer.data, "import_supported", false) && optional(answer.data, "storage_granted", false)
                st.max_import = optional(answer.data, "max_import_bytes", 0)
                took_usage(answer.data)
            }
            render_home()
            render_status()
        })
    })
}
fn took_usage(data){
    let u = usage_from(data)
    if u == nil { return }
    st.used = u.used
    st.quota = u.quota
}
// Ask files.status again a moment after a write: one question for a burst.
fn storage_later(){
    if st.storage_due { return }
    st.storage_due = true
    start_timeout(0.8, || {
        host.request("files.status", {}, fn(r){
            let answer = {is_ok: r.is_ok data: r.data}
            start_timeout(0.01, || {
                st.storage_due = false
                if answer.is_ok { took_usage(answer.data) }
                render_status()
            })
        })
    })
}
fn import_limit(){ pick(st.max_import > 0, "Up to " + size_text(st.max_import), "") }
// "Open a presentation from this device": the person chooses a file in the
// host's own dialog; it is copied into imports/ under a name the app chose
// first, titled with the chosen file's name, and opens in a tab. The deck
// engine's import guard decides whether it opens (deck.open's refusals).
fn open_from_device(){
    if st.importing != "" { return }
    if !st.files_ok {
        note("This OctoSense can't open files from this device for Quick Deck.")
        return
    }
    ensure_dir(IMPORTS)
    let name = imports_name(IMPORTED) + ".pptx"
    let path = IMPORTS + "/" + name
    st.importing = "pptx"
    st.alert = nil
    render_home()
    host.request("files.import", {path: path}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || imported(path, answer))
    })
}
fn imports_name(base){
    if !fs.exists(IMPORTS + "/" + base + ".pptx") { return base }
    let n = 2
    loop {
        if !fs.exists(IMPORTS + "/" + base + " " + n + ".pptx") { return base + " " + n }
        n = n + 1
    }
}
fn imported(path, a){
    st.importing = ""
    if !a.is_ok {
        st.alert = {head: "Couldn't open a presentation from this device" detail: import_refusal(a.error, "presentation", import_limit()) note: "" + a.error}
        if storage_full(a.error) { st.space_full = true }
        show()
        return
    }
    if optional(a.data, "cancelled", false) { render_home() return }
    storage_later()
    let title = title_for_import(optional(a.data, "name", nil), file_stem(base_name(path)), titles_taken())
    let now = time_now()
    st.index[path] = {title: title bytes: optional(a.data, "bytes", nil) created: now edited: now}
    save_index()
    scan_library()
    let d = deck_by_path(path)
    if d == nil { render_home() return }
    open_deck(d)
}
// A picture for a slide, from this device, into images/: its own name is
// kept for the picture strip. The engine reads it by its content.
fn picture_from_device(){
    if st.importing != "" { return }
    if !st.files_ok {
        note("This OctoSense can't open files from this device for Quick Deck.")
        return
    }
    ensure_dir(IMAGES)
    let n = 1
    loop {
        if !fs.exists(IMAGES + "/Picture " + n + ".img") { break }
        n = n + 1
    }
    let path = IMAGES + "/Picture " + n + ".img"
    st.importing = "picture"
    render_strip()
    host.request("files.import", {path: path}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || picture_imported(path, answer))
    })
}
fn picture_imported(path, a){
    st.importing = ""
    let t = deck_tab()
    if !a.is_ok {
        if storage_full(a.error) { st.space_full = true render_storage() }
        note(import_refusal(a.error, "picture", import_limit()))
        render_strip()
        return
    }
    if optional(a.data, "cancelled", false) { render_strip() return }
    storage_later()
    st.pictures[base_name(path)] = {name: "" + optional(a.data, "name", base_name(path)) bytes: optional(a.data, "bytes", nil)}
    save_index()
    render_strip()
    if t != nil { insert_picture(t, path) }
}
fn picture_list(){
    let out = []
    if !fs.exists(IMAGES) { return out }
    for name in fs.list(IMAGES) {
        if !regex("/$").test(name) {
            let known = optional(st.pictures, name, nil)
            out.push({path: IMAGES + "/" + name name: pick(known == nil, name, optional(known, "name", name))})
        }
    }
    out
}
fn remove_picture(p){
    try { fs.remove(p.path) } catch {}
    let kept = {}
    for k v in st.pictures { if k != base_name(p.path) { kept[k] = v } }
    st.pictures = kept
    save_index()
    storage_later()
    st.space_full = false
    render_strip()
}

// ---- decks in tabs -------------------------------------------------------------

fn new_tab(d){
    st.next_key = st.next_key + 1
    {key: "t" + st.next_key kind: "deck" path: d.path title: d.title doc: nil state: "opening" error: ""
        size: [960, 540] slides: [] sections: [] layouts: [] theme: "" rev: 0
        edited: false can_undo: false can_redo: false saving: false
        view: "slides" seg: "format" tool: "" cur: nil zoom: 1.0 fit: true
        renders: {} thumbs: {} tiles: {} stale: {} thumb_stale: {} tile_stale: {} failed: {} change_of: {}
        layout_pics: {} layout_paths: [] layouts_asked: false
        detail: nil detail_for: nil detail_due: true
        sel: [] fmt: nil fmt_for: nil fmt_due: false paragraphs: nil pending_edit: nil
        editing: nil drag: nil
        sorter_sel: [] sorter_drag: nil sorter_start: 0 renaming: -1 rename_text: ""
        export: nil
        font_open: false custom_open: false custom_text: ""
        grid: nil grid_for: nil cell: [0, 0] alt_text: ""
        shape_cat: "" table_rows: 3 table_cols: 4 chart_type: "column"
        bg_kind: "theme" transition_ms: 700
        color_scheme: "" font_scheme: "" footer: nil
        import: d.import}
}
fn open_deck(d){
    let t = tab_by_path(d.path)
    if t != nil {
        show_tab(tab_index(t))
        return
    }
    if deck_tab_count() >= MAX_OPEN {
        note("Quick Deck keeps up to " + MAX_OPEN + " decks open. Close one to open another.")
        return
    }
    t = new_tab(d)
    st.tabs.push(t)
    d.opened = time_now()
    remember(d)
    show_tab(st.tabs.len() - 1)
    load_tab(t)
}
fn load_tab(t){
    t.state = "opening"
    engine("open", {path: t.path}, fn(a){
        if tab_index(t) < 0 {
            if a.is_ok { engine("close", {doc: a.data.doc discard: true}, fn(c){}) }
            return
        }
        if engine_gone(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        if !a.is_ok {
            t.state = open_state(err_code(a.error))
            t.error = err_words(a.error)
            let d = deck_by_path(t.path)
            if d != nil && t.state != "full" {
                d.state = t.state
                d.error = t.error
            }
            refresh_doc()
            return
        }
        took_open(t, a.data)
    })
}
// A document the engine opened (deck.open, or deck.create, which answers the
// same): its handle, size, layouts and sections, then its slides.
fn took_open(t, v){
    t.doc = v.doc
    t.size = optional(v, "size", [960, 540])
    t.layouts = optional(v, "layouts", [])
    t.sections = optional(v, "sections", [])
    t.theme = "" + optional(v, "theme", "")
    took_design(t, v)
    t.rev = optional(v, "rev", 0)
    t.edited = optional(v, "edited", false)
    t.can_undo = optional(v, "can_undo", false)
    t.can_redo = optional(v, "can_redo", false)
    // Fonts the deck names that the engine draws with similar ones: the
    // Theme segment says so (OctoSense bundles no theme fonts, SERVICE.md
    // decision 7).
    t.missing_fonts = optional(v, "missing_fonts", [])
    let d = deck_by_path(t.path)
    if d != nil {
        d.state = ""
        d.error = ""
        d.theme = t.theme
        let n = slide_count(optional(v, "slides", nil))
        if n != nil { d.slides = n }
        remember(d)
    }
    refresh_slides(t, || {
        t.state = "ready"
        let at = 0
        if d != nil { at = clamp(optional(d, "slide", 0), 0, max(0, t.slides.len() - 1)) }
        if t.slides.len() > 0 { t.cur = t.slides[at].id }
        t.zoom = fit_now(t)
        t.fit = true
        refresh_doc()
        pump()
    })
}
// The deck's design as the document has it (deck.open, deck.state): its
// theme, colour set, font pair and footer. What the person picked and is on
// its way gives way to it.
fn took_design(t, v){
    let theme = optional(v, "theme", nil)
    if theme != nil { t.theme = "" + theme }
    t.color_scheme = "" + optional(v, "color_scheme", "")
    t.font_scheme = "" + optional(v, "font_scheme", "")
    t.footer = optional(v, "footer", nil)
    t.colors = ""
    t.fonts = ""
    t.footer_pending = {}
    // deck.open's missing_fonts holds for the fonts the deck opened with.
    let key = t.theme + "|" + t.font_scheme
    if optional(t, "fonts_key", nil) == nil { t.fonts_key = key }
    t.fonts_changed = key != t.fonts_key
    if t.fonts_changed { ask_fonts() }
}
// The deck's fonts this device draws with similar ones: what deck.open said,
// until the theme or the font pair changes; then those of the current pair's
// families that deck.fonts doesn't list.
fn missing_now(t){
    if !optional(t, "fonts_changed", false) { return optional(t, "missing_fonts", []) }
    let fams = optional(st, "fonts", [])
    if fams.len() == 0 { return [] }
    let th = theme_named("" + t.theme)
    let major = "" + optional(th, "major", "")
    let minor = "" + optional(th, "minor", "")
    if st.themes != nil {
        for f in optional(st.themes, "font_schemes", []) {
            if ("" + optional(f, "name", "")) == ("" + optional(t, "font_scheme", "")) {
                major = "" + optional(f, "major", major)
                minor = "" + optional(f, "minor", minor)
            }
        }
    }
    let out = []
    for name in [major, minor] { if name != "" && !has(fams, name) && !has(out, name) { out.push(name) } }
    out
}
// After a design change, an undo or a redo: the deck's design again
// (deck.state), so the Theme segment follows without reopening.
fn refresh_state(t){
    if t == nil || t.doc == nil { return }
    engine("state", {doc: t.doc}, fn(a){
        if !a.is_ok { return }
        took_design(t, a.data)
        let d = deck_by_path(t.path)
        if d != nil && d.theme != t.theme {
            d.theme = t.theme
            remember(d)
        }
        if deck_tab() == t && t.editing == nil && t.seg == "theme" { render_inspector() }
    })
}
// The deck's slides, sections and size again (deck.slides).
fn refresh_slides(t, then){
    engine("slides", {doc: t.doc}, fn(a){
        if a.is_ok {
            t.slides = optional(a.data, "slides", [])
            t.sections = optional(a.data, "sections", t.sections)
            t.size = optional(a.data, "size", t.size)
            if t.cur == nil || slide_index(t, t.cur) < 0 {
                if t.slides.len() > 0 { t.cur = t.slides[min(max(0, optional(t, "last_index", 0)), t.slides.len() - 1)].id }
            }
            let d = deck_by_path(t.path)
            if d != nil && d.slides != t.slides.len() {
                d.slides = t.slides.len()
                remember(d)
            }
            t.sorter_sel = keep_ids(t, t.sorter_sel)
        } else if engine_gone(a) {
            t.state = "missing"
        }
        if then != nil { then() } else { refresh_doc() }
    })
}
fn keep_ids(t, ids){
    let out = []
    for id in ids { if slide_index(t, id) >= 0 { out.push(id) } }
    out
}
fn slide_index(t, id){
    for i s in t.slides { if s.id == id { return i } }
    -1
}
fn slide_of(t, id){
    for s in t.slides { if s.id == id { return s } }
    nil
}
fn show_tab(i){
    st.screen = pick(st.tabs[i].kind == "outline", "outline", "deck")
    st.cur = i
    show()
    pump()
}
fn go_home(){
    let t = deck_tab()
    if t != nil && t.editing != nil { end_edit(t) }
    st.screen = "home"
    scan_library()
    storage_later()
    show()
    pump()
}
fn drop_tab(t){
    let i = tab_index(t)
    if i < 0 { return }
    let kept = []
    for x in st.tabs { if x.key != t.key { kept.push(x) } }
    st.tabs = kept
    t.state = "closed"
    if st.screen == "home" { render_tabs() return }
    if st.tabs.len() == 0 { go_home() return }
    if st.cur >= i { st.cur = max(0, st.cur - 1) }
    if st.cur >= st.tabs.len() { st.cur = st.tabs.len() - 1 }
    show_tab(st.cur)
}
// Closing a tab with unsaved changes asks first, in a bar under the tabs.
fn ask_close(t){
    if t.kind == "outline" {
        drop_tab(t)
        return
    }
    if t.editing != nil { end_edit(t) }
    if t.edited {
        st.confirm = t.key
        render_confirm()
        return
    }
    close_tab(t, false)
}
fn close_tab(t, discard){
    st.confirm = ""
    render_confirm()
    if t.doc == nil {
        drop_tab(t)
        return
    }
    engine("close", {doc: t.doc discard: discard}, fn(a){
        if !a.is_ok && err_code(a.error) == "unsaved" {
            st.confirm = t.key
            render_confirm()
            return
        }
        remember_place(t)
        drop_tab(t)
    })
}
fn save_and_close(t){
    st.confirm = ""
    render_confirm()
    save(t, || close_tab(t, false))
}
fn remember_place(t){
    let d = deck_by_path(t.path)
    if d == nil { return }
    let i = slide_index(t, t.cur)
    if i >= 0 { d.slide = i }
    remember(d)
}

// ---- the render pump: one engine call at a time ------------------------------

fn busy_on(){
    st.busy = true
    st.busy_at = time_now()
}
fn later_pump(){ start_timeout(0.02, || pump()) }
fn pump(){
    // A call that never answered (its callback lost to a script budget abort
    // under load) frees the pump after 12 s.
    if st.busy && time_now() - st.busy_at > 12 { st.busy = false }
    if st.busy || st.engine == "missing" || st.engine == "old" { return }
    if st.present != nil {
        if present_next() { return }
        return
    }
    let t = deck_tab()
    if t != nil && t.state == "ready" && t.doc != nil {
        if t.view == "slides" {
            if canvas_next(t) { return }
            if detail_next(t) { return }
            if fmt_next(t) { return }
            if t.seg == "layout" && layouts_next(t) { return }
            if thumb_next(t) { return }
        }
        if t.view == "sorter" && tile_next(t) { return }
    }
    if st.screen == "home" { cover_next() }
}
// Read the PNG the engine wrote: one read per answer.
fn read_png(path){
    if path == nil || path == "" { return nil }
    try { binary_resource(fs.read_bytes(path)) } catch { nil }
}
fn drop_key(m, key){
    let out = {}
    for k v in m { if k != key { out[k] = v } }
    out
}
fn mark_of(t, id){ optional(t.change_of, "s" + id, 0) }

// The canvas: the current slide at the canvas's width, in the editor's view
// (placeholder prompts, dashed outlines), kept by revision. While a text box
// is edited, the engine draws the slide without that box's text.
// pick() takes both of its values, so a field of nil is never read in one.
fn canvas_mode(t){
    if t.editing == nil { return "edit" }
    "editing:" + t.editing.id
}
fn canvas_px(t){ clamp(round(t.size[0] * t.zoom * DENSITY), 48, 3840) }
fn needs_canvas(t){
    if t.cur == nil { return false }
    let k = "s" + t.cur
    let r = optional(t.renders, k, nil)
    let px = canvas_px(t)
    if optional(t.failed, k, nil) == px { return false }
    r == nil || r.px != px || r.mode != canvas_mode(t) || optional(t.stale, k, false)
}
fn canvas_next(t){
    if !needs_canvas(t) { return false }
    let id = t.cur
    let px = canvas_px(t)
    let mode = canvas_mode(t)
    let mark = mark_of(t, id)
    let args = {doc: t.doc slide: id width: px edit: true}
    if t.editing != nil { args.editing = t.editing.id }
    busy_on()
    engine("view", args, fn(a){
        st.busy = false
        if engine_gone(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        wrote(a)
        let k = "s" + id
        if a.is_ok {
            let src = read_png(optional(a.data, "path", ""))
            if src != nil {
                t.renders[k] = {src: src px: px mode: mode rev: optional(a.data, "rev", t.rev)}
                t.failed = drop_key(t.failed, k)
            } else { t.failed[k] = px }
            if mark_of(t, id) == mark { t.stale = drop_key(t.stale, k) }
        } else {
            t.failed[k] = px
        }
        if deck_tab() == t && t.cur == id {
            // The text box being edited shows its field once the engine has
            // drawn the slide without its text; after that the field stays
            // put (drawing the canvas again would end the typing).
            if t.editing != nil && t.editing.waiting && mode != "edit" {
                t.editing.waiting = false
                ui.canvas.render()
            } else if t.editing == nil && t.drag == nil {
                render_canvas()
            }
        }
        later_pump()
    })
    true
}
// The current slide's shapes (deck.slide): the selection's boxes and what the
// inspector shows.
fn detail_next(t){
    if t.cur == nil || (!t.detail_due && t.detail_for == t.cur) { return false }
    let id = t.cur
    t.detail_due = false
    busy_on()
    engine("slide", {doc: t.doc slide: id}, fn(a){
        st.busy = false
        if a.is_ok && t.cur == id {
            t.detail = a.data
            t.detail_for = id
            t.sel = keep_shapes(t, t.sel)
            t.chart_pending = {}
            t.tb_pending = {}
            // The notes field of this slide keeps its typing: it isn't drawn again.
            let typing = t.seg == "notes" && optional(t, "notes_for", nil) == id
            if t.pending_edit != nil {
                let e = t.pending_edit
                t.pending_edit = nil
                start_edit(t, e)
            } else if deck_tab() == t && t.editing == nil && t.drag == nil {
                render_canvas()
                if !typing { render_inspector() }
            }
        }
        later_pump()
    })
    true
}
fn shapes_of(t){
    if t.detail == nil || t.detail_for != t.cur { return [] }
    optional(t.detail, "shapes", [])
}
fn shape_of(t, id){
    for sh in shapes_of(t) { if sh.id == id { return sh } }
    nil
}
fn keep_shapes(t, ids){
    let out = []
    for id in ids { if shape_of(t, id) != nil { out.push(id) } }
    out
}
fn text_kind(sh){
    let k = "" + optional(sh, "kind", "")
    k == "placeholder" || k == "textBox" || k == "shape"
}
fn selected_shape(t){
    if t.sel.len() != 1 { return nil }
    shape_of(t, t.sel[0])
}
// The selected text's character and paragraph format (deck.format_state).
fn fmt_next(t){
    let sh = selected_shape(t)
    if sh == nil || !text_kind(sh) || (!t.fmt_due && t.fmt_for == sh.id) { return false }
    t.fmt_due = false
    let id = sh.id
    let args = {doc: t.doc slide: t.cur id: id}
    if t.paragraphs != nil { args.paragraph = t.paragraphs[0] }
    busy_on()
    engine("format_state", args, fn(a){
        st.busy = false
        if a.is_ok && t.sel.len() == 1 && t.sel[0] == id {
            t.fmt = a.data
            t.fmt_for = id
            if deck_tab() == t && t.drag == nil { render_inspector() }
        }
        later_pump()
    })
    true
}
// The Layout segment's eleven layouts (deck.layouts): one call names their
// pictures, then one picture is read per tick.
fn layouts_next(t){
    if !t.layouts_asked {
        t.layouts_asked = true
        busy_on()
        engine("layouts", {doc: t.doc width: LAYOUT_W * DENSITY}, fn(a){
            st.busy = false
            if a.is_ok {
                t.layouts = optional(a.data, "layouts", t.layouts)
                t.layout_paths = []
                for l in t.layouts { t.layout_paths.push({id: l.id path: optional(l, "path", "")}) }
            }
            render_inspector()
            later_pump()
        })
        return true
    }
    if t.layout_paths.len() > 0 {
        let next = t.layout_paths[0]
        t.layout_paths.remove(0)
        let src = read_png(next.path)
        if src != nil { t.layout_pics["l" + next.id] = src }
        if t.layout_paths.len() == 0 || t.layout_paths.len() % 3 == 0 { render_inspector() }
        later_pump()
        return true
    }
    false
}
// The navigator's thumbnails, nearest the current slide first.
fn thumb_next(t){
    let n = t.slides.len()
    if n == 0 { return false }
    let cur = max(0, slide_index(t, t.cur))
    let first = nav_start(t)
    let last = min(n, first + NAV_WINDOW)
    let order = []
    for i in max(0, last - cur) { order.push(cur + i) }
    for i in max(0, cur - first) { order.push(first + i) }
    for k in order {
        let id = t.slides[k].id
        let key = "s" + id
        if optional(t.failed, "t" + id, nil) == nil && (optional(t.thumbs, key, nil) == nil || optional(t.thumb_stale, key, false)) {
            render_small(t, id, false)
            return true
        }
    }
    false
}
fn tile_next(t){
    let n = t.slides.len()
    let last = min(n, t.sorter_start + SORTER_WINDOW)
    for i in last - t.sorter_start {
        let id = t.slides[t.sorter_start + i].id
        let key = "s" + id
        if optional(t.failed, "g" + id, nil) == nil && (optional(t.tiles, key, nil) == nil || optional(t.tile_stale, key, false)) {
            render_small(t, id, true)
            return true
        }
    }
    false
}
// A thumbnail (navigator) or a tile (sorter): the slide as the show draws it.
fn render_small(t, id, tile){
    let mark = mark_of(t, id)
    busy_on()
    engine("view", {doc: t.doc slide: id width: pick(tile, TILE_W, THUMB_W) * DENSITY}, fn(a){
        st.busy = false
        if engine_gone(a) {
            t.state = "missing"
            refresh_doc()
            return
        }
        wrote(a)
        let key = "s" + id
        let src = nil
        if a.is_ok { src = read_png(optional(a.data, "path", "")) }
        if tile {
            if src != nil { t.tiles[key] = src } else { t.failed["g" + id] = true }
            if mark_of(t, id) == mark { t.tile_stale = drop_key(t.tile_stale, key) }
            if deck_tab() == t && t.view == "sorter" && t.sorter_drag == nil { render_sorter() }
        } else {
            if src != nil { t.thumbs[key] = src } else { t.failed["t" + id] = true }
            if mark_of(t, id) == mark { t.thumb_stale = drop_key(t.thumb_stale, key) }
            if deck_tab() == t { render_thumbs() }
        }
        later_pump()
    })
}

// ---- changes the engine keeps: revisions, undo, redo, save -------------------

// A change method's common answer: {rev, changed, edited, can_undo, can_redo}.
// Only the slides it lists draw again.
fn took_change(t, v){
    t.rev = optional(v, "rev", t.rev)
    t.edited = optional(v, "edited", true)
    t.can_undo = optional(v, "can_undo", true)
    t.can_redo = optional(v, "can_redo", false)
    let changed = optional(v, "changed", nil)
    if changed == nil {
        for s in t.slides { mark_slide(t, s.id) }
    } else {
        for id in changed { mark_slide(t, id) }
    }
    let d = deck_by_path(t.path)
    if d != nil {
        d.edited = time_now()
        remember(d)
    }
    render_status()
    render_bar()
    render_tabs()
    later_pump()
}
fn mark_slide(t, id){
    let k = "s" + id
    t.change_of[k] = optional(t.change_of, k, 0) + 1
    t.stale[k] = true
    t.thumb_stale[k] = true
    t.tile_stale[k] = true
    t.failed = drop_key(drop_key(drop_key(t.failed, k), "t" + id), "g" + id)
    if id == t.cur {
        t.detail_due = true
        t.fmt_due = true
    }
}
fn undo(t, redo){
    if t == nil || t.doc == nil { return }
    if redo && !t.can_redo { return }
    if !redo && !t.can_undo { return }
    if t.editing != nil { end_edit(t) }
    engine(pick(redo, "redo", "undo"), {doc: t.doc}, fn(a){
        if !a.is_ok {
            note(action_failed(pick(redo, "redo", "undo"), a.error))
            return
        }
        took_change(t, a.data)
        t.layouts_asked = false
        t.layout_pics = {}
        // What the inspector shows comes back from the document: the slide's
        // shapes (deck.slide) and the box's format (deck.format_state) through
        // the pump, the deck's design here (deck.state).
        t.chart_pending = {}
        t.tb_pending = {}
        refresh_state(t)
        // An undo can add, remove or move slides and shapes.
        refresh_slides(t, || {
            t.sel = keep_shapes(t, t.sel)
            refresh_view(t)
            pump()
        })
    })
}
fn save(t, then){
    if t == nil || t.doc == nil || t.saving { return }
    if t.editing != nil { end_edit(t) }
    let args = {doc: t.doc}
    // A presentation from this device (or a deck the engine made from an
    // outline before its first save) has no native file yet.
    if t.import { args.path = DECKS + "/" + unique_file(t.title) + ".deckcraft" }
    if t.import { ensure_dir(DECKS) }
    t.saving = true
    render_status()
    engine("save", args, fn(a){
        t.saving = false
        wrote(a)
        if !a.is_ok {
            note(action_failed("save", a.error))
            render_status()
            render_storage()
            return
        }
        t.edited = false
        let old = t.path
        let path = optional(a.data, "path", t.path)
        let d = deck_by_path(old)
        if path != old {
            let e = optional(st.index, old, {title: t.title})
            st.index[path] = e
            forget(old)
            // The import is now a native deck: the .pptx goes.
            if is_pptx(old) { try { fs.remove(old) } catch {} }
            t.path = path
            t.import = false
            scan_library()
            d = deck_by_path(path)
        }
        if d != nil {
            d.bytes = optional(a.data, "bytes", d.bytes)
            d.slides = t.slides.len()
            d.edited = time_now()
            stale_cover(d)
            remember(d)
        }
        save_index()
        render_status()
        render_tabs()
        render_bar()
        if then != nil { then() }
    })
}

// ---- slides ---------------------------------------------------------------------

// Show slide `id`: the canvas draws it, the navigator moves to it, the
// inspector follows.
fn go_slide(t, id){
    if t == nil || id == nil { return }
    if t.editing != nil { end_edit(t) }
    t.cur = id
    t.last_index = slide_index(t, id)
    t.sel = []
    t.fmt = nil
    t.paragraphs = nil
    t.grid = nil
    t.font_open = false
    t.custom_open = false
    t.detail_due = true
    remember_place(t)
    render_canvas()
    render_thumbs()
    render_inspector()
    render_pill()
    render_status()
    pump()
}
fn step_slide(t, delta){
    if t == nil || t.slides.len() == 0 { return }
    let i = clamp(slide_index(t, t.cur) + delta, 0, t.slides.len() - 1)
    go_slide(t, t.slides[i].id)
}
// A change to the slides themselves (new, duplicate, delete, move, hide,
// layout, sections): the engine answers, then the list is read again.
fn slides_op(t, args, what, done){
    if t.editing != nil { end_edit(t) }
    args.doc = t.doc
    engine("slides_op", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed(what, a.error))
            return
        }
        took_change(t, a.data)
        refresh_slides(t, || {
            if done != nil { done(a.data) }
            refresh_doc()
            pump()
        })
    })
}
fn new_slide(t){
    let at = slide_index(t, t.cur) + 1
    slides_op(t, {op: "new" at: at layout: "Title and Content"}, "add a slide", |v| {
        let id = optional(v, "slide", nil)
        if id != nil { go_slide(t, id) }
    })
}
fn chosen_slides(t){
    if t.view == "sorter" {
        let out = []
        for s in t.slides { if has(t.sorter_sel, s.id) && out.len() < MAX_NAMED { out.push(s.id) } }
        return out
    }
    pick(t.cur == nil, [], [t.cur])
}
fn duplicate_slides(t){
    let ids = chosen_slides(t)
    if ids.len() == 0 { note("Choose slides to duplicate.") return }
    slides_op(t, {op: "duplicate" slides: ids}, "duplicate the slides", |v| {
        let made = optional(v, "slides", [])
        if t.view == "sorter" { t.sorter_sel = made } else if made.len() > 0 { go_slide(t, made[0]) }
    })
}
fn delete_slides(t){
    let ids = chosen_slides(t)
    if ids.len() == 0 { note("Choose slides to delete.") return }
    if ids.len() >= t.slides.len() { note("A deck keeps at least one slide.") return }
    slides_op(t, {op: "delete" slides: ids}, "delete the slides", |v| {
        t.sorter_sel = []
        for id in ids {
            t.thumbs = drop_key(t.thumbs, "s" + id)
            t.tiles = drop_key(t.tiles, "s" + id)
            t.renders = drop_key(t.renders, "s" + id)
        }
    })
}
// Hide the chosen slides, or show them again when every one is hidden.
fn hide_slides(t){
    let ids = chosen_slides(t)
    if ids.len() == 0 { note("Choose slides to hide.") return }
    let all_hidden = true
    for id in ids { if !optional(slide_of(t, id), "hidden", false) { all_hidden = false } }
    slides_op(t, {op: "hide" slides: ids hidden: !all_hidden}, pick(all_hidden, "show the slides", "hide the slides"), nil)
}
fn move_slides(t, dir){
    let ids = chosen_slides(t)
    if ids.len() == 0 { note("Choose slides to move.") return }
    let to = move_target(t.slides, ids, dir)
    if to == nil { return }
    slides_op(t, {op: "move" slides: ids to: to}, "move the slides", nil)
}
fn set_layout(t, layout){
    slides_op(t, {op: "layout" slides: [t.cur] layout: layout}, "change the layout", nil)
}
fn reset_slide(t){ slides_op(t, {op: "reset" slides: [t.cur]}, "reset the slide", nil) }
fn skip_slide(t, hidden){ slides_op(t, {op: "hide" slides: [t.cur] hidden: hidden}, "change the slide", nil) }
// Sections: a new one starts at the first chosen slide.
fn add_section(t){
    let ids = chosen_slides(t)
    let at = 0
    if ids.len() > 0 { at = slide_index(t, ids[0]) }
    let name = unique_title("New section", section_names(t))
    slides_op(t, {op: "section_add" at: at name: name}, "add a section", |v| {
        t.sections = optional(v, "sections", t.sections)
    })
}
fn section_names(t){
    let out = []
    for s in t.sections { out.push("" + optional(s, "name", "")) }
    out
}
fn rename_section(t, i, name){
    let n = ("" + name).trim()
    t.renaming = -1
    if n == "" { render_sorter() return }
    if n.len() > 256 {
        note("A section name holds up to 256 characters.")
        render_sorter()
        return
    }
    slides_op(t, {op: "section_rename" section: i name: n}, "rename the section", |v| { t.sections = optional(v, "sections", t.sections) })
}
fn remove_section(t, i){
    slides_op(t, {op: "section_remove" section: i}, "remove the section", |v| { t.sections = optional(v, "sections", t.sections) })
}
// The section that starts at slide position `i`, or nil.
fn section_at(t, i){
    for k s in t.sections { if optional(s, "first", -1) == i { return {index: k name: "" + optional(s, "name", "") count: optional(s, "count", 0)} } }
    nil
}

// ---- the canvas: selection, dragging, text in place -----------------------------

// A tap on the slide at (x, y) points: the engine's own hit test chooses what
// it lands on. A long press adds to the selection, or takes away.
fn canvas_tap(x, y, more){
    let t = deck_tab()
    if t == nil || t.state != "ready" || t.cur == nil { return }
    if t.editing != nil { end_edit(t) }
    let slide = t.cur
    engine("hit", hit_args(t, x, y), fn(a){
        if !a.is_ok || t.cur != slide {
            if !a.is_ok { note(action_failed("choose that", a.error)) }
            return
        }
        let hit = optional(a.data, "hit", nil)
        let id = nil
        if hit != nil {
            let kind = "" + optional(hit, "kind", "")
            if kind == "shape" || kind == "text" { id = optional(hit, "id", nil) }
            // A handle of the selection: it stays chosen.
            if kind == "resize" || kind == "rotate" || kind == "adjust" || kind == "line_end" { return }
        }
        if more {
            if id == nil { return }
            if has(t.sel, id) { t.sel = without(t.sel, id) } else { t.sel.push(id) }
        } else {
            t.sel = pick(id == nil, [], [id])
        }
        selection_changed(t)
    })
}
// deck.hit's arguments: the chosen shapes go along so their handles hit
// (the service takes no empty list).
fn hit_args(t, x, y){
    let args = {doc: t.doc slide: t.cur at: [x, y]}
    if t.sel.len() > 0 { args.selected = t.sel }
    args
}
// A double tap on a text box edits its text.
fn canvas_double_tap(x, y){
    let t = deck_tab()
    if t == nil || t.state != "ready" || t.cur == nil { return }
    if t.editing != nil { return }
    engine("hit", hit_args(t, x, y), fn(a){
        if !a.is_ok { return }
        let hit = optional(a.data, "hit", nil)
        if hit == nil { return }
        let id = optional(hit, "id", nil)
        let sh = shape_of(t, id)
        if sh != nil && text_kind(sh) { start_edit(t, id) }
    })
}
fn selection_changed(t){
    t.fmt = nil
    t.fmt_due = true
    t.chart_pending = {}
    t.tb_pending = {}
    t.paragraphs = nil
    t.grid = nil
    t.font_open = false
    t.custom_open = false
    t.cell = [0, 0]
    let sh = selected_shape(t)
    t.alt_text = pick(sh == nil, "", "" + optional(sh, "alt_text", ""))
    if t.sel.len() > 0 && t.seg != "format" { t.seg = "format" }
    if narrow() && t.sel.len() > 0 { st.insp_over = true }
    render_canvas()
    render_insp_tabs()
    render_inspector()
    show_regions()
    pump()
}
// The selected shape's frame: a tap on it edits its text; a drag moves it.
fn frame_tap(id){
    let t = deck_tab()
    if t == nil { return }
    let sh = shape_of(t, id)
    if sh != nil && text_kind(sh) { start_edit(t, id) }
}
// Dragging: the frame moves the selection, a handle resizes it, the round
// handle above rotates it. The outline follows the pointer in its own layer
// (drawing the canvas again would end the drag), and the change is made
// once, when the drag ends.
fn frame_pan(kind, handle, dx, dy, phase){
    let t = deck_tab()
    if t == nil || t.sel.len() == 0 { return }
    let z = t.zoom
    if phase == 0 {
        t.drag = {kind: kind handle: handle dx: 0 dy: 0}
        return
    }
    if t.drag == nil { return }
    t.drag.dx = dx / z
    t.drag.dy = dy / z
    if phase == 1 {
        render_drag()
        return
    }
    let d = t.drag
    t.drag = nil
    render_drag()
    if abs(d.dx) < 0.5 && abs(d.dy) < 0.5 { return }
    let sh = selected_shape(t)
    if d.kind == "move" {
        shape_op(t, {op: "move" dx: round(d.dx * 10) / 10 dy: round(d.dy * 10) / 10}, "move it")
        return
    }
    if sh == nil { return }
    if d.kind == "resize" {
        let b = resized(sh.box, d.handle, d.dx, d.dy)
        shape_op(t, {op: "bounds" x: b[0] y: b[1] w: b[2] h: b[3]}, "resize it")
        return
    }
    shape_op(t, {op: "rotate" deg: rotation_to(sh.box, ROTATE_LIFT, d.dx, d.dy)}, "rotate it")
}
let ROTATE_LIFT = 24
// Text in place: the engine draws the slide without the box's text, and a
// text field over the box holds it while the person types. What they type
// goes to the engine (deck.set_text) when they pause and when they leave.
fn start_edit(t, id){
    let sh = shape_of(t, id)
    if sh == nil || !text_kind(sh) { return }
    if t.editing != nil && t.editing.id == id { return }
    if t.editing != nil { end_edit(t) }
    let text = ("" + optional(sh, "text", "")).replace(regex("\x0b", "g"), "\n")
    t.sel = [id]
    let size = 18
    if t.fmt != nil && t.fmt_for == id { size = optional(t.fmt, "size", 18) }
    t.editing = {id: id slide: t.cur text: text draft: text sent: text box: sh.box size: size seq: 0 waiting: true}
    t.seg = "format"
    render_insp_tabs()
    render_inspector()
    pump()
}
fn edit_typed(text){
    let t = deck_tab()
    if t == nil || t.editing == nil { return }
    let e = t.editing
    e.draft = text
    e.seq = e.seq + 1
    let seq = e.seq
    start_timeout(0.9, || { if t.editing == e && e.seq == seq { commit_edit(t, e, nil) } })
}
let MAX_TEXT = 100000
let MAX_CELL = 10000
let MAX_BREAKS = 1000
// What keeps a text from going in (SERVICE.md caps), or "".
fn text_problem(text, most, what){
    if text.len() > most { return what + " holds up to " + pick(most == MAX_TEXT, "100,000", "10,000") + " characters: shorten it and it goes in." }
    if text.split("\n").len() - 1 > MAX_BREAKS { return what + " holds up to 1,000 lines: shorten it and it goes in." }
    ""
}
fn commit_edit(t, e, then){
    if e.draft == e.sent {
        if then != nil { then() }
        return
    }
    let problem = text_problem(e.draft, MAX_TEXT, "A text box")
    if problem != "" {
        note(problem)
        return
    }
    let text = e.draft
    e.sent = text
    engine("set_text", {doc: t.doc slide: e.slide id: e.id text: text}, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("change the text", a.error))
            e.sent = e.text
            return
        }
        e.text = text
        took_change(t, a.data)
        if then != nil { then() }
    })
}
// Leave the text field: what was typed goes in, and the slide draws whole.
fn end_edit(t){
    let e = t.editing
    if e == nil { return }
    t.editing = nil
    commit_edit(t, e, nil)
    mark_slide(t, e.slide)
    render_canvas()
    render_inspector()
    later_pump()
}

// ---- objects: format, insert, arrange ----------------------------------------------

// Character, paragraph and box format for the selection (the whole box, or
// the paragraphs chosen in the inspector).
fn apply_format(t, args, what){
    if t == nil || t.sel.len() == 0 { return }
    if t.editing != nil { end_edit(t) }
    args.doc = t.doc
    args.slide = t.cur
    args.ids = t.sel
    if t.paragraphs != nil { args.paragraphs = t.paragraphs }
    // What it will be, at once; the engine's own answer follows.
    if t.fmt != nil { t.fmt = fmt_with(t.fmt, args) }
    render_inspector()
    engine("format", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed(what, a.error))
            t.fmt_due = true
            later_pump()
            return
        }
        took_change(t, a.data)
        t.fmt_due = true
    })
}
// The format state with a change applied (the inspector shows it at once).
fn fmt_with(f, args){
    let out = {}
    for k v in f { out[k] = v }
    for k v in args { if k != "doc" && k != "slide" && k != "ids" && k != "paragraphs" { out[k] = v } }
    out
}
fn fmt_value(t, key, fallback){
    if t.fmt == nil { return fallback }
    optional(t.fmt, key, fallback)
}
// PowerPoint's size steps, for the − and + beside the size.
let SIZES = [8, 9, 10, 11, 12, 14, 16, 18, 20, 24, 28, 32, 36, 40, 44, 48, 54, 60, 66, 72, 80, 88, 96]
fn size_step(size, dir){
    let next = size
    if dir > 0 {
        let found = false
        for v in SIZES { if !found && v > size + 0.01 { next = v found = true } }
        if !found { next = size + 8 }
    } else {
        for v in SIZES { if v < size - 0.01 { next = v } }
        if next == size { next = max(1, size - 1) }
    }
    next
}
fn set_size_text(t, text){
    let v = ("" + text).replace(regex("[^0-9.]", "g"), "").to_f64()
    if !(v >= 1) || v > 400 { note("Type a size from 1 to 400 points.") return }
    apply_format(t, {size: v}, "change the size")
}
fn insert_kind(t, args, what){
    if t == nil || t.cur == nil { return }
    if t.editing != nil { end_edit(t) }
    args.doc = t.doc
    args.slide = t.cur
    engine("insert", args, fn(a){
        wrote(a)
        if !a.is_ok {
            // A service that wants a chart's data gets the engine's own sample
            // (deckcraft model/src/chart.rs Chart::sample).
            if args.kind == "chart" && err_code(a.error) == "invalid" && optional(args, "categories", nil) == nil {
                args.categories = ["Q1", "Q2", "Q3", "Q4"]
                args.series = sample_series(args.type)
                insert_kind(t, args, what)
                return
            }
            if args.kind == "picture" { note(picture_refusal(what, a.error)) } else { note(action_failed(what, a.error)) }
            return
        }
        took_change(t, a.data)
        t.tool = ""
        let id = optional(a.data, "id", nil)
        t.sel = pick(id == nil, [], [id])
        t.detail_due = true
        if args.kind == "text" && id != nil { t.pending_edit = id }
        show_regions()
        render_strip()
        render_bar()
        selection_changed(t)
    })
}
// A picture the service refused, in words (SERVICE.md "As built in #503": at
// most 50 megapixels; PNG, JPEG, GIF, BMP, WebP or TIFF, no SVG).
fn picture_refusal(what, e){
    let code = err_code(e)
    if code == "too_large" { return "Couldn't " + what + ": it's too big for a slide. Quick Deck takes pictures up to 50 megapixels." }
    if code == "invalid" && err_words(e).search("not a picture") >= 0 { return "Couldn't " + what + ": Quick Deck takes PNG, JPEG, GIF, BMP, WebP and TIFF pictures (an SVG drawing can't go on a slide yet)." }
    action_failed(what, e)
}
fn sample_series(kind){
    let rows = [[4.2, 2.6, 2.1], [2.8, 4.1, 2.4], [3.6, 1.9, 3.3], [4.7, 3.0, 5.1]]
    let n = pick(kind == "pie" || kind == "doughnut", 1, 3)
    let out = []
    for s in n {
        let values = []
        for r in rows { values.push(r[s]) }
        out.push({name: "Series " + (s + 1) values: values})
    }
    out
}
fn insert_text(t){ insert_kind(t, {kind: "text"}, "add a text box") }
fn insert_picture(t, path){ insert_kind(t, {kind: "picture" path: path}, "add the picture") }
fn insert_shape(t, preset){ insert_kind(t, {kind: "shape" preset: preset}, "add the shape") }
fn insert_table(t){ insert_kind(t, {kind: "table" rows: t.table_rows cols: t.table_cols}, "add the table") }
fn insert_chart(t){ insert_kind(t, {kind: "chart" type: t.chart_type categories: ["Q1", "Q2", "Q3", "Q4"] series: sample_series(t.chart_type)}, "add the chart") }
// Move, size, rotate, order, align, group, duplicate, delete, fill, outline,
// effects and quick styles of the selection.
fn shape_op(t, args, what){
    if t == nil || t.sel.len() == 0 { return }
    if t.editing != nil { end_edit(t) }
    args.doc = t.doc
    args.slide = t.cur
    args.ids = t.sel
    engine("shape", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed(what, a.error))
            render_canvas()
            return
        }
        took_change(t, a.data)
        let ids = optional(a.data, "ids", nil)
        if args.op == "delete" { t.sel = [] }
        if (args.op == "duplicate" || args.op == "group" || args.op == "ungroup") && ids != nil { t.sel = ids }
        t.detail_due = true
        selection_changed(t)
    })
}
fn set_bounds_text(t, key, text){
    let sh = selected_shape(t)
    if sh == nil { return }
    let v = ("" + text).replace(regex("[^0-9.\\-]", "g"), "").to_f64()
    if !(v == v) { note("Type a number of points.") return }
    let b = [sh.box[0], sh.box[1], sh.box[2], sh.box[3]]
    let at = position(["x", "y", "w", "h"], key)
    b[at] = v
    if b[2] < 1 || b[3] < 1 { note("A width and a height are at least 1 point.") return }
    shape_op(t, {op: "bounds" x: b[0] y: b[1] w: b[2] h: b[3]}, "move it")
}
fn picture_op(t, args, what){
    let sh = selected_shape(t)
    if sh == nil { return }
    args.doc = t.doc
    args.slide = t.cur
    args.id = sh.id
    engine("picture", args, fn(a){
        wrote(a)
        if !a.is_ok {
            if args.op == "replace" { note(picture_refusal(what, a.error)) } else { note(action_failed(what, a.error)) }
            return
        }
        took_change(t, a.data)
        t.detail_due = true
        later_pump()
    })
}
fn table_op(t, args, what){
    let sh = selected_shape(t)
    if sh == nil { return }
    args.doc = t.doc
    args.slide = t.cur
    args.id = sh.id
    engine("table", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed(what, a.error))
            return
        }
        took_change(t, a.data)
        let rows = optional(a.data, "rows", nil)
        let cols = optional(a.data, "cols", nil)
        if rows != nil && cols != nil { t.cell = [min(t.cell[0], rows - 1), min(t.cell[1], cols - 1)] }
        t.detail_due = true
        render_inspector()
        later_pump()
    })
}
// A table cell's text: the inspector's grid edits it in place.
fn cell_typed(t, r, c, text){
    let sh = selected_shape(t)
    if sh == nil { return }
    let id = sh.id
    let slide = t.cur
    t.cell = [r, c]
    let problem = text_problem(text, MAX_CELL, "A table cell")
    if problem != "" {
        note(problem)
        return
    }
    engine("set_text", {doc: t.doc slide: slide id: id text: text cell: [r, c]}, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("change the cell", a.error))
            return
        }
        took_change(t, a.data)
    })
}
fn chart_op(t, args, what){
    let sh = selected_shape(t)
    if sh == nil { return }
    args.doc = t.doc
    args.slide = t.cur
    args.id = sh.id
    engine("chart", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed(what, a.error))
            return
        }
        took_change(t, a.data)
        t.detail_due = true
        later_pump()
    })
}
// The chart's data grid: the inspector keeps the person's edits, and sends
// them when they pause, press Return, or add a row or a series.
fn chart_grid(t){
    let sh = selected_shape(t)
    if sh == nil { return nil }
    if t.grid == nil || t.grid_for != sh.id {
        t.grid = grid_of(optional(sh, "chart", {}))
        t.grid_for = sh.id
    }
    t.grid
}
fn grid_typed(t, r, c, text){
    let g = chart_grid(t)
    if g == nil { return }
    if c < 0 {
        g.categories[r] = text
    } else if r < 0 {
        g.series[c].name = text
    } else {
        g.series[c].values[r] = text
    }
    t.grid_seq = optional(t, "grid_seq", 0) + 1
    let seq = t.grid_seq
    start_timeout(1.0, || { if optional(t, "grid_seq", 0) == seq { send_grid(t) } })
}
fn send_grid(t){
    let g = chart_grid(t)
    if g == nil { return }
    let args = chart_args(g)
    chart_op(t, {categories: args.categories series: args.series}, "change the chart's data")
}
fn grid_add_row(t){
    let g = chart_grid(t)
    if g == nil { return }
    g.categories.push("")
    for s in g.series { s.values.push("") }
    send_grid(t)
    render_inspector()
}
fn grid_add_series(t){
    let g = chart_grid(t)
    if g == nil { return }
    let values = []
    for c in g.categories { values.push("") }
    g.series.push({name: "Series " + (g.series.len() + 1) values: values})
    send_grid(t)
    render_inspector()
}

// ---- notes, transitions, the deck's design -------------------------------------

// Speaker notes: sent when the person pauses; the field stays as it is.
fn notes_typed(t, text){
    let id = t.cur
    let s = slide_of(t, id)
    if s == nil { return }
    let clipped = text
    if clipped.len() > MAX_NOTES { note("Notes hold up to 20,000 characters.") return }
    s.notes = clipped
    if t.detail != nil && t.detail_for == id { t.detail.notes = clipped }
    try { ui.notes_meta.set_text(notes_meta(clipped)) } catch {}
    t.notes_seq = optional(t, "notes_seq", 0) + 1
    let seq = t.notes_seq
    start_timeout(0.9, || {
        if optional(t, "notes_seq", 0) != seq { return }
        engine("notes", {doc: t.doc slide: id text: clipped}, fn(a){
            wrote(a)
            if !a.is_ok {
                note(action_failed("keep the notes", a.error))
                return
            }
            took_change(t, a.data)
        })
    })
}
// The current slide's transition length in milliseconds: the slide's own
// (deck.slide's transition.duration) once read, else the last one set here.
fn transition_ms_of(t){
    if t.detail != nil && t.detail_for == t.cur {
        let tr = optional(t.detail, "transition", nil)
        if tr != nil {
            let d = optional(tr, "duration", nil)
            if d != nil && d > 0 { return d }
        }
    }
    t.transition_ms
}
fn set_transition(t, kind, all){
    let ms = transition_ms_of(t)
    if !all && !optional(t, "duration_step", false) {
        for tr in TRANSITIONS { if tr.id == kind { ms = tr.ms } }
    }
    t.duration_step = false
    if kind == "none" { ms = 0 }
    t.transition_ms = max(ms, pick(kind == "none", 0, 100))
    let args = {doc: t.doc kind: kind duration: t.transition_ms}
    if all { args.all = true } else { args.slides = [t.cur] }
    engine("transition", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("set the transition", a.error))
            return
        }
        took_change(t, a.data)
        refresh_slides(t, || {
            render_inspector()
            if all { note("Every slide now has the " + transition_label(kind) + " transition.") }
        })
    })
}
fn step_duration(t, dir){
    let s = slide_of(t, t.cur)
    let kind = pick(s == nil, "none", "" + optional(s, "transition", "none"))
    if kind == "none" || kind == "" { return }
    t.transition_ms = clamp(transition_ms_of(t) + dir * 100, 100, 10000)
    t.duration_step = true
    set_transition(t, kind, false)
}
fn design(t, args, what){
    if t == nil || t.doc == nil { return }
    if t.editing != nil { end_edit(t) }
    args.doc = t.doc
    engine("design", args, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed(what, a.error))
            return
        }
        let size = optional(a.data, "size", nil)
        if size != nil && size != t.size {
            t.size = size
            if t.fit { t.zoom = fit_now(t) }
        }
        if optional(args, "theme", nil) != nil {
            t.theme = args.theme
            // A theme brings its own colours and fonts.
            t.colors = ""
            t.fonts = ""
            let d = deck_by_path(t.path)
            if d != nil {
                d.theme = args.theme
                remember(d)
            }
        }
        // A deck-wide change: every slide and the layout pictures draw again.
        t.layouts_asked = false
        t.layout_pics = {}
        took_change(t, a.data)
        refresh_view(t)
        refresh_state(t)
    })
}
fn set_background(t, kind){
    t.bg_kind = kind
    let c = swatches_for(t)
    if kind == "theme" { design(t, {background: {reset: true slides: [t.cur]}}, "reset the background") return }
    if kind == "colour" { design(t, {background: {color: c[3] slides: [t.cur]}}, "change the background") return }
    design(t, {background: {gradient: {stops: [[0, c[6]], [1, c[1]]] angle: 90} slides: [t.cur]}}, "change the background")
}
fn background_colour(t, hex){ design(t, {background: {color: hex slides: [t.cur]}}, "change the background") }
fn background_all(t){
    let c = swatches_for(t)
    if t.bg_kind == "theme" { design(t, {background: {reset: true all: true}}, "reset the backgrounds") return }
    if t.bg_kind == "colour" { design(t, {background: {color: c[3] all: true}}, "change the backgrounds") return }
    design(t, {background: {gradient: {stops: [[0, c[6]], [1, c[1]]] angle: 90} all: true}}, "change the backgrounds")
}
// A footer setting: shown at once, the deck's own after deck.state answers.
// Footer text shows the footer; an empty one hides it.
fn footer(t, key, value){
    let p = optional(t, "footer_pending", {})
    let f = {}
    if key == "slide_numbers" {
        p.slide_numbers = value
        f.slide_numbers = value
    }
    if key == "date" {
        p.date = value
        f.date = value
    }
    if key == "footer_text" {
        let text = ("" + value).trim()
        p.footer_text = text
        p.footer = text != ""
        f.footer_text = text
        f.footer = text != ""
    }
    t.footer_pending = p
    render_inspector()
    design(t, {footer: f}, "change the footer")
}

// ---- the sorter -------------------------------------------------------------------

fn set_view(t, v){
    if t == nil || t.state != "ready" || t.view == v { return }
    if t.editing != nil { end_edit(t) }
    t.view = v
    t.tool = ""
    if v == "sorter" {
        t.sorter_sel = pick(t.cur == nil, [], [t.cur])
        t.sorter_start = window_start(t.slides.len(), slide_index(t, t.cur), SORTER_WINDOW)
    }
    if v == "export" && t.export == nil {
        t.export = {kind: "pdf" layout: "slides" per_page: 3 which: "all" range: "" hidden: false name: t.title busy: false error: ""}
    }
    show()
    pump()
}
fn toggle_tile(t, id){
    if has(t.sorter_sel, id) { t.sorter_sel = without(t.sorter_sel, id) } else { t.sorter_sel.push(id) }
    t.cur = id
    render_sorter()
    render_sorter_strip()
    render_status()
}
// Dragging a tile: the strip says where it would go (the grid itself can't
// draw while a tile is held: drawing it again ends the drag), and the move
// is made when it's let go.
fn sorter_cols(){ max(1, floor((st.width - 48 + 22) / (TILE_W + 22))) }
fn tile_target(t, i, dx, dy){
    let cols = sorter_cols()
    let row = floor((i - t.sorter_start) / cols)
    let col = (i - t.sorter_start) % cols
    let c = clamp(round(col + dx / (TILE_W + 22)), 0, cols - 1)
    let r = max(0, row + round(dy / 236))
    clamp(t.sorter_start + r * cols + c, 0, t.slides.len() - 1)
}
fn tile_pan(t, id, dx, dy, phase){
    let i = slide_index(t, id)
    if phase == 0 {
        t.sorter_drag = {id: id to: i}
        render_sorter_strip()
        return
    }
    if t.sorter_drag == nil { return }
    let to = tile_target(t, i, dx, dy)
    if phase == 1 {
        if to != t.sorter_drag.to {
            t.sorter_drag.to = to
            render_sorter_strip()
        }
        return
    }
    t.sorter_drag = nil
    render_sorter_strip()
    if to == i { return }
    let ids = pick(has(t.sorter_sel, id), chosen_slides(t), [id])
    slides_op(t, {op: "move" slides: ids to: to}, "move the slides", nil)
}

// ---- Present --------------------------------------------------------------------

// The show: the slides in the engine's show order (hidden ones left out),
// each build step at its end state, on a dark stage that hides the app's
// chrome. Nothing animates: a Splash host can't play transitions (BRIEF).
fn start_present(t){
    if t == nil || t.state != "ready" || t.doc == nil { return }
    if t.editing != nil { end_edit(t) }
    engine("show", {doc: t.doc from: t.cur}, fn(a){
        if !a.is_ok {
            note(action_failed("present", a.error))
            return
        }
        let order = optional(a.data, "order", [])
        if order.len() == 0 {
            note("Every slide from here on is hidden, so there's nothing to show. Show a slide in the sorter first.")
            return
        }
        st.present = {key: t.key order: order i: 0 step: 0 notes: st.show_notes started: time_now() pics: {} failed: {} full: {} timer: nil done: false}
        st.present.timer = start_interval(1, || present_tick())
        // The stage shows the slide alone: an earlier note goes.
        note("")
        show()
        pump()
    })
}
fn present_tab(){
    if st.present == nil { return nil }
    tab_by_key(st.present.key)
}
fn present_item(){
    let p = st.present
    if p == nil || p.i >= p.order.len() { return nil }
    p.order[p.i]
}
fn stage_px(){ clamp(round(min(st.width - 96, (st.height - 150) * 16 / 9) * DENSITY), 48, 3840) }
fn present_key(item, step){ "s" + item.slide + "@" + step }
fn present_next(){
    let p = st.present
    let t = present_tab()
    if p == nil || t == nil || p.done { return false }
    let item = present_item()
    if item == nil { return false }
    // The step on show, then the next one ahead of the tap.
    let want = [{item: item step: p.step}]
    if p.step < optional(item, "steps", 0) { want.push({item: item step: p.step + 1}) }
    if p.step >= optional(item, "steps", 0) && p.i + 1 < p.order.len() { want.push({item: p.order[p.i + 1] step: 0}) }
    for w in want {
        let k = present_key(w.item, w.step)
        if optional(p.pics, k, nil) == nil && optional(p.failed, k, nil) == nil {
            present_render(t, w.item, w.step)
            return true
        }
    }
    // The notes strip: a preview that was cut gets the slide's whole notes.
    let nk = "s" + item.slide
    if p.notes && optional(p.full, nk, nil) == nil {
        let s = slide_of(t, item.slide)
        let preview = pick(s == nil, "", "" + optional(s, "notes", ""))
        if preview.len() > 200 {
            busy_on()
            engine("slide", {doc: t.doc slide: item.slide}, fn(a){
                st.busy = false
                if st.present != p { return }
                p.full[nk] = preview
                if a.is_ok { p.full[nk] = "" + optional(a.data, "notes", preview) }
                render_present()
                later_pump()
            })
            return true
        }
    }
    false
}
fn present_notes(t, item){
    let full = optional(st.present.full, "s" + item.slide, nil)
    if full != nil { return full }
    let s = slide_of(t, item.slide)
    pick(s == nil, "", "" + optional(s, "notes", ""))
}
fn present_render(t, item, step){
    let p = st.present
    let k = present_key(item, step)
    busy_on()
    engine("view", {doc: t.doc slide: item.slide width: stage_px() step: step}, fn(a){
        st.busy = false
        if st.present != p { return }
        let src = nil
        if a.is_ok { src = read_png(optional(a.data, "path", "")) }
        if src != nil { p.pics[k] = src } else { p.failed[k] = true }
        let now = present_item()
        if now != nil && present_key(now, p.step) == k { render_present() }
        later_pump()
    })
}
fn present_step(dir){
    let p = st.present
    if p == nil { return }
    if p.done {
        if dir > 0 { stop_present() return }
        p.done = false
        render_present()
        render_present_bar()
        return
    }
    let item = present_item()
    if item == nil { return }
    if dir > 0 {
        if p.step < optional(item, "steps", 0) { p.step = p.step + 1 }
        else if p.i + 1 < p.order.len() {
            p.i = p.i + 1
            p.step = 0
        } else { p.done = true }
    } else {
        if p.step > 0 { p.step = p.step - 1 }
        else if p.i > 0 {
            p.i = p.i - 1
            p.step = optional(p.order[p.i], "steps", 0)
        }
    }
    render_present()
    render_present_bar()
    pump()
}
fn present_tick(){
    if st.present == nil { return }
    render_present_bar()
}
fn toggle_present_notes(){
    if st.present == nil { return }
    st.present.notes = !st.present.notes
    render_present()
    render_present_bar()
    pump()
}
fn stop_present(){
    let p = st.present
    if p == nil { return }
    if p.timer != nil { stop_timer(p.timer) }
    st.present = nil
    let t = tab_by_key(p.key)
    let item = nil
    if p.i < p.order.len() { item = p.order[p.i] }
    show()
    if t != nil && item != nil { go_slide(t, item.slide) }
    pump()
}

// ---- Export -----------------------------------------------------------------------

fn export_ext(kind){
    if kind == "pptx" { return ".pptx" }
    if kind == "pdf" { return ".pdf" }
    ""
}
fn export_button(kind){
    if kind == "pptx" { return "Export presentation" }
    if kind == "images" { return "Export pictures" }
    "Export PDF"
}
// Files and folders the storage holds now, counted the way its 256-entry
// limit counts them, with the engine's cache counted as full.
fn entries_used(){
    let n = 1
    for dir in [DECKS, IMPORTS, IMAGES, EXPORTS] {
        if fs.exists(dir) {
            n = n + 1
            for name in fs.list(dir) {
                n = n + 1
                if regex("/$").test(name) { n = n + fs.list(dir + "/" + name).len() }
            }
        }
    }
    n + CACHE_FILES
}
fn do_export(t){
    let e = t.export
    if e == nil || e.busy { return }
    let name = clean_title(e.name)
    e.error = ""
    if name == "" { e.error = "Give the export a name." render_export() return }
    let numbers = nil
    if e.which == "current" { numbers = [slide_index(t, t.cur) + 1] }
    if e.which == "custom" {
        numbers = range_numbers(e.range, t.slides.len())
        if numbers == nil { e.error = "Check the slides: use numbers and ranges such as 2-6." render_export() return }
    }
    let args = {doc: t.doc kind: e.kind}
    if e.kind == "images" {
        let dir = EXPORTS + "/" + name
        if fs.exists(dir) { e.error = "An export named “" + name + "” is already in Quick Deck's storage. Change the name." render_export() return }
        let count = t.slides.len()
        if numbers != nil { count = numbers.len() }
        if entries_used() + count + 1 > MAX_ENTRIES {
            e.error = "There isn't room for " + plural(count, "picture", "pictures") + ": Quick Deck's storage holds 256 files and folders. Remove an export or a deck first."
            render_export()
            return
        }
        args.out_dir = dir
        args.width = 1920
    } else {
        let out = EXPORTS + "/" + name + export_ext(e.kind)
        if fs.exists(out) { e.error = "An export named “" + base_name(out) + "” is already in Quick Deck's storage. Change the name." render_export() return }
        args.out = out
    }
    if numbers != nil { args.slides = ids_at(t.slides, numbers) }
    if e.kind == "pdf" {
        args.layout = e.layout
        if e.layout == "handouts" { args.per_page = e.per_page }
        args.include_hidden = e.hidden
    }
    // An images export names its slides (it takes no include_hidden): the
    // chosen ones, less the hidden ones unless they're included; at most 64.
    if e.kind == "images" {
        let ids = []
        for i s in t.slides {
            let chosen = numbers == nil || has(numbers, i + 1)
            if chosen && (e.hidden || !optional(s, "hidden", false)) { ids.push(s.id) }
        }
        if ids.len() == 0 { e.error = "Every chosen slide is hidden: include hidden slides, or choose others." render_export() return }
        if ids.len() > 64 { e.error = "An images export takes up to 64 slides at a time: choose a range." render_export() return }
        args.slides = ids
    }
    ensure_dir(EXPORTS)
    e.busy = true
    render_export()
    engine("export", args, fn(a){
        e.busy = false
        wrote(a)
        if !a.is_ok {
            e.error = action_failed("export it", a.error)
            render_export()
            return
        }
        let path = optional(a.data, "path", optional(args, "out", optional(args, "out_dir", "")))
        let d = deck_by_path(t.path)
        if d != nil {
            let list = optional(d, "exports", [])
            list.push({name: base_name(path) path: path bytes: optional(a.data, "bytes", nil) at: time_now() kind: e.kind count: optional(a.data, "paths", []).len()})
            d.exports = list
            remember(d)
            save_index()
        }
        render_export()
        note("Exported “" + base_name(path) + "” into Quick Deck's storage.")
    })
}
fn remove_export(t, x){
    let d = deck_by_path(t.path)
    if d == nil { return }
    if x.kind == "images" && fs.exists(x.path) {
        for name in fs.list(x.path) { try { fs.remove(x.path + "/" + name) } catch {} }
    }
    try { fs.remove(x.path) } catch {}
    let kept = []
    for y in optional(d, "exports", []) { if y.path != x.path { kept.push(y) } }
    d.exports = kept
    remember(d)
    save_index()
    storage_later()
    st.space_full = false
    render_export()
}

// ---- New from an outline -------------------------------------------------------------

fn blank_card(){ {title: "" points: "" notes: ""} }
fn open_outline(){
    if st.draft == nil {
        st.draft = {cards: [blank_card(), blank_card(), blank_card()] topic: "" count: 10 theme: "" size: "16:9"}
    }
    let o = st.draft
    o.busy = false
    o.error = ""
    o.ai = optional(o, "ai", "")
    o.making = false
    if o.theme == "" {
        let th = theme_named("Harbor")
        if th == nil && theme_list().len() > 0 { th = theme_list()[0] }
        if th != nil { o.theme = th.name }
    }
    for i t in st.tabs {
        if t.kind == "outline" {
            show_tab(i)
            return
        }
    }
    st.next_key = st.next_key + 1
    st.tabs.push({key: "t" + st.next_key kind: "outline" title: "New deck" edited: false state: "ready" doc: nil path: ""})
    show_tab(st.tabs.len() - 1)
}
fn outline_typed(i, key, text){
    let o = st.draft
    if o == nil || i >= o.cards.len() { return }
    if key == "title" { o.cards[i].title = text } else { o.cards[i].points = text }
    st.index_dirty = true
    render_outline_make()
}
fn add_card(){
    let o = st.draft
    if o.cards.len() >= MAX_OUTLINE { o.error = "An outline holds up to " + MAX_OUTLINE + " slides." render_outline() return }
    o.cards.push(blank_card())
    render_outline()
    render_outline_side()
}
fn remove_card(i){
    let o = st.draft
    if o.cards.len() < 2 {
        o.cards = [blank_card()]
    } else {
        o.cards.remove(i)
    }
    render_outline()
    render_outline_side()
}
fn move_card(i, dy){
    let o = st.draft
    let j = clamp(i + round(dy / 120), 0, o.cards.len() - 1)
    if j == i { return }
    let moving = o.cards[i]
    let rest = []
    for k c in o.cards { if k != i { rest.push(c) } }
    let out = []
    for k c in rest {
        if k == j { out.push(moving) }
        out.push(c)
    }
    if j >= rest.len() { out.push(moving) }
    o.cards = out
    render_outline()
}
// Draft with AI: the host's model.complete, on the person's own provider,
// fills the outline cards; the app never sees a key, and the cards can be
// typed by hand whatever the answer.
fn draft_outline(){
    let o = st.draft
    if o == nil || o.ai == "drafting" { return }
    let topic = ("" + o.topic).trim()
    if topic == "" {
        o.ai = "Type what the deck is about, then draft."
        render_outline()
        return
    }
    o.ai = "drafting"
    render_outline()
    host.request("model.complete", {task: DRAFT_TASK input: {topic: topic slides: o.count} schema: outline_schema(o.count) class: "fast"}, fn(r){
        let answer = {is_ok: r.is_ok data: r.data error: r.error}
        start_timeout(0.01, || drafted(answer))
    })
}
fn ai_refusal(error){
    let e = "" + error
    if e.search("no_provider") >= 0 { return "Set up an AI provider in Settings to draft outlines (Settings → AI providers). You can still type the outline." }
    if e.search("budget") >= 0 { return "Today's AI allowance is used up. Try again tomorrow, or type the outline." }
    if e.search("rate") == 0 { return "Too many requests. Wait a minute, then try again." }
    if e.search("timed out") >= 0 { return "This is taking too long. Try again in a moment." }
    if e.search("no service answers") >= 0 || e.search("capability") >= 0 || e.search("not granted") >= 0 { return "Drafting needs OctoSense's AI service, which isn't available here. You can still type the outline." }
    "The AI provider couldn't draft it: " + err_words(e)
}
fn drafted(a){
    let o = st.draft
    if o == nil { return }
    if !a.is_ok {
        o.ai = ai_refusal(a.error)
        render_outline()
        return
    }
    let cards = cards_from_model(optional(a.data, "output", nil), MAX_OUTLINE)
    if cards == nil {
        o.ai = "The AI's outline couldn't be used. Try again, or type the outline."
        render_outline()
        return
    }
    o.cards = cards
    o.ai = ""
    st.index_dirty = true
    render_outline()
    render_outline_side()
}
// Make deck: the engine lays the cards out as slides (deck.create), and the
// new deck opens in place of the outline.
fn make_deck(){
    let o = st.draft
    if o == nil || o.making { return }
    if st.engine != "ok" {
        o.error = engine_headline() + "."
        render_outline_side()
        return
    }
    let problem = outline_problem(o.cards)
    if problem != "" {
        o.error = problem
        render_outline_side()
        return
    }
    let slides = outline_slides(o.cards)
    let title = clean_title(slides[0].title)
    if title == "" { title = UNTITLED }
    title = unique_title(title, titles_taken())
    let out = DECKS + "/" + unique_file(title) + ".deckcraft"
    ensure_dir(DECKS)
    o.making = true
    o.error = ""
    render_outline_side()
    engine("create", {out: out theme: o.theme size: o.size slides: slides}, fn(a){
        o.making = false
        wrote(a)
        if !a.is_ok {
            o.error = action_failed("make the deck", a.error)
            render_outline_side()
            return
        }
        let now = time_now()
        st.index[out] = {title: title slides: slides.len() theme: o.theme created: now edited: now opened: now}
        st.draft = nil
        save_index()
        scan_library()
        // The outline's tab becomes the deck's.
        let kept = []
        for x in st.tabs { if x.kind != "outline" { kept.push(x) } }
        st.tabs = kept
        open_created(out, a.data)
    })
}
// Home's theme row: a new deck of one title slide in that theme.
fn new_deck(theme){
    if st.engine != "ok" {
        note(engine_headline() + ".")
        return
    }
    if deck_tab_count() >= MAX_OPEN {
        note("Quick Deck keeps up to " + MAX_OPEN + " decks open. Close one to open another.")
        return
    }
    let title = unique_title(UNTITLED, titles_taken())
    let out = DECKS + "/" + unique_file(title) + ".deckcraft"
    ensure_dir(DECKS)
    engine("create", {out: out theme: theme}, fn(a){
        wrote(a)
        if !a.is_ok {
            note(action_failed("start a deck", a.error))
            return
        }
        let now = time_now()
        st.index[out] = {title: title slides: 1 theme: theme created: now edited: now opened: now}
        save_index()
        scan_library()
        open_created(out, a.data)
    })
}
fn open_created(path, v){
    let d = deck_by_path(path)
    if d == nil { d = deck_from(path, optional(st.index, path, nil)) }
    let t = new_tab(d)
    st.tabs.push(t)
    st.cur = st.tabs.len() - 1
    st.screen = "deck"
    took_open(t, v)
    show()
}

// ---- size --------------------------------------------------------------------

// The canvas there is now, for the deck tab `t`.
fn canvas_now(t){
    let insp = pick(narrow(), 0, INSP_W + 1)
    let strip = pick(t != nil && t.tool != "" && t.tool != "text", STRIP_H + 1, 0)
    canvas_size(st.width, st.height, nav_w() + 1, insp, strip)
}
fn fit_now(t){
    let c = canvas_now(t)
    fit_zoom(t.size[0], t.size[1], c[0], c[1])
}
fn set_zoom(t, z, fit){
    t.zoom = clamp(z, 0.1, 4.0)
    t.fit = fit
    render_canvas()
    render_pill()
    pump()
}
// The shell calls this when the app's window changes size, on every frame of
// its open animation too: settle, then lay out.
fn on_app_resize(width, height){
    if width <= 0 { return }
    if abs(width - st.width) < 2 && abs(height - st.height) < 2 { return }
    st.width = width
    st.height = height
    st.resize_n = st.resize_n + 1
    let n = st.resize_n
    start_timeout(0.3, || {
        if n != st.resize_n || !st.booted { return }
        for t in st.tabs { if t.kind == "deck" && t.fit && t.state == "ready" { t.zoom = fit_now(t) } }
        show()
        pump()
    })
}

// ---- drawing: each region renders on its own ----------------------------------

fn render_tabs(){ ui.tabs.render() }
fn render_confirm(){
    ui.confirm_box.set_visible(st.confirm != "")
    ui.confirm.render()
}
fn render_home(){ if st.screen == "home" { ui.home_pane.render() render_status() } }
fn render_bar(){ if deck_tab() != nil { ui.bar.render() } }
fn render_strip(){ if deck_tab() != nil { ui.strip.render() } }
fn render_thumbs(){
    let t = deck_tab()
    if t != nil && t.state == "ready" && t.view == "slides" { ui.thumbs.render() }
}
fn render_canvas(){
    let t = deck_tab()
    // While a text box is edited its field stays put.
    if t != nil && t.editing != nil && !t.editing.waiting && t.drag == nil { ui.drag_layer_host.render() return }
    ui.canvas.render()
}
fn render_drag(){ ui.drag_layer_host.render() }
fn render_pill(){ ui.pill.render() }
fn insp_shown(){ !narrow() || st.insp_over }
fn render_insp_tabs(){ if deck_tab() != nil && insp_shown() { ui.insp_tabs.render() } }
fn render_inspector(){ if deck_tab() != nil && insp_shown() { ui.insp_body.render() } }
fn render_sorter(){ ui.sorter.render() }
fn render_sorter_strip(){ ui.sorter_strip.render() }
fn render_export(){ ui.export_pane.render() }
fn render_outline(){ if st.screen == "outline" { ui.outline_main.render() } }
fn render_outline_side(){
    if st.screen != "outline" { return }
    ui.outline_side.render()
    ui.outline_make.render()
}
// What typing changes on the side: the counts, and whether Make deck can go.
fn render_outline_make(){ if st.screen == "outline" { ui.outline_make.render() } }
fn render_status(){ ui.status.render() }
fn render_storage(){
    ui.full_box.set_visible(st.space_full && st.present == nil && st.screen != "home")
    ui.full_bar.render()
    render_status()
}
fn render_present(){ if st.present != nil { ui.present.render() } }
fn render_present_bar(){ if st.present != nil { ui.present_bar.render() } }
fn refresh_doc(){
    if st.screen == "home" { render_tabs() return }
    show()
}
// After a change that keeps the window's regions as they are (a design
// change, an undo): the canvas, the thumbnails, the inspector's content and
// the bars, drawn again without making their regions again, so the
// inspector keeps its scroll and the control just used stays in view.
fn refresh_view(t){
    if deck_tab() != t || t.state != "ready" || t.view != "slides" {
        refresh_doc()
        return
    }
    render_canvas()
    render_thumbs()
    render_pill()
    render_insp_tabs()
    render_inspector()
    render_bar()
    render_tabs()
    render_status()
}
// Which of the deck view's regions show.
fn show_regions(){
    let t = deck_tab()
    if t == nil { return }
    let ready = t.state == "ready"
    let slides = ready && t.view == "slides"
    ui.slides_box.set_visible(t.view == "slides" || !ready)
    ui.sorter_box.set_visible(ready && t.view == "sorter")
    ui.export_box.set_visible(ready && t.view == "export")
    ui.nav_box.set_visible(slides)
    ui.strip_box.set_visible(slides && t.tool != "" && t.tool != "text")
    ui.canvas_box.set_visible(slides)
    ui.pill_box.set_visible(slides)
    ui.notice_box.set_visible(!ready)
    ui.insp_box.set_visible(slides && !narrow())
    ui.float_box.set_visible(slides && narrow() && st.insp_over)
}
// Which regions show, then every region drawn again.
fn show(){
    let t = cur_tab()
    let presenting = st.present != nil
    let deck = !presenting && t != nil && t.kind == "deck"
    let outline = !presenting && t != nil && t.kind == "outline"
    ui.tabs_box.set_visible(!presenting)
    ui.home.set_visible(!presenting && t == nil)
    ui.deck.set_visible(deck)
    ui.outline.set_visible(outline)
    ui.status_box.set_visible(!presenting)
    ui.present_box.set_visible(presenting)
    ui.full_box.set_visible(st.space_full && !presenting && t != nil)
    if presenting {
        render_present()
        render_present_bar()
        return
    }
    if deck {
        show_regions()
        ui.notice.render()
        render_bar()
        if t.state == "ready" && t.view == "slides" {
            // The navigator and the inspector hold regions of their own, made
            // with them and drawn on the next turn.
            ui.nav.render()
            render_strip()
            ui.canvas.render()
            render_pill()
            ui.insp_side.render()
            ui.insp_float.render()
            start_timeout(0.03, || {
                render_thumbs()
                render_insp_tabs()
                render_inspector()
            })
        }
        if t.state == "ready" && t.view == "sorter" {
            render_sorter_strip()
            render_sorter()
        }
        if t.state == "ready" && t.view == "export" { render_export() }
    }
    if outline {
        ui.outline_main.render()
        ui.outline_side.render()
        ui.outline_make.render()
    }
    if t == nil { ui.home_pane.render() }
    ui.full_bar.render()
    render_tabs()
    render_confirm()
    render_status()
}

// Every 2 s: a boot that a script budget abort cut short starts again, the
// library index is written when it changed, and the pump picks up work an
// aborted callback left. Made once: a restyle runs this file again.
fn heartbeat(){
    if !st.booted { boot() return }
    if optional(st, "index_dirty", false) { save_index() }
    pump()
}
fn boot(){
    if st.booted {
        resume()
        return
    }
    load_index()
    adopt_v1()
    scan_library()
    st.booted = true
    show()
    check_files()
    ask_themes()
}
// After a restyle: the same screen, every region drawn with the new look.
fn resume(){
    // The text field of a box being edited is made again with the canvas.
    for t in st.tabs { if t.kind == "deck" && t.editing != nil { t.editing.waiting = true } }
    show()
    pump()
}

// ---- views: each returns one widget, drawn by a region's on_render ----------
// Sizes and spacing are the maps' (design/map/NN-*.json), in points.

// The document tabs: Home, one tab per open deck (and the outline page),
// then New, which goes to Home and its ways to start a deck.
fn tabs_view(){
    View{width: Fill height: Fill flow: Overlay
        View{width: Fill height: Fill flow: Down align: Align{y: 1.0}
            Line{}
        }
        View{width: Fill height: Fill flow: Right padding: Inset{left: 8 right: 8 top: 11} spacing: 2
            home_tab()
            for i t in st.tabs { doc_tab(i, t) }
            View{width: Fit height: 42 flow: Right align: Align{y: 0.5} padding: Inset{left: 6}
                Flat{height: 34 padding: Inset{left: 10 right: 12} spacing: 6 text: "New" icon_walk: Walk{width: 16 height: 16}
                    draw_icon +: {svg: icon("plus") color: qd_ink2}
                    on_click: || go_home()}
            }
        }
    }
}
// A tab is 48 pt tall from the row's top padding: the row clips its last 6,
// so the open tab's rounded bottom and border disappear into the toolbar.
let Tab = RoundedView{width: Fit height: 48 flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 8 bottom: 6} spacing: 9 show_bg: true
    draw_bg +: {color: #x00000000 border_size: 0.0 border_color: qd_tab_line border_radius: 6.0}}
fn home_tab(){
    let on = st.screen == "home"
    GestureView{width: Fit height: 48 cursor: MouseCursor.Hand on_tap: |x, y| go_home()
        Tab{padding: Inset{left: 16 right: 18 bottom: 6} spacing: 10 draw_bg +: {color: pick(on, qd_tab_on, #x00000000) border_size: pick(on, 1.0, 0.0)}
            Ico{width: 17 height: 17 draw_svg +: {svg: icon("home") color: pick(on, qd_ink, qd_muted)}}
            Label{padding: 0 text: "Home" draw_text +: {color: pick(on, qd_ink, qd_muted) text_style: theme.font_regular{font_size: 11}}}
        }
    }
}
// Each title takes what it needs while the row has room: what the row leaves
// after its padding, Home and New (232), less each tab's icon, cross, padding
// and gap (80).
// Past that the longest titles are cut to one common width (an ellipsis),
// found by filling the room from the shortest title up.
// About 8 points a character at 11 (measured on the runtime's UI font, which
// is wider than the designs': 6.6).
fn title_px(t){ (t.title.len() + pick(t.edited, 2, 0)) * 8.2 }
fn tab_title_cap(){
    let n = st.tabs.len()
    if n == 0 { return 190 }
    let room = st.width - 232 - n * 80
    let total = 0
    for t in st.tabs { total = total + title_px(t) }
    if total <= room { return 100000 }
    let cap = room / n
    for k in 8 {
        let used = 0
        let over = 0
        for t in st.tabs {
            let w = title_px(t)
            if w > cap { used = used + cap over = over + 1 } else { used = used + w }
        }
        if over == 0 || used >= room - 1 { return max(24, floor(cap)) }
        cap = cap + (room - used) / over
    }
    max(24, floor(cap))
}
fn doc_tab(i, t){
    let on = st.screen != "home" && i == st.cur
    let title = t.title + pick(t.edited, " •", "")
    let cap = tab_title_cap()
    let long = title_px(t) > cap
    GestureView{width: Fit height: 48 cursor: MouseCursor.Hand on_tap: |x, y| show_tab(i)
        Tab{draw_bg +: {color: pick(on, qd_tab_on, #x00000000) border_size: pick(on, 1.0, 0.0)}
            Ico{width: 16 height: 16 draw_svg +: {svg: icon(pick(t.kind == "outline", "outline", "deck")) color: pick(on, qd_ink2, qd_muted)}}
            if long { Label{padding: 0 width: cap max_lines: 1 text_overflow: TextOverflow.Ellipsis text: title draw_text +: {color: pick(on, qd_ink, qd_muted) text_style: theme.font_regular{font_size: 11}}} }
            if !long { Label{padding: 0 text: title draw_text +: {color: pick(on, qd_ink, qd_muted) text_style: theme.font_regular{font_size: 11}}} }
            IconBtn{width: 26 height: 26 icon_walk: Walk{width: 13 height: 13} draw_icon +: {svg: icon("close") color: qd_muted}
                on_click: || ask_close(t)}
        }
    }
}

// The toolbar: Slides and Sorter; Text, Picture, Shape, Table and Chart;
// Undo and Redo; Save, Export and Present (the one filled button).
fn bar_view(){
    let t = deck_tab()
    if t == nil { return View{width: Fill height: 1} }
    let ready = t.state == "ready"
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 16}
        view_tab(t, "slides", "Slides")
        view_tab(t, "sorter", "Sorter")
        Gap{}
        if ready {
            insert_btn(t, "text", "text-box", "Text")
            insert_btn(t, "picture", "picture", "Picture")
            insert_btn(t, "shape", "shape", "Shape")
            insert_btn(t, "table", "table", "Table")
            insert_btn(t, "chart", "chart", "Chart")
        }
        Gap{}
        if ready {
            tool_btn("undo", "Undo", t.can_undo, || undo(deck_tab(), false))
            tool_btn("redo", "Redo", t.can_redo, || undo(deck_tab(), true))
            SolidView{width: 1 height: 28 margin: Inset{left: 10 right: 14} draw_bg.color: qd_line}
            Outline{height: 34 padding: Inset{left: 12 right: 16} spacing: 8 text: pick(t.saving, "Saving…", "Save") icon_walk: Walk{width: 17 height: 17}
                draw_icon +: {svg: icon("save")} draw_text +: {text_style: theme.font_regular{font_size: 12}}
                on_click: || save(deck_tab(), nil)}
            View{width: 8 height: 1}
            Outline{height: 34 padding: Inset{left: 12 right: 16} spacing: 8 text: "Export" icon_walk: Walk{width: 17 height: 17}
                draw_icon +: {svg: icon("export") color: pick(t.view == "export", qd_link, qd_icon)}
                draw_bg +: {color: pick(t.view == "export", qd_tint, qd_card) border_color: pick(t.view == "export", qd_tint_line, qd_field_line)}
                draw_text +: {color: pick(t.view == "export", qd_link, qd_ink) color_hover: pick(t.view == "export", qd_link, qd_ink) text_style: theme.font_regular{font_size: 12}}
                on_click: || { let x = deck_tab() set_view(x, pick(x.view == "export", "slides", "export")) }}
            View{width: 8 height: 1}
            Primary{height: 34 padding: Inset{left: 16 right: 20} spacing: 10 text: "Present" icon_walk: Walk{width: 13 height: 13}
                draw_icon +: {svg: icon("play")} draw_text +: {text_style: theme.font_bold{font_size: 12}}
                on_click: || start_present(deck_tab())}
            if narrow() && t.view == "slides" {
                IconBtn{margin: Inset{left: 8} width: 34 height: 34 icon_walk: Walk{width: 19 height: 19}
                    draw_icon +: {svg: icon("inspector") color: pick(st.insp_over, qd_link, qd_icon)}
                    on_click: || { st.insp_over = !st.insp_over show() }}
            }
        }
    }
}
fn view_tab(t, id, label){
    let on = t.view == id || (id == "slides" && t.view == "export")
    View{width: 76 height: Fill flow: Down align: Align{x: 0.5}
        Flat{width: Fill height: Fill padding: Inset{left: 6 right: 6} text: label
            draw_bg +: {color_hover: #x00000000 color_down: #x00000000}
            draw_text +: {color: pick(on, qd_link, qd_ink2) color_hover: pick(on, qd_link, qd_ink) color_down: qd_link color_focus: pick(on, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 12.5}}
            on_click: || set_view(deck_tab(), id)}
        SolidView{width: Fill height: 3 margin: Inset{left: 12 right: 12 bottom: 1} draw_bg.color: pick(on, qd_accent, #x00000000)}
    }
}
// An insert button: its icon over its name; tinted while its strip is open.
fn insert_btn(t, tool, ic, label){
    let on = t.tool == tool && t.view == "slides"
    GestureView{width: 64 height: 50 cursor: MouseCursor.Hand on_tap: |x, y| choose_tool(tool)
        RoundedView{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 3 show_bg: true
            draw_bg +: {color: pick(on, qd_tint, #x00000000) border_radius: 5.0}
            Ico{width: 22 height: 22 draw_svg +: {svg: icon(ic) color: pick(on, qd_link, qd_icon)}}
            Label{padding: 0 text: label draw_text +: {color: pick(on, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 10.5}}}
        }
    }
}
fn tool_btn(ic, label, enabled, act){
    GestureView{width: 52 height: 50 cursor: pick(enabled, MouseCursor.Hand, MouseCursor.Default) on_tap: |x, y| { if enabled { act() } }
        View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 3
            Ico{width: 20 height: 20 draw_svg +: {svg: icon(ic) color: pick(enabled, qd_icon, qd_faint)}}
            Label{padding: 0 text: label draw_text +: {color: pick(enabled, qd_ink2, qd_faint) text_style: theme.font_regular{font_size: 10.5}}}
        }
    }
}
// Text inserts a text box at once and edits it; the others open their strip.
fn choose_tool(tool){
    let t = deck_tab()
    if t == nil || t.state != "ready" { return }
    if t.view != "slides" { set_view(t, "slides") }
    if tool == "text" {
        t.tool = ""
        show_regions()
        insert_text(t)
        return
    }
    t.tool = pick(t.tool == tool, "", tool)
    if t.tool == "shape" { ask_shapes() }
    if t.tool == "chart" {
        let sh = selected_shape(t)
        if sh != nil && optional(sh, "kind", "") == "chart" { t.chart_type = chart_id(optional(optional(sh, "chart", {}), "type", "column")) }
    }
    if t.fit { t.zoom = fit_now(t) }
    show()
    pump()
}

// The insert strip under the toolbar, above the canvas: chart types, shape
// presets, the pictures in storage, a table's size (BRIEF "Window and layout";
// 03-chart draws the chart strip).
let StripChip = Flat{height: 34 padding: Inset{left: 10 right: 12} spacing: 8 icon_walk: Walk{width: 18 height: 18}
    draw_text +: {text_style: theme.font_regular{font_size: 11.5}}}
fn chip_on(on){ pick(on, qd_tint, #x00000000) }
fn strip_view(){
    let t = deck_tab()
    if t == nil || t.tool == "" || t.tool == "text" { return View{width: Fill height: 1} }
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} align: Align{y: 0.5} padding: Inset{left: 24 right: 12 top: 8 bottom: 8} spacing: 10
            if t.tool == "chart" { chart_strip(t) }
            if t.tool == "shape" { shape_strip(t) }
            if t.tool == "picture" { picture_strip(t) }
            if t.tool == "table" { table_strip(t) }
        }
        Line{}
    }
}
fn strip_title(text){ View{width: Fit height: 34 align: Align{y: 0.5} padding: Inset{right: 14} Label{padding: 0 text: text draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 12.5}}}} }
fn strip_close(){
    IconBtn{width: 30 height: 30 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("close") color: qd_muted}
        on_click: || { let x = deck_tab() x.tool = "" if x.fit { x.zoom = fit_now(x) } show() }}
}
fn chart_strip(t){
    // Wraps in a narrow canvas, so Insert chart is always there.
    View{width: Fill height: Fit flow: Flow.Right{wrap: true} align: Align{y: 0.5} spacing: 6
        strip_title("Chart")
        for c in CHARTS {
            StripChip{text: c.label
                draw_icon +: {svg: icon("chart-" + c.id) color: pick(t.chart_type == c.id, qd_link, qd_icon)}
                draw_bg +: {color: chip_on(t.chart_type == c.id) border_size: pick(t.chart_type == c.id, 1.0, 0.0) border_color: qd_tint_line}
                draw_text +: {color: pick(t.chart_type == c.id, qd_link, qd_ink2) color_hover: pick(t.chart_type == c.id, qd_link, qd_ink)}
                on_click: || { let x = deck_tab() x.chart_type = c.id render_strip() }}
        }
        View{width: 12 height: 1}
        Outline{height: 34 text: "Insert chart" draw_text +: {text_style: theme.font_regular{font_size: 11.5}} on_click: || insert_chart(deck_tab())}
        strip_close()
    }
}
fn shape_categories(){
    let out = []
    if st.shapes == nil { return out }
    for p in st.shapes {
        let c = "" + optional(p, "category", "")
        if c != "" && c != "Action Buttons" && !has(out, c) { out.push(c) }
    }
    out
}
fn shape_strip(t){
    let cats = shape_categories()
    let cat = t.shape_cat
    if cat == "" && cats.len() > 0 { cat = pick(has(cats, "Basic Shapes"), "Basic Shapes", cats[0]) }
    View{width: Fill height: Fit flow: Down spacing: 6
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} align: Align{y: 0.5} spacing: 4
            strip_title("Shape")
            if cats.len() == 0 { Label{padding: 0 text: pick(st.engine == "ok", "Reading the shapes…", engine_headline()) draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11.5}}} }
            for c in cats {
                StripChip{text: c draw_bg +: {color: chip_on(c == cat) border_size: pick(c == cat, 1.0, 0.0) border_color: qd_tint_line}
                    draw_text +: {color: pick(c == cat, qd_link, qd_ink2) color_hover: pick(c == cat, qd_link, qd_ink)}
                    on_click: || { let x = deck_tab() x.shape_cat = c render_strip() }}
            }
            Gap{}
            strip_close()
        }
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 4 padding: Inset{left: 62}
            for p in optional(st, "shapes", []) {
                if ("" + optional(p, "category", "")) == cat {
                    Outline{height: 30 padding: Inset{left: 10 right: 10} text: "" + optional(p, "label", p.name)
                        draw_text +: {text_style: theme.font_regular{font_size: 11}}
                        on_click: || insert_shape(deck_tab(), p.name)}
                }
            }
        }
    }
}
fn picture_strip(t){
    let pics = picture_list()
    View{width: Fill height: Fit flow: Flow.Right{wrap: true} align: Align{y: 0.5} spacing: 6
        strip_title("Picture")
        if pics.len() == 0 { Label{padding: 0 text: "No pictures in Quick Deck yet." draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11.5}}} }
        for p in pics {
            View{width: Fit height: 34 flow: Right align: Align{y: 0.5} spacing: 0
                StripChip{text: p.name draw_icon +: {svg: icon("picture")} on_click: || insert_picture(deck_tab(), p.path)}
                IconBtn{width: 24 height: 24 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("close") color: qd_faint} on_click: || remove_picture(p)}
            }
        }
        View{width: 8 height: 1}
        Outline{height: 34 spacing: 8 text: pick(st.importing == "picture", "Choosing a picture…", "From this device…") icon_walk: Walk{width: 16 height: 16}
            draw_icon +: {svg: icon("folder")} draw_text +: {text_style: theme.font_regular{font_size: 11.5}}
            on_click: || picture_from_device()}
        Gap{}
        strip_close()
    }
}
fn stepper(value, minus, plus){
    RoundedView{width: Fit height: 34 flow: Right align: Align{y: 0.5} show_bg: true draw_bg +: {color: qd_field border_size: 1.0 border_color: qd_field_line border_radius: 5.0}
        IconBtn{width: 32 height: 32 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("minus")} on_click: minus}
        SolidView{width: 1 height: Fill draw_bg.color: qd_field_line}
        View{width: Fit height: Fill align: Align{x: 0.5 y: 0.5} padding: Inset{left: 12 right: 12}
            Label{padding: 0 text: value draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 12}}}
        }
        SolidView{width: 1 height: Fill draw_bg.color: qd_field_line}
        IconBtn{width: 32 height: 32 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("plus")} on_click: plus}
    }
}
fn table_strip(t){
    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
        strip_title("Table")
        Label{padding: 0 text: "Rows" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}
        stepper("" + t.table_rows, || { let x = deck_tab() x.table_rows = max(1, x.table_rows - 1) render_strip() }, || { let x = deck_tab() x.table_rows = min(75, x.table_rows + 1) render_strip() })
        View{width: 6 height: 1}
        Label{padding: 0 text: "Columns" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}
        stepper("" + t.table_cols, || { let x = deck_tab() x.table_cols = max(1, x.table_cols - 1) render_strip() }, || { let x = deck_tab() x.table_cols = min(75, x.table_cols + 1) render_strip() })
        View{width: 12 height: 1}
        Outline{height: 34 text: "Insert table" draw_text +: {text_style: theme.font_regular{font_size: 11.5}} on_click: || insert_table(deck_tab())}
        Gap{}
        strip_close()
    }
}

// The navigator: New slide, then the slides around the current one with
// their numbers, section names between them; the current one outlined, a
// hidden one dimmed.
fn nav_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" { return View{width: 1 height: Fill} }
    let w = nav_w()
    View{width: Fit height: Fill flow: Right
        SolidView{width: w height: Fill flow: Down draw_bg.color: qd_nav
            View{width: Fill height: Fit padding: Inset{left: 16 right: 14 top: 12 bottom: 8}
                Flat{width: Fill height: 34 spacing: 8 text: "New slide" icon_walk: Walk{width: 15 height: 15}
                    draw_icon +: {svg: icon("plus") color: qd_link}
                    draw_bg +: {color: qd_card color_hover: qd_tint border_size: 1.0 border_color: qd_link border_radius: 5.0}
                    draw_text +: {color: qd_link color_hover: qd_link color_down: qd_link color_focus: qd_link text_style: theme.font_regular{font_size: 12}}
                    on_click: || new_slide(deck_tab())}
            }
            thumbs := ScrollYView{width: Fill height: Fill flow: Down on_render: || { thumbs_view() }}
        }
        VLine{}
    }
}
fn nav_thumb_w(){ pick(narrow(), 140, THUMB_W) }
// The navigator's first slide: the list keeps no scroll position a script can
// set, so it starts a little before the current slide once the current one
// would fall below the fold (04-layout and 10-dark-notes start at slide 3).
fn nav_rows(t){
    let h = round(nav_thumb_w() * t.size[1] / max(1, t.size[0])) + 20
    max(2, floor((st.height - TAB_H - BAR_H - STATUS_H - 60) / h))
}
fn nav_start(t){
    let n = t.slides.len()
    let cur = max(0, slide_index(t, t.cur))
    let rows = nav_rows(t)
    if n <= rows || cur < rows - 1 { return 0 }
    clamp(cur - 3, 0, max(0, n - rows))
}
fn thumbs_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let n = t.slides.len()
    let first = nav_start(t)
    let last = min(n, first + NAV_WINDOW)
    let w = nav_thumb_w()
    let h = round(w * t.size[1] / max(1, t.size[0]))
    let collapsed = optional(t, "collapsed", {})
    View{width: Fill height: Fit flow: Down padding: Inset{top: 2 bottom: 24}
        if first > 0 {
            LinkBtn{margin: Inset{left: 40} text: "‹ Slides 1–" + first on_click: || { let x = deck_tab() go_slide(x, x.slides[max(0, nav_start(x) - 1)].id) }}
        }
        for i in last - first { nav_item(t, first + i, w, h, collapsed) }
        if last < n {
            LinkBtn{margin: Inset{left: 40} text: "Slides " + (last + 1) + "–" + n + " ›" on_click: || { let x = deck_tab() go_slide(x, x.slides[min(x.slides.len() - 1, last)].id) }}
        }
    }
}
// The section a slide position belongs to (its index in t.sections), or -1.
fn section_of(t, i){
    let found = -1
    for k s in t.sections { if optional(s, "first", 0) <= i { found = k } }
    found
}
fn nav_item(t, i, w, h, collapsed){
    let s = t.slides[i]
    let sec = section_at(t, i)
    let folded = optional(collapsed, "c" + section_of(t, i), false)
    let on = s.id == t.cur
    let src = optional(t.thumbs, "s" + s.id, nil)
    let hidden = optional(s, "hidden", false)
    View{width: Fill height: Fit flow: Down
        if sec != nil {
            GestureView{width: Fill height: 34 flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 12} spacing: 6 cursor: MouseCursor.Hand
                on_tap: |x, y| { let tt = deck_tab() let c = optional(tt, "collapsed", {}) c["c" + sec.index] = !optional(c, "c" + sec.index, false) tt.collapsed = c render_thumbs() }
                Ico{width: 14 height: 14 draw_svg +: {svg: icon(pick(folded, "chevron-right", "chevron-down")) color: qd_muted}}
                Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: pick(sec.name == "", "Untitled section", sec.name) draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}}
            }
        }
        if !folded {
            GestureView{width: Fill height: Fit flow: Right padding: Inset{left: 14 top: 6 bottom: 6} spacing: 8 cursor: MouseCursor.Hand
                on_tap: |x, y| go_slide(deck_tab(), s.id)
                View{width: 22 height: Fit align: Align{x: 1.0} padding: Inset{top: 4}
                    Label{padding: 0 text: "" + (i + 1) draw_text +: {color: pick(on, qd_accent, qd_muted) text_style: theme.font_regular{font_size: 12}}}
                }
                RoundedView{width: w + 6 height: h + 6 padding: 2 show_bg: true
                    draw_bg +: {color: #x00000000 border_size: pick(on, 2.0, 0.0) border_color: qd_accent border_radius: 4.0}
                    // The picture sits inside the 1 pt edge, so a white slide still shows its edge.
                    RoundedView{width: w height: h padding: 1 flow: Overlay show_bg: true draw_bg +: {color: pick(src == nil, qd_line_soft, #xffffff) border_size: 1.0 border_color: qd_thumb_line border_radius: 1.0}
                        if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
                        if src == nil {
                            View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
                                Label{padding: 0 text: "" + (i + 1) draw_text +: {color: qd_faint text_style: theme.font_bold{font_size: 18}}}
                            }
                        }
                        if hidden {
                            SolidView{width: Fill height: Fill draw_bg.color: #xffffffaa}
                            View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0} padding: 6
                                Ico{width: 18 height: 18 draw_svg +: {svg: icon("eye-off") color: #x55585c}}
                            }
                        }
                    }
                }
            }
        }
    }
}

// The canvas: the current slide on the desk, the engine's render at the
// canvas's width, with the selection's frame and handles, the text field of
// a box being edited, and the drag outline in a layer of its own.
fn canvas_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" || t.cur == nil { return View{width: 10 height: 1} }
    let z = t.zoom
    let w = round(t.size[0] * z)
    let h = round(t.size[1] * z)
    let k = "s" + t.cur
    let r = optional(t.renders, k, nil)
    let failed = optional(t.failed, k, nil) != nil && r == nil
    let busy = needs_canvas(t) && !failed
    let e = t.editing
    View{width: Fit height: Fit flow: Down align: Align{x: 0.5}
        RectShadowView{width: w height: h flow: Overlay
            draw_bg +: {color: #xffffff shadow_color: qd_shadow shadow_radius: 7.0 shadow_offset: vec2(0.0, 1.5)}
            if r != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: r.src} }
            if r == nil {
                View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 10
                    if !failed { LoadingSpinner{width: 26 height: 26} }
                    Label{padding: 0 text: pick(failed, "Couldn't draw slide " + (slide_index(t, t.cur) + 1), "Drawing slide " + (slide_index(t, t.cur) + 1) + "…") draw_text +: {color: #x8a8c90 text_style: theme.font_regular{font_size: 12}}}
                }
            }
            GestureView{width: Fill height: Fill cursor: MouseCursor.Default
                on_tap: |x, y| canvas_tap(x / z, y / z, false)
                on_double_tap: |x, y| canvas_double_tap(x / z, y / z)
                on_long_press: |x, y| canvas_tap(x / z, y / z, true)}
            for id in t.sel { selection_view(t, id, z, t.sel.len() == 1 && (e == nil || e.id != id)) }
            if e != nil && !e.waiting { edit_box(t, e, z) }
            if r != nil && busy {
                View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0} padding: 8
                    LoadingSpinner{width: 16 height: 16}
                }
            }
            drag_layer_host := View{width: Fill height: Fill flow: Overlay on_render: || { drag_view() }}
        }
    }
}
// The selection's frame: its handles resize it, the round one above rotates
// it, and the frame itself moves it, or, tapped, edits its text.
fn selection_view(t, id, z, handles){
    let sh = shape_of(t, id)
    if sh == nil { return View{width: 1 height: 1} }
    let b = sh.box
    let x = b[0] * z
    let y = b[1] * z
    let w = max(4, b[2] * z)
    let h = max(4, b[3] * z)
    let editing = t.editing != nil && t.editing.id == id
    View{width: Fill height: Fill flow: Overlay
        RoundedView{margin: Inset{left: x top: y} width: w height: h show_bg: true
            draw_bg +: {color: #x00000000 border_size: 1.25 border_color: qd_select border_radius: 0.0}}
        if handles && !editing {
            GestureView{margin: Inset{left: x + 6 top: y + 6} width: max(4, w - 12) height: max(4, h - 12) cursor: MouseCursor.Move
                on_tap: |px, py| frame_tap(id)
                on_double_tap: |px, py| frame_tap(id)
                on_pan: |dx, dy, phase| frame_pan("move", "", dx, dy, phase)}
        }
        if handles {
            handle(x, y, "nw") handle(x + w / 2, y, "n") handle(x + w, y, "ne")
            handle(x, y + h / 2, "w") handle(x + w, y + h / 2, "e")
            handle(x, y + h, "sw") handle(x + w / 2, y + h, "s") handle(x + w, y + h, "se")
            SolidView{margin: Inset{left: x + w / 2 top: y - ROTATE_LIFT + 5} width: 1 height: ROTATE_LIFT - 5 draw_bg.color: qd_select}
            GestureView{margin: Inset{left: x + w / 2 - 9 top: y - ROTATE_LIFT - 9} width: 18 height: 18 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Hand
                on_pan: |dx, dy, phase| frame_pan("rotate", "", dx, dy, phase)
                RoundedView{width: 12 height: 12 show_bg: true draw_bg +: {color: #xffffff border_size: 1.5 border_color: qd_select border_radius: 6.0}}
            }
        }
    }
}
fn handle(cx, cy, name){
    GestureView{margin: Inset{left: cx - 8 top: cy - 8} width: 16 height: 16 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Hand
        on_pan: |dx, dy, phase| frame_pan("resize", name, dx, dy, phase)
        RoundedView{width: 9 height: 9 show_bg: true draw_bg +: {color: #xffffff border_size: 1.25 border_color: qd_select border_radius: 1.0}}
    }
}
// The outline a drag would leave: the selection moved, resized or turned.
fn drag_view(){
    let t = deck_tab()
    if t == nil || t.drag == nil { return View{width: 1 height: 1} }
    let sh = selected_shape(t)
    let z = t.zoom
    let d = t.drag
    if d.kind == "move" {
        return View{width: Fill height: Fill flow: Overlay
            for id in t.sel {
                if shape_of(t, id) != nil { ghost(moved(shape_of(t, id).box, d.dx, d.dy), z) }
            }
        }
    }
    if sh == nil { return View{width: 1 height: 1} }
    if d.kind == "resize" { return View{width: Fill height: Fill flow: Overlay ghost(resized(sh.box, d.handle, d.dx, d.dy), z)} }
    let deg = rotation_to(sh.box, ROTATE_LIFT, d.dx, d.dy)
    View{width: Fill height: Fill flow: Overlay
        ghost(sh.box, z)
        View{margin: Inset{left: sh.box[0] * z + sh.box[2] * z / 2 + 14 top: sh.box[1] * z - ROTATE_LIFT - 10} width: Fit height: Fit
            RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3} show_bg: true draw_bg +: {color: qd_select border_radius: 4.0}
                Label{padding: 0 text: "" + deg + "°" draw_text +: {color: #xffffff text_style: theme.font_regular{font_size: 11}}}
            }
        }
    }
}
fn ghost(b, z){
    RoundedView{margin: Inset{left: b[0] * z top: b[1] * z} width: max(2, b[2] * z) height: max(2, b[3] * z) show_bg: true
        draw_bg +: {color: #x2f6fdf14 border_size: 1.5 border_color: qd_select border_radius: 0.0}}
}
// The text field over a box being edited: the engine draws the slide without
// its text meanwhile (deck.view `editing`).
fn edit_box(t, e, z){
    let b = e.box
    let size = max(8, e.size * z * 0.75)
    View{margin: Inset{left: b[0] * z top: b[1] * z} width: max(40, b[2] * z) height: max(size * 2, b[3] * z) flow: Overlay
        TextInput{width: Fill height: Fill margin: 0 padding: Inset{left: 7.2 * z right: 7.2 * z top: 3.6 * z bottom: 3.6 * z} is_multiline: true text: e.draft
            on_change: |text| edit_typed(text)
            draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000
                border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000
                border_size: 0.0}
            draw_text +: {color: #x1e2b3a color_hover: #x1e2b3a color_focus: #x1e2b3a color_empty: #x888888 text_style: theme.font_regular{font_size: size line_spacing: 1.25}}
            draw_selection.color: #x557dcc55}
    }
}

// The floating pill: previous, "5 / 12", next, zoom out, the zoom, zoom in,
// and Fit (02-edit-text).
fn pill_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" || t.view != "slides" { return View{width: 1 height: 1} }
    let n = t.slides.len()
    RoundedShadowView{width: Fit height: PILL_H flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 12} spacing: 4
        draw_bg +: {color: qd_pill border_size: 1.0 border_color: qd_pill_line border_radius: 26.5 shadow_color: qd_shadow shadow_radius: 10.0 shadow_offset: vec2(0.0, 2.0)}
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("chevron-left") color: qd_pill_icon} draw_bg +: {color_hover: qd_pill_hover color_down: qd_pill_hover} on_click: || step_slide(deck_tab(), -1)}
        View{width: 72 height: Fit align: Align{x: 0.5}
            Label{padding: 0 text: "" + (slide_index(t, t.cur) + 1) + " / " + n draw_text +: {color: qd_pill_ink text_style: theme.font_regular{font_size: 12}}}
        }
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("chevron-right") color: qd_pill_icon} draw_bg +: {color_hover: qd_pill_hover color_down: qd_pill_hover} on_click: || step_slide(deck_tab(), 1)}
        SolidView{width: 1 height: 28 margin: Inset{left: 10 right: 10} draw_bg.color: qd_pill_line}
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("minus") color: qd_pill_icon} draw_bg +: {color_hover: qd_pill_hover color_down: qd_pill_hover} on_click: || { let x = deck_tab() set_zoom(x, zoom_step(x.zoom, -1), false) }}
        View{width: 60 height: Fit align: Align{x: 0.5}
            Label{padding: 0 text: zoom_text(t.zoom) draw_text +: {color: qd_pill_ink text_style: theme.font_regular{font_size: 12}}}
        }
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("plus") color: qd_pill_icon} draw_bg +: {color_hover: qd_pill_hover color_down: qd_pill_hover} on_click: || { let x = deck_tab() set_zoom(x, zoom_step(x.zoom, 1), false) }}
        SolidView{width: 1 height: 28 margin: Inset{left: 10 right: 10} draw_bg.color: qd_pill_line}
        Flat{height: 32 padding: Inset{left: 12 right: 12} text: "Fit"
            draw_bg +: {color: pick(t.fit, qd_pill_tint, qd_pill) color_hover: qd_pill_hover color_down: qd_pill_hover border_size: 1.0 border_color: pick(t.fit, qd_pill_tint_line, qd_pill_line) border_radius: 5.0}
            draw_text +: {color: pick(t.fit, qd_pill_link, qd_pill_ink) color_hover: pick(t.fit, qd_pill_link, qd_pill_ink) color_down: qd_pill_ink color_focus: pick(t.fit, qd_pill_link, qd_pill_ink) text_style: theme.font_regular{font_size: 12}}
            on_click: || { let x = deck_tab() set_zoom(x, fit_now(x), true) }}
    }
}

// What a deck's tab shows when it isn't open: opening, damaged, unsupported,
// protected, held, no engine, too many open.
fn notice_view(){
    let t = deck_tab()
    if t == nil || t.state == "ready" { return View{width: 1 height: 1} }
    if t.state == "opening" {
        return View{width: Fit height: Fit flow: Down align: Align{x: 0.5} spacing: 12
            LoadingSpinner{width: 30 height: 30}
            Label{padding: 0 text: "Opening “" + t.title + "”…" draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 12.5}}}
        }
    }
    let head = open_head(t.state)
    let detail = open_detail(t.state)
    let ic = "warning"
    if t.state == "protected" { ic = "lock" }
    if t.state == "missing" {
        head = engine_headline()
        detail = engine_detail()
    }
    RoundedShadowView{width: 480 height: Fit flow: Down padding: 28 spacing: 12
        draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_line border_radius: 8.0 shadow_color: qd_shadow shadow_radius: 8.0 shadow_offset: vec2(0.0, 1.0)}
        Ico{width: 30 height: 30 draw_svg +: {svg: icon(ic) color: pick(ic == "lock", qd_icon, qd_red)}}
        Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: head draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 15}}}
        if t.state == "damaged" {
            Wrap{text: "It may be damaged, or not a presentation at all. The engine said:" draw_text +: {color: qd_muted}}
            Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: t.error draw_text +: {color: qd_ink2 text_style: theme.font_code{font_size: 11}}}
        }
        if t.state != "damaged" && detail != "" { Wrap{text: detail draw_text +: {color: qd_muted}} }
        if t.state == "held" && t.error != "" { Wrap{text: "The deck engine said: " + t.error draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5 line_spacing: 1.4}}} }
        if t.state == "missing" && st.engine_note != "" { Code{text: st.engine_note} }
        View{width: Fill height: Fit flow: Right margin: Inset{top: 8} spacing: 10
            Outline{text: "Close this tab" on_click: || close_tab(deck_tab(), true)}
            if t.state == "damaged" || t.state == "unsupported" || t.state == "held" || t.state == "protected" {
                DangerBtn{text: "Remove" on_click: || {
                    let x = deck_tab()
                    let d = deck_by_path(x.path)
                    drop_tab(x)
                    if d != nil { remove_deck(d) }
                }}
            }
            if t.state == "full" { Primary{text: "Try again" on_click: || load_tab(deck_tab())} }
        }
    }
}

// ---- the inspector: Format, Layout, Theme, Notes ----------------------------------

// The inspector's column beside the canvas (the wide layout), and over the
// canvas in a narrow window when the toolbar's button asks for it. Only one
// exists at a time, so its regions keep their names.
fn insp_side_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" || narrow() { return View{width: 1 height: 1} }
    View{width: Fit height: Fill flow: Right
        VLine{}
        SolidView{width: INSP_W height: Fill flow: Down draw_bg.color: qd_insp
            insp_tabs := View{width: Fill height: SEG_H on_render: || { insp_tabs_view() }}
            Line{draw_bg.color: qd_line_soft}
            insp_body := ScrollYView{width: Fill height: Fill flow: Down on_render: || { inspector_view() }}
        }
    }
}
fn insp_float_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" || !narrow() || !st.insp_over { return View{width: 1 height: 1} }
    View{width: Fill height: Fill flow: Down align: Align{x: 1.0} padding: Inset{top: 8 right: 8 bottom: 8}
        RoundedShadowView{width: INSP_W height: Fill flow: Down
            draw_bg +: {color: qd_insp border_size: 1.0 border_color: qd_line border_radius: 8.0 shadow_color: qd_shadow shadow_radius: 12.0 shadow_offset: vec2(0.0, 2.0)}
            insp_tabs := View{width: Fill height: SEG_H on_render: || { insp_tabs_view() }}
            Line{draw_bg.color: qd_line_soft}
            insp_body := ScrollYView{width: Fill height: Fill flow: Down on_render: || { inspector_view() }}
        }
    }
}
let SEGMENTS = [{id: "format" label: "Format"}, {id: "layout" label: "Layout"}, {id: "theme" label: "Theme"}, {id: "notes" label: "Notes"}]
fn insp_tabs_view(){
    let t = deck_tab()
    if t == nil { return View{width: Fill height: 1} }
    View{width: Fill height: Fill flow: Right padding: Inset{left: 8 right: 8}
        for s in SEGMENTS { seg_tab(t, s) }
    }
}
fn seg_tab(t, s){
    let on = t.seg == s.id
    View{width: Fill height: Fill flow: Down align: Align{x: 0.5}
        Flat{width: Fill height: Fill padding: Inset{left: 4 right: 4} text: s.label
            draw_bg +: {color_hover: #x00000000 color_down: #x00000000}
            draw_text +: {color: pick(on, qd_link, qd_ink2) color_hover: pick(on, qd_link, qd_ink) color_down: qd_link color_focus: pick(on, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 12}}
            on_click: || set_seg(s.id)}
        SolidView{width: Fill height: 3 margin: Inset{left: 14 right: 14} draw_bg.color: pick(on, qd_accent, #x00000000)}
    }
}
fn set_seg(id){
    let t = deck_tab()
    if t == nil { return }
    if t.editing != nil && id != "format" { end_edit(t) }
    t.seg = id
    t.font_open = false
    render_insp_tabs()
    render_inspector()
    pump()
}
fn inspector_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    if t.seg == "layout" { return layout_panel(t) }
    if t.seg == "theme" { return theme_panel(t) }
    if t.seg == "notes" { return notes_panel(t) }
    format_panel(t)
}
// Pieces the panels share: a section, its heading, a field's label, a row of
// segments, a chip, a swatch, a toggle row.
fn heading(text){ Label{padding: 0 text: text draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 12}}} }
fn sublabel(text){ View{width: Fit height: Fit padding: Inset{top: 2} Label{padding: 0 text: text draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}} }
fn section_label(text){ View{width: Fit height: Fit padding: Inset{top: 4} Label{padding: 0 text: text draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 12.5}}}} }
fn hint(text){ Wrap{text: text draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11.5 line_spacing: 1.4}}} }
fn divider(){ SolidView{width: Fill height: 1 draw_bg.color: qd_line_soft} }
// One segment of a segmented row: an icon or a word, tinted when chosen.
fn seg_item(on, ic, text, act){
    GestureView{width: Fill height: Fill cursor: MouseCursor.Hand on_tap: |x, y| act()
        RoundedView{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} show_bg: true selected: on
            draw_bg +: {color: pick(on, qd_tint, qd_field) border_size: 1.0 border_color: pick(on, qd_accent, qd_field) border_radius: 3.0}
            if ic != "" { Ico{width: 18 height: 18 draw_svg +: {svg: icon(ic) color: pick(on, qd_accent, qd_icon)}} }
            if ic == "" { Label{padding: 0 text: text draw_text +: {color: pick(on, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 11.5}}} }
        }
    }
}
let SegRow = RoundedView{width: Fill height: 36 flow: Right padding: 2 spacing: 2 show_bg: true draw_bg +: {color: qd_field border_size: 1.0 border_color: qd_field_line border_radius: 5.0}}
let Chip = Flat{height: 30 padding: Inset{left: 11 right: 11} draw_text +: {text_style: theme.font_regular{font_size: 11}}}
fn chip(on, text, act){
    Chip{text: text
        draw_bg +: {color: pick(on, qd_tint, qd_field) color_hover: pick(on, qd_tint, qd_hover) border_size: 1.0 border_color: pick(on, qd_accent, qd_field_line) border_radius: 4.0}
        draw_text +: {color: pick(on, qd_link, qd_ink2) color_hover: pick(on, qd_link, qd_ink)}
        on_click: || act()}
}
fn swatch(hex, on, act){
    GestureView{width: 32 height: 32 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Hand on_tap: |x, y| act()
        RoundedView{width: 32 height: 32 align: Align{x: 0.5 y: 0.5} show_bg: true
            draw_bg +: {color: #x00000000 border_size: pick(on, 2.0, 0.0) border_color: qd_ink border_radius: 16.0}
            RoundedView{width: 24 height: 24 show_bg: true draw_bg +: {color: hex_color(hex, #x888888) border_size: 1.0 border_color: qd_thumb_line border_radius: 12.0}}
        }
    }
}
fn toggle_row(label, on, act){
    View{width: Fill height: 30 flow: Right align: Align{y: 0.5}
        Label{padding: 0 width: Fill text: label draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}
        QdToggle{active: on on_click: |active| act(active)}
    }
}

// Format: what the selection is decides what shows (BRIEF "The inspector's
// segments"); nothing chosen shows the slide's own settings.
fn format_panel(t){
    let sh = selected_shape(t)
    if t.sel.len() > 1 { return many_panel(t) }
    if sh == nil { return nothing_panel(t) }
    let kind = "" + optional(sh, "kind", "")
    View{width: Fill height: Fit flow: Down
        if kind == "placeholder" || kind == "textBox" {
            text_section(t, sh)
            divider()
            box_section(t)
            divider()
        }
        if kind == "shape" || kind == "connector" {
            shape_section(t, sh)
            divider()
        }
        if kind == "shape" {
            text_section(t, sh)
            divider()
        }
        if kind == "picture" {
            picture_section(t, sh)
            divider()
        }
        if kind == "table" {
            table_section(t, sh)
            divider()
        }
        if kind == "chart" {
            chart_section(t, sh)
            divider()
        }
        arrange_section(t, sh)
    }
}
fn nothing_panel(t){
    let s = slide_of(t, t.cur)
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
            heading("Slide " + (slide_index(t, t.cur) + 1))
            hint("Tap a text box, picture, shape, table or chart on the slide to format it. Double-tap a text box to type in it.")
            sublabel("Background")
            background_row(t)
        }
        divider()
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
            heading("This slide")
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
                Outline{height: 32 text: "Duplicate" icon_walk: Walk{width: 15 height: 15} draw_icon +: {svg: icon("duplicate")} on_click: || duplicate_slides(deck_tab())}
                Outline{height: 32 text: pick(s != nil && optional(s, "hidden", false), "Show", "Hide") icon_walk: Walk{width: 15 height: 15} draw_icon +: {svg: icon("eye-off")} on_click: || hide_slides(deck_tab())}
                Outline{height: 32 text: "Delete" icon_walk: Walk{width: 15 height: 15} draw_icon +: {svg: icon("trash")} on_click: || delete_slides(deck_tab())}
            }
        }
    }
}
fn many_panel(t){
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
        heading(plural(t.sel.len(), "object", "objects") + " chosen")
        hint("A long press on the slide adds an object to the choice, or takes it away.")
        sublabel("Align")
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
            for a in [{e: "left" l: "Left"}, {e: "center" l: "Centre"}, {e: "right" l: "Right"}, {e: "top" l: "Top"}, {e: "middle" l: "Middle"}, {e: "bottom" l: "Bottom"}] {
                chip(false, a.l, || shape_op(deck_tab(), {op: "align" edge: a.e to: "selection"}, "align them"))
            }
        }
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8 margin: Inset{top: 6}
            Outline{height: 32 text: "Group" on_click: || shape_op(deck_tab(), {op: "group"}, "group them")}
            Outline{height: 32 text: "Duplicate" on_click: || shape_op(deck_tab(), {op: "duplicate"}, "duplicate them")}
            Outline{height: 32 text: "Delete" on_click: || shape_op(deck_tab(), {op: "delete"}, "delete them")}
        }
    }
}
// Text (02-edit-text): font, size, B I U S, colour, alignment, lists, line
// spacing, and which paragraphs a change applies to.
fn text_section(t, sh){
    let fam = "" + fmt_value(t, "font", "")
    let size = fmt_value(t, "size", nil)
    let colour = hex_of(fmt_value(t, "color", ""))
    let al = align_name(fmt_value(t, "align", ""))
    let paras = optional(sh, "paragraphs", [])
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
        heading("Text")
        View{width: Fill height: 36 flow: Right align: Align{y: 0.5} spacing: 8
            GestureView{width: Fill height: 36 cursor: MouseCursor.Hand on_tap: |x, y| { let x2 = deck_tab() x2.font_open = !x2.font_open if x2.font_open { ask_fonts() } render_inspector() }
                RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 10 right: 8} show_bg: true
                    draw_bg +: {color: qd_field border_size: 1.0 border_color: pick(t.font_open, qd_accent, qd_field_line) border_radius: 5.0}
                    Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: pick(fam == "", "Font", fam) draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 12}}}
                    Ico{width: 14 height: 14 draw_svg +: {svg: icon(pick(t.font_open, "chevron-up", "chevron-down")) color: qd_icon}}
                }
            }
            Field{width: 72 height: 36 text: size_field(size) empty_text: "Size"
                on_return: |text| set_size_text(deck_tab(), text)}
            RoundedView{width: Fit height: 36 flow: Right align: Align{y: 0.5} show_bg: true draw_bg +: {color: qd_field border_size: 1.0 border_color: qd_field_line border_radius: 5.0}
                IconBtn{width: 34 height: 34 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("minus")} on_click: || { let x = deck_tab() apply_format(x, {size: size_step(fmt_value(x, "size", 18), -1)}, "change the size") }}
                SolidView{width: 1 height: Fill draw_bg.color: qd_field_line}
                IconBtn{width: 34 height: 34 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("plus")} on_click: || { let x = deck_tab() apply_format(x, {size: size_step(fmt_value(x, "size", 18), 1)}, "change the size") }}
            }
        }
        if t.font_open { font_list(t, fam) }
        View{width: Fill height: 34 flow: Right spacing: 8
            style_btn(t, "bold", "B", "")
            style_btn(t, "italic", "I", "")
            style_btn(t, "underline", "", "underline")
            style_btn(t, "strike", "", "strike")
        }
        sublabel("Colour")
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 4
            for hex in swatches_for(t) { swatch(hex, colour == hex_of(hex), || apply_format(deck_tab(), {color: hex}, "change the colour")) }
            IconBtn{width: 32 height: 32 icon_walk: Walk{width: 16 height: 16} draw_icon +: {svg: icon("plus") color: qd_icon}
                on_click: || { let x = deck_tab() x.custom_open = !x.custom_open render_inspector() }}
        }
        if t.custom_open {
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                Field{width: 140 text: t.custom_text empty_text: "#1B7FA6" on_change: |text| { deck_tab().custom_text = text }
                    on_return: |text| custom_colour(text)}
                Outline{height: 34 text: "Use" on_click: || custom_colour(deck_tab().custom_text)}
            }
        }
        sublabel("Alignment")
        SegRow{
            seg_item(al == "left", "align-left", "", || apply_format(deck_tab(), {align: "left"}, "align the text"))
            seg_item(al == "center", "align-center", "", || apply_format(deck_tab(), {align: "center"}, "align the text"))
            seg_item(al == "right", "align-right", "", || apply_format(deck_tab(), {align: "right"}, "align the text"))
            seg_item(al == "justify", "align-justify", "", || apply_format(deck_tab(), {align: "justify"}, "align the text"))
        }
        sublabel("Lists")
        View{width: Fill height: 36 flow: Right spacing: 8
            SegRow{width: Fill
                seg_item(fmt_value(t, "bullets", false) == true, "bullets", "", || { let x = deck_tab() apply_format(x, {bullets: !fmt_value(x, "bullets", false)}, "change the bullets") })
                seg_item(fmt_value(t, "numbering", false) == true, "numbering", "", || { let x = deck_tab() apply_format(x, {numbering: !fmt_value(x, "numbering", false)}, "change the numbering") })
            }
            SegRow{width: Fill
                seg_item(false, "outdent", "", || apply_format(deck_tab(), {level: -1}, "outdent the text"))
                seg_item(false, "indent", "", || apply_format(deck_tab(), {level: 1}, "indent the text"))
            }
        }
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6 margin: Inset{top: 4}
            Label{padding: 0 width: Fill text: "Line spacing" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}
            for v in SPACINGS { chip(abs(spacing_of(fmt_value(t, "line_spacing", nil)) - v) < 0.01, spacing_label(v), || apply_format(deck_tab(), {line_spacing: v}, "change the line spacing")) }
        }
        if paras.len() > 1 {
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                View{width: Fit height: 30 align: Align{y: 0.5} padding: Inset{right: 4}
                    Label{padding: 0 text: "Applies to" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}
                }
                chip(t.paragraphs == nil, "Whole box", || choose_paragraphs(nil))
                for i p in paras {
                    chip(t.paragraphs != nil && t.paragraphs[0] == i, "" + (i + 1), || choose_paragraphs([i, i]))
                }
            }
            if t.paragraphs != nil && t.paragraphs[0] < paras.len() {
                hint("Paragraph " + (t.paragraphs[0] + 1) + ": “" + short_text(optional(paras[t.paragraphs[0]], "text", ""), 34) + "”")
            }
        }
    }
}
fn spacing_label(v){ pick(floor(v) == v, "" + v + ".0", "" + v) }
fn size_field(size){
    if size == nil { return "" }
    "" + size + " pt"
}
fn short_text(s, n){
    let t = ("" + s).replace(regex("\\s+", "g"), " ").trim()
    let m = regex("^(.{0," + n + "})").exec(t)
    if m == nil { return t }
    let cut = m.captures[1]
    pick(cut.len() < t.len(), cut.trim() + "…", t)
}
fn choose_paragraphs(range){
    let t = deck_tab()
    t.paragraphs = range
    t.fmt_due = true
    render_inspector()
    pump()
}
fn custom_colour(text){
    let hex = hex_of(text)
    if hex == "" {
        note("Type a colour as six hex digits, like #1B7FA6.")
        return
    }
    let t = deck_tab()
    t.custom_open = false
    apply_format(t, {color: hex}, "change the colour")
}
fn style_btn(t, key, letter, ic){
    let on = fmt_value(t, key, false) == true
    GestureView{width: Fill height: 34 cursor: MouseCursor.Hand on_tap: |x, y| { let x2 = deck_tab() let args = {} args[key] = !fmt_value(x2, key, false) apply_format(x2, args, "change the text's style") }
        RoundedView{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} show_bg: true
            draw_bg +: {color: pick(on, qd_tint, qd_field) border_size: 1.0 border_color: pick(on, qd_accent, qd_field_line) border_radius: 4.0}
            if letter == "B" { Label{padding: 0 text: "B" draw_text +: {color: pick(on, qd_link, qd_ink) text_style: theme.font_bold{font_size: 13}}} }
            if letter == "I" { Label{padding: 0 text: "I" draw_text +: {color: pick(on, qd_link, qd_ink) text_style: theme.font_italic{font_size: 13}}} }
            if ic != "" { Ico{width: 18 height: 18 draw_svg +: {svg: icon(ic) color: pick(on, qd_link, qd_ink)}} }
        }
    }
}
// The families the engine draws (deck.fonts), as an inline list.
fn font_list(t, current){
    let fams = optional(st, "fonts", [])
    RoundedView{width: Fill height: 196 flow: Down show_bg: true draw_bg +: {color: qd_field border_size: 1.0 border_color: qd_field_line border_radius: 5.0}
        if fams.len() == 0 {
            View{width: Fill height: Fit padding: 12 Label{padding: 0 text: "Reading the fonts…" draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11.5}}}}
        }
        ScrollYView{width: Fill height: Fill flow: Down padding: 4
            for f in fams {
                GestureView{width: Fill height: 30 flow: Right align: Align{y: 0.5} padding: Inset{left: 10 right: 10} cursor: MouseCursor.Hand
                    on_tap: |x, y| { let x2 = deck_tab() x2.font_open = false apply_format(x2, {font: f}, "change the font") }
                    Label{padding: 0 width: Fill text: f draw_text +: {color: pick(f == current, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 12}}}
                    if f == current { Ico{width: 14 height: 14 draw_svg +: {svg: icon("check") color: qd_link}} }
                }
            }
        }
    }
}
// Box: shrink to fit and vertical alignment.
// Box: shrink to fit and vertical alignment, as the box draws them
// (deck.format_state's autofit and anchor; a change shows at once through
// apply_format, then format_state answers again).
fn box_section(t){
    let b = box_state(t.fmt)
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
        heading("Box")
        toggle_row("Shrink text when it overflows", b.shrink, |on| {
            apply_format(deck_tab(), {autofit: pick(on, "shrink", "none")}, "change the box")
        })
        sublabel("Vertical alignment")
        SegRow{width: 216
            seg_item(b.anchor == "top", "valign-top", "", || box_anchor("top"))
            seg_item(b.anchor == "middle", "valign-middle", "", || box_anchor("middle"))
            seg_item(b.anchor == "bottom", "valign-bottom", "", || box_anchor("bottom"))
        }
        if b.autofit == "resize" { hint("The box grows to fit its text.") }
        if b.anchor == "justified" || b.anchor == "distributed" { hint("Its text is spread over the box's height.") }
    }
}
fn box_anchor(a){ apply_format(deck_tab(), {anchor: a}, "align the box's text") }
// Shape: fill, outline, shadow.
fn shape_section(t, sh){
    let fill = hex_of(optional(sh, "fill", ""))
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
        heading("Shape")
        sublabel("Fill")
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} align: Align{y: 0.5} spacing: 4
            for hex in swatches_for(t) { swatch(hex, fill == hex_of(hex), || shape_op(deck_tab(), {op: "fill" color: hex}, "fill it")) }
            chip(optional(sh, "fill", "") == "none", "None", || shape_op(deck_tab(), {op: "fill" none: true}, "fill it"))
        }
        sublabel("Outline")
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} align: Align{y: 0.5} spacing: 4
            for hex in swatches_for(t) { swatch(hex, false, || shape_op(deck_tab(), {op: "line" color: hex}, "outline it")) }
            chip(false, "None", || shape_op(deck_tab(), {op: "line" none: true}, "outline it"))
        }
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
            Label{padding: 0 width: Fill text: "Width" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}}
            for w in [0.75, 1.5, 3, 6] { chip(false, "" + w + " pt", || shape_op(deck_tab(), {op: "line" width: w}, "outline it")) }
        }
        toggle_row("Shadow", optional(t, "shape_shadow", false), |on| {
            let x = deck_tab()
            x.shape_shadow = on
            shape_op(x, {op: "effects" shadow: on}, "change the shadow")
        })
    }
}
// Picture: replace, crop, corrections, reset, alt text.
fn picture_section(t, sh){
    let pic = optional(t, "pic", nil)
    if pic == nil || optional(pic, "id", nil) != sh.id {
        let p = optional(sh, "picture", {})
        pic = {id: sh.id brightness: optional(p, "brightness", 0) contrast: optional(p, "contrast", 0) saturation: optional(p, "saturation", 1)
            grayscale: optional(p, "grayscale", false) transparency: optional(p, "transparency", 0) replacing: false}
        t.pic = pic
    }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
        heading("Picture")
        View{width: Fill height: Fit flow: Right spacing: 8
            Outline{height: 32 text: "Replace…" on_click: || { let x = deck_tab() x.pic.replacing = !x.pic.replacing render_inspector() }}
            Outline{height: 32 text: "Reset" on_click: || { let x = deck_tab() x.pic = nil picture_op(x, {op: "reset"}, "reset the picture") }}
        }
        if pic.replacing {
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                for p in picture_list() { chip(false, p.name, || { let x = deck_tab() x.pic.replacing = false picture_op(x, {op: "replace" path: p.path}, "replace the picture") }) }
                Outline{height: 32 text: "From this device…" on_click: || picture_from_device()}
            }
        }
        adjust_row(t, "Brightness", "brightness")
        adjust_row(t, "Contrast", "contrast")
        adjust_row(t, "Saturation", "saturation")
        adjust_row(t, "Transparency", "transparency")
        toggle_row("Greyscale", pic.grayscale == true, |on| {
            let x = deck_tab()
            x.pic.grayscale = on
            picture_op(x, {op: "adjust" grayscale: on}, "change the picture")
        })
        sublabel("Crop")
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
            for c in [{k: "left" l: "Left"}, {k: "top" l: "Top"}, {k: "right" l: "Right"}, {k: "bottom" l: "Bottom"}] {
                chip(false, c.l + " 10%", || picture_op(deck_tab(), crop_args(c.k), "crop the picture"))
            }
        }
        sublabel("Alt text")
        Field{text: t.alt_text empty_text: "What the picture shows" on_change: |text| { deck_tab().alt_text = text }
            on_return: |text| picture_op(deck_tab(), {op: "alt_text" text: text}, "keep the alt text")}
    }
}
// Crop one side by a tenth (picture.crop takes each side's share).
fn crop_args(side){
    {op: "crop" left: pick(side == "left", 0.1, 0) top: pick(side == "top", 0.1, 0) right: pick(side == "right", 0.1, 0) bottom: pick(side == "bottom", 0.1, 0)}
}
fn adjust_row(t, label, key){
    let v = optional(t.pic, key, pick(key == "saturation", 1, 0))
    View{width: Fill height: 34 flow: Right align: Align{y: 0.5} spacing: 8
        Label{padding: 0 width: Fill text: label draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}}
        stepper("" + round(v * 100) + "%", || adjust(key, -0.1), || adjust(key, 0.1))
    }
}
fn adjust(key, delta){
    let t = deck_tab()
    // Brightness and contrast -1 to 1 (0 as it is), saturation 0 to 2 here
    // (the service takes up to 4; 1 as it is), transparency 0 to 1.
    let lo = pick(key == "transparency" || key == "saturation", 0, -1)
    let hi = pick(key == "saturation", 2, 1)
    let v = clamp(round((optional(t.pic, key, pick(key == "saturation", 1, 0)) + delta) * 10) / 10, lo, hi)
    if key == "brightness" { t.pic.brightness = v }
    if key == "contrast" { t.pic.contrast = v }
    if key == "saturation" { t.pic.saturation = v }
    if key == "transparency" { t.pic.transparency = v }
    let args = {op: "adjust"}
    args[key] = v
    render_inspector()
    picture_op(t, args, "change the picture")
}
// Table: style, options, its cells, rows and columns, cell fill.
fn table_section(t, sh){
    let tb = optional(sh, "table", {})
    let rows = optional(tb, "rows", 0)
    let cols = optional(tb, "cols", 0)
    let cells = optional(tb, "cells", [])
    let style = "" + optional(tb, "style", "")
    let r0 = min(t.cell[0], max(0, rows - 1))
    let c0 = min(t.cell[1], max(0, cols - 1))
    let o = table_options(tb, optional(t, "tb_pending", {}))
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
        heading("Table")
        sublabel("Style")
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
            for s in TABLE_STYLES { chip(style == s.id, s.label, || table_op(deck_tab(), {op: "style" style: s.id}, "change the table's style")) }
        }
        sublabel("Options")
        toggle_row("Header row", o.header_row, |on| table_option(deck_tab(), "header_row", on))
        toggle_row("Total row", o.total_row, |on| table_option(deck_tab(), "total_row", on))
        toggle_row("Banded rows", o.banded_rows, |on| table_option(deck_tab(), "banded_rows", on))
        toggle_row("First column", o.first_column, |on| table_option(deck_tab(), "first_column", on))
        toggle_row("Last column", o.last_column, |on| table_option(deck_tab(), "last_column", on))
        toggle_row("Banded columns", o.banded_columns, |on| table_option(deck_tab(), "banded_columns", on))
        sublabel("Cells")
        RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: qd_field border_size: 1.0 border_color: qd_field_line border_radius: 4.0}
            for r in min(rows, 10) {
                View{width: Fill height: 32 flow: Right
                    for c in min(cols, 6) {
                        cell_field(t, r, c, "" + optional(optional(cells, r, []), c, ""), r == r0 && c == c0)
                    }
                }
            }
        }
        if rows > 10 || cols > 6 { hint("The first 10 rows and 6 columns show here; the slide has them all.") }
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
            Label{padding: 0 text: "Row " + (r0 + 1) draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}}
            Gap{}
            chip(false, "Above", || table_op(deck_tab(), {op: "insert_row" row: r0 below: false}, "insert a row"))
            chip(false, "Below", || table_op(deck_tab(), {op: "insert_row" row: r0 below: true}, "insert a row"))
            chip(false, "Delete", || table_op(deck_tab(), {op: "delete_row" row: r0}, "delete the row"))
        }
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
            Label{padding: 0 text: "Column " + (c0 + 1) draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}}
            Gap{}
            chip(false, "Left", || table_op(deck_tab(), {op: "insert_col" col: c0 right: false}, "insert a column"))
            chip(false, "Right", || table_op(deck_tab(), {op: "insert_col" col: c0 right: true}, "insert a column"))
            chip(false, "Delete", || table_op(deck_tab(), {op: "delete_col" col: c0}, "delete the column"))
        }
        View{width: Fill height: Fit flow: Right spacing: 6
            chip(false, "Merge with the next cell", || table_op(deck_tab(), {op: "merge" from: [r0, c0] to: [r0, min(cols - 1, c0 + 1)]}, "merge the cells"))
            chip(false, "Split", || table_op(deck_tab(), {op: "split" cell: [r0, c0]}, "split the cell"))
        }
        sublabel("Cell fill")
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 4
            for hex in swatches_for(t) { swatch(hex, false, || table_op(deck_tab(), {op: "fill" cells: [[r0, c0]] color: hex}, "fill the cell")) }
        }
    }
}
// A table option: shown at once, the table's own once deck.slide answers.
fn table_option(t, key, on){
    let p = optional(t, "tb_pending", {})
    let args = {op: "options"}
    if key == "header_row" {
        p.header_row = on
        args.header_row = on
    }
    if key == "total_row" {
        p.total_row = on
        args.total_row = on
    }
    if key == "banded_rows" {
        p.banded_rows = on
        args.banded_rows = on
    }
    if key == "first_column" {
        p.first_column = on
        args.first_column = on
    }
    if key == "last_column" {
        p.last_column = on
        args.last_column = on
    }
    if key == "banded_columns" {
        p.banded_columns = on
        args.banded_columns = on
    }
    t.tb_pending = p
    render_inspector()
    table_op(t, args, "change the table")
}
// A table cell's field: its text goes in when the person presses Return or
// pauses; choosing it makes it the row and column the buttons act on.
fn cell_field(t, r, c, text, on){
    RoundedView{width: Fill height: Fill flow: Overlay show_bg: true draw_bg +: {color: pick(on, qd_tint, #x00000000) border_size: 0.5 border_color: qd_field_line border_radius: 0.0}
        TextInput{width: Fill height: Fill padding: Inset{left: 6 right: 4 top: 8 bottom: 6} text: text
            on_change: |s| { let x = deck_tab() x.cell = [r, c] x.cell_seq = optional(x, "cell_seq", 0) + 1 let seq = x.cell_seq start_timeout(1.0, || { if optional(x, "cell_seq", 0) == seq { cell_typed(x, r, c, s) } }) }
            on_return: |s| { let x = deck_tab() x.cell_seq = optional(x, "cell_seq", 0) + 1 cell_typed(x, r, c, s) render_inspector() }
            draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000
                border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: qd_accent border_color_empty: #x00000000 border_size: 0.0}
            draw_text +: {color: qd_ink color_hover: qd_ink color_focus: qd_ink color_empty: qd_faint text_style: theme.font_regular{font_size: 11}}
            draw_selection.color: #x557dcc55}
    }
}
// Chart (03-chart): type, the data grid, elements, colours.
fn chart_section(t, sh){
    let ch = optional(sh, "chart", {})
    let kind = chart_id(optional(ch, "type", "column"))
    let g = chart_grid(t)
    // What deck.slide reports of the chart, or a change on its way.
    let cs = chart_state(ch, optional(t, "chart_pending", {}))
    let c = swatches_for(t)
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
        heading("Chart")
        sublabel("Type")
        View{width: Fill height: 40 flow: Right spacing: 4
            for ct in CHARTS {
                GestureView{width: 40 height: 40 cursor: MouseCursor.Hand on_tap: |x, y| chart_op(deck_tab(), {type: ct.id}, "change the chart type")
                    RoundedView{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} show_bg: true
                        draw_bg +: {color: pick(kind == ct.id, qd_tint, #x00000000) border_size: pick(kind == ct.id, 1.0, 0.0) border_color: qd_accent border_radius: 5.0}
                        Ico{width: 22 height: 22 draw_svg +: {svg: icon("chart-" + ct.id) color: pick(kind == ct.id, qd_link, qd_icon)}}
                    }
                }
            }
        }
        sublabel("Data")
        if g != nil { data_grid(t, g) }
        View{width: Fill height: Fit flow: Right spacing: 8
            LinkBtn{text: "Row" icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("plus")} on_click: || grid_add_row(deck_tab())}
            LinkBtn{text: "Series" icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("plus")} on_click: || grid_add_series(deck_tab())}
        }
        divider()
        heading("Elements")
        toggle_row("Title", cs.title, |on| chart_flag(deck_tab(), "title", on))
        toggle_row("Legend", cs.legend, |on| chart_flag(deck_tab(), "legend", on))
        toggle_row("Data labels", cs.data_labels, |on| chart_flag(deck_tab(), "data_labels", on))
        toggle_row("Gridlines", cs.gridlines, |on| chart_flag(deck_tab(), "gridlines", on))
        divider()
        heading("Colours")
        View{width: Fill height: Fit flow: Right spacing: 8
            palette_chip(!cs.mono, [c[1], c[2], c[3], c[4]], || chart_flag(deck_tab(), "palette", "colorful1"))
            palette_chip(cs.mono, [c[1], c[1], c[1], c[1]], || chart_flag(deck_tab(), "palette", "monochrome1"))
        }
    }
}
fn palette_chip(on, colours, act){
    GestureView{width: 74 height: 30 cursor: MouseCursor.Hand on_tap: |x, y| act()
        RoundedView{width: Fill height: Fill flow: Right align: Align{x: 0.5 y: 0.5} padding: 4 spacing: 0 show_bg: true selected: on
            draw_bg +: {color: qd_field border_size: pick(on, 2.0, 1.0) border_color: pick(on, qd_accent, qd_field_line) border_radius: 5.0}
            for i hex in colours { RoundedView{width: 16 height: 18 show_bg: true draw_bg +: {color: mix(hex_color(hex, #x888888), #xffffff, i * 0.18) border_radius: 1.0}} }
        }
    }
}
// A chart element or palette: shown at once, the chart's own once deck.slide
// answers. An empty title takes the title away (SERVICE.md deck.chart).
fn chart_flag(t, key, value){
    let sh = selected_shape(t)
    if sh == nil { return }
    let p = optional(t, "chart_pending", {})
    let args = {}
    if key == "title" {
        let ch = optional(sh, "chart", {})
        let had = "" + optional(ch, "title", "")
        p.title = value
        args.title = pick(value, pick(had == "", "Chart Title", had), "")
    }
    if key == "legend" {
        p.legend = pick(value, "b", "none")
        args.legend = p.legend
    }
    if key == "data_labels" {
        p.data_labels = value
        args.data_labels = value
    }
    if key == "gridlines" {
        p.gridlines = value
        args.gridlines = value
    }
    if key == "palette" {
        p.palette = value
        args.palette = value
    }
    t.chart_pending = p
    render_inspector()
    chart_op(t, args, "change the chart")
}
// The data grid: categories down, a column per series; a cell's text goes in
// when the person pauses or presses Return.
fn data_grid(t, g){
    RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: qd_field border_size: 1.0 border_color: qd_field_line border_radius: 4.0}
        View{width: Fill height: 34 flow: Right
            grid_cell("", false, -1, -1, true)
            for c s in g.series { grid_cell(s.name, true, -1, c, true) }
        }
        for r cat in g.categories {
            View{width: Fill height: 34 flow: Right
                grid_cell(cat, false, r, -1, false)
                for c s in g.series { grid_cell("" + optional(s.values, r, ""), true, r, c, false) }
            }
        }
    }
}
fn grid_cell(text, number, r, c, head){
    RoundedView{width: Fill height: Fill flow: Overlay show_bg: true draw_bg +: {color: pick(head, qd_hover, #x00000000) border_size: 0.5 border_color: qd_field_line border_radius: 0.0}
        if r == -1 && c == -1 {
            View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} Label{padding: 0 text: "" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}}
        }
        if !(r == -1 && c == -1) {
            TextInput{width: Fill height: Fill padding: Inset{left: 8 right: 6 top: 9 bottom: 7} text: text
                on_change: |s| grid_typed(deck_tab(), r, c, s)
                on_return: |s| { let x = deck_tab() x.grid_seq = optional(x, "grid_seq", 0) + 1 send_grid(x) }
                draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000
                    border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: qd_accent border_color_empty: #x00000000 border_size: 0.0}
                draw_text +: {color: qd_ink color_hover: qd_ink color_focus: qd_ink color_empty: qd_faint text_style: theme.font_regular{font_size: 11.5}}
                draw_selection.color: #x557dcc55}
        }
    }
}
// Arrange, under every kind: X, Y, W, H, rotation, order, duplicate, delete.
fn arrange_section(t, sh){
    let b = sh.box
    let rot = round(optional(sh, "rotation", 0))
    let open = optional(t, "arrange_open", true)
    View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 10 bottom: 14} spacing: 8
        GestureView{width: Fill height: 24 flow: Right align: Align{y: 0.5} cursor: MouseCursor.Hand on_tap: |x, y| { let x2 = deck_tab() x2.arrange_open = !optional(x2, "arrange_open", true) render_inspector() }
            Label{padding: 0 width: Fill text: "Arrange" draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 12}}}
            Ico{width: 14 height: 14 draw_svg +: {svg: icon(pick(open, "chevron-down", "chevron-right")) color: qd_icon}}
        }
        if open {
            View{width: Fill height: 36 flow: Right align: Align{y: 0.5} spacing: 10
                box_field("X", "x", b[0])
                box_field("Y", "y", b[1])
            }
            View{width: Fill height: 36 flow: Right align: Align{y: 0.5} spacing: 10
                box_field("W", "w", b[2])
                box_field("H", "h", b[3])
            }
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                Label{padding: 0 width: Fill text: "Rotation" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}
                for r in ROTATIONS { chip(rot == r, "" + r + "°", || shape_op(deck_tab(), {op: "rotate" deg: r}, "rotate it")) }
            }
            View{width: Fill height: 34 flow: Right spacing: 10
                Outline{width: Fill height: 34 text: "Bring to front" on_click: || shape_op(deck_tab(), {op: "order" to: "front"}, "bring it to the front")}
                Outline{width: Fill height: 34 text: "Send to back" on_click: || shape_op(deck_tab(), {op: "order" to: "back"}, "send it to the back")}
            }
            View{width: Fill height: 34 flow: Right spacing: 10
                Outline{width: Fill height: 34 text: "Duplicate" icon_walk: Walk{width: 15 height: 15} draw_icon +: {svg: icon("duplicate")} on_click: || shape_op(deck_tab(), {op: "duplicate"}, "duplicate it")}
                Outline{width: Fill height: 34 text: "Delete" icon_walk: Walk{width: 15 height: 15} draw_icon +: {svg: icon("trash")} on_click: || shape_op(deck_tab(), {op: "delete"}, "delete it")}
            }
            if optional(sh, "kind", "") == "group" {
                Outline{height: 32 text: "Ungroup" on_click: || shape_op(deck_tab(), {op: "ungroup"}, "ungroup it")}
            }
        }
    }
}
fn box_field(label, key, value){
    View{width: Fill height: 36 flow: Right align: Align{y: 0.5} spacing: 8
        View{width: 16 height: Fit Label{padding: 0 text: label draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11.5}}}}
        Field{width: Fill text: "" + round(value) + " pt" on_return: |text| set_bounds_text(deck_tab(), key, text)}
    }
}
fn background_row(t){
    SegRow{
        seg_item(t.bg_kind == "theme", "", "Theme", || set_background(deck_tab(), "theme"))
        seg_item(t.bg_kind == "colour", "", "Colour", || set_background(deck_tab(), "colour"))
        seg_item(t.bg_kind == "gradient", "", "Gradient", || set_background(deck_tab(), "gradient"))
    }
}
// Layout (04-layout): the eleven layouts, background, transition, skip.
fn layout_panel(t){
    let s = slide_of(t, t.cur)
    let current = "" + optional(s, "layout", "")
    let kind = "" + optional(s, "transition", "none")
    if kind == "" { kind = "none" }
    let hidden = optional(s, "hidden", false)
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
            heading("Slide layout")
            if t.layouts.len() == 0 { hint("Reading the layouts…") }
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 8
                for l in t.layouts { layout_card(t, l, ("" + l.id) == current || ("" + l.name) == current) }
            }
        }
        divider()
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
            heading("Background")
            background_row(t)
            if t.bg_kind == "colour" {
                View{width: Fill height: Fit flow: Right spacing: 4
                    for hex in swatches_for(t) { swatch(hex, false, || background_colour(deck_tab(), hex)) }
                }
            }
            LinkBtn{text: "Apply to all slides" on_click: || background_all(deck_tab())}
        }
        divider()
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
            heading("Transition")
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                for tr in TRANSITIONS { chip(kind == tr.id, tr.label, || set_transition(deck_tab(), tr.id, false)) }
            }
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
                Label{padding: 0 width: 70 text: "Duration" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}}
                stepper("" + floor(transition_ms_of(t) / 100) / 10 + " s", || step_duration(deck_tab(), -1), || step_duration(deck_tab(), 1))
            }
            LinkBtn{text: "Apply to all slides" on_click: || { let x = deck_tab() set_transition(x, kind, true) }}
            hint("Quick Deck shows each slide's end state when you present: transitions and builds don't play here.")
        }
        divider()
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 24} spacing: 12
            toggle_row("Skip this slide in the show", hidden, |on| skip_slide(deck_tab(), on))
            Outline{height: 34 text: "Reset slide" on_click: || reset_slide(deck_tab())}
        }
    }
}
fn layout_card(t, l, on){
    let src = optional(t.layout_pics, "l" + l.id, nil)
    let lw = floor((INSP_W - 32 - 16) / 3)
    let lh = round(lw * t.size[1] / max(1, t.size[0]))
    GestureView{width: lw height: Fit flow: Down align: Align{x: 0.5} spacing: 5 cursor: MouseCursor.Hand on_tap: |x, y| set_layout(deck_tab(), l.id)
        RoundedView{width: lw height: lh + 4 padding: 1 show_bg: true
            draw_bg +: {color: #xffffff border_size: pick(on, 2.0, 1.0) border_color: pick(on, qd_accent, qd_thumb_line) border_radius: 3.0}
            if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
        }
        Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} align: Align{x: 0.5} text: "" + l.name draw_text +: {color: pick(on, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 10.5 line_spacing: 1.2}}}
    }
}
// Theme (05-theme): the engine's themes, colour variants, font pairs, slide
// size and footer.
fn theme_panel(t){
    let schemes = []
    let fonts = []
    if st.themes != nil {
        schemes = optional(st.themes, "color_schemes", [])
        fonts = optional(st.themes, "font_schemes", [])
    }
    let wide = t.size[0] / max(1, t.size[1]) > 1.5
    // The deck's footer (deck.open, deck.state), or a change on its way.
    let fs = footer_state(t.footer, optional(t, "footer_pending", {}))
    let missing = missing_now(t)
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
            heading("Themes")
            if theme_list().len() == 0 { hint(pick(st.engine == "ok", "Reading the themes…", engine_headline() + ".")) }
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                for th in theme_list() { theme_card(th, th.name == t.theme, 96, 54, || design(deck_tab(), {theme: th.name}, "change the theme")) }
            }
        }
        divider()
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 12 bottom: 14} spacing: 8
            heading("Colours")
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 6
                for sc in schemes { scheme_card(t, sc) }
            }
            if schemes.len() > 0 && !scheme_listed(schemes, current_colors(t)) { hint("This deck's own colours: " + current_colors(t) + ". Pick a set to use one of these instead.") }
        }
        divider()
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 16 bottom: 18} spacing: 6
            heading("Fonts")
            if missing.len() > 0 { hint("Drawn with similar fonts on this device: " + list_text(missing) + ".") }
            for f in fonts { font_row(t, f) }
            if fonts.len() > 0 && current_fonts(t) == "" && ("" + optional(t, "font_scheme", "")) != "" { hint("This deck's own fonts: " + t.font_scheme + ".") }
        }
        divider()
        View{width: Fill height: Fit flow: Right padding: Inset{left: 16 right: 16 top: 16 bottom: 24} spacing: 16
            View{width: 140 height: Fit flow: Down spacing: 10
                heading("Slide size")
                SegRow{width: 140
                    seg_item(wide, "", "16:9", || design(deck_tab(), {size: "16:9"}, "change the slide size"))
                    seg_item(!wide, "", "4:3", || design(deck_tab(), {size: "4:3"}, "change the slide size"))
                }
            }
            View{width: Fill height: Fit flow: Down spacing: 4
                heading("Footer")
                toggle_row("Slide numbers", fs.slide_numbers, |on| footer(deck_tab(), "slide_numbers", on))
                toggle_row("Date", fs.date, |on| footer(deck_tab(), "date", on))
                Field{height: 32 text: fs.footer_text empty_text: "Footer text"
                    on_return: |text| { let x = deck_tab() footer(x, "footer_text", text) }}
            }
        }
    }
}
// A theme as a card drawn from its own colours: its light 1 ground, "Title" in
// its dark 2, a rule in its accent 1 (01-home's row, 05-theme, 07-outline).
fn theme_card(th, on, w, h, act){
    let c = theme_colors(th)
    let ground = hex_color(slot(c, 1, "#ffffff"), #xffffff)
    let ink = hex_color(slot(c, 2, "#1e2b3c"), #x1e2b3c)
    let rule = hex_color(slot(c, 4, "#2e6fd8"), #x2e6fd8)
    GestureView{width: w + 4 height: Fit flow: Down align: Align{x: 0.5} spacing: 5 cursor: MouseCursor.Hand on_tap: |x, y| act()
        RoundedView{width: w + 4 height: h + 4 padding: 2 flow: Overlay show_bg: true selected: on
            draw_bg +: {color: #x00000000 border_size: pick(on, 2.0, 0.0) border_color: qd_accent border_radius: 6.0}
            RoundedView{width: w height: h flow: Down align: Align{x: 0.5 y: 0.5} spacing: 3 show_bg: true
                draw_bg +: {color: ground border_size: 1.0 border_color: qd_thumb_line border_radius: 4.0}
                Label{padding: 0 text: "Title" draw_text +: {color: ink text_style: theme.font_bold{font_size: max(9, h * 0.22)}}}
                SolidView{width: w * 0.55 height: max(1.5, h * 0.035) draw_bg.color: rule}
            }
            if on {
                View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0} padding: 5
                    RoundedView{width: 18 height: 18 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: qd_accent border_size: 1.5 border_color: #xffffff border_radius: 9.0}
                        Ico{width: 11 height: 11 draw_svg +: {svg: icon("check") color: #xffffff}}
                    }
                }
            }
        }
        Label{padding: 0 text: theme_label(th.name) draw_text +: {color: pick(on, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 11.5}}}
    }
}
// A colour set: its dark 2 and accents 1-4 as dots, its name below
// (deck.themes gives each set's twelve colours; an older service gave names
// only, and then a set shows its theme's colours, or its name alone).
fn scheme_colors(sc){
    let c = optional(sc, "colors", nil)
    if c != nil { return c }
    theme_colors(theme_named("" + sc))
}
fn scheme_name(sc){
    let n = optional(sc, "name", nil)
    if n != nil { return "" + n }
    "" + sc
}
// The deck's colour set and font pair (deck.open, deck.state), or one just
// picked and on its way.
fn current_colors(t){ scheme_mark(optional(t, "colors", ""), optional(t, "color_scheme", ""), t.theme) }
fn current_fonts(t){
    let th = theme_named("" + t.theme)
    let pairs = []
    if st.themes != nil { pairs = optional(st.themes, "font_schemes", []) }
    font_mark(optional(t, "fonts", ""), optional(t, "font_scheme", ""), pairs, optional(th, "major", ""), optional(th, "minor", ""))
}
fn scheme_card(t, sc){
    let name = scheme_name(sc)
    let c = scheme_colors(sc)
    let on = current_colors(t) == name
    GestureView{width: floor((INSP_W - 32 - 12) / 3) height: 50 cursor: MouseCursor.Hand on_tap: |x, y| { let x2 = deck_tab() x2.colors = name design(x2, {colors: name}, "change the colours") }
        RoundedView{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 5 show_bg: true selected: on
            draw_bg +: {color: qd_field border_size: pick(on, 2.0, 1.0) border_color: pick(on, qd_accent, qd_field_line) border_radius: 5.0}
            if c.len() >= 9 {
                View{width: Fit height: Fit flow: Right spacing: 4
                    for i in [2, 4, 5, 6, 7] { RoundedView{width: 13 height: 13 show_bg: true draw_bg +: {color: hex_color("" + c[i], #x888888) border_radius: 6.5}} }
                }
            }
            Label{padding: 0 text: theme_label(name) draw_text +: {color: pick(on, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 10.5}}}
        }
    }
}
fn scheme_listed(schemes, name){
    for sc in schemes { if scheme_name(sc) == name { return true } }
    false
}
fn list_text(items){
    let out = ""
    for i x in items { if i < 5 { out = out + pick(i == 0, "", ", ") + x } }
    if items.len() > 5 { out = out + "…" }
    out
}
fn font_row(t, f){
    let name = "" + optional(f, "name", "")
    let on = current_fonts(t) == name
    GestureView{width: Fill height: 38 cursor: MouseCursor.Hand on_tap: |x, y| { let x2 = deck_tab() x2.fonts = name design(x2, {fonts: name}, "change the fonts") }
        RoundedView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 12 right: 10} spacing: 8 show_bg: true selected: on
            draw_bg +: {color: qd_field border_size: pick(on, 2.0, 1.0) border_color: pick(on, qd_accent, qd_field_line) border_radius: 5.0}
            Label{padding: 0 width: 118 max_lines: 1 text_overflow: TextOverflow.Ellipsis text: name draw_text +: {color: pick(on, qd_link, qd_ink) text_style: theme.font_regular{font_size: 12.5}}}
            Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: "" + optional(f, "major", "") + " / " + optional(f, "minor", "") draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11}}}
            if on { Ico{width: 16 height: 16 draw_svg +: {svg: icon("check") color: qd_link}} }
        }
    }
}
// Notes (10-dark-notes): the slide's speaker notes, their length, and
// whether Present shows them.
// deck.slides' notes are a preview of at most 200 characters (SERVICE.md "As
// built in #503"): the whole notes come with the slide (deck.slide), and the
// field waits for them.
fn full_notes(t){
    if t.detail == nil || t.detail_for != t.cur { return nil }
    "" + optional(t.detail, "notes", "")
}
fn notes_panel(t){
    let text = full_notes(t)
    t.notes_for = pick(text == nil, nil, t.cur)
    let h = max(180, st.height - TAB_H - BAR_H - SEG_H - STATUS_H - 190)
    if text == nil {
        return View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 18 bottom: 18} spacing: 10
            heading("Speaker notes")
            hint("Reading the notes…")
        }
    }
    View{width: Fill height: Fit flow: Down
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 18 bottom: 18} spacing: 10
            heading("Speaker notes")
            RoundedView{width: Fill height: h flow: Down show_bg: true draw_bg +: {color: qd_field border_size: 1.0 border_color: qd_field_line border_radius: 5.0}
                TextInput{width: Fill height: Fill padding: Inset{left: 12 right: 12 top: 12 bottom: 8} is_multiline: true text: text empty_text: "Type what you'll say for this slide"
                    on_change: |s2| notes_typed(deck_tab(), s2)
                    draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000
                        border_color: #x00000000 border_color_hover: #x00000000 border_color_focus: #x00000000 border_color_empty: #x00000000 border_size: 0.0}
                    draw_text +: {color: qd_ink color_hover: qd_ink color_focus: qd_ink color_empty: qd_faint color_empty_hover: qd_faint color_empty_focus: qd_faint text_style: theme.font_regular{font_size: 12.5 line_spacing: 1.45}}
                    draw_selection.color: #x557dcc55}
                View{width: Fill height: Fit padding: Inset{left: 12 right: 12 bottom: 10}
                    notes_meta := Label{padding: 0 text: notes_meta(text) draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11}}}
                }
            }
        }
        divider()
        View{width: Fill height: Fit flow: Down padding: Inset{left: 16 right: 16 top: 14 bottom: 20}
            toggle_row("Show notes while presenting", st.show_notes, |on| {
                st.show_notes = on
                save_index()
            })
        }
    }
}

// ---- the sorter (06-sorter) ----------------------------------------------------

fn sorter_strip_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let n = chosen_slides(t).len()
    let all_hidden = n > 0
    for id in chosen_slides(t) { if !optional(slide_of(t, id), "hidden", false) { all_hidden = false } }
    let hint = "Drag slides to reorder"
    if t.sorter_drag != nil {
        hint = "Drop to move slide " + (slide_index(t, t.sorter_drag.id) + 1) + " to position " + (t.sorter_drag.to + 1)
    }
    View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 24 right: 26} spacing: 8
        View{width: 96 height: Fit Label{padding: 0 text: pick(n == 0, "None selected", "" + n + " selected") draw_text +: {color: pick(n == 0, qd_muted, qd_ink2) text_style: theme.font_regular{font_size: 12.5}}}}
        SolidView{width: 1 height: 26 margin: Inset{right: 10} draw_bg.color: qd_line}
        Flat{text: "New slide" icon_walk: Walk{width: 19 height: 19} draw_icon +: {svg: icon("new-slide")} on_click: || new_slide(deck_tab())}
        Flat{text: "Duplicate" icon_walk: Walk{width: 19 height: 19} draw_icon +: {svg: icon("duplicate")} on_click: || duplicate_slides(deck_tab())}
        Flat{text: "Delete" icon_walk: Walk{width: 19 height: 19} draw_icon +: {svg: icon("trash")} on_click: || delete_slides(deck_tab())}
        Flat{text: pick(all_hidden, "Show", "Hide") icon_walk: Walk{width: 19 height: 19} draw_icon +: {svg: icon("eye-off")} on_click: || hide_slides(deck_tab())}
        Flat{text: "Move earlier" icon_walk: Walk{width: 19 height: 19} draw_icon +: {svg: icon("arrow-up")} on_click: || move_slides(deck_tab(), -1)}
        Flat{text: "Move later" icon_walk: Walk{width: 19 height: 19} draw_icon +: {svg: icon("arrow-down")} on_click: || move_slides(deck_tab(), 1)}
        Flat{text: "Section" icon_walk: Walk{width: 19 height: 19} draw_icon +: {svg: icon("section")} on_click: || add_section(deck_tab())}
        Gap{}
        if st.width >= 1240 || t.sorter_drag != nil {
            Label{padding: 0 text: hint draw_text +: {color: pick(t.sorter_drag != nil, qd_link, qd_muted) text_style: theme.font_regular{font_size: 12}}}
        }
    }
}
fn sorter_view(){
    let t = deck_tab()
    if t == nil || t.state != "ready" { return View{width: Fill height: 1} }
    let n = t.slides.len()
    let first = t.sorter_start
    let last = min(n, first + SORTER_WINDOW)
    let cols = sorter_cols()
    // The window's slides in runs that share a section.
    let runs = []
    let run = nil
    for i in last - first {
        let k = first + i
        let sec = section_of(t, k)
        if run == nil || run.sec != sec {
            run = {sec: sec items: []}
            runs.push(run)
        }
        run.items.push(k)
    }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 24 right: 24 top: 14 bottom: 40} spacing: 14
        if first > 0 {
            LinkBtn{text: "‹ Slides 1–" + first on_click: || { let x = deck_tab() x.sorter_start = max(0, x.sorter_start - SORTER_WINDOW) render_sorter() pump() }}
        }
        for r in runs { sorter_run(t, r, cols) }
        if last < n {
            LinkBtn{text: "Slides " + (last + 1) + "–" + n + " ›" on_click: || { let x = deck_tab() x.sorter_start = x.sorter_start + SORTER_WINDOW render_sorter() pump() }}
        }
    }
}
fn sorter_run(t, run, cols){
    let rows = ceil(run.items.len() / cols)
    let s = nil
    if run.sec >= 0 && run.sec < t.sections.len() { s = t.sections[run.sec] }
    View{width: Fill height: Fit flow: Down spacing: 12
        if s != nil { sorter_head(t, run.sec, s) }
        for r in rows {
            View{width: Fit height: Fit flow: Right spacing: 22
                for c in cols {
                    if r * cols + c < run.items.len() { tile_view(t, run.items[r * cols + c]) }
                }
            }
        }
    }
}
fn sorter_head(t, k, s){
    let name = "" + optional(s, "name", "")
    if t.renaming == k {
        return View{width: Fill height: 34 flow: Right align: Align{y: 0.5} spacing: 8
            Field{width: 260 height: 32 text: name empty_text: "Section name" on_change: |text| { deck_tab().rename_text = text } on_return: |text| rename_section(deck_tab(), k, text)}
            Outline{height: 32 text: "Rename" on_click: || { let x = deck_tab() rename_section(x, k, x.rename_text) }}
            Outline{height: 32 text: "Cancel" on_click: || { let x = deck_tab() x.renaming = -1 render_sorter() }}
        }
    }
    View{width: Fill height: 30 flow: Right align: Align{y: 0.5} spacing: 4
        GestureView{width: Fit height: Fill flow: Right align: Align{y: 0.5} cursor: MouseCursor.Hand on_tap: |x, y| { let x2 = deck_tab() x2.renaming = k x2.rename_text = name render_sorter() }
            Label{padding: 0 text: pick(name == "", "Untitled section", name) draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 13}}}
            View{width: Fit height: Fit padding: Inset{left: 6 top: 2} Label{padding: 0 text: "·  " + plural(optional(s, "count", 0), "slide", "slides") draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11}}}}
        }
        IconBtn{width: 26 height: 26 icon_walk: Walk{width: 12 height: 12} draw_icon +: {svg: icon("close") color: qd_faint} on_click: || remove_section(deck_tab(), k)}
    }
}
fn tile_view(t, i){
    let s = t.slides[i]
    let w = TILE_W
    let h = round(w * t.size[1] / max(1, t.size[0]))
    let on = has(t.sorter_sel, s.id)
    let src = optional(t.tiles, "s" + s.id, nil)
    let hidden = optional(s, "hidden", false)
    GestureView{width: w + 6 height: Fit flow: Down spacing: 8 cursor: MouseCursor.Hand
        on_tap: |x, y| toggle_tile(deck_tab(), s.id)
        on_double_tap: |x, y| { let x2 = deck_tab() x2.cur = s.id set_view(x2, "slides") go_slide(x2, s.id) }
        on_pan: |dx, dy, phase| tile_pan(deck_tab(), s.id, dx, dy, phase)
        RoundedView{width: w + 6 height: h + 6 padding: 2 flow: Overlay show_bg: true
            draw_bg +: {color: #x00000000 border_size: pick(on, 2.0, 0.0) border_color: qd_accent border_radius: 4.0}
            RectShadowView{width: w height: h margin: 1 flow: Overlay draw_bg +: {color: pick(src == nil, qd_line_soft, #xffffff) shadow_color: qd_shadow shadow_radius: 4.0 shadow_offset: vec2(0.0, 1.0)}
                if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
                if src == nil { View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} Label{padding: 0 text: "" + (i + 1) draw_text +: {color: qd_faint text_style: theme.font_bold{font_size: 24}}}} }
                if hidden {
                    SolidView{width: Fill height: Fill draw_bg.color: #xf2f3f4b0}
                    View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0} padding: 10
                        Ico{width: 22 height: 22 draw_svg +: {svg: icon("eye-off") color: #x55585c}}
                    }
                }
            }
            if on {
                View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0} padding: 10
                    RoundedView{width: 24 height: 24 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: qd_accent border_size: 1.5 border_color: #xffffff border_radius: 12.0}
                        Ico{width: 14 height: 14 draw_svg +: {svg: icon("check") color: #xffffff}}
                    }
                }
            }
        }
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 4 right: 4}
            Label{padding: 0 text: "" + (i + 1) draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12.5}}}
            Gap{}
            Label{padding: 0 text: transition_label("" + optional(s, "transition", "none")) draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11}}}
        }
    }
}

// ---- Export (09-export) ---------------------------------------------------------

fn export_view(){
    let t = deck_tab()
    if t == nil || t.export == nil { return View{width: Fill height: 1} }
    let e = t.export
    let d = deck_by_path(t.path)
    let exports = []
    if d != nil { exports = optional(d, "exports", []) }
    let hidden_n = 0
    for s in t.slides { if optional(s, "hidden", false) { hidden_n = hidden_n + 1 } }
    let days = days_now()
    View{width: Fill height: Fit flow: Down align: Align{x: 0.5} padding: Inset{top: 20 bottom: 40 left: 24 right: 24}
        RoundedShadowView{width: Fill max_width: 703 height: Fit flow: Down padding: Inset{left: 26 right: 26 top: 24 bottom: 24} spacing: 12
            draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_line border_radius: 7.0 shadow_color: qd_shadow shadow_radius: 8.0 shadow_offset: vec2(0.0, 1.0)}
            Label{padding: 0 text: "Export “" + t.title + "”" draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 16}}}
            section_label("Format")
            View{width: Fill height: 154 flow: Right spacing: 20
                format_card(e, "pptx", "Presentation", ".pptx", "Opens in most presentation apps")
                format_card(e, "pdf", "PDF", ".pdf", "Looks the same everywhere")
                format_card(e, "images", "Images", ".png", "One picture per slide")
            }
            if e.kind == "pdf" {
                section_label("Pages")
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 14
                    SegRow{width: 420
                        seg_item(e.layout == "slides", "", "Slides", || export_set("layout", "slides"))
                        seg_item(e.layout == "notes", "", "Notes pages", || export_set("layout", "notes"))
                        seg_item(e.layout == "handouts", "", "Handouts", || export_set("layout", "handouts"))
                    }
                }
                if e.layout == "handouts" {
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                        Label{padding: 0 text: "Slides per page" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}}
                        View{width: 8 height: 1}
                        for n in PER_PAGE { chip(e.per_page == n, "" + n, || export_set("per_page", n)) }
                    }
                }
            }
            section_label("Slides")
            radio_row(e.which == "all", "All " + plural(t.slides.len(), "slide", "slides"), || export_set("which", "all"))
            radio_row(e.which == "current", "Current slide", || export_set("which", "current"))
            View{width: Fill height: 32 flow: Right align: Align{y: 0.5} spacing: 12
                radio_row(e.which == "custom", "Custom", || export_set("which", "custom"))
                Field{width: 116 height: 32 text: e.range empty_text: "2–6" on_change: |text| { let x = deck_tab() x.export.range = text if x.export.which != "custom" { x.export.which = "custom" } }}
            }
            check_row(e.hidden, "Include hidden slides (" + hidden_n + ")", || export_set("hidden", !deck_tab().export.hidden))
            section_label("Name")
            View{width: Fill height: 40 flow: Right align: Align{y: 0.5} spacing: 10
                Field{width: Fill height: 40 text: e.name empty_text: "Name of the export" on_change: |text| { deck_tab().export.name = text }}
                Label{padding: 0 text: pick(e.kind == "images", "/", export_ext(e.kind)) draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 13}}}
            }
            if e.error != "" { Wrap{text: e.error draw_text +: {color: qd_red}} }
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5} margin: Inset{top: 6}
                Label{padding: 0 text: "Saved in Quick Deck's storage" draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 12}}}
                Gap{}
                Primary{height: 40 padding: Inset{left: 22 right: 22} text: pick(e.busy, "Exporting…", export_button(e.kind)) draw_text +: {text_style: theme.font_regular{font_size: 13}}
                    on_click: || do_export(deck_tab())}
            }
        }
        if exports.len() > 0 {
            View{width: Fill max_width: 703 height: Fit flow: Down padding: Inset{left: 26 right: 26 top: 22} spacing: 10
                Label{padding: 0 text: "Exported" draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 13}}}
                for x in exports {
                    View{width: Fill height: 30 flow: Right align: Align{y: 0.5} spacing: 10
                        RoundedView{width: 20 height: 20 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: qd_green border_radius: 10.0}
                            Ico{width: 12 height: 12 draw_svg +: {svg: icon("check") color: #xffffff}}
                        }
                        Label{padding: 0 text: export_line(x, days) draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12.5}}}
                        Gap{}
                        IconBtn{width: 26 height: 26 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("trash") color: qd_faint} on_click: || remove_export(deck_tab(), x)}
                    }
                }
            }
        }
    }
}
fn export_line(x, days){
    let parts = x.name
    if optional(x, "kind", "") == "images" && optional(x, "count", 0) > 0 { parts = parts + "  ·  " + plural(x.count, "picture", "pictures") }
    if optional(x, "bytes", nil) != nil { parts = parts + "  ·  " + size_text(x.bytes) }
    parts + "  ·  " + export_when(x.at, days.today)
}
fn export_set(key, value){
    let t = deck_tab()
    let e = t.export
    if key == "kind" { e.kind = value }
    if key == "layout" { e.layout = value }
    if key == "per_page" { e.per_page = value }
    if key == "which" { e.which = value }
    if key == "hidden" { e.hidden = value }
    e.error = ""
    render_export()
}
fn format_card(e, kind, title, ext, note_text){
    let on = e.kind == kind
    GestureView{width: Fill height: Fill cursor: MouseCursor.Hand on_tap: |x, y| export_set("kind", kind)
        RoundedView{width: Fill height: Fill flow: Overlay show_bg: true
            draw_bg +: {color: qd_card border_size: pick(on, 1.5, 1.0) border_color: pick(on, qd_accent, qd_field_line) border_radius: 6.0}
            View{width: Fill height: Fill flow: Down padding: Inset{left: 16 right: 14 top: 18 bottom: 14} spacing: 12
                View{width: Fill height: Fit flow: Right spacing: 14
                    Ico{width: 30 height: 36 draw_svg +: {svg: icon("file") color: qd_icon}}
                    View{width: Fill height: Fit flow: Down spacing: 6
                        Label{padding: 0 text: title draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 12.5}}}
                        Label{padding: 0 text: ext draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 12}}}
                    }
                }
                Wrap{text: note_text draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}}
            }
            View{width: Fill height: Fill align: Align{x: 1.0 y: 1.0} padding: 12
                radio(on)
            }
        }
    }
}
fn radio(on){
    RoundedView{width: 20 height: 20 align: Align{x: 0.5 y: 0.5} show_bg: true
        draw_bg +: {color: pick(on, qd_accent, qd_field) border_size: pick(on, 0.0, 1.5) border_color: qd_faint border_radius: 10.0}
        if on { RoundedView{width: 8 height: 8 show_bg: true draw_bg +: {color: #xffffff border_radius: 4.0}} }
    }
}
fn radio_row(on, label, act){
    GestureView{width: Fit height: 30 flow: Right align: Align{y: 0.5} spacing: 10 cursor: MouseCursor.Hand on_tap: |x, y| act()
        radio(on)
        Label{padding: 0 text: label draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12.5}}}
    }
}
fn check_row(on, label, act){
    GestureView{width: Fit height: 30 flow: Right align: Align{y: 0.5} spacing: 10 cursor: MouseCursor.Hand on_tap: |x, y| act()
        RoundedView{width: 20 height: 20 align: Align{x: 0.5 y: 0.5} show_bg: true
            draw_bg +: {color: pick(on, qd_accent, qd_field) border_size: pick(on, 0.0, 1.5) border_color: qd_faint border_radius: 2.5}
            if on { Ico{width: 14 height: 14 draw_svg +: {svg: icon("check") color: #xffffff}} }
        }
        Label{padding: 0 text: label draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12.5}}}
    }
}

// ---- New from an outline (07-outline) -----------------------------------------------

fn outline_main_view(){
    let o = st.draft
    if o == nil { return View{width: Fill height: 1} }
    let drafting = o.ai == "drafting"
    View{width: Fill height: Fit flow: Down padding: Inset{left: 28 right: 28 top: 22 bottom: 28} spacing: 12
        Label{padding: 0 text: "Draft with AI" draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 13}}}
        Field{height: 42 text: o.topic empty_text: "What is the deck about? A topic, the audience, the points to cover…"
            on_change: |text| { st.draft.topic = text st.index_dirty = true }
            on_return: |text| { st.draft.topic = text draft_outline() }
            draw_text +: {text_style: theme.font_regular{font_size: 13}}}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            stepper(plural(o.count, "slide", "slides"), || { let x = st.draft x.count = max(2, x.count - 1) render_outline() }, || { let x = st.draft x.count = min(30, x.count + 1) render_outline() })
            Gap{}
            Outline{height: 38 padding: Inset{left: 14 right: 18} spacing: 10 text: pick(drafting, "Drafting…", "Draft outline") icon_walk: Walk{width: 18 height: 18}
                draw_icon +: {svg: icon("wand")} draw_text +: {text_style: theme.font_regular{font_size: 13}}
                on_click: || draft_outline()}
        }
        if o.ai == "" || drafting { hint("Uses the AI provider from Settings. Edit anything before you make the deck.") }
        if o.ai != "" && !drafting { Wrap{text: o.ai draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 12}}} }
        SolidView{width: Fill height: 1 margin: Inset{top: 8 bottom: 8} draw_bg.color: qd_line}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            Label{padding: 0 text: "Outline" draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 13}}}
            Gap{}
            LinkBtn{text: "Add slide" icon_walk: Walk{width: 15 height: 15} draw_icon +: {svg: icon("plus")} draw_text +: {text_style: theme.font_regular{font_size: 13}} on_click: || add_card()}
        }
        for i c in o.cards { outline_card(i, c) }
    }
}
fn outline_card(i, c){
    RoundedView{width: Fill height: Fit flow: Right padding: Inset{left: 8 right: 8 top: 8 bottom: 10} spacing: 12 show_bg: true
        draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_line_soft border_radius: 5.0}
        GestureView{width: 30 height: 46 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Grab
            on_pan: |dx, dy, phase| { if phase == 2 { move_card(i, dy) } }
            Ico{width: 20 height: 20 draw_svg +: {svg: icon("grip") color: qd_icon}}
        }
        RoundedView{width: 40 height: 40 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_field_line border_radius: 4.0}
            Label{padding: 0 text: "" + (i + 1) draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 14}}}
        }
        View{width: Fill height: Fit flow: Down spacing: 6
            Field{height: 36 text: c.title empty_text: pick(i == 0, "The deck's title", "Slide title") on_change: |text| outline_typed(i, "title", text)
                draw_text +: {text_style: theme.font_regular{font_size: 13}}}
            Field{height: Fit is_multiline: true text: c.points empty_text: pick(i == 0, "A subtitle (optional)", "Points, one per line") on_change: |text| outline_typed(i, "points", text)
                draw_text +: {text_style: theme.font_regular{font_size: 13 line_spacing: 0.85}}}
        }
        IconBtn{width: 30 height: 30 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("close") color: qd_muted} on_click: || remove_card(i)}
    }
}
fn outline_side_view(){
    let o = st.draft
    if o == nil { return View{width: Fill height: 1} }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 26 right: 26 top: 22 bottom: 26} spacing: 14
        Label{padding: 0 text: "Theme" draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 13}}}
        if theme_list().len() == 0 { hint(pick(st.engine == "ok" || st.engine == "", "Reading the themes…", engine_headline() + ": the outline still works by hand, and the deck can be made where the engine is available.")) }
        View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 10
            for th in theme_list() { outline_theme(th, th.name == o.theme) }
        }
        SolidView{width: Fill height: 1 margin: Inset{top: 6 bottom: 4} draw_bg.color: qd_line}
        Label{padding: 0 text: "Slide size" draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 13}}}
        View{width: Fill height: Fit flow: Right spacing: 12
            size_card(o.size == "16:9", "16:9", 66, 30, || { st.draft.size = "16:9" render_outline_side() })
            size_card(o.size == "4:3", "4:3", 52, 36, || { st.draft.size = "4:3" render_outline_side() })
        }
    }
}
fn outline_make_view(){
    let o = st.draft
    if o == nil { return View{width: Fill height: 1} }
    View{width: Fill height: Fit flow: Down padding: Inset{left: 26 right: 26 top: 0 bottom: 26} spacing: 14
        SolidView{width: Fill height: 1 margin: Inset{bottom: 4} draw_bg.color: qd_line}
        Label{padding: 0 text: counts_text(o.cards) draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 14}}}
        if optional(o, "error", "") != "" { Wrap{text: o.error draw_text +: {color: qd_red}} }
        Primary{width: Fill height: 50 text: pick(optional(o, "making", false), "Making the deck…", "Make deck") draw_text +: {text_style: theme.font_regular{font_size: 14}}
            on_click: || make_deck()}
    }
}
fn outline_theme(th, on){
    let c = theme_colors(th)
    let ground = hex_color(slot(c, 1, "#ffffff"), #xffffff)
    let ink = hex_color(slot(c, 2, "#1e2b3c"), #x1e2b3c)
    let rule = hex_color(slot(c, 2, "#1e2b3c"), #x1e2b3c)
    let a1 = hex_color(slot(c, 4, "#2e6fd8"), #x2e6fd8)
    let a2 = hex_color(slot(c, 5, "#f26b1d"), #xf26b1d)
    GestureView{width: 104 height: 132 cursor: MouseCursor.Hand on_tap: |x, y| { st.draft.theme = th.name render_outline_side() }
        RoundedView{width: Fill height: Fill flow: Down padding: Inset{left: 12 right: 12 top: 14 bottom: 10} spacing: 8 show_bg: true
            draw_bg +: {color: ground border_size: pick(on, 2.0, 1.0) border_color: pick(on, qd_accent, qd_line) border_radius: 6.0}
            Label{padding: 0 text: "Title" draw_text +: {color: ink text_style: theme.font_regular{font_size: 18}}}
            SolidView{width: Fill height: 1 draw_bg.color: mix(rule, ground, 0.5)}
            View{width: Fill height: 8 flow: Right spacing: 5 margin: Inset{top: 10}
                SolidView{width: 52 height: 8 draw_bg.color: a1}
                SolidView{width: 18 height: 8 draw_bg.color: a2}
            }
            Gap{}
            View{width: Fill height: Fit align: Align{x: 0.5}
                Label{padding: 0 text: theme_label(th.name) draw_text +: {color: pick(on, qd_link, mix(ink, ground, 0.25)) text_style: theme.font_regular{font_size: 12}}}
            }
        }
    }
}
fn size_card(on, label, w, h, act){
    GestureView{width: 148 height: 106 cursor: MouseCursor.Hand on_tap: |x, y| act()
        RoundedView{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} spacing: 12 show_bg: true
            draw_bg +: {color: qd_card border_size: pick(on, 2.0, 1.0) border_color: pick(on, qd_accent, qd_line) border_radius: 6.0}
            RoundedView{width: w height: h show_bg: true draw_bg +: {color: #x00000000 border_size: 1.5 border_color: qd_ink2 border_radius: 1.0}}
            Label{padding: 0 text: label draw_text +: {color: pick(on, qd_link, qd_ink2) text_style: theme.font_regular{font_size: 14}}}
        }
    }
}

// ---- Home (01-home) -------------------------------------------------------------

fn home_cols(){ pick(st.width < 900, 2, 3) }
fn home_view(){
    let cols = home_cols()
    let days = days_now()
    let gap = 17
    let cw = floor((min(st.width, 1536) - 2 * 72 - (cols - 1) * gap) / cols)
    let themes = theme_list()
    View{width: Fill height: Fit flow: Down padding: Inset{top: 30 bottom: 40 left: 72 right: 72}
        View{width: Fill height: Fit flow: Right align: Align{y: 0.0} spacing: 16
            View{width: Fit height: Fit flow: Right align: Align{y: 0.5} spacing: 22 padding: Inset{top: 6}
                Ico{width: 50 height: 42 draw_svg +: {svg: icon("decks") color: qd_accent}}
                Label{padding: 0 text: "Quick Deck" draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 24}}}
            }
            Gap{}
            Outline{height: 50 padding: Inset{left: 14 right: 16} spacing: 12 text: "New from an outline" icon_walk: Walk{width: 22 height: 22}
                draw_icon +: {svg: icon("outline")} draw_text +: {text_style: theme.font_regular{font_size: 13}}
                on_click: || open_outline()}
            View{width: Fit height: Fit flow: Down align: Align{x: 0.5} spacing: 8
                Outline{height: 50 padding: Inset{left: 14 right: 16} spacing: 12 icon_walk: Walk{width: 20 height: 20}
                    text: pick(st.importing == "pptx", "Choosing a presentation…", "Open a presentation from this device")
                    draw_icon +: {svg: icon("folder")} draw_text +: {text_style: theme.font_regular{font_size: 13}}
                    on_click: || open_from_device()}
                Label{padding: 0 text: pick(st.files_known && !st.files_ok, "Not available here", ".pptx, " + pick(st.max_import > 0, "up to " + size_text(st.max_import), "up to 64 MB")) draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 12}}}
            }
        }
        View{width: Fit height: Fit padding: Inset{top: 20 bottom: 12} Label{padding: 0 text: "Start a new deck" draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 15}}}}
        if st.engine == "missing" || st.engine == "old" { home_alert(engine_headline(), engine_detail(), st.engine_note, false) }
        if themes.len() == 0 && st.engine != "missing" && st.engine != "old" { hint("Reading the deck engine's themes…") }
        if themes.len() > 0 {
            View{width: Fill height: Fit flow: Flow.Right{wrap: true} spacing: 12
                for th in themes { theme_card(th, false, 156, 108, || new_deck(th.name)) }
            }
        }
        if st.alert != nil { home_alert(st.alert.head, st.alert.detail, st.alert.note, true) }
        if st.space_full { home_alert("Quick Deck's storage is full", "Remove a deck or an export to make room: slides and new decks can't be saved until there's space.", "", false) }
        if st.lib.len() > 0 {
            View{width: Fit height: Fit padding: Inset{top: 26 bottom: 12} Label{padding: 0 text: "Recent" draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 15}}}}
            for r in ceil(st.lib.len() / cols) {
                View{width: Fill height: Fit flow: Right spacing: gap margin: Inset{bottom: 14}
                    for c in cols { if r * cols + c < st.lib.len() { deck_card(st.lib[r * cols + c], cw, days) } }
                }
            }
        }
    }
}
fn home_alert(head, detail, code, dismiss){
    RoundedView{width: Fill max_width: 760 height: Fit flow: Right margin: Inset{top: 16} padding: 18 spacing: 14 show_bg: true
        draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_line border_radius: 6.0}
        Ico{width: 22 height: 22 draw_svg +: {svg: icon("warning") color: qd_red}}
        View{width: Fill height: Fit flow: Down spacing: 6
            Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: head draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 13}}}
            Wrap{text: detail draw_text +: {color: qd_muted}}
            if code != "" { Code{text: code} }
        }
        if dismiss { Outline{height: 30 text: "OK" on_click: || { st.alert = nil render_home() }} }
    }
}
fn deck_card(d, w, days){
    let src = optional(st.covers, d.path, nil)
    let ch = round(w * 0.405)
    GestureView{width: w height: Fit cursor: MouseCursor.Hand on_tap: |x, y| open_deck(d)
        RoundedView{width: Fill height: Fit flow: Down show_bg: true draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_line border_radius: 4.0}
            View{width: Fill height: ch flow: Down padding: 3
                RoundedView{width: Fill height: Fill flow: Overlay show_bg: true draw_bg +: {color: pick(src == nil, qd_line_soft, #xffffff) border_radius: 2.0}
                    if src != nil { Image{width: Fill height: Fit fit: ImageFit.Horizontal src: src} }
                    if src == nil {
                        View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
                            Ico{width: 34 height: 34 draw_svg +: {svg: icon(pick(d.state == "protected", "lock", pick(d.state != "", "warning", "deck"))) color: #xb0b3b8}}
                        }
                    }
                }
            }
            Line{draw_bg.color: qd_line_soft}
            View{width: Fill height: Fit flow: Down padding: Inset{left: 12 right: 10 top: 10 bottom: 10} spacing: 5
                Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: d.title draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 13}}}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                    Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: doc_meta(d) draw_text +: {color: pick(d.state != "", qd_red, qd_muted) text_style: theme.font_regular{font_size: 11.5}}}
                    Label{padding: 0 text: edited_text(d.edited, days.today, days.yesterday) draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 11.5}}}
                    View{width: 10 height: 1}
                    IconBtn{width: 24 height: 22 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("duplicate") color: qd_faint} on_click: || duplicate_deck(d)}
                    IconBtn{width: 24 height: 22 icon_walk: Walk{width: 14 height: 14} draw_icon +: {svg: icon("trash") color: qd_faint} on_click: || ask_remove(d)}
                }
                if st.removing == d.path {
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{top: 6}
                        Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "Remove it from Quick Deck's storage?" draw_text +: {color: qd_ink2 text_style: theme.font_regular{font_size: 11.5}}}
                        DangerBtn{height: 28 text: "Remove" on_click: || remove_deck(d)}
                        Outline{height: 28 text: "Keep" on_click: || { st.removing = "" render_home() }}
                    }
                }
            }
        }
    }
}

// ---- the status line, the unsaved-changes bar, the storage bar ----------------------

fn storage_text(){
    if st.used >= 0 && st.quota > 0 { return used_text(st.used, st.quota) }
    used_text(library_bytes(), QUOTA)
}
fn storage_share(){
    if st.used >= 0 && st.quota > 0 { return min(1, st.used / st.quota) }
    min(1, library_bytes() / QUOTA)
}
fn status_view(){
    let t = cur_tab()
    let used = storage_text()
    let full = st.space_full
    if t == nil || t.kind == "outline" {
        // Home: the words and a bar at the left (01-home); the outline page:
        // the words at the right, on the page's own ground (07-outline).
        let outline = t != nil
        return SolidView{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 38 right: 38} spacing: 22 draw_bg.color: pick(full, qd_red_tint, pick(outline, qd_home, qd_status))
            if outline { Gap{} }
            Label{padding: 0 text: pick(full, "Storage is full: " + used, used) draw_text +: {color: pick(full, qd_red, qd_muted) text_style: theme.font_regular{font_size: 12}}}
            if t == nil {
                RoundedView{width: 188 height: 5 flow: Right show_bg: true draw_bg +: {color: qd_track border_radius: 2.5}
                    RoundedView{width: max(5, floor(storage_share() * 188)) height: Fill show_bg: true draw_bg +: {color: pick(full, qd_red, qd_accent) border_radius: 2.5}}
                }
            }
        }
    }
    let state = pick(t.saving, "Saving…", pick(t.edited, "Edited", "Saved"))
    if t.state != "ready" { state = "" }
    let middle = ""
    if t.state == "ready" {
        if t.view == "sorter" { middle = plural(t.slides.len(), "slide", "slides") + "  ·  " + "" + chosen_slides(t).len() + " selected" }
        if t.view != "sorter" { middle = "Slide " + (slide_index(t, t.cur) + 1) + " of " + t.slides.len() + "  ·  " + pick(t.size[0] / max(1, t.size[1]) > 1.5, "16:9", "4:3") }
    }
    SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: pick(full, qd_red_tint, qd_status)
        View{width: Fill height: Fill flow: Right align: Align{y: 0.5} padding: Inset{left: 26 right: 34} spacing: 10
            if state != "" {
                Label{padding: 0 text: state draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 12}}}
                RoundedView{width: 11 height: 11 show_bg: true draw_bg +: {color: pick(t.edited || t.saving, qd_orange, qd_green) border_radius: 5.5}}
            }
            if full { View{width: Fit height: Fit padding: Inset{left: 14} Label{padding: 0 text: "Storage is full: remove a deck or an export to make room" draw_text +: {color: qd_red text_style: theme.font_regular{font_size: 12}}}} }
            Gap{}
            Label{padding: 0 text: used draw_text +: {color: pick(full, qd_red, qd_muted) text_style: theme.font_regular{font_size: 12}}}
        }
        if !full {
            View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5}
                Label{padding: 0 text: middle draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 12}}}
            }
        }
    }
}
// Closing a tab with unsaved changes: an inline bar under the tab row.
fn confirm_view(){
    let t = tab_by_key(st.confirm)
    if t == nil { return View{width: Fill height: 1} }
    View{width: Fill height: Fit flow: Down
        SolidView{width: Fill height: 50 flow: Right align: Align{y: 0.5} padding: Inset{left: 24 right: 16} spacing: 10 draw_bg.color: qd_tint
            Ico{width: 18 height: 18 draw_svg +: {svg: icon("save") color: qd_link}}
            Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: "Save changes to “" + t.title + "”?" draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 12.5}}}
            Primary{height: 32 text: "Save" on_click: || save_and_close(tab_by_key(st.confirm))}
            Outline{height: 32 text: "Don't save" on_click: || close_tab(tab_by_key(st.confirm), true)}
            Outline{height: 32 text: "Cancel" on_click: || { st.confirm = "" render_confirm() }}
        }
        Line{}
    }
}
// Storage full: an inline bar under the toolbar.
fn full_view(){
    if !st.space_full { return View{width: Fill height: 1} }
    View{width: Fill height: Fit flow: Down
        SolidView{width: Fill height: 44 flow: Right align: Align{y: 0.5} padding: Inset{left: 24 right: 16} spacing: 10 draw_bg.color: qd_red_tint
            Ico{width: 18 height: 18 draw_svg +: {svg: icon("warning") color: qd_red}}
            Label{padding: 0 width: Fill max_lines: 1 text_overflow: TextOverflow.Ellipsis text: "Quick Deck's storage is full: remove a deck or an export to make room. Your edits stay in the open deck." draw_text +: {color: qd_ink text_style: theme.font_regular{font_size: 12.5}}}
            Outline{height: 30 text: "Go to Home" on_click: || go_home()}
        }
        Line{}
    }
}

// ---- Present (08-present) ---------------------------------------------------------

fn present_view(){
    let p = st.present
    let t = present_tab()
    if p == nil || t == nil { return View{width: Fill height: Fill} }
    if p.done {
        return View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.45} spacing: 10
            GestureView{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.45} spacing: 10 on_tap: |x, y| present_step(1) on_swipe: |dx, dy| present_step(pick(dx > 0, -1, 1))
                Label{padding: 0 text: "End of the show" draw_text +: {color: qd_stage_ink text_style: theme.font_regular{font_size: 18}}}
                Label{padding: 0 text: "Tap to leave, or go back with ‹." draw_text +: {color: qd_stage_muted text_style: theme.font_regular{font_size: 12.5}}}
            }
        }
    }
    let item = present_item()
    let notes = present_notes(t, item).trim()
    let show_notes = p.notes && notes != ""
    let room_h = st.height - 150 - pick(show_notes, 130, 0)
    let w = floor(min(st.width - 96, room_h * t.size[0] / max(1, t.size[1])))
    let h = round(w * t.size[1] / max(1, t.size[0]))
    let src = optional(p.pics, present_key(item, p.step), nil)
    View{width: Fill height: Fill flow: Overlay
        View{width: Fill height: Fill flow: Down align: Align{x: 0.5} padding: Inset{top: 48}
            RectShadowView{width: w height: h flow: Overlay draw_bg +: {color: #xffffff shadow_color: #x00000099 shadow_radius: 12.0 shadow_offset: vec2(0.0, 2.0)}
                if src != nil { Image{width: Fill height: Fill fit: ImageFit.Stretch src: src} }
                if src == nil { View{width: Fill height: Fill align: Align{x: 0.5 y: 0.5} LoadingSpinner{width: 28 height: 28}} }
                GestureView{width: Fill height: Fill on_tap: |x, y| present_step(1) on_swipe: |dx, dy| present_step(pick(dx > 0, -1, 1))}
            }
            if show_notes {
                RoundedView{width: w height: 110 margin: Inset{top: 14} flow: Down padding: Inset{left: 18 right: 18 top: 12 bottom: 12} show_bg: true
                    draw_bg +: {color: qd_notes_strip border_size: 1.0 border_color: qd_stage_line border_radius: 8.0}
                    ScrollYView{width: Fill height: Fill
                        Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: notes draw_text +: {color: qd_stage_ink text_style: theme.font_regular{font_size: 14 line_spacing: 1.45}}}
                    }
                }
            }
        }
        View{width: Fill height: Fill align: Align{x: 1.0 y: 0.0} padding: Inset{top: 26 right: 26}
            GestureView{width: 46 height: 46 align: Align{x: 0.5 y: 0.5} cursor: MouseCursor.Hand on_tap: |x, y| stop_present()
                RoundedView{width: 46 height: 46 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg +: {color: qd_stage_pill border_size: 1.0 border_color: qd_stage_line border_radius: 23.0}
                    Ico{width: 18 height: 18 draw_svg +: {svg: icon("close") color: qd_stage_ink}}
                }
            }
        }
    }
}
// Present's control bar: previous, "4 / 12", next, Notes, the time, Exit.
fn present_bar_view(){
    let p = st.present
    let t = present_tab()
    if p == nil || t == nil { return View{width: 1 height: 1} }
    let item = present_item()
    let n = t.slides.len()
    let at = n
    if item != nil && !p.done { at = slide_index(t, item.slide) + 1 }
    RoundedView{width: Fit height: 62 flow: Right align: Align{y: 0.5} padding: Inset{left: 18 right: 18} spacing: 6 show_bg: true
        draw_bg +: {color: qd_stage_pill border_size: 1.0 border_color: qd_stage_line border_radius: 14.0}
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("chevron-left") color: qd_stage_ink} draw_bg +: {color_hover: #xffffff18 color_down: #xffffff24} on_click: || present_step(-1)}
        View{width: 74 height: Fit align: Align{x: 0.5}
            Label{padding: 0 text: "" + at + " / " + n draw_text +: {color: qd_stage_ink text_style: theme.font_regular{font_size: 13}}}
        }
        IconBtn{icon_walk: Walk{width: 18 height: 18} draw_icon +: {svg: icon("chevron-right") color: qd_stage_ink} draw_bg +: {color_hover: #xffffff18 color_down: #xffffff24} on_click: || present_step(1)}
        SolidView{width: 1 height: 30 margin: Inset{left: 12 right: 12} draw_bg.color: qd_stage_line}
        Flat{height: 36 padding: Inset{left: 10 right: 12} spacing: 10 text: "Notes" icon_walk: Walk{width: 18 height: 18}
            draw_icon +: {svg: icon("notes") color: pick(p.notes, #xffffff, qd_stage_ink)}
            draw_bg +: {color: pick(p.notes, #xffffff1c, #x00000000) color_hover: #xffffff18 color_down: #xffffff24}
            draw_text +: {color: qd_stage_ink color_hover: #xffffff color_down: #xffffff color_focus: qd_stage_ink text_style: theme.font_regular{font_size: 13}}
            on_click: || toggle_present_notes()}
        View{width: 86 height: Fit align: Align{x: 0.5}
            Label{padding: 0 text: clock_text(time_now() - p.started) draw_text +: {color: qd_stage_ink text_style: theme.font_regular{font_size: 13}}}
        }
        SolidView{width: 1 height: 30 margin: Inset{left: 6 right: 12} draw_bg.color: qd_stage_line}
        Flat{height: 36 padding: Inset{left: 12 right: 10} spacing: 10 text: "Exit" icon_walk: Walk{width: 16 height: 16}
            draw_icon +: {svg: icon("close") color: qd_stage_ink}
            draw_bg +: {color_hover: #xffffff18 color_down: #xffffff24}
            draw_text +: {color: qd_stage_ink color_hover: #xffffff color_down: #xffffff color_focus: qd_stage_ink text_style: theme.font_regular{font_size: 13}}
            on_click: || stop_present()}
    }
}

// ---- the window -------------------------------------------------------------

SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: qd_desk
    View{width: Fill height: Fill flow: Down
        // Present hides these regions through plain wrappers (a view whose
        // on_render starts hidden stays hidden).
        tabs_box := View{width: Fill height: Fit
            tabs := SolidView{width: Fill height: TAB_H draw_bg.color: qd_tabs on_render: || { tabs_view() }}
        }
        confirm_box := View{visible: false width: Fill height: Fit
            confirm := View{width: Fill height: Fit on_render: || { confirm_view() }}
        }
        home := SolidView{width: Fill height: Fill flow: Down draw_bg.color: qd_home
            home_pane := ScrollYView{width: Fill height: Fill flow: Down on_render: || { home_view() }}
        }
        deck := View{visible: false width: Fill height: Fill flow: Down
            View{width: Fill height: Fit flow: Down
                bar := SolidView{width: Fill height: BAR_H draw_bg.color: qd_bar on_render: || { bar_view() }}
                Line{}
            }
            full_box := View{visible: false width: Fill height: Fit
                full_bar := View{width: Fill height: Fit on_render: || { full_view() }}
            }
            slides_box := View{width: Fill height: Fill flow: Right
                nav_box := View{width: Fit height: Fill
                    nav := View{width: Fit height: Fill on_render: || { nav_view() }}
                }
                View{width: Fill height: Fill flow: Down
                    strip_box := View{visible: false width: Fill height: Fit
                        strip := SolidView{width: Fill height: Fit draw_bg.color: qd_bar on_render: || { strip_view() }}
                    }
                    View{width: Fill height: Fill flow: Overlay
                        canvas_box := View{width: Fill height: Fill
                            canvas := ScrollXYView{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.5} padding: Inset{top: DESK_TOP bottom: DESK_BOTTOM left: DESK_SIDE right: DESK_SIDE} on_render: || { canvas_view() }}
                        }
                        notice_box := View{visible: false width: Fill height: Fill
                            notice := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 0.4} padding: 24 on_render: || { notice_view() }}
                        }
                        pill_box := View{width: Fill height: Fill
                            pill := View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0} padding: Inset{bottom: PILL_BOTTOM} on_render: || { pill_view() }}
                        }
                        float_box := View{visible: false width: Fill height: Fill
                            insp_float := View{width: Fill height: Fill on_render: || { insp_float_view() }}
                        }
                    }
                }
                insp_box := View{width: Fit height: Fill
                    insp_side := View{width: Fit height: Fill on_render: || { insp_side_view() }}
                }
            }
            sorter_box := View{visible: false width: Fill height: Fill flow: Down
                sorter_strip := SolidView{width: Fill height: SORT_STRIP_H draw_bg.color: qd_bar on_render: || { sorter_strip_view() }}
                Line{}
                sorter := ScrollYView{width: Fill height: Fill flow: Down on_render: || { sorter_view() }}
            }
            export_box := View{visible: false width: Fill height: Fill
                export_pane := ScrollYView{width: Fill height: Fill flow: Down on_render: || { export_view() }}
            }
        }
        outline := SolidView{visible: false width: Fill height: Fill flow: Down draw_bg.color: qd_home padding: Inset{left: 76 right: 76}
            View{width: Fill height: Fit flow: Down align: Align{x: 0.5} padding: Inset{top: 34 bottom: 22} spacing: 10
                Label{padding: 0 text: "New from an outline" draw_text +: {color: qd_ink text_style: theme.font_bold{font_size: 21}}}
                Label{padding: 0 text: "One card per slide: a title, then its points, one per line." draw_text +: {color: qd_muted text_style: theme.font_regular{font_size: 13.5}}}
            }
            View{width: Fill height: Fill flow: Right spacing: 12 padding: Inset{bottom: 26}
                RoundedView{width: Fill height: Fill flow: Down show_bg: true draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_line border_radius: 7.0}
                    outline_main := ScrollYView{width: Fill height: Fill flow: Down on_render: || { outline_main_view() }}
                }
                RoundedView{width: 512 height: Fill flow: Down show_bg: true draw_bg +: {color: qd_card border_size: 1.0 border_color: qd_line border_radius: 7.0}
                    outline_side := ScrollYView{width: Fill height: Fill flow: Down on_render: || { outline_side_view() }}
                    // The counts and Make deck stay in view in a short window.
                    outline_make := View{width: Fill height: Fit flow: Down on_render: || { outline_make_view() }}
                }
            }
        }
        status_box := View{width: Fill height: Fit flow: Down
            Line{}
            status := SolidView{width: Fill height: STATUS_H draw_bg.color: qd_status on_render: || { status_view() }}
        }
    }
    present_box := View{visible: false width: Fill height: Fill flow: Overlay
        present := SolidView{width: Fill height: Fill draw_bg.color: qd_stage on_render: || { present_view() }}
        View{width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0} padding: Inset{bottom: 28}
            present_bar := View{width: Fit height: Fit on_render: || { present_bar_view() }}
        }
    }
    banner := View{visible: false width: Fill height: Fill flow: Down align: Align{x: 0.5 y: 1.0} padding: Inset{left: 16 right: 16 bottom: 84}
        RoundedView{width: Fill max_width: 600 height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 16 right: 6 top: 6 bottom: 6}
            new_batch: true show_bg: true draw_bg +: {color: #x1c1c1eee border_radius: 10.0}
            banner_text := Label{padding: 0 width: Fill flow: Flow.Right{wrap: true} text: "" draw_text +: {color: #xffffff text_style: theme.font_regular{font_size: 12 line_spacing: 1.35}}}
            ButtonFlat{height: 40 padding: Inset{left: 12 right: 12} text: "OK" on_click: || note("")
                draw_bg +: {color: #x00000000 color_focus: #x00000000 color_hover: #xffffff22 color_down: #xffffff33 border_size: 0.0}
                draw_text +: {color: #x64d2ff color_focus: #x64d2ff color_hover: #x64d2ff color_down: #x64d2ff text_style: theme.font_bold{font_size: 12}}}
        }
    }
}
