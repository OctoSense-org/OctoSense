                draw_text +: {color: if page == "qa" {orange} else {muted} color_hover: orange color_down: orange text_style.font_size: 14}}
            ButtonFlat{text: "♡   我的" width: Fill height: 48 on_click: || goto("mine") align: Align{x: 0.0 y: 0.5}
