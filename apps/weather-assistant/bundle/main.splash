for hour in hours { View{width: Fill height: Fit flow: Down spacing: 10 align: Align{x: 0.5}
Label{text: hour.time draw_text.color: muted draw_text.text_style.font_size: 12}
Svg{width: 32 height: 32 animating: false draw_svg.svg: http_resource("{{assets}}/assets/" + hourly_weather_asset(hour))}
Label{text: "" + round(hour.temp) + "°" draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 17}}
}}
}
if hours.len() == 7 {View{show_bg: true width: Fill height: 52 draw_bg +: {
    y0: instance(today_curve_y(hours, 0)) y1: instance(today_curve_y(hours, 1)) y2: instance(today_curve_y(hours, 2))
    y3: instance(today_curve_y(hours, 3)) y4: instance(today_curve_y(hours, 4)) y5: instance(today_curve_y(hours, 5)) y6: instance(today_curve_y(hours, 6))
    pixel: fn(){ let sdf = Sdf2d.viewport(self.pos * self.rect_size); let w = self.rect_size.x; let h = self.rect_size.y
        sdf.move_to(w / 14.0, self.y0 * h); sdf.line_to(w * 3.0 / 14.0, self.y1 * h); sdf.line_to(w * 5.0 / 14.0, self.y2 * h)
        sdf.line_to(w * 7.0 / 14.0, self.y3 * h); sdf.line_to(w * 9.0 / 14.0, self.y4 * h); sdf.line_to(w * 11.0 / 14.0, self.y5 * h); sdf.line_to(w * 13.0 / 14.0, self.y6 * h)
        sdf.stroke(#xb75b35, 1.8); return sdf.result }
}}}
View{width: Fill height: Fit flow: Right spacing: 6
for hour in hours { Label{width: Fill text: if hour.rain == nil {"暂无"} else {"" + round(hour.rain) + "%"} align: Align{x: 0.5} draw_text.color: muted draw_text.text_style.font_size: 11} }
}
}
Caption{text: "降水概率 · 数据来自 Open-Meteo"}

}Card{
View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5} 
Heading{text: "未来 7 天" }Caption{text: "温度范围与降水概率" width: Fit}
}
let days = forecast_days()
if days.len() == 0 {Small{text: "七日预报暂不可用"}}
for i in days.len() {
View{width: Fill height: 48 flow: Right spacing: 12 align: Align{y: 0.5}
Label{width: 98 text: if i == 0 {"今天"} else {date_label(days[i].date)} draw_text.color: ink}
Svg{width: 28 height: 28 animating: false draw_svg.svg: http_resource("{{assets}}/assets/" + compact_weather_asset(days[i].code))}
Label{width: 50 text: weather_text(days[i].code) draw_text.color: muted draw_text.text_style.font_size: 12}
Label{width: 44 text: "" + round(days[i].low) + "°" draw_text.color: muted}
View{show_bg: true width: Fill height: 8 draw_bg +: {
lo: instance(temperature_position(days[i].low, days)) hi: instance(temperature_position(days[i].high, days))
pixel: fn(){let sdf = Sdf2d.viewport(self.pos * self.rect_size); let w = self.rect_size.x; let h = self.rect_size.y
sdf.box(0.0, 0.0, w, h, 4.0); sdf.fill(#xf2e6d6); sdf.box(w * self.lo, 0.0, w * (self.hi - self.lo), h, 4.0); sdf.fill(#xb75b35); return sdf.result}
}}
Label{width: 44 text: "" + round(days[i].high) + "°" draw_text.color: ink}
Label{width: 56 text: if days[i].rain == nil {"暂无"} else {"" + round(days[i].rain) + "%"} draw_text.color: muted draw_text.text_style.font_size: 12}
}
}

}
