    composer := RoundedView{visible: false width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5} padding: 12 draw_bg.color: paper draw_bg.border_radius: 14.0
        question := Field{width: Fill height: 44 empty_text: "想问问天气、穿衣，或安排一次出门？" on_return: |text| send_weather_question()}
        Primary{text: "发送 →" width: 84 on_click: || send_weather_question()}
    }
    }
}

// Schedule startup only after the app view tree has been constructed. On a
// cold launch, the old timer could fire while the dynamic content view was
// still mounting, leaving the page blank until the user forced a redraw.
start_timeout(0.05, || { ui.navigation.render(); ui.content.render(); load_data(); poll_family_weather() })
