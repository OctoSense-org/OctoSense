    let Heading = Label{width: Fill draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 18}}
    let Small = Label{width: Fill draw_text.color: muted draw_text.text_style.font_size: 12}
    let Caption = Label{width: Fill draw_text.color: muted draw_text.text_style.font_size: 11}
    let Hr = SolidView{width: Fill height: 1 margin: Inset{top: 6 bottom: 6} draw_bg.color: #x25344514}
    let Action = ButtonFlat{height: 40 draw_bg +: {border_radius: 5.5 color: soft color_hover: warm color_down: warm border_size: 0.0} draw_text +: {color: orange color_hover: orange color_down: ink}}
    let Primary = ButtonFlat{height: 44 draw_bg +: {border_radius: 5.5 color: orange color_hover: #xa74d2b color_down: #x954325 border_size: 0.0} draw_text +: {color: light_ink color_hover: light_ink color_down: light_ink}}
    let Quiet = ButtonFlatter{height: 34 draw_text +: {color: muted color_hover: orange color_down: orange}}
    let Field = TextInput{width: Fill height: 44 padding: 12 draw_bg +: {color: pale color_hover: pale color_focus: soft color_empty: pale border_radius: 5.0 border_size: 0.0 color_2: vec4(-1.0) color_2_hover: vec4(-1.0) color_2_focus: vec4(-1.0) color_2_empty: vec4(-1.0)} draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: muted color_empty_hover: muted text_style: DaycastRegular{font_size: 13}}}
    // finesse · product · warm weather surface + ink advice · daily overview
    SolidView{width: 176 height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 30 bottom: 24} spacing: 10 draw_bg.color: paper
        View{width: Fill height: Fit flow: Right spacing: 9 align: Align{y: 0.5}
            Svg{width: 30 height: 30 animating: false draw_svg.svg: http_resource("{{assets}}/assets/daycast.svg")}
