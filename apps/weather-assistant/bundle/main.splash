Heading{text: "出门，要不要带伞？" draw_text.text_style.font_size: 15}Small{text: today_rain_tip() }}
}Hr{}View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5} 
Svg{width: 30 height: 30 animating: false draw_svg.svg: http_resource("{{assets}}/assets/compact-sunny.svg")}View{width: Fill height: Fit flow: Down spacing: 8
