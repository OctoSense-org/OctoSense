    let DaycastRegular = TextStyle{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-Regular.ttf") asc: -0.2 desc: 0.08 weight: 400}} line_spacing: 1.0}
    let DaycastBold = TextStyle{font_family: FontFamily{latin := FontMember{res: http_resource("{{assets}}/assets/NotoSansSC-Bold.ttf") asc: -0.2 desc: 0.08 weight: 700}} line_spacing: 1.0}
