}if family_alerts.len() == 0 {Small{text: "还没有天气变化提醒。首次检查会建立基线。"}}
for alert in family_alerts {
Card{padding: 16 draw_bg.color: pale
Small{text: alert.text draw_text.color: ink}
Small{text: if alert.state == "sent" {"✓ 已通过 Rinx 发送"} else if alert.state == "sending" {"等待 Rinx 确认"} else if alert.state == "error" {"未发送：" + alert.error} else {"待发送"} draw_text.color: orange}
if alert.state != "sent" && alert.state != "sending" {Action{text: "交给 Rinx 确认 / 重试" on_click: || send_family_alert(alert.id)}}
}
}

}Card{draw_bg.color: warm
