if page == "today" {
today_scroll := ScrollYView{width: Fill height: Fill flow: Down spacing: 20

            View{width: Fill height: Fit flow: Down spacing: 8
                Label{text: today_date_label() draw_text.color: muted draw_text.text_style.font_size: 12 padding: 0}
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
                    Label{width: Fill text: "今天，轻松出发。" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 28}}
                    ButtonFlat{text: current_city.name + "  ›" height: 42 on_click: || goto("cities") draw_bg +: {border_radius: 11.0 color: paper color_hover: soft color_down: warm border_size: 0.0} draw_text +: {color: ink color_hover: ink color_down: ink text_style.font_size: 13}}
                    ButtonFlat{text: "刷新" width: 56 height: 42 on_click: || {load_schedule(); refresh_weather()} draw_bg +: {border_radius: 11.0 color: paper color_hover: soft color_down: warm border_size: 0.0} draw_text +: {color: ink color_hover: ink color_down: ink text_style.font_size: 12}}
                }
