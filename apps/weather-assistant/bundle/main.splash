fn save_clothing_photo_copy(){
    if clothing_photo != "wardrobe_photos/draft.json" { return }
    let copy_path = "wardrobe_photos/" + ("" + floor(time_now() * 1000)) + ".json"
    fs.write(copy_path, fs.read(clothing_photo))
    clothing_photo = copy_path
    fs.remove("wardrobe_photos/draft.json")
}
fn add_clothing(){
    new_clothing = ui.clothing_input.text().trim()
    if new_clothing == "" { return }
    new_clothing_location = ui.clothing_location.text().trim()
    save_clothing_photo_copy()
    let exists = false
    for i in wardrobe.len() {
        if wardrobe[i] == new_clothing {
            exists = true
            if new_clothing_location != "" && i < wardrobe_locations.len() { wardrobe_locations[i] = new_clothing_location }
            if clothing_photo != "" && i < wardrobe_photos.len() {
                if wardrobe_photos[i] != "" && wardrobe_photos[i] != clothing_photo && fs.exists(wardrobe_photos[i]) { fs.remove(wardrobe_photos[i]) }
                wardrobe_photos[i] = clothing_photo
            }
        }
    }
    if !exists { wardrobe.push(new_clothing); wardrobe_locations.push(new_clothing_location); wardrobe_photos.push(clothing_photo) }
    clothing_form_status = if new_clothing_location != "" {"存放位置已保存：" + new_clothing_location} else if exists {"衣物信息已更新；未填写存放位置"} else {"已添加衣物；未填写存放位置"}
    new_clothing = ""
    new_clothing_location = ""
    clothing_photo = ""
    clothing_photo_status = ""
    ui.clothing_input.set_text("")
    ui.clothing_location.set_text("")
    ui.clothing_photo_preview.set_visible(false)
    ui.clothing_photo_status.set_text("")
    save_data()
    request_outing_advice()
    ui.content.render()
}
fn remove_clothing(index){
    if index < wardrobe_photos.len() && wardrobe_photos[index] != "" && fs.exists(wardrobe_photos[index]) { fs.remove(wardrobe_photos[index]) }
    let kept = []
    for i in wardrobe.len() { if i != index { kept.push(wardrobe[i]) } }
    wardrobe = kept
    let kept_locations = []
    for i in wardrobe_locations.len() { if i != index { kept_locations.push(wardrobe_locations[i]) } }
    wardrobe_locations = kept_locations
    let kept_photos = []
    for i in wardrobe_photos.len() { if i != index { kept_photos.push(wardrobe_photos[i]) } }
    wardrobe_photos = kept_photos
    save_data()
    request_outing_advice()
    ui.content.render()
}
fn edit_clothing_location(index){
    if index >= wardrobe.len() { return }
    new_clothing = wardrobe[index]
    new_clothing_location = if index < wardrobe_locations.len() {wardrobe_locations[index]} else {""}
    clothing_form_status = "修改存放位置后，点击保存到衣橱即可更新"
    ui.content.render()
}
fn clothing_location_text(index){
    if index < wardrobe_locations.len() && wardrobe_locations[index] != "" { return "存放位置：" + wardrobe_locations[index] }
    "存放位置：未填写"
}
fn normalize_datetime(value){
    let halves = value.trim().replace(" ", "T").split("T")
    if halves.len() != 2 { return "" }
    let date = halves[0].split("-")
    let time = halves[1].split(":")
    if date.len() != 3 || time.len() < 2 { return "" }
    let minute = time[1].split("+")[0].split("-")[0].split("Z")[0]
    date[0] + "-" + date[1] + "-" + date[2] + "T" + time[0] + ":" + minute
}
fn datetime_number(value){
    let halves = value.split("T")
    let date = halves[0].split("-")
    let time = halves[1].split(":")
    (date[0] + date[1] + date[2] + time[0] + time[1]).to_f64()
}
fn valid_datetime(value){
    if value.len() != 16 || value.search("-") != 4 || value.search("T") != 10 || value.search(":") != 13 { return false }
    let halves = value.split("T")
    let date = halves[0].split("-")
    let time = halves[1].split(":")
    if date[0].len() != 4 || date[1].len() != 2 || date[2].len() != 2 || time[0].len() != 2 || time[1].len() != 2 { return false }
    let month = date[1].to_f64()
    let day = date[2].to_f64()
    let hour = time[0].to_f64()
    let minute = time[1].to_f64()
    if month < 1 || month > 12 || day < 1 || day > 31 || hour < 0 || hour > 23 || minute < 0 || minute > 59 { return false }
    let number = datetime_number(value)
    number == number
}
fn add_schedule_item(){
    schedule_title = schedule_title.trim()
    schedule_start = normalize_datetime(schedule_start)
    schedule_end = normalize_datetime(schedule_end)
    if schedule_title == "" { app_status = "请填写日程事项"; ui.content.render(); return }
    if !valid_datetime(schedule_start) || !valid_datetime(schedule_end) || datetime_number(schedule_start) >= datetime_number(schedule_end) {
        app_status = "时间格式请用 YYYY-MM-DDTHH:mm，且结束时间晚于开始时间"
        ui.content.render()
        return
    }
    for event in schedule {
        if datetime_number(schedule_start) < datetime_number(event.end) && datetime_number(event.start) < datetime_number(schedule_end) {
            app_status = "这个时间段与“" + event.title + "”重叠，请调整时间"
            ui.content.render()
            return
        }
    }
    host.request("storage.daycast.schedule.add", {title: schedule_title start: schedule_start end: schedule_end}, fn(r){
        if !r.is_ok { app_status = r.error; ui.content.render(); return }
        schedule.push(r.data.event)
        schedule_title = ""
        schedule_start = ""
        schedule_end = ""
        selected_schedule_date = schedule_date
        ui.schedule_title_input.set_text("")
        ui.schedule_start_input.set_text("")
        ui.schedule_end_input.set_text("")
        app_status = "已添加到日程表"
        request_outing_advice()
        ui.content.render()
    })
}
fn remove_schedule_item(index){
    if index < 0 || index >= schedule.len() { return }
    host.request("storage.daycast.schedule.remove", {id: schedule[index].id}, fn(r){
        if !r.is_ok { app_status = r.error; ui.content.render(); return }
        let kept = []
        for i in schedule.len() { if i != index { kept.push(schedule[i]) } }
        schedule = kept
        request_outing_advice()
        ui.content.render()
    })
}
fn confirm_ai_event(){
    if pending_event == nil { return }
    let event = pending_event
    if event.title.trim() == "" || !valid_datetime(event.start) || !valid_datetime(event.end) || datetime_number(event.start) >= datetime_number(event.end) {
        app_status = "AI 给出的时间格式不正确，未添加"
        pending_event = nil
        ui.content.render()
        return
    }
    for existing in schedule {
        if datetime_number(event.start) < datetime_number(existing.end) && datetime_number(existing.start) < datetime_number(event.end) {
            app_status = "确认前发现日程冲突，未添加；请让 Daycast 重新安排"
            pending_event = nil
            ui.content.render()
            return
        }
    }
    host.request("storage.daycast.schedule.add", {title: event.title start: event.start end: event.end}, fn(r){
        pending_event = nil
        if !r.is_ok { app_status = r.error; ui.content.render(); return }
        schedule.push(r.data.event)
        app_status = "已按你的确认添加到日程表"
        request_outing_advice()
        ui.content.render()
    })
}
fn dismiss_ai_event(){ pending_event = nil; ui.content.render() }
fn ai_action_text(){
    if pending_action == nil { return "" }
    if pending_action.kind == "add_clothing" {
        if pending_action.location != "" { return "添加衣物：" + pending_action.value + "（存放位置：" + pending_action.location + "）" }
        return "添加衣物：" + pending_action.value
    }
    if pending_action.kind == "create_preference" { return "创建天气偏好：" + pending_action.value }
    if pending_action.kind == "add_family_city" { return "添加家庭城市：" + location_text(pending_action.city) }
    ""
}
fn handle_family_city_geocode(response, ticket, query){
    if ticket != qa_generation { return }
    if response.status_code >= 400 { app_status = "城市查询暂时不可用，没有添加家庭城市"; ui.content.render(); return }
    let data = response.body.to_string().parse_json()
    if data == nil || data.results == nil || data.results.len() == 0 {
        app_status = "没有找到“" + query + "”，请在城市搜索中选择准确地点"
        ui.content.render()
        return
    }
    pending_action = {kind: "add_family_city", city: data.results[0]}
    app_status = "已找到城市，请核对后确认添加"
    ui.content.render()
}
fn stage_ai_action(kind, value, location, ticket, expected_mode){
    if ticket != qa_generation || kind != expected_mode { return }
    value = value.trim()
    location = location.trim()
    if value == "" { app_status = "AI 没能识别要添加的内容，请补充后再试"; ui.content.render(); return }
    if kind == "add_family_city" {
        app_status = "正在核对城市名称…"
        ui.content.render()
        let url = "https://geocoding-api.open-meteo.com/v1/search?name=" + value.url_encode() + "&count=1&language=zh&format=json"
        net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET}) do net.HttpEvents{
            on_response: |response| handle_family_city_geocode(response, ticket, value)
            on_error: |_error| { if ticket == qa_generation { app_status = "城市查询失败，没有添加家庭城市"; ui.content.render() } }
        }
        return
    }
    pending_action = {kind: kind, value: value, location: location}
    app_status = "请核对下方内容，确认后会写入你的资料"
    ui.content.render()
}
fn confirm_ai_action(){
    if pending_action == nil { return }
    let action = pending_action
    if action.kind == "add_clothing" {
        let found = false
        for i in wardrobe.len() {
            if wardrobe[i] == action.value {
                found = true
                if action.location != "" && i < wardrobe_locations.len() { wardrobe_locations[i] = action.location }
            }
        }
        if !found { wardrobe.push(action.value); wardrobe_locations.push(action.location); wardrobe_photos.push("") }
        app_status = if found {"衣物已在衣橱中；已按确认更新存放位置"} else {"已添加到衣橱"}
    } elif action.kind == "create_preference" {
        if has_preference(action.value) { app_status = "这个天气偏好已经存在" }
        else { preferences.push(action.value); app_status = "已创建天气偏好" }
    } elif action.kind == "add_family_city" {
        let found = false
        for city in family_cities { if city.name == action.city.name && city.country == action.city.country { found = true } }
        if found { app_status = "这个家庭城市已经添加过了" }
        else { family_cities.push(action.city); app_status = "已添加家庭城市：" + location_text(action.city) }
    }
    pending_action = nil
    save_data()
    request_outing_advice()
    ui.content.render()
}
fn dismiss_ai_action(){ pending_action = nil; app_status = "已取消，没有修改资料"; ui.content.render() }
fn schedule_context(){
    let rows = []
    for event in schedule { rows.push({title: event.title start: event.start end: event.end}) }
    rows
}
fn hourly_context(){
    let rows = []
    if current_weather != nil && current_weather.hourly != nil {
        for i in 48 {
            if i < current_weather.hourly.time.len() {
                rows.push({time: current_weather.hourly.time[i] weather: weather_text(current_weather.hourly.weather_code[i]) temperature_c: current_weather.hourly.temperature_2m[i] precipitation_probability_percent: current_weather.hourly.precipitation_probability[i]})
            }
        }
    }
    rows
}
fn handle_weather_question(result, ticket, action_mode){
    if ticket != qa_generation { return }
    if result.is_ok && result.data != nil && result.data.output != nil {
        let output = result.data.output
        let reply = ""
        if output.answer != nil { reply = output.answer.trim() }
        if reply == "" { reply = "暂时无法生成回答，请稍后重试。" }
        let proposed = nil
        if output.propose_event == true && (action_mode == "chat" || action_mode == "create_schedule") {
            let proposed_start = ""
            let proposed_end = ""
            if output.event_start != nil { proposed_start = normalize_datetime(output.event_start) }
            if output.event_end != nil { proposed_end = normalize_datetime(output.event_end) }
            if output.event_title != nil && valid_datetime(proposed_start) && valid_datetime(proposed_end) && datetime_number(proposed_start) < datetime_number(proposed_end) {
                proposed = {title: output.event_title start: proposed_start end: proposed_end reason: output.event_reason}
            } else {
                reply = reply + "\n我没能识别出准确的日期和起止时间，请补充具体时间，我再为你生成可确认的日程。"
            }
        }
        pending_event = proposed
        if output.propose_action == true && output.action_kind != nil && output.action_value != nil && output.action_location != nil {
            stage_ai_action(output.action_kind, output.action_value, output.action_location, ticket, action_mode)
        } elif action_mode == "add_clothing" || action_mode == "create_preference" || action_mode == "add_family_city" {
            if output.propose_action != true { app_status = "AI 需要更多信息；请按回复补充后再试" }
        }
        chat_messages.push({speaker: "Daycast", lane: "person", text: reply})
        if app_status == "Daycast 正在结合天气和你的安排思考…" { app_status = "" }
    } else {
        chat_messages.push({speaker: "Daycast", lane: "person", text: "AI 暂时不可用，请检查 AI 设置后重试。"})
        pending_event = nil
        app_status = ""
    }
    ui.content.render()
}
fn send_weather_question(){
    question_text = ui.question.text().trim()
    if question_text == "" { return }
    chat_messages.push({speaker: "我", lane: "person", text: question_text})
    let display_text = question_text
    let action_mode = qa_action_mode
    let schedule_intent = action_mode == "create_schedule"
    create_schedule_mode = false
    qa_action_mode = ""
    update_schedule_mode_ui()
    qa_generation = qa_generation + 1
    let ticket = qa_generation
    pending_event = nil
    pending_action = nil
    question_text = ""
    ui.question.set_text("")
    app_status = "Daycast 正在结合天气和你的安排思考…"
    ui.content.render()
    let task = "你是 Daycast 的天气、衣橱和日程顾问。结合用户问题、天气、衣橱、偏好、家庭城市和已有日程回答。只使用提供的数据，不虚构天气。weather_date 是今天的本地日期，请据此换算明天等相对日期。用户询问活动时间，或明确表达想做某活动时，查看日程找不冲突的合适时段；天气适合度只根据给出的逐小时预报判断，预报覆盖不到的日期不要声称天气合适。可以提出一个待确认的日程草案，但绝不能声称已添加，也不能自行添加。只有确实适合提出具体时间时 propose_event=true，event_start 和 event_end 必须严格使用 YYYY-MM-DDTHH:mm，例如 2026-10-05T08:00；只能返回年月日和 24 小时制时分，不得使用‘明天’、空格分隔、秒或时区。活动时长优先按用户描述推断，没说时按 1 小时。没有明确活动意图时 propose_event=false。普通问答中，单纯说‘提醒我’或询问闹铃时不要创建日程草案；说明 Daycast 可通过创建日程模式添加事项，不要让用户去设置闹铃。"
    if schedule_intent { task = task + " 本条消息处于用户明确开启的‘创建日程’模式：将用户消息理解为要在 Daycast 日程表中创建事项，而不是设置闹铃。即使用户说‘提醒我’，也请提取活动标题和具体日期时间，结合现有日程检查冲突；信息足够时必须返回 propose_event=true 和严格格式的时间，信息不足时在 answer 中询问缺少的日期或时间并返回 propose_event=false。未获得用户点击确认前，不能声称日程已添加。没有说明活动时长时，请按 15 分钟安排短暂事项（如吃药），其他事项按 1 小时安排。" }
    if action_mode == "add_clothing" { task = task + " 本条消息处于添加衣物模式：只提取用户明确提到的一类衣物，可选提取明确说出的存放位置，不得推断或编造衣物、位置或照片。若衣物类型不清楚，在 answer 中追问并设 propose_action=false；明确时 propose_action=true、action_kind='add_clothing'、action_value 为衣物类型、action_location 为位置或空字符串。仅生成待确认内容，不要声称已保存。" }
    if action_mode == "create_preference" { task = task + " 本条消息处于创建天气偏好模式：提取一条用户明确表达的长期天气/体感偏好，保留简洁原意；若不是偏好或意思不清楚就追问并设 propose_action=false。明确时 propose_action=true、action_kind='create_preference'、action_value 为偏好文字、action_location 为空字符串。仅生成待确认内容，不要声称已保存。" }
    if action_mode == "add_family_city" { task = task + " 本条消息处于添加家庭城市模式：提取用户明确说出的一个家人所在城市名称，不得猜测城市或输出经纬度。城市不明确就追问并设 propose_action=false；明确时 propose_action=true、action_kind='add_family_city'、action_value 为用户说的城市名、action_location 为空字符串。应用会查找地点并让用户确认后再保存。" }
    host.request("model.complete", {
        task: task
        input: {
            question: display_text
            intent_mode: action_mode
            city: location_text(current_city)
            weather: if current_weather == nil {nil} else {current_weather.current}
            hourly_forecast: hourly_context()
            weather_date: if current_weather == nil {""} else {current_weather.daily.time[0]}
            wardrobe: wardrobe_context()
            preferences: preferences
            family_cities: family_cities
            existing_schedule: schedule_context()
        }
        schema: {type: "object" properties: {answer: {type: "string" minLength: 1 maxLength: 500} propose_event: {type: "boolean"} event_title: {type: "string" maxLength: 80} event_start: {type: "string" maxLength: 16} event_end: {type: "string" maxLength: 16} event_reason: {type: "string" maxLength: 200} propose_action: {type: "boolean"} action_kind: {type: "string" maxLength: 32} action_value: {type: "string" maxLength: 80} action_location: {type: "string" maxLength: 80}} required: ["answer" "propose_event" "event_title" "event_start" "event_end" "event_reason" "propose_action" "action_kind" "action_value" "action_location"] additionalProperties: false}
        class: "fast"
    }, fn(result){ handle_weather_question(result, ticket, action_mode) })
    ui.content.render()
}


// Today reads the same weather, schedule and family stores as the other pages.
fn today_date(){
    if current_weather != nil && current_weather.current.time != nil { return current_weather.current.time.split("T")[0] }
    if current_weather != nil && current_weather.daily.time != nil && current_weather.daily.time.len() > 0 { return current_weather.daily.time[0] }
    let now = local_time()
    return "" + now.year + "-" + if now.month < 10 {"0"} else {""} + now.month + "-" + if now.day < 10 {"0"} else {""} + now.day
}
fn today_date_label(){
    let parts = today_date().split("-")
    if parts.len() == 3 { return parts[1] + " 月 " + parts[2] + " 日" }
    return "今天"
}
fn today_hourly(){
    let rows = []
    if current_weather == nil || current_weather.hourly == nil || current_weather.hourly.time == nil { return rows }
    let hours = current_weather.hourly
    let first = 0
    let found = false
    if current_weather.current.time != nil {
        let now = datetime_number(current_weather.current.time)
        for i in hours.time.len() {
            if !found && datetime_number(hours.time[i]) >= now { first = i; found = true }
        }
        if !found { return rows }
    }
    for slot in 7 {
        let index = first + slot * 2
        if index < hours.time.len() && hours.temperature_2m != nil && index < hours.temperature_2m.len() {
            let code = nil
            let rain = nil
            if hours.weather_code != nil && index < hours.weather_code.len() { code = hours.weather_code[index] }
            if hours.precipitation_probability != nil && index < hours.precipitation_probability.len() { rain = hours.precipitation_probability[index] }
            let halves = hours.time[index].split("T")
            rows.push({time: if halves.len() > 1 {halves[1]} else {hours.time[index]}, temp: hours.temperature_2m[index], code: code, rain: rain, night: forecast_night(hours.time[index])})
        }
    }
    return rows
}
fn today_curve_y(rows, index){
    if index >= rows.len() { return 0.5 }
    let low = rows[0].temp
    let high = low
    for row in rows {
        if row.temp < low { low = row.temp }
        if row.temp > high { high = row.temp }
    }
    if high == low { return 0.5 }
    return 0.8 - (rows[index].temp - low) / (high - low) * 0.6
}
fn today_events(){
    let events = []
    let date = today_date()
    for event in schedule { if event.start.search(date + "T") == 0 { events.push(event) } }
    return events
}
fn family_current(city){
    let key = family_key(city)
    for sample in family_weather { if sample.key == key { return sample } }
    return nil
}
fn weather_asset(code){
    if code == nil { return "unknown.svg" }
    if code == 0 { return "sunny.svg" }
    if code >= 51 && code <= 99 {
        if code >= 71 && code <= 77 { return "snow.svg" }
        return "rain.svg"
    }
    if code == 45 || code == 48 { return "fog.svg" }
    return "cloudy.svg"
}
fn today_headline(){
    if current_weather == nil { return "天气就绪后，为你安排今天。" }
    let now = current_weather.current
    if now.precipitation > 0 || family_wet(now.weather_code) || (today_rain_probability() != nil && today_rain_probability() >= 50) { return "带好雨具，安心出发。" }
    if now.apparent_temperature >= 28 { return "穿得轻盈，记得补水。" }
    if now.apparent_temperature <= 16 || current_weather.daily.temperature_2m_min[0] <= 12 { return "带件外套，从容出发。" }
    return "按体感穿衣，轻松出发。"
}
fn today_rain_tip(){
    if current_weather == nil { return "降水暂缺" }
    if current_weather.current.precipitation > 0 || family_wet(current_weather.current.weather_code) { return "带好雨具" }
    let rain = today_rain_probability()
    if rain == nil { return "降水暂缺" }
    if rain >= 50 { return "建议带伞" }
    if rain == 0 { return "降水风险低" }
    return "留意降雨"
}
fn today_uv_tip(){
    if current_weather == nil { return "紫外线暂缺" }
    let uv = today_uv_index()
    if uv == nil { return "紫外线暂缺" }
    if uv >= 6 { return "做好防晒" }
    if uv >= 3 { return "注意防晒" }
    return "紫外线较弱"
}
fn today_scene_status(kind){
    if current_weather == nil { return "等待天气" }
    let rain = today_rain_probability()
    if rain == nil { return "查看逐小时天气" }
    if current_weather.current.precipitation > 0 || family_wet(current_weather.current.weather_code) || rain >= 50 { return "留意降水" }
    if kind == "run" && current_weather.current.apparent_temperature >= 30 { return "避开高温时段" }
    if kind == "run" && current_weather.current.wind_speed_10m >= 40 { return "留意大风" }
    if kind == "run" { return "参考体感与防晒" }
    return "降水风险较低"
}
fn ask_today_scene(kind){
    goto("qa")
    ui.question.set_text(if kind == "laundry" {"今天适合晾衣服吗？什么时间更好？"} else if kind == "run" {"今天什么时候适合跑步？需要注意什么？"} else {"今天适合洗车吗？"})
}
fn on_app_resize(width, height){
    if width <= 0 || height <= 0 { return }
    ui.sidebar_footer.set_visible(height >= 740)
    let next_wide = width >= 1040
    let next_bottom = if height >= 740 {80} else {28}
    if next_bottom != desktop_bottom { desktop_bottom = next_bottom; ui.main_column.render_style() }
    if next_wide != wide_layout { wide_layout = next_wide; ui.content.render() }
}


fn mine_navigation(){ return page == "mine" || page == "wardrobe" || page == "wardrobe-camera" || page == "wardrobe-photo" || page == "schedule" || page == "tag-add" || page == "family" }
fn joined_text(values){let text = ""; for value in values {if text != "" {text = text + " · "}; text = text + value}; return text}
fn time_part(value){ let parts = value.split("T"); return if parts.len() > 1 {parts[1]} else {value} }
fn date_label(value){ let p = value.split("-"); return if p.len() == 3 {p[1] + " 月 " + p[2] + " 日"} else {value} }
fn events_on_date(date){
    let rows = []
    for i in schedule.len() {
        // Include an overnight event on every date it occupies, keeping its real index.
        let start = datetime_number(date + "T00:00")
        let end = datetime_number(date + "T23:59")
        if datetime_number(schedule[i].start) <= end && datetime_number(schedule[i].end) > start { rows.push({index: i event: schedule[i]}) }
    }
    return rows
}
fn schedule_dates(){
    let dates = [today_date()]
    if current_weather != nil && current_weather.daily != nil && current_weather.daily.time != nil {
        for date in current_weather.daily.time { if date != dates[0] { dates.push(date) } }
    }
    // Saved appointments remain reachable beyond the forecast's seven-day horizon.
    for event in schedule {
        let date = event.start.split("T")[0]
        let found = false
        for existing in dates { if existing == date { found = true } }
        if !found { dates.push(date) }
    }
    return dates
}
fn submit_schedule_form(){
    let draft_start = schedule_start
    let draft_end = schedule_end
    let date = schedule_date.trim()
    if schedule_start.search("T") < 0 { schedule_start = date + "T" + schedule_start.trim() }
    if schedule_end.search("T") < 0 { schedule_end = date + "T" + schedule_end.trim() }
    add_schedule_item()
    schedule_start = draft_start
    schedule_end = draft_end
}
fn edit_pending_event(){
    if pending_event == nil { return }
    schedule_title = pending_event.title
    schedule_date = pending_event.start.split("T")[0]
    selected_schedule_date = schedule_date
    schedule_start = time_part(pending_event.start)
    schedule_end = time_part(pending_event.end)
    pending_event = nil
    goto("schedule")
}
fn edit_photo_record(){ goto("wardrobe"); edit_clothing_location(clothing_photo_view_index) }
fn query_place(name){ search_text = name; ui.city_query.set_text(name); search_cities() }
fn set_custom_tag(value){ custom_tag = value; ui.new_tag.set_text(value); update_tag_preview() }
fn update_tag_preview(){ ui.tag_preview_title.set_text(if custom_tag.trim() == "" {"你的日常，值得被记住。"} else {"多留意一点：" + custom_tag.trim()}) }
fn compact_weather_asset(code){ return "compact-" + weather_asset(code) }
fn forecast_night(timestamp){
    if current_weather == nil || current_weather.daily == nil {return false}
    let daily = current_weather.daily
    if daily.to_json().search("\"sunrise\"") < 0 || daily.to_json().search("\"sunset\"") < 0 || daily.sunrise == nil || daily.sunset == nil {return false}
    let date = timestamp.split("T")[0]
    for i in daily.time.len() {
        if daily.time[i] == date && i < daily.sunrise.len() && i < daily.sunset.len() {
            let time = datetime_number(timestamp)
            return time < datetime_number(daily.sunrise[i]) || time >= datetime_number(daily.sunset[i])
        }
    }
    return false
}
fn hourly_weather_asset(hour){
    if hour.night && hour.code == 0 {return "compact-moon.svg"}
    if hour.night && (hour.code == 1 || hour.code == 2) {return "compact-night-cloudy.svg"}
    return compact_weather_asset(hour.code)
}
fn forecast_days(){
    let rows = []
    if current_weather == nil || current_weather.daily == nil || current_weather.daily.time == nil { return rows }
    let daily = current_weather.daily
    for i in daily.time.len() {
        if i < 7 && daily.temperature_2m_min != nil && daily.temperature_2m_max != nil && i < daily.temperature_2m_min.len() && i < daily.temperature_2m_max.len() {
            let code = nil
            let rain = nil
            if daily.weather_code != nil && i < daily.weather_code.len() { code = daily.weather_code[i] }
            if daily.precipitation_probability_max != nil && i < daily.precipitation_probability_max.len() { rain = daily.precipitation_probability_max[i] }
            rows.push({date: daily.time[i] low: daily.temperature_2m_min[i] high: daily.temperature_2m_max[i] code: code rain: rain})
        }
    }
    return rows
}
fn temperature_position(value, rows){
    let low = rows[0].low
    let high = rows[0].high
    for day in rows { if day.low < low {low = day.low}; if day.high > high {high = day.high} }
    if high == low {return 0.5}
    return 0.08 + (value - low) / (high - low) * 0.84
}

