            preference_mode_button := ButtonFlat{text: "＋ 天气偏好" height: 34 on_click: || select_qa_mode("create_preference") draw_bg +: {border_radius: 17.0 color: #xeaf1f8 color_hover: #xffdfb3 color_down: #xffd29a border_size: 0.0} draw_text.color: ink}
