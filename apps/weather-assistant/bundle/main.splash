Heading{text: "提醒怎么送到家人那里" }Caption{text: "Rinx" width: Fit}
}Heading{text: "家人聊天室" draw_text.text_style.font_size: 16}Small{text: "先在 Rinx 登录 matrix.rinx.chat，邀请家人加入聊天室。" }Action{text: "读取 Rinx 聊天室" on_click: || load_rinx_rooms() }Small{text: if rinx_room == "" {"尚未选择家人聊天室"} else {"家人聊天室：" + rinx_room_name} }for room in rinx_rooms {Action{width: Fill height: Fit text: room.name + " · " + room.id on_click: || choose_rinx_room(room)}}
Hr{}
Action{text: if rinx_on {"✓ 变化后交给 Rinx 确认发送"} else {"启用变化后 Rinx 提醒"} on_click: || toggle_rinx() width: Fill}Small{text: "每条提醒仍需在 Rinx 中确认。" }Hr{}Action{text: if reminders_on {"✓ 家庭天气变化检查已开启"} else {"开启家庭天气变化检查"} on_click: || toggle_reminders() width: Fill}Small{text: "应用打开期间每 15 分钟检查；关闭后暂停。" }Caption{text: "关注降水变化、温差 ≥5°C、冰点或高温，以及大风。首次检查只建立基线。" }Small{text: family_status }Small{text: rinx_status draw_text.color: orange}
}
