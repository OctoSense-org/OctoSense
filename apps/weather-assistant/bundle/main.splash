            if app_status != "" { Label{width: Fill text: app_status padding: 0 draw_text.color: orange draw_text.text_style.font_size: 12} }
            View{width: Fill height: Fit flow: if wide_layout {Flow.Right} else {Flow.Down} spacing: 20
                RoundedView{width: Fill{weight: 160 basis: 430 shrink: 1 min: if wide_layout {300} else {0}} height: 324 padding: 24 flow: Down spacing: 12 draw_bg.color: warm draw_bg.border_radius: 22.0
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                        ButtonFlatter{text: current_city.name height: 28 align: Align{x: 0.0 y: 0.5} on_click: || goto("cities") draw_text +: {color: ink color_hover: orange color_down: orange text_style: DaycastBold{font_size: 16}}}
                        Label{width: Fill text: if current_city.admin1 == nil {""} else {current_city.admin1} draw_text.color: muted draw_text.text_style.font_size: 11}
                        Label{text: if current_weather == nil {"等待天气"} else {weather_text(current_weather.current.weather_code)} draw_text.color: muted draw_text.text_style.font_size: 12}
                    }
                    View{width: Fill height: Fill flow: Right spacing: 14 align: Align{y: 0.5}
                        View{width: Fill height: Fit flow: Down spacing: 8
                            Label{text: if current_weather == nil {"--°"} else {"" + round(current_weather.current.temperature_2m) + "°"} padding: 0 draw_text.color: ink draw_text.text_style: DaycastRegular{font_size: 64}}
                            Label{width: Fill text: if current_weather == nil {"天气数据暂不可用"} else {weather_text(current_weather.current.weather_code) + "   体感 " + round(current_weather.current.apparent_temperature) + "°C"} padding: 0 draw_text.color: ink draw_text.text_style.font_size: 13}
                            Label{width: Fill text: if current_weather == nil {"点击刷新重新获取"} else {"今日 " + round(current_weather.daily.temperature_2m_min[0]) + "° / " + round(current_weather.daily.temperature_2m_max[0]) + "°"} padding: 0 draw_text.color: muted draw_text.text_style.font_size: 12}
                        }
                        Svg{width: Fill{weight: 90 max: 210} height: 145 animating: false draw_svg.svg: http_resource("{{assets}}/assets/" + weather_asset(if current_weather == nil {nil} else {current_weather.current.weather_code}))}
                    }
                    SolidView{width: Fill height: 1 draw_bg.color: #x25344514}
                    View{width: Fill height: Fit flow: Right spacing: 14
                        View{width: Fill height: Fit flow: Down spacing: 7
                            Label{text: "降水概率" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                            Label{text: if current_weather == nil || today_rain_probability() == nil {"暂无"} else {"" + round(today_rain_probability()) + "%"} padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 16}}
                        }
                        View{width: Fill height: Fit flow: Down spacing: 7
                            Label{text: "紫外线" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                            Label{text: if current_weather == nil || today_uv_index() == nil {"暂无"} else {"" + today_uv_index()} padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 16}}
                        }
                        View{width: Fill height: Fit flow: Down spacing: 7
                            Label{text: "风速" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                            Label{text: if current_weather == nil || current_weather.current.wind_speed_10m == nil {"暂无"} else {"" + round(current_weather.current.wind_speed_10m) + " km/h"} padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 16}}
                        }
                        View{width: Fill height: Fit flow: Down spacing: 7
                            Label{text: "空气质量" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                            Label{text: "暂未接入" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 12}
                        }
                    }
                }
                RoundedView{width: Fill{weight: 100 basis: 300 shrink: 1 min: if wide_layout {280} else {0}} height: 324 padding: 24 flow: Down spacing: 14 draw_bg.color: navy draw_bg.border_radius: 22.0
                    View{width: Fill height: Fit flow: Right spacing: 9 align: Align{y: 0.5}
                        Svg{width: 20 height: 20 animating: false draw_svg.svg: http_resource("{{assets}}/assets/spark.svg")}
                        Label{width: Fill text: "今日出门建议" padding: 0 draw_text.color: light_ink draw_text.text_style: DaycastBold{font_size: 16}}
                        Label{text: "AI" padding: 0 draw_text.color: #xebad54 draw_text.text_style.font_size: 11}
                    }
                    Label{width: Fill text: today_headline() padding: 0 draw_text.color: light_ink draw_text.text_style: DaycastBold{font_size: 18} draw_text.max_lines: 2}
                    ScrollYView{width: Fill height: Fill flow: Down
                        Label{width: Fill height: Fit text: if current_weather == nil {"正在读取天气，稍后给出穿衣与出行建议。"} else if advice_text == "" {"等待最新天气数据生成建议…"} else {advice_text} padding: 0 draw_text.color: light_muted draw_text.text_style.font_size: 13}
                    }
                    Label{width: Fill text: today_rain_tip() + "  ·  " + today_uv_tip() padding: 0 draw_text.color: #xffd7a4 draw_text.text_style.font_size: 12}
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 10
                        Label{width: Fill text: "结合天气、衣橱与偏好" padding: 0 draw_text.color: light_muted draw_text.text_style.font_size: 11}
                        ButtonFlat{text: "问问 Daycast  →" height: 40 on_click: || goto("qa") draw_bg +: {border_radius: 10.0 color: soft color_hover: warm color_down: warm border_size: 0.0} draw_text +: {color: ink color_hover: ink color_down: ink text_style.font_size: 12}}
                    }
                }
            }
            let hours = today_hourly()
            let events = today_events()
            View{width: Fill height: Fit flow: if wide_layout {Flow.Right} else {Flow.Down} spacing: 20
                RoundedView{width: Fill{weight: 160 basis: 430 shrink: 1 min: if wide_layout {300} else {0}} height: 280 padding: 22 flow: Down spacing: 12 draw_bg.color: paper draw_bg.border_radius: 22.0
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                        Label{width: Fill text: "接下来，天气怎样？" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 16}}
                        ButtonFlatter{text: "完整天气 →" height: 26 on_click: || goto("sky") draw_text +: {color: muted color_hover: orange color_down: orange text_style.font_size: 11}}
                    }
                    if hours.len() == 0 { Label{width: Fill text: "逐小时预报暂不可用，刷新后重试。" padding: 0 draw_text.color: muted} }
                    if hours.len() > 0 {
                        View{width: Fill height: Fit flow: Right spacing: 6
                            for i in hours.len() {
                                View{width: Fill height: Fit flow: Down spacing: 9 align: Align{x: 0.5}
                                    Label{text: hours[i].time padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                                    Svg{width: 25 height: 25 animating: false draw_svg.svg: http_resource("{{assets}}/assets/" + hourly_weather_asset(hours[i]))}
                                    Label{text: "" + round(hours[i].temp) + "°" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 15}}
                                }
                            }
                        }
                        if hours.len() == 7 {
                            View{show_bg: true width: Fill height: 48 draw_bg +: {
                                y0: instance(today_curve_y(hours, 0)) y1: instance(today_curve_y(hours, 1)) y2: instance(today_curve_y(hours, 2))
                                y3: instance(today_curve_y(hours, 3)) y4: instance(today_curve_y(hours, 4)) y5: instance(today_curve_y(hours, 5)) y6: instance(today_curve_y(hours, 6))
                                pixel: fn(){
                                    let sdf = Sdf2d.viewport(self.pos * self.rect_size)
                                    let w = self.rect_size.x
                                    let h = self.rect_size.y
                                    sdf.move_to(w / 14.0, self.y0 * h)
                                    sdf.line_to(w * 3.0 / 14.0, self.y1 * h)
                                    sdf.line_to(w * 5.0 / 14.0, self.y2 * h)
                                    sdf.line_to(w * 7.0 / 14.0, self.y3 * h)
                                    sdf.line_to(w * 9.0 / 14.0, self.y4 * h)
                                    sdf.line_to(w * 11.0 / 14.0, self.y5 * h)
                                    sdf.line_to(w * 13.0 / 14.0, self.y6 * h)
                                    sdf.stroke(#xb75b35, 1.5)
                                    return sdf.result
                                }
                            }}
                        }
                        View{width: Fill height: Fit flow: Right spacing: 6
                            for hour in hours { Label{width: Fill text: if hour.rain == nil {"暂无"} else {"" + round(hour.rain) + "%"} align: Align{x: 0.5} padding: 0 draw_text.color: muted draw_text.text_style.font_size: 10} }
                        }
                    }
                    View{width: Fill height: Fill}
                    Label{text: "降水概率 · 每两小时" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                }
                RoundedView{width: Fill{weight: 100 basis: 300 shrink: 1 min: if wide_layout {280} else {0}} height: 280 padding: 22 flow: Down spacing: 14 draw_bg.color: paper draw_bg.border_radius: 22.0
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                        Label{width: Fill text: "今天的小安排" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 16}}
                        ButtonFlatter{text: "查看日程 ›" height: 26 on_click: || goto("schedule") draw_text +: {color: muted color_hover: orange color_down: orange text_style.font_size: 11}}
                    }
                    Label{text: "让天气配合你的计划。" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 12}
                    if events.len() == 0 { Label{width: Fill text: "今天还没有安排，留一点时间给自己。" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 13} }
                    for i in min(events.len(), 3) {
                        View{width: Fill height: Fit flow: Right spacing: 12
                            Label{text: events[i].start.split("T")[1] padding: 0 draw_text.color: orange draw_text.text_style.font_size: 12}
                            Label{width: Fill text: events[i].title padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 13} draw_text.max_lines: 1 draw_text.text_overflow: TextOverflow.Ellipsis}
                        }
                    }
                    View{width: Fill height: Fill}
                    RoundedView{width: Fill height: 38 padding: 10 align: Align{y: 0.5} draw_bg.color: sage draw_bg.border_radius: 10.0
                        Label{text: if events.len() == 0 {"＋ 从日程页添加一个小安排"} else {"今日 " + events.len() + " 项安排 · 以日程表为准"} padding: 0 draw_text.color: #x476c5b draw_text.text_style.font_size: 11}
                    }
                }
            }
            View{width: Fill height: Fit flow: if wide_layout {Flow.Right} else {Flow.Down} spacing: 20
                RoundedView{width: Fill{weight: 160 basis: 430 shrink: 1 min: if wide_layout {300} else {0}} height: 172 padding: 22 flow: Down spacing: 18 draw_bg.color: paper draw_bg.border_radius: 22.0
                    Label{text: "今天，做点什么？" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 16}}
                    View{width: Fill height: Fill flow: Right spacing: 10
                        GestureView{width: Fill height: Fill on_tap: |x, y| ask_today_scene("laundry")
                            RoundedView{width: Fill height: Fill padding: 13 flow: Down spacing: 7 draw_bg.color: sage draw_bg.border_radius: 12.0
                                Label{text: "晾衣服" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 13}}
                                Label{width: Fill text: today_scene_status("laundry") padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                            }
                        }
                        GestureView{width: Fill height: Fill on_tap: |x, y| ask_today_scene("run")
                            RoundedView{width: Fill height: Fill padding: 13 flow: Down spacing: 7 draw_bg.color: pale draw_bg.border_radius: 12.0
                                Label{text: "去跑步" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 13}}
                                Label{width: Fill text: today_scene_status("run") padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                            }
                        }
                        GestureView{width: Fill height: Fill on_tap: |x, y| ask_today_scene("wash")
                            RoundedView{width: Fill height: Fill padding: 13 flow: Down spacing: 7 draw_bg.color: pale draw_bg.border_radius: 12.0
                                Label{text: "洗车" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 13}}
                                Label{width: Fill text: today_scene_status("wash") padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
                            }
                        }
                    }
                }
                RoundedView{width: Fill{weight: 100 basis: 300 shrink: 1 min: if wide_layout {280} else {0}} height: 172 padding: 22 flow: Down spacing: 18 draw_bg.color: paper draw_bg.border_radius: 22.0
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                        Label{width: Fill text: "也关心，他们的天气。" padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 16}}
                        ButtonFlatter{text: "›" height: 26 on_click: || goto("mine") draw_text +: {color: muted color_hover: orange color_down: orange}}
                    }
                    if family_cities.len() == 0 { Label{width: Fill text: "还没有关注家人城市，可在「我的」里添加。" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 12} }
                    View{width: Fill height: Fill flow: Right spacing: 14
                        for i in min(family_cities.len(), 3) {
                            let sample = family_current(family_cities[i])
                            View{width: Fill height: Fit flow: Down spacing: 8
                                Label{text: family_cities[i].name padding: 0 draw_text.color: muted draw_text.text_style.font_size: 12}
                                Label{text: if sample == nil {"--°"} else {"" + round(sample.temp) + "°"} padding: 0 draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 21}}
                                Label{width: Fill text: if sample == nil {"待更新"} else {sample.time.split("T")[0]} padding: 0 draw_text.color: muted draw_text.text_style.font_size: 10}
                            }
                        }
                    }
                }
            }
            Label{text: "♡  让每一次出发，都多一份从容。" padding: 0 draw_text.color: muted draw_text.text_style.font_size: 11}
        
}
}
