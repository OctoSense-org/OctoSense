    let bytes = []
    if clothing_photo.split(".json").len() > 1 { bytes = fs.read(clothing_photo).parse_json() }
    else { bytes = fs.read_bytes(clothing_photo) }
    if bytes != nil { ui.clothing_photo_preview.load_image_from_data_async(bytes); ui.clothing_photo_preview.set_visible(true) }
}
