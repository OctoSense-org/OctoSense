Label{text: city.name draw_text.color: ink draw_text.text_style: DaycastBold{font_size: 15}}
Caption{text: location_text(city)}
}
Label{text: if sample == nil {"待检查"} else {"" + round(sample.temp) + "°"} draw_text.color: ink draw_text.text_style.font_size: 22}
}
}

}View{width: Fill height: Fit flow: if wide_layout {Flow.Right} else {Flow.Down} spacing: 20
