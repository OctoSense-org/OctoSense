// YouTube: search YouTube, list what exists right now, play a tap in the
// system web view. Results come from the runtime's keyless `sys.video`
// helper, which reads YouTube's own results page (public Piped/Invidious
// instances were dead when it was written); nothing here remembers a video id
// it did not just get from a search.
let chips = ["lofi hip hop radio" "news live" "music" "NASA" "cooking" "documentary"]
let q = "lofi hip hop radio"
let loaded_q = ""
let failed = false
let hits = []
let history = []
let playing = nil
let screen = "search"   // search | history | player

// ADR 0004 §11: the app's data is its account folder (a system app acts for
// the device), the folder its agent works in; what it can fetch again is
// cache/. A file an earlier build kept at the top of the jail moves on first
// use.
let DATA = "accounts/device/"
fn moved(name, path){
    if !fs.exists(path) && fs.exists(name) {
        fs.write(path, fs.read(name))
        fs.remove(name)
    }
    return path
}
fn data_path(name){ return moved(name, DATA + name) }

fn load_state(){
    if fs.exists(data_path("history.json")) {
        let v = fs.read(data_path("history.json")).parse_json()
        if v != nil { history = v }
    }
    if fs.exists(data_path("query.json")) {
        let v = fs.read(data_path("query.json")).parse_json()
        if v != nil && v.q != nil && v.q != "" { q = v.q }
    }
}

// The helper answers "—" while the results page loads and "n/a" once the
// fetch has failed for good; otherwise how many results it parsed.
fn read_hits(){
    if q == "" || loaded_q == q { return }
    let n = sys.video(q, 0, "count")
    if n == "—" { return }
    loaded_q = q
    hits = []
    failed = n == "n/a"
    // Rows until the helper runs out: past the last result it answers "".
    if !failed {
        for i in 20 {
            let id = sys.video(q, i, "id")
            if id == "" || id == "—" || id == "n/a" { break }
            hits.push({id: id title: sys.video(q, i, "title") channel: sys.video(q, i, "channel")
                length: sys.video(q, i, "length") views: sys.video(q, i, "views") age: sys.video(q, i, "age")
                thumb: sys.video(q, i, "thumb") embed: sys.video(q, i, "embed")})
        }
    }
    sync_status()
    ui.list.render()
}

fn search_for(text){
    let t = ("" + text).trim()
    if t == "" { return }
    q = t
    loaded_q = ""
    failed = false
    hits = []
    fs.write(data_path("query.json"), {q: q}.to_json())
    show("search")
    sync_status()
    ui.list.render()
    read_hits()
}

fn sync_status(){
    let text = ""
    if screen == "history" { text = "" }
    else if q != "" && loaded_q != q { text = "Searching YouTube for “" + q + "”…" }
    else if failed { text = "Couldn't reach YouTube. Check the connection and search again." }
    else if hits.len() == 0 { text = "No videos found for “" + q + "”." }
    else { text = "Results for “" + q + "”" }
    ui.status.set_text(text)
}

fn meta(h){
    let line = h.channel
    if h.views != "" && h.views != "—" { line = line + "  ·  " + h.views }
    if h.age != "" && h.age != "—" { line = line + "  ·  " + h.age }
    line
}

fn remember(h){
    let next = [h]
    for v in history {
        if v.id != h.id && next.len() < 30 { next.push(v) }
    }
    history = next
    fs.write(data_path("history.json"), history.to_json())
}

fn show(name){
    screen = name
    ui.main.set_visible(name != "player")
    ui.player_pane.set_visible(name == "player")
    if name != "player" {
        sync_status()
        ui.tabs.render()
        ui.list.render()
    }
}

fn play(h){
    playing = h
    remember(h)
    ui.player_title.set_text(h.title)
    ui.player_meta.set_text(meta(h))
    ui.player_fail.set_text("")
    show("player")
    ui.reader.open(h.embed)
}

fn close_player(){
    ui.reader.close()
    playing = nil
    show(screen_before_player())
}

fn screen_before_player(){
    if hits.len() == 0 && history.len() > 0 && loaded_q == q { return "history" }
    "search"
}

fn clear_history(){
    history = []
    fs.write(data_path("history.json"), history.to_json())
    ui.list.render()
}

fn boot(){
    load_state()
    ui.tabs.render()
    sync_status()
    ui.list.render()
    read_hits()
}
start_timeout(0.05, || boot())
start_interval(0.5, || read_hits())

let ground = #x0f0f0f
let ink = #xf1f1f1
let secondary = #xaaaaaa
let raised = #x272727
let red = #xff0033

let Chip = ButtonFlat{height: 32 padding: Inset{left: 12 right: 12}
    draw_bg +: {border_radius: 8.0 color: raised color_hover: #x3f3f3f color_down: #x505050 border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 13}}
}
let ChipOn = Chip{
    draw_bg +: {color: ink color_hover: ink color_down: #xd9d9d9}
    draw_text +: {color: ground color_hover: ground color_down: ground}
}
let BarButton = ButtonFlat{height: 40 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: #x00000000 color_hover: #xffffff14 color_down: #xffffff24 border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 15}}
}
let VideoRow = GestureView{width: Fill height: Fit flow: Right spacing: 12 padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
    frame := View{width: 168 height: 94 flow: Overlay align: Align{x: 1.0 y: 1.0}
        thumb := Image{width: 168 height: 94 fit: ImageFit.CropToFill}
        corner := View{width: Fit height: Fit padding: Inset{right: 4 bottom: 4}
            badge := RoundedView{width: Fit height: Fit padding: Inset{left: 4 right: 4 top: 1 bottom: 1}
                new_batch: true show_bg: true draw_bg.color: #x000000cc draw_bg.border_radius: 4.0
                length := Label{text: "" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 11}}
            }
        }
    }
    text := View{width: Fill height: Fit flow: Down spacing: 4
        title := Label{width: Fill text: "" max_lines: 2 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
        meta := Label{width: Fill text: "" max_lines: 2 draw_text.color: secondary draw_text.text_style.font_size: 12}
    }
}

SolidView{width: Fill height: Fill flow: Overlay show_bg: true draw_bg.color: ground
    main := SolidView{width: Fill height: Fill flow: Down new_batch: true show_bg: true draw_bg.color: ground
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{left: 14 right: 12 top: 12 bottom: 8}
            RoundedView{width: 30 height: 21 align: Align{x: 0.5 y: 0.5} new_batch: true show_bg: true draw_bg.color: red draw_bg.border_radius: 6.0
                Label{text: "▶" draw_text.color: #xffffff draw_text.text_style.font_size: 10}
            }
            Label{text: "YouTube" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 19}}
        }
        View{width: Fill height: Fit padding: Inset{left: 12 right: 12 bottom: 8}
            search := TextInput{width: Fill height: 40 empty_text: "Search YouTube"
                on_return: |text| search_for(text)
                draw_bg +: {color: #x222222 color_hover: #x222222 color_focus: #x222222 color_empty: #x222222
                    border_color: #x303030 border_color_hover: #x303030 border_color_focus: #x3ea6ff border_color_empty: #x303030
                    border_radius: 20.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
            }
        }
        tabs := ScrollXView{width: Fill height: 44 flow: Right spacing: 8 padding: Inset{left: 12 right: 12 top: 2 bottom: 10}
            on_render: || {
                if screen == "history" { ChipOn{text: "History" on_click: || show("history")} }
                else { Chip{text: "History" on_click: || show("history")} }
                for c in chips {
                    if screen == "search" && c == q { ChipOn{text: c on_click: || search_for(c)} }
                    else { Chip{text: c on_click: || search_for(c)} }
                }
            }
        }
        status := Label{width: Fill padding: Inset{left: 14 right: 14 bottom: 6} text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
        list := ScrollYView{width: Fill height: Fill flow: Down spacing: 4 padding: Inset{bottom: 24}
            on_render: || {
                if screen == "history" {
                    if history.len() == 0 {
                        View{width: Fill height: 200 align: Align{x: 0.5 y: 0.5}
                            Label{text: "Videos you play appear here." draw_text.color: secondary draw_text.text_style.font_size: 13}
                        }
                    } else {
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 14 right: 6}
                            Label{width: Fill text: "Watched on this device" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 15}}
                            BarButton{text: "Clear" on_click: || clear_history()}
                        }
                        for h in history {
                            VideoRow{on_tap: |x, y| play(h) frame.thumb.src: http_resource(h.thumb)
                                frame.corner.badge.length.text: h.length text.title.text: h.title text.meta.text: meta(h)}
                        }
                    }
                } else for h in hits {
                    VideoRow{on_tap: |x, y| play(h) frame.thumb.src: http_resource(h.thumb)
                        frame.corner.badge.length.text: h.length text.title.text: h.title text.meta.text: meta(h)}
                }
            }
        }
    }
    player_pane := SolidView{visible: false width: Fill height: Fill flow: Down new_batch: true show_bg: true draw_bg.color: ground
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 4 right: 12 top: 6 bottom: 6} spacing: 6
            BarButton{text: "‹ Back" on_click: || close_player()}
            View{width: Fill height: Fit flow: Down spacing: 2
                player_title := Label{width: Fill text: "" max_lines: 1 draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
                player_meta := Label{width: Fill text: "" max_lines: 1 draw_text.color: secondary draw_text.text_style.font_size: 11}
            }
        }
        player_fail := Label{width: Fill padding: Inset{left: 14 right: 14} text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
        reader := WebReader{width: Fill height: Fill on_error: || ui.player_fail.set_text(ui.reader.error())}
    }
}
