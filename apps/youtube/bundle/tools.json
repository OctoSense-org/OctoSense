{
  "schema": 1,
  "tools": [
    {
      "name": "youtube.search",
      "description": "Search actual YouTube results. Returns searched video ids, titles, channels and playback URLs. No audio starts. Search text is sent to YouTube.",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "background": true,
      "implemented_by": "host-service",
      "shareable": true
    },
    {
      "name": "youtube.read",
      "description": "Read a video previously returned by YouTube search or recommendations. A supplied or remembered id that was never searched is refused.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "background": true,
      "implemented_by": "host-service",
      "shareable": true
    },
    {
      "name": "youtube.recommend",
      "description": "Search real videos for a music occasion: morning, noon break, afternoon relaxation, dinner or sleep. Uses the saved query unless query is supplied. Returns choices; does not publish or play.",
      "input_schema": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "morning",
              "noon",
              "afternoon",
              "dinner",
              "sleep"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        },
        "required": [
          "slot"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "read",
      "background": true,
      "implemented_by": "host-service",
      "shareable": true
    },
    {
      "name": "youtube.publish",
      "description": "Put a searched video on YouTube\u2019s Glance music card for this slot. Quiet: no notification, no autoplay. The in-card Play action opens this exact video in YouTube; native Card/Chat stays available. Only a cached result searched within 24 hours is accepted.",
      "input_schema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{11}$"
          },
          "slot": {
            "type": "string",
            "enum": [
              "morning",
              "noon",
              "afternoon",
              "dinner",
              "sleep"
            ]
          }
        },
        "required": [
          "id",
          "slot"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service",
      "shareable": true
    },
    {
      "name": "youtube.preferences",
      "description": "Read or change YouTube music preferences at the person\u2019s request. Enable quiet daily suggestions, set each slot\u2019s device-local hour (0\u201323) and search query. Five distinct hours. The scheduler runs only while OctoSense\u2019s host runs, may be suspended by Android, and never autoplays. Do not infer an enduring preference just from listening once.",
      "input_schema": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "slots": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "morning",
                    "noon",
                    "afternoon",
                    "dinner",
                    "sleep"
                  ]
                },
                "hour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23
                },
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "required": [
                "id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service"
    },
    {
      "name": "youtube.notify",
      "description": "Tell the person something now: put a notice card from YouTube on the glance screen and show a notification. Give a short title (at most 80 characters) and the text (at most 600 characters); YouTube draws the card. Use it when the person or the system agent asks YouTube to notify them. The same card_id replaces an earlier notice.",
      "input_schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "card_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "title",
          "body"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string"
          },
          "replaced": {
            "type": "boolean"
          },
          "expires_at": {
            "type": "integer"
          }
        },
        "required": [
          "card_id"
        ]
      },
      "risk": "act",
      "background": true,
      "implemented_by": "host-service"
    }
  ]
}
