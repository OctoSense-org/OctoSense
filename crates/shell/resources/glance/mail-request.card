# ledger mail.action@0.2.0
# level:   L0
# profile: ui/l0
#
# Mail's email action card, the "personal or work request" shape of the email
# action card plan (apps/mail/docs/2026-10-01-email-action-card-plan.md),
# hand-written as the L0 the Mail agent will later write. A test fixture: the
# shell publishes it as `os.mail` with fake data under
# OCTOSENSE_GLANCE_DEMO=mail; no mail is read and no model is called.
#
# - The agent's words are the card's own `model-copy` (profile §4.2): the
#   summary, the suggestion and the reply draft. A text slot shows them and
#   the kit marks them AI-written; nothing acts on them. Reply writes the
#   draft into `draft`, a text state, which the Field shows for editing;
#   what the person sends is their own text.
# - Ask is an in-card chat with Mail's agent (§5.15): `convo` is the host's
#   `sys.chat` thread for this message, drawn with `ChatEntry`; a question
#   committed in the Field is appended as the person's entry and the host
#   appends the agent's reply (the canned demo answer, glance_chat.rs).
# - `msg` (title, recipient line, time) is a flat `sys.dataset` record,
#   seeded from `data`, standing in until Octoscript catalogs `sys.mail_*`
#   (plan, build order #3). Send only moves the card to "Sent (demo)".

source msg   sys.dataset(fields: [title, subtitle, as_of])
source convo sys.chat(app: "os.mail", thread: "ana-contract", fields: [entries, id, role, text])

state mode     { shape: enum[brief, reply, ask, sent, done], initial: .brief }
state draft    { shape: text, initial: "" }
state question { shape: text, initial: "" }

event reply  { mode: set(.reply), draft: set(copy.draft) }
event done   { mode: set(.done) }
event ask    { mode: set(.ask) }
event back   { mode: set(.brief) }
event send   { mode: set(.sent) }
event edit   { draft: set($value) }
event typing { question: set($value) }
event submit { convo: append($value), question: clear }

copy gist     { class: model-copy, en: "Ana asks whether we can sign by Friday, and wants the revised payment terms before then." }
copy suggest  { class: model-copy, en: "Suggested: Reply — confirm Friday" }
copy draft    { class: model-copy, en: "Hi Ana, Friday works for us. I'll send the revised payment terms tomorrow morning." }

copy app      { class: vocabulary, en: "Mail" }
copy h_sum    { class: vocabulary, en: "SUMMARY" }
copy h_draft  { class: vocabulary, en: "DRAFT · EDIT BEFORE SENDING" }
copy h_chat   { class: vocabulary, en: "ASK MAIL'S AGENT" }
copy b_reply  { class: vocabulary, en: "Reply" }
copy b_done   { class: vocabulary, en: "Mark done" }
copy b_ask    { class: vocabulary, en: "Ask" }
copy b_cancel { class: vocabulary, en: "Cancel" }
copy b_send   { class: vocabulary, en: "Send" }
copy b_back   { class: vocabulary, en: "Back" }
copy b_go     { class: vocabulary, en: "➤" }
copy hint     { class: vocabulary, en: "Ask about this email…" }
copy sent     { class: vocabulary, en: "Sent (demo)" }
copy marked   { class: vocabulary, en: "Marked done" }

view root Surface(pad: .tight) {
  Col(gap: 10) {
    Row(gap: 8, align: .center) {
      Icon(name: .mail, size: .row)
      TextCaption(text: copy.app, width: .fill)
      TextCaption(value: msg.as_of)
    }
    TextTitle(text: msg.title, width: .fill)
    when mode == .brief { brief }
    when mode == .reply { compose }
    when mode == .ask   { chat }
    when mode == .sent  { Row(gap: 8, align: .center) { Icon(name: .send, size: .row) TextTitle(text: copy.sent) } }
    when mode == .done  { Row(gap: 8, align: .center) { Icon(name: .check, size: .row) TextTitle(text: copy.marked) } }
  }
}

view brief Col(gap: 10) {
  TextEyebrow(text: copy.h_sum)
  TextBody(text: copy.gist, width: .fill)
  TextRow(text: copy.suggest, width: .fill)
  Row(gap: 8) {
    Chip(text: copy.b_reply, on_tap: reply, tone: .primary)
    Chip(text: copy.b_done, on_tap: done)
    Chip(text: copy.b_ask, on_tap: ask)
  }
}

view compose Col(gap: 10) {
  TextCaption(value: msg.subtitle)
  TextEyebrow(text: copy.h_draft)
  Field(text: draft, on_change: edit, width: .fill)
  Row(gap: 8) {
    Chip(text: copy.b_cancel, on_tap: back)
    Chip(text: copy.b_send, on_tap: send, tone: .primary)
  }
}

view chat Col(gap: 8) {
  TextEyebrow(text: copy.h_chat)
  for m in convo.entries key m.id {
    ChatEntry(text: m.text, role: m.role)
  }
  Row(gap: 8, align: .center) {
    Field(text: question, placeholder: copy.hint, on_change: typing, on_commit: submit, width: .fill)
    Chip(text: copy.b_go, on_tap: submit, value: question, tone: .primary)
  }
  Chip(text: copy.b_back, on_tap: back)
}
