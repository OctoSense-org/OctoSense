{
  "id": "briefing",
  "version": "1.1.0",
  "title": "Briefing",
  "description": "Search a few topics together (for example a city's weather and business news), read the top articles of each concurrently and write one briefing with a point or two per topic, with citations. Ready when every topic was read and the briefing kept every point; partial, with the reasons, when a topic found or read nothing or the briefing failed or dropped points; failed when nothing was read.",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topics", "language"],
    "properties": {
      "topics": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
      "language": {"type": "string", "minLength": 2, "maxLength": 16},
      "search_language": {"type": "string", "minLength": 2, "maxLength": 16, "default": "en"},
      "per_topic": {"type": "integer", "minimum": 1, "maximum": 3, "default": 2},
      "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 168, "default": 24}
    }
  },
  "modules": [{"module": "research", "methods": ["search", "article", "digest"]}],
  "budget": {"max_calls": 17, "max_model_calls": 1, "max_reads": 16, "max_ms": 60000, "max_concurrency": 4},
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topics", "language", "briefing", "sources", "missing"],
    "properties": {
      "topics": {"type": "array", "maxItems": 4, "items": {
        "type": "object", "additionalProperties": false, "required": ["topic", "found", "read"],
        "properties": {"topic": {"type": "string"}, "found": {"type": "integer", "minimum": 0}, "read": {"type": "integer", "minimum": 0, "description": "Articles read for this topic."}}}},
      "language": {"type": "string"},
      "briefing": {"description": "research.digest's result (task brief), or null."},
      "sources": {"type": "array", "maxItems": 12, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "topic", "title", "url", "source", "published_at", "evidence_sha256"],
        "properties": {
          "id": {"type": "string"}, "topic": {"type": "string"}, "title": {"type": "string"},
          "url": {"type": "string"}, "source": {"type": "string"}, "published_at": {"type": "string"},
          "evidence_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
        }}},
      "missing": {"type": "integer", "minimum": 0}
    }
  },
  "provenance": true
}
