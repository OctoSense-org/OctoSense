{
  "id": "market-brief",
  "version": "1.0.0",
  "title": "Market brief",
  "description": "One news search per ticker symbol, started together, the top articles for each read concurrently, and one brief (a comparison for several symbols) of developments and the risks the sources name, with citations. Research, not advice: no quotes or predictions in v1.",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": ["symbols", "language"],
    "properties": {
      "symbols": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
        "type": "object", "additionalProperties": false, "required": ["symbol", "name"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1, "maxLength": 12, "description": "Ticker, for example AAPL."},
          "name": {"type": "string", "minLength": 1, "maxLength": 60, "description": "Company or fund name, for example Apple."}
        }}},
      "language": {"type": "string", "minLength": 2, "maxLength": 16},
      "search_language": {"type": "string", "minLength": 2, "maxLength": 16, "default": "en"},
      "per_symbol": {"type": "integer", "minimum": 1, "maximum": 3, "default": 2},
      "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 720, "default": 72}
    }
  },
  "modules": [{"module": "research", "methods": ["search", "article", "digest"]}],
  "budget": {"max_calls": 13, "max_model_calls": 1, "max_pages": 12, "max_ms": 60000, "max_concurrency": 4},
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": ["symbols", "language", "brief", "sources", "missing"],
    "properties": {
      "symbols": {"type": "array", "maxItems": 3, "items": {
        "type": "object", "additionalProperties": false, "required": ["symbol", "name", "found"],
        "properties": {"symbol": {"type": "string"}, "name": {"type": "string"}, "found": {"type": "integer", "minimum": 0}}}},
      "language": {"type": "string"},
      "brief": {"description": "research.digest's result, or null."},
      "sources": {"type": "array", "maxItems": 9, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "symbol", "title", "url", "source", "published_at", "evidence_sha256"],
        "properties": {
          "id": {"type": "string"}, "symbol": {"type": "string"}, "title": {"type": "string"},
          "url": {"type": "string"}, "source": {"type": "string"}, "published_at": {"type": "string"},
          "evidence_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
        }}},
      "missing": {"type": "integer", "minimum": 0}
    }
  },
  "provenance": true
}
