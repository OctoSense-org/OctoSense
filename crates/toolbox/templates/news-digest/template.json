{
  "id": "news-digest",
  "version": "1.0.0",
  "title": "News digest",
  "description": "Search news on a topic, read the top articles concurrently and summarize them once in the requested language, citing each point's articles. Optionally translates the query into the search language first.",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topic", "language"],
    "properties": {
      "topic": {"type": "string", "minLength": 1, "maxLength": 160, "description": "What to search for, in the person's words."},
      "language": {"type": "string", "minLength": 2, "maxLength": 16, "description": "BCP 47 tag of the digest's language."},
      "search_language": {"type": "string", "minLength": 2, "maxLength": 16, "default": "en", "description": "BCP 47 tag of the sources to search."},
      "translate_query": {"type": "boolean", "default": false, "description": "Translate the topic into the search language first (one model call)."},
      "limit": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3, "description": "Articles to read."},
      "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 720, "default": 72}
    }
  },
  "modules": [{"module": "research", "methods": ["query", "search", "article", "digest"]}],
  "budget": {"max_calls": 8, "max_model_calls": 2, "max_pages": 7, "max_ms": 60000, "max_concurrency": 4},
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topic", "language", "digest", "sources", "missing"],
    "properties": {
      "topic": {"type": "string"},
      "language": {"type": "string"},
      "digest": {"description": "research.digest's result, or null when nothing was read or the model failed."},
      "sources": {"type": "array", "maxItems": 5, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "url", "source", "published_at", "evidence_sha256"],
        "properties": {
          "id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string"},
          "source": {"type": "string"}, "published_at": {"type": "string"},
          "evidence_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
        }}},
      "missing": {"type": "integer", "minimum": 0}
    }
  },
  "provenance": true
}
