{
  "id": "topic-brief",
  "version": "1.0.0",
  "title": "Topic brief across languages",
  "description": "Search one topic in several languages (translating the search terms where asked), merge the results round-robin so every language is represented, read the top articles concurrently and write one brief in the reader's language with citations.",
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topic", "language", "languages"],
    "properties": {
      "topic": {"type": "string", "minLength": 1, "maxLength": 160, "description": "The topic, in the person's words."},
      "language": {"type": "string", "minLength": 2, "maxLength": 16, "description": "BCP 47 tag of the brief's language."},
      "languages": {"type": "array", "minItems": 1, "maxItems": 4, "description": "The languages to search, each with whether to translate the topic into it first.", "items": {
        "type": "object", "additionalProperties": false, "required": ["language", "translate"],
        "properties": {
          "language": {"type": "string", "minLength": 2, "maxLength": 16},
          "translate": {"type": "boolean"}
        }}},
      "per_language": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3, "description": "Results to take from each language."},
      "read_top": {"type": "integer", "minimum": 1, "maximum": 6, "default": 4, "description": "Articles to read after merging."},
      "max_age_hours": {"type": "integer", "minimum": 1, "maximum": 720, "default": 72}
    }
  },
  "modules": [{"module": "research", "methods": ["query", "search", "article", "digest"]}],
  "budget": {"max_calls": 16, "max_model_calls": 5, "max_pages": 10, "max_ms": 90000, "max_concurrency": 4},
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": ["topic", "language", "queries", "brief", "sources", "missing"],
    "properties": {
      "topic": {"type": "string"},
      "language": {"type": "string"},
      "queries": {"type": "array", "maxItems": 4, "items": {
        "type": "object", "additionalProperties": false, "required": ["language", "terms", "found"],
        "properties": {"language": {"type": "string"}, "terms": {"type": "string"}, "found": {"type": "integer", "minimum": 0}}}},
      "brief": {"description": "research.digest's result, or null when nothing was read or the model failed."},
      "sources": {"type": "array", "maxItems": 6, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "url", "source", "language", "published_at", "evidence_sha256"],
        "properties": {
          "id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string"},
          "source": {"type": "string"}, "language": {"type": "string"}, "published_at": {"type": "string"},
          "evidence_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
        }}},
      "missing": {"type": "integer", "minimum": 0}
    }
  },
  "provenance": true
}
