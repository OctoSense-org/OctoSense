          {"name": "apphub.updates", "description": "List the installed apps that have a newer release in the catalog: id, name and the catalog's version. Does not update anything.", "input_schema": {"type": "object", "properties": {}, "additionalProperties": false}, "risk": "read", "shareable": true}
        ],
        "system_tools": ["apphub.search", "apphub.installed", "apphub.updates"]
      }
