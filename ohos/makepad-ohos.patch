+/// A flat `{"key":"value", ...}` object, the shape the ArkTS glue sends.
+/// Anything else (nesting, non-string values) is skipped, not an error.
+fn parse_flat_json_object(text: &str) -> Vec<(String, String)> {
+    fn string_at(chars: &[char], mut i: usize) -> Option<(String, usize)> {
+        if chars.get(i) != Some(&'"') {
+            return None;
+        }
+        i += 1;
+        let mut out = String::new();
+        while i < chars.len() {
+            match chars[i] {
+                '\\' if i + 1 < chars.len() => {
+                    out.push(match chars[i + 1] {
+                        'n' => '\n',
+                        't' => '\t',
+                        other => other,
+                    });
+                    i += 2;
+                }
+                '"' => return Some((out, i + 1)),
+                c => {
+                    out.push(c);
+                    i += 1;
+                }
+            }
+        }
+        None
+    }
+    let chars: Vec<char> = text.chars().collect();
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < chars.len() {
+        if let Some((key, next)) = string_at(&chars, i) {
+            i = next;
+            while i < chars.len() && (chars[i].is_whitespace() || chars[i] == ':') {
+                i += 1;
+            }
+            if let Some((value, next)) = string_at(&chars, i) {
+                out.push((key, value));
+                i = next;
+                continue;
+            }
+        }
+        i += 1;
+    }
+    out
+}
