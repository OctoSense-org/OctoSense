diff --git a/apps/mixer/src/module.rs b/apps/mixer/src/module.rs
new file mode 100644
index 000000000..f8b31cd7f
--- /dev/null
+++ b/apps/mixer/src/module.rs
@@ -0,0 +1,82 @@
+//! mixer as a module (aicontrol.md §3): the app the window manager seats
+//! in a tile in-process, in an isolate of its own. `register` puts this
+//! crate's palette and widget family into the isolate the host prepared;
+//! `create` mints one `MixerView{}` root there. The mixer has no tools
+//! for the assistant: its executor answers every call as unavailable.
+//!
+//! SAFETY: nothing here can name an OSC address — see `safety.rs`.
+
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct MixerModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static MIXER_MODULE: MixerModule = MixerModule;
+
+impl AppModule for MixerModule {
+    fn id(&self) -> &'static str {
+        "mixer"
+    }
+
+    fn label(&self) -> &'static str {
+        "Mixer"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            MixerView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        InstanceParts {
+            root: root.clone(),
+            // The client thread stops when the root (and its `Client`) drops.
+            executor: Box::new(NoTools { root }),
+            shutdown: Box::new(|_vm| {}),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["net"]
+    }
+}
+
+/// An instance without tools: on the bus for the window, nothing to call.
+struct NoTools {
+    #[allow(dead_code)]
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for NoTools {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("mixer", "Mixer", "A control surface for a digital rack mixer over OSC. It exposes no tools.")
+    }
+
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "mixer has no tools"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &MIXER_MODULE;
+        assert_eq!(m.id(), "mixer");
+        assert_eq!(m.label(), "Mixer");
+        assert!(m.capabilities().contains(&"net"));
+        assert!(m.open_schema().empty_open().is_ok(), "no argument is required");
+    }
+}
