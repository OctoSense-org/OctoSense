--- /dev/null
+++ b/apps/task/src/lib.rs
@@ -0,0 +1,54 @@
+//! task as a library: the task manager widget ([`TaskView`]) and the
+//! module ([`module`]) a host links to seat it in-process. The standalone
+//! binary (`src/main.rs`, feature `standalone`) is the same crate with a
+//! `Window` around `TaskView{}`.
+
+pub use makepad_widgets;
+use makepad_widgets::*;
+
+pub mod backend;
+pub mod module;
+pub mod sampler;
+pub mod theme;
+pub mod view;
+pub mod widgets;
+
+pub use module::{TaskModule, TASK_MODULE};
+pub use theme::Theme;
+pub use view::TaskView;
+
+/// This crate's widget families, into a VM whose widgets module exists.
+/// MeterBars/ProcessTable must exist in mod.widgets before the view does
+/// `use mod.widgets.*`.
+pub fn register(vm: &mut ScriptVm) {
+    widgets::script_mod(vm);
+    view::script_mod(vm);
+}
+
+/// Binary units, because that is what a process manager's RSS is measured in.
+pub fn format_bytes(bytes: u64) -> String {
+    const UNITS: [&str; 5] = ["B", "KiB", "MiB", "GiB", "TiB"];
+    let mut value = bytes as f64;
+    let mut unit = 0;
+    while value >= 1024.0 && unit + 1 < UNITS.len() {
+        value /= 1024.0;
+        unit += 1;
+    }
+    if unit == 0 {
+        format!("{bytes} {}", UNITS[unit])
+    } else {
+        format!("{value:.1} {}", UNITS[unit])
+    }
+}
+
+pub fn format_uptime(seconds: u64) -> String {
+    let days = seconds / 86_400;
+    let hours = seconds % 86_400 / 3_600;
+    let minutes = seconds % 3_600 / 60;
+    if days > 0 {
+        format!("{days}d {hours:02}h {minutes:02}m")
+    } else {
+        format!("{hours:02}h {minutes:02}m")
+    }
+}
+
