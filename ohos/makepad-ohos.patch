+//! task as a module (aicontrol.md §3): the app the window manager seats
+//! in a tile in-process, in an isolate of its own. `register` puts this
+//! crate's widget families into the isolate the host prepared; `create`
+//! mints one `TaskView{}` root there. The task manager has no tools for
+//! the assistant: its executor answers every call as unavailable. Its
+//! sampler worker is stopped at shutdown, before the isolate is freed.
+
+use crate::view::TaskView;
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct TaskModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static TASK_MODULE: TaskModule = TaskModule;
+
+impl AppModule for TaskModule {
+    fn id(&self) -> &'static str {
+        "task"
+    }
+
+    fn label(&self) -> &'static str {
+        "Task Manager"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            TaskView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        let stop = root.clone();
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(NoTools { root }),
+            shutdown: Box::new(move |_vm| {
+                if let Some(mut view) = stop.borrow_mut::<TaskView>() {
+                    view.stop_sampler();
+                }
+            }),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["system.processes"]
+    }
+}
+
+/// An instance without tools: on the bus for the window, nothing to call.
+struct NoTools {
+    #[allow(dead_code)]
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for NoTools {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("task", "Task Manager", "Live system activity: CPU, memory, network and the process list. It exposes no tools.")
+    }
+
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "the task manager has no tools"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &TASK_MODULE;
+        assert_eq!(m.id(), "task");
+        assert_eq!(m.label(), "Task Manager");
+        assert!(m.open_schema().empty_open().is_ok(), "no argument is required");
+    }
+}
