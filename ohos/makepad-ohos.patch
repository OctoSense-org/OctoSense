+//! files as a module (aicontrol.md §3): the app the window manager seats
+//! in a tile in-process, in an isolate of its own. `register` puts this
+//! crate's palette tokens and widget families into the isolate the host
+//! prepared; `create` mints one `FilesView{}` root there and hands the
+//! host its tools — the same seven the standalone port answers, run on
+//! the view's worker and answered through the host's reply sink.
+
+use crate::view::FilesView;
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct FilesModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static FILES_MODULE: FilesModule = FilesModule;
+
+impl AppModule for FilesModule {
+    fn id(&self) -> &'static str {
+        "files"
+    }
+
+    fn label(&self) -> &'static str {
+        "Files"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    /// `demo`: any text switches the closed demo file system on.
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1).arg("demo", OpenArgKind::Text, false)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, open: ValidatedOpen, handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            FilesView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        if let Some(mut view) = root.borrow_mut::<FilesView>() {
+            view.set_demo(open.text("demo").is_some());
+            let sink = handles.replies.clone();
+            view.set_reply(Box::new(move |result| sink.reply(result)));
+        }
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(FilesExecutor { root }),
+            shutdown: Box::new(|_vm| {}),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["storage", "fs"]
+    }
+}
+
+/// The instance's tools: queued on the view's worker, answered later
+/// through the host's reply sink.
+struct FilesExecutor {
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for FilesExecutor {
+    fn manifest(&self) -> ServiceManifest {
+        crate::chat_tools::service_manifest()
+    }
+
+    fn execute(&mut self, cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        match self.root.borrow_mut::<FilesView>() {
+            Some(mut view) => {
+                view.ai_answer(cx, call);
+                ExecOutcome::Pending
+            }
+            None => ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "the file browser is gone")),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty_or_on_the_demo() {
+        let m = &FILES_MODULE;
+        assert_eq!(m.id(), "files");
+        assert_eq!(m.label(), "Files");
+        assert!(m.capabilities().contains(&"fs"));
+        let schema = m.open_schema();
+        assert_eq!(schema.version, 1);
+        assert!(schema.empty_open().is_ok(), "no argument is required");
+        let open = schema.validate(r#"{"demo":"1"}"#, &[]).unwrap();
+        assert_eq!(open.text("demo"), Some("1"));
+        assert!(schema.validate(r#"{"path":"/tmp"}"#, &[]).is_err(), "a path is never an open argument");
+    }
+}
