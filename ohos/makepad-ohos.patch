new file mode 100644
index 000000000..0be3e4c05
--- /dev/null
+++ b/apps/terminal/src/module.rs
@@ -0,0 +1,95 @@
+//! terminal as a module (aicontrol.md §3): the app the window manager
+//! seats in a tile in-process, in an isolate of its own. `register` puts
+//! this crate's widget families into the isolate the host prepared;
+//! `create` mints one `TerminalView{}` root there and hands the host the
+//! same three tools the standalone binary answers over its port, read or
+//! typed against the live session at call time. The shell's PTY child
+//! ends with the instance: `shutdown` drops the session, and so does the
+//! root when the isolate frees it.
+
+use crate::view::TerminalView;
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct TerminalModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static TERMINAL_MODULE: TerminalModule = TerminalModule;
+
+impl AppModule for TerminalModule {
+    fn id(&self) -> &'static str {
+        "terminal"
+    }
+
+    fn label(&self) -> &'static str {
+        "Terminal"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            TerminalView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        let ending = root.clone();
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(TerminalExecutor { root }),
+            shutdown: Box::new(move |vm| {
+                if let Some(mut view) = ending.borrow_mut::<TerminalView>() {
+                    view.shutdown(vm.cx_mut());
+                }
+            }),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["process", "fs", "storage"]
+    }
+}
+
+/// The instance's tools, answered against the live session at call time.
+struct TerminalExecutor {
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for TerminalExecutor {
+    fn manifest(&self) -> ServiceManifest {
+        crate::ai::manifest()
+    }
+
+    fn execute(&mut self, cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        let result = self
+            .root
+            .borrow_mut::<TerminalView>()
+            .map(|mut view| view.ai_answer(cx, call))
+            .unwrap_or_else(|| ToolResult::unavailable(&call.call_id, "the terminal is gone"));
+        ExecOutcome::Done(result)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &TERMINAL_MODULE;
+        assert_eq!(m.id(), "terminal");
+        assert_eq!(m.label(), "Terminal");
+        assert!(m.capabilities().contains(&"process"));
+        let schema = m.open_schema();
+        assert_eq!(schema.version, 1);
+        assert!(schema.empty_open().is_ok(), "no argument is required");
+        assert!(schema.validate(r#"{"cwd":"/tmp"}"#, &[]).is_err(), "a path is never an open argument");
+    }
+}
diff --git a/apps/terminal/src/view.rs b/apps/terminal/src/view.rs
new file mode 100644
index 000000000..caa68e9ce
--- /dev/null
+++ b/apps/terminal/src/view.rs
@@ -0,0 +1,243 @@
+//! The terminal's root widget: the emulator ([`MpTerm`]) with the job it
+//! runs (the interactive shell, or a pager over a previewed file), in one
+//! widget the standalone window seats under a `Window` and the window
+//! manager seats in a tile in-process (`module.rs`). Nothing here knows
+//! about a window: titles and directories leave as actions, tool calls
+//! arrive through [`TerminalView::ai_answer`], and the first event or draw
+//! hands the job to the emulator the way an app would on `Startup`.
+
+use crate::ai;
+use crate::widget::{MpTerm, MpTermAction};
+use makepad_ai_services::wire::{ServiceCall, ToolResult};
+use makepad_widgets::*;
+use std::path::{Path, PathBuf};
+
+script_mod! {
+    use mod.prelude.widgets_internal.*
+    use mod.widgets.*
+
+    mod.widgets.TerminalViewBase = #(TerminalView::register_widget(vm))
+
+    mod.widgets.TerminalView = set_type_default() do mod.widgets.TerminalViewBase{
+        width: Fill height: Fill flow: Down padding: 0 spacing: 0
+        // Why there is no shell, when there is none (no PTY on this platform).
+        status := Label{
+            visible: false
+            width: Fill height: Fit padding: 10
+            draw_text +: {color: theme.color_text text_style: theme.font_regular{font_size: 10}}
+        }
+        term := MpTerm{}
+    }
+}
+
+/// Single-quote a path for the POSIX shell.
+pub fn shell_quote(s: &str) -> String {
+    format!("'{}'", s.replace('\'', "'\\''"))
+}
+
+/// The one-shot job a preview runs: a pager over the file, or a listing
+/// of the directory, staying up until the user quits it (q / Escape).
+pub fn preview_command(path: &Path) -> String {
+    let quoted = shell_quote(&path.to_string_lossy());
+    if cfg!(windows) {
+        return format!("more {}", quoted);
+    }
+    if path.is_dir() {
+        format!("ls -la -- {} | less -R", quoted)
+    } else {
+        format!("less -R -- {}", quoted)
+    }
+}
+
+/// The title a preview shows for its file.
+pub fn preview_title(path: &Path) -> String {
+    let name = path
+        .file_name()
+        .map(|n| n.to_string_lossy().to_string())
+        .unwrap_or_else(|| path.display().to_string());
+    format!("{} \u{2014} preview", name)
+}
+
+#[derive(Script, ScriptHook, Widget)]
+pub struct TerminalView {
+    #[source]
+    source: ScriptObjectRef,
+    #[deref]
+    view: View,
+    /// The job reached the emulator (on the first event or draw).
+    #[rust]
+    started: bool,
+    /// Where the shell opens; `None` is the process's own directory.
+    #[rust]
+    cwd: Option<PathBuf>,
+    /// A one-shot job instead of the shell (a preview's pager).
+    #[rust]
+    command: Option<String>,
+    /// Quick Look mode: the pager's exit ends the preview.
+    #[rust]
+    preview: bool,
+    /// What the shell last titled itself.
+    #[rust]
+    title: String,
+    #[rust]
+    shown_error: Option<String>,
+}
+
+impl TerminalView {
+    /// The directory the shell opens in; before the first draw only.
+    pub fn set_cwd(&mut self, cwd: Option<PathBuf>) {
+        self.cwd = cwd;
+    }
+
+    /// Quick Look: run the pager over `path` — before the first draw, or
+    /// as a retarget in place (`WmEvent::PreviewFile`): the current job is
+    /// torn down (dropping the session kills the PTY child) and the new
+    /// one starts in the same widget.
+    pub fn set_preview(&mut self, cx: &mut Cx, path: &Path) {
+        self.preview = true;
+        self.command = Some(preview_command(path));
+        if self.cwd.is_none() {
+            self.cwd = path.parent().map(Path::to_path_buf);
+        }
+        self.title = preview_title(path);
+        if self.started {
+            if let Some(mut term) = self.view.widget(cx, ids!(term)).borrow_mut::<MpTerm>() {
+                term.restart_with(cx, self.cwd.clone(), self.command.clone());
+            }
+        }
+    }
+
+    /// Quick Look unload: drop the job and idle blank until the next
+    /// retarget (`WmEvent::PreviewUnload`).
+    pub fn unload(&mut self, cx: &mut Cx) {
+        if let Some(mut term) = self.view.widget(cx, ids!(term)).borrow_mut::<MpTerm>() {
+            term.unload(cx);
+        }
+    }
+
+    /// End the job for good: the instance is going away.
+    pub fn shutdown(&mut self, cx: &mut Cx) {
+        self.unload(cx);
+    }
+
+    pub fn preview(&self) -> bool {
+        self.preview
+    }
+
+    /// The last title the shell set (or the preview's).
+    pub fn title(&self) -> &str {
+        &self.title
+    }
+
+    /// The shell's current directory, as the emulator last learned it.
+    pub fn cwd(&mut self, cx: &mut Cx) -> Option<PathBuf> {
+        self.view.widget(cx, ids!(term)).borrow::<MpTerm>().and_then(|term| term.cwd.clone())
+    }
+
+    /// One tool call against the live session: the standalone port and
+    /// the module executor both come through here.
+    pub fn ai_answer(&mut self, cx: &mut Cx, call: &ServiceCall) -> ToolResult {
+        self.view
+            .widget(cx, ids!(term))
+            .borrow_mut::<MpTerm>()
+            .map(|mut term| ai::answer(call, &mut *term))
+            .unwrap_or_else(|| ToolResult::unavailable(&call.call_id, "the terminal widget is not ready"))
+    }
+
+    /// The job reaches the emulator once, before it first spawns.
+    fn ensure_started(&mut self, cx: &mut Cx) {
+        if self.started {
+            return;
+        }
+        self.started = true;
+        if let Some(mut term) = self.view.widget(cx, ids!(term)).borrow_mut::<MpTerm>() {
+            term.cwd = self.cwd.clone();
+            term.command = self.command.clone();
+        }
+    }
+
+    /// A shell that could not start says so above the (empty) grid.
+    fn show_spawn_error(&mut self, cx: &mut Cx) {
+        let error = self.view.widget(cx, ids!(term)).borrow::<MpTerm>().and_then(|term| term.spawn_error().map(String::from));
+        if error == self.shown_error {
+            return;
+        }
+        let status = self.view.widget(cx, ids!(status));
+        match &error {
+            Some(error) => {
+                status.set_text(cx, &format!("The shell could not start: {error}"));
+                status.set_visible(cx, true);
+            }
+            None => status.set_visible(cx, false),
+        }
+        self.shown_error = error;
+    }
+}
+
+impl MatchEvent for TerminalView {
+    fn handle_actions(&mut self, _cx: &mut Cx, actions: &Actions) {
+        for action in actions {
+            let Some(wa) = action.as_widget_action() else {
+                continue;
+            };
+            if let MpTermAction::TitleChanged(title) = wa.cast::<MpTermAction>() {
+                if !self.preview {
+                    self.title = title;
+                }
+            }
+        }
+    }
+}
+
+impl Widget for TerminalView {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.ensure_started(cx);
+        self.match_event(cx, event);
+        self.view.handle_event(cx, event, scope);
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        self.ensure_started(cx);
+        self.show_spawn_error(cx);
+        self.view.draw_walk(cx, scope, walk)
+    }
+}
+
+impl ai::TerminalTarget for MpTerm {
+    fn visible_screen(&self) -> Option<ai::ScreenState> {
+        let (rows, cursor_row, cursor_col) = self.ai_screen_rows(None)?;
+        Some(ai::ScreenState {
+            rows,
+            cursor_row,
+            cursor_col,
+            cwd: self.cwd.as_ref().map(|path| path.display().to_string()),
+        })
+    }
+
+    fn recent_screen(&self, lines: usize) -> Option<ai::ScreenState> {
+        let (rows, cursor_row, cursor_col) = self.ai_screen_rows(Some(lines))?;
+        Some(ai::ScreenState {
+            rows,
+            cursor_row,
+            cursor_col,
+            cwd: self.cwd.as_ref().map(|path| path.display().to_string()),
+        })
+    }
+
+    fn type_bytes(&mut self, bytes: &[u8]) -> bool {
+        self.ai_type_bytes(bytes)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preview_quotes_the_path() {
+        assert_eq!(shell_quote("it's"), "'it'\\''s'");
+        let cmd = preview_command(Path::new("/no/such/file's.txt"));
+        assert_eq!(cmd, "less -R -- '/no/such/file'\\''s.txt'");
+        assert_eq!(preview_title(Path::new("/tmp/a b.txt")), "a b.txt \u{2014} preview");
+    }
+}
