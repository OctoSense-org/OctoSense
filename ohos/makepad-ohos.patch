-            self.ui.view(cx,ids!(content_bg)).set_visible(cx,true);
-        }
-        let current = self.current_dir();
-        if add_history && !current.as_os_str().is_empty() && current != path {
-            let tab = self.tab_mut();
-            tab.back.push(current);
