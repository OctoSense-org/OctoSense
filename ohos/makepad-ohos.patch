new file mode 100644
index 000000000..2aaee24c9
--- /dev/null
+++ b/apps/pdf/src/module.rs
@@ -0,0 +1,84 @@
+//! pdf as a module (aicontrol.md §3): the app the window manager seats in
+//! a tile in-process, in an isolate of its own. `register` puts this
+//! crate's palette and widget families into the isolate the host prepared;
+//! `create` mints one `PdfView{}` root there. A document arrives, when it
+//! does, as a handle the host issued (the `file` argument of the open
+//! schema, unused until the host has a picker to issue one); the viewer
+//! has no tools for the assistant.
+
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct PdfModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static PDF_MODULE: PdfModule = PdfModule;
+
+impl AppModule for PdfModule {
+    fn id(&self) -> &'static str {
+        "pdf"
+    }
+
+    fn label(&self) -> &'static str {
+        "PDF"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1).arg("file", OpenArgKind::FileHandle, false)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            PdfView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(NoTools { root }),
+            shutdown: Box::new(|_vm| {}),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["fs", "storage"]
+    }
+}
+
+/// An instance without tools: on the bus for the window, nothing to call.
+struct NoTools {
+    #[allow(dead_code)]
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for NoTools {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("pdf", "PDF", "A PDF viewer: one continuous scroll of pages, zoom and fit, a thumbnail strip. It exposes no tools.")
+    }
+
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "pdf has no tools"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &PDF_MODULE;
+        assert_eq!(m.id(), "pdf");
+        assert_eq!(m.label(), "PDF");
+        assert!(m.capabilities().contains(&"fs"));
+        let schema = m.open_schema();
+        assert_eq!(schema.version, 1);
+        assert!(schema.empty_open().is_ok(), "no argument is required");
+        assert!(schema.validate(r#"{"file":"/tmp/x.pdf"}"#, &[]).is_err(), "a path is never an open argument");
+    }
+}
