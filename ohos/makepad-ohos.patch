+impl FilesView {
+    /// The standalone window seats this view: it may quit the process on
+    /// its last tab and open the bus port. `warm` says whether the process
+    /// is a warm-pool standby (see `Dormancy`). Before the first event.
+    pub fn set_standalone(&mut self, warm: bool) {
+        self.standalone = true;
+        self.warm = warm;
+    }
+
+    /// Browse the demo file system instead of the disk. Before the first event.
+    pub fn set_demo(&mut self, demo: bool) {
+        self.demo = demo;
+    }
+
+    /// The folder to open first (a directory, or Home is used). Before the first event.
+    pub fn set_start(&mut self, path: Option<PathBuf>) {
+        self.start = path;
+    }
+
+    /// Where a module instance's tool answers go: the host's reply sink.
+    pub fn set_reply(&mut self, sink: Box<dyn Fn(makepad_ai_services::wire::ToolResult)>) {
+        self.reply_sink = Some(sink);
+    }
+
+    /// One tool call from a host that has no port of its own (a module's
+    /// executor): queued on the same worker the port's calls use; the
+    /// answer comes back through `set_reply`'s sink.
+    pub fn ai_answer(&mut self, cx: &mut Cx, call: &ServiceCall) {
+        let (cwd, home) = (self.current_dir(), self.home.clone());
+        let spawner = cx.thread_spawner();
+        self.ai_runner
+            .get_or_insert_with(|| ServiceRunner::new(&spawner))
+            .submit(call, cwd, home);
+    }
+
+    /// Give up on one of those calls.
+    pub fn ai_cancel(&mut self, call_id: &str) {
+        if let Some(runner) = self.ai_runner.as_mut() {
+            runner.cancel(call_id);
+        }
+    }
+
+    /// The layout follows the width the view is given: the window's, or
+    /// the tile's. Under 620 points it is the phone layout.
+    fn fit_width(&mut self, cx: &mut Cx, width: f64) {
+        self.responsive_layout(cx, width);
+    }
+    /// What the window did on `Startup`: on the first event or draw, so a
+    /// module instance (which never sees `Startup`) comes up the same way.
+    fn ensure_started(&mut self, cx: &mut Cx) {
+        if self.started {
+            return;
+        }
+        self.started = true;
+        for id in [ids!(ctx_panel),ids!(ctx_sub_panel),ids!(ql_panel)] {
+            if let Some(mut view)=self.view.view(cx,id).borrow_mut() {view.set_optimize(cx,ViewOptimize::DrawList);}
+        }
+        // Checked once: a warm-pool instance stays dormant until
+        // `WmEvent::Adopted` or a real input wakes it (see `Dormancy`).
+        self.dormancy = Dormancy::start(self.warm);
+        // The feature build and the native switch install the same closed
+        // filesystem before preferences or paths can consult a backend.
+        // A module instance asks for it by its open argument; a host without
+        // a home directory to browse gets it too, rather than an empty temp.
+        if self.demo || vfs::demo_requested() || !crate::model::home_dir().is_dir() {
+            vfs::install(Arc::new(demo::DemoVfs::new()));
+        }
+        // The block view's saved rendering and whether its filter sidebar
+        // was left open — both come back exactly as they were left.
+        self.projection = match model::pref_get("projection").as_deref() {
+            Some("ortho") => MapProjection::Ortho,
+            Some("persp") => MapProjection::Persp,
+            _ => MapProjection::default(),
+        };
+        self.filter_popup_open = model::pref_get("filter_side").as_deref() == Some("1");
+        let (sender, receiver) = mpsc::channel();
+        self.sender = Some(sender);
+        self.receiver = Some(receiver);
+        let (size_sender, size_receiver) = mpsc::channel();
+        self.size_sender = Some(size_sender);
+        self.size_receiver = Some(size_receiver);
+        self.ops = if vfs().is_instant() {
+            None
+        } else {
+            Some(Ops::new(Box::new(SignalToUI::set_ui_signal), &cx.thread_spawner()))
+        };
+        self.home = vfs().home();
+        // The desktop's assistant hears about this instance now — unless it
+        // is a warm-pool standby, which waits for `Adopted` so a dormant
+        // process never shows up as a running Files.
+        if !self.warm {
+            self.open_ai_port(cx);
+        }
+        // The demo must not write to the real home, so its bookmarks live and
+        // die with the window.
+        self.bookmarks = if vfs::is_demo() {
+            Bookmarks::in_memory(Vec::new())
+        } else {
+            Bookmarks::load(&crate::model::makepad_home())
+        };
+        let palette = &Palette::for_cx(cx);
+        let colors = contents::Colors {
+            dim: Palette::vec4(&palette.fg_dim),
+            selection: Palette::vec4(&palette.sel),
+        };
+        self.with_contents(cx, |contents, cx| {
+            contents.set_colors(cx, colors);
+            contents.set_zoom(cx, DEFAULT_ZOOM);
+        });
+        // An explicit folder argument wins over Home; wm passes none.
+        let start = self
+            .start
+            .take()
+            .filter(|p| vfs().is_dir(p))
+            .unwrap_or_else(|| self.home.clone());
+        // The first tab opens on the space view: where the bytes are is the
+        // question a file manager gets asked first.
+        self.tabs = vec![Tab::new(start, if self.phone_layout {ViewMode::Icons}else{ViewMode::Treemap})];
+        self.tab = 0;
+        // Warm and still dormant: no disk scan and no thumbnails until
+        // `wake` runs it — see `Dormancy`.
+        if self.dormancy.is_dormant() {
+            log!("files: warm-start dormant, deferring the initial scan");
+        } else {
+            self.enter_tab(cx);
+        }
+    }
+}
