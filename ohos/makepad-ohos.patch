+//! files as a library: the file browser widget ([`FilesView`]), its model,
+//! views, thumbnails, operations and tools, and — for a host that links
+//! it — the module ([`module`]) the window manager seats in a tile
+//! IN-PROCESS, one instance per isolate, without a `Window` or a process.
+//! The standalone binary (`src/main.rs`, feature `standalone`) is the same
+//! crate with a `Window` around `FilesView{}`.
+
+pub use makepad_widgets;
+use makepad_widgets::*;
+
+pub mod bookmarks;
+#[cfg(feature = "chat")]
+pub mod chat_agent;
+#[cfg(feature = "chat")]
+pub mod chat_panel;
+pub mod ai_service;
+pub mod chat_tools;
+pub mod contents;
+pub mod demo;
+pub mod menu;
+pub mod model;
+pub mod ops;
+pub mod preview;
+pub mod rename;
+pub mod sizecache;
+pub mod theme;
+pub mod thumbs;
+pub mod treemap;
+pub mod treemap_view;
+pub mod vfs;
+pub mod module;
+pub mod view;
+
+pub use module::{FilesModule, FILES_MODULE};
+pub use view::{Dormancy, FilesView};
+
+#[cfg(not(feature = "chat"))]
+mod no_chat {
+    use makepad_widgets::*;
+
+    script_mod! {
+        use mod.prelude.widgets.*
+        mod.widgets.MpfChatPanel = View{visible: false width: 0 height: 0}
+    }
+}
+
+/// This crate's script modules, into a VM whose widgets module and WM
+/// palette are already there: the palette's `mod.mpf` tokens first, then
+/// the widget families, the view last.
+pub fn register(vm: &mut ScriptVm) {
+    crate::theme::Palette::for_vm(vm).publish(vm);
+    crate::theme::script_mod(vm);
+    crate::thumbs::script_mod(vm);
+    crate::treemap_view::script_mod(vm);
+    crate::contents::script_mod(vm);
+    #[cfg(feature = "chat")]
+    crate::chat_panel::script_mod(vm);
+    #[cfg(not(feature = "chat"))]
+    crate::no_chat::script_mod(vm);
+    crate::view::script_mod(vm);
+}
