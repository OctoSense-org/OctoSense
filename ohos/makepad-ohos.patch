diff --git a/apps/weather/src/module.rs b/apps/weather/src/module.rs
new file mode 100644
index 000000000..409a53404
--- /dev/null
+++ b/apps/weather/src/module.rs
@@ -0,0 +1,80 @@
+//! weather as a module (aicontrol.md §3): the app the window manager seats
+//! in a tile in-process, in an isolate of its own. `register` puts this
+//! crate's widget families into the isolate the host prepared; `create`
+//! mints one `WeatherView{}` root there, which fetches Open-Meteo through
+//! the host's network. The weather has no tools for the assistant: its
+//! executor answers every call as unavailable.
+
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct WeatherModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static WEATHER_MODULE: WeatherModule = WeatherModule;
+
+impl AppModule for WeatherModule {
+    fn id(&self) -> &'static str {
+        "weather"
+    }
+
+    fn label(&self) -> &'static str {
+        "Weather"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            WeatherView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(NoTools { root }),
+            shutdown: Box::new(|_vm| {}),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["net"]
+    }
+}
+
+/// An instance without tools: on the bus for the window, nothing to call.
+struct NoTools {
+    #[allow(dead_code)]
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for NoTools {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("weather", "Weather", "Current conditions and a five-day forecast for a chosen city. It exposes no tools.")
+    }
+
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "weather has no tools"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &WEATHER_MODULE;
+        assert_eq!(m.id(), "weather");
+        assert_eq!(m.label(), "Weather");
+        assert!(m.capabilities().contains(&"net"));
+        assert!(m.open_schema().empty_open().is_ok(), "no argument is required");
+    }
+}
