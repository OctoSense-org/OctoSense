-                    draw.empty_texture(slot);
-                }
-            }
-            draw.set_uniform(cx, live_id!(source_y_flip), &[snapshot.source_y_flip]);
-            draw.set_uniform(cx, live_id!(has_gauss), &[1.0]);
-        } else {
-            for slot in 0..=GAUSS_VIEW_LEVELS {
-                draw.empty_texture(slot);
