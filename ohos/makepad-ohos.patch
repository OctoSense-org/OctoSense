+//! fabric as a library: the pattern-drafting workspace widget
+//! ([`FabricView`]) — a photo in, a fitted sewing pattern out — and the
+//! module ([`module`]) a host links to seat it in-process. The standalone
+//! binary (`src/main.rs`, feature `standalone`) is the same crate with a
+//! `Window` around `FabricView{}`.
+
+pub use makepad_widgets;
+use makepad_widgets::*;
+
+pub(crate) mod body_view;
+pub(crate) mod camera;
+pub(crate) mod install;
+pub mod module;
+pub(crate) mod pattern_view;
+pub(crate) mod pipeline;
+pub mod view;
+
+pub use module::{FabricModule, FABRIC_MODULE};
+pub use view::FabricView;
+
+/// This crate's widget families (and the model install panel they seat),
+/// into a VM whose widgets module exists.
+pub fn register(vm: &mut ScriptVm) {
+    makepad_ai_hub_ui::script_mod(vm);
+    body_view::script_mod(vm);
+    pattern_view::script_mod(vm);
+    view::script_mod(vm);
+}
