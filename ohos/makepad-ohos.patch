diff --git a/platform/src/os/linux/open_harmony/vk_native.rs b/platform/src/os/linux/open_harmony/vk_native.rs
new file mode 100644
index 000000000..49cd9892f
--- /dev/null
+++ b/platform/src/os/linux/open_harmony/vk_native.rs
@@ -0,0 +1,112 @@
+//! What the Vulkan backend (`os/linux/vulkan.rs`) needs from the platform's
+//! native window layer, in the NDK's names so that file compiles unchanged
+//! on OpenHarmony. The backend was written against Android: a refcounted
+//! `ANativeWindow` handed to `VK_KHR_android_surface`, and `AHardwareBuffer`
+//! imports for video. Here the window is the XComponent's `OHNativeWindow`
+//! (refcounted through `OH_NativeWindow_NativeObject{Reference,Unreference}`),
+//! the surface comes from `VK_OHOS_surface`, and hardware buffers do not
+//! exist: their entry points are stubs that never succeed, so the video
+//! paths stay compiled but inert.
+
+use std::os::raw::{c_int, c_void};
+
+/// `OHNativeWindow`, opaque.
+#[repr(C)]
+pub struct ANativeWindow {
+    _unused: [u8; 0],
+}
+
+/// No hardware buffers on OpenHarmony: never constructed.
+#[repr(C)]
+pub struct AHardwareBuffer {
+    _unused: [u8; 0],
+}
+
+#[link(name = "native_window")]
+extern "C" {
+    fn OH_NativeWindow_NativeObjectReference(obj: *mut c_void) -> c_int;
+    fn OH_NativeWindow_NativeObjectUnreference(obj: *mut c_void) -> c_int;
+}
+
+pub unsafe fn ANativeWindow_acquire(window: *mut ANativeWindow) {
+    if !window.is_null() {
+        let _ = OH_NativeWindow_NativeObjectReference(window as *mut c_void);
+    }
+}
+
+pub unsafe fn ANativeWindow_release(window: *mut ANativeWindow) {
+    if !window.is_null() {
+        let _ = OH_NativeWindow_NativeObjectUnreference(window as *mut c_void);
+    }
+}
+
+pub unsafe fn AHardwareBuffer_acquire(_buffer: *mut AHardwareBuffer) {}
+
+pub unsafe fn AHardwareBuffer_release(_buffer: *mut AHardwareBuffer) {}
+
+/// `VK_OHOS_surface`: the extension name, the `VkSurfaceCreateInfoOHOS`
+/// structure and the instance-level `vkCreateSurfaceOHOS`, fetched through
+/// `vkGetInstanceProcAddr` since ash has no binding for it.
+pub mod surface {
+    use ash::vk;
+    use std::ffi::CStr;
+    use std::os::raw::c_void;
+
+    pub const EXTENSION_NAME: &CStr = c"VK_OHOS_surface";
+    /// `VK_STRUCTURE_TYPE_SURFACE_CREATE_INFO_OHOS` from the SDK's vulkan_core.h.
+    const STRUCTURE_TYPE_SURFACE_CREATE_INFO_OHOS: i32 = 1000685000;
+
+    #[repr(C)]
+    struct SurfaceCreateInfoOHOS {
+        s_type: vk::StructureType,
+        p_next: *const c_void,
+        flags: u32,
+        window: *mut c_void,
+    }
+
+    type PfnCreateSurfaceOHOS = unsafe extern "system" fn(
+        instance: vk::Instance,
+        create_info: *const SurfaceCreateInfoOHOS,
+        allocator: *const vk::AllocationCallbacks<'_>,
+        surface: *mut vk::SurfaceKHR,
+    ) -> vk::Result;
+
+    /// The loader for this extension, the shape ash gives its own.
+    #[derive(Clone)]
+    pub struct Instance {
+        handle: vk::Instance,
+        create_surface: Option<PfnCreateSurfaceOHOS>,
+    }
+
+    impl Instance {
+        pub fn new(entry: &ash::Entry, instance: &ash::Instance) -> Self {
+            let create_surface = unsafe {
+                entry.get_instance_proc_addr(instance.handle(), c"vkCreateSurfaceOHOS".as_ptr())
+            }
+            .map(|f| unsafe { std::mem::transmute::<_, PfnCreateSurfaceOHOS>(f) });
+            Instance { handle: instance.handle(), create_surface }
+        }
+
+        pub unsafe fn create_surface(
+            &self,
+            window: *mut super::ANativeWindow,
+        ) -> Result<vk::SurfaceKHR, String> {
+            let Some(create) = self.create_surface else {
+                return Err("vkCreateSurfaceOHOS is not exported by this Vulkan loader".into());
+            };
+            let info = SurfaceCreateInfoOHOS {
+                s_type: vk::StructureType::from_raw(STRUCTURE_TYPE_SURFACE_CREATE_INFO_OHOS),
+                p_next: std::ptr::null(),
+                flags: 0,
+                window: window as *mut c_void,
+            };
+            let mut surface = vk::SurfaceKHR::null();
+            let result = create(self.handle, &info, std::ptr::null(), &mut surface);
+            if result == vk::Result::SUCCESS {
+                Ok(surface)
+            } else {
+                Err(format!("vkCreateSurfaceOHOS failed: {result:?}"))
+            }
+        }
+    }
+}
