+/// The typed fetch for every vertex/instance io, in the mapping's order:
+/// geometry, dyn instances, rust instances. Returns the chunk attributes,
+/// the `<var> = <expr>;` assignments for `vertex_main` (led by a comment
+/// with the byte layout) and the number of geometry chunks.
+fn wgsl_typed_vertex_inputs(
+    output: &ShaderOutput,
+    vm: &ScriptVm,
+) -> (Vec<WgslTypedAttr>, Vec<String>, usize) {
+    let geometry_kinds: [(fn(&ShaderIoKind) -> bool, &str); 1] =
+        [(|k| matches!(k, ShaderIoKind::VertexBuffer), "vb_")];
+    let instance_kinds: [(fn(&ShaderIoKind) -> bool, &str); 2] = [
+        (|k| matches!(k, ShaderIoKind::DynInstance), "dyninst_"),
+        (|k| matches!(k, ShaderIoKind::RustInstance), "rustinst_"),
+    ];
+    let (geometry_ios, geometry_stride) = wgsl_typed_record(output, vm, &geometry_kinds);
+    let (instance_ios, instance_stride) = wgsl_typed_record(output, vm, &instance_kinds);
+    let mut location = 0usize;
+    let geometry_chunks = wgsl_typed_chunks(geometry_stride, &mut location);
+    let geometry_chunk_count = geometry_chunks.len();
+    let instance_chunks = wgsl_typed_chunks(instance_stride, &mut location);
+
+    let mut assigns = Vec::new();
+    let mut layout = format!("    // typed fetch: geometry stride {geometry_stride}, instance stride {instance_stride};");
+    for (ios, chunks) in [(&geometry_ios, &geometry_chunks), (&instance_ios, &instance_chunks)] {
+        for io in ios {
+            let exprs = io
+                .leaves
+                .iter()
+                .map(|(offset, ty)| {
+                    layout.push_str(&format!(" {}@{offset}", io.var));
+                    wgsl_typed_leaf_expr(output, vm, chunks, *offset, ty)
+                })
+                .collect::<Vec<_>>();
+            let expr = match &io.struct_name {
+                Some(name) => format!("{}({})", name, exprs.join(", ")),
+                None => exprs.into_iter().next().unwrap_or_default(),
+            };
+            assigns.push(format!("    {} = {expr};", io.var));
+        }
+    }
+    assigns.insert(0, layout);
+    let mut attrs = geometry_chunks;
+    attrs.extend(instance_chunks);
+    (attrs, assigns, geometry_chunk_count)
+}
