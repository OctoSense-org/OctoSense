diff --git a/apps/score/src/module.rs b/apps/score/src/module.rs
new file mode 100644
index 000000000..a85e48c4e
--- /dev/null
+++ b/apps/score/src/module.rs
@@ -0,0 +1,80 @@
+//! score as a module (aicontrol.md §3): the app the window manager seats
+//! in a tile in-process, in an isolate of its own. `register` puts the
+//! score widget families into the isolate the host prepared; `create`
+//! mints one `ScoreView{}` root there, which opens the shipped piece. The
+//! score has no tools for the assistant: its executor answers every call
+//! as unavailable.
+
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct ScoreModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static SCORE_MODULE: ScoreModule = ScoreModule;
+
+impl AppModule for ScoreModule {
+    fn id(&self) -> &'static str {
+        "score"
+    }
+
+    fn label(&self) -> &'static str {
+        "Score"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            ScoreView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(NoTools { root }),
+            shutdown: Box::new(|_vm| {}),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["audio.output", "midi"]
+    }
+}
+
+/// An instance without tools: on the bus for the window, nothing to call.
+struct NoTools {
+    #[allow(dead_code)]
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for NoTools {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("score", "Score", "A notation editor and pianist viewer for sheet music. It exposes no tools.")
+    }
+
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "score has no tools"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &SCORE_MODULE;
+        assert_eq!(m.id(), "score");
+        assert_eq!(m.label(), "Score");
+        assert!(m.capabilities().contains(&"audio.output"));
+        assert!(m.open_schema().empty_open().is_ok(), "no argument is required");
+    }
+}
