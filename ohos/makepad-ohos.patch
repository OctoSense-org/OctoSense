+    /// Load the model, once. A machine without the weights on it says so and
+    /// carries on being a file browser.
+    #[cfg(feature = "chat")]
+    fn start_chat(&mut self, cx: &mut Cx) {
+        let Some(model) = chat_agent::model_path() else {
+            self.chat.push(
+                ChatVoice::Info,
