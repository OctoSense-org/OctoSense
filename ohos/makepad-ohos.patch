+/// The `--config <file|KEY=VALUE>` pairs among the build's cargo args: a
+/// `[patch]` given that way changes where dependencies live, so the
+/// `cargo tree` that locates their resources has to see it too.
+pub fn cargo_config_args(args: &[String]) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < args.len() {
+        if args[i] == "--config" {
+            if let Some(value) = args.get(i + 1) {
+                out.push("--config".to_string());
+                out.push(value.clone());
+            }
+            i += 2;
+            continue;
+        }
+        if args[i].starts_with("--config=") {
+            out.push(args[i].clone());
+        }
+        i += 1;
+    }
+    out
