new file mode 100644
index 000000000..5928c1d59
--- /dev/null
+++ b/apps/video/src/module.rs
@@ -0,0 +1,90 @@
+//! video as a module (aicontrol.md §3): the player the window manager
+//! seats in a tile in-process, in an isolate of its own. `register` puts
+//! this crate's palette and widget families into the isolate the host
+//! prepared; `create` mints one `VideoView{}` root there. The player has
+//! no tools for the assistant: its executor answers every call as
+//! unavailable. A clip arrives, when it does, as a handle the host issued
+//! (the `file` argument, unused until the host has a picker to issue one).
+
+use crate::view::VideoView;
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct VideoModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static VIDEO_MODULE: VideoModule = VideoModule;
+
+impl AppModule for VideoModule {
+    fn id(&self) -> &'static str {
+        "video"
+    }
+
+    fn label(&self) -> &'static str {
+        "Video"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1).arg("file", OpenArgKind::FileHandle, false)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            VideoView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        if let Some(mut view) = root.borrow_mut::<VideoView>() {
+            view.set_hosted(vm.cx_mut(), true);
+        }
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(NoTools { root }),
+            // The player drops with the root (its decode task stops on its
+            // own); the soundtrack queue is silenced right away.
+            shutdown: Box::new(|_vm| crate::player::stop_audio()),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["fs", "audio.output"]
+    }
+}
+
+/// An instance without tools: on the bus for the window, nothing to call.
+struct NoTools {
+    #[allow(dead_code)]
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for NoTools {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("video", "Video", "A video player. It exposes no tools.")
+    }
+
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "video has no tools"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &VIDEO_MODULE;
+        assert_eq!(m.id(), "video");
+        assert_eq!(m.label(), "Video");
+        assert!(m.capabilities().contains(&"audio.output"));
+        let schema = m.open_schema();
+        assert_eq!(schema.version, 1);
+        assert!(schema.empty_open().is_ok(), "no argument is required");
+        assert!(schema.validate(r#"{"file":"/tmp/x.mp4"}"#, &[]).is_err(), "a path is never an open argument");
+    }
+}
diff --git a/apps/video/src/view.rs b/apps/video/src/view.rs
new file mode 100644
index 000000000..0a53fe417
--- /dev/null
+++ b/apps/video/src/view.rs
@@ -0,0 +1,158 @@
+//! The player as one root widget: `MpVideoView` over the status line the
+//! standalone window also shows, so a host that seats the module
+//! in-process gets the same face without a `Window`. The first event or
+//! draw does what the standalone app did on `Startup`: the speakers and
+//! the silent-start rule (`wants_mute`).
+
+use crate::widget::{format_time, MpVideoAction, MpVideoView};
+use makepad_widgets::*;
+
+script_mod! {
+    use mod.prelude.widgets_internal.*
+    use mod.widgets.*
+
+    mod.widgets.VideoViewBase = #(VideoView::register_widget(vm))
+
+    mod.widgets.VideoView = set_type_default() do mod.widgets.VideoViewBase{
+        width: Fill
+        height: Fill
+        flow: Down
+        spacing: 0
+        padding: 0
+        show_bg: true
+        draw_bg +: { color: mod.mpv.bg }
+
+        player := MpVideoView{
+            width: Fill
+            height: Fill
+        }
+
+        status_row := RectView{
+            width: Fill
+            height: 22
+            align: Align{y: 0.5}
+            padding: Inset{left: 10 right: 10 top: 0 bottom: 0}
+            draw_bg +: { color: mod.mpv.bg }
+
+            status := Label{
+                width: Fill
+                max_lines: 1
+                text_overflow: TextOverflow.Ellipsis
+                text: ""
+                draw_text +: {
+                    color: mod.mpv.fg
+                    text_style: theme.font_regular{font_size: 9}
+                }
+            }
+        }
+    }
+}
+
+#[derive(Script, ScriptHook, Widget)]
+pub struct VideoView {
+    #[source]
+    source: ScriptObjectRef,
+    #[deref]
+    view: View,
+    /// The startup ran: speakers registered, the silent-start rule applied.
+    #[rust]
+    started: bool,
+    /// Seated by a host (the module): the player never ends the process.
+    #[rust]
+    hosted: bool,
+}
+
+impl VideoView {
+    /// The host seats this root in its own process.
+    pub fn set_hosted(&mut self, cx: &mut Cx, hosted: bool) {
+        self.hosted = hosted;
+        if let Some(mut player) = self.view.widget(cx, ids!(player)).borrow_mut::<MpVideoView>() {
+            player.set_hosted(hosted);
+        }
+    }
+
+    /// Open `path` in the player.
+    pub fn open(&mut self, cx: &mut Cx, path: &std::path::Path) {
+        self.ensure_started(cx);
+        if let Some(mut player) = self.view.widget(cx, ids!(player)).borrow_mut::<MpVideoView>() {
+            player.open(cx, path);
+        }
+    }
+
+    /// Stop and blank the player, keeping the widget.
+    pub fn unload(&mut self, cx: &mut Cx) {
+        if let Some(mut player) = self.view.widget(cx, ids!(player)).borrow_mut::<MpVideoView>() {
+            player.unload(cx);
+        }
+    }
+
+    /// What the app did on `Startup`: on the first event or draw, so a
+    /// module instance (which never sees `Startup`) comes up the same way.
+    fn ensure_started(&mut self, cx: &mut Cx) {
+        if self.started {
+            return;
+        }
+        self.started = true;
+        // Speakers: the clip's soundtrack, mixed from the decode queue.
+        cx.audio_output(0, move |info, output| {
+            output.zero();
+            crate::player::mix_into(output, info.sample_rate);
+        });
+        // Silent start where nobody should hear it — see `wants_mute`.
+        let muted = crate::wants_mute(&[], |key| std::env::var(key).ok());
+        if let Some(mut player) = self.view.widget(cx, ids!(player)).borrow_mut::<MpVideoView>() {
+            player.set_muted(muted);
+            player.set_hosted(self.hosted);
+        }
+    }
+
+    fn show_status(&mut self, cx: &mut Cx, status: &MpVideoAction) {
+        let MpVideoAction::Status {
+            name, width, height, fps, position_secs, duration_secs, playing, ended, volume_pct, muted, bare, error,
+        } = status else { return };
+        let text = if let Some(error) = error {
+            format!("{name}    cannot play \u{2014} {error}")
+        } else if name.is_empty() {
+            String::new()
+        } else if *width == 0 {
+            format!("{name}    opening\u{2026}")
+        } else {
+            let state = if *ended { "ended" } else if *playing { "playing" } else { "paused" };
+            let sound = if *muted { "muted".to_string() } else { format!("vol {volume_pct}%") };
+            format!(
+                "{name}    {width}\u{00d7}{height}    {fps:.0} fps    {state}    {} / {}    {sound}",
+                format_time(*position_secs),
+                format_time(*duration_secs),
+            )
+        };
+        self.view.label(cx, ids!(status)).set_text(cx, &text);
+        // Double-clicked into bare mode: the picture is the whole face.
+        self.view.widget(cx, ids!(status_row)).set_visible(cx, !*bare);
+    }
+}
+
+impl MatchEvent for VideoView {
+    fn handle_audio_devices(&mut self, cx: &mut Cx, devices: &AudioDevicesEvent) {
+        cx.use_audio_outputs(&devices.default_output());
+    }
+
+    fn handle_actions(&mut self, cx: &mut Cx, actions: &Actions) {
+        let uid = self.view.widget(cx, ids!(player)).widget_uid();
+        for action in actions.filter_widget_actions_cast::<MpVideoAction>(uid) {
+            self.show_status(cx, &action);
+        }
+    }
+}
+
+impl Widget for VideoView {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.ensure_started(cx);
+        self.match_event(cx, event);
+        self.view.handle_event(cx, event, scope);
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        self.ensure_started(cx);
+        self.view.draw_walk(cx, scope, walk)
+    }
+}
