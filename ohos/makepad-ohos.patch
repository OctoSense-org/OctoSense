-                KeyCode::Equals | KeyCode::NumpadAdd if !editing => return self.zoom(cx, 1),
-                KeyCode::Minus | KeyCode::NumpadSubtract if !editing => return self.zoom(cx, -1),
-                KeyCode::KeyH => return self.toggle_hidden(cx),
