new file mode 100644
index 000000000..55170e32d
--- /dev/null
+++ b/apps/mixer/src/view.rs
@@ -0,0 +1,363 @@
+//! The mixer's root widget: the search page and the surface, the client
+//! thread, the model and the layout binder, in one widget the standalone
+//! window seats under a `Window` and the window manager seats in a tile
+//! in-process (`module.rs`). Nothing here knows about a window: the first
+//! event or draw runs the startup an app would run on `Startup`, and
+//! dropping the widget drops the client, which stops its thread.
+//!
+//! SAFETY: the wire is still the closed whitelist in `safety.rs`; this
+//! widget only turns surface gestures into `Cmd::Set` of those parameters.
+
+use crate::client::{guess_directed_broadcast, Client, Cmd, Evt};
+use crate::model::MixerModel;
+use crate::surface::SurfaceBinder;
+use crate::theme::Palette;
+use makepad_widgets::*;
+use std::net::SocketAddr;
+use std::sync::Arc;
+
+/// Posted by the client thread whenever new events are queued.
+#[derive(Debug)]
+struct NetPing;
+
+const LAYOUTS: &[(&str, &str)] = &[("LR MIX", "lr_mix"), ("COMPACT", "compact")];
+
+/// Reconcile passes after the initial sweep, and how far apart they sit.
+const RESWEEP_ROUNDS: u32 = 8;
+const RESWEEP_EVERY: std::time::Duration = std::time::Duration::from_millis(1200);
+
+fn load_layout_body(name: &str) -> String {
+    let candidates = [
+        format!("apps/mixer/layouts/{name}.splash"),
+        format!("{}/layouts/{name}.splash", env!("CARGO_MANIFEST_DIR")),
+    ];
+    for c in &candidates {
+        if let Ok(s) = std::fs::read_to_string(c) {
+            return s;
+        }
+    }
+    match name {
+        "lr_mix" => include_str!("../layouts/lr_mix.splash").to_string(),
+        "compact" => include_str!("../layouts/compact.splash").to_string(),
+        _ => String::new(),
+    }
+}
+
+script_mod! {
+    use mod.prelude.widgets_internal.*
+    use mod.widgets.*
+
+    mod.widgets.MixerViewBase = #(MixerView::register_widget(vm))
+
+    // The desk is flat and dark: the ground is the theme's own background,
+    // not the stock neutral (`theme.rs` publishes `mod.mpm` from the WM
+    // palette, or Tokyo Night when there is none).
+    mod.widgets.MixerView = set_type_default() do mod.widgets.MixerViewBase{
+        width: Fill
+        height: Fill
+        flow: Down
+        show_bg: true
+        draw_bg.color: mod.mpm.bg_dark
+        searching := View{
+            width: Fill
+            height: Fill
+            flow: Down
+            align: Align{x: 0.5, y: 0.5}
+            spacing: 14
+
+            Label{
+                text: "Searching for your mixer"
+                draw_text.color: mod.mpm.fg_bright
+                draw_text.text_style: theme.font_code{font_size: 15.0}
+            }
+            search_note := Label{
+                text: "listening for a console on the local network"
+                draw_text.color: mod.mpm.fg_dim
+                draw_text.text_style: theme.font_code{font_size: 9.0}
+            }
+            LoadingSpinner{
+                width: 34
+                height: 34
+                draw_bg +: {
+                    color: uniform(mod.mpm.accent)
+                }
+            }
+        }
+
+        surface_panel := View{
+            visible: false
+            width: Fill
+            height: Fill
+            flow: Down
+            surface := Splash{
+                width: Fill
+                height: Fill
+            }
+        }
+    }
+}
+
+#[derive(Script, ScriptHook, Widget)]
+pub struct MixerView {
+    #[source]
+    source: ScriptObjectRef,
+    #[deref]
+    view: View,
+    /// The startup ran: the client thread, the layout, the first scan.
+    #[rust]
+    started: bool,
+    #[rust]
+    client: Option<Client>,
+    #[rust]
+    model: MixerModel,
+    #[rust]
+    binder: SurfaceBinder,
+    #[rust]
+    layout_idx: usize,
+    #[rust]
+    connected: Option<SocketAddr>,
+    /// Reconcile rounds run so far: after the sweep drains, anything the
+    /// console did not answer is asked for again, round after round, until
+    /// nothing is missing (or the cap is reached).
+    #[rust]
+    resweep_rounds: u32,
+    #[rust]
+    sweep_drained_at: Option<std::time::Instant>,
+}
+
+impl MixerView {
+    fn splash_ref(&self, cx: &mut Cx) -> WidgetRef {
+        self.view.widget(cx, ids!(surface))
+    }
+
+    fn load_layout(&mut self, cx: &mut Cx) {
+        let (_label, file) = LAYOUTS[self.layout_idx];
+        // A Splash body runs in its own isolate VM with a FRESH stock
+        // `mod.theme`, so the desktop palette cannot reach a layout through
+        // the theme — the host hands it over as one prepended line binding
+        // `mp` (see theme.rs and the layout headers).
+        let body = format!(
+            "{}{}",
+            Palette::for_cx(cx).splash_preamble(),
+            load_layout_body(file)
+        );
+        let splash = self.splash_ref(cx);
+        splash.set_text(cx, &body);
+        self.binder.rebind(cx, &splash);
+        self.binder.sync_all(cx, &self.model);
+        self.view.redraw(cx);
+    }
+
+    /// The whole app is two pages: the search page, and the surface.
+    fn show_surface(&mut self, cx: &mut Cx, on: bool) {
+        self.view.view(cx, ids!(searching)).set_visible(cx, !on);
+        self.view.view(cx, ids!(surface_panel)).set_visible(cx, on);
+        self.view.redraw(cx);
+    }
+
+    /// The one status line, at the top of the surface layout.
+    fn note(&mut self, cx: &mut Cx, text: &str) {
+        self.binder.set_note(cx, text);
+        let _ = self.view.label(cx, ids!(search_note)).set_text(cx, text);
+    }
+
+    fn drain_net(&mut self, cx: &mut Cx) {
+        let Some(client) = &self.client else { return };
+        let mut sync_needed = false;
+        let mut events = Vec::new();
+        while let Ok(e) = client.evt_rx.try_recv() {
+            events.push(e);
+        }
+        for e in events {
+            match e {
+                Evt::Found { info, from } => {
+                    // First console that answers wins — no list, no choice.
+                    if self.connected.is_none() {
+                        let what = info.model.as_deref().unwrap_or("mixer").to_string();
+                        println!("[mixer] connecting to {what} at {from}");
+                        self.note(cx, &format!("found {what} — reading its state"));
+                        if let Some(client) = &self.client {
+                            client.cmd(Cmd::Connect { addr: from });
+                        }
+                    }
+                }
+                Evt::Connected { addr } => {
+                    self.connected = Some(addr);
+                    self.model.clear();
+                    self.resweep_rounds = 0;
+                    self.sweep_drained_at = None;
+                    // The surface is a control surface: it moves the desk.
+                    if let Some(client) = &self.client {
+                        client.cmd(Cmd::SetControl(true));
+                    }
+                    self.show_surface(cx, true);
+                    self.binder.sync_all(cx, &self.model);
+                }
+                Evt::Disconnected => {
+                    self.connected = None;
+                    self.show_surface(cx, false);
+                    self.note(cx, "lost the console — searching again");
+                }
+                Evt::Info(info) => {
+                    self.model.device = Some(info);
+                }
+                Evt::Param(p, v) => {
+                    if self.model.apply(p, v) {
+                        if self.binder.slot_count() > 0 {
+                            self.binder.push_param(cx, &self.model, p);
+                        }
+                        sync_needed = true;
+                    }
+                }
+                Evt::Meters { bank, vals } => {
+                    self.binder.push_meters(cx, &self.model, bank, &vals);
+                }
+                Evt::Health { rx_age, stale, sweep_left } => {
+                    // Reconcile: the console drops answers when it is busy,
+                    // so keep asking for what is still blank until the
+                    // surface is complete. Names, colours and link state
+                    // are exactly what goes missing.
+                    if sweep_left == 0 && self.resweep_rounds < RESWEEP_ROUNDS {
+                        let now = std::time::Instant::now();
+                        let due = match self.sweep_drained_at {
+                            None => {
+                                self.sweep_drained_at = Some(now);
+                                false
+                            }
+                            Some(t) => now.duration_since(t) >= RESWEEP_EVERY,
+                        };
+                        if due {
+                            self.sweep_drained_at = Some(now);
+                            let missing = self.binder.missing_params(&self.model);
+                            self.resweep_rounds += 1;
+                            if missing.is_empty() {
+                                println!(
+                                    "[mixer] surface complete after {} reconcile round(s)",
+                                    self.resweep_rounds - 1
+                                );
+                                self.resweep_rounds = RESWEEP_ROUNDS;
+                            } else {
+                                println!(
+                                    "[mixer] reconcile {}/{}: re-requesting {} unanswered parameters",
+                                    self.resweep_rounds,
+                                    RESWEEP_ROUNDS,
+                                    missing.len()
+                                );
+                                if let Some(client) = &self.client {
+                                    for p in missing {
+                                        client.cmd(Cmd::Get(p));
+                                    }
+                                }
+                            }
+                        }
+                    }
+                    let dev = self
+                        .model
+                        .device
+                        .as_ref()
+                        .map(|d| d.summary())
+                        .unwrap_or_default();
+                    let txt = if stale {
+                        format!(
+                            "{dev} — nothing heard for {:.0}s",
+                            rx_age.as_secs_f32()
+                        )
+                    } else if sweep_left > 0 {
+                        format!("{dev} · reading state ({} left)", sweep_left)
+                    } else {
+                        String::new()
+                    };
+                    self.note(cx, &txt);
+                }
+                Evt::Note(n) => {
+                    println!("[mixer] {n}");
+                }
+            }
+        }
+        let _ = sync_needed;
+    }
+
+}
+
+impl MixerView {
+    /// Start on a named surface layout (`lr_mix`, `compact`); unknown names
+    /// keep the default. Takes effect at startup, or on the next reload.
+    pub fn set_layout(&mut self, name: &str) {
+        if let Some(i) = LAYOUTS.iter().position(|(_, f)| *f == name) {
+            self.layout_idx = i;
+        }
+    }
+
+    /// What the app did on `Startup`: on the first event or draw, so a
+    /// module instance (which never sees `Startup`) comes up the same way.
+    fn ensure_started(&mut self, cx: &mut Cx) {
+        if self.started { return; }
+        self.started = true;
+
+
+        let notify: Arc<dyn Fn() + Send + Sync> = Arc::new(|| Cx::post_action(NetPing));
+        match Client::start(notify) {
+            Ok(c) => {
+                println!("[mixer] client socket bound to {}", c.local_addr);
+                self.client = Some(c);
+            }
+            Err(e) => log!("client failed to start: {e}"),
+        }
+
+        self.load_layout(cx);
+        self.show_surface(cx, false);
+
+        // Discovery is automatic and stays automatic: one /xinfo query to
+        // the local broadcast, repeated about once a second for as long as
+        // no console is connected. Nothing else goes out unbidden.
+        match guess_directed_broadcast() {
+            Some(target) => {
+                println!("[mixer] searching for a console on {target}");
+                if let Some(client) = &self.client {
+                    client.cmd(Cmd::Scan { target });
+                }
+            }
+            None => {
+                self.note(cx, "no network interface to search on");
+            }
+        }
+    }
+}
+
+impl MatchEvent for MixerView {
+    fn handle_actions(&mut self, cx: &mut Cx, actions: &Actions) {
+        for action in actions {
+            if action.downcast_ref::<NetPing>().is_some() {
+                self.drain_net(cx);
+                break;
+            }
+        }
+
+        // Surface gestures. The app is a control surface — what you move on
+        // it moves on the desk. (The wire is still the closed whitelist:
+        // faders, mutes, pan, preamp gain, EQ. Phantom power, scenes and
+        // presets are not expressible, see safety.rs.)
+        let cmds = self.binder.handle_actions(cx, actions, &self.model);
+        if !cmds.is_empty() {
+            if let Some(client) = &self.client {
+                for (p, v) in cmds {
+                    client.cmd(Cmd::Set(p, v));
+                }
+            }
+        }
+    }
+}
+
+impl Widget for MixerView {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.ensure_started(cx);
+        if matches!(event, Event::LiveEdit) { self.load_layout(cx); }
+        self.match_event(cx, event);
+        self.view.handle_event(cx, event, scope);
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        self.ensure_started(cx);
+        self.view.draw_walk(cx, scope, walk)
+    }
+}
