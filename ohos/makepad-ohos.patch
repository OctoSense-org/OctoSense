+// ---- The typed (compact) vertex fetch -------------------------------------
+//
+// A shader whose vertex or instance record holds a compact leaf (f16x2,
+// i16x2, u8x4norm, ...) cannot be fed as f32 lanes: the record is the
+// CPU-side repr(C) struct. On this path every record is fetched as
+// consecutive 16-byte chunks of raw `u32` words (R32G32B32A32_UINT, a
+// shorter vector for the tail), one attribute per chunk, geometry chunks
+// first then instance chunks, at consecutive locations — and each field is
+// read out of its chunk words by byte offset: f32 lanes by bitcast, 32-bit
+// integers as they are, compact leaves through WGSL's unpack builtins. The
+// Vulkan backend binds the same chunks (`typed_record_chunks`) at the
+// mapping's `stride_bytes`; the byte layout below mirrors
+// `CxDrawShaderMapping::push_pod_fields` + `DrawShaderInputs::push`, and
+// the emitted WGSL carries it as a comment.
+//
+// Unsigned words, not floats: a float vertex fetch is a conversion, and
+// the Maleoon driver on the Mate 70 Air canonicalises NaN patterns and
+// flushes denormals in it — which is what a pair of small or negative i16
+// coordinates, or a packed colour, looks like as an f32 — so the bits that
+// reach the shader are not the bits in the buffer. Integer fetches are
+// exact.
+
+/// A typed vertex attribute as declared on `VertexMainIn`: one record chunk.
+struct WgslTypedAttr {
+    name: String,
+    ty_name: String,
+}
+
+/// Bytes and alignment of one physical input, as `DrawShaderInputs::push`
+/// lays it out (compact formats by their own size, everything else as
+/// `slots * 4` bytes on a 4-byte boundary).
+fn wgsl_attr_bytes(ty: &ScriptPodTy) -> (usize, usize) {
+    use crate::pod::ScriptPodPacked as P;
+    match ty {
+        ScriptPodTy::Packed(p) => match p {
+            P::U8x4Norm | P::I8x4Norm => (4, 1),
+            P::F16x4 => (8, 2),
+            _ => (4, 2),
+        },
+        other => (other.slots().max(1) * 4, 4),
+    }
+}
+
+/// One io of a typed record: its variable, its struct name when the io is
+/// a compact struct rebuilt field by field, and its leaves' byte offsets.
+struct WgslTypedIo {
+    var: String,
+    struct_name: Option<String>,
+    leaves: Vec<(usize, ScriptPodTypeInline)>,
+}
+
+/// Every vertex/instance input holds a plain f32-lane type: the vec4-chunk
+/// path applies. Any compact leaf anywhere switches the whole shader to the
+/// typed fetch (the same rule the GLSL emitter and the mapping use).
+fn wgsl_vertex_fetch_is_f32(output: &ShaderOutput, vm: &ScriptVm) -> bool {
+    output.io.iter().all(|io| match io.kind {
+        ShaderIoKind::VertexBuffer | ShaderIoKind::DynInstance | ShaderIoKind::RustInstance => {
+            !vm.bx.heap.pod_type_ref(io.ty).ty.has_compact_format()
+        }
+        _ => true,
+    })
+}
+
+/// The byte layout of one record (geometry, or dyn+rust instances):
+/// its ios and the stride.
+fn wgsl_typed_record(
+    output: &ShaderOutput,
+    vm: &ScriptVm,
+    kinds: &[(fn(&ShaderIoKind) -> bool, &str)],
+) -> (Vec<WgslTypedIo>, usize) {
+    let mut ios = Vec::new();
+    let mut stride = 0usize;
+    let place = |ty: &ScriptPodTy, stride: &mut usize| -> usize {
+        let (size, align) = wgsl_attr_bytes(ty);
+        if align > 1 && *stride % align != 0 {
+            *stride += align - (*stride % align);
+        }
+        let offset = *stride;
+        *stride += size;
+        offset
+    };
+    for (wanted, prefix) in kinds {
+        for io in output.io.iter().filter(|io| wanted(&io.kind)) {
+            let io_name = output.backend.map_io_name(io.name);
+            let pod_ty = vm.bx.heap.pod_type_ref(io.ty);
+            let inline = ScriptPodTypeInline { self_ref: io.ty, data: pod_ty.clone() };
+            let (struct_name, leaves) = match &pod_ty.ty {
+                ScriptPodTy::Struct { fields, .. } if pod_ty.ty.has_compact_format() => (
+                    Some(wgsl_type_name_inline(output, vm, &inline)),
+                    fields
+                        .iter()
+                        .map(|field| (place(&field.ty.data.ty, &mut stride), field.ty.clone()))
+                        .collect::<Vec<_>>(),
+                ),
+                other => (None, vec![(place(other, &mut stride), inline)]),
+            };
+            ios.push(WgslTypedIo { var: format!("{prefix}{io_name}"), struct_name, leaves });
+        }
+    }
+    (ios, stride)
+}
+
+/// The chunk attributes a record of `stride` bytes is fetched as, named
+/// from `location` on: (name, WGSL type) per chunk.
+fn wgsl_typed_chunks(stride: usize, location: &mut usize) -> Vec<WgslTypedAttr> {
+    let words = (stride + 3) / 4;
+    let mut out = Vec::new();
+    let mut done = 0usize;
+    while done < words {
+        let n = (words - done).min(4);
+        let ty_name = if n == 1 { "u32".to_string() } else { format!("vec{n}u") };
+        out.push(WgslTypedAttr { name: format!("vin_{location}"), ty_name });
+        *location += 1;
+        done += n;
+    }
+    out
+}
+
+/// The expression for word `w` of a record fetched as `chunks`.
+fn wgsl_typed_word(chunks: &[WgslTypedAttr], w: usize) -> String {
+    let chunk = &chunks[w / 4];
+    if chunk.ty_name == "u32" {
+        format!("in.{}", chunk.name)
+    } else {
+        format!("in.{}.{}", chunk.name, wgsl_swizzle_component(w % 4))
     }
 }
 
+/// Rebuild one leaf's logical value from its record words.
+fn wgsl_typed_leaf_expr(
+    output: &ShaderOutput,
+    vm: &ScriptVm,
+    chunks: &[WgslTypedAttr],
+    byte_offset: usize,
+    ty: &ScriptPodTypeInline,
+) -> String {
+    let w = byte_offset / 4;
+    if let ScriptPodTy::Packed(p) = &ty.data.ty {
+        use crate::pod::ScriptPodPacked as P;
+        // Compact leaves are logical vec2f / vec4f in shader code.
+        let bits = wgsl_typed_word(chunks, w);
+        return match p {
+            P::F16x2 => format!("unpack2x16float({bits})"),
+            P::F16x4 => format!(
+                "vec4f(unpack2x16float({bits}), unpack2x16float({}))",
+                wgsl_typed_word(chunks, w + 1)
+            ),
+            P::U16x2Norm => format!("unpack2x16unorm({bits})"),
+            P::I16x2Norm => format!("unpack2x16snorm({bits})"),
+            P::U8x4Norm => format!("unpack4x8unorm({bits})"),
+            P::I8x4Norm => format!("unpack4x8snorm({bits})"),
+            P::U16x2 => format!("vec2f(f32({bits} & 0xffffu), f32({bits} >> 16u))"),
+            P::I16x2 => {
+                let sbits = format!("bitcast<i32>({bits})");
+                format!("vec2f(f32(({sbits} << 16u) >> 16u), f32({sbits} >> 16u))")
+            }
+        };
+    }
+    let scalars = (0..ty.data.ty.slots().max(1))
+        .map(|i| wgsl_typed_word(chunks, w + i))
