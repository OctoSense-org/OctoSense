diff --git a/apps/fab/src/module.rs b/apps/fab/src/module.rs
new file mode 100644
index 000000000..7caf24806
--- /dev/null
+++ b/apps/fab/src/module.rs
@@ -0,0 +1,79 @@
+//! fab as a module (aicontrol.md §3): the app the window manager seats in
+//! a tile in-process, in an isolate of its own. `register` puts the shell's
+//! widget families and this crate's root into the isolate the host
+//! prepared; `create` mints one `FabView{}` root there, which opens the
+//! demo house. Fab has no tools for the assistant: its executor answers
+//! every call as unavailable.
+
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct FabModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static FAB_MODULE: FabModule = FabModule;
+
+impl AppModule for FabModule {
+    fn id(&self) -> &'static str {
+        "fab"
+    }
+
+    fn label(&self) -> &'static str {
+        "Fab"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            FabView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(NoTools { root }),
+            shutdown: Box::new(|_vm| {}),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["storage"]
+    }
+}
+
+/// An instance without tools: on the bus for the window, nothing to call.
+struct NoTools {
+    #[allow(dead_code)]
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for NoTools {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("fab", "Fab", "A digital-fabrication and architecture modeller. It exposes no tools.")
+    }
+
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "fab has no tools"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &FAB_MODULE;
+        assert_eq!(m.id(), "fab");
+        assert_eq!(m.label(), "Fab");
+        assert!(m.open_schema().empty_open().is_ok(), "no argument is required");
+    }
+}
