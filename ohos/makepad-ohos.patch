-        let count = paths.len();
-        self.clipboard = paths;
-        self.clipboard_cut = cut;
-        self.status(
-            cx,
-            &format!(
-                "{} {} item{} — Cmd+V pastes {} here or in another tab",
-                if cut { "Cut" } else { "Copied" },
-                count,
-                if count == 1 { "" } else { "s" },
-                if count == 1 { "it" } else { "them" }
-            ),
-        );
