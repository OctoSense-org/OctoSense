@@ -0,0 +1,86 @@
+//! route as a module (aicontrol.md §3): the app the window manager seats
+//! in a tile in-process, in an isolate of its own. `register` puts this
+//! crate's widget families into the isolate the host prepared; `create`
+//! mints one `RouteView{}` root there and hands the host its tools: the
+//! same tools the standalone binary answers over its port, executed on the
+//! root at call time (they are synchronous).
+
+use crate::view::RouteView;
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct RouteModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static ROUTE_MODULE: RouteModule = RouteModule;
+
+impl AppModule for RouteModule {
+    fn id(&self) -> &'static str {
+        "route"
+    }
+
+    fn label(&self) -> &'static str {
+        "Route"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            RouteView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(RouteExecutor { root }),
+            shutdown: Box::new(|_vm| {}),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["net", "location", "storage", "audio.output", "audio.input"]
+    }
+}
+
+/// The instance's tools, executed on the root at call time.
+struct RouteExecutor {
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for RouteExecutor {
+    fn manifest(&self) -> ServiceManifest {
+        crate::ai::manifest()
+    }
+
+    fn execute(&mut self, cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        let result = self
+            .root
+            .borrow_mut::<RouteView>()
+            .map(|mut view| view.ai_answer(cx, call))
+            .unwrap_or_else(|| ToolResult::unavailable(&call.call_id, "the map is gone"));
+        ExecOutcome::Done(result)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &ROUTE_MODULE;
+        assert_eq!(m.id(), "route");
+        assert_eq!(m.label(), "Route");
+        assert!(m.capabilities().contains(&"location"));
+        assert!(m.open_schema().empty_open().is_ok(), "no argument is required");
+        assert!(m.open_schema().validate(r#"{"path":"/tmp/x"}"#, &[]).is_err(), "a path is never an open argument");
+    }
+}
