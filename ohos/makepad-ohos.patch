+//! fab as a library: the Fab root widget ([`FabView`]) — the shell from
+//! `makepad-fab-shell` over the app state and the feature-selected loaders
+//! — and the module ([`module`]) a host links to seat it in-process. The
+//! standalone binary (`src/main.rs`, feature `standalone`) is the same
+//! crate with a `Window` around `FabView{}`.
+
+pub use makepad_widgets;
+use makepad_widgets::*;
+
+pub mod module;
+pub mod view;
+
+pub use module::{FabModule, FAB_MODULE};
+pub use view::FabView;
+
+/// This crate's widget families, into a VM whose widgets module exists:
+/// the shell's (theme, kit, editors) and the root view.
+pub fn register(vm: &mut ScriptVm) {
+    fab::script_mod(vm);
+    view::script_mod(vm);
+}
