+//! score as a library: the notation editor and pianist viewer as one root
+//! widget ([`ScoreView`]) over `makepad-score-ui`, and the module
+//! ([`module`]) a host links to seat it in-process. The standalone binary
+//! (`src/main.rs`, feature `standalone`) is the same crate with a `Window`
+//! around `ScoreView{}`.
+
+pub use makepad_widgets;
+use makepad_widgets::*;
+use score_ui::font::ensure_default_font;
+
+pub mod module;
+pub mod view;
+
+pub use module::{ScoreModule, SCORE_MODULE};
+pub use view::ScoreView;
+
+/// This crate's widget families, into a VM whose widgets module exists.
+/// The music font is registered BEFORE anything engraves: the spacing pass
+/// asks for it the moment a document exists, and the state builds one
+/// during construction — a frame later would be too late, and the font
+/// resolves exactly once.
+pub fn register(vm: &mut ScriptVm) {
+    ensure_default_font();
+    score_ui::script_mod(vm);
+    view::script_mod(vm);
+}
