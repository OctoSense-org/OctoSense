+//! clock as a library: the clock widget with its two faces
+//! ([`ClockView`]), and the module ([`module`]) a host links to seat it
+//! in-process. The standalone binary (`src/main.rs`, feature `standalone`)
+//! is the same crate with a `Window` around `ClockView{}`.
+
+pub use makepad_widgets;
+use makepad_widgets::*;
+
+pub mod alarm;
+pub mod alarm_list;
+pub mod face;
+pub mod local_time;
+pub mod module;
+pub mod view;
+pub mod wheel;
+
+pub use module::{ClockModule, CLOCK_MODULE};
+pub use view::ClockView;
+
+/// This crate's widget families, into a VM whose widgets module exists.
+pub fn register(vm: &mut ScriptVm) {
+    face::script_mod(vm);
+    wheel::script_mod(vm);
+    alarm_list::script_mod(vm);
+    view::script_mod(vm);
+}
