--- /dev/null
+++ b/apps/image/src/module.rs
@@ -0,0 +1,89 @@
+//! image as a module (aicontrol.md §3): the app the window manager seats
+//! in a tile in-process, in an isolate of its own. `register` puts this
+//! crate's widget families into the isolate the host prepared; `create`
+//! mints one `ImageView{}` root there, an empty canvas until a file
+//! handle arrives. The viewer has no tools for the assistant: its executor
+//! answers every call as unavailable.
+
+use crate::view::ImageView;
+use makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult};
+use makepad_app_module::*;
+use makepad_widgets::*;
+
+pub struct ImageModule;
+
+/// The one linked instance of the module description: immutable, no state.
+pub static IMAGE_MODULE: ImageModule = ImageModule;
+
+impl AppModule for ImageModule {
+    fn id(&self) -> &'static str {
+        "image"
+    }
+
+    fn label(&self) -> &'static str {
+        "Image"
+    }
+
+    fn register(&self, vm: &mut ScriptVm) {
+        crate::register(vm);
+    }
+
+    fn open_schema(&self) -> OpenSchema {
+        // A picture arrives as a handle the host issued; unused until the
+        // host has a picker to issue one.
+        OpenSchema::new(1).arg("file", OpenArgKind::FileHandle, false)
+    }
+
+    fn create(&self, vm: &mut ScriptVm, _open: ValidatedOpen, _handles: InstanceHandles) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            ImageView {}
+        });
+        let root = WidgetRef::script_from_value(vm, value);
+        if let Some(mut view) = root.borrow_mut::<ImageView>() {
+            view.set_hosted(vm.cx_mut(), true);
+        }
+        InstanceParts {
+            root: root.clone(),
+            executor: Box::new(NoTools { root }),
+            shutdown: Box::new(|_vm| {}),
+        }
+    }
+
+    fn capabilities(&self) -> &'static [&'static str] {
+        &["fs"]
+    }
+}
+
+/// An instance without tools: on the bus for the window, nothing to call.
+struct NoTools {
+    #[allow(dead_code)]
+    root: WidgetRef,
+}
+
+impl ServiceExecutor for NoTools {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("image", "Image", "A picture viewer: fit, zoom and pan one image, step through its folder. It exposes no tools.")
+    }
+
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(&call.call_id, "image has no tools"))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_module_describes_itself_and_opens_empty() {
+        let m = &IMAGE_MODULE;
+        assert_eq!(m.id(), "image");
+        assert_eq!(m.label(), "Image");
+        assert!(m.capabilities().contains(&"fs"));
+        let schema = m.open_schema();
+        assert_eq!(schema.version, 1);
+        assert!(schema.empty_open().is_ok(), "no argument is required");
+        assert!(schema.validate(r#"{"file":"/tmp/x.png"}"#, &[]).is_err(), "a path is never an open argument");
+    }
+}
