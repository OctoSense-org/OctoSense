+++ b/apps/image/src/view.rs
@@ -0,0 +1,116 @@
+//! The viewer's root: the picture (`MpImageView`) over a one-line status
+//! bar, in one widget the standalone window seats under a `Window` and the
+//! window manager seats in a tile in-process (`module.rs`). Nothing here
+//! knows about a window or a process: opening a file, the preview mode and
+//! the close key's meaning are set by whoever seats it.
+
+use crate::widget::{MpImageAction, MpImageView};
+use makepad_widgets::*;
+use std::path::Path;
+
+script_mod! {
+    use mod.prelude.widgets_internal.*
+    use mod.widgets.*
+
+    mod.widgets.ImageViewBase = #(ImageView::register_widget(vm))
+
+    mod.widgets.ImageView = set_type_default() do mod.widgets.ImageViewBase{
+        width: Fill
+        height: Fill
+        flow: Down
+        spacing: 0
+        padding: 0
+
+        viewer := MpImageView{
+            width: Fill
+            height: Fill
+        }
+
+        status_row := RectView{
+            width: Fill
+            height: 22
+            align: Align{y: 0.5}
+            padding: Inset{left: 10 right: 10 top: 0 bottom: 0}
+            draw_bg +: { color: theme.color_bg_container }
+
+            status := Label{
+                width: Fill
+                max_lines: 1
+                text_overflow: TextOverflow.Ellipsis
+                text: ""
+                draw_text +: {
+                    color: theme.color_text_meta
+                    text_style: theme.font_regular{font_size: 9}
+                }
+            }
+        }
+    }
+}
+
+#[derive(Script, ScriptHook, Widget)]
+pub struct ImageView {
+    #[source]
+    source: ScriptObjectRef,
+    #[deref]
+    view: View,
+}
+
+impl ImageView {
+    /// Open `path` (its folder becomes the Left/Right sequence).
+    pub fn open(&mut self, cx: &mut Cx, path: &Path) {
+        if let Some(mut viewer) = self.view.widget(cx, ids!(viewer)).borrow_mut::<MpImageView>() {
+            viewer.open(cx, path);
+        }
+    }
+
+    /// Drop the picture and the folder listing: an empty canvas.
+    pub fn unload(&mut self, cx: &mut Cx) {
+        if let Some(mut viewer) = self.view.widget(cx, ids!(viewer)).borrow_mut::<MpImageView>() {
+            viewer.unload(cx);
+        }
+    }
+
+    /// A warm Quick Look panel: the close key hides it instead of quitting.
+    pub fn set_preview(&mut self, cx: &mut Cx, preview: bool) {
+        if let Some(mut viewer) = self.view.widget(cx, ids!(viewer)).borrow_mut::<MpImageView>() {
+            viewer.set_preview(preview);
+        }
+    }
+
+    /// A module instance inside a host: the close key does nothing.
+    pub fn set_hosted(&mut self, cx: &mut Cx, hosted: bool) {
+        if let Some(mut viewer) = self.view.widget(cx, ids!(viewer)).borrow_mut::<MpImageView>() {
+            viewer.set_hosted(hosted);
+        }
+    }
+}
+
+impl MatchEvent for ImageView {
+    fn handle_actions(&mut self, cx: &mut Cx, actions: &Actions) {
+        let uid = self.view.widget(cx, ids!(viewer)).widget_uid();
+        for action in actions.filter_widget_actions_cast::<MpImageAction>(uid) {
+            if let MpImageAction::Status { name, width, height, zoom_pct } = action {
+                let text = if name.is_empty() {
+                    // An unloaded viewer has nothing to say.
+                    String::new()
+                } else if width > 0 && height > 0 {
+                    format!("{}    {}\u{00d7}{}    {}%", name, width, height, zoom_pct)
+                } else {
+                    format!("{}    loading\u{2026}", name)
+                };
+                self.view.label(cx, ids!(status)).set_text(cx, &text);
+            }
+        }
+    }
+}
+
+impl Widget for ImageView {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.match_event(cx, event);
