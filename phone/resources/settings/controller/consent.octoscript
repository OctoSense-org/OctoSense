// Native default-app and runtime-permission consent: script owns the screens,
// while every effect remains a reviewed, opaque native choice.
fn settings_decimal_newer(a,b) {
    if a==nil { return false }
    if b==nil { return true }
    if a.len()!=b.len() { return a.len()>b.len() }
    let aa=a.to_chars(); let bb=b.to_chars(); let i=0
    while i<aa.len() { if aa[i]!=bb[i] { return aa[i]>bb[i] }; i=i+1 }
    return false
}
fn settings_consent_ui(s,domain) {
    if s[domain]==nil { s[domain]={selected:nil,offset:0,generation:nil,last:nil,notice:"",pressed:nil,row_pressed:nil} }
    return s[domain]
}
fn settings_roles_catalog() { return [
    ["Browser","browser","Browser"],["Home","home","Home app"],["Assistant","assistant","Digital assistant"],
    ["Dialer","dialer","Phone app"],["Sms","sms","SMS app"],["CallScreening","call_screening","Call screening"],
    ["CallRedirection","call_redirection","Call redirection"],["Wallet","wallet","Wallet"]
] }
fn settings_permission_catalog() { return [
    ["Camera","camera","Camera"],["Microphone","microphone","Microphone"],["Location","location","Location"],
    ["Contacts","contacts","Contacts"],["Calendar","calendar","Calendar"],["Phone","phone","Phone"],
    ["CallLog","call_log","Call logs"],["Sms","sms","SMS"],["NearbyDevices","nearby_devices","Nearby devices"],
    ["ActivityRecognition","activity_recognition","Physical activity"],["Sensors","sensors","Body sensors"]
] }
fn settings_consent_meta(domain,variant) {
    let catalog=settings_roles_catalog()
    if domain=="permission_ui" { catalog=settings_permission_catalog() }
    for row in catalog { if row[0]==variant { return {wire:row[1],label:row[2]} } }
    return nil
}
fn settings_consent_observed(s,o,domain) {
    let ui=settings_consent_ui(s,domain)
    let row=o.roles
    if domain=="permission_ui" {
        row=o.permissions
        if row==nil || row.package!=s.context["app_target"] || row.group!=ui.selected { return nil }
    } else if row==nil || row.role!=ui.selected { return nil }
    if row.availability!="Available" || (domain=="permission_ui" && row.group!=nil) || row.offset==ui.offset { return row }
    return nil
}
fn settings_consent_read(s,out,domain) {
    let ui=settings_consent_ui(s,domain)
    let selected=nil
    if ui.selected!=nil { selected=settings_consent_meta(domain,ui.selected).wire }
    if domain=="roles_ui" { settings_request(out,{kind:"read",domain:"roles",role:selected,offset:ui.offset,generation:ui.generation}); return }
    if s.context["app_target"]!=nil {
        let offset=ui.offset; let generation=ui.generation
        if selected!=nil { offset=0; generation=nil }
        settings_request(out,{kind:"read",domain:"permissions",package:s.context["app_target"],group:selected,offset:offset,generation:generation})
    }
}
fn settings_consent_observe(s,o,domain,out) {
    let ui=settings_consent_ui(s,domain)
    let row=o.roles; let selected=nil
    if domain=="permission_ui" { row=o.permissions; if row!=nil { selected=row.group }; if row!=nil && row.package!=s.context["app_target"] { return } }
    else if row!=nil { selected=row.role }
    if row==nil || selected!=ui.selected || !settings_decimal_newer(row.request_id,ui.last) { return }
    ui.last=row.request_id
    if row.stale && row.offset==0 && (domain=="roles_ui" || selected==nil) {
        ui.offset=0
        if domain=="roles_ui" { ui.notice="Available apps changed. Showing the first page."; settings_scroll(out,"role_choices_page") }
        else { ui.notice="Permission groups changed. Showing the first page."; settings_scroll(out,"app_permissions_page") }
    }
    if row.offset==ui.offset && row.availability=="Available" { ui.generation=row.generation }
}
fn settings_consent_candidate(s,o,domain,index,none) {
    if o.android!=true || s.pending { return nil }
    let ui=settings_consent_ui(s,domain)
    let row=settings_consent_observed(s,o,domain)
    if row==nil || row.availability!="Available" || row.key==nil || ui.selected==nil { return nil }
    let target=nil
    if domain=="roles_ui" {
        if none { target=row.none_target }
        else if index<row.candidates.len() && row.candidates[index].can_select { target=row.candidates[index].target }
        if target!=nil { return {kind:"roles",role:settings_consent_meta(domain,ui.selected).wire,key:row.key,target:target} }
    } else if row.exists==true && index<row.choices.len() {
        let choice=row.choices[index]
        if choice.enabled && choice.target!=nil { return {kind:"permission",package:row.package,group:settings_consent_meta(domain,ui.selected).wire,key:row.key,target:choice.target} }
    }
    return nil
}
fn settings_consent_held(ui,e,target) {
    if e.kind=="press" { ui.pressed=nil; if target!=nil { ui.pressed={id:e.id,value:target.to_json()} }; return false }
    if e.kind=="release" { ui.pressed=nil; return false }
    if e.kind!="click" { return false }
    let previous=ui.pressed; ui.pressed=nil
    return target!=nil && (previous==nil || (previous.id==e.id && previous.value==target.to_json()))
}
fn settings_consent_event(s,e,o,out) {
    let roles=settings_consent_ui(s,"roles_ui"); let permissions=settings_consent_ui(s,"permission_ui")
    if e.kind=="pause" || e.kind=="entry" || e.kind=="navigate" || e.kind=="back" || (e.kind=="click" && e.id=="back") {
        roles.pressed=nil; permissions.pressed=nil; roles.row_pressed=nil; permissions.row_pressed=nil
        if e.kind=="entry" || e.kind=="navigate" { roles.selected=nil; roles.offset=0; roles.generation=nil; roles.notice=""; permissions.selected=nil; permissions.offset=0; permissions.generation=nil; permissions.notice="" }
    }
    if s.page=="DefaultApps" || s.page=="RoleChoices" { settings_consent_observe(s,o,"roles_ui",out) }
    if s.page=="AppPermissions" || s.page=="PermissionChoices" { settings_consent_observe(s,o,"permission_ui",out) }
    if s.page=="PermissionChoices" && (e.kind=="back" || (e.kind=="click" && e.id=="back")) {
        permissions.selected=nil; s.page="AppPermissions"; settings_consent_read(s,out,"permission_ui"); settings_scroll(out,"app_permissions_page"); return true
    }
    if s.page=="RoleChoices" && (e.kind=="back" || (e.kind=="click" && e.id=="back")) {
        roles.selected=nil; roles.offset=0; roles.generation=nil; s.page="DefaultApps"; settings_consent_read(s,out,"roles_ui"); settings_scroll(out,"default_apps_page"); return true
    }
    if s.page=="AppDetails" && e.kind=="click" && e.id=="app_permission_settings" {
        let details=settings_selected_details(s,o)
        if o.android==true && !s.pending && details!=nil && details.exists {
            permissions.selected=nil; permissions.offset=0; permissions.generation=nil; permissions.notice=""; permissions.pressed=nil
            s.page="AppPermissions"; settings_consent_read(s,out,"permission_ui"); settings_scroll(out,"app_permissions_page")
        }
        return true
    }
    if s.page=="Apps" && e.kind=="click" && e.id=="apps_defaults" {
        roles.selected=nil; roles.offset=0; roles.generation=nil; roles.notice=""; roles.pressed=nil
        s.page="DefaultApps"; settings_consent_read(s,out,"roles_ui"); settings_scroll(out,"default_apps_page"); return true
    }
    let domain=""
    if s.page=="DefaultApps" || s.page=="RoleChoices" { domain="roles_ui" }
    if s.page=="AppPermissions" || s.page=="PermissionChoices" { domain="permission_ui" }
    if domain=="" { return false }
    let ui=settings_consent_ui(s,domain); let observed=settings_consent_observed(s,o,domain)
    let ready=o.android==true && !s.pending
    if e.kind=="click" {
        if settings_has(["roles_refresh","role_refresh","permissions_refresh","permission_refresh"],e.id) { if ready { settings_consent_read(s,out,domain) }; return true }
        if settings_has(["roles_native","role_native"],e.id) { if ready { settings_request(out,{kind:"open",destination:"default_apps"}) }; return true }
        if settings_has(["permissions_native","permission_native"],e.id) {
            let details=settings_selected_details(s,o)
            if ready && details!=nil && settings_has(details.actions,"AppInfo") { settings_request(out,{kind:"app_action",target:details.target,action:"AppInfo"}) }
            return true
        }
        let previous=settings_has(["role_previous","role_previous_bottom","permission_groups_previous"],e.id)
        let next=settings_has(["role_next","role_next_bottom","permission_groups_next"],e.id)
        if previous || next {
            if ready && observed!=nil {
                let offset=settings_max(0,observed.offset-20)
                if next { offset=observed.offset+20 }
                if offset<observed.total {
                    ui.offset=offset; ui.generation=observed.generation; ui.pressed=nil
                    settings_consent_read(s,out,domain); settings_scroll(out,settings_active_scroll(s.page))
                }
            }
            return true
        }
    }
    if s.page=="DefaultApps" {
        let i=0
        for meta in settings_roles_catalog() {
            if e.id=="role_overview_"+i && e.kind=="click" {
                if ready && observed!=nil { for row in observed.roles { if row.role==meta[0] && row.available { ui.selected=row.role; ui.offset=0; ui.generation=nil; ui.notice=""; s.page="RoleChoices"; settings_consent_read(s,out,domain); settings_scroll(out,"role_choices_page") } } }
                return true
            }
            i=i+1
        }
    } else if s.page=="AppPermissions" {
        let i=0
        while i<20 {
            if e.id=="permission_group_"+i {
                let target=nil
                if ready && observed!=nil && i<observed.groups.len() { let row=observed.groups[i]; if row.group!=nil { target={group:row.group,target:row.target} } }
                if settings_consent_held(ui,e,target) { ui.selected=target.group; s.page="PermissionChoices"; settings_consent_read(s,out,domain); settings_scroll(out,"permission_choices_page") }
                return true
            }
            i=i+1
        }
    } else {
        let count=20; let prefix="role_row_"
        if domain=="permission_ui" { count=9; prefix="permission_choice_" }
        let i=0
        while i<count {
            if e.id==prefix+i || (domain=="roles_ui" && e.id=="role_none") {
                let request=settings_consent_candidate(s,o,domain,i,e.id=="role_none")
                if settings_consent_held(ui,e,request) { settings_request(out,request) }
                return true
            }
            i=i+1
        }
    }
    return false
}
fn settings_consent_availability(domain,status) {
    if status=="Available" { return "" }
    if domain=="roles_ui" {
        if status=="Unsupported" { return "This default-app role is not supported on this device." }
        if status=="Restricted" { return "Default-app choices are unavailable while locked or restricted." }
        return "Default-app choices are unavailable on this installation. Android default-app settings remain available below."
    }
    if status=="Unsupported" { return "This permission group is not available for this app." }
    if status=="Restricted" { return "Permission choices are unavailable while locked or restricted." }
    return "Permission controls are unavailable on this installation. Android app settings remain available below."
}
fn settings_consent_refresh(s,o,out) {
    let ready=o.android==true && !s.pending
    let details=settings_selected_details(s,o)
    settings_enabled(out,"app_permission_settings",ready && details!=nil && details.exists)
    if s.page=="DefaultApps" || s.page=="RoleChoices" {
        let ui=settings_consent_ui(s,"roles_ui"); let observed=settings_consent_observed(s,o,"roles_ui")
        let availability="Waiting for Android default-app choices…"
        if observed!=nil { availability=settings_consent_availability("roles_ui",observed.availability) }
        settings_text(out,"roles_availability",availability)
        let overview=nil; let i=0
        for meta in settings_roles_catalog() {
            let row=nil
            if observed!=nil { for candidate in observed.roles { if candidate.role==meta[0] { row=candidate } } }
            let label=meta[2]; let current="Unavailable"
            if row!=nil { label=row.label; current="None"; if row.holder!=nil { current=row.holder.label }; if !row.available { current="Unsupported" } }
            settings_text(out,"role_overview_"+i,label+"\n"+current)
            settings_enabled(out,"role_overview_"+i,ready && row!=nil && row.available)
            if meta[0]==ui.selected { overview=row }
            i=i+1
        }
        let identity=""; let summary=""
        if ui.selected!=nil { identity=settings_consent_meta("roles_ui",ui.selected).label }
        if overview!=nil {
            let holder="None"
            if overview.holder!=nil { holder=overview.holder.label+"\n"+overview.holder.package }
            identity=overview.label+"\nCurrent: "+holder
        }
        if observed!=nil && observed.availability=="Available" {
            availability="Choosing an app opens Android’s confirmation. Restricted apps remain unavailable; Android settings can explain their restrictions."
            if overview!=nil && overview.restricted { availability="Default-app changes are restricted by Android or your administrator." }
            summary="No eligible apps are currently available."
            if observed.total>0 { summary=""+(observed.offset+1)+"–"+(observed.offset+observed.candidates.len())+" of "+observed.total+" eligible apps"; if observed.truncated { summary=summary+" (first 2,000 shown)" } }
        }
        settings_text(out,"role_identity",identity); settings_text(out,"role_availability",availability)
        settings_text(out,"role_page",summary); settings_text(out,"role_notice",ui.notice)
        i=0
        while i<20 {
            let id="role_row_"+i; let row=nil
            if observed!=nil && i<observed.candidates.len() { row=observed.candidates[i] }
            settings_visible(out,id,row!=nil)
            let request=settings_consent_candidate(s,o,"roles_ui",i,false)
            settings_enabled(out,id,request!=nil)
            if row!=nil { let status="Restricted"; if row.can_select { status="Choose…" }; if row.selected { status="Selected" }; settings_text(out,id,row.label+"\n"+row.package+"\n"+status); settings_patch(out,"semantic",id,"role:"+ui.selected+":"+row.target) }
            i=i+1
        }
        let none="Choose none…"
        if overview!=nil && overview.holder==nil { none="None · Selected" }
        settings_text(out,"role_none",none)
        let request=settings_consent_candidate(s,o,"roles_ui",0,true)
        settings_enabled(out,"role_none",request!=nil)
        if request!=nil { settings_patch(out,"semantic","role_none","role:"+ui.selected+":"+request.target) }
        for id in ["roles_refresh","role_refresh","roles_native","role_native"] { settings_enabled(out,id,ready) }
        for id in ["role_previous","role_previous_bottom"] { settings_enabled(out,id,ready && observed!=nil && observed.offset>0) }
        for id in ["role_next","role_next_bottom"] { settings_enabled(out,id,ready && observed!=nil && observed.offset+20<observed.total && observed.generation!=nil) }
    }
    if s.page=="AppPermissions" || s.page=="PermissionChoices" {
        let ui=settings_consent_ui(s,"permission_ui"); let observed=settings_consent_observed(s,o,"permission_ui")
        let identity=settings_or(s.context["app_target"],"")
        let availability="Waiting for Android permission choices…"; let summary=""; let detail=""
        if observed!=nil {
            identity=settings_or(observed.app_label,"Android app")+"\n"+observed.package
            availability=settings_consent_availability("permission_ui",observed.availability)
            if observed.availability=="Available" && observed.exists==false { availability="This app is no longer installed." }
            detail=settings_or(observed.detail,"")
            if observed.availability=="Available" && observed.exists==true && observed.group==nil {
                summary="No runtime permission groups are requested by this app."
                if observed.total>0 { summary=""+(observed.offset+1)+"–"+(observed.offset+observed.groups.len())+" of "+observed.total+" permission groups"; if observed.truncated { summary=summary+" (first 64 shown)" } }
            }
        }
        let group="App"; if ui.selected!=nil { group=settings_consent_meta("permission_ui",ui.selected).label }
        if s.page=="PermissionChoices" { settings_text(out,"title",group+" permissions") }
        for prefix in ["permissions","permission"] {
            settings_text(out,prefix+"_identity",identity); settings_text(out,prefix+"_availability",availability)
            settings_enabled(out,prefix+"_refresh",ready)
            settings_enabled(out,prefix+"_native",ready && details!=nil && settings_has(details.actions,"AppInfo"))
        }
        settings_text(out,"permissions_page",summary); settings_text(out,"permissions_notice",ui.notice); settings_text(out,"permission_detail",detail)
        let i=0
        while i<20 {
            let id="permission_group_"+i; let row=nil
            if observed!=nil && i<observed.groups.len() { row=observed.groups[i] }
            settings_visible(out,id,row!=nil); settings_enabled(out,id,ready && row!=nil && row.group!=nil)
            if row!=nil {
                let category="Not allowed"
                if row.category=="Allowed" { category="Allowed" }; if row.category=="Ask" { category="Ask every time" }
                let label=row.label+"\n"+category
                if row.subtitle!=nil { label=label+" · "+row.subtitle }
                if row.group==nil { label=label+" · Manage in Android settings" }
                settings_text(out,id,label); settings_patch(out,"semantic",id,"permission-group:"+observed.package+":"+row.target)
            }
            i=i+1
        }
        settings_enabled(out,"permission_groups_previous",ready && observed!=nil && observed.offset>0)
        settings_enabled(out,"permission_groups_next",ready && observed!=nil && observed.offset+20<observed.total && observed.generation!=nil)
        i=0
        while i<9 {
            let id="permission_choice_"+i; let row=nil
            if observed!=nil && i<observed.choices.len() { row=observed.choices[i] }
            settings_visible(out,id,row!=nil); settings_enabled(out,id,settings_consent_candidate(s,o,"permission_ui",i,false)!=nil)
            if row!=nil {
                let label=row.label; if row.selected { label=label+" · Selected" }
                settings_text(out,id,label); settings_patch(out,"label",id,group+": "+label)
                settings_patch(out,"semantic",id,"permission-choice:"+observed.package+":"+ui.selected+":"+settings_or(observed.key,"")+":"+settings_or(row.target,"")+":"+row.choice)
            }
            i=i+1
        }
    }
}
