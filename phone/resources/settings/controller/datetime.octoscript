// Civil time and zone drafts. Native validation resolves actual zone transitions.
fn settings_datetime_init(s) { if s["time_ui"]==nil { s.time_ui={clock:nil,query:"",offset:0,review:nil,pressed:nil} } }
fn settings_time_state(o) { if o.device!=nil { return o.device.time_controls }; return nil }
fn settings_civil_valid(value,min,max) {
    let c=value.to_chars(); if c.len()!=16 || c[4]!=45 || c[7]!=45 || c[10]!=32 || c[13]!=58 { return false }
    let i=0; for n in c { if !settings_has([4,7,10,13],i) && (n<48 || n>57) { return false }; i=i+1 }
    let year=(c[0]-48)*1000+(c[1]-48)*100+(c[2]-48)*10+c[3]-48
    let month=(c[5]-48)*10+c[6]-48; let day=(c[8]-48)*10+c[9]-48; let hour=(c[11]-48)*10+c[12]-48; let minute=(c[14]-48)*10+c[15]-48
    let days=0
    if settings_has([1,3,5,7,8,10,12],month) { days=31 }
    if settings_has([4,6,9,11],month) { days=30 }
    if month==2 { days=28; if year%4==0 && (year%100!=0 || year%400==0) { days=29 } }
    return year>=min && year<=max && day>=1 && day<=days && hour<24 && minute<60
}
fn settings_zone_name(zone) { return zone.replace("_"," ") }
fn settings_time_zones(s,o) {
    let rows=[]; if o.device==nil || !settings_query_valid(s.time_ui.query) { return rows }
    let query=text.lower(s.time_ui.query.trim()).replace(" ","_")
    for zone in o.device.time_zones { if query=="" || text.lower(zone).search(query)>=0 { rows.push(zone) } }
    return rows
}
fn settings_time_permits(s,o,r) {
    let t=settings_time_state(o); if t==nil || r==nil || t.key!=r.key { return false }
    if r.operation=="AutoTime" { return t.can_auto_time }; if r.operation=="AutoZone" { return t.can_auto_zone }
    if r.operation=="Clock" { return t.can_clock && !t.auto_time && settings_civil_valid(r.civil,t.minimum_year,t.maximum_year) }
    if r.operation=="Zone" { return t.can_zone && !t.auto_zone && settings_has(o.device.time_zones,r.zone) }
    return false
}
fn settings_time_candidate(s,o,id) {
    let t=settings_time_state(o); if t==nil { return nil }
    let r=nil
    if id=="auto_time" { r={kind:"datetime",key:t.key,operation:"AutoTime",enabled:!t.auto_time} }
    if id=="auto_time_zone" { r={kind:"datetime",key:t.key,operation:"AutoZone",enabled:!t.auto_zone} }
    if id=="clock_save" && s.time_ui.clock!=nil { let d=s.time_ui.clock; r={kind:"datetime",key:d.key,operation:"Clock",civil:d.civil,second:d.second} }
    if id=="zone_apply" { r=s.time_ui.review }
    let rows=settings_time_zones(s,o); let i=0
    while i<20 { if id=="zone_row_"+i && s.time_ui.offset+i<rows.len() { r={kind:"datetime",key:t.key,operation:"Zone",zone:rows[s.time_ui.offset+i]} }; i=i+1 }
    if settings_time_permits(s,o,r) { return r }; return nil
}
fn settings_datetime_event(s,e,o,out) {
    settings_datetime_init(s); let ui=s.time_ui
    if e.kind=="pause" || e.kind=="navigate" || e.kind=="entry" || e.kind=="back" { ui.pressed=nil; if e.kind!="pause" { ui.clock=nil; ui.review=nil }; return false }
    if s.page!="DateTime" && s.page!="TimeZones" { return false }
    let t=settings_time_state(o); let ready=o.android && !s.pending
    if e.kind=="input" {
        if e.id=="clock_civil" { if ui.clock!=nil { ui.clock.civil=e.value }; return true }
        if e.id=="zone_query" { ui.query=e.value; ui.offset=0; ui.review=nil; return true }
    }
    let candidate=settings_time_candidate(s,o,e.id)
    if e.kind=="press" { ui.pressed={id:e.id,request:candidate}; return candidate!=nil }
    if e.kind=="release" { ui.pressed=nil; return false }
    if e.kind!="click" || s.pending { return false }
    if e.id=="clock_cancel" { ui.clock=nil; settings_blur(out); return true }; if e.id=="zone_cancel" { ui.review=nil; return true }
    if e.id=="clock_first" || e.id=="clock_second" { if ui.clock!=nil { ui.clock.second=e.id=="clock_second" }; return true }
    if !ready { return false }
    if e.id=="clock_edit" {
        if t!=nil && t.can_clock && !t.auto_time { ui.clock={key:t.key,civil:t.civil,second:false}; settings_patch(out,"input","clock_civil",t.civil) }
        return true
    }
    if e.id=="zone_open" { if t!=nil && t.can_zone && !t.auto_zone { ui.clock=nil; ui.review=nil; ui.offset=0; s.page="TimeZones" }; return true }
    if e.id=="zone_previous" || e.id=="zone_next" {
        let zones=settings_time_zones(s,o)
        if e.id=="zone_previous" { ui.offset=settings_max(0,ui.offset-20) } else if ui.offset+20<zones.len() { ui.offset=ui.offset+20 }
        ui.review=nil; ui.pressed=nil; settings_scroll(out,"time_zones_page"); return true
    }
    if candidate!=nil {
        let held=ui.pressed; ui.pressed=nil
        if held!=nil && (held.id!=e.id || held.request.to_json()!=candidate.to_json()) { return true }
        settings_blur(out)
        if candidate.operation=="Zone" && e.id!="zone_apply" { ui.review=candidate; settings_scroll(out,"time_zones_page") }
        else { settings_request(out,candidate); ui.clock=nil; ui.review=nil }
        return true
    }
    // Consume authoritative time controls even when unavailable: no fallback to a weaker setter.
    return settings_has(["auto_time","auto_time_zone","clock_save","zone_apply"],e.id)
}
fn settings_datetime_refresh(s,o,out) {
    settings_datetime_init(s); if s.page!="DateTime" && s.page!="TimeZones" { return }
    let t=settings_time_state(o); let ui=s.time_ui; let ready=o.android && !s.pending
    let auto=nil; let zone_auto=nil; let zone="Unavailable"; let help=""; let policy="The system time service is unavailable. Manual controls require the OctoSense ROM."
    if o.device!=nil { auto=o.device.auto_time; zone_auto=o.device.auto_time_zone }
    if t!=nil {
        auto=t.auto_time; zone_auto=t.auto_zone; zone=settings_zone_name(t.zone)
        help="Date and time in "+zone+"\nEnter YYYY-MM-DD HH:MM (24-hour time), years "+t.minimum_year+"–"+t.maximum_year+"."
        policy=""; if !t.can_auto_time && !t.can_auto_zone { policy="Date and time are restricted by Android or your administrator." }
        else if t.auto_time && t.auto_zone { policy="Turn off automatic time or automatic time zone to change that value manually." }
    }
    settings_text(out,"auto_time",settings_bool_label("Automatic time",auto)); settings_text(out,"auto_time_zone",settings_bool_label("Automatic time zone",zone_auto))
    for id in ["auto_time","auto_time_zone","clock_save","zone_apply"] { settings_enabled(out,id,ready && settings_time_candidate(s,o,id)!=nil) }
    settings_text(out,"time_policy",policy); settings_text(out,"clock_help",help)
    settings_enabled(out,"clock_edit",ready && t!=nil && t.can_clock && !t.auto_time); settings_enabled(out,"zone_open",ready && t!=nil && t.can_zone && !t.auto_zone)
    settings_visible(out,"clock_editor",ui.clock!=nil)
    let stale=ui.clock!=nil && (t==nil || t.key!=ui.clock.key || !t.can_clock || t.auto_time)
    let notice=""; if stale { notice="Time settings changed. Cancel and reopen the editor before saving." }
    else if ui.clock!=nil && t!=nil && !settings_civil_valid(ui.clock.civil,t.minimum_year,t.maximum_year) { notice="Enter a valid date and time in the supported range." }
    settings_text(out,"clock_notice",notice)
    let first="First occurrence"; let second="Second occurrence"; if ui.clock!=nil { if ui.clock.second { second=second+" · Selected" } else { first=first+" · Selected" } }
    settings_text(out,"clock_first",first); settings_text(out,"clock_second",second)
    for id in ["clock_first","clock_second","clock_civil"] { settings_enabled(out,id,ready && !stale) }
    settings_enabled(out,"clock_cancel",!s.pending); settings_text(out,"zone_current","Current time zone: "+zone)
    let rows=settings_time_zones(s,o); let count="No matching time zones"
    if rows.len()>0 { count=""+(settings_min(ui.offset,rows.len())+1)+"–"+settings_min(ui.offset+20,rows.len())+" of "+rows.len()+" time zones" }
    settings_text(out,"zone_count",count); settings_enabled(out,"zone_previous",ready && ui.offset>0); settings_enabled(out,"zone_next",ready && ui.offset+20<rows.len())
    settings_visible(out,"zone_review",ui.review!=nil); let review=""; if ui.review!=nil { review="Use "+settings_zone_name(ui.review.zone)+" for the device's local time?" }; settings_text(out,"zone_review_text",review)
    let note=""; if !settings_query_valid(ui.query) { note="Use at most 128 characters without control characters." }
    else if ui.review!=nil && !s.pending && !settings_time_permits(s,o,ui.review) { note="Time settings changed. Cancel and select the time zone again." }
    settings_text(out,"zone_notice",note); settings_enabled(out,"zone_cancel",!s.pending)
    let i=0
    while i<20 {
        let id="zone_row_"+i; let zone=nil; if ui.offset+i<rows.len() { zone=rows[ui.offset+i] }
        settings_visible(out,id,zone!=nil); settings_enabled(out,id,ready && settings_time_candidate(s,o,id)!=nil)
        let label=""; if zone!=nil { label=settings_zone_name(zone); if t!=nil { if t.zone==zone { label=label+" · Current" }; settings_patch(out,"semantic",id,"zone:"+t.key+":"+zone) } }
        settings_text(out,id,label); i=i+1
    }
}
