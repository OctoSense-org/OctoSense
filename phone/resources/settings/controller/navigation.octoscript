fn settings_routes() { return [
    {"route":"Overview","wire":"overview","page":"Overview","section":"","parent":"Overview","title":""},
    {"route":"Search","wire":"search","page":"Search","section":"","parent":"Overview","title":""},
    {"route":"Appearance","wire":"appearance","page":"Appearance","section":"","parent":"Overview","title":""},
    {"route":"Display","wire":"display","page":"Display","section":"","parent":"Overview","title":""},
    {"route":"Sound","wire":"sound","page":"Sound","section":"","parent":"Overview","title":""},
    {"route":"Network","wire":"network","page":"Network","section":"","parent":"Overview","title":""},
    {"route":"System","wire":"system","page":"System","section":"","parent":"Overview","title":""},
    {"route":"About","wire":"about","page":"About","section":"","parent":"Overview","title":""},
    {"route":"Storage","wire":"storage","page":"Storage","section":"","parent":"Overview","title":""},
    {"route":"Battery","wire":"battery","page":"Battery","section":"","parent":"Overview","title":""},
    {"route":"DateTime","wire":"date_time","page":"DateTime","section":"","parent":"Overview","title":""},
    {"route":"Apps","wire":"apps","page":"Apps","section":"","parent":"Overview","title":""},
    {"route":"Wifi","wire":"wifi","page":"Wifi","section":"","parent":"Overview","title":""},
    {"route":"Bluetooth","wire":"bluetooth","page":"Bluetooth","section":"","parent":"Overview","title":""},
    {"route":"Accounts","wire":"accounts","page":"Accounts","section":"","parent":"Overview","title":""},
    {"route":"Updates","wire":"updates","page":"Updates","section":"","parent":"Overview","title":""},
    {"route":"AdvancedNetwork","wire":"advanced_network","page":"AdvancedNetwork","section":"","parent":"Overview","title":""},
    {"route":"TimeZones","wire":"time_zones","page":"TimeZones","section":"","parent":"Overview","title":""},
    {"route":"NotificationHistory","wire":"notification_history","page":"NotificationHistory","section":"","parent":"Overview","title":""},
    {"route":"Sounds","wire":"sounds","page":"Sounds","section":"","parent":"Overview","title":""},
    {"route":"DisplayOptions","wire":"display_options","page":"DisplayOptions","section":"","parent":"Overview","title":""},
    {"route":"DefaultApps","wire":"default_apps","page":"DefaultApps","section":"","parent":"Overview","title":""},
    {"route":"Dnd","wire":"dnd","page":"Dnd","section":"","parent":"Overview","title":""},
    {"route":"SystemLanguages","wire":"system_languages","page":"SystemLanguages","section":"","parent":"Overview","title":""},
    {"route":"CaptionLanguage","wire":"caption_language","page":"CaptionLanguage","section":"","parent":"Overview","title":""},
    {"route":"Keyboards","wire":"keyboards","page":"Keyboards","section":"","parent":"Overview","title":""},
    {"route":"Notifications","wire":"notifications","page":"Controls","section":"Notifications","parent":"Overview","title":"Notifications"},
    {"route":"Privacy","wire":"privacy","page":"Controls","section":"Privacy","parent":"Overview","title":"Privacy"},
    {"route":"Location","wire":"location","page":"Controls","section":"Location","parent":"Overview","title":"Location"},
    {"route":"BatteryPolicy","wire":"battery_policy","page":"Controls","section":"BatteryPolicy","parent":"Battery","title":"Battery policy"},
    {"route":"SoundFeedback","wire":"sound_feedback","page":"Controls","section":"SoundFeedback","parent":"Sound","title":"Sound feedback and haptics"},
    {"route":"AccessibilityVision","wire":"accessibility_vision","page":"Controls","section":"AccessibilityVision","parent":"System","title":"Accessibility: colors"},
    {"route":"AccessibilityHearing","wire":"accessibility_hearing","page":"Controls","section":"AccessibilityHearing","parent":"System","title":"Accessibility: hearing"},
    {"route":"AccessibilityTextInteraction","wire":"accessibility_text_interaction","page":"Controls","section":"AccessibilityTextInteraction","parent":"System","title":"Accessibility: text and interaction"},
    {"route":"CaptionCustom","wire":"caption_custom","page":"Controls","section":"CaptionCustom","parent":"Controls","title":"Caption appearance"}
] }

fn settings_route(value) {
    for route in settings_routes() { if value==route.route || value==route.wire { return route } }
    return nil
}
fn settings_active_scroll(page) {
    let shared=["Overview","Appearance","Display","Sound","Network","System","About","Storage","Battery","DateTime"]
    if settings_has(shared,page) { return "scroll" }
    if page=="Search" { return "settings_results" }
    for item in settings_pages() { if item.page==page { return item.id } }
    return "scroll"
}
fn settings_page_title(s) {
    if s.page=="Controls" {
        for route in settings_routes() { if route.section==s.controls_section { return route.title } }
    }
    for page in settings_pages() { if page.page==s.page { return page.title } }
    return "OctoSense Settings"
}
fn settings_clear_reviews(s) { s.drafts={}; s.pressed={}; s.search_pressed=nil }
fn settings_route_read(s,o,out) {
    if o.android!=true { return }
    if s.page=="Controls" && s.controls_section!="CaptionCustom" {
        let route=settings_route(s.controls_section)
        if route!=nil { settings_request(out,{kind:"read",domain:"controls",page:route.wire}) }
    }
    if s.page=="Apps" { settings_apps_read(s,o,out) }
    if s.page=="Wifi" { settings_request(out,{kind:"read",domain:"wifi"}) }
    if s.page=="Bluetooth" { settings_request(out,{kind:"read",domain:"bluetooth"}) }
    if s.page=="Accounts" { settings_request(out,{kind:"read",domain:"accounts"}) }
    if s.page=="Updates" { settings_request(out,{kind:"read",domain:"updates"}) }
    if s.page=="AdvancedNetwork" { settings_request(out,{kind:"read",domain:"network"}) }
    if s.page=="DisplayOptions" { settings_request(out,{kind:"read",domain:"display"}) }
    if s.page=="DefaultApps" { let ui=settings_consent_ui(s,"roles_ui"); ui.selected=nil; ui.offset=0; ui.generation=nil; ui.notice=""; ui.pressed=nil; settings_consent_read(s,out,"roles_ui") }
    if s.page=="Dnd" { settings_request(out,{kind:"read",domain:"dnd",offset:0,key:nil}) }
    if s.page=="Sounds" { settings_request(out,{kind:"read",domain:"sounds",sound_type:"ringtone",key:nil,offset:0}) }
    if s.page=="NotificationHistory" { settings_request(out,{kind:"read",domain:"notification_history",key:nil,offset:0}) }
    if s.page=="CaptionLanguage" { settings_language_enter(s,o,out,"caption_language_ui") }
    if s.page=="SystemLanguages" { settings_system_enter(s,o,out) }
    if s.page=="Keyboards" { settings_keyboard_enter(s,o,out) }
}
fn settings_open_route(s,value,from_search,external,o,out) {
    let route=settings_route(value)
    if route==nil { return false }
    if s.page=="Sounds" { settings_request(out,{kind:"sound_stop"}) }
    if external {
        settings_clear_reviews(s)
        s.context={}
        s.theme_draft=settings_theme_copy(s.theme_seen)
        s.message=""
        s.search_destination=nil
        s.controls_parent="Overview"
    }
    let previous=s.page
    s.page=route.page
    if route.section!="" {
        s.controls_section=route.section
        if external || from_search { s.controls_parent=route.parent }
        else if previous!="Controls" { s.controls_parent=previous }
        let ui=settings_control_ui(s); ui.pressed=nil; ui.history_review=false
        if route.section=="CaptionCustom" { s.controls_parent="Controls"; settings_caption_enter(s,o,out,from_search) }
    }
    if from_search { s.search_destination=s.page }
    if external { s.search_destination=nil }
    if s.page=="Dnd" || s.page=="NotificationHistory" { s.controls_section="Notifications" }
    settings_blur(out)
    settings_scroll(out,settings_active_scroll(s.page))
    settings_route_read(s,o,out)
    return true
}
fn settings_parent(s) {
    let pairs=[
        ["Keyboards","System"],["KeyboardDetails","Keyboards"],["SystemLanguages","System"],
        ["CaptionLanguage","Controls"],["CaptionChoice","Controls"],["ControlChoices","Controls"],
        ["AppLanguage","AppDetails"],["AppStorage","AppDetails"],["AppBattery","AppDetails"],["AppNetwork","AppDetails"],
        ["Dnd","Controls"],["DndPolicy","Dnd"],["DndRules","Dnd"],["DndRule","DndRules"],["DndEditor","DndRules"],
        ["AppPermissions","AppDetails"],["PermissionChoices","AppPermissions"],["DefaultApps","Apps"],["RoleChoices","DefaultApps"],
        ["AppNotifications","AppDetails"],["NotificationChannel","AppNotifications"],["DisplayOptions","Display"],
        ["Sounds","Sound"],["NotificationHistory","Controls"],["TimeZones","DateTime"],["Updates","System"],
        ["Accounts","System"],["AccountSync","AccountDetails"],["AccountDetails","Accounts"],["AccountProviders","Accounts"],
        ["BluetoothDevice","Bluetooth"],["Bluetooth","Network"],["AdvancedNetwork","Network"],["DateTime","System"],
        ["AppDetails","Apps"],["WifiNetwork","Wifi"],["Wifi","Network"]
    ]
    if s.page=="Controls" { return s.controls_parent }
    for pair in pairs { if pair[0]==s.page { return pair[1] } }
    return "Overview"
}
fn settings_back(s,o,out) {
    if s.page=="Overview" { settings_request(out,{kind:"back"}); return true }
    if s.page=="Sounds" { settings_request(out,{kind:"sound_stop"}) }
    if s.page=="Appearance" && !s.pending { s.theme_draft=settings_theme_copy(s.theme_seen) }
    let parent=settings_parent(s)
    if s.search_destination==s.page { parent="Search"; s.search_destination=nil }
    s.page=parent
    settings_clear_reviews(s)
    settings_blur(out)
    // Dedicated mounted list pages retain their actual native scroll on Back.
    // The shared overview/basic-page scroller begins at its own top.
    if settings_active_scroll(s.page)=="scroll" { settings_scroll(out,"scroll") }
    if settings_has(["Apps","DefaultApps","Wifi","Bluetooth","Accounts"],s.page) { settings_route_read(s,o,out) }
    if s.page=="AppDetails" { settings_apps_read(s,o,out) }
    return true
}
fn settings_search_valid(value) {
    let chars=value.to_chars()
    if chars.len()>128 { return false }
    for c in chars { if c<32 || (c>=127 && c<=159) { return false } }
    return true
}
fn settings_normalize(value) {
    let result=""
    let separated=true
    for c in text.lower(value).to_chars() {
        if text.is_alphanumeric(c) {
            result=result+text.from_codepoint(c)
            separated=false
        } else if !separated { result=result+" "; separated=true }
    }
    return result.trim()
}
fn settings_search_matches(query) {
    let result=[]
    if !settings_search_valid(query) { return result }
    let normalized=settings_normalize(query)
    if normalized=="" { return result }
    let terms=normalized.split(" ")
    let buckets=[[],[],[],[],[]]
    for entry in settings_search_entries() {
        let haystack=entry.normalized_title+" "+entry.normalized_keywords+" "+entry.normalized_location
        let all=true
        for term in terms { if haystack.search(term)<0 { all=false } }
        if all {
            let rank=4
            if entry.normalized_title==normalized { rank=0 }
            else if entry.normalized_title.search(normalized)==0 { rank=1 }
            else if entry.normalized_title.search(normalized)>=0 { rank=2 }
            else if settings_has(entry.normalized_keywords.split(" "),normalized) { rank=3 }
            buckets[rank].push(entry)
        }
    }
    for bucket in buckets { for entry in bucket { result.push(entry) } }
    return result
}
fn settings_search_refresh(s,out) {
    let matches=settings_search_matches(s.search_query)
    let rows=[]
    let index=0
    for entry in matches {
        if index>=s.search_offset && rows.len()<20 { rows.push(entry) }
        index=index+1
    }
    s.search_rows=rows
    let summary=""
    if !settings_search_valid(s.search_query) { summary="Use up to 128 characters without line breaks." }
    else if s.search_query.trim()=="" { summary="Search the settings available in OctoSense. English and Chinese keywords are supported." }
    else if matches.len()==0 { summary="No matching OctoSense settings." }
    else { summary=""+(s.search_offset+1)+"–"+(s.search_offset+rows.len())+" of "+matches.len()+" results" }
    settings_text(out,"settings_search_summary",summary)
    settings_enabled(out,"settings_search_clear",s.search_query!="")
    settings_enabled(out,"settings_search_previous",s.search_offset>0)
    settings_enabled(out,"settings_search_next",s.search_offset+20<matches.len())
    let i=0
    while i<20 {
        let id="settings_result_"+i
        let shown=i<rows.len()
        settings_visible(out,id,shown)
        settings_enabled(out,id,shown)
        if shown {
            let row=rows[i]
            settings_text(out,id,row.title+"\n"+row.location)
            settings_patch(out,"semantic",id,"search:"+row.route+":"+row.title)
        }
        i=i+1
    }
}
fn settings_navigation_event(s,e,o,out) {
    if e.kind=="navigate" || (e.kind=="entry" && e.id!="app_notifications") {
        let route=e.id
        if route=="" { route=e.value }
        return settings_open_route(s,route,false,true,o,out)
    }
    if e.kind=="back" || (e.kind=="click" && e.id=="back") { return settings_back(s,o,out) }
    if e.kind=="input" && e.id=="settings_query" {
        s.search_query=e.value; s.search_offset=0
        settings_scroll(out,"settings_results")
        return true
    }
    if s.page=="Search" {
        let i=0
        while i<20 {
            if e.id=="settings_result_"+i {
                let matches=settings_search_matches(s.search_query)
                let row=nil
                if s.search_offset+i<matches.len() { row=matches[s.search_offset+i] }
                if e.kind=="press" {
                    s.search_pressed=nil
                    if row!=nil { s.search_pressed={index:i,route:row.route,title:row.title} }
                    return true
                }
                if e.kind=="release" { s.search_pressed=nil; return true }
                if e.kind=="click" {
                    let previous=s.search_pressed; s.search_pressed=nil
                    if row==nil { return true }
                    if previous!=nil && (previous.index!=i || previous.route!=row.route || previous.title!=row.title) { return true }
                    settings_open_route(s,row.route,true,false,o,out)
                    return true
                }
            }
            i=i+1
        }
        if e.kind=="click" && e.id=="settings_search_clear" {
            s.search_query=""; s.search_offset=0
            settings_patch(out,"input","settings_query","")
            settings_scroll(out,"settings_results")
            out.patch.push({op:"focus",id:"settings_query"})
            return true
        }
        if e.kind=="click" && e.id=="settings_search_next" {
            if s.search_offset+20<settings_search_matches(s.search_query).len() { s.search_offset=s.search_offset+20; settings_scroll(out,"settings_results") }
            return true
        }
        if e.kind=="click" && e.id=="settings_search_previous" {
            s.search_offset=settings_max(0,s.search_offset-20); settings_scroll(out,"settings_results")
            return true
        }
    }
    if e.kind!="click" { return false }
    if e.id=="search_settings" { s.page="Search"; s.search_destination=nil; return true }
    let links=[
        ["appearance_page","Appearance"],["display_page","Display"],["sound_page","Sound"],
        ["network_page","Network"],["system_page","System"],["about","About"],["storage","Storage"],
        ["battery","Battery"],["date_time","DateTime"],["apps","Apps"],["wifi","Wifi"],
        ["bluetooth","Bluetooth"],["accounts","Accounts"],["location","Location"],["privacy","Privacy"],
        ["notifications","Notifications"],["notifications_overview","Notifications"],["battery_policy","BatteryPolicy"],
        ["sound_feedback","SoundFeedback"],["accessibility_vision","AccessibilityVision"],
        ["accessibility_hearing","AccessibilityHearing"],["accessibility_text_interaction","AccessibilityTextInteraction"],
        ["keyboards_open","Keyboards"],["system_languages_open","SystemLanguages"],
        ["caption_language_open","CaptionLanguage"],["sounds_open","Sounds"],
        ["advanced_connections","AdvancedNetwork"],["system_updates","Updates"],
        ["display_options_open","DisplayOptions"],["apps_defaults","DefaultApps"],
        ["history_open","NotificationHistory"],["dnd_open","Dnd"]
    ]
    for link in links { if e.id==link[0] { return settings_open_route(s,link[1],false,false,o,out) } }
    return false
}
