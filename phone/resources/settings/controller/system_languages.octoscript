// Ordered system languages. Drafts retain complete native locale tags and opaque
// targets; only an explicit reviewed order may cross the native binding.
fn settings_system_ui(s) {
    if s["system_language_ui"]==nil { s.system_language_ui={key:nil,parent:nil,query:"",filter:"",offset:0,order_offset:0,waiting:false,last:nil,adding:false,review:false,draft:nil,notice:"",stack:[],pressed:nil} }
    return s.system_language_ui
}
fn settings_system_read(s) {
    let ui=settings_system_ui(s)
    return {kind:"read",domain:"system_languages",key:ui.key,parent:ui.parent,query:ui.query,offset:ui.offset}
}
fn settings_system_matches(ui,row) {
    return row!=nil && row.query==ui.query && (row.availability!="Available" || (row.parent==ui.parent && (ui.key==nil || row.key==ui.key) && (row.offset==ui.offset || (row.offset==0 && ui.offset>=row.total))))
}
fn settings_system_observed(s,o) { let ui=settings_system_ui(s); if ui.waiting || !settings_system_matches(ui,o.system_language) { return nil }; return o.system_language }
fn settings_system_order(s,o) {
    let ui=settings_system_ui(s); if ui.draft!=nil { return ui.draft.order }
    let row=settings_system_observed(s,o); if row!=nil { return row.current }; return nil
}
fn settings_system_editable(s,o) {
    let ui=settings_system_ui(s); let row=settings_system_observed(s,o)
    if row==nil || row.availability!="Available" || !row.can_apply { return false }
    return ui.draft==nil || (!ui.draft.submitted && row.key==ui.draft.key && row.current.to_json()==ui.draft.original.to_json())
}
fn settings_system_load(s,out,read) {
    let ui=settings_system_ui(s)
    ui.key=read.key; ui.parent=read.parent; ui.query=read.query; ui.offset=read.offset; ui.waiting=true; ui.pressed=nil
    settings_request(out,read); settings_scroll(out,"system_language_page")
}
fn settings_system_root(key) { return {kind:"read",domain:"system_languages",key:key,parent:nil,query:"",offset:0} }
fn settings_system_enter(s,o,out) {
    let last=nil; if o.system_language!=nil { last=o.system_language.request_id }
    s.system_language_ui={key:nil,parent:nil,query:"",filter:"",offset:0,order_offset:0,waiting:true,last:last,adding:false,review:false,draft:nil,notice:"",stack:[],pressed:nil}
    s.page="SystemLanguages"; settings_patch(out,"input","system_language_query","")
    settings_system_load(s,out,settings_system_root(nil))
}
fn settings_system_begin(s,o) {
    let ui=settings_system_ui(s)
    if !settings_system_editable(s,o) { return false }
    if ui.draft==nil { let row=settings_system_observed(s,o); ui.draft={key:row.key,original:row.current,order:row.current,submitted:false}; ui.notice="" }
    return true
}
fn settings_system_write(s,o) {
    let ui=settings_system_ui(s)
    if !settings_system_editable(s,o) || ui.draft==nil || ui.draft.order.to_json()==ui.draft.original.to_json() { return nil }
    let order=[]; for row in ui.draft.order { order.push(row.target) }
    return {kind:"system_languages",key:ui.draft.key,order:order}
}
fn settings_system_candidate(s,o,id) {
    let ui=settings_system_ui(s)
    if o.android!=true || s.pending || !settings_system_editable(s,o) { return nil }
    if id=="system_language_review" || id=="system_language_apply" {
        let request=settings_system_write(s,o)
        if request==nil { return nil }
        if id=="system_language_review" && !ui.review { return {action:"review",request:request} }
        if id=="system_language_apply" && ui.review { return {action:"apply",request:request} }
        return nil
    }
    let order=settings_system_order(s,o); let row=settings_system_observed(s,o); let i=0
    while i<20 {
        let index=i+ui.order_offset
        if !ui.adding && !ui.review && order!=nil && index<order.len() {
            let item=order[index]
            if id=="system_language_up_"+i && index>0 { return {action:"move",target:item.target,index:index,next:index-1} }
            if id=="system_language_down_"+i && index+1<order.len() { return {action:"move",target:item.target,index:index,next:index+1} }
            if id=="system_language_remove_"+i && order.len()>1 { return {action:"remove",target:item.target,index:index} }
        }
        if id=="system_language_row_"+i && ui.adding && i<row.rows.len() {
            let item=row.rows[i]
            if item.kind=="Open" { return {action:"open",read:{kind:"read",domain:"system_languages",key:row.key,parent:item.target,query:"",offset:0}} }
            let duplicate=false; for existing in order { if existing.tag==item.tag || existing.target==item.target { duplicate=true } }
            if !duplicate && order.len()<128 { return {action:"add",key:row.key,row:item} }
        }
        i=i+1
    }
    return nil
}
fn settings_system_observe(s,o) {
    let ui=settings_system_ui(s); let row=o.system_language
    if !settings_system_matches(ui,row) || row.request_id==ui.last { return }
    ui.last=row.request_id; ui.waiting=false
    if row.availability=="Available" { ui.key=row.key; ui.offset=row.offset }
    if ui.draft!=nil && ui.draft.submitted && row.current!=nil && row.current.len()==ui.draft.order.len() {
        let confirmed=true; let i=0
        while i<row.current.len() { if row.current[i].tag!=ui.draft.order[i].tag { confirmed=false }; i=i+1 }
        if confirmed { ui.draft=nil; ui.review=false; ui.notice="The current system languages match your reviewed order." }
    }
}
fn settings_system_cancel(s,out) {
    let ui=settings_system_ui(s); let submitted=ui.draft!=nil && ui.draft.submitted
    ui.draft=nil; ui.review=false; ui.adding=false; ui.order_offset=0; ui.stack=[]
    ui.notice="Draft cancelled. System languages were not changed."
    if submitted { ui.notice="Review closed. Current system languages will refresh." }
    settings_system_load(s,out,settings_system_root(nil))
}
fn settings_system_event(s,e,o,out) {
    let ui=settings_system_ui(s)
    if e.kind=="pause" || e.kind=="entry" || e.kind=="navigate" { ui.pressed=nil }
    if s.page=="System" && e.kind=="click" && e.id=="system_languages_open" {
        if o.android==true && !s.pending { settings_system_enter(s,o,out) }; return true
    }
    if s.page!="SystemLanguages" { return false }
    settings_system_observe(s,o)
    if e.kind=="result" && e.value["domain"]=="system_languages" && e.value["phase"]=="submitted" {
        if ui.draft!=nil { ui.draft.submitted=true }
        ui.key=nil; ui.parent=nil; ui.offset=0; ui.query=""; ui.waiting=true; ui.pressed=nil
        if o.system_language!=nil { ui.last=o.system_language.request_id }
        return false
    }
    if e.kind=="back" || (e.kind=="click" && e.id=="back") {
        settings_blur(out); ui.pressed=nil
        if ui.adding {
            let read=settings_system_root(ui.key)
            if ui.stack.len()>0 { let previous=ui.stack.pop(); read=previous.read; ui.filter=previous.filter; settings_patch(out,"input","system_language_query",ui.filter) }
            else { ui.adding=false }
            settings_system_load(s,out,read); return true
        }
        if ui.review { ui.review=false; return true }
        if ui.draft!=nil { settings_system_cancel(s,out); return true }
        return false
    }
    if e.kind=="input" && e.id=="system_language_query" { ui.filter=e.value; return true }
    let ready=o.android==true && !s.pending
    if e.kind=="click" {
        if e.id=="system_language_native" { if ready { settings_request(out,{kind:"open",destination:"languages"}) }; return true }
        if e.id=="system_language_refresh" { if ready && ui.draft==nil { settings_system_enter(s,o,out) }; return true }
        if e.id=="system_language_cancel" { if ready && ui.draft!=nil { settings_system_cancel(s,out) }; return true }
        if e.id=="system_language_add" {
            if ready && !ui.review && settings_system_begin(s,o) {
                ui.adding=true; ui.stack=[]; ui.filter=""; settings_patch(out,"input","system_language_query","")
                settings_system_load(s,out,settings_system_root(ui.key))
            }; return true
        }
        if e.id=="system_language_order_previous" || e.id=="system_language_order_next" {
            let order=settings_system_order(s,o)
            if ready && order!=nil { let offset=settings_max(0,ui.order_offset-20); if e.id=="system_language_order_next" { offset=ui.order_offset+20 }; if offset<order.len() { ui.order_offset=offset; settings_scroll(out,"system_language_page") } }
            return true
        }
        if e.id=="system_language_previous" || e.id=="system_language_next" {
            let row=settings_system_observed(s,o)
            if ready && settings_system_editable(s,o) && row!=nil { let offset=settings_max(0,row.offset-20); if e.id=="system_language_next" { offset=row.offset+20 }; if offset<row.total { let read=settings_system_read(s); read.offset=offset; settings_system_load(s,out,read) } }
            return true
        }
    }
    if (e.kind=="click" && (e.id=="system_language_search" || e.id=="system_language_clear")) || (e.kind=="return" && e.id=="system_language_query") {
        if ready && settings_system_editable(s,o) {
            let filter=ui.filter; if e.id=="system_language_clear" { filter=""; settings_patch(out,"input","system_language_query","") }
            let query=filter.trim()
            if settings_language_query(query,"system_language_ui") { ui.filter=filter; let read=settings_system_read(s); read.query=query; read.offset=0; settings_system_load(s,out,read) }
        }; return true
    }
    let action=settings_system_candidate(s,o,e.id)
    if action==nil && e.kind!="press" && e.kind!="release" { return false }
    if settings_consent_held(ui,e,action) {
        if action.action=="move" && settings_system_begin(s,o) {
            let order=[]; let i=0
            while i<ui.draft.order.len() {
                let index=i; if i==action.next { index=action.index }; if i==action.index { index=action.next }
                order.push(ui.draft.order[index]); i=i+1
            }
            ui.draft.order=order
        }
        if action.action=="remove" && settings_system_begin(s,o) {
            let order=[]; let i=0; for row in ui.draft.order { if i!=action.index { order.push(row) }; i=i+1 }
            ui.draft.order=order; if ui.order_offset>=order.len() { ui.order_offset=settings_max(0,ui.order_offset-20) }
        }
        if action.action=="open" { ui.stack.push({read:settings_system_read(s),filter:ui.filter}); ui.filter=""; settings_patch(out,"input","system_language_query",""); settings_system_load(s,out,action.read) }
        if action.action=="add" && settings_system_begin(s,o) {
            let order=[]; for row in ui.draft.order { order.push(row) }
            let row=action.row; let label=settings_or(row.secondary,row.label)
            order.push({target:row.target,tag:row.tag,label:label,native_label:row.label,translated:row.translated})
            ui.draft.order=order; ui.adding=false; ui.order_offset=0; settings_system_load(s,out,settings_system_root(ui.key))
        }
        if action.action=="review" { ui.review=true; settings_scroll(out,"system_language_page") }
        if action.action=="apply" { settings_request(out,action.request) }
        return true
    }
    return action!=nil
}
fn settings_system_reason(row) {
    if row==nil { return "Waiting for Android system languages…" }
    for pair in [["None",""],["Locked","Unlock the device to change system languages."],["Policy","Android policy prevents changing system languages."],["Unavailable","System language controls are unavailable on this installation."],["InvalidCatalog","Android’s language list could not be read completely. Open Android language settings to continue."],["Expired","These language choices expired. Refresh and review the order again."],["Changed","The system language list, regional preferences, or available choices changed. Your draft is preserved; cancel it and refresh to review the current list."]] { if row.reason==pair[0] { return pair[1] } }
    return "System language controls are unavailable on this installation."
}
fn settings_system_refresh(s,o,out) {
    let ready=o.android==true && !s.pending; settings_enabled(out,"system_languages_open",ready)
    if s.page!="SystemLanguages" { return }
    let ui=settings_system_ui(s); let row=settings_system_observed(s,o); let order=settings_system_order(s,o); let editable=settings_system_editable(s,o)
    settings_visible(out,"system_language_order_content",!ui.adding); settings_visible(out,"system_language_catalog_content",ui.adding); settings_visible(out,"system_language_review_content",ui.review && !ui.adding)
    settings_text(out,"system_language_availability",settings_system_reason(row))
    let notice=ui.notice
    if notice=="" {
        notice="Android and supported apps use these languages in order. The first language is the preferred display language."
        if ui.draft!=nil { notice="Draft only. Review and apply to change system languages."; if !editable { notice="The observed list changed or is unavailable. Your draft is preserved. Cancel it and refresh before editing." }; if ui.draft.submitted { notice="The change was requested. This draft stays visible until Android’s current order confirms it. Do not apply it again." } }
    }
    settings_text(out,"system_language_notice",notice)
    let title="Current language order"; if ui.draft!=nil { title="Draft language order" }; settings_text(out,"system_language_order_title",title)
    let summary="Current language order unavailable"; if order!=nil { summary="Languages "+(ui.order_offset+1)+"–"+settings_min(ui.order_offset+20,order.len())+" of "+order.len() }; settings_text(out,"system_language_order_summary",summary)
    let i=0
    while i<20 {
        let item=nil; if order!=nil && ui.order_offset+i<order.len() { item=order[ui.order_offset+i] }
        settings_visible(out,"system_language_current_"+i,item!=nil)
        if item!=nil {
            let label=(ui.order_offset+i+1)+". "+item.label+"\n"+item.tag
            if !item.translated { label=label+" · Android may use a fallback display language" }
            settings_text(out,"system_language_label_"+i,label); settings_patch(out,"semantic","system_language_current_"+i,"system-language:"+item.target)
        }
        for pair in [["up","Move up"],["down","Move down"],["remove","Remove"]] {
            let id="system_language_"+pair[0]+"_"+i; let action=settings_system_candidate(s,o,id)
            settings_enabled(out,id,action!=nil); if action!=nil { settings_patch(out,"semantic",id,action.to_json()) }
            if item!=nil { settings_patch(out,"label",id,pair[1]+": "+item.label+" ("+item.tag+")") }
        }
        let choice=nil; if row!=nil && i<row.rows.len() { choice=row.rows[i] }; let id="system_language_row_"+i
        settings_visible(out,id,choice!=nil); let action=settings_system_candidate(s,o,id); settings_enabled(out,id,action!=nil)
        if choice!=nil {
            let label=choice.label; if choice.secondary!=nil && choice.secondary!=choice.label { label=label+"\n"+choice.secondary }
            label=label+"\n"+choice.tag; if choice.kind=="Open" { label=label+" · Choose region or numbering" }
            settings_text(out,id,label)
        }
        if action!=nil { settings_patch(out,"semantic",id,action.to_json()) }
        i=i+1
    }
    settings_enabled(out,"system_language_order_previous",ready && ui.order_offset>0)
    settings_enabled(out,"system_language_order_next",ready && order!=nil && ui.order_offset+20<order.len())
    settings_enabled(out,"system_language_add",ready && editable && !ui.review && order!=nil && order.len()<128)
    for id in ["system_language_review","system_language_apply"] { let action=settings_system_candidate(s,o,id); settings_enabled(out,id,action!=nil); if action!=nil { settings_patch(out,"semantic",id,action.to_json()) } }
    settings_enabled(out,"system_language_cancel",ready && ui.draft!=nil); settings_enabled(out,"system_language_refresh",ready && ui.draft==nil); settings_enabled(out,"system_language_native",ready)
    let review=""
    if ui.draft!=nil {
        review="Apply this language order? Android and apps use available translations in this order."
        if ui.draft.original[0].tag!=ui.draft.order[0].tag { review="Change preferred display language from "+ui.draft.original[0].label+" to "+ui.draft.order[0].label+"? Android and apps may change language, layout direction, and restart screens immediately." }
        let i=0; for item in ui.draft.order { review=review+"\n"+(i+1)+". "+item.label+" ("+item.tag+")"; i=i+1 }
    }
    settings_text(out,"system_language_review_text",review)
    let summary=""
    if row!=nil && row.availability=="Available" {
        let level=settings_language_level(row.level); summary="No matching "+level
        if row.total>0 { summary=level+" "+(row.offset+1)+"–"+(row.offset+row.rows.len())+" of "+row.total; if row.parent_label!=nil { summary=summary+" · "+row.parent_label } }
    }
    settings_text(out,"system_language_catalog_summary",summary)
    let hint=""; if ui.filter.trim()!=ui.query { hint="Search to apply filter edits." }; settings_text(out,"system_language_filter_hint",hint)
    for id in ["system_language_search","system_language_clear"] { settings_enabled(out,id,ready && editable) }
    settings_enabled(out,"system_language_previous",ready && editable && row!=nil && row.offset>0)
    settings_enabled(out,"system_language_next",ready && editable && row!=nil && row.offset+row.rows.len()<row.total)
}
