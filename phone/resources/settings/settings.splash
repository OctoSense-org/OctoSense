// Octoscript layout -> UiNode -> Octoscript-Makepad. Stable IDs are the binding
// contract. Native SettingsView owns typed actions; no script can name an
// Android intent, settings key, Binder transaction or shell command here.
{t: "column", id: "body", fillw: 1, fillh: 1, spacing: 12, c: [
    {t: "row", spacing: 12, c: [
        {t: "button", id: "back", text: "Back"},
        {t: "text", id: "title", text: "Settings", fillw: 1}
    ]},
    {t: "text", id: "status", text: "", fillw: 1},
    {t: "scroll", id: "scroll", fillw: 1, fillh: 1, c: [
        {t: "column", id: "overview", fillw: 1, spacing: 10, c: [
            {t: "text", text: "Device settings", fillw: 1},
            {t: "button", id: "search_settings", text: "Search settings", fillw: 1},
            {t: "button", id: "appearance_page", text: "Appearance", fillw: 1},
            {t: "button", id: "display_page", text: "Display", fillw: 1},
