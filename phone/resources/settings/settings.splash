            {t: "text", text: "More settings are being brought into OctoSense. Android Settings remains available during this transition.", fillw: 1},
            {t: "button", id: "android_settings", text: "Android Settings", fillw: 1}
        ]},
        {t: "column", id: "appearance", fillw: 1, spacing: 10, c: [
            {t: "text", id: "theme_summary", text: "Current theme", fillw: 1},
