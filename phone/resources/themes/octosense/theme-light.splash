// The console follows the app palette by reference, so a palette tweak cannot
// desync it; declared so a reload resets a previous style's console.
mod.theme.color_terminal_bg = mod.theme.color_bg_app
mod.theme.color_terminal_text = mod.theme.color_text
mod.theme.material = {
    glass: 1.0
    corner_radius: 12.0
    blur_level: 5.2
    lensing_effect: 0.94
    lensing_strength: 28.0
    lensing_width: 20.0
    diffraction_strength: 4.4
    tint_color: #eff5f6
    tint_alpha: 0.68
    border_color: #ffffff
    border_alpha: 0.72
    border_width: 1.0
    specular_strength: 0.10
    noise_strength: 0.004
    shadow_color: #284957
    shadow_alpha: 0.20
    shadow_radius: 13.0
    shadow_offset_y: 5.0
    fallback_color: #e2eef0
}
true
