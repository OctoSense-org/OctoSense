+// Synthetic weight preserves shaping, glyph advances, caret positions and fallback
+// fonts, including static faces without a variable weight axis. Color emoji bypass it.
+fn accessibility_stroke(adjustment: i32, font_size: f32, dpi: f32) -> f32 {
+    if adjustment == 0 { return 0.0; }
+    (adjustment.clamp(-1000, 1000) as f32 / 300.0 * (font_size / 28.0).clamp(0.0, 1.25))
+        .clamp(-1.25, 1.25) * dpi.max(0.0)
+}
