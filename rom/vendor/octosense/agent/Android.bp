// The OctoSense agent platform service: one persistent, platform-signed
// privileged process that gives agent code the framework's hidden APIs
// (tasks and snapshots, screen capture, input injection, secure settings,
// task control, the status bar) behind a single Binder surface. See
// docs/agent-service.md.
android_app {
    name: "OctoSenseAgent",
    srcs: [
        "src/**/*.java",
        "src/**/*.aidl",
        ":octosense-wifi-settings-sources",
    ],
    aidl: {
        local_include_dirs: ["src"],
    },
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: {
        enabled: false,
    },
    // The privapp allowlist ships through PRODUCT_COPY_FILES in octosense.mk.
}
