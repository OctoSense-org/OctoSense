// Development acceptance fixture; no permission prompts or capture.
let calls = 0
fn show_status(data) {
    calls = calls + 1
    ui.status.set_text("Native OS permission: " + data.os_permission)
    ui.policy.set_text("App capability: declared | App consent: " + data.app_consent.to_string())
    ui.count.set_text("Completed native queries: " + calls.to_string())
}
fn read_status() {
    host.request("camera.permission.status", {}, fn(r) {
        if r.is_ok { show_status(r.data) }
        else { ui.status.set_text(r.error) }
    })
}
fn app_tool(name, call_id) {
    let request = mod.app_tools.request(call_id)
    host.request("runtime.describe", {method: "camera.permission.status"}, fn(discovery) {
        if !discovery.is_ok { mod.app_tools.fail(call_id, discovery.error); return }
        host.request("runtime.describe", {method: "apilab.custom_rust"}, fn(missing) {
            if !missing.is_ok { mod.app_tools.fail(call_id, missing.error); return }
            host.request("camera.permission.status", {}, fn(camera) {
                if !camera.is_ok { mod.app_tools.fail(call_id, camera.error); return }
                show_status(camera.data)
                // No microphone capability is declared. This must be refused.
                host.request("microphone.permission.status", {}, fn(microphone) {
                    // A tool callback must retain its background provenance.
                    host.request("camera.permission.request", {}, fn(prompt) {
                        ui.safety.set_text("Permission checks complete; no approval sheet opened")
                        ui.origin.set_text("Own app tool completed through the native host service")
                        mod.app_tools.complete(call_id, {
                            account: request.context.account
                            camera: camera.data
                            discovery: discovery.data
                            missing: missing.data
                            microphone_allowed: microphone.is_ok
                            microphone_error: microphone.error
                            background_prompt_allowed: prompt.is_ok
                            background_error: prompt.error
                            calls: calls
                        })
                    })
                })
            })
        })
    })
}
SolidView {width: Fill height: Fill flow: Down padding: 28 spacing: 20 draw_bg.color: #xf5f7fa
    Label {text: "Host API Lab" draw_text.color: #x17243b draw_text.text_style: theme.font_bold {font_size: 28}}
    Label {width: Fill text: "A signed app calls its own tool, which queries a Rust host service and reads native OS permission status." draw_text.color: #x48566b draw_text.text_style.font_size: 16}
    SolidView {width: Fill height: Fit flow: Down padding: 20 spacing: 16 draw_bg.color: #xffffff
        Label {text: "CAMERA PERMISSION" draw_text.color: #x48566b draw_text.text_style.font_size: 12}
        status := Label {width: Fill text: "Waiting for a signed native query" draw_text.color: #x17243b draw_text.text_style.font_size: 20}
        policy := Label {width: Fill text: "The capability and OS permission are separate checks." draw_text.color: #x48566b}
        count := Label {text: "Completed native queries: 0" draw_text.color: #x48566b}
        refresh := Button {text: "Read permission status" on_click: || read_status()}
    }
    origin := Label {width: Fill text: "Run the signed acceptance host to invoke apilab.inspect." draw_text.color: #x17243b}
    safety := Label {width: Fill text: "This fixture does not capture images or request permission." draw_text.color: #x48566b}
    Label {width: Fill text: "A custom Rust function must already be compiled into the host. Discovery reports an unavailable function without executing it." draw_text.color: #x48566b}
}
