{
  "schema": 1,
  "tools": [{
    "name": "apilab.inspect",
    "description": "Read native camera permission status and exercise permission refusals in this acceptance fixture. Does not capture images or approve access.",
    "implemented_by": "app",
    "risk": "read",
    "background": false,
    "shareable": false,
    "private_data": true,
    "input_schema": {"type": "object", "properties": {}, "additionalProperties": false},
    "output_schema": {
      "type": "object",
      "required": ["account", "camera", "discovery", "missing", "microphone_allowed", "microphone_error", "background_prompt_allowed", "background_error", "calls"],
      "properties": {
        "account": {"type": "string"},
        "camera": {"type": "object"},
        "discovery": {"type": "object"},
        "missing": {"type": "object"},
        "microphone_allowed": {"type": "boolean"},
        "microphone_error": {"type": "string"},
        "background_prompt_allowed": {"type": "boolean"},
        "background_error": {"type": "string"},
        "calls": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }]
}
