@@ -836,6 +836,11 @@ public class MakepadInputConnection extends BaseInputConnection {
                 // Handle Enter key from IME
                 // Some IMEs send sendKeyEvent(ENTER) instead of commitText("\n")
                 if (mSurface.isMultiline()) {
+                    // Enter accepts the current composing word, then inserts
+                    // a line break. A bare commitText("\n") replaces that word
+                    // with the newline in both Editable and the Rust editor.
+                    // Keep these operations ordered on the same editor session.
+                    if (!finishComposingText()) return false;
                     // For multiline: insert newline via commitText
                     // This ensures proper notification to Rust via ImeTextState
                     return commitText("\n", 1);
