 pub struct RunningAudioUnit {
     device_id: AudioDeviceId,
+    // A device may be cancelled and reopened before async instantiation ends.
+    // Only the exact pending open may install a unit or mark a failure.
+    generation: Arc<()>,
     audio_unit: Option<AudioUnit>,
 }
 
+fn pending_audio_unit_index(
+    units: &[RunningAudioUnit],
+    device_id: AudioDeviceId,
+    generation: &Arc<()>,
+) -> Option<usize> {
+    units.iter().position(|unit| {
+        unit.device_id == device_id
+            && Arc::ptr_eq(&unit.generation, generation)
+            && unit.audio_unit.is_none()
+    })
+}
