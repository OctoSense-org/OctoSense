+
+/// A continuation can deny native prompts without changing the host's surface
+/// baseline. Kept by heap so nested calls into another isolate are independent.
+/// Native widgets and host bridges must intersect this with their own policy.
+pub struct ScriptPromptScope { denied_heap: Option<usize> }
+impl ScriptPromptScope {
+    pub fn enter(heap_key: usize, may_prompt: bool) -> Self {
+        if !may_prompt {
+            PROMPT_DENIALS.with(|denials| *denials.borrow_mut().entry(heap_key).or_default() += 1);
+        }
+        Self { denied_heap: (!may_prompt).then_some(heap_key) }
+    }
+}
+impl Drop for ScriptPromptScope {
+    fn drop(&mut self) {
+        if let Some(heap) = self.denied_heap {
+            PROMPT_DENIALS.with(|denials| {
+                let mut denials = denials.borrow_mut();
+                if let Some(depth) = denials.get_mut(&heap) {
+                    *depth -= 1;
+                    if *depth == 0 { denials.remove(&heap); }
+                }
+            });
+        }
+    }
+}
