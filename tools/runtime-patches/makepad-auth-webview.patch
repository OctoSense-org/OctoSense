+package dev.makepad.android;
+
+import android.app.Activity;
+import android.app.ActivityManager;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ActivityInfo;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Message;
+import android.os.Messenger;
+import android.os.ResultReceiver;
+import java.io.File;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.nio.file.attribute.BasicFileAttributes;
+import java.util.UUID;
+
+/** Main-process coordinator. Never initializes android.webkit or touches the reader profile. */
+final class MakepadAuthBrowser {
+    static final String PREFIX = "makepad_auth_";
+    static final int READY = 1, EVENT = 2, TERMINAL = 3, CANCEL = 4, START = 5;
+    private static final Handler MAIN = new Handler(Looper.getMainLooper());
+    private static final java.util.concurrent.ThreadPoolExecutor WORKER = new java.util.concurrent.ThreadPoolExecutor(
+        1,1,0,java.util.concurrent.TimeUnit.SECONDS,new java.util.concurrent.ArrayBlockingQueue<Runnable>(2),
+        task -> new Thread(task,"makepad-auth-profile"),new java.util.concurrent.ThreadPoolExecutor.AbortPolicy());
+    private static Session active;
+    private static final class Session {
+        final long id;
+        final Context context;
+        final MakepadAuthPolicy policy;
+        final String suffix = PREFIX + UUID.randomUUID().toString().replace("-", "");
+        Messenger child;
+        int pid;
+        boolean closing, cleanup, cancel;
+        String terminal = "cancelled", callback = "";
+        Session(Activity activity, long id, MakepadAuthPolicy policy) {
+            context = activity.getApplicationContext(); this.id = id; this.policy = policy;
+        }
+    }
+    static void open(Activity activity, long id, String url, String callback) {
+        if (Build.VERSION.SDK_INT < 28 || active != null) { emit(id,"error",""); return; }
+        final Session session;
+        try {
+            MakepadAuthPolicy policy = new MakepadAuthPolicy(url,callback);
+            ActivityInfo info = activity.getPackageManager().getActivityInfo(new ComponentName(activity,MakepadAuthActivity.class),0);
+            if (info.exported || !(activity.getPackageName()+":makepad_auth").equals(info.processName))
+                throw new IllegalArgumentException("auth activity isolation");
+            session = new Session(activity,id,policy);
+        } catch (Exception e) { emit(id,"error",""); return; }
+        active = session;
+        // A previous main-process death may have left an auth process/profile. Only our exact
+        // private process and directory namespace are eligible; all I/O is off the UI thread.
+        submit(session,() -> {
+            boolean ready = retireProcess(session.context) && cleanProfiles(session.context);
+            MAIN.post(() -> {
+                if (active != session) return;
+                if (!ready) { complete(session,"error",""); return; }
+                if (session.cancel || session.cleanup) { cleanup(session); return; }
+                Intent intent = new Intent(activity,MakepadAuthActivity.class);
+                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_EXCLUDE_FROM_RECENTS);
+                intent.putExtra("url",url); intent.putExtra("callback",callback); intent.putExtra("suffix",session.suffix);
+                intent.putExtra("owner",new Messenger(new Handler(Looper.getMainLooper())));
+                intent.putExtra("receiver",new ResultReceiver(MAIN) {
+                    @Override protected void onReceiveResult(int kind, Bundle data) {
+                        if (data == null) return;
+                        if (active != session || session.cleanup) {
+                            // startActivity may complete after cancellation/timeout. Never let an
+                            // obsolete activity create a WebView; the handshake has no URL content.
+                            if (kind == READY) {
+                                Messenger stale = data.getParcelable("child");
+                                if (stale != null) try { stale.send(Message.obtain(null,CANCEL)); }
+                                catch (android.os.RemoteException ignored) {}
+                            }
+                            return;
+                        }
+                        if (kind == READY) {
+                            if (session.child != null) return;
+                            session.pid = data.getInt("pid");
+                            session.child = data.getParcelable("child");
+                            if (session.child == null || session.pid <= 0) { close(id); return; }
+                            try { session.child.getBinder().linkToDeath(() -> MAIN.postDelayed(() -> cleanup(session),100),0); }
+                            catch (android.os.RemoteException e) { cleanup(session); }
+                            if (session.cancel) close(id);
+                            else try { session.child.send(Message.obtain(null,START)); }
+                            catch (android.os.RemoteException e) { cleanup(session); }
+                        } else if (kind == TERMINAL && !session.closing) {
+                            session.closing = true;
+                            String event = data.getString("kind", "cancelled");
+                            String value = data.getString("url", "");
+                            session.terminal = "callback".equals(event) && session.policy.callback(value) ? "callback"
+                                : "cancelled".equals(event) ? "cancelled" : "error";
+                            session.callback = "callback".equals(session.terminal) ? value : "";
+                            // The child normally exits in onDestroy; this also bounds broken lifecycle paths.
+                            MAIN.postDelayed(() -> cleanup(session),750);
+                        } else if (kind == EVENT && !session.closing) {
+                            String event = data.getString("kind", "error");
+                            if ("loaded".equals(event) || "error".equals(event) || "blocked".equals(event)) emit(id,event,"");
+                        }
+                    }
+                });
+                try { activity.startActivity(intent); }
+                catch (RuntimeException e) { session.terminal="error"; cleanup(session); }
+                MAIN.postDelayed(() -> {
+                    if (active == session && session.child == null) { session.terminal="error"; close(id); }
+                },15000);
+                MAIN.postDelayed(() -> { if (active == session) close(id); },600000);
+            });
+        });
+    }
+    static boolean close(long id) {
+        Session session = active;
+        if (session == null || session.id != id) return false;
+        session.cancel = true;
+        // Also closes a child that never sends READY, crashes during initialization, or
+        // has already closed its command binder. Never leave admission locked for ten minutes.
+        MAIN.postDelayed(() -> cleanup(session),1000);
+        if (session.child != null && !session.closing) {
+            try { session.child.send(Message.obtain(null,CANCEL)); }
+            catch (android.os.RemoteException e) { cleanup(session); }
+        }
+        return true;
+    }
+    private static void cleanup(Session session) {
+        if (active != session || session.cleanup) return;
+        session.cleanup = true;
+        submit(session,() -> {
