@@ -0,0 +1,43 @@
+package dev.makepad.android;
+
+import java.net.URI;
+import java.util.Locale;
+
+/** Pure URL policy; no WebView calls (safe in the renderer process). */
+final class MakepadAuthPolicy {
+    final URI start;
+    final URI callback;
+    MakepadAuthPolicy(String url, String callbackUrl) {
+        start = parse(url);
+        callback = parse(callbackUrl);
+        if (!allowedOrigin(start) || !allowedOrigin(callback)
+                || callback.getRawQuery() != null) throw new IllegalArgumentException("auth URL policy");
+    }
+    static URI parse(String value) {
+        if (value == null || value.length() > 8192) throw new IllegalArgumentException("auth URL policy");
+        try {
+            URI uri = new URI(value);
+            if (uri.isOpaque() || uri.getHost() == null || uri.getRawUserInfo() != null
+                    || uri.getRawFragment() != null || uri.getRawPath() == null)
+                throw new IllegalArgumentException("auth URL policy");
+            return uri;
+        } catch (java.net.URISyntaxException e) { throw new IllegalArgumentException("auth URL policy"); }
+    }
+    static boolean allowedOrigin(URI uri) {
+        return "https".equals(uri.getScheme())
+            || ("http".equals(uri.getScheme()) && "127.0.0.1".equals(uri.getHost()) && uri.getPort() > 0);
+    }
+    static int port(URI uri) { return uri.getPort() >= 0 ? uri.getPort() : 443; }
+    static boolean origin(URI a, URI b) {
+        return a.getScheme().equals(b.getScheme()) && a.getHost().equalsIgnoreCase(b.getHost()) && port(a) == port(b);
+    }
+    boolean callback(String value) {
+        try { URI u = parse(value); return origin(callback,u) && callback.getRawPath().equals(u.getRawPath()); }
+        catch (IllegalArgumentException e) { return false; }
+    }
+    boolean navigation(String value) {
+        try { return origin(start, parse(value)); }
+        catch (IllegalArgumentException e) { return false; }
+    }
+    String domain() { return start.getHost().toLowerCase(Locale.ROOT) + (start.getPort() > 0 ? ":" + start.getPort() : ""); }
+}
