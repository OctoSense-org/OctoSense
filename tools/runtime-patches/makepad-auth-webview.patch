+package dev.makepad.android;
+
+import android.app.Activity;
+import android.graphics.Color;
+import android.net.http.SslError;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.Messenger;
+import android.os.ResultReceiver;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.WindowManager;
+import android.webkit.CookieManager;
+import android.webkit.PermissionRequest;
+import android.webkit.SslErrorHandler;
+import android.webkit.WebChromeClient;
+import android.webkit.WebResourceError;
+import android.webkit.WebResourceRequest;
+import android.webkit.WebResourceResponse;
+import android.webkit.WebSettings;
+import android.webkit.WebView;
+import android.webkit.WebViewClient;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+/** One ephemeral backend login. Must run in the dedicated :makepad_auth process. */
+public final class MakepadAuthActivity extends Activity {
+    private ResultReceiver receiver;
+    private Messenger owner;
+    private WebView web;
+    private MakepadAuthPolicy policy;
+    private TextView status;
+    private Button retry;
+    private boolean finished;
+    private boolean failed;
+    private boolean started;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_SECURE);
+        getWindow().setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE);
+        if (android.os.Build.VERSION.SDK_INT >= 31
+                && checkSelfPermission("android.permission.HIDE_OVERLAY_WINDOWS") == android.content.pm.PackageManager.PERMISSION_GRANTED)
+            getWindow().setHideOverlayWindows(true);
+        if (android.os.Build.VERSION.SDK_INT >= 33) getOnBackInvokedDispatcher().registerOnBackInvokedCallback(
+            android.window.OnBackInvokedDispatcher.PRIORITY_DEFAULT,() -> goBack());
+        try {
+            receiver = getIntent().getParcelableExtra("receiver");
+            owner = getIntent().getParcelableExtra("owner");
+            String suffix = getIntent().getStringExtra("suffix");
+            if (android.os.Build.VERSION.SDK_INT < 28 || receiver == null || owner == null
+                    || !getPackageName().concat(":makepad_auth").equals(android.app.Application.getProcessName())
+                    || suffix == null || !suffix.matches(MakepadAuthBrowser.PREFIX+"[a-f0-9]{32}"))
+                throw new IllegalArgumentException("auth activity isolation");
+            policy = new MakepadAuthPolicy(getIntent().getStringExtra("url"),getIntent().getStringExtra("callback"));
+            owner.getBinder().linkToDeath(() -> main.post(() -> finishAuth("cancelled","")),0);
+            Bundle ready = new Bundle();
+            ready.putInt("pid",android.os.Process.myPid());
+            ready.putParcelable("child",new Messenger(new Handler(Looper.getMainLooper(), message -> {
+                if (message.what == MakepadAuthBrowser.CANCEL) { finishAuth("cancelled",""); return true; }
+                if (message.what == MakepadAuthBrowser.START && !started && !finished) {
+                    started=true;
+                    try {
+                        // Must precede EVERY android.webkit call in this separate process.
+                        // The host confirms this is still the current attempt before any load.
+                        WebView.setDataDirectorySuffix(suffix);
+                        WebView.setWebContentsDebuggingEnabled(false);
+                        buildUi();
+                    } catch (Exception e) { finishAuth("error",""); }
+                    return true;
+                }
+                return false;
+            })));
+            receiver.send(MakepadAuthBrowser.READY,ready);
+            main.postDelayed(() -> { if (!started && !finished) finishAuth("cancelled",""); },15000);
+        } catch (Exception e) { finishAuth("error",""); }
+    }
+    private void buildUi() {
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL); root.setBackgroundColor(Color.WHITE);
+        root.setImportantForAutofill(View.IMPORTANT_FOR_AUTOFILL_NO_EXCLUDE_DESCENDANTS);
+        if (android.os.Build.VERSION.SDK_INT >= 30) {
+            // Android 15 enforces edge-to-edge. Keep trusted controls outside
+            // system bars and shrink the form above the actual keyboard.
+            getWindow().setDecorFitsSystemWindows(false);
+            root.setOnApplyWindowInsetsListener((view,insets) -> {
+                android.graphics.Insets safe = insets.getInsets(
+                    android.view.WindowInsets.Type.systemBars() | android.view.WindowInsets.Type.ime());
+                view.setPadding(safe.left,safe.top,safe.right,safe.bottom);
+                return android.view.WindowInsets.CONSUMED;
+            });
+        } else root.setFitsSystemWindows(true);
+        LinearLayout toolbar = new LinearLayout(this);
+        toolbar.setPadding(dp(8),dp(4),dp(8),dp(4));
+        Button back = new Button(this); back.setText("Back"); back.setOnClickListener(v -> goBack());
+        toolbar.addView(back,new LinearLayout.LayoutParams(dp(76),dp(48)));
+        TextView domain = new TextView(this); domain.setText(policy.domain()); domain.setTextColor(Color.rgb(28,37,48));
+        domain.setTextSize(16); domain.setGravity(android.view.Gravity.CENTER); domain.setMaxLines(2);
+        toolbar.addView(domain,new LinearLayout.LayoutParams(0,dp(48),1));
+        Button cancel = new Button(this); cancel.setText("Cancel"); cancel.setOnClickListener(v -> finishAuth("cancelled",""));
+        toolbar.addView(cancel,new LinearLayout.LayoutParams(dp(88),dp(48)));
+        root.addView(toolbar);
+        status = new TextView(this); status.setText("Private sign-in • Loading…"); status.setTextSize(14);
+        status.setTextColor(Color.rgb(55,65,81)); status.setPadding(dp(16),dp(8),dp(16),dp(8)); root.addView(status);
+        retry = new Button(this); retry.setText("Retry sign-in"); retry.setVisibility(View.GONE);
+        retry.setOnClickListener(v -> { failed=false; retry.setVisibility(View.GONE); status.setText("Private sign-in • Loading…"); web.loadUrl(policy.start.toString()); });
+        root.addView(retry,new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,dp(48)));
+        web = new WebView(this);
+        web.setImportantForAutofill(View.IMPORTANT_FOR_AUTOFILL_NO_EXCLUDE_DESCENDANTS);
+        WebSettings settings = web.getSettings();
+        settings.setJavaScriptEnabled(true); settings.setDomStorageEnabled(true);
+        settings.setAllowFileAccess(false); settings.setAllowContentAccess(false);
+        settings.setAllowFileAccessFromFileURLs(false); settings.setAllowUniversalAccessFromFileURLs(false);
+        settings.setMixedContentMode(WebSettings.MIXED_CONTENT_NEVER_ALLOW);
+        settings.setCacheMode(WebSettings.LOAD_NO_CACHE);
+        settings.setSaveFormData(false); settings.setSavePassword(false);
+        settings.setJavaScriptCanOpenWindowsAutomatically(false); settings.setSupportMultipleWindows(false);
+        settings.setGeolocationEnabled(false); settings.setMediaPlaybackRequiresUserGesture(true);
+        CookieManager.getInstance().setAcceptThirdPartyCookies(web,false);
+        web.setWebChromeClient(new WebChromeClient() {
+            @Override public boolean onConsoleMessage(android.webkit.ConsoleMessage message) { return true; }
+            @Override public void onPermissionRequest(PermissionRequest request) { request.deny(); }
+            @Override public boolean onShowFileChooser(WebView view, android.webkit.ValueCallback<android.net.Uri[]> callback, FileChooserParams params) { callback.onReceiveValue(null); return true; }
+        });
+        web.setDownloadListener((url,userAgent,disposition,mime,length) -> failure("blocked","Downloads are unavailable during sign-in."));
+        web.setWebViewClient(new WebViewClient() {
+            @Override public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {
+                String url=request.getUrl().toString();
+                if (!request.isForMainFrame()) return !policy.navigation(url);
+                return navigation(url);
+            }
+            @Override public boolean shouldOverrideUrlLoading(WebView view,String url) { return navigation(url); }
+            @Override public void onPageStarted(WebView view,String url,android.graphics.Bitmap favicon) {
+                if (navigation(url)) { if (!finished) view.stopLoading(); }
+                else {
+                    failed=false; retry.setVisibility(View.GONE);
+                    status.setText("Private sign-in • Loading…");
+                }
+            }
+            @Override public void onPageFinished(WebView view,String url) {
+                if (!finished && !failed && policy.navigation(url)) { status.setText("Private sign-in • "+policy.domain()); event("loaded"); }
+            }
+            @Override public void onReceivedError(WebView view,WebResourceRequest request,WebResourceError error) {
+                if (request.isForMainFrame()) failure("error","This sign-in page could not load. Check your connection and retry.");
+            }
+            @Override public void onReceivedHttpError(WebView view,WebResourceRequest request,WebResourceResponse response) {
+                if (request.isForMainFrame()) failure("error","The sign-in service is unavailable. Please retry.");
+            }
+            @Override public void onReceivedSslError(WebView view,SslErrorHandler handler,SslError error) {
+                handler.cancel(); failure("error","The sign-in certificate could not be verified.");
+            }
+            @Override public void onReceivedHttpAuthRequest(WebView view,android.webkit.HttpAuthHandler handler,String host,String realm) {
+                handler.cancel(); failure("blocked","This authentication method is unavailable.");
+            }
+            @Override public void onReceivedClientCertRequest(WebView view,android.webkit.ClientCertRequest request) { request.cancel(); }
+            @Override public boolean onRenderProcessGone(WebView view,android.webkit.RenderProcessGoneDetail detail) {
+                finishAuth("error",""); return true;
+            }
+        });
+        root.addView(web,new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,0,1));
+        setContentView(root);
+        root.requestApplyInsets();
+        web.loadUrl(policy.start.toString());
+    }
+    private int dp(int value) { return (int)(getResources().getDisplayMetrics().density*value+0.5f); }
+    private boolean navigation(String url) {
+        if (finished) return true;
+        if (policy.callback(url)) { finishAuth("callback",url); return true; }
+        if (policy.navigation(url)) return false;
+        failure("blocked","This sign-in cannot open another site."); return true;
+    }
+    private void failure(String kind,String message) {
+        if (finished) return;
+        failed=true; status.setText(message); retry.setVisibility(View.VISIBLE); event(kind);
+    }
+    private void event(String kind) {
+        if (receiver == null) return;
+        Bundle data=new Bundle(); data.putString("kind",kind); receiver.send(MakepadAuthBrowser.EVENT,data);
+    }
+    private void goBack() {
+        if (web != null && web.canGoBack()) {
+            android.webkit.WebBackForwardList history=web.copyBackForwardList();
+            String url=history.getItemAtIndex(history.getCurrentIndex()-1).getUrl();
+            if (policy.navigation(url)) { web.goBack(); return; }
+        }
+        finishAuth("cancelled","");
+    }
+    @Override public void onBackPressed() { goBack(); }
+    private void finishAuth(String kind,String url) {
+        if (finished) return;
+        finished=true;
+        if (receiver != null) {
+            Bundle data=new Bundle(); data.putString("kind",kind); data.putString("url",url);
+            receiver.send(MakepadAuthBrowser.TERMINAL,data);
+        }
+        if (web != null) {
+            web.stopLoading();
+            if (web.getParent() instanceof ViewGroup) ((ViewGroup)web.getParent()).removeView(web);
+            web.destroy(); web=null;
+        }
+        finishAndRemoveTask();
+    }
+    @Override protected void onStop() {
+        super.onStop();
+        // A login left through Home/Recents cannot remain live in the background.
+        if (!finished) finishAuth("cancelled","");
+    }
+    @Override protected void onDestroy() {
+        if (!finished) finishAuth("cancelled","");
+        super.onDestroy();
+        // Only this isolated auth process exits. The renderer process owns cleanup and
+        // delays completion until the profile is gone, so a later attempt cannot reuse it.
+        main.postDelayed(() -> android.os.Process.killProcess(android.os.Process.myPid()),100);
+    }
+}
