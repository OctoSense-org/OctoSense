+/// Only an optional object of boolean options is accepted. Unknown keys and
+/// truthy strings/numbers are errors, never accidental capture/export intent.
+fn capture_intent(vm: &mut ScriptVm, args: ScriptValue, recording: bool) -> Result<CaptureIntent, &'static str> {
+    let Some(args) = args.as_object() else {
+        return if args.is_nil() { Ok(CaptureIntent::default()) } else { Err("bad_request: pass an options object with boolean audio/library fields") };
+    };
+    match vm.bx.heap.vec_len(args) {
+        0 => return Ok(CaptureIntent::default()),
+        1 => {},
+        _ => return Err("bad_request: capture accepts one options object"),
+    }
+    let value = vm.bx.heap.vec_value_if_exist(args, 0).unwrap_or(NIL);
+    let Some(options) = value.as_object() else {
+        return Err("bad_request: capture options must be an object, such as {library: false}");
+    };
+    if vm.bx.heap.vec_len(options) != 0 || vm.bx.heap.map_len(options) > 2 {
+        return Err("bad_request: only boolean audio/library capture options are supported");
+    }
+    let mut fields = Vec::new();
+    vm.bx.heap.object_data(options).map_iter(|key, value| fields.push((key, value)));
+    let mut intent = CaptureIntent::default();
+    for (key, value) in fields {
+        let name = key.as_id().or_else(|| vm.bx.heap.cast_to_owned_string(key, "reading capture option").map(|key| LiveId::from_str(&key)));
+        let Some(value) = value.as_bool() else {
+            return Err("bad_request: audio and library must be true or false, not strings or numbers");
+        };
+        match name {
+            Some(name) if name == live_id!(library) => intent.library = value,
+            Some(name) if name == live_id!(audio) && recording => intent.audio = value,
+            _ => return Err("bad_request: capture supports library; record_start supports audio and library"),
+        }
+    }
+    Ok(intent)
+}
