+    #[test]
+    fn available_microphone_and_library_never_opt_a_capture_in() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let widget = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let value = crate::script_eval!(vm, {use mod.widgets.* CameraPreview{}});
+            WidgetRef::script_from_value(vm, value)
+        });
+        let mut preview = widget.borrow_mut::<CameraPreview>().unwrap();
+        let heap = preview.heap_key();
+        crate::splash_policy::set_policy_for_heap(heap, vec!["camera".into(), "microphone".into(), "library".into()], vec![], None);
+        preview.state = State::Running;
+        preview.input = Some(VideoInputId(LiveId(1)));
+        // No storage root: stop before native capture. Broad API availability
+        // must neither request microphone permission nor select gallery export.
+        assert!(!preview.record_start(&mut cx, CaptureIntent::default()));
+        assert!(preview.audio_permission_request.is_none());
+        assert!(!preview.recording_audio);
+        assert!(preview.last_error.contains("storage"));
+        assert!(!preview.last_error.contains("export"));
+        crate::splash_policy::gc_policies(&[heap]);
+    }
