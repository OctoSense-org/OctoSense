+    #[test]
+    fn capture_options_require_explicit_boolean_intent() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        cx.with_vm(|vm| {
+            let args_for = |vm: &mut ScriptVm, value: Option<ScriptValue>| {
+                let args = vm.bx.heap.new_object();
+                if let Some(value) = value {
+                    let trap = vm.bx.threads.cur().trap.pass();
+                    vm.bx.heap.vec_push(args, NIL, value, trap);
+                }
+                args.into()
+            };
+            let empty = args_for(vm, None);
+            assert_eq!(capture_intent(vm, empty, false), Ok(CaptureIntent::default()));
+            assert_eq!(capture_intent(vm, empty, true), Ok(CaptureIntent::default()));
+            let options = crate::script_eval!(vm, {{audio: true library: false}});
+            let args = args_for(vm, Some(options));
+            assert_eq!(capture_intent(vm, args, true), Ok(CaptureIntent { audio: true, library: false }));
+            assert!(capture_intent(vm, args, false).unwrap_err().contains("capture supports library"));
+            let library = crate::script_eval!(vm, {{library: true}});
+            let args = args_for(vm, Some(library));
+            assert_eq!(capture_intent(vm, args, false), Ok(CaptureIntent { audio: false, library: true }));
+            for value in [
+                crate::script_eval!(vm, {{audio: "true"}}),
+                crate::script_eval!(vm, {{library: 1}}),
+                crate::script_eval!(vm, {{export: true}}),
+                crate::script_eval!(vm, {true}),
+                NIL,
+            ] {
+                let args = args_for(vm, Some(value));
+                assert!(capture_intent(vm, args, true).unwrap_err().starts_with("bad_request:"));
+            }
+            let args = vm.bx.heap.new_object();
+            let trap = vm.bx.threads.cur().trap.pass();
+            vm.bx.heap.vec_push(args, NIL, options, trap);
+            vm.bx.heap.vec_push(args, NIL, library, trap);
+            assert!(capture_intent(vm, args.into(), true).is_err(), "extra arguments cannot hide intent");
+        });
+    }
