+    #[test]
+    fn stopping_during_prepare_allows_retry_and_ignores_retired_generation_events() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let widget = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let value = crate::script_eval!(vm, {use mod.widgets.* CameraPreview{}});
+            WidgetRef::script_from_value(vm, value)
+        });
+        let mut preview = widget.borrow_mut::<CameraPreview>().unwrap();
+        let heap = preview.heap_key();
+        crate::splash_policy::set_policy_for_heap(heap, vec!["camera".into()], vec![], None);
+        preview.permission = Some(PermissionStatus::Granted);
+        preview.cameras = vec![CameraChoice { input_id: VideoInputId(LiveId(1)), front: false,
+            formats: vec![format(640, 480, VideoPixelFormat::YUV420, 1)] }];
+        // No native event loop runs: preparation only queues a synthetic source.
+        assert!(preview.start(&mut cx));
+        assert!(preview.video(&cx).is_preparing());
+        let old_id = preview.video(&cx).playback_id().unwrap();
+        preview.stop(&mut cx);
+        assert_eq!(preview.state, State::Idle, "detached cleanup does not wait for an old acknowledgement");
+        assert!(preview.video(&cx).is_unprepared());
+        assert!(preview.start(&mut cx));
+        let new_id = preview.video(&cx).playback_id().unwrap();
+        assert_ne!(new_id, old_id);
+        assert_eq!(preview.state, State::Starting);
+        let prepared = |video_id| Event::VideoPlaybackPrepared(VideoPlaybackPreparedEvent {
+            video_id, video_width: 640, video_height: 480, duration: 0, is_seekable: false,
+            video_tracks: vec![], audio_tracks: vec![],
+        });
+        for event in [prepared(old_id),
+            Event::VideoDecodingError(VideoDecodingErrorEvent { video_id: old_id, error: "retired failure".into() }),
+            Event::VideoPlaybackResourcesReleased(VideoPlaybackResourcesReleasedEvent { video_id: old_id })] {
+            preview.handle_event(&mut cx, &event, &mut Scope::empty());
+            assert_eq!(preview.state, State::Starting, "a retired callback cannot change the new preview");
+            assert!(preview.wanted);
+            assert!(preview.last_error.is_empty());
+        }
+        preview.handle_event(&mut cx, &prepared(new_id), &mut Scope::empty());
+        assert_eq!(preview.state, State::Running);
+        preview.stop(&mut cx);
+        preview.handle_event(&mut cx, &Event::VideoPlaybackResourcesReleased(
+            VideoPlaybackResourcesReleasedEvent { video_id: new_id }), &mut Scope::empty());
+        assert_eq!(preview.state, State::Idle);
+        crate::splash_policy::gc_policies(&[heap]);
+    }
