+        assert_eq!(accessibility_stroke(0, 16.0, 3.0), 0.0);
+        assert_eq!(accessibility_stroke(300, 14.0, 2.0), 1.0);
+        assert_eq!(accessibility_stroke(-300, 14.0, 2.0), -1.0);
+        assert_eq!(accessibility_stroke(1000, 80.0, 2.0), 2.5);
+        assert_eq!(accessibility_stroke(300, 28.0, 2.0), 2.0);
+    }
+}
