+extern "C" {
+    fn XSelectInput(display: *mut x::Display, window: x::Window, mask: c_long) -> c_int;
+    fn XSync(display: *mut x::Display, discard: c_int) -> c_int;
+    fn XReparentWindow(display: *mut x::Display, window: x::Window, parent: x::Window, x: c_int, y: c_int) -> c_int;
+    fn XUnmapWindow(display: *mut x::Display, window: x::Window) -> c_int;
+}
