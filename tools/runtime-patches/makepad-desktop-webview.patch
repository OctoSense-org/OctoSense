+            let root = x::XRootWindow(self.display, x::XDefaultScreen(self.display));
+            XReparentWindow(self.display, self.socket, root, 0, 0);
+            self.parent = root;
+            x::XFlush(self.display);
+        }
+        self.attached = None;
+    }
+    pub(crate) fn focus(&mut self, focused: bool) {
+        if focused && !self.visible { return; }
+        if self.focused == focused { return; }
+        self.focused = focused;
+        self.send_xembed(if focused { 4 } else { 5 }, 0, 0, 0);
+        unsafe {
+            if focused {
+                x::XSetInputFocus(self.display, self.plug_id, 2, 0);
+                (self.state.api.gtk_widget_grab_focus)(self.view);
+            } else if self.visible {
+                x::XSetInputFocus(self.display, self.parent, 2, 0);
+            }
+        }
+    }
+    pub(crate) fn active(&mut self, active: bool) {
+        if self.visible { self.send_xembed(if active { 1 } else { 2 }, 0, 0, 0); }
+        if !active { self.focused = false; self.send_xembed(5, 0, 0, 0); }
+    }
+    pub(crate) fn xembed_message(&mut self, window: x::Window, atom: x::Atom, message: c_long) -> bool {
+        if window != self.socket || atom != self.xembed { return false; }
+        match message { 3 => self.focus(true), 6 | 7 => self.focus(false), _ => {} }
+        true
+    }
+    pub(crate) fn set_url(&mut self, url: &str, replace: bool) {
+        if self.state.finished.get() { return; }
+        if !self.has_allocation { self.pending_document = Some(Document::Url(url.to_owned(), replace)); return; }
+        match BrowserPolicy::reader(url, self.state.navigable) {
+            Ok(policy) => *self.state.policy.borrow_mut() = policy,
+            Err(message) => { self.state.error(message); return; }
+        }
+        if !matches!(self.state.policy.borrow().decide(url, true), NavigationDecision::Allow) {
+            self.state.blocked(); return;
+        }
+        let Ok(uri) = CString::new(url) else { self.state.error("Invalid browser URL"); return; };
+        unsafe {
+            // A native replace is implemented inside the existing document;
+            // normal navigation policies still enforce its destination.
+            if replace {
