index 000000000..d079a6d60
--- /dev/null
+++ b/platform/src/os/linux/linux_webkit.rs
@@ -0,0 +1,507 @@
+//! Optional WebKitGTK browser, embedded by XEmbed in an existing X11 window.
+//!
+//! Only system libraries are loaded; ordinary Makepad builds require no GTK or
+//! WebKit development packages. GTK owns a child GtkPlug, never a free-standing
+//! application window. All GTK operations and callbacks run on the UI thread.
+use super::{module_loader::ModuleLoader, x11::x11_sys as x};
+use crate::{
+    cx::Cx,
+    event::{NativeAuthBrowserEvent, NativeSystemBrowserNavigation, NativeSystemBrowserPageError},
+    makepad_math::Rect,
+    system_browser::{BrowserPolicy, NavigationDecision},
+    window::WindowId,
+};
+use std::{
+    cell::{Cell, RefCell},
+    ffi::{c_char, c_int, c_long, c_uint, c_ulong, c_void, CStr, CString},
+    mem::ManuallyDrop,
+    ptr,
+    rc::Rc,
+};
+
+type Object = *mut c_void;
+type Callback = unsafe extern "C" fn();
+
+#[repr(C)]
+struct Allocation { x: c_int, y: c_int, width: c_int, height: c_int }
+
+macro_rules! api {
+    ($($name:ident: $ty:ty),* $(,)?) => {
+        struct Api {
+            // GTypes retain class/vtable addresses until process exit, even
+            // after the last view closes. Never dlclose their libraries.
+            _libraries: ManuallyDrop<Vec<ModuleLoader>>,
+            $($name: $ty,)*
+        }
+        impl Api {
+            fn load() -> Result<Rc<Self>, &'static str> {
+                let gtk = ModuleLoader::load("libgtk-3.so.0")
+                    .map_err(|_| "Install the system GTK3 and WebKitGTK 4.1 runtime to use embedded browsing")?;
+                let webkit = ModuleLoader::load("libwebkit2gtk-4.1.so.0")
+                    .or_else(|_| ModuleLoader::load("libwebkit2gtk-4.0.so.37"))
+                    .map_err(|_| "Install the system WebKitGTK 4.1 runtime to use embedded browsing")?;
+                let api = Self {
+                    $($name: webkit.get_symbol(stringify!($name))
+                        .or_else(|_| gtk.get_symbol(stringify!($name)))
+                        .map_err(|_| "The installed WebKitGTK/GTK3 runtime is missing a required browser API")?,)*
+                    _libraries: ManuallyDrop::new(vec![gtk, webkit]),
+                };
+                unsafe {
+                    // GTK must use the same protocol as our parent X11 window.
+                    // This does not change Makepad's backend or process env.
+                    (api.gdk_set_allowed_backends)(c"x11".as_ptr());
+                    if (api.gtk_init_check)(ptr::null_mut(), ptr::null_mut()) == 0 {
+                        return Err("GTK could not connect to the X11 display");
+                    }
+                }
+                Ok(Rc::new(api))
+            }
+        }
+    };
+}
+api! {
+    gdk_set_allowed_backends: unsafe extern "C" fn(*const c_char),
+    gdk_display_get_default: unsafe extern "C" fn() -> Object,
+    gdk_display_sync: unsafe extern "C" fn(Object),
+    gdk_x11_display_error_trap_push: unsafe extern "C" fn(Object),
+    gdk_x11_display_error_trap_pop_ignored: unsafe extern "C" fn(Object),
+    gtk_init_check: unsafe extern "C" fn(*mut c_int, *mut *mut *mut c_char) -> c_int,
+    g_main_context_iteration: unsafe extern "C" fn(Object, c_int) -> c_int,
+    g_signal_connect_data: unsafe extern "C" fn(Object, *const c_char, Callback, Object, Option<unsafe extern "C" fn(Object, Object)>, c_uint) -> c_ulong,
+    g_signal_handler_disconnect: unsafe extern "C" fn(Object, c_ulong),
+    g_object_unref: unsafe extern "C" fn(Object),
+    gtk_plug_new: unsafe extern "C" fn(c_ulong) -> Object,
+    gtk_plug_get_id: unsafe extern "C" fn(Object) -> c_ulong,
+    gtk_container_add: unsafe extern "C" fn(Object, Object),
+    gtk_widget_show_all: unsafe extern "C" fn(Object),
+    gtk_widget_destroy: unsafe extern "C" fn(Object),
+    gtk_widget_set_size_request: unsafe extern "C" fn(Object, c_int, c_int),
+    gtk_widget_size_allocate: unsafe extern "C" fn(Object, *const Allocation),
+    gtk_widget_get_scale_factor: unsafe extern "C" fn(Object) -> c_int,
+    gtk_widget_grab_focus: unsafe extern "C" fn(Object),
+    webkit_web_context_new_ephemeral: unsafe extern "C" fn() -> Object,
+    webkit_web_context_set_tls_errors_policy: unsafe extern "C" fn(Object, c_int),
+    webkit_web_view_new_with_context: unsafe extern "C" fn(Object) -> Object,
+    webkit_web_view_get_settings: unsafe extern "C" fn(Object) -> Object,
+    webkit_settings_set_javascript_can_open_windows_automatically: unsafe extern "C" fn(Object, c_int),
+    webkit_settings_set_enable_developer_extras: unsafe extern "C" fn(Object, c_int),
+    webkit_web_view_set_zoom_level: unsafe extern "C" fn(Object, f64),
+    webkit_web_view_load_uri: unsafe extern "C" fn(Object, *const c_char),
+    webkit_web_view_load_html: unsafe extern "C" fn(Object, *const c_char, *const c_char),
+    webkit_web_view_stop_loading: unsafe extern "C" fn(Object),
+    webkit_web_view_get_uri: unsafe extern "C" fn(Object) -> *const c_char,
+    webkit_web_view_get_title: unsafe extern "C" fn(Object) -> *const c_char,
+    webkit_web_view_is_loading: unsafe extern "C" fn(Object) -> c_int,
+    webkit_web_view_run_javascript: unsafe extern "C" fn(Object, *const c_char, Object, Option<unsafe extern "C" fn(Object, Object, Object)>, Object),
+    webkit_web_view_get_back_forward_list: unsafe extern "C" fn(Object) -> Object,
+    webkit_back_forward_list_get_nth_item: unsafe extern "C" fn(Object, c_int) -> Object,
+    webkit_web_view_go_to_back_forward_list_item: unsafe extern "C" fn(Object, Object),
+    webkit_navigation_policy_decision_get_request: unsafe extern "C" fn(Object) -> Object,
+    webkit_response_policy_decision_get_request: unsafe extern "C" fn(Object) -> Object,
+    webkit_response_policy_decision_is_main_frame_main_resource: unsafe extern "C" fn(Object) -> c_int,
+    webkit_response_policy_decision_is_mime_type_supported: unsafe extern "C" fn(Object) -> c_int,
+    webkit_uri_request_get_uri: unsafe extern "C" fn(Object) -> *const c_char,
+    webkit_policy_decision_use: unsafe extern "C" fn(Object),
+    webkit_policy_decision_ignore: unsafe extern "C" fn(Object),
+    webkit_permission_request_deny: unsafe extern "C" fn(Object),
+    webkit_file_chooser_request_cancel: unsafe extern "C" fn(Object),
+    webkit_download_cancel: unsafe extern "C" fn(Object),
+    webkit_authentication_request_cancel: unsafe extern "C" fn(Object),
+}
+thread_local! {
+    static API: RefCell<Option<Result<Rc<Api>, &'static str>>> = const { RefCell::new(None) };
+}
+fn api() -> Result<Rc<Api>, &'static str> {
+    API.with(|slot| slot.borrow_mut().get_or_insert_with(Api::load).clone())
+}
+
+/// Run a bounded amount of GLib work. Never wait for events or a web process.
+pub(crate) fn pump() {
+    API.with(|slot| {
+        let api = match &*slot.borrow() { Some(Ok(api)) => api.clone(), _ => return };
+        for _ in 0..16 {
+            if unsafe { (api.g_main_context_iteration)(ptr::null_mut(), 0) } == 0 { break; }
+        }
+    });
+}
+
+pub(crate) fn unavailable(browser_id: u64, auth: bool, description: &str) {
+    if auth {
+        Cx::post_action(NativeAuthBrowserEvent { browser_id, kind: "error".into(), url: String::new() });
+    } else {
+        Cx::post_action(NativeSystemBrowserPageError {
+            browser_id, code: -1, description: description.into(), url: String::new(),
+        });
+    }
+}
+
+struct State {
+    api: Rc<Api>,
+    id: u64,
+    policy: RefCell<BrowserPolicy>,
+    navigable: bool,
+    finished: Cell<bool>,
+}
+impl State {
+    fn blocked(&self) {
+        self.error("The embedded browser blocked a disallowed navigation or operation");
+    }
+    fn error(&self, description: &str) {
+        if !self.finished.get() { unavailable(self.id, false, description); }
+    }
+    unsafe fn navigation(&self, view: Object) {
+        if self.finished.get() { return; }
+        Cx::post_action(NativeSystemBrowserNavigation {
+            browser_id: self.id,
+            url: string((self.api.webkit_web_view_get_uri)(view)),
+            title: string((self.api.webkit_web_view_get_title)(view)),
+            loading: (self.api.webkit_web_view_is_loading)(view) != 0,
+            error: None,
+        });
+    }
+}
+unsafe fn string(value: *const c_char) -> String {
+    if value.is_null() { String::new() } else { CStr::from_ptr(value).to_string_lossy().into_owned() }
+}
+unsafe fn state<'a>(value: Object) -> &'a State { &*(value as *const State) }
+
+unsafe extern "C" fn decide(_view: Object, decision: Object, kind: c_int, data: Object) -> c_int {
+    let s = state(data);
+    if s.finished.get() || kind == 1 { // Never create a popup/auxiliary browsing context.
+        (s.api.webkit_policy_decision_ignore)(decision);
+        s.blocked();
+        return 1;
+    }
+    let (request, main) = match kind {
+        0 => ((s.api.webkit_navigation_policy_decision_get_request)(decision), false),
+        2 => ((s.api.webkit_response_policy_decision_get_request)(decision),
+            (s.api.webkit_response_policy_decision_is_main_frame_main_resource)(decision) != 0),
+        _ => { (s.api.webkit_policy_decision_ignore)(decision); return 1; }
+    };
+    let url = string((s.api.webkit_uri_request_get_uri)(request));
+    let policy = s.policy.borrow();
+    let result = policy.decide(&url, main);
+    let supported = kind != 2 || (s.api.webkit_response_policy_decision_is_mime_type_supported)(decision) != 0;
+    match result {
+        NavigationDecision::Allow if supported => (s.api.webkit_policy_decision_use)(decision),
+        _ => { (s.api.webkit_policy_decision_ignore)(decision); s.blocked(); }
+    }
+    1
+}
+unsafe extern "C" fn load_changed(view: Object, _event: c_int, data: Object) { state(data).navigation(view); }
+unsafe extern "C" fn load_failed(_view: Object, _event: c_int, _uri: *const c_char, error: *const GError, data: Object) -> c_int {
+    // WEBKIT_NETWORK_ERROR_CANCELLED is an intentional stop/policy rejection.
+    if !error.is_null() && (*error).code == 302 { return 1; }
+    state(data).error("The embedded browser could not load the page");
+    1 // Never display an engine-generated error page carrying a sensitive URL.
+}
+#[repr(C)]
+struct GError { domain: u32, code: c_int, message: *mut c_char }
+unsafe extern "C" fn tls_failed(_view: Object, _uri: *const c_char, _certificate: Object, _errors: c_uint, data: Object) -> c_int {
+    state(data).error("The embedded browser rejected an invalid TLS certificate");
+    1
+}
+unsafe extern "C" fn process_terminated(_view: Object, _reason: c_int, data: Object) {
+    state(data).error("The embedded browser process exited");
+}
+unsafe extern "C" fn deny_permission(_view: Object, request: Object, data: Object) -> c_int {
+    let s = state(data); (s.api.webkit_permission_request_deny)(request); s.blocked(); 1
+}
+unsafe extern "C" fn deny_file(_view: Object, request: Object, data: Object) -> c_int {
+    let s = state(data); (s.api.webkit_file_chooser_request_cancel)(request); s.blocked(); 1
+}
+unsafe extern "C" fn deny_authenticate(_view: Object, request: Object, data: Object) -> c_int {
+    let s = state(data); (s.api.webkit_authentication_request_cancel)(request); s.blocked(); 1
+}
+unsafe extern "C" fn deny_download(_context: Object, download: Object, data: Object) {
+    let s = state(data); (s.api.webkit_download_cancel)(download); s.blocked();
+}
+unsafe extern "C" fn deny_popup(_view: Object, _action: Object, data: Object) -> Object {
+    state(data).blocked(); ptr::null_mut()
+}
+unsafe extern "C" fn deny_dialog(_view: Object, _dialog: Object, data: Object) -> c_int {
+    state(data).blocked(); 1
+}
+unsafe extern "C" fn deny_context_menu(_view: Object, _menu: Object, _event: Object, _hit: Object, _data: Object) -> c_int { 1 }
+unsafe extern "C" fn deny_fullscreen(_view: Object, _data: Object) -> c_int { 1 }
+unsafe extern "C" fn deny_print(_view: Object, _operation: Object, _data: Object) -> c_int { 1 }
+unsafe extern "C" fn closed(_view: Object, data: Object) {
+    let s = state(data);
+    s.finished.set(true);
+}
+
+enum Document { Url(String, bool), Html(String, String) }
+
+pub(crate) struct LinuxSystemBrowser {
+    state: Box<State>,
+    view: Object,
+    plug: Object,
+    context: Object,
+    signals: Vec<(Object, c_ulong)>,
+    display: *mut x::Display,
+    socket: x::Window,
+    plug_id: x::Window,
+    xembed: x::Atom,
+    parent: x::Window,
+    attached: Option<WindowId>,
+    visible: bool,
+    focused: bool,
+    has_allocation: bool,
+    pending_document: Option<Document>,
+}
+impl LinuxSystemBrowser {
+    pub(crate) fn new(display: *mut x::Display, id: u64, url: &str, navigable: bool) -> Result<Self, &'static str> {
+        let policy = BrowserPolicy::reader(url, navigable)?;
+        let api = api()?;
+        unsafe {
+            // Start under an UNMAPPED child of root. No independent GTK toplevel
+            // becomes visible, even if loading starts before the first draw.
+            let root = x::XRootWindow(display, x::XDefaultScreen(display));
+            let socket = x::XCreateWindow(display, root, 0, 0, 1, 1, 0, 0, x::InputOutput, ptr::null_mut(), 0, ptr::null_mut());
+            if socket == 0 { return Err("Could not create the browser child window"); }
+            XSelectInput(display, socket, (x::SubstructureNotifyMask | x::StructureNotifyMask | x::FocusChangeMask) as c_long);
+            XSync(display, 0); // GTK uses a separate X connection: socket must exist first.
+            let context = (api.webkit_web_context_new_ephemeral)();
+            if context.is_null() { x::XDestroyWindow(display, socket); return Err("Could not create an isolated WebKit context"); }
+            (api.webkit_web_context_set_tls_errors_policy)(context, 1); // WEBKIT_TLS_ERRORS_POLICY_FAIL, never IGNORE.
+            let view = (api.webkit_web_view_new_with_context)(context);
+            let plug = (api.gtk_plug_new)(socket);
+            if view.is_null() || plug.is_null() {
+                if !view.is_null() { (api.gtk_widget_destroy)(view); }
+                if !plug.is_null() { (api.gtk_widget_destroy)(plug); }
+                (api.g_object_unref)(context);
+                x::XDestroyWindow(display, socket);
+                return Err("Could not create the embedded WebKit view");
+            }
+            let settings = (api.webkit_web_view_get_settings)(view);
+            (api.webkit_settings_set_javascript_can_open_windows_automatically)(settings, 0);
+            (api.webkit_settings_set_enable_developer_extras)(settings, 0);
+            let mut browser = Self {
+                state: Box::new(State { api: api.clone(), id, policy: RefCell::new(policy), navigable, finished: Cell::new(false) }),
+                view, plug, context, signals: Vec::new(), display, socket, plug_id: 0,
+                xembed: x::XInternAtom(display, c"_XEMBED".as_ptr(), 0), parent: root,
+                attached: None, visible: false, focused: false,
+                has_allocation: false, pending_document: Some(Document::Url(url.to_owned(), false)),
+            };
+            macro_rules! signal { ($object:expr, $name:literal, $callback:ident) => {{
+                let handler = (api.g_signal_connect_data)($object, concat!($name, "\0").as_ptr().cast(),
+                    std::mem::transmute::<*const (), Callback>($callback as *const ()),
+                    (&*browser.state as *const State).cast_mut().cast(), None, 0);
+                browser.signals.push(($object, handler));
+            }}; }
+            signal!(view, "decide-policy", decide);
+            signal!(view, "load-changed", load_changed);
+            signal!(view, "load-failed", load_failed);
+            signal!(view, "load-failed-with-tls-errors", tls_failed);
+            signal!(view, "web-process-terminated", process_terminated);
+            signal!(view, "permission-request", deny_permission);
+            signal!(view, "run-file-chooser", deny_file);
+            signal!(view, "authenticate", deny_authenticate);
+            signal!(view, "create", deny_popup);
+            signal!(view, "script-dialog", deny_dialog);
+            signal!(view, "context-menu", deny_context_menu);
+            signal!(view, "enter-fullscreen", deny_fullscreen);
+            signal!(view, "print", deny_print);
+            signal!(view, "close", closed);
+            signal!(context, "download-started", deny_download);
+            (api.gtk_container_add)(plug, view);
+            (api.gtk_widget_show_all)(plug);
+            browser.plug_id = (api.gtk_plug_get_id)(plug);
+            // Establish GTK's child on its X connection before the Makepad
+            // connection sends XEmbed messages or geometry requests to it.
+            (api.gdk_display_sync)((api.gdk_display_get_default)());
+            browser.send_xembed(0, 0, socket as c_long, 0); // EMBEDDED_NOTIFY, protocol 0.
+            Ok(browser)
+        }
+    }
+
+    fn send_xembed(&self, message: c_long, detail: c_long, data1: c_long, data2: c_long) {
+        if self.plug_id == 0 { return; }
+        unsafe {
+            let mut event: x::XEvent = std::mem::zeroed();
+            event.xclient = x::XClientMessageEvent {
+                type_: x::ClientMessage as c_int, serial: 0, send_event: 1,
+                display: self.display, window: self.plug_id, message_type: self.xembed, format: 32,
+                data: x::XClientMessageEvent__bindgen_ty_1 { l: [0, message, detail, data1, data2] },
+            };
+            x::XSendEvent(self.display, self.plug_id, 0, 0, &mut event);
+            x::XFlush(self.display);
+        }
+    }
+
+    pub(crate) fn update(&mut self, window: WindowId, parent: x::Window, full: Rect, clip: Rect, dpi: f64, visible: bool) {
+        if self.state.finished.get() || !visible || clip.size.x <= 0.0 || clip.size.y <= 0.0
+            || full.size.x <= 0.0 || full.size.y <= 0.0 || !dpi.is_finite()
+            || ![full.pos.x, full.pos.y, full.size.x, full.size.y, clip.pos.x, clip.pos.y, clip.size.x, clip.size.y].iter().all(|v| v.is_finite()) {
+            self.hide(); return;
+        }
+        unsafe {
+            if self.parent != parent {
+                self.hide();
+                XReparentWindow(self.display, self.socket, parent, 0, 0);
+                self.parent = parent;
+            }
+            self.attached = Some(window);
+            // The socket clips the plug, preserving the complete document's
+            // layout while parent scroll/clip changes its visible rectangle.
+            x::XMoveWindow(self.display, self.socket, coord(clip.pos.x), coord(clip.pos.y));
+            x::XResizeWindow(self.display, self.socket, extent(clip.size.x), extent(clip.size.y));
+            let scale = (self.state.api.gtk_widget_get_scale_factor)(self.plug).max(1) as f64;
+            let allocation = Allocation { x: 0, y: 0, width: extent(full.size.x / scale) as c_int, height: extent(full.size.y / scale) as c_int };
+            (self.state.api.gtk_widget_set_size_request)(self.plug, allocation.width, allocation.height);
+            // The host may intentionally be hidden (remote instrumentation).
+            // GTK then receives no frame-clock allocation before page load.
+            // Allocate the sole child explicitly so its first document has the
+            // same viewport as the real native child, including in hidden mode.
+            (self.state.api.gtk_widget_size_allocate)(self.plug, &allocation);
+            (self.state.api.gtk_widget_size_allocate)(self.view, &allocation);
+            (self.state.api.webkit_web_view_set_zoom_level)(self.view, (dpi / scale).clamp(0.25, 5.0));
+            x::XMoveWindow(self.display, self.plug_id, coord(full.pos.x - clip.pos.x), coord(full.pos.y - clip.pos.y));
+            x::XResizeWindow(self.display, self.plug_id, extent(full.size.x), extent(full.size.y));
+            if !self.visible {
+                x::XMapWindow(self.display, self.socket);
+                self.send_xembed(1, 0, 0, 0); // WINDOW_ACTIVATE, no focus stealing.
+                self.visible = true;
+            }
+            x::XFlush(self.display);
+        }
+        self.has_allocation = true;
+        if let Some(document) = self.pending_document.take() {
+            match document {
+                Document::Url(url, replace) => self.set_url(&url, replace),
+                Document::Html(html, base) => self.set_html(&html, &base),
+            }
+        }
+    }
+    pub(crate) fn window(&self) -> Option<WindowId> { self.attached }
+    pub(crate) fn hide(&mut self) {
+        if self.visible {
+            self.focus(false);
+            self.send_xembed(2, 0, 0, 0);
+            unsafe { XUnmapWindow(self.display, self.socket); x::XFlush(self.display); }
+            self.visible = false;
+        }
+    }
+    pub(crate) fn detach(&mut self) {
+        self.hide();
