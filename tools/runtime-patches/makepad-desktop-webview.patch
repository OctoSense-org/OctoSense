+    pub(crate) fn set_html(&mut self, html: &str, base: &str) {
+        if self.state.finished.get() { return; }
+        if !self.has_allocation { self.pending_document = Some(Document::Html(html.to_owned(), base.to_owned())); return; }
+        let Ok(policy) = BrowserPolicy::reader(base, self.state.navigable) else { self.state.error("Invalid browser base URL"); return; };
+        let (Ok(html), Ok(base)) = (CString::new(html), CString::new(base)) else { return; };
+        *self.state.policy.borrow_mut() = policy;
+        unsafe { (self.state.api.webkit_web_view_load_html)(self.view, html.as_ptr(), base.as_ptr()); }
+    }
+    pub(crate) fn eval_js(&self, js: &str) {
+        // Only the owning native host can evaluate script; no page-to-host bridge.
+        if self.state.finished.get() { return; }
+        if let Ok(js) = CString::new(js) {
+            unsafe { (self.state.api.webkit_web_view_run_javascript)(self.view, js.as_ptr(), ptr::null_mut(), None, ptr::null_mut()); }
+        }
+    }
+    pub(crate) fn history_go(&self, delta: i32) {
+        if self.state.finished.get() { return; }
+        unsafe {
+            let list = (self.state.api.webkit_web_view_get_back_forward_list)(self.view);
+            let item = (self.state.api.webkit_back_forward_list_get_nth_item)(list, delta);
+            if !item.is_null() { (self.state.api.webkit_web_view_go_to_back_forward_list_item)(self.view, item); }
+        }
+    }
+}
+impl Drop for LinuxSystemBrowser {
+    fn drop(&mut self) {
+        self.hide();
+        self.state.finished.set(true);
+        unsafe {
+            // Disconnect before destroying GTK objects or releasing callback
+            // state. Web process signals may arrive during destruction.
+            for (object, signal) in self.signals.drain(..) { (self.state.api.g_signal_handler_disconnect)(object, signal); }
+            (self.state.api.webkit_web_view_stop_loading)(self.view);
+            let gdk_display = (self.state.api.gdk_display_get_default)();
+            // A window-manager close can already have destroyed the native
+            // parent. Trap only GTK teardown's expected stale-child errors.
+            (self.state.api.gdk_x11_display_error_trap_push)(gdk_display);
+            (self.state.api.gtk_widget_destroy)(self.plug);
+            // GTK and Makepad use separate X connections. Complete the plug's
+            // unmap/destroy before destroying its socket, otherwise the server
+            // can remove the child before GTK's queued UnmapWindow arrives.
+            (self.state.api.gdk_display_sync)(gdk_display);
+            (self.state.api.gdk_x11_display_error_trap_pop_ignored)(gdk_display);
+            (self.state.api.g_object_unref)(self.context);
+            x::XDestroyWindow(self.display, self.socket);
+            x::XFlush(self.display);
+        }
+    }
+}
+fn coord(value: f64) -> c_int { value.round().clamp(-32768.0, 32767.0) as c_int }
+fn extent(value: f64) -> c_uint { value.ceil().clamp(1.0, 32767.0) as c_uint }
+fn js_string(value: &str) -> String {
+    let mut out = String::from("\"");
+    for character in value.chars() {
+        match character {
+            '"' => out.push_str("\\\""), '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"), '\r' => out.push_str("\\r"),
+            c if c.is_control() || c == '\u{2028}' || c == '\u{2029}' => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out.push('"'); out
+}
