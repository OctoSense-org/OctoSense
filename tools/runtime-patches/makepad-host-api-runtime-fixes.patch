+#[test]
+fn parked_reentrant_callbacks_are_bounded_and_completed_threads_are_reused() {
+    use std::collections::HashSet;
+    let mut vm = test_vm();
+    let module = vm.new_module(id!(hostx));
+    vm.add_method(module, id_lut!(request), script_args_def!(callback = NIL), |vm, args| {
+        let callback = script_value!(vm, args.callback);
+        vm.call(callback, &[]);
+        NIL
+    });
+    let parked = RefCell::new(HashSet::new());
+    vm.add_method(module, id_lut!(park), script_args_def!(), move |vm, _args| {
+        if parked.borrow_mut().insert(vm.thread().thread_id().to_index()) {
+            vm.thread_mut().pause();
+        }
+        NIL
+    });
+    let effect = std::rc::Rc::new(std::cell::Cell::new(false));
+    let effect_out = effect.clone();
+    vm.add_method(module, id_lut!(effect), script_args_def!(), move |_vm, _args| {
+        effect_out.set(true);
+        NIL
+    });
+    vm.bx.captured_errors = Some(Vec::new());
+    let result = vm.with_instruction_limit(100_000, |vm| vm.eval(ScriptMod {
+        file: "bounded_parked_callbacks".into(),
+        code: "let callback = fn() { mod.hostx.park(); 11 }\ntry { for i in 0..300 { mod.hostx.request(callback) } } catch 99\nmod.hostx.effect()".into(),
+        ..Default::default()
+    }));
+    assert!(result.is_err(), "a callback loop must hit the thread bound");
+    assert!(vm.take_errors().iter().any(|error| error.contains("reentrant thread limit exceeded")));
+    assert!(!effect.get(), "script continued after the resource-limit bail");
+    let allocated = vm.bx.threads.len();
+    assert!(allocated <= 128);
+    assert_eq!(vm.bx.threads.current(), 0);
+    vm.set_thread(1);
+    assert_eq!(vm.resume().as_number(), Some(11.0));
+    vm.set_thread(0);
+    let result = vm.with_instruction_limit(1_000, |vm| vm.eval(ScriptMod {
+        file: "reused_callback_thread".into(),
+        code: "mod.hostx.request(fn() { 9 })\n7".into(),
+        ..Default::default()
+    }));
+    assert_eq!(result.as_number(), Some(7.0));
+    assert_eq!(vm.bx.threads.len(), allocated, "completed callback thread was not reused");
+}
