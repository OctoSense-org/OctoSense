+#[test]
+fn yielded_reentrant_callback_shares_fuel_and_preserves_prompt_authority() {
+    use std::cell::Cell;
+    use std::rc::Rc;
+    let mut vm = test_vm();
+    let pending = Rc::new(RefCell::new(None));
+    let yielded = Rc::new(Cell::new(false));
+    let module = vm.new_module(id!(hostx));
+    vm.add_method(module, id_lut!(request), script_args_def!(callback = NIL), |vm, args| {
+        let callback = script_value!(vm, args.callback);
+        let caller = vm.bx.threads.current();
+        vm.call(callback, &[]);
+        assert_eq!(vm.bx.threads.current(), caller);
+        2.into()
+    });
+    let thread_out = pending.clone();
+    vm.add_method(module, id_lut!(park), script_args_def!(), move |vm, _args| {
+        assert!(!vm.thread().host_prompts_allowed, "a callback cannot acquire prompt authority");
+        if !yielded.replace(true) {
+            *thread_out.borrow_mut() = Some(vm.thread().thread_id());
+            vm.thread_mut().pause();
+        }
+        NIL
+    });
+    vm.thread_mut().host_prompts_allowed = false;
+    vm.bx.captured_errors = Some(Vec::new());
+    let result = vm.with_instruction_limit(1_000, |vm| vm.eval(ScriptMod {
+        file: "reentrant_callback_parent".into(),
+        code: "let state = {value:0}\nlet result = 40 + mod.hostx.request(fn() {\nmod.hostx.park()\nfor i in 0..10000 { state.value = state.value + 1 }\n})\nfor i in 0..40 { state.value = state.value + 1 }\nresult".into(),
+        ..Default::default()
+    }));
+    let parent_consumed = vm.last_limit_consumed();
+    let errors = vm.take_errors();
+    assert!(errors.is_empty(), "parent errored: {errors:?}");
+    assert_eq!(result.as_number(), Some(42.0));
+    assert!(!vm.thread().is_paused());
+    assert!(parent_consumed > 200 && parent_consumed < 1_000);
+    let child = pending.borrow().expect("callback yielded");
+    assert_ne!(child.to_index(), vm.bx.threads.current());
+    vm.thread_mut().host_prompts_allowed = true;
+    vm.set_thread(child.to_index());
+    vm.bx.captured_errors = Some(Vec::new());
+    let result = vm.with_instruction_limit(1_000, |vm| vm.resume());
+    let child_consumed = vm.last_limit_consumed();
+    assert!(result.is_err());
+    assert!(vm.take_errors().iter().any(|error| error.contains("instruction limit exceeded")));
+    assert!(parent_consumed + child_consumed <= 1_000,
+        "fuel was duplicated: parent={parent_consumed}, child={child_consumed}");
+    assert!(!vm.thread().host_prompts_allowed);
+    let recovered = vm.eval(ScriptMod { file:"callback_recovered".into(), code:"7".into(), ..Default::default() });
+    assert_eq!(recovered.as_number(), Some(7.0), "completed thread retained exhausted family fuel");
+}
