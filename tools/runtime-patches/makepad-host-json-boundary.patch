+
+/// A delayed callback retains the authority of the originating request, even
+/// when its tool has completed and the foreground app has regained its baseline.
+struct CallbackPromptScope { heap: usize, restore: bool }
+impl CallbackPromptScope {
+    fn enter(heap: usize, may_prompt: bool) -> Self {
+        let restore = !may_prompt && BRIDGE.with(|bridge| bridge.borrow_mut().no_prompt.insert(heap));
+        Self { heap, restore }
+    }
+}
+impl Drop for CallbackPromptScope {
+    fn drop(&mut self) {
+        if self.restore { BRIDGE.with(|bridge| { bridge.borrow_mut().no_prompt.remove(&self.heap); }); }
+    }
+}
