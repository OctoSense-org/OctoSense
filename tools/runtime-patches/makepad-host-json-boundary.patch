+    #[test]
+    fn native_json_boundary_bounds_shared_graphs_cycles_and_escaped_controls() {
+        let mut heap = ScriptHeap::empty();
+        let control = heap.new_string_from_str("\u{1}");
+        assert_eq!(heap.to_json_string_bounded(control, 8).as_deref(), Some("\"\\u0001\""));
+        assert!(heap.to_json_string_bounded(control, 7).is_none());
+        let array = heap.new_array();
+        assert!(heap.to_json_string_bounded(array.into(), 0).is_none());
+        assert!(heap.to_json_string_bounded(array.into(), 1).is_none());
+        assert_eq!(heap.to_json_string_bounded(array.into(), 2).as_deref(), Some("[]"));
+        heap.array_push(array, array.into(), ScriptTrap::NoTrap);
+        assert!(heap.to_json_string_bounded(array.into(), 1024).is_none());
+
+        let object = heap.new_object();
+        heap.objects[object].proto = object.into();
+        assert!(heap.to_json_string_bounded(object.into(), 1024).is_none());
+
+        let mut value = heap.new_string_from_str("shared");
+        for _ in 0..24 {
+            let pair = heap.new_array();
+            heap.array_push(pair, value, ScriptTrap::NoTrap);
+            heap.array_push(pair, value, ScriptTrap::NoTrap);
+            value = pair.into();
+        }
+        assert!(heap.to_json_string_bounded(value, 1024).is_none());
+    }
