+/// As above, with a host authorization check immediately before native IO and
+/// again before a desktop temporary file replaces the selected destination.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn write_selected_file_guarded(path: &std::path::Path, bytes: &[u8], authorized: impl Fn() -> bool) -> Result<(), String> {
+    if !authorized() { return Err("file transfer cancelled or permission changed".into()); }
+    #[cfg(all(not(gpusim), target_os = "android"))]
+    if path.to_string_lossy().starts_with("content://") {
+        return unsafe { crate::os::linux::android::android_jni::write_file_dialog_uri(&path.to_string_lossy(), bytes) };
+    }
+    use std::io::Write;
+    let parent = path.parent().ok_or("invalid save destination")?.canonicalize().map_err(|_| "save folder unavailable")?;
+    let name = path.file_name().ok_or("invalid save destination")?;
+    let destination = parent.join(name);
+    if let Ok(meta) = std::fs::symlink_metadata(&destination) {
+        if !meta.is_file() || meta.file_type().is_symlink() { return Err("save destination is not a regular file".into()); }
+    }
+    let temporary = parent.join(format!(".makepad-export-{}", LiveId::unique().0));
+    let result = (|| {
+        let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(&temporary).map_err(|_| "cannot create export")?;
+        file.write_all(bytes).map_err(|_| "cannot write export")?;
+        drop(file);
+        if !authorized() { return Err("file transfer cancelled or permission changed"); }
+        std::fs::rename(&temporary, &destination).map_err(|_| "cannot finish export")
+    })();
+    if result.is_err() { let _ = std::fs::remove_file(&temporary); }
+    result.map_err(str::to_string)
+}
