+pub unsafe fn write_file_dialog_uri(uri: &str, bytes: &[u8]) -> Result<(), String> {
+    if bytes.len() > i32::MAX as usize { return Err("export exceeds the byte limit".into()); }
+    let scope = FileDialogJni::enter()?;
+    let env = scope.env;
+    let (activity, method) = scope.method(b"writeFileDialogUri\0", b"(Ljava/lang/String;[B)Z\0")?;
+    let uri = scope.string(uri)?;
+    let data = (**env).NewByteArray.unwrap()(env, bytes.len() as jni_sys::jsize);
+    scope.check_exception()?;
+    if data.is_null() { return Err("cannot allocate export".into()); }
+    if !bytes.is_empty() {
+        (**env).SetByteArrayRegion.unwrap()(env, data, 0, bytes.len() as jni_sys::jsize, bytes.as_ptr().cast());
+        scope.check_exception()?;
+    }
+    let ok = (**env).CallBooleanMethod.unwrap()(env, activity, method, uri, data) != 0;
+    scope.check_exception()?;
+    if ok { Ok(()) } else { Err("cannot write selected document".into()) }
