+
+    fn target(&self, path: &str) -> Result<PathBuf, String> {
+        let real = resolve_jailed(&self.root, path)?;
+        if real == self.root { return Err("cannot use the storage root as a file".into()); }
+        verify_no_symlinks(&self.root, &real)?;
+        Ok(real)
+    }
+
+    /// Single-file import never replaces an app's existing document.
+    pub fn import_new(&self, path: &str, bytes: &[u8]) -> Result<(), String> {
