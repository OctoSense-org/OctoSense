+/// A native host's view of a live isolate's existing jail. Never constructed
+/// from script arguments. Obtain and use this on the UI thread, where script
+/// filesystem writes are serialized, and refresh it after an asynchronous UI.
+pub struct StorageAccess {
+    root: PathBuf,
+    quota: u64,
+}
+
+pub fn storage_for_heap(heap_key: usize, app_id: &str) -> Option<StorageAccess> {
+    if crate::splash_host::app_tag_for_heap(heap_key).as_deref() != Some(app_id) { return None; }
+    Some(StorageAccess {
+        root: root_for_heap(heap_key)?,
+        quota: JAIL_QUOTAS.with(|q| q.borrow().get(&heap_key).copied()).unwrap_or(MAX_TOTAL_BYTES),
+    })
+}
+
+impl StorageAccess {
+    pub fn quota(&self) -> u64 { self.quota }
