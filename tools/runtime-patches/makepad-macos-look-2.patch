+    /// A Mac's CPU Time reads as Activity Monitor's.
+    #[test]
+    fn cpu_time_reads_as_activity_monitor() {
+        let s = 1_000_000_000u64;
+        assert_eq!(format_cpu_time(0), "0.00");
+        assert_eq!(format_cpu_time(s / 2 + 26_000_000), "0.52");
+        assert_eq!(format_cpu_time(4 * 60 * s + 31 * s + 470_000_000), "4:31.47");
+        assert_eq!(format_cpu_time(2 * 3600 * s + 45 * 60 * s + 27 * s + 390_000_000), "2:45:27.39");
+        // A process of weeks keeps its hundredths; its column holds them.
+        assert_eq!(format_cpu_time(129 * 3600 * s + 60 * s + 8 * s + 900_000_000), "129:01:08.90");
+        assert_eq!(format_cpu_time(59 * s + 999_999_999), "59.99");
+    }
