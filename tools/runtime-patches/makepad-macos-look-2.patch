+// ---- FootGraph ----
+
+/// One filled history in a Mac's foot panel graph.
+#[derive(Clone, Debug)]
+pub struct FootSeries {
+    pub color: Vec4f,
+    /// Oldest first, on the graph's 0..100 scale.
+    pub points: Vec<f64>,
+}
+
+/// The graph in a Mac's panel under the table, as Activity Monitor's: a framed
+/// well with the newest reading at its right edge. Stacked, it is CPU LOAD's
+/// columns, one a reading, system time under user time; overlaid, each history
+/// is filled up from the floor with a line along its top (memory pressure,
+/// data read and written, data received and sent).
+#[derive(Script, ScriptHook, Widget)]
+pub struct FootGraph {
+    #[uid]
+    uid: WidgetUid,
+    #[source]
+    source: ScriptObjectRef,
+    #[walk]
+    walk: Walk,
+    #[redraw]
+    #[live]
+    draw_bg: DrawColor,
+    #[live]
+    draw_seg: DrawChartSegment,
+    #[live]
+    color_bg: Vec4f,
+    #[live]
+    color_frame: Vec4f,
+    #[rust]
+    series: Vec<FootSeries>,
+    #[rust]
+    stacked: bool,
+    /// The readings the well holds edge to edge.
+    #[rust(2usize)]
+    capacity: usize,
+}
+
+impl FootGraph {
+    pub fn set_series(&mut self, cx: &mut Cx, series: Vec<FootSeries>, stacked: bool, capacity: usize) {
+        self.series = series;
+        self.stacked = stacked;
+        self.capacity = capacity.max(2);
+        self.draw_bg.redraw(cx);
+    }
+
+    /// Stacked: a column a reading, each series on the one before it.
+    fn draw_columns(&mut self, cx: &mut Cx2d, well: Rect) {
+        let step = well.size.x / self.capacity as f64;
+        // A hairline of the well between columns while they are wide enough to show it.
+        let gap = if step >= 3.0 { 1.0 } else { 0.0 };
+        let len = self.series.iter().map(|series| series.points.len()).max().unwrap_or(0).min(self.capacity);
+        let floor = well.pos.y + well.size.y;
+        let right = well.pos.x + well.size.x;
+        for at in 0..len {
+            let x = right - (len - at) as f64 * step;
+            let mut base = 0.0;
+            for index in 0..self.series.len() {
+                let points = &self.series[index].points;
+                // Right-aligned: a shorter history is the newest readings.
+                let Some(point) = (at + points.len()).checked_sub(len) else { continue };
+                let tall = points[point].clamp(0.0, 100.0) / 100.0 * well.size.y;
+                let tall = tall.min(well.size.y - base);
+                if tall >= 0.25 {
+                    self.draw_bg.color = self.series[index].color;
+                    self.draw_bg.draw_abs(cx, Rect { pos: dvec2(x + gap, floor - base - tall), size: dvec2(step - gap, tall) });
+                }
+                base += tall;
+            }
+        }
+    }
+
+    /// Overlaid: each history filled from the floor, with its top drawn as a line.
+    fn draw_areas(&mut self, cx: &mut Cx2d, well: Rect) {
+        let dx = well.size.x / (self.capacity - 1) as f64;
+        let floor = well.pos.y + well.size.y;
+        let right = well.pos.x + well.size.x;
+        let py = |value: f64| floor - value.clamp(0.0, 100.0) / 100.0 * (well.size.y - 1.0);
+        for index in 0..self.series.len() {
+            let color = self.series[index].color;
+            let points = self.series[index].points.clone();
+            let points = &points[points.len().saturating_sub(self.capacity)..];
+            let n = points.len();
+            if n < 2 {
+                continue;
+            }
+            let x_of = |at: usize| right - (n - 1 - at) as f64 * dx;
+            // The fill: a quad a step, cut along the line between its two readings.
+            self.draw_seg.mode = 1.0;
+            self.draw_seg.fade_len = 1.0e6;
+            self.draw_seg.color = vec4(color.x, color.y, color.z, 0.3);
+            for at in 0..n - 1 {
+                let (x0, y0, y1) = (x_of(at), py(points[at]), py(points[at + 1]));
+                let top = y0.min(y1);
+                if floor - top < 0.5 {
+                    continue;
+                }
+                self.draw_seg.seg_a = Vec2f { x: 0.0, y: (y0 - top) as f32 };
+                self.draw_seg.seg_b = Vec2f { x: dx as f32, y: (y1 - top) as f32 };
+                self.draw_seg.draw_abs(cx, Rect { pos: dvec2(x0, top), size: dvec2(dx, floor - top) });
+            }
+            self.draw_seg.mode = 0.0;
+            self.draw_seg.color = color;
+            self.draw_seg.thickness = 1.25;
+            let margin = 2.0;
+            for at in 0..n - 1 {
+                let (x0, y0, y1) = (x_of(at), py(points[at]), py(points[at + 1]));
+                let quad = Rect {
+                    pos: dvec2(x0 - margin, y0.min(y1) - margin),
+                    size: dvec2(dx + 2.0 * margin, (y0 - y1).abs() + 2.0 * margin),
+                };
+                self.draw_seg.seg_a = Vec2f { x: margin as f32, y: (y0 - quad.pos.y) as f32 };
+                self.draw_seg.seg_b = Vec2f { x: (dx + margin) as f32, y: (y1 - quad.pos.y) as f32 };
+                self.draw_seg.draw_abs(cx, quad);
+            }
+        }
+    }
+}
+
+impl Widget for FootGraph {
+    fn handle_event(&mut self, _cx: &mut Cx, _event: &Event, _scope: &mut Scope) {}
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, _scope: &mut Scope, walk: Walk) -> DrawStep {
+        let rect = cx.walk_turtle(walk);
+        self.draw_bg.color = self.color_frame;
+        self.draw_bg.draw_abs(cx, rect);
+        let well = Rect { pos: rect.pos + dvec2(1.0, 1.0), size: rect.size - dvec2(2.0, 2.0) };
+        self.draw_bg.color = self.color_bg;
+        self.draw_bg.draw_abs(cx, well);
+        if well.size.x >= 8.0 && well.size.y >= 8.0 {
+            if self.stacked {
+                self.draw_columns(cx, well);
+            } else {
+                self.draw_areas(cx, well);
+            }
+        }
+        DrawStep::done()
+    }
+}
