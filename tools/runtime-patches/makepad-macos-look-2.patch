+/// `days` with `weekday` (0 Sunday) turned on or off, as a Mac's Repeat menu
+/// does: from Never a day starts a set, and the last day off is Never again.
+pub fn toggle_day(days: u32, weekday: u32) -> u32 {
+    (days ^ (1 << (weekday % 7))) & EVERY_DAY
