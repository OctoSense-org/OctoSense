+    let only_cmd = m.sup && !m.ctrl && !m.alt && !m.shift;
+    let shift_cmd = m.sup && m.shift && !m.ctrl && !m.alt;
+    let ctrl_cmd = m.sup && m.ctrl && !m.alt && !m.shift;
