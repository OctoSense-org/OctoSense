+#[cfg(test)]
+mod bar_tests {
+    use super::*;
+
+    /// A Mac's menu bar gets the shell's rows for Browser with what can't act
+    /// now grey, as JSON the shell reads (`WmRequest::MenuRows`).
+    #[test]
+    fn back_and_forward_grey_at_the_ends_of_the_history() {
+        use makepad_widgets::makepad_micro_serde::{DeJson, JsonValue};
+        let first = mac_bar_rows(BarCan { find: true, reload: true, ..BarCan::default() }, &BarPages::default());
+        assert!(JsonValue::deserialize_json(&first).is_ok(), "{first}");
+        assert!(first.contains(r#""menu":"History","title":"Back","key":"cmd+[","command":"key:cmd+[","enabled":false"#), "{first}");
+        assert!(first.contains(r#""title":"Stop","key":"cmd+.","command":"key:cmd+.","enabled":false"#), "{first}");
+        assert!(first.contains(r#""title":"Reload","key":"cmd+R","command":"key:cmd+R","enabled":true"#), "{first}");
+        let later = mac_bar_rows(BarCan { back: true, ..BarCan::default() }, &BarPages::default());
+        assert!(later.contains(r#""title":"Back","key":"cmd+[","command":"key:cmd+[","enabled":true"#), "{later}");
+        assert!(later.contains(r#""title":"Forward","key":"cmd+]","command":"key:cmd+]","enabled":false"#), "{later}");
+        assert!(later.contains("\"title\":\"Open Location\u{2026}\",\"key\":\"cmd+L\""), "{later}");
+    }
+
+    /// Safari's History lists the pages visited last and its Bookmarks the pages
+    /// kept, the Favorites in a submenu; a row opens its page, and any name stays JSON.
+    #[test]
+    fn history_and_bookmarks_list_their_pages() {
+        use makepad_widgets::makepad_micro_serde::{DeJson, JsonValue};
+        let page = |name: &str, url: &str| (name.to_string(), url.to_string());
+        let pages = BarPages {
+            recent: vec![page("Second \"Place\"", "http://localhost:8000/"), page("A\\B\nC", "http://127.0.0.1:8000/")],
+            favorites: vec![page("Google", "https://www.google.com/")],
+            bookmarks: vec![page(&"long ".repeat(20), "https://example.com/")],
+        };
+        let rows = mac_bar_rows(BarCan::default(), &pages);
+        assert!(JsonValue::deserialize_json(&rows).is_ok(), "{rows}");
+        assert!(rows.contains(r#""menu":"History","title":"Second \"Place\"","key":"","command":"open:http://localhost:8000/""#), "{rows}");
+        assert!(rows.contains(r#""title":"A\\B C""#), "{rows}");
+        assert!(rows.contains(r#""menu":"Bookmarks","submenu":"Favorites","title":"Google","key":"","command":"open:https://www.google.com/""#), "{rows}");
+        let long = menu_title(&"long ".repeat(20));
+        assert!(long.chars().count() == 48 && long.ends_with('\u{2026}'), "{long}");
+        assert!(rows.contains(&format!("\"title\":\"{long}\",\"key\":\"\",\"command\":\"open:https://example.com/\"")), "{rows}");
+        // The pages come before Clear History, a rule between.
+        let last_page = rows.find("open:http://127.0.0.1:8000/").unwrap();
+        let clear = rows.find("Clear History").unwrap();
+        assert!(last_page < clear, "{rows}");
+        assert!(rows[last_page..clear].contains(r#"{"menu":"History","title":""}"#), "{rows}");
+        // Nothing kept: no rule under Show Bookmarks.
+        let none = mac_bar_rows(BarCan::default(), &BarPages::default());
+        assert!(!none.contains(r#"{"menu":"Bookmarks","title":""}"#), "{none}");
+        assert!(none.ends_with(r#""title":"Show Bookmarks","key":"alt+cmd+B","command":"key:alt+cmd+B","enabled":true}]"#), "{none}");
+    }
+}
