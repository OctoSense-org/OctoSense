+/// Where an action sits in the menus' order (`keybinds::available_actions`):
+/// a tab's number after it, typed text and Do Nothing last.
+fn action_rank(action: &keybinds::Action) -> (usize, usize) {
+    use keybinds::Action;
+    let kinds = keybinds::available_actions();
+    let same = |kind: &Action| {
+        std::mem::discriminant(kind) == std::mem::discriminant(action)
+            && match (kind, action) {
+                (Action::NewSplit(a), Action::NewSplit(b)) | (Action::GotoSplit(a), Action::GotoSplit(b)) => a == b,
+                (Action::NavigateSearch { next: a }, Action::NavigateSearch { next: b }) => a == b,
+                _ => true,
+            }
+    };
+    let at = kinds.iter().position(same).unwrap_or(kinds.len());
+    (at, if let Action::GotoTab(n) = action { *n } else { 0 })
+}
