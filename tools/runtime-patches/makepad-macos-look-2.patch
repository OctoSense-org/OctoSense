+    /// The name sheet's Save, Create or Rename.
+    fn desk_commit_name(&mut self, cx: &mut Cx) {
+        let Some((name, naming)) =
+            self.desk_ui.settings.as_ref().and_then(|sheet| sheet.name.as_ref().map(|edit| (edit.text.trim().to_owned(), sheet.naming.clone())))
+        else {
+            return;
+        };
+        let (rows, _, _) = self.profile_list();
+        match naming {
+            Naming::SaveAs => self.desk_save_profile(cx),
+            Naming::New => {
+                if model::profile_name_problem(&name, &rows, None).is_none() {
+                    if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                        sheet.name = None;
+                    }
+                    self.create_profile(cx, &name);
+                }
+            }
+            Naming::Rename(old) => {
+                if model::profile_name_problem(&name, &rows, Some(&old)).is_none() {
+                    if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                        sheet.name = None;
+                    }
+                    if name != old {
+                        self.rename_profile(cx, &old, &name);
+                    }
+                }
+            }
+        }
+    }
