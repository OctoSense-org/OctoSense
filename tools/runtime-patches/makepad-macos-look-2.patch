+#[cfg(not(target_arch = "wasm32"))]
+fn sample_copy_in(root: &Path, path: &Path) -> Option<PathBuf> {
+    if !makepad_diskmap::kind::is_image_file(path) {
+        return None;
+    }
+    let bytes = crate::thumbs::sample_picture(path);
+    let key = path
+        .to_string_lossy()
+        .bytes()
+        .fold(0xcbf2_9ce4_8422_2325u64, |hash, byte| (hash ^ byte as u64).wrapping_mul(0x1000_0000_01b3));
+    let file = root.join(format!("{key:016x}")).join(path.file_name()?);
+    if std::fs::read(&file).ok().as_deref() != Some(bytes) {
+        std::fs::create_dir_all(file.parent()?).ok()?;
+        std::fs::write(&file, bytes).ok()?;
+    }
+    Some(file)
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn sample_copy(_path: &Path) -> Option<PathBuf> {
+    None
+}
+
+/// Where those copies are kept: Files' own storage.
+#[cfg(not(target_arch = "wasm32"))]
+fn samples_root() -> PathBuf {
+    crate::model::makepad_home().join("files/Quick Look")
+}
+
+/// The copies an earlier run left, gone as the demo starts again.
+pub(crate) fn clear_sample_copies() {
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let _ = std::fs::remove_dir_all(samples_root());
+    }
+}
