+/// The folders the Columns view lists, first to last: from `root`, where the
+/// browsing started, down to `dir`, at most `room` of them (the deepest
+/// kept). Outside `root`, or `flat` (a search), the folder alone.
+fn column_chain_of(root: Option<&Path>, dir: &Path, flat: bool, room: usize) -> Vec<PathBuf> {
+    let mut chain = vec![dir.to_path_buf()];
+    if let Some(root) = root.filter(|root| !flat && dir.starts_with(root)) {
+        let mut at = dir;
+        while at != root {
+            let Some(parent) = at.parent() else {
+                break;
+            };
+            chain.push(parent.to_path_buf());
+            at = parent;
+        }
+    }
+    chain.reverse();
+    if chain.len() > room.max(1) {
+        chain.drain(..chain.len() - room.max(1));
+    }
