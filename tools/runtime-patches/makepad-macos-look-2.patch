+/// `base`, else `base 2`, `base 3`…: the first name no profile in `taken` has (case
+/// aside), cut to a profile name's 40 characters.
+pub fn unused_profile_name(base: &str, taken: &[String]) -> String {
+    let base = Some(base.trim()).filter(|b| !b.is_empty()).unwrap_or("Profile");
+    let is_taken = |name: &str| taken.iter().any(|t| t.trim().to_lowercase() == name.to_lowercase());
+    let cut = |room: usize| base.chars().take(room).collect::<String>().trim_end().to_owned();
+    let first = cut(40);
+    if !is_taken(&first) {
+        return first;
+    }
+    let mut n = 2;
+    loop {
+        let suffix = format!(" {n}");
+        let name = format!("{}{suffix}", cut(40 - suffix.chars().count()));
+        if !is_taken(&name) {
+            return name;
+        }
+        n += 1;
+    }
+}
