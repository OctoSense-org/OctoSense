+/// `t`, `7`, `page_up`, `bracket_left`, `f5`, `kp_enter`. None: a key no
+/// `keybind` line can name (a modifier, Caps Lock).
+pub fn key_config_name(key: KeyCode) -> Option<String> {
+    use KeyCode::*;
+    let named = match key {
+        ReturnKey => "enter",
+        Escape => "escape",
+        Tab => "tab",
+        Backspace => "backspace",
+        Delete => "delete",
+        Insert => "insert",
+        Home => "home",
+        End => "end",
+        PageUp => "page_up",
+        PageDown => "page_down",
+        ArrowUp => "up",
+        ArrowDown => "down",
+        ArrowLeft => "left",
+        ArrowRight => "right",
+        Space => "space",
+        Backtick => "grave",
+        Minus => "minus",
+        Equals => "equal",
+        LBracket => "bracket_left",
+        RBracket => "bracket_right",
+        Backslash => "backslash",
+        Semicolon => "semicolon",
+        Quote => "quote",
+        Comma => "comma",
+        Period => "period",
+        Slash => "slash",
+        F1 => "f1",
+        F2 => "f2",
+        F3 => "f3",
+        F4 => "f4",
+        F5 => "f5",
+        F6 => "f6",
+        F7 => "f7",
+        F8 => "f8",
+        F9 => "f9",
+        F10 => "f10",
+        F11 => "f11",
+        F12 => "f12",
+        Numpad0 => "kp_0",
+        Numpad1 => "kp_1",
+        Numpad2 => "kp_2",
+        Numpad3 => "kp_3",
+        Numpad4 => "kp_4",
+        Numpad5 => "kp_5",
+        Numpad6 => "kp_6",
+        Numpad7 => "kp_7",
+        Numpad8 => "kp_8",
+        Numpad9 => "kp_9",
+        NumpadEnter => "kp_enter",
+        NumpadAdd => "kp_add",
+        NumpadSubtract => "kp_subtract",
+        NumpadMultiply => "kp_multiply",
+        NumpadDivide => "kp_divide",
+        NumpadDecimal => "kp_decimal",
+        NumpadEquals => "kp_equal",
+        other => {
+            // A letter or a digit: its own character.
+            let name = format!("{other:?}");
+            let one = name.strip_prefix("Key").filter(|rest| rest.chars().count() == 1)?;
+            return Some(one.to_ascii_lowercase());
+        }
+    };
+    Some(named.to_owned())
+}
+
+/// A chord as `settings.conf` spells it, the way the defaults are written
+/// (`ctrl+shift+t`, `cmd+page_up`); [`parse_trigger`] reads it back to the
+/// same chord. None: its key has no name in the file.
+pub fn config_trigger(t: &Trigger) -> Option<String> {
+    let mut out = String::new();
+    if t.mods.ctrl {
+        out.push_str("ctrl+");
+    }
+    if t.mods.alt {
+        out.push_str("alt+");
+    }
+    if t.mods.shift {
+        out.push_str("shift+");
+    }
+    if t.mods.sup {
+        out.push_str(if cfg!(target_os = "macos") { "cmd+" } else { "super+" });
+    }
+    out.push_str(&key_config_name(t.key)?);
+    Some(out)
+}
