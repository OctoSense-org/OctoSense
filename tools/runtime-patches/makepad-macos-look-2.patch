+/// What a link under the pointer is, for its menu.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum LinkKind {
+    /// A page: a tab or a window can open it, and Bookmarks keep it.
+    Web,
+    /// A `mailto:`: its address can be copied.
+    Mail,
+    /// Anything else (`tel:`, an app's own scheme): only its address.
+    Other,
+}
+
+impl LinkKind {
+    fn of(link: &str) -> LinkKind {
+        let lower = link.get(..8).unwrap_or(link).to_ascii_lowercase();
+        if lower.starts_with("http://") || lower.starts_with("https://") || lower.starts_with("file://") {
+            LinkKind::Web
+        } else if lower.starts_with("mailto:") && mail_address(link).is_some() {
+            LinkKind::Mail
+        } else {
