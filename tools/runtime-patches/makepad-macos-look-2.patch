+    /// The Keyboard tab's sheet, as Terminal.app's: the key, its modifiers and what it
+    /// does; under them what the chord does now, or why it can't be had.
+    fn draw_key_sheet(&mut self, cx: &mut Cx2d, c: &DeskPalette) {
+        let Some(edit) = self.desk_ui.settings.as_ref().and_then(|sheet| sheet.key_edit.clone()) else {
+            return;
+        };
+        let mac = cfg!(target_os = "macos");
+        let (can, note) = self.key_edit_check(&edit);
+        let (title, action) = if edit.was.is_some() { ("Change the keyboard shortcut", "OK") } else { ("Add a keyboard shortcut", "Add") };
+        let height = 20.0 + 18.0 + 12.0 + CONTROL + ROW_GAP + CHECK_ROW + ROW_GAP + CONTROL + NOTE_ROW + 20.0 + CONTROL + 16.0;
+        let rect = self.begin_sheet(cx, c, KEY_SHEET_WIDTH, height);
+        let left = rect.pos.x;
+        let right = left + rect.size.x;
+        let mut y = rect.pos.y + 20.0;
+        self.text(cx, Type::Bold, left + 20.0, y + 9.0, title, c.ink);
+        y += 18.0 + 12.0;
+        let label_end = left + KEY_SHEET_LABELS;
+        let x = label_end + 8.0;
+        self.text_right(cx, Type::Body, label_end, y + CONTROL * 0.5, "Key:", c.ink);
+        self.draw_popup(cx, c, rect_at(x, y, 180.0, CONTROL), &model::key_choice_name(edit.key), DeskHit::KeyChoice);
+        y += CONTROL + ROW_GAP;
+        self.text_right(cx, Type::Body, label_end, y + CHECK_ROW * 0.5, "Modifiers:", c.ink);
+        let mods = [
+            (0u8, "Control", edit.mods.ctrl),
+            (1, if mac { "Option" } else { "Alt" }, edit.mods.alt),
+            (2, "Shift", edit.mods.shift),
+            (3, if mac { "Command" } else { "Super" }, edit.mods.sup),
+        ];
+        let mut at = x;
+        for (bit, name, on) in mods {
+            let w = self.draw_check_box(cx, c, at, y, (right - 20.0 - at).max(0.0), name, DeskHit::KeyMod(bit), on);
+            at += w + 18.0;
+        }
+        y += CHECK_ROW + ROW_GAP;
+        self.text_right(cx, Type::Body, label_end, y + CONTROL * 0.5, "Action:", c.ink);
+        self.draw_popup(cx, c, rect_at(x, y, right - 20.0 - x, CONTROL), &model::key_action_label(&edit.action), DeskHit::KeyAction);
+        y += CONTROL;
+        if let Some(note) = note {
+            let note = self.fitted(cx, Type::Note, &note, right - 20.0 - x);
+            self.text(cx, Type::Note, x, y + NOTE_ROW * 0.5 + 2.0, &note, c.muted);
+        }
+        let bottom = rect.pos.y + rect.size.y - 16.0 - CONTROL;
+        let save_w = self.button_width(cx, action);
+        let cancel_w = self.button_width(cx, "Cancel");
+        let save = rect_at(right - 16.0 - save_w, bottom, save_w, CONTROL);
+        let cancel = rect_at(save.pos.x - 8.0 - cancel_w, bottom, cancel_w, CONTROL);
+        self.push_button(cx, c, cancel, "Cancel", DeskHit::KeyCancel, false, true);
+        self.push_button(cx, c, save, action, DeskHit::KeySave, true, can);
+    }
