+    }
+    let parsed = Settings::parse(text);
+    let stem = std::path::Path::new(file_name).file_stem().map(|stem| stem.to_string_lossy().into_owned()).unwrap_or_default();
+    let name = [parsed.profile.trim(), stem.trim()]
+        .into_iter()
+        .find(|name| crate::settings::valid_profile_name(name))
+        .unwrap_or("Imported Profile")
+        .to_owned();
+    Some(Settings { profile: unused_profile_name(&name, taken), ..parsed })
