+/// The grounds of a Mac's Start Page monograms, deep enough for a white letter.
+pub const MONOGRAM_COLORS: [&str; 8] = ["#1a6fd8", "#5856d6", "#9445c2", "#cc2f63", "#d03a2f", "#c45a12", "#2a8a43", "#1a7f94"];
+
+/// The colour of a page's monogram, as Safari's Start Page draws a site with no
+/// icon: one of [`MONOGRAM_COLORS`] by its host, so a site keeps its colour.
+pub fn monogram_color(url: &str) -> &'static str {
+    let host = crate::tabs::host_of(url).unwrap_or_else(|| url.to_string());
+    // FNV-1a; its top bits pick the colour.
+    let hash = host.bytes().fold(0x811c_9dc5u32, |hash, byte| (hash ^ byte as u32).wrapping_mul(0x0100_0193));
+    MONOGRAM_COLORS[(hash >> 29) as usize]
