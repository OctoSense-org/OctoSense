+
+/// A file chosen to import, as a profile: None unless it sets one of a settings file's
+/// keys. Its name is the one it carries, else the file's, else Imported Profile, made
+/// one no profile in `taken` has.
+pub fn imported_profile(text: &str, file_name: &str, taken: &[String]) -> Option<Settings> {
+    let keys = known_keys();
+    let known = text
+        .lines()
+        .map(str::trim)
+        .filter(|line| !line.starts_with('#'))
+        .filter_map(|line| line.split_once('='))
+        .any(|(key, _)| keys.iter().any(|known| known == key.trim()));
+    if !known {
