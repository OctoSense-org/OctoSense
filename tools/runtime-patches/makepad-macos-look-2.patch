+                    plain("Writes out:", known(with_thousands(disk.writes))),
+                    plain("Reads in/sec:", known(count(disk.reads_per_second))),
+                    plain("Writes out/sec:", known(count(disk.writes_per_second))),
+                ],
+                right: vec![
+                    plain("Data read:", known(format_bytes_activity(disk.bytes_read))),
+                    plain("Data written:", known(format_bytes_activity(disk.bytes_written))),
+                    reading("Data read/sec:", known(rate(disk.read_per_second)), FootKey::In),
+                    reading("Data written/sec:", known(rate(disk.written_per_second)), FootKey::Out),
