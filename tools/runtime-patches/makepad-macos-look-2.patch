+    /// points on CPU, User then Idle Wake Ups only when the name would have
+    /// less than 150.
+    #[test]
+    fn a_mac_narrows_the_name_before_a_column_goes() {
+        let labels = |width: f64, tab: MacTab, hidden: u16| {
+            widgets::mac_columns(width, tab, hidden).iter().map(|&col| desk_column_label(col)).collect::<Vec<_>>()
+        };
+        let cpu = |width: f64| labels(width, MacTab::Cpu, MacTab::Cpu.hidden_default());
+        let all = ["Process Name", "% CPU", "CPU Time", "Threads", "Idle Wake Ups", "PID", "User"];
+        assert_eq!(cpu(994.0), all);
+        assert_eq!(cpu(700.0), all);
+        assert_eq!(cpu(656.0), all);
+        assert_eq!(cpu(655.0), ["Process Name", "% CPU", "CPU Time", "Threads", "Idle Wake Ups", "PID"]);
+        assert_eq!(cpu(520.0), ["Process Name", "% CPU", "CPU Time", "Threads", "PID"]);
+        assert_eq!(cpu(400.0), ["Process Name", "% CPU", "Threads", "PID"]);
+        assert_eq!(
+            labels(994.0, MacTab::Cpu, 0),
+            ["Process Name", "% CPU", "CPU Time", "Threads", "Idle Wake Ups", "State", "PID", "User", "Parent PID"]
+        );
+        // A column taken out stays out, and the name takes its room.
+        assert_eq!(labels(520.0, MacTab::Cpu, MacTab::Cpu.hidden_default() | 1 << 8), ["Process Name", "% CPU", "Threads", "Idle Wake Ups", "PID"]);
+        let memory = |width: f64| labels(width, MacTab::Memory, MacTab::Memory.hidden_default());
+        assert_eq!(memory(994.0), ["Process Name", "Memory", "Threads", "PID", "User"]);
