+    /// Each tab's panel under the table, as Activity Monitor's: its graph's
+    /// title, its readings and the ones that key the graph.
+    #[test]
+    fn each_tab_has_its_own_labelled_foot() {
+        let gb = 1024 * 1024 * 1024u64;
+        let mut data = FootData { cpu_user: 5.126, cpu_system: 3.2, threads: Some(2345), processes: 512, ..FootData::default() };
+        data.mem = backend::MemInfo { total: 16 * gb, app: 6 * gb, wired: 2 * gb, compressed: gb / 2, cached_files: 5 * gb, swap_used: 0, ..Default::default() };
+        data.net = backend::NetInfo { rx_total: 3 * gb / 2, packets_in: 1_234_567, packets_in_per_second: 12.4, rx_per_second: 2048.0, ..Default::default() };
+        let words = |layout: &FootLayout| {
+            layout.left.iter().chain(&layout.right).map(|r| format!("{} {}", r.label, r.value)).collect::<Vec<_>>()
+        };
+        let cpu = foot_layout(MacTab::Cpu, &data);
+        assert_eq!((cpu.title, cpu.graph_leads), ("CPU LOAD", false));
+        assert_eq!(words(&cpu), ["System: 3.20%", "User: 5.13%", "Idle: 91.67%", "Threads: 2,345", "Processes: 512"]);
+        assert_eq!((cpu.left[0].key, cpu.left[1].key, cpu.left[2].key), (FootKey::Out, FootKey::In, FootKey::Plain));
+        let memory = foot_layout(MacTab::Memory, &data);
+        assert_eq!((memory.title, memory.graph_leads), ("MEMORY PRESSURE", true));
+        assert_eq!(
+            words(&memory),
+            ["Physical Memory: 16.00 GB", "Memory Used: 8.50 GB", "Cached Files: 5.00 GB", "Swap Used: 0 bytes",
+             "App Memory: 6.00 GB", "Wired Memory: 2.00 GB", "Compressed: 512.0 MB"]
+        );
+        // A disk the system doesn't count says so; it isn't zero.
+        let disk = foot_layout(MacTab::Disk, &data);
+        assert_eq!(disk.title, "DATA");
+        assert!(disk.left.iter().chain(&disk.right).all(|r| r.value == "—"), "{:?}", words(&disk));
+        data.disk = backend::DiskInfo { known: true, reads: 1_234_567, writes: 987_654, written_per_second: 12.0 * 1024.0, ..Default::default() };
+        assert_eq!(
+            words(&foot_layout(MacTab::Disk, &data)),
+            ["Reads in: 1,234,567", "Writes out: 987,654", "Reads in/sec: 0", "Writes out/sec: 0",
+             "Data read: 0 bytes", "Data written: 0 bytes", "Data read/sec: 0 bytes", "Data written/sec: 12 KB"]
+        );
+        let network = foot_layout(MacTab::Network, &data);
