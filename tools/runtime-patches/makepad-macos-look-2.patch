+/// The first token of the operand that ends at `last`, its signs aside: a
+/// number, a constant, a group or a call, with the ! and % after it.
+fn postfix_start(tokens: &[Token], last: usize) -> Option<usize> {
+    let mut i = last;
+    while matches!(tokens.get(i)?.kind, TokenKind::Bang | TokenKind::Percent) {
+        i = i.checked_sub(1)?;
+    }
+    match tokens.get(i)?.kind {
+        TokenKind::Number(_) | TokenKind::Ident(_) => Some(i),
+        TokenKind::RParen => {
+            let mut depth = 1;
+            while depth > 0 {
+                i = i.checked_sub(1)?;
+                match tokens[i].kind {
+                    TokenKind::RParen => depth += 1,
+                    TokenKind::LParen => depth -= 1,
+                    _ => {}
+                }
+            }
+            if i > 0 && matches!(&tokens[i - 1].kind, TokenKind::Ident(n) if function_of(n).is_some()) {
+                i -= 1;
+            }
+            Some(i)
+        }
+        _ => None,
+    }
+}
+
+/// The `)` that closes the `(` at `open`.
+fn group_end(tokens: &[Token], open: usize) -> Option<usize> {
+    if !matches!(tokens.get(open)?.kind, TokenKind::LParen) {
+        return None;
+    }
+    let mut depth = 0;
+    for (i, tok) in tokens.iter().enumerate().skip(open) {
+        match tok.kind {
+            TokenKind::LParen => depth += 1,
+            TokenKind::RParen => {
+                depth -= 1;
+                if depth == 0 {
+                    return Some(i);
+                }
+            }
+            _ => {}
+        }
+    }
+    None
+}
