+pub fn help_without_model(state: &EngineState, index: usize) -> bool {
+    let Some(Entry::System { text }) = state.entries.get(index) else { return false };
+    if !(text.starts_with("tools: ") || text.starts_with("no tools")) {
+        return false;
+    }
+    let turn_ends = |entry: &&Entry| matches!(entry, Entry::User { .. } | Entry::Assistant { .. });
+    let no_model = |entry: &Entry| matches!(entry, Entry::System { text } if text.starts_with("no model is answering"));
+    let after = state.entries[index + 1..].iter().take_while(|entry| !turn_ends(entry)).any(no_model);
+    let before = state.entries[..index].iter().rev().take_while(|entry| !turn_ends(entry)).any(no_model);
+    after || before
+}
