+/// Two rates on one scale, the larger's peak at nine tenths of the graph, as
+/// a rate has no ceiling of its own: in first (blue), out second (red).
+fn rate_series(incoming: &[f64], outgoing: &[f64], colors: (Vec4f, Vec4f)) -> Vec<FootSeries> {
+    let peak = incoming.iter().chain(outgoing).fold(0.0f64, |peak, value| peak.max(*value));
+    let scale = |history: &[f64]| -> Vec<f64> {
+        history.iter().map(|value| if peak > 0.0 { value / peak * 90.0 } else { 0.0 }).collect()
+    };
+    vec![
+        FootSeries { color: colors.0, points: scale(incoming) },
+        FootSeries { color: colors.1, points: scale(outgoing) },
+    ]
+}
