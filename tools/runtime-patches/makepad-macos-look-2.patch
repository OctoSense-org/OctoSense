+        MacTab::Cpu => FootLayout {
+            title: "CPU LOAD",
+            graph_leads: false,
+            left: vec![
+                reading("System:", percent(data.cpu_system), FootKey::Out),
+                reading("User:", percent(data.cpu_user), FootKey::In),
+                plain("Idle:", percent(100.0 - data.cpu_user - data.cpu_system)),
+            ],
+            right: vec![
+                plain("Threads:", data.threads.map(with_thousands).unwrap_or_else(none)),
+                plain("Processes:", with_thousands(data.processes as u64)),
+            ],
