+/// The pages a Mac's History and Bookmarks menus list, each its name and address.
+#[derive(Default)]
+struct BarPages {
+    /// The last pages visited, the last first.
+    recent: Vec<(String, String)>,
+    /// The Start Page's own Favorites, then the person's.
+    favorites: Vec<(String, String)>,
+    bookmarks: Vec<(String, String)>,
+}
+
+/// How many pages History lists, and how many Favorites and Bookmarks: the
+/// shell reads 64 rows at most.
+const BAR_RECENT: usize = 10;
+const BAR_FAVORITES: usize = 8;
+const BAR_BOOKMARKS: usize = 12;
+
+/// The rows Browser adds to a Mac's menu bar (`makepad_wm_api::menu_rows`), the
+/// shell's own as before: each the key the window answers, grey when it can't act now.
+/// History lists the pages visited last and Bookmarks the pages kept, as Safari's
+/// menus do; such a row opens its page (`open:<address>`).
+fn mac_bar_rows(can: BarCan, pages: &BarPages) -> String {
+    let row = |menu: &str, title: &str, key: &str, enabled: bool| {
+        format!(r#"{{"menu":"{menu}","title":"{title}","key":"{key}","command":"key:{key}","enabled":{enabled}}}"#)
+    };
+    let rule = |menu: &str| format!(r#"{{"menu":"{menu}","title":""}}"#);
+    let page = |menu: &str, submenu: &str, (name, url): &(String, String)| {
+        let submenu = if submenu.is_empty() { String::new() } else { format!(r#","submenu":"{submenu}""#) };
+        format!(
+            r#"{{"menu":"{menu}"{submenu},"title":"{}","key":"","command":"open:{}","enabled":true}}"#,
+            json_text(&menu_title(name)),
+            json_text(url)
+        )
+    };
+    let mut rows = vec![
+        row("File", "New Tab", "cmd+T", true),
+        row("File", "Open Location\u{2026}", "cmd+L", true),
+        row("Edit", "Find\u{2026}", "cmd+F", can.find),
+        row("View", "Reload", "cmd+R", can.reload),
+        row("View", "Stop", "cmd+.", can.stop),
+        row("History", "Back", "cmd+[", can.back),
+        row("History", "Forward", "cmd+]", can.forward),
+        row("History", "Show History", "cmd+Y", true),
+    ];
+    if !pages.recent.is_empty() {
+        rows.push(rule("History"));
+        rows.extend(pages.recent.iter().map(|place| page("History", "", place)));
+    }
+    rows.push(rule("History"));
+    rows.push(row("History", "Clear History\u{2026}", "shift+cmd+delete", can.clear));
+    rows.push(row("Bookmarks", "Add Bookmark\u{2026}", "cmd+D", can.bookmark));
+    rows.push(row("Bookmarks", "Show Bookmarks", "alt+cmd+B", true));
+    if !pages.favorites.is_empty() || !pages.bookmarks.is_empty() {
+        rows.push(rule("Bookmarks"));
+    }
+    rows.extend(pages.favorites.iter().map(|place| page("Bookmarks", "Favorites", place)));
+    rows.extend(pages.bookmarks.iter().map(|place| page("Bookmarks", "", place)));
+    format!("[{}]", rows.join(","))
+}
+
+/// `text` as the inside of a JSON string.
+fn json_text(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    for c in text.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
+            c => out.push(c),
+        }
+    }
+    out
+}
+
+/// A page's name as a menu's row shows it: one line, cut with an ellipsis, as
+/// a Mac's menus cut a long one.
+fn menu_title(name: &str) -> String {
+    const LONGEST: usize = 48;
+    let line = name.split_whitespace().collect::<Vec<_>>().join(" ");
+    if line.chars().count() <= LONGEST {
+        return line;
+    }
+    let cut: String = line.chars().take(LONGEST - 1).collect();
+    format!("{}\u{2026}", cut.trim_end())
+}
