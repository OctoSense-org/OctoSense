+/// The data columns on screen, in order.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ShownColumns {
+    cols: [usize; COL_COUNT],
+    len: usize,
+}
+
+impl ShownColumns {
+    fn of(cols: &[usize]) -> Self {
+        let mut shown = ShownColumns { cols: [0; COL_COUNT], len: cols.len() };
+        shown.cols[..cols.len()].copy_from_slice(cols);
+        shown
+    }
+
+    fn retain(&mut self, keep: impl Fn(usize) -> bool) {
+        let mut len = 0;
+        for at in 0..self.len {
+            let col = self.cols[at];
+            if keep(col) {
+                self.cols[len] = col;
+                len += 1;
+            }
+        }
+        self.len = len;
+    }
+}
+
+impl std::ops::Deref for ShownColumns {
+    type Target = [usize];
+    fn deref(&self) -> &[usize] {
+        &self.cols[..self.len]
+    }
+}
