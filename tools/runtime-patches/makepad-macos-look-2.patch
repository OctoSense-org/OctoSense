diff --git a/apps/pdf/src/toolbar.rs b/apps/pdf/src/toolbar.rs
new file mode 100644
index 0000000000000000000000000000000000000000..137d68ce1e66ae732ef4c0aa36b2f214cbd70d75
--- /dev/null
+++ b/apps/pdf/src/toolbar.rs
@@ -0,0 +1,97 @@
+//! A Mac's toolbar in a window narrower than all of it: what it keeps out, as
+//! the PDF Viewer's desk toolbar lays it out, in points.
+
+/// What a Mac's toolbar has room for: the tools that stay out, in the order
+/// they give way to a narrower window (the two fits, then the zoom, then the
+/// page tools, each to the » menu at the toolbar's end), and the search
+/// field's width, which gives a little first.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct ToolbarRoom {
+    pub fits: bool,
+    pub zoom: bool,
+    pub pages: bool,
+    pub field: f64,
+}
+
+/// The toolbar's widths in points, spacing and margins included, as the
+/// desk toolbar lays them out.
+mod bar {
+    /// The lights' room and the trailing padding; a toolbar without lights.
+    pub const SIDES_UNIFIED: f64 = 84.0 + 10.0;
+    pub const SIDES: f64 = 12.0 + 10.0;
+    pub const THUMBS: f64 = 30.0 + 4.0;
+    /// The name keeps this much, and its margin and the spacing after it.
+    pub const TITLE: f64 = 120.0;
+    pub const TITLE_EDGES: f64 = 8.0;
+    /// The gap before Open, and Open.
+    pub const BASE: f64 = 12.0 + 30.0;
+    pub const FIND_BUTTON: f64 = 2.0 + 30.0;
+    /// The search tools but their field: the count, the two arrows.
+    pub const FIND_TOOLS: f64 = 10.0 + 138.0;
+    pub const FIELD: f64 = 168.0;
+    pub const FIELD_LEAST: f64 = 128.0;
+    pub const FITS: f64 = 12.0 + 159.0;
+    pub const ZOOM: f64 = 2.0 + 30.0 + 2.0 + 44.0 + 2.0 + 30.0;
+    pub const ZOOM_BARE: f64 = 2.0 + 30.0 + 2.0 + 30.0;
+    pub const PAGES: f64 = 120.0 + 2.0;
+    pub const PAGES_BARE: f64 = 62.0 + 12.0;
+    pub const MORE: f64 = 2.0 + 4.0 + 30.0;
+}
+
+/// What a toolbar `width` points wide keeps; `width` 0 is a window that has
+/// not said yet, which keeps everything.
+pub fn toolbar_room(width: f64, unified: bool, thumbs: bool, open: bool, finding: bool, can_find: bool) -> ToolbarRoom {
+    let all = ToolbarRoom { fits: true, zoom: true, pages: true, field: bar::FIELD };
+    if width <= 0.0 {
+        return all;
+    }
+    let sides = if unified { bar::SIDES_UNIFIED } else { bar::SIDES };
+    let room = width - sides - if thumbs { bar::THUMBS } else { 0.0 } - bar::TITLE - bar::TITLE_EDGES;
+    let find = if finding { bar::FIND_TOOLS + bar::FIELD } else if can_find { bar::FIND_BUTTON } else { 0.0 };
+    let (pages, zoom) = if open { (bar::PAGES, bar::ZOOM) } else { (bar::PAGES_BARE, bar::ZOOM_BARE) };
+    let tiers = [(true, true, true), (false, true, true), (false, false, true), (false, false, false)];
+    for (tier, (fits, keeps_zoom, keeps_pages)) in tiers.into_iter().enumerate() {
+        let need = bar::BASE
+            + find
+            + if tier > 0 { bar::MORE } else { 0.0 }
+            + if fits { bar::FITS } else { 0.0 }
+            + if keeps_zoom { zoom } else { 0.0 }
+            + if keeps_pages { pages } else { 0.0 };
+        let short = need - room;
+        let give = if finding { bar::FIELD - bar::FIELD_LEAST } else { 0.0 };
+        if short <= give {
+            let field = bar::FIELD - short.max(0.0);
+            return ToolbarRoom { fits, zoom: keeps_zoom, pages: keeps_pages, field };
+        }
+    }
+    ToolbarRoom { fits: false, zoom: false, pages: false, field: bar::FIELD_LEAST }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_first_size_keeps_every_tool_with_find_open() {
+        // The shell's first size for the PDF Viewer is 994 points wide.
+        let room = toolbar_room(994.0, true, true, true, true, true);
+        assert!(room.fits && room.zoom && room.pages, "{room:?}");
+        assert!(room.field >= bar::FIELD_LEAST && room.field < bar::FIELD, "{room:?}");
+        let closed = toolbar_room(994.0, true, true, true, false, true);
+        assert_eq!(closed, ToolbarRoom { fits: true, zoom: true, pages: true, field: bar::FIELD });
+    }
+
+    #[test]
+    fn a_narrower_window_gives_way_in_order() {
+        let at = |width| toolbar_room(width, true, true, true, true, true);
+        let (wide, mid, narrow) = (at(860.0), at(760.0), at(620.0));
+        assert!(!wide.fits && wide.zoom && wide.pages, "{wide:?}");
+        assert!(!mid.fits && !mid.zoom && mid.pages, "{mid:?}");
+        assert!(!narrow.fits && !narrow.zoom && !narrow.pages, "{narrow:?}");
+        // Without the search field, the narrowest window keeps the zoom and the pages.
+        let plain = toolbar_room(620.0, true, true, true, false, true);
+        assert!(!plain.fits && plain.zoom && plain.pages, "{plain:?}");
+        // A window that hasn't said its width keeps everything.
+        assert!(toolbar_room(0.0, true, true, true, true, true).fits);
+    }
+}
