+        let exporting = matches!(sheet.file_job, Some(FileJob::ExportPanel { .. }));
+        match answer {
+            FileDialogAction::FileSelected { id, paths } if *id == IMPORT_PANEL && importing => {
+                sheet.file_job = None;
+                if let Some(path) = paths.first() {
+                    let file = path.file_name().map(|name| name.to_string_lossy().into_owned()).unwrap_or_default();
+                    let read = LiveId::unique();
+                    sheet.file_job = Some(FileJob::ImportRead { id: read, file });
+                    cx.read_chosen_file(read, path);
+                }
+            }
+            FileDialogAction::FileCancelled { id } if *id == IMPORT_PANEL && importing => sheet.file_job = None,
+            FileDialogAction::SaveFileSelected { id, path } if *id == EXPORT_PANEL && exporting => {
+                if let Some(FileJob::ExportPanel { name, text }) = sheet.file_job.take() {
+                    let write = LiveId::unique();
