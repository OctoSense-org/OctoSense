+    /// A new profile of the chosen one's settings, under `name`, chosen.
+    fn create_profile(&mut self, cx: &mut Cx, name: &str) {
+        let settings = self.shown_settings();
+        match term_settings::save_profile(name, &settings) {
+            Ok(()) => {
+                self.refresh_saved();
+                self.choose_profile(cx, Some(name.to_owned()));
+            }
+            Err(err) => self.desk_notice(format!("The profile \u{201c}{name}\u{201d} could not be saved."), err.to_string()),
+        }
+    }
+
+    /// Duplicate: the chosen profile again, as "<name> copy".
+    fn duplicate_profile(&mut self, cx: &mut Cx) {
+        let (rows, _, chosen) = self.profile_list();
+        let from = rows.get(chosen).cloned().unwrap_or_default();
+        let name = model::unused_profile_name(&format!("{from} copy"), &rows);
+        self.create_profile(cx, &name);
+    }
+
+    /// A profile's new name: its file's, and for the default the live settings' label.
+    fn rename_profile(&mut self, cx: &mut Cx, old: &str, new: &str) {
+        let live = self.current_settings();
+        let is_default = self.default_profile().to_lowercase() == old.to_lowercase();
+        let file = self.saved_names().iter().any(|name| name == old);
+        let moved = (|| -> std::io::Result<()> {
+            if !file {
+                return Ok(());
+            }
+            let settings = term_settings::load_profile(old).ok_or_else(|| std::io::Error::other("the file could not be read"))?;
+            if old.to_lowercase() == new.to_lowercase() {
+                // A disk that ignores case has one file for both names: out of the way first.
+                term_settings::delete_profile(old)?;
+                if let Err(err) = term_settings::save_profile(new, &settings) {
+                    let _ = term_settings::save_profile(old, &settings);
+                    return Err(err);
+                }
+                Ok(())
+            } else {
+                term_settings::save_profile(new, &settings)?;
+                term_settings::delete_profile(old)
+            }
+        })();
+        match moved {
+            Ok(()) => {
+                if is_default {
+                    self.apply(cx, Settings { profile: new.to_owned(), ..live });
+                }
+                self.refresh_saved();
+                self.choose_profile(cx, (!is_default).then(|| new.to_owned()));
+            }
+            Err(err) => self.desk_notice(format!("\u{201c}{old}\u{201d} could not be renamed."), err.to_string()),
+        }
+    }
