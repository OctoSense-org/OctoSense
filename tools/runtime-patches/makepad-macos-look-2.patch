+/// How long a timer ran, in words: "1 minute", "1 hour 30 minutes", "45 seconds".
+pub fn duration_words(secs: f64) -> String {
+    let whole = secs.round().max(0.0) as u64;
+    let (h, m, s) = (whole / 3600, (whole / 60) % 60, whole % 60);
+    let unit = |n: u64, one: &str| if n == 1 { format!("1 {one}") } else { format!("{n} {one}s") };
+    let parts: Vec<String> = [(h, "hour"), (m, "minute"), (s, "second")].iter().filter(|(n, _)| *n > 0).map(|(n, one)| unit(*n, one)).collect();
+    if parts.is_empty() { "0 seconds".to_string() } else { parts.join(" ") }
+}
