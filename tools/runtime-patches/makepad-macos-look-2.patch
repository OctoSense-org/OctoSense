+    let default = default_profile_name(live, saved);
+    let mut rows: Vec<String> = saved.iter().filter(|name| name.to_lowercase() != default.to_lowercase()).cloned().collect();
+    rows.push(default.clone());
+    rows.sort_by_key(|name| name.to_lowercase());
+    let at = rows.iter().position(|name| *name == default).unwrap_or(0);
