+/// A `mailto:` link's address: what comes before its `?`, its escapes undone.
+fn mail_address(link: &str) -> Option<String> {
+    let rest = link.get(7..).filter(|_| link.get(..7).is_some_and(|scheme| scheme.eq_ignore_ascii_case("mailto:")))?;
+    let address = percent_decode(rest.split('?').next().unwrap_or_default());
+    let address = address.trim();
+    (!address.is_empty()).then(|| address.to_string())
+}
+
+/// `%XX` escapes undone; what isn't one stays as it is.
+fn percent_decode(text: &str) -> String {
+    let bytes = text.as_bytes();
+    let mut out = Vec::with_capacity(bytes.len());
+    let mut i = 0;
+    while i < bytes.len() {
+        let hex = |b: u8| (b as char).to_digit(16);
+        if bytes[i] == b'%' && i + 2 < bytes.len() {
+            if let (Some(hi), Some(lo)) = (hex(bytes[i + 1]), hex(bytes[i + 2])) {
+                out.push((hi * 16 + lo) as u8);
+                i += 3;
+                continue;
+            }
+        }
+        out.push(bytes[i]);
+        i += 1;
+    }
+    String::from_utf8_lossy(&out).into_owned()
