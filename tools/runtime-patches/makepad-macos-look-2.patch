+    /// Whether the Keyboard tab's sheet may give its chord its action in the shown
+    /// profile, and what to say under it. A row opened and left as it was: OK does nothing.
+    fn key_edit_check(&self, edit: &KeyEdit) -> (bool, Option<String>) {
+        let mac = cfg!(target_os = "macos");
+        let lines = self.shown_settings().keybinds;
+        let trigger = edit.trigger();
+        let unchanged = edit.was == Some(trigger)
+            && Keybinds::build(&lines, mac).bindings.iter().any(|b| b.trigger == trigger && b.action == edit.action);
+        if unchanged {
+            return (true, None);
+        }
+        model::key_check(&lines, mac, trigger, &edit.action, edit.was)
+    }
