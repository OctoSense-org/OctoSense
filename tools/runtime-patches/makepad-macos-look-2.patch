+        assert_eq!(&words(&network)[..3], ["Packets in: 1,234,567", "Packets out: 0", "Packets in/sec: 12"]);
+        assert_eq!(&words(&network)[4..], ["Data received: 1.50 GB", "Data sent: 0 bytes", "Data received/sec: 2 KB", "Data sent/sec: 0 bytes"]);
+        assert_eq!((network.right[2].key, network.right[3].key), (FootKey::In, FootKey::Out));
+        // Without the breakdown (another backend), Memory Used is what it gives.
+        let plain = FootData { mem: backend::MemInfo { total: 8 * gb, used: 3 * gb, ..Default::default() }, ..FootData::default() };
+        let words_plain = words(&foot_layout(MacTab::Memory, &plain));
+        assert_eq!(&words_plain[1], "Memory Used: 3.00 GB");
+        assert_eq!(&words_plain[4..], ["App Memory: —", "Wired Memory: —", "Compressed: —"]);
+    }
