+        let disk = |width: f64| labels(width, MacTab::Disk, MacTab::Disk.hidden_default());
+        assert_eq!(disk(520.0), ["Process Name", "Bytes Written", "Bytes Read", "PID", "User"]);
+        assert_eq!(disk(519.0), ["Process Name", "Bytes Written", "Bytes Read", "PID"]);
+        assert_eq!(labels(700.0, MacTab::Network, MacTab::Network.hidden_default()), ["Process Name", "PID", "User"]);
+    }
