+        if old.to_lowercase() == name.to_lowercase() {
+            return;
+        }
+        let Some(profile) = term_settings::load_profile(name) else {
+            self.desk_notice(format!("The profile \u{201c}{name}\u{201d} could not be read."), String::new());
+            return;
+        };
+        if let Err(err) = term_settings::save_profile(&old, &live) {
+            self.desk_notice(format!("\u{201c}{old}\u{201d} could not be kept as a profile."), err.to_string());
+            return;
+        }
+        self.apply(cx, model::as_default(&profile, &live));
