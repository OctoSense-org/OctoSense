+    // ------------------------------------------------------------------
+    // The Settings window's profiles: the live settings are the default
+    // profile, each saved profile file another row of the list.
+    // ------------------------------------------------------------------
+
+    /// The Profiles pane is in front.
+    fn in_profiles(&self) -> bool {
+        self.settings_window && self.desk_ui.settings.as_ref().is_some_and(|sheet| sheet.pane == PROFILES)
+    }
+
+    fn saved_names(&self) -> Vec<String> {
+        self.desk_ui.settings.as_ref().map(|sheet| sheet.saved.iter().map(|(name, _)| name.clone()).collect()).unwrap_or_default()
+    }
+
+    /// The saved profiles read again, each one's colour scheme for its picture; a
+    /// chosen one that has gone leaves the default chosen.
+    fn refresh_saved(&mut self) {
+        let saved: Vec<(String, String)> = term_settings::list_profiles()
+            .into_iter()
+            .map(|name| {
+                let theme = term_settings::load_profile(&name).map(|s| s.theme).unwrap_or_default();
+                (name, theme)
+            })
+            .collect();
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.saved = saved;
+            if sheet.chosen.as_ref().is_some_and(|chosen| !sheet.saved.iter().any(|(name, _)| name == chosen)) {
+                sheet.chosen = None;
+                sheet.chosen_settings = None;
+            }
+        }
+    }
+
+    /// The default profile's name.
+    fn default_profile(&self) -> String {
+        model::default_profile_name(&self.current_settings(), &self.saved_names())
+    }
+
+    /// The list's rows, where the default is, and the chosen row.
+    fn profile_list(&self) -> (Vec<String>, usize, usize) {
+        let (rows, default) = model::profile_rows(&self.current_settings(), &self.saved_names());
+        let chosen = self.chosen_profile().and_then(|name| rows.iter().position(|row| *row == name)).unwrap_or(default);
+        (rows, default, chosen)
+    }
+
+    /// The saved profile chosen in the list; None while it is the default.
+    fn chosen_profile(&self) -> Option<String> {
+        let sheet = self.desk_ui.settings.as_ref()?;
+        let chosen = sheet.chosen.clone()?;
+        let default = self.default_profile();
+        (chosen.to_lowercase() != default.to_lowercase() && sheet.saved.iter().any(|(name, _)| *name == chosen)).then_some(chosen)
+    }
+
+    /// − works on a saved profile: never the default, so never the last one.
+    fn can_remove_profile(&self) -> bool {
+        self.chosen_profile().is_some()
+    }
+
+    /// What the window's controls show and change: in Profiles the chosen profile's
+    /// settings, else (the default, and General) the live settings.
+    fn shown_settings(&self) -> Settings {
+        if self.in_profiles() && self.chosen_profile().is_some() {
+            if let Some(chosen) = self.desk_ui.settings.as_ref().and_then(|sheet| sheet.chosen_settings.clone()) {
+                return chosen;
+            }
+        }
+        self.current_settings()
+    }
+
+    /// A change in the window: a saved profile's goes to its file; the default's and
+    /// General's are the live settings, which every window takes at once.
+    fn desk_set(&mut self, cx: &mut Cx, next: Settings) {
+        let Some(name) = self.chosen_profile().filter(|_| self.in_profiles()) else {
+            self.apply(cx, next);
+            return;
+        };
+        match term_settings::save_profile(&name, &next) {
+            Ok(()) => {
+                if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                    if let Some(entry) = sheet.saved.iter_mut().find(|(saved, _)| *saved == name) {
+                        entry.1 = next.theme.clone();
+                    }
+                    sheet.chosen_settings = Some(Settings { profile: name, ..next });
+                }
+            }
+            Err(err) => self.desk_notice(format!("The profile \u{201c}{name}\u{201d} could not be saved."), err.to_string()),
+        }
+        self.refresh(cx);
+    }
+
+    /// What went wrong, in a sheet of its own until OK.
+    fn desk_notice(&mut self, title: String, body: String) {
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.name = None;
+            sheet.asking_delete = false;
+            sheet.notice = Some((title, body));
+        }
+    }
+
+    /// Choose a profile in the list (None: the default), its file read for the tabs.
+    fn choose_profile(&mut self, cx: &mut Cx, name: Option<String>) {
+        let loaded = match &name {
+            Some(name) => match term_settings::load_profile(name) {
+                Some(settings) => Some(settings),
+                None => {
+                    self.desk_notice(format!("The profile \u{201c}{name}\u{201d} could not be read."), String::new());
+                    self.refresh(cx);
+                    return;
+                }
+            },
+            None => None,
+        };
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.chosen = name;
+            sheet.chosen_settings = loaded;
+            sheet.list_scroll = 0;
+            sheet.key_row = None;
+            sheet.key_edit = None;
+        }
+        // Keep it in view.
+        let (_, _, chosen) = self.profile_list();
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            let fit = sheet.profile_fit.max(1);
+            if chosen < sheet.profile_scroll {
+                sheet.profile_scroll = chosen;
+            } else if chosen >= sheet.profile_scroll + fit {
+                sheet.profile_scroll = chosen + 1 - fit;
+            }
+        }
+        self.refresh(cx);
+    }
+
+    fn choose_profile_row(&mut self, cx: &mut Cx, index: usize) {
+        let (rows, default, chosen) = self.profile_list();
+        if index == chosen {
+            return;
+        }
+        if let Some(name) = rows.get(index).cloned() {
+            self.choose_profile(cx, (index != default).then_some(name));
+        }
+    }
+
+    /// Up and Down in the list.
+    fn desk_move_chosen(&mut self, cx: &mut Cx, dir: i64) {
+        let (rows, _, chosen) = self.profile_list();
+        let next = (chosen as i64 + dir).clamp(0, rows.len() as i64 - 1) as usize;
+        self.choose_profile_row(cx, next);
+    }
+
+    /// A tab of the chosen profile's in front.
+    fn desk_show_tab(&mut self, tab: usize) {
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.tab = tab.min(MAC_PROFILE_TABS.len() - 1);
+            sheet.focus = None;
+            sheet.list_scroll = 0;
+            sheet.list_rect = Rect::default();
+        }
+    }
+
+    /// Up and Down in the Keyboard tab's table, the chosen row kept in view.
+    fn desk_move_key_row(&mut self, dir: i64) {
+        let count = model::key_rows(&self.shown_settings(), cfg!(target_os = "macos")).len();
+        if count == 0 {
+            return;
+        }
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            let next = match sheet.key_row {
+                Some(at) => (at as i64 + dir).clamp(0, count as i64 - 1) as usize,
+                None if dir > 0 => 0,
+                None => count - 1,
+            };
+            sheet.key_row = Some(next);
+            sheet.reveal_key_row();
+        }
+    }
+
+    /// The Keyboard tab's sheet: for + a new chord (Control and Command with a key, as a
+    /// Mac leaves free), else the chosen row's chord and action, to change.
+    fn begin_key_edit(&mut self, cx: &mut Cx, row: Option<usize>) {
+        let mac = cfg!(target_os = "macos");
+        let edit = match row {
+            Some(index) => {
+                let rows = model::key_rows(&self.shown_settings(), mac);
+                let Some(row) = rows.get(index) else {
+                    return;
+                };
+                KeyEdit { was: Some(row.trigger), key: row.trigger.key, mods: row.trigger.mods, action: row.action.clone() }
+            }
+            None => KeyEdit {
+                was: None,
+                key: model::KEY_CHOICES[0].0,
+                mods: keybinds::Mods { ctrl: true, sup: mac, shift: !mac, alt: false },
+                action: model::key_action_choices().into_iter().next().unwrap_or(keybinds::Action::NewTab),
+            },
+        };
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.key_edit = Some(edit);
+        }
+        self.desk_ui.press = None;
+        self.refresh(cx);
+    }
+
+    /// The sheet's Add (OK): the chord's `keybind` lines in the shown profile's file (the
+    /// chord it changed given back first), its row chosen.
+    fn commit_key_edit(&mut self, cx: &mut Cx) {
+        let Some(edit) = self.desk_ui.settings.as_ref().and_then(|sheet| sheet.key_edit.clone()) else {
+            return;
+        };
+        if !self.key_edit_check(&edit).0 {
+            return;
+        }
+        let mac = cfg!(target_os = "macos");
+        let s = self.shown_settings();
+        let trigger = edit.trigger();
+        let mut lines = s.keybinds.clone();
+        if let Some(was) = edit.was.filter(|was| *was != trigger) {
+            lines = model::unbind_key(&lines, mac, was);
+        }
+        lines = model::bind_key(&lines, mac, trigger, &edit.action);
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.key_edit = None;
+        }
+        if lines != s.keybinds {
+            self.desk_set(cx, Settings { keybinds: lines, ..s });
+        }
+        let rows = model::key_rows(&self.shown_settings(), mac);
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.key_row = rows.iter().position(|row| row.trigger == trigger);
+            sheet.reveal_key_row();
+        }
+        self.refresh(cx);
+    }
+
+    /// −: the chosen row's chord gives up its action, without asking, as Terminal.app's
+    /// − does: its line goes, or a default's chord gets an `unbind` line and is the
+    /// program's again. The row after it is chosen.
+    fn remove_key_row(&mut self, cx: &mut Cx) {
+        let mac = cfg!(target_os = "macos");
+        let s = self.shown_settings();
+        let rows = model::key_rows(&s, mac);
+        let Some(at) = self.desk_ui.settings.as_ref().and_then(|sheet| sheet.key_row).filter(|at| *at < rows.len()) else {
+            return;
+        };
+        let lines = model::unbind_key(&s.keybinds, mac, rows[at].trigger);
+        self.desk_set(cx, Settings { keybinds: lines, ..s });
+        let left = model::key_rows(&self.shown_settings(), mac).len();
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.key_row = (left > 0).then(|| at.min(left - 1));
+            sheet.reveal_key_row();
+        }
+        self.refresh(cx);
+    }
+
+    /// The name sheet, for + (a new name no profile has) or a rename (the old name),
+    /// the name selected whole.
+    fn begin_profile_name(&mut self, cx: &mut Cx, naming: Naming) {
+        let (rows, _, _) = self.profile_list();
+        let text = match &naming {
+            Naming::New => model::unused_profile_name("New Profile", &rows),
+            Naming::Rename(old) => old.clone(),
+            Naming::SaveAs => self.settings.profile.clone(),
+        };
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.name = Some(NameEdit::new(&text));
+            sheet.name_selected = naming != Naming::SaveAs && !text.is_empty();
+            sheet.naming = naming;
+            sheet.focus = None;
+        }
+        self.refresh(cx);
+    }
+
+    fn begin_rename_profile(&mut self, cx: &mut Cx) {
+        let (rows, _, chosen) = self.profile_list();
+        if let Some(old) = rows.get(chosen).cloned() {
+            self.begin_profile_name(cx, Naming::Rename(old));
+        }
+    }
