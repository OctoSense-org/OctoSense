+#[cfg(test)]
+mod info_tests {
+    use super::*;
+
+    /// A Mac's menu bar gets Preview's Tools beside View's rows, as JSON the shell
+    /// reads (`WmRequest::MenuRows`): grey with nothing to act on, and the
+    /// Inspector's row saying what it will do.
+    #[test]
+    fn the_menu_bar_has_previews_tools() {
+        use makepad_widgets::makepad_micro_serde::{DeJson, JsonValue};
+        let rows = mac_menu_rows(true, Some(true), Some(false));
+        assert!(JsonValue::deserialize_json(&rows).is_ok(), "{rows}");
+        assert!(rows.contains(r#""menu":"Tools","title":"Rotate Left","key":"cmd+L","command":"key:cmd+L","enabled":true"#), "{rows}");
+        assert!(rows.contains(r#""menu":"Tools","title":"Rotate Right","key":"cmd+R","command":"key:cmd+R","enabled":true"#), "{rows}");
+        assert!(rows.contains(r#""title":"Thumbnails","key":"shift+cmd+T","command":"key:shift+cmd+T","enabled":true,"checked":true"#), "{rows}");
+        assert!(rows.contains(r#""title":"Show Inspector","key":"cmd+I","command":"key:cmd+I","enabled":true"#), "{rows}");
+        assert!(rows.contains(r#"{"menu":"Tools"}"#), "a rule before the Inspector: {rows}");
+        let out = mac_menu_rows(true, None, Some(true));
+        assert!(out.contains(r#""title":"Hide Inspector""#), "{out}");
+        assert!(out.contains(r#""title":"Thumbnails","key":"shift+cmd+T","command":"key:shift+cmd+T","enabled":false"#), "{out}");
+        let empty = mac_menu_rows(false, None, None);
+        assert!(JsonValue::deserialize_json(&empty).is_ok() && !empty.contains(r#""enabled":true"#), "nothing to act on: {empty}");
+    }
+
+    #[test]
+    fn a_file_size_reads_as_a_mac_says_it() {
+        assert_eq!(file_size(1), "1 byte");
+        assert_eq!(file_size(512), "512 bytes");
+        assert_eq!(file_size(244_880), "245 KB (244,880 bytes)");
+        assert_eq!(file_size(999_499), "999 KB (999,499 bytes)");
+        assert_eq!(file_size(999_500), "1 MB (999,500 bytes)");
+        assert_eq!(file_size(1_234_567), "1.2 MB (1,234,567 bytes)");
+        assert_eq!(file_size(999_960_000), "1 GB (999,960,000 bytes)");
+        assert_eq!(file_size(2_500_000_000), "2.5 GB (2,500,000,000 bytes)");
+    }
+
+    #[test]
+    fn a_kind_is_named_by_its_extension() {
+        assert_eq!(kind_of(Path::new("photos/alpine.JPG")), "JPEG image");
+        assert_eq!(kind_of(Path::new("boy.png")), "PNG image");
+        assert_eq!(kind_of(Path::new("no extension")), "Image");
+    }
+}
