+        assert_eq!(profile_name_problem("work", &taken, None), Some("A profile named \u{201c}work\u{201d} already exists.".to_owned()));
+        assert_eq!(profile_name_problem("work", &taken, Some("Work")), None, "a rename may change the case");
+        assert!(profile_name_problem("Basic", &taken, Some("Work")).is_some());
+        let long = "x".repeat(41);
+        for bad in ["a/b", ".hidden", "x=y", long.as_str()] {
+            assert!(profile_name_problem(bad, &taken, None).is_some_and(|p| p.starts_with("Use up to 40")), "{bad}");
+        }
+    }
+
+    #[test]
+    fn generals_rows_say_what_they_are_for_on_a_mac() {
+        assert_eq!(Row::Profile.mac_label(), "New windows and tabs open with:");
+        assert_eq!(Row::NewTabDir.mac_label(), "New windows and tabs open in:");
+        assert_eq!(Row::Theme.mac_label(), Row::Theme.desk_label());
+        assert!(Row::Profile.mac_note().is_some());
+        assert_eq!(Row::Term.mac_note(), Row::Term.desk_note());
+    }
+
+    /// A Mac's Keyboard tab: a row for each chord, an action's Command chord
+    /// first, in the menus' order; + and − write Ghostty's `keybind` lines,
+    /// which read back as the table they mean, the way today's file is read.
+    #[test]
+    fn the_keyboard_tab_edits_keybind_lines_the_file_reads_as_before() {
+        use crate::keybinds::{parse_trigger, Action};
+        let s = Settings::default();
+        let rows = key_rows(&s, true);
+        assert_eq!(rows.len(), Keybinds::defaults(true).bindings.len());
+        assert_eq!((rows[0].keys.as_str(), &rows[0].action), ("\u{2318}T", &Action::NewTab));
+        assert_eq!(rows[1].action, Action::NewTab, "\u{2303}\u{21e7}T after \u{2318}T");
+        let tab = |n| rows.iter().position(|row| row.action == Action::GotoTab(n)).unwrap();
+        assert!(tab(1) < tab(2) && tab(8) < rows.iter().position(|row| row.action == Action::LastTab).unwrap());
+        // +: a new chord is one line, and the table has it.
+        // (A Mac's file says cmd, another's super; both read as either.)
+        let spelled = |chord: &str| crate::keybinds::config_trigger(&parse_trigger(chord).unwrap()).unwrap();
+        let j = parse_trigger("ctrl+cmd+j").unwrap();
+        let lines = bind_key(&s.keybinds, true, j, &Action::NewWindow);
+        assert_eq!(lines, [format!("{}=new_window", spelled("ctrl+cmd+j"))]);
+        let with = Settings { keybinds: lines.clone(), ..Settings::default() };
+        assert!(key_rows(&with, true).iter().any(|row| row.trigger == j && row.action == Action::NewWindow && row.keys == "\u{2303}\u{2318}J"));
+        // The file says it as `keybind = ...`, which reads back unchanged.
+        assert!(with.to_text().contains(&format!("\nkeybind = {}=new_window\n", spelled("ctrl+cmd+j"))));
+        let reread = Settings::parse(&with.to_text());
+        assert_eq!(reread.keybinds, lines);
+        assert!(Keybinds::build(&reread.keybinds, true).errors.is_empty());
+        // −: the added chord goes with its line.
+        assert!(unbind_key(&lines, true, j).is_empty());
+        // − on a default: an unbind line, and the key is the program's again.
+        let t = parse_trigger("cmd+t").unwrap();
+        let off = unbind_key(&[], true, t);
+        assert_eq!(off, [format!("{}=unbind", spelled("cmd+t"))]);
+        assert!(!key_rows(&Settings { keybinds: off.clone(), ..Settings::default() }, true).iter().any(|row| row.trigger == t));
+        // + gives it back: the unbind line goes, and a default needs no line.
+        assert!(bind_key(&off, true, t, &Action::NewTab).is_empty());
+        // Another action for a default's chord: one line, in place of the unbind.
+        assert_eq!(bind_key(&off, true, t, &Action::NewWindow), [format!("{}=new_window", spelled("cmd+t"))]);
+        // A `clear`, and a line that doesn't read, stay as written.
+        let kept: Vec<String> = ["clear", "oops", "cmd+t=new_window"].map(String::from).to_vec();
+        assert_eq!(unbind_key(&kept, true, t), ["clear", "oops"]);
+    }
+
+    /// The Keyboard tab's sheet: what a chord does now, and the chords it
+    /// can't give out (a key that types, the ones macOS keeps).
+    #[test]
+    fn the_keyboard_sheet_says_what_a_chord_does_and_what_it_cannot_have() {
+        use crate::keybinds::{parse_trigger, Action};
+        let none: Vec<String> = Vec::new();
+        let check = |chord: &str, action: Action| key_check(&none, true, parse_trigger(chord).unwrap(), &action, None);
+        assert_eq!(check("j", Action::NewTab), (false, Some("Add \u{2303}, \u{2325} or \u{2318}: the key alone types.".into())));
+        assert!(!check("shift+j", Action::NewTab).0);
+        assert_eq!(check("f5", Action::NewTab), (true, None));
+        assert_eq!(check("cmd+q", Action::NewTab), (false, Some("macOS keeps \u{2318}Q for itself.".into())));
+        assert_eq!(check("cmd+t", Action::NewTab), (false, Some("\u{2318}T already does this.".into())));
+        assert_eq!(
+            check("cmd+t", Action::NewWindow),
+            (true, Some("\u{2318}T is \u{201c}New Tab\u{201d} now: this replaces it.".into()))
+        );
+        assert_eq!(check("ctrl+cmd+j", Action::NewWindow), (true, None));
+        // A row's own chord, its action changed: nothing to say about the chord.
+        let t = parse_trigger("cmd+t").unwrap();
+        assert_eq!(key_check(&none, true, t, &Action::NewWindow, Some(t)), (true, None));
+        // Every key the sheet offers can be written.
+        assert!(KEY_CHOICES.iter().all(|(key, _)| crate::keybinds::key_config_name(*key).is_some()));
+        // Its actions: a tab by its number, Do Nothing last.
+        let actions = key_action_choices();
+        assert_eq!(actions.last(), Some(&Action::Ignore));
+        assert!(actions.contains(&Action::GotoTab(8)) && actions.contains(&Action::NewWindow));
+        assert_eq!(key_action_label(&Action::ScrollPageLines(-3)), "Scroll Up 3 Lines");
+        assert_eq!(key_action_label(&Action::GotoTab(4)), "Show Tab 4");
+        // The Key pop-up names a key as a Mac's keyboard does; a key only a line names keeps a name.
+        assert_eq!(key_choice_name(makepad_widgets::KeyCode::Equals), "=");
+        assert_eq!(key_choice_name(makepad_widgets::KeyCode::Backspace), "Delete");
+        assert_eq!(key_choice_name(makepad_widgets::KeyCode::NumpadEnter), "\u{21a9}");
+    }
 }
