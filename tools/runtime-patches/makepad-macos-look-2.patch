+        self.fill(cx, rect_at(inner_x, head_y + KEY_HEADER - 1.0, inner_w, 1.0), c.border, 0.0);
+        let list = rect_at(inner_x, head_y + KEY_HEADER, inner_w, LIST_ROW * KEY_ROWS as f64);
+        let max = rows.len().saturating_sub(KEY_ROWS);
