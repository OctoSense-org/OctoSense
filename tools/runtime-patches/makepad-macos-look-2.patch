+/// The style of the line the selection starts on, as a Mac's Format menu ticks
+/// it. The first line is the note's title.
+pub fn block_style_at(source: &str, sel: ByteSelection) -> BlockStyle {
+    let source = normalize_newlines(source);
+    let spans = line_spans(&source);
+    let (first, _) = selected_line_range(&source, sel);
+    let Some((ls, le)) = spans.get(first) else { return BlockStyle::Title };
+    if first == 0 {
+        return BlockStyle::Title;
+    }
+    let line = &source[*ls..*le];
+    if line.starts_with("## ") {
+        BlockStyle::Heading
+    } else if line.starts_with("# ") {
+        BlockStyle::Title
+    } else if checklist_prefix(line).is_some() {
+        BlockStyle::Checklist
+    } else if line.starts_with("- ") {
+        BlockStyle::Bullets
+    } else if numbered_prefix(line).is_some() {
+        BlockStyle::Numbers
+    } else {
+        BlockStyle::Body
+    }
+}
