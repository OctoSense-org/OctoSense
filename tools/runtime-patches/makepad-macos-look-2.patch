+    fn desk_chosen_answer(&mut self, cx: &mut Cx, done: &ChosenFileAction) {
+        let (id, result) = match done {
+            ChosenFileAction::Done { id, data } => (*id, Ok(data)),
+            ChosenFileAction::Failed { id, error } => (*id, Err(error.clone())),
+            ChosenFileAction::None => return,
+        };
+        let job = self.desk_ui.settings.as_mut().and_then(|sheet| sheet.file_job.take());
+        match job {
+            Some(FileJob::ImportRead { id: read, file }) if read == id => match result {
+                Ok(data) => self.finish_import(cx, &file, data),
+                Err(error) => self.desk_notice(format!("\u{201c}{file}\u{201d} could not be read."), error),
+            },
+            Some(FileJob::ExportWrite { id: write, name }) if write == id => {
+                if let Err(error) = result {
+                    self.desk_notice(format!("\u{201c}{name}\u{201d} could not be exported."), error);
+                }
+            }
+            other => {
+                if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                    sheet.file_job = other;
+                }
+            }
+        }
+        self.refresh(cx);
+    }
