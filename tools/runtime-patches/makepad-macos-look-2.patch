+/// The most a search of This Mac reads: past it the walk stops, the nearest
+/// folders read first, rather than hold a huge home in memory.
+const EVERYWHERE_CAP: usize = 100_000;
+
+/// Everything a search of This Mac looks through: each folder and file under
+/// `home`, the nearest first, hidden ones only when the window shows them.
+/// The Trash and the home's Library are left out, as Finder's search leaves
+/// out the Trash and system files. A folder reached twice through a link is
+/// read once.
+fn read_everything(home: &Path, show_hidden: bool) -> Vec<FileEntry> {
+    let (trash, library) = (trash_dir(home), home.join("Library"));
+    let mut seen = std::collections::HashSet::new();
+    let mut out = Vec::new();
+    let mut todo = std::collections::VecDeque::from([home.to_path_buf()]);
+    while let Some(dir) = todo.pop_front() {
+        if !seen.insert(std::fs::canonicalize(&dir).unwrap_or_else(|_| dir.clone())) {
+            continue;
+        }
+        let Ok(entries) = vfs().read_dir(&dir, show_hidden) else {
+            continue;
+        };
+        for entry in entries {
+            if entry.path == trash || entry.path == library {
+                continue;
+            }
+            if entry.is_dir {
+                todo.push_back(entry.path.clone());
+            }
+            out.push(entry);
+            if out.len() >= EVERYWHERE_CAP {
+                return out;
+            }
+        }
+    }
+    out
+}
