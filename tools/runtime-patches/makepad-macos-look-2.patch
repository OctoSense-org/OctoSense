+/// The rows Image adds to a Mac's menu bar (`makepad_wm_api::menu_rows`): View's
+/// sidebar and sizes, and Preview's Tools > Rotate Left, Rotate Right and Show or
+/// Hide Inspector, each the key the window already answers. `picture`: one is on
+/// screen to size and turn. `thumbs` and `inspector`: whether each is out, `None`
+/// where it can't be.
+fn mac_menu_rows(picture: bool, thumbs: Option<bool>, inspector: Option<bool>) -> String {
+    let row = |menu: &str, title: &str, key: &str, enabled: bool, checked: bool| {
+        format!(r#"{{"menu":"{menu}","title":"{title}","key":"{key}","command":"key:{key}","enabled":{enabled},"checked":{checked}}}"#)
+    };
+    let inspect = if inspector == Some(true) { "Hide Inspector" } else { "Show Inspector" };
+    let rows = [
+        row("View", "Thumbnails", "shift+cmd+T", thumbs.is_some(), thumbs == Some(true)),
+        row("View", "Zoom In", "cmd+=", picture, false),
+        row("View", "Zoom Out", "cmd+-", picture, false),
+        row("View", "Actual Size", "cmd+0", picture, false),
+        row("View", "Zoom to Fit", "cmd+9", picture, false),
+        row("Tools", "Rotate Left", "cmd+L", picture, false),
+        row("Tools", "Rotate Right", "cmd+R", picture, false),
+        r#"{"menu":"Tools"}"#.to_string(),
+        row("Tools", inspect, "cmd+I", inspector.is_some(), false),
+    ];
+    format!("[{}]", rows.join(","))
+}
+
+/// What a Mac calls the file, by its extension.
+fn kind_of(path: &Path) -> &'static str {
+    let extension = path.extension().and_then(|extension| extension.to_str()).unwrap_or_default().to_ascii_lowercase();
+    match extension.as_str() {
+        "png" => "PNG image",
+        "jpg" | "jpeg" => "JPEG image",
+        "webp" => "WebP image",
+        "gif" => "GIF image",
+        "bmp" => "BMP image",
+        "qoi" => "QOI image",
+        "ico" => "ICO image",
+        _ => "Image",
+    }
+}
+
+/// A file's size as a Mac says it, in thousands, and its bytes: "245 KB
+/// (244,880 bytes)", "1.2 MB", "2.5 GB".
+fn file_size(bytes: u64) -> String {
+    let exact = grouped(bytes);
+    if bytes < 1000 {
+        return if bytes == 1 { "1 byte".to_string() } else { format!("{exact} bytes") };
+    }
+    let kilobytes = (bytes as f64 / 1e3).round();
+    let megabytes = (bytes as f64 / 1e5).round() / 10.0;
+    let short = if kilobytes < 1000.0 {
+        format!("{} KB", kilobytes as u64)
+    } else if megabytes < 1000.0 {
+        format!("{} MB", trimmed(format!("{megabytes:.1}")))
+    } else {
+        format!("{} GB", trimmed(format!("{:.2}", bytes as f64 / 1e9)))
+    };
+    format!("{short} ({exact} bytes)")
+}
+
+/// A decimal's trailing zeros dropped: "1.0" is "1", "2.50" is "2.5".
+fn trimmed(decimal: String) -> String {
+    if decimal.contains('.') {
+        decimal.trim_end_matches('0').trim_end_matches('.').to_string()
+    } else {
+        decimal
+    }
+}
+
+/// 1234567 as "1,234,567".
+fn grouped(number: u64) -> String {
+    let digits = number.to_string();
+    let mut out = String::with_capacity(digits.len() + digits.len() / 3);
+    for (index, digit) in digits.chars().enumerate() {
+        if index > 0 && (digits.len() - index) % 3 == 0 {
+            out.push(',');
+        }
+        out.push(digit);
+    }
+    out
+}
