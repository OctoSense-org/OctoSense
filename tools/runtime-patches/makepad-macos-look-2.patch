+                words: "Robin".into(),
+                after: " sings from first light, and the robin's song carries over the frozen garden in\u{2026}".into(),
+            }
+        );
+        let second = page.context(found[1]);
+        assert_eq!(second.before, "\u{2026}and the ");
+        assert_eq!(second.words, "robin");
+        // The page's end is no cut.
+        assert_eq!(second.after, "'s song carries over the frozen garden in the depth of winter.");
+        // A ligature reads as its letters, a soft hyphen as nothing, and a letter
+        // that folds to two as itself: one shown for each folded.
+        let (mut folded, mut shown) = (Vec::new(), Vec::new());
+        for c in "\u{fb01}ne co\u{ad}op \u{130}".chars() {
+            let from = folded.len();
+            fold(c, |f| folded.push(f));
+            show_as(c, &folded[from..], &mut shown);
+        }
+        assert_eq!(folded.len(), shown.len());
+        assert_eq!(shown.iter().filter(|c| **c != '\0').collect::<String>(), "fine coop \u{130}");
+    }
+
+    #[test]
+    fn the_finder_lists_its_matches_and_takes_one_as_current() {
+        let pages = vec![page_of("BT /F1 10 Tf 10 700 Td (a wren) Tj ET"), page_of("BT /F1 10 Tf 10 700 Td (wren and wren) Tj ET")];
+        let mut finder = Finder::default();
+        finder.search("wren", &pages, 0);
+        assert_eq!(finder.found().iter().map(|found| found.page).collect::<Vec<_>>(), [0, 1, 1]);
+        assert_eq!(finder.select(2).map(|found| found.page), Some(1));
+        assert_eq!(finder.position(), 3);
+        // Past the end, nothing changes.
+        assert_eq!(finder.select(9).map(|found| found.page), Some(1));
+        assert_eq!(finder.position(), 3);
+        assert_eq!(finder.step(true).map(|found| found.page), Some(0));
+    }
+
     #[test]
     fn a_page_with_no_text_says_so() {
         assert!(!page_of("0 0 100 100 re f").has_text());
diff --git a/apps/pdf/src/find_list.rs b/apps/pdf/src/find_list.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5dc4019d2b5a47451ef4087cc2a191e93843723a
--- /dev/null
+++ b/apps/pdf/src/find_list.rs
@@ -0,0 +1,348 @@
+//! Find's matches in the sidebar, as Preview lists them: each in its words,
+//! the match in bold, and its page. A press makes one current; the current one
+//! is marked, and kept in view as the keys walk the matches.
+//!
+//! A desktop's alone: a phone has no Find (`MpPdfView::sync_find_list`).
+
+use crate::find::FoundWords;
+use makepad_widgets::makepad_draw::shader::draw_text::TextOverflow;
+use makepad_widgets::*;
+
+/// The list's width: a line of words and a page's number.
+pub const LIST_WIDTH: f64 = 240.0;
+/// The space a word gap is, at the rows' size: a label drops one at its ends.
+const WORD_GAP: f64 = 2.5;
+/// A row's insets, left and right, and the gap before its page: as the
+/// layout below sets them.
+const ROW_INSET_LEFT: f64 = 14.0;
+const ROW_INSET_RIGHT: f64 = 15.0;
+const PAGE_GAP: f64 = 8.0;
+
+script_mod! {
+    use mod.prelude.widgets_internal.*
+    use mod.widgets.*
+
+    mod.widgets.MpPdfFindListBase = #(MpPdfFindList::register_widget(vm))
+
+    // The sidebar's gray, as the thumbnails have it, and a source list's
+    // selection for the current match: the field keeps the keyboard.
+    let ink = theme.color_text
+    let page = theme.color_bg_app
+    let sidebar = mix(page, ink, 0.03)
+    let muted = mix(ink, page, 0.3)
+    let chosen = mix(page, ink, 0.12)
+    // The current match's page, on its fill: darker, to read at 4.5:1 there.
+    let muted_chosen = mix(ink, page, 0.2)
+
+    let Words = Label{
+        padding: 0
+        max_lines: 1
+        text: ""
+        draw_text +: {color: ink text_style: theme.font_regular{font_size: 9.75}}
+    }
+
+    mod.widgets.MpPdfFindList = set_type_default() do mod.widgets.MpPdfFindListBase{
+        width: 240
+        height: Fill
+        flow: Overlay
+        page_ink: muted
+        page_ink_chosen: muted_chosen
+
+        SolidView{
+            width: Fill
+            height: Fill
+            flow: Overlay
+            draw_bg +: { color: sidebar }
+
+            results := PortalList{
+                width: Fill
+                height: Fill
+                flow: Down
+
+                // A press makes a match current and leaves the keyboard in
+                // the search field, where Return and Command-G walk on.
+                Found := View{
+                    width: Fill
+                    height: 26
+                    flow: Overlay
+                    cursor: MouseCursor.Default
+                    grab_key_focus: false
+
+                    found_fill := RoundedView{
+                        visible: false
+                        width: Fill
+                        height: Fill
+                        margin: Inset{left: 6 right: 7 top: 1 bottom: 1}
+                        draw_bg +: { color: chosen border_radius: 2.5 }
+                    }
+                    // The words: a word or two before the match, the match,
+                    // and what follows. `draw_rows` sets the right inset, which
+                    // keeps them clear of the page.
+                    found_line := View{
+                        width: Fill
+                        height: Fill
+                        flow: Right
+                        align: Align{y: 0.5}
+                        padding: Inset{left: 14 right: 15}
+                        found_before := Words{}
+                        found_words := Words{draw_text +: {text_style: theme.font_bold{font_size: 9.75}}}
+                        found_after := Words{width: Fill text_overflow: TextOverflow.Ellipsis}
+                    }
+                    // The page, at the row's end.
+                    View{
+                        width: Fill
+                        height: Fill
+                        flow: Right
+                        align: Align{x: 1.0 y: 0.5}
+                        padding: Inset{right: 15}
+                        found_page := Label{
+                            padding: 0
+                            text: ""
+                            draw_text +: {color: muted text_style: theme.font_regular{font_size: 8.25}}
+                        }
+                    }
+                }
+            }
+
+            // A search that finds nothing says so where its matches would be.
+            found_none := View{
+                visible: false
+                width: Fill
+                height: Fill
+                align: Align{x: 0.5 y: 0.25}
+                found_none_words := Label{
+                    padding: 0
+                    text: "No Results"
+                    draw_text +: {color: muted text_style: theme.font_regular{font_size: 9.75}}
+                }
+            }
+        }
+
+        // The list's edge, as the thumbnails' strip has it.
+        View{
+            width: Fill
+            height: Fill
+            flow: Right
+            align: Align{x: 1.0}
+            SolidView{
+                width: 1
+                height: Fill
+                draw_bg +: { color: mix(page, ink, 0.14) }
+            }
+        }
+    }
+}
+
+/// What the list tells the viewer.
+#[derive(Clone, Debug, Default)]
+pub enum MpPdfFindListAction {
+    /// A match was pressed: make it current (its place in the list, from 0).
+    Select(usize),
+    /// The press on a match was let go. The search field, which lost the
+    /// keyboard to a press outside it, takes it back.
+    Released,
+    #[default]
+    None,
+}
+
+/// One row: a match's page (from 0) and its words.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct FoundRow {
+    pub page: usize,
+    pub words: FoundWords,
+}
+
+#[derive(Script, ScriptHook, Widget)]
+pub struct MpPdfFindList {
+    #[source]
+    source: ScriptObjectRef,
+    #[deref]
+    view: View,
+    /// A match's page, and the current match's on its fill.
+    #[live]
+    page_ink: Vec4f,
+    #[live]
+    page_ink_chosen: Vec4f,
+    #[rust]
+    rows: Vec<FoundRow>,
+    #[rust]
+    current: Option<usize>,
+}
+
+impl Widget for MpPdfFindList {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.view.handle_event(cx, event, scope);
+        if let Event::Actions(actions) = event {
+            let list = self.view.portal_list(cx, ids!(results));
+            for (index, item) in list.items_with_actions(actions) {
+                if item.as_view().finger_down(actions).is_some() {
+                    cx.widget_action(self.widget_uid(), MpPdfFindListAction::Select(index));
+                }
+                if item.as_view().finger_up(actions).is_some() {
+                    cx.widget_action(self.widget_uid(), MpPdfFindListAction::Released);
+                }
+            }
+        }
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        self.view.widget(cx, ids!(found_none)).set_visible(cx, self.rows.is_empty());
+        while let Some(step) = self.view.draw_walk(cx, scope, walk).step() {
+            if let Some(mut list) = step.as_portal_list().borrow_mut() {
+                self.draw_rows(cx, &mut list);
+            }
+        }
+        DrawStep::done()
+    }
+}
+
+impl MpPdfFindList {
+    pub fn set_rows(&mut self, cx: &mut Cx, rows: Vec<FoundRow>) {
+        if self.rows != rows {
+            self.rows = rows;
+            self.view.portal_list(cx, ids!(results)).set_first_id_and_scroll(0, 0.0);
+            self.view.redraw(cx);
+        }
+    }
+
+    /// Mark the current match, and keep it in view with a row of context.
+    pub fn set_current(&mut self, cx: &mut Cx, current: Option<usize>) {
+        if self.current == current {
+            return;
+        }
+        self.current = current;
+        if let Some(at) = current {
+            let list = self.view.portal_list(cx, ids!(results));
+            let first = list.first_id();
+            let visible = list.visible_items().max(2);
+            if at < first || at + 1 >= first + visible {
+                list.set_first_id_and_scroll(at.saturating_sub(1), 0.0);
+            }
+        }
+        self.view.redraw(cx);
+    }
+
+    fn draw_rows(&mut self, cx: &mut Cx2d, list: &mut PortalList) {
+        list.set_item_range(cx, 0, self.rows.len());
+        while let Some(index) = list.next_visible_item(cx) {
+            let Some(row) = self.rows.get(index) else {
+                continue;
+            };
+            let item = list.item(cx, index, id!(Found));
+            let words = &row.words;
+            let page = format!("Page {}", row.page + 1);
+            // A label drops a space at its ends: the gap goes in its margin.
+            let (before, gap_before) = trimmed_end(&words.before);
+            let (after, gap_after) = trimmed_start(&words.after);
+            let before_label = item.label(&**cx, ids!(found_before));
+            let words_label = item.label(&**cx, ids!(found_words));
+            let after_label = item.label(&**cx, ids!(found_after));
+            let page_label = item.label(&**cx, ids!(found_page));
+            // The page always shows whole, and what follows the match at least
+            // as an ellipsis. When the rest doesn't fit, the words before the
+            // match give way a word at a time, from their start; then nothing
+            // follows the match, and a match too long for the row ends in an
+            // ellipsis of its own.
+            let page_width = text_width(cx, &page_label, &page);
+            let room = LIST_WIDTH - ROW_INSET_LEFT - ROW_INSET_RIGHT - PAGE_GAP - page_width;
+            let match_width = text_width(cx, &words_label, &words.words);
+            let after_gap = if gap_after { WORD_GAP } else { 0.0 };
+            let after_least = if after.is_empty() { 0.0 } else { after_gap + text_width(cx, &after_label, "\u{2026}") };
+            let gap = |lead: &str| if gap_before && !lead.is_empty() { WORD_GAP } else { 0.0 };
+            let mut lead = before.to_string();
+            while !lead.is_empty() && text_width(cx, &before_label, &lead) + gap(&lead) + match_width + after_least > room {
+                lead = without_first_word(&lead);
+            }
+            let lead_width = if lead.is_empty() { 0.0 } else { text_width(cx, &before_label, &lead) + gap(&lead) };
+            let squeezed = lead_width + match_width + after_least > room;
+            before_label.set_text(&mut **cx, &lead);
+            item.widget(&**cx, ids!(found_before)).set_visible(&mut **cx, !lead.is_empty());
+            words_label.set_text(&mut **cx, &words.words);
+            after_label.set_text(&mut **cx, after);
+            item.widget(&**cx, ids!(found_after)).set_visible(&mut **cx, !squeezed && !after.is_empty());
+            if let Some(mut label) = words_label.borrow_mut() {
+                label.walk.margin.left = gap(&lead);
+                label.walk.width = if squeezed { Size::Fixed((room - lead_width).max(0.0)) } else { Size::fit() };
+                label.text_overflow = if squeezed { TextOverflow::Ellipsis } else { TextOverflow::Clip };
+            }
+            if let Some(mut label) = after_label.borrow_mut() {
+                label.walk.margin.left = after_gap;
+            }
+            if let Some(mut line) = item.view(&**cx, ids!(found_line)).borrow_mut() {
+                line.layout.padding.right = ROW_INSET_RIGHT + PAGE_GAP + page_width;
+            }
+            page_label.set_text(&mut **cx, &page);
+            let current = self.current == Some(index);
+            page_label.set_text_color(&mut **cx, if current { self.page_ink_chosen } else { self.page_ink });
+            item.widget(&**cx, ids!(found_fill)).set_visible(&mut **cx, current);
+            item.draw_all(cx, &mut Scope::empty());
+        }
+    }
+}
+
+/// How wide a row's label sets `text`, in points.
+fn text_width(cx: &mut Cx2d, label: &LabelRef, text: &str) -> f64 {
+    label.borrow().map_or(0.0, |label| {
+        let laid = label.draw_text.layout(cx, 0.0, 0.0, None, false, Align::default(), text);
+        laid.rows.first().map_or(0.0, |row| row.width_in_lpxs as f64)
+    })
+}
+
+/// The words before a match with their first word gone. Cut, they start with
+/// an ellipsis, which goes last.
+fn without_first_word(lead: &str) -> String {
+    let rest = lead.trim_start_matches('\u{2026}');
+    match rest.split_once(' ') {
+        Some((_, tail)) if !tail.trim().is_empty() => format!("\u{2026}{}", tail.trim_start()),
+        _ if rest.is_empty() => String::new(),
+        _ => "\u{2026}".to_string(),
+    }
+}
+
+fn trimmed_end(text: &str) -> (&str, bool) {
+    let trimmed = text.trim_end();
+    (trimmed, trimmed.len() < text.len())
+}
+
+fn trimmed_start(text: &str) -> (&str, bool) {
+    let trimmed = text.trim_start();
+    (trimmed, trimmed.len() < text.len())
+}
+
+impl MpPdfFindListRef {
+    pub fn set_rows(&self, cx: &mut Cx, rows: Vec<FoundRow>) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.set_rows(cx, rows);
+        }
+    }
+
+    pub fn set_current(&self, cx: &mut Cx, current: Option<usize>) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.set_current(cx, current);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_word_gap_at_a_labels_end_is_kept_as_its_margin() {
+        assert_eq!(trimmed_end("The European "), ("The European", true));
+        assert_eq!(trimmed_end("\u{2026}the rob"), ("\u{2026}the rob", false));
+        assert_eq!(trimmed_start(" sings"), ("sings", true));
+        assert_eq!(trimmed_start("'s song"), ("'s song", false));
+        assert_eq!(trimmed_end(""), ("", false));
+    }
+
+    #[test]
+    fn the_words_before_a_match_give_way_a_word_at_a_time() {
+        assert_eq!(without_first_word("\u{2026}and sadder"), "\u{2026}sadder");
+        assert_eq!(without_first_word("\u{2026}sadder"), "\u{2026}");
+        assert_eq!(without_first_word("\u{2026}"), "");
+        assert_eq!(without_first_word("The European"), "\u{2026}European");
+        assert_eq!(without_first_word("one  two"), "\u{2026}two");
+        assert_eq!(without_first_word(""), "");
+    }
+}
