+/// Why a model can't be picked now, in a person's words: never the engine's.
+fn unavailable_words(reason: &str) -> &'static str {
+    if reason.starts_with("Local AI only") {
+        "Off While Local AI Only Is On"
+    } else if reason.contains("KEY") || reason.contains("TOKEN") {
+        "Needs an API Key"
+    } else {
+        "Not Available"
+    }
