+    /// What the Settings window writes for a chord reads back as that chord,
+    /// for every key a line can name and every set of modifiers.
+    #[test]
+    fn a_chord_spelled_for_the_file_reads_back_the_same() {
+        let mut named = 0;
+        for &key in ALL_KEY_CODES {
+            let Some(name) = key_config_name(key) else {
+                continue;
+            };
+            named += 1;
+            for bits in 0..16u8 {
+                let mods = Mods { ctrl: bits & 1 != 0, alt: bits & 2 != 0, shift: bits & 4 != 0, sup: bits & 8 != 0 };
+                let chord = Trigger { key, mods };
+                let spelled = config_trigger(&chord).unwrap();
+                assert!(spelled.ends_with(&name), "{spelled}");
+                assert_eq!(parse_trigger(&spelled), Ok(chord), "{spelled}");
+            }
+        }
+        // Letters, digits, punctuation, the named keys, F1 to F12 and the keypad.
+        assert_eq!(named, 91);
+        assert_eq!(key_config_name(KeyCode::Control), None);
+        assert_eq!(config_trigger(&trig("ctrl+shift+t")).unwrap(), "ctrl+shift+t");
+        assert_eq!(config_trigger(&trig("cmd+[")).unwrap(), if cfg!(target_os = "macos") { "cmd+bracket_left" } else { "super+bracket_left" });
+        // A shifted symbol is its key with Shift.
+        assert_eq!(config_trigger(&trig("ctrl+?")).unwrap(), "ctrl+shift+slash");
+    }
