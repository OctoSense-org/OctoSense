+/// Wake Ups, CPU Time, then Threads).
+pub fn mac_columns(width: f64, tab: MacTab, hidden: u16) -> ShownColumns {
+    let mut shown = ShownColumns::of(tab.columns());
+    shown.retain(|col| col == COL_NAME || hidden & (1 << col) == 0);
+    for &col in tab.drop_order() {
+        let numbers: f64 = shown.iter().map(|&col| DESK_WIDTHS[col]).sum();
