+            y += LIST_ROW;
+        }
+        // An overlay knob, as the shortcut list's: the table goes on.
+        if max > 0 {
+            let track = list.size.y - 6.0;
+            let h = (track * KEY_ROWS as f64 / rows.len() as f64).max(18.0);
+            let top = list.pos.y + 3.0 + (track - h) * scroll as f64 / max as f64;
+            let knob = vec4(c.ink.x, c.ink.y, c.ink.z, if Cx::monotonic_now() < self.desk_ui.knob_until { 0.4 } else { 0.22 });
