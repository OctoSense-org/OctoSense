diff --git a/apps/image/src/overflow.rs b/apps/image/src/overflow.rs
new file mode 100644
index 0000000000000000000000000000000000000000..96a7aa716ff36c5898536f10e3b1e85547a34ce8
--- /dev/null
+++ b/apps/image/src/overflow.rs
@@ -0,0 +1,152 @@
+//! A toolbar's overflow: tools a narrow window has no room for go behind the
+//! » at the toolbar's end, as a Mac's do, and stay reachable from its menu.
+//! The app says which tools that is; this holds the menu and draws it. The
+//! PDF Viewer's toolbar has the same, from this file.
+
+use makepad_widgets::*;
+
+script_mod! {
+    use mod.prelude.widgets.*
+
+    mod.widgets.MpToolbarMoreBase = #(MpToolbarMore::register_widget(vm))
+    mod.widgets.MpToolbarMore = set_type_default() do mod.widgets.MpToolbarMoreBase{
+        width: 0
+        height: 0
+        popup_menu: mod.widgets.PopupMenu{}
+    }
+}
+
+/// Owns the menu and draws it. The app offers it every event first, so that
+/// while it is open the keys and the pointer reach nothing else.
+#[derive(Script, ScriptHook, Widget)]
+pub struct MpToolbarMore {
+    #[deref]
+    view: View,
+    #[live]
+    popup_menu: ScriptValue,
+    #[rust]
+    context_menu: ContextMenu,
+    /// The tool the menu hangs from.
+    #[rust]
+    tool: WidgetRef,
+}
+
+impl Widget for MpToolbarMore {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.view.handle_event(cx, event, scope);
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        let step = self.view.draw_walk(cx, scope, walk);
+        if step.is_done() && self.context_menu.is_open() {
+            let uid = self.widget_uid();
+            let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+            self.context_menu.draw(cx, uid, owner);
+        }
+        step
+    }
+}
+
+impl MpToolbarMoreRef {
+    /// Hang the menu of `rows` from under `tool`, `ticked` ticked.
+    pub fn open(&self, cx: &mut Cx, tool: &WidgetRef, rows: Vec<ContextRow>, ticked: Option<usize>) {
+        let Some(mut inner) = self.borrow_mut() else { return };
+        let inner = &mut *inner;
+        let anchor = tool.area().rect(cx);
+        let at = dvec2(anchor.pos.x, anchor.pos.y + anchor.size.y + 4.0);
+        let owner = ContextMenuOwner { source: &inner.view.source, template: inner.popup_menu, area: inner.view.area() };
+        inner.context_menu.open_pull_down(cx, owner, at, Cx::time_now(), rows, ticked);
+        // The menu leaves the pointer the plain arrow, as a right click's does.
+        // This one opened from the tool under the pointer, which is a control
+        // still: to a Mac window's toolbar band the plain arrow means an empty
+        // stretch, and once Escape closed the menu the next press on the tool
+        // would move the window instead of reaching it.
+        if inner.context_menu.is_open() {
+            let cursor = makepad_widgets::desktop_style::control_cursor(cx);
+            cx.set_cursor(cursor);
+            inner.tool = tool.clone();
+        }
+    }
+
+    pub fn is_open(&self) -> bool {
+        self.borrow().is_some_and(|inner| inner.context_menu.is_open())
+    }
+
+    pub fn offer(&self, cx: &mut Cx, event: &Event) -> ContextMenuEvent {
+        let Some(mut inner) = self.borrow_mut() else { return ContextMenuEvent::Ignored };
+        let inner = &mut *inner;
+        let owner = ContextMenuOwner { source: &inner.view.source, template: inner.popup_menu, area: inner.view.area() };
+        let was_open = inner.context_menu.is_open();
+        let answer = inner.context_menu.handle_event(cx, event, owner);
+        if was_open && !inner.context_menu.is_open() {
+            // The press that opened the menu was released into it: the tool
+            // never heard, and would stay pressed.
+            inner.tool.as_button().reset_hover(cx);
+            inner.tool = WidgetRef::empty();
+        }
+        answer
+    }
+}
+
+/// One row of an overflow menu: what it says, whether it can act now, and
+/// the app's own command for it. `None` is a rule.
+pub struct MoreRow<C> {
+    pub title: &'static str,
+    pub live: bool,
+    pub command: Option<C>,
+}
+
+impl<C: Copy> MoreRow<C> {
+    pub fn new(title: &'static str, live: bool, command: C) -> Self {
+        MoreRow { title, live, command: Some(command) }
+    }
+
+    pub fn rule() -> Self {
+        MoreRow { title: "-", live: false, command: None }
+    }
+
+    /// The menu's rows, and the commands by row, rules dropped where they
+    /// would lead, trail or double.
+    pub fn split(rows: Vec<MoreRow<C>>) -> (Vec<ContextRow>, Vec<Option<C>>) {
+        let mut shown: Vec<MoreRow<C>> = Vec::new();
+        for row in rows {
+            let rule = row.command.is_none();
+            if rule && shown.last().is_none_or(|last| last.command.is_none()) {
+                continue;
+            }
+            shown.push(row);
+        }
+        while shown.last().is_some_and(|last| last.command.is_none()) {
+            shown.pop();
+        }
+        shown
+            .into_iter()
+            .map(|row| match row.command {
+                Some(command) => (ContextRow::new(row.title, row.live), Some(command)),
+                None => (ContextRow::rule(), None),
+            })
+            .unzip()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rules_only_stand_between_rows() {
+        let rows = vec![
+            MoreRow::rule(),
+            MoreRow::new("Zoom In", true, 1),
+            MoreRow::rule(),
+            MoreRow::rule(),
+            MoreRow::new("Fit Page", false, 2),
+            MoreRow::rule(),
+        ];
+        let (menu, commands) = MoreRow::split(rows);
+        let titles: Vec<&str> = menu.iter().map(|row| row.title.as_str()).collect();
+        assert_eq!(titles, ["Zoom In", "-", "Fit Page"]);
+        assert_eq!(commands, [Some(1), None, Some(2)]);
+        assert!(!menu[2].live);
+    }
+}
