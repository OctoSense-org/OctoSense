+        NEVER => "Never".into(),
+        EVERY_DAY => "Every day".into(),
+        _ => DAY_NAMES.iter().enumerate().filter(|(i, _)| days & (1 << i) != 0).map(|(_, name)| &name[..3]).collect::<Vec<_>>().join(" "),
+    }
