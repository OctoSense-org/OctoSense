 }
+
+#[test]
+fn a_macs_delete_takes_a_reminder_at_once_and_undo_puts_it_back_as_a_new_revision() {
+    let (mut cx, root) = root();
+    let mut view = root.borrow_mut::<RemindersView>().unwrap();
+    mac_work_list(&mut view, &mut cx);
+    let before = view.document.clone().unwrap();
+    view.selected_row = Some(12);
+    view.delete_now(&mut cx, 12);
+    assert!(view.document.as_ref().unwrap().reminder(12).is_none(), "gone at once");
+    assert!(view.draft.is_none() && !view.confirm_delete, "nothing asks first");
+    assert_eq!(view.selected_row, None);
+    let deleted = view.document.as_ref().unwrap().revision;
+    assert!(view.undo_last_delete(&mut cx));
+    let doc = view.document.clone().unwrap();
+    assert_eq!(doc.reminders, before.reminders, "back as it was");
+    assert!(doc.revision > deleted, "a new revision, so it is saved");
+    assert_eq!(view.selected_row, Some(12));
+    assert!(!view.undo_last_delete(&mut cx), "one Undo for one Delete");
+    // Redo deletes it again, and Undo is offered again.
+    assert_eq!(view.redo_delete, Some(12));
+    assert!(view.redo_last_delete(&mut cx));
+    assert!(view.document.as_ref().unwrap().reminder(12).is_none());
+    assert!(view.redo_delete.is_none() && view.undo_delete.is_some());
+    assert!(!view.redo_last_delete(&mut cx), "one Redo for one Undo");
+    assert!(view.undo_last_delete(&mut cx));
+    // Any other change ends what Undo would put back, and what Redo would take.
+    view.mutate(&mut cx, Command::SetFlagged { id: 13, flagged: true });
+    assert!(view.redo_delete.is_none());
+    view.delete_now(&mut cx, 12);
+    assert!(view.undo_delete.is_some());
+    view.mutate(&mut cx, Command::SetFlagged { id: 13, flagged: false });
+    assert!(view.undo_delete.is_none());
+}
+
+#[test]
+fn a_macs_clear_takes_the_shown_lists_completed_reminders_older_than_its_choice() {
+    let (mut cx, root) = root();
+    let mut view = root.borrow_mut::<RemindersView>().unwrap();
+    mac_work_list(&mut view, &mut cx);
+    // Work's completed reminders: a day and three days ago.
+    let mut all = view.clearable(0);
+    all.sort();
+    assert_eq!(all, vec![19, 20]);
+    assert!(view.clearable(30).is_empty(), "none is a month old");
+    view.now.day += 40;
+    assert_eq!(view.clearable(30).len(), 2);
+    assert!(view.clearable(365).is_empty());
+    view.now.day -= 40;
+    view.open_list_sheet(&mut cx, ListSheet::Clear(0));
+    assert_eq!(view.list_sheet, Some(ListSheet::Clear(0)));
+    view.commit_list_sheet(&mut cx);
+    assert_eq!(view.list_sheet, None);
+    let doc = view.document.as_ref().unwrap();
+    assert!(doc.reminder(19).is_none() && doc.reminder(20).is_none());
+    assert!(doc.reminder(9).is_some(), "another list's completed reminders stay");
+    assert!(doc.reminder(12).is_some(), "what isn't completed stays");
+}
