+pub fn marker_sig(state: &MapOverlayState) -> u64 {
+    use std::hash::{Hash, Hasher};
+    let mut hasher = std::collections::hash_map::DefaultHasher::new();
+    for marker in &state.markers {
+        marker.id.hash(&mut hasher);
+        marker.pos_norm.x.to_bits().hash(&mut hasher);
+        marker.pos_norm.y.to_bits().hash(&mut hasher);
+    }
+    hasher.finish()
