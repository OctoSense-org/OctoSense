+    /// Two rates share one scale, the larger's peak at nine tenths.
+    #[test]
+    fn rates_share_one_scale() {
+        let colors = (vec4(0.0, 0.0, 1.0, 1.0), vec4(1.0, 0.0, 0.0, 1.0));
+        let series = rate_series(&[0.0, 50.0, 100.0], &[200.0, 0.0, 20.0], colors);
+        let near = |points: &[f64], want: [f64; 3]| points.iter().zip(want).all(|(a, b)| (a - b).abs() < 1e-9);
+        assert!(near(&series[0].points, [0.0, 22.5, 45.0]), "{:?}", series[0].points);
