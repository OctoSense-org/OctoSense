+/// What is wrong with `name` for a profile: Some("") when there is nothing to say but
+/// nothing to save either (no name yet). `own`: the profile being renamed, whose name
+/// it may keep or change the case of.
+pub fn profile_name_problem(name: &str, taken: &[String], own: Option<&str>) -> Option<String> {
+    let name = name.trim();
+    if name.is_empty() {
+        return Some(String::new());
+    }
+    if !crate::settings::valid_profile_name(name) {
+        return Some("Use up to 40 characters, without / \\ : = # or a leading period.".to_owned());
+    }
+    let own = own.map(str::to_lowercase);
+    let lower = name.to_lowercase();
+    if taken.iter().any(|t| t.to_lowercase() == lower && own.as_deref() != Some(lower.as_str())) {
+        return Some(format!("A profile named \u{201c}{name}\u{201d} already exists."));
+    }
