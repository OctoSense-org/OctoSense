+/// Sizes and rates as a Mac's Activity Monitor writes them: whole bytes with
+/// a thousands separator ("1,014 bytes"), whole KB, MB to one place, GB and up
+/// to two, counted in 1024s as it counts memory.
+pub fn format_bytes_activity(bytes: u64) -> String {
+    const UNITS: [&str; 5] = ["bytes", "KB", "MB", "GB", "TB"];
+    if bytes < 1024 {
+        return format!("{} {}", with_thousands(bytes), UNITS[0]);
+    }
+    let mut value = bytes as f64 / 1024.0;
+    let mut unit = 1;
+    loop {
+        let places = match unit {
+            1 => 0,
+            2 => 1,
+            _ => 2,
+        };
+        let scale = 10f64.powi(places as i32);
+        let shown = (value * scale).round() / scale;
+        // 1023.9 KB reads as 1.0 MB, not 1024 KB.
+        if shown < 1024.0 || unit + 1 == UNITS.len() {
+            return format!("{:.*} {}", places, shown, UNITS[unit]);
+        }
+        value /= 1024.0;
+        unit += 1;
+    }
+}
+
+pub fn with_thousands(value: u64) -> String {
+    let digits = value.to_string();
+    let mut out = String::with_capacity(digits.len() + digits.len() / 3);
+    for (at, digit) in digits.chars().enumerate() {
+        if at > 0 && (digits.len() - at) % 3 == 0 {
+            out.push(',');
+        }
+        out.push(digit);
+    }
+    out
+}
+
+/// CPU Time as Activity Monitor writes it: seconds to two places, with the
+/// minutes and hours in front once there are any ("0.52", "4:31.47",
+/// "2:45:27.39").
+pub fn format_cpu_time(nanos: u64) -> String {
+    let hundredths = nanos / 10_000_000;
+    let (hours, minutes) = (hundredths / 360_000, hundredths / 6_000 % 60);
+    let (seconds, fraction) = (hundredths / 100 % 60, hundredths % 100);
+    if hours > 0 {
+        format!("{hours}:{minutes:02}:{seconds:02}.{fraction:02}")
+    } else if minutes > 0 {
+        format!("{minutes}:{seconds:02}.{fraction:02}")
+    } else {
+        format!("{seconds}.{fraction:02}")
+    }
+}
