+//! The colours of a pointer desktop's controls: the shared interface's values
+//! (`apps/interface.splash`), worked out from the two colours every style sheet has.
+//! The terminal's own chrome is drawn in code, so it cannot use those names.
+
+use makepad_widgets::*;
+
+fn hex(c: u32) -> Vec4f {
+    vec4(((c >> 16) & 255) as f32 / 255.0, ((c >> 8) & 255) as f32 / 255.0, (c & 255) as f32 / 255.0, 1.0)
+}
+
+pub(crate) fn mix(a: Vec4f, b: Vec4f, t: f32) -> Vec4f {
+    vec4(
+        a.x + (b.x - a.x) * t,
+        a.y + (b.y - a.y) * t,
+        a.z + (b.z - a.z) * t,
+        a.w + (b.w - a.w) * t,
+    )
+}
+
+/// `text` on the line whose middle is `mid`, by its capitals: it reads as centred in a
+/// control whatever the font's ascent and descent are.
+pub(crate) fn text_on_line(draw: &mut DrawText, cx: &mut Cx2d, x: f64, mid: f64, text: &str, color: Vec4f) {
+    let laid = draw.layout(cx, 0.0, 0.0, None, false, Align::default(), text);
+    let Some(row) = laid.rows.first() else {
+        return;
+    };
+    let cap = if row.cap_height_in_lpxs > 0.0 { row.cap_height_in_lpxs } else { row.ascender_in_lpxs * 0.72 };
+    draw.color = color;
+    draw.draw_abs(cx, dvec2(x, mid + cap as f64 * 0.5 - row.origin_in_lpxs.y as f64), text);
+}
+
+/// How wide `text` is set.
+pub(crate) fn text_width(draw: &DrawText, cx: &mut Cx2d, text: &str) -> f64 {
+    let laid = draw.layout(cx, 0.0, 0.0, None, false, Align::default(), text);
+    laid.rows.first().map_or(0.0, |row| row.width_in_lpxs as f64)
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct DeskPalette {
+    pub light: bool,
+    pub ink: Vec4f,
+    pub muted: Vec4f,
+    /// A title bar's and a sheet's colour.
+    pub bar: Vec4f,
+    /// The tab bar behind its tabs, a shade under the title bar.
+    pub strip: Vec4f,
+    /// The hairlines between tabs and over them.
+    pub strip_line: Vec4f,
+    /// What a list sits on.
+    pub content: Vec4f,
+    pub menu: Vec4f,
+    pub border: Vec4f,
+    pub selected: Vec4f,
+    pub hover: Vec4f,
+    pub field: Vec4f,
+    pub button: Vec4f,
+    /// The raised segment of a segmented control, on `selected`.
+    pub segment: Vec4f,
+    /// An unchecked box's edge.
+    pub check_edge: Vec4f,
+    pub button_hover: Vec4f,
+    pub button_down: Vec4f,
+    pub primary: Vec4f,
+    pub primary_hover: Vec4f,
+    pub primary_down: Vec4f,
+    /// The row a menu is on, white text on it.
+    pub accent_row: Vec4f,
+    pub link: Vec4f,
+    pub white: Vec4f,
+}
+
+impl DeskPalette {
+    pub(crate) fn of(ink: Vec4f, page: Vec4f) -> DeskPalette {
+        let lum = |c: Vec4f| c.x * 0.2118 + c.y * 0.7137 + c.z * 0.0706;
+        let light = lum(ink) < 0.5;
+        let by = |l: u32, d: u32| hex(if light { l } else { d });
+        let button = if light { hex(0xffffff) } else { mix(page, ink, 0.16) };
+        DeskPalette {
+            light,
+            ink,
+            muted: mix(ink, page, 0.26),
+            bar: by(0xededf0, 0x303033),
+            strip: by(0xdcdce0, 0x242426),
+            strip_line: by(0xc4c4c8, 0x444447),
+            content: by(0xffffff, 0x1e1e1e),
+            menu: by(0xf6f6f7, 0x38383b),
+            border: mix(page, ink, 0.14),
+            selected: mix(page, ink, 0.11),
+            hover: mix(page, ink, 0.07),
+            field: if light { hex(0xffffff) } else { mix(page, ink, 0.07) },
+            button,
+            segment: by(0xffffff, 0x636366),
+            check_edge: if light { mix(page, ink, 0.14) } else { mix(page, ink, 0.32) },
+            button_hover: mix(button, ink, 0.04),
+            button_down: mix(button, ink, 0.1),
+            primary: hex(0x0071e3),
+            primary_hover: hex(0x006edb),
+            primary_down: hex(0x0060c0),
+            accent_row: by(0x0064d2, 0x0a60c8),
+            link: by(0x0060c0, 0x6cb8ff),
+            white: hex(0xffffff),
+        }
+    }
+}
diff --git a/apps/terminal/src/restore.rs b/apps/terminal/src/restore.rs
new file mode 100644
index 0000000000000000000000000000000000000000..954cc06abbedf1d940525fd3f6f14446f693950d
--- /dev/null
+++ b/apps/terminal/src/restore.rs
@@ -0,0 +1,399 @@
+//! A Mac's Terminal brings its windows and tabs back after it quits. Each window
+//! keeps what it holds when the app quits, or when the desktop it runs in quits
+//! ([`save_in`]), and forgets it when only the window is closed ([`forget_in`]).
+//! The next Terminal opened takes every kept window back ([`take_all_in`]): the
+//! first into itself, each other as a window of its own, started with
+//! [`SavedWindow::to_args`].
+//!
+//! A kept window is its tabs' folders, the tab in front and the name its window
+//! manager keeps its frame under (`WmRequest::FrameAutosave`), so where the window
+//! was and how big comes back with it. What each tab showed comes back too, as
+//! Terminal's "Restore text when reopening windows" has it: its last lines, as
+//! plain text above a fresh shell in its folder. What ran does not.
+//!
+//! `<makepad home>/terminal/restore/<frame>.window`, a line a fact:
+//! `active <n>`, then `tab <folder>` for each tab (an empty folder: home).
+//! `<frame>.<tab>.text` beside it: what that tab showed, read and removed by the
+//! Terminal that brings the window back ([`take_text_in`]); only its owner may
+//! read it.
+
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+/// How many windows come back at most: a folder of stale files never opens a hundred.
+pub const MAX_WINDOWS: usize = 12;
+/// How many tabs a window brings back at most.
+pub const MAX_TABS: usize = 64;
+/// How much of a tab's text comes back at most: its last lines.
+pub const MAX_TEXT_LINES: usize = 2000;
+pub const MAX_TEXT_BYTES: usize = 256 * 1024;
+/// A tab's text no Terminal took back by then was left by one that failed to open.
+const STALE_TEXT: std::time::Duration = std::time::Duration::from_secs(24 * 60 * 60);
+
+const EXTENSION: &str = "window";
+const TEXT_EXTENSION: &str = "text";
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SavedWindow {
+    /// The name the window manager keeps the window's frame under.
+    pub frame: String,
+    /// Each tab's folder, in order; `None` for one that was not known (home).
+    pub tabs: Vec<Option<PathBuf>>,
+    /// The tab in front.
+    pub active: usize,
+}
+
+/// `<makepad home>/terminal/restore`.
+pub fn dir() -> PathBuf {
+    makepad_widgets::makepad_platform::home::makepad_home().join("terminal").join("restore")
+}
+
+/// A name for a new window's frame, unique among this Mac's windows: when it was
+/// opened and by which process.
+pub fn new_frame_name() -> String {
+    let millis = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_millis()).unwrap_or(0);
+    format!("w-{millis}-{}", std::process::id())
+}
+
+/// A frame name this module writes and reads: what `makepad_wm_api::valid_frame_name`
+/// takes, so it is also a plain file name.
+fn valid_frame(frame: &str) -> bool {
+    makepad_wm_api::valid_frame_name(frame)
+}
+
+impl SavedWindow {
+    pub fn to_text(&self) -> String {
+        let mut text = format!("active {}\n", self.active);
+        for tab in &self.tabs {
+            let folder = tab.as_deref().map(|p| p.to_string_lossy().into_owned()).filter(|p| !p.contains(|c| c == '\n' || c == '\r'));
+            text.push_str(&format!("tab {}\n", folder.unwrap_or_default()));
+        }
+        text
+    }
+
+    /// A kept window's file; `None` when it holds no tab.
+    pub fn parse(frame: &str, text: &str) -> Option<SavedWindow> {
+        let mut window = SavedWindow { frame: frame.to_owned(), ..SavedWindow::default() };
+        for line in text.lines() {
+            if let Some(n) = line.strip_prefix("active ") {
+                window.active = n.trim().parse().unwrap_or(0);
+            } else if let Some(folder) = line.strip_prefix("tab ") {
+                if window.tabs.len() < MAX_TABS {
+                    window.tabs.push((!folder.is_empty()).then(|| PathBuf::from(folder)));
+                }
+            }
+        }
+        window.active = window.active.min(window.tabs.len().saturating_sub(1));
+        (valid_frame(frame) && !window.tabs.is_empty()).then_some(window)
+    }
+
+    /// The window as a Terminal's command line: `--restore <frame>`, then
+    /// `--restore-active <n>` and a `--restore-tab <folder>` a tab.
+    pub fn to_args(&self) -> Vec<String> {
+        let mut args = vec!["--restore".to_owned(), self.frame.clone(), "--restore-active".to_owned(), self.active.to_string()];
+        for tab in &self.tabs {
+            args.push("--restore-tab".to_owned());
+            args.push(tab.as_deref().map(|p| p.to_string_lossy().into_owned()).unwrap_or_default());
+        }
+        args
+    }
+
+    /// What [`Self::to_args`] wrote, read back out of a whole command line.
+    pub fn from_args(args: &[String]) -> Option<SavedWindow> {
+        let mut window = SavedWindow::default();
+        let mut found = false;
+        let mut it = args.iter();
+        while let Some(arg) = it.next() {
+            match arg.as_str() {
+                "--restore" => {
+                    window.frame = it.next()?.clone();
+                    found = true;
+                }
+                "--restore-active" => window.active = it.next()?.parse().unwrap_or(0),
+                "--restore-tab" => {
+                    let folder = it.next()?;
+                    if window.tabs.len() < MAX_TABS {
+                        window.tabs.push((!folder.is_empty()).then(|| PathBuf::from(folder)));
+                    }
+                }
+                _ => {}
+            }
+        }
+        if !found || !valid_frame(&window.frame) {
+            return None;
+        }
+        if window.tabs.is_empty() {
+            window.tabs.push(None);
+        }
+        window.active = window.active.min(window.tabs.len() - 1);
+        Some(window)
+    }
+}
+
+fn file_of(dir: &Path, frame: &str) -> PathBuf {
+    dir.join(format!("{frame}.{EXTENSION}"))
+}
+
+/// Keep `window` in `dir` for the next Terminal, replacing what it kept before
+/// (written whole, then renamed: a reader never sees half of it).
+pub fn save_in(dir: &Path, window: &SavedWindow) -> std::io::Result<()> {
+    if !valid_frame(&window.frame) || window.tabs.is_empty() {
+        return Err(std::io::Error::other("not a window to keep"));
+    }
+    std::fs::create_dir_all(dir)?;
+    let path = file_of(dir, &window.frame);
+    let tmp = dir.join(format!(".{}.{}.tmp", window.frame, std::process::id()));
+    std::fs::write(&tmp, window.to_text())?;
+    std::fs::rename(&tmp, &path)
+}
+
+/// The window was closed, not the app quit: it does not come back.
+pub fn forget_in(dir: &Path, frame: &str) {
+    if valid_frame(frame) {
+        let _ = std::fs::remove_file(file_of(dir, frame));
+        forget_texts_in(dir, frame);
+    }
+}
+
+fn text_of(dir: &Path, frame: &str, tab: usize) -> PathBuf {
+    dir.join(format!("{frame}.{tab}.{TEXT_EXTENSION}"))
+}
+
+/// A tab's text as it is kept: its last [`MAX_TEXT_LINES`] lines, within
+/// [`MAX_TEXT_BYTES`].
+fn kept_text(text: &str) -> &str {
+    let mut start = 0;
+    if let Some((at, _)) = text.rmatch_indices('\n').nth(MAX_TEXT_LINES - 1) {
+        start = at + 1;
+    }
+    if text.len() - start > MAX_TEXT_BYTES {
+        start = text.len() - MAX_TEXT_BYTES;
+        while !text.is_char_boundary(start) {
+            start += 1;
+        }
+        // A cut line would come back half: start at the next whole one.
+        start = text[start..].find('\n').map_or(start, |at| start + at + 1);
+    }
+    &text[start..]
+}
+
+/// Keep what each tab of `frame` shows (`None`: nothing), in tab order, for the
+/// window that comes back; what it kept before goes.
+pub fn save_texts_in(dir: &Path, frame: &str, texts: &[Option<String>]) -> std::io::Result<()> {
+    if !valid_frame(frame) {
+        return Err(std::io::Error::other("not a window to keep"));
+    }
+    forget_texts_in(dir, frame);
+    std::fs::create_dir_all(dir)?;
+    for (tab, text) in texts.iter().enumerate().take(MAX_TABS) {
+        let Some(text) = text.as_deref().map(kept_text).filter(|text| !text.trim().is_empty()) else {
+            continue;
+        };
+        let tmp = dir.join(format!(".{frame}.{tab}.{}.tmp", std::process::id()));
+        write_private(&tmp, text)?;
+        std::fs::rename(&tmp, text_of(dir, frame, tab))?;
+    }
+    Ok(())
+}
+
+/// What a terminal showed may be anyone's business but its owner's.
+fn write_private(path: &Path, text: &str) -> std::io::Result<()> {
+    use std::io::Write;
+    let mut options = std::fs::OpenOptions::new();
+    options.write(true).create(true).truncate(true);
+    #[cfg(unix)]
+    std::os::unix::fs::OpenOptionsExt::mode(&mut options, 0o600);
+    options.open(path)?.write_all(text.as_bytes())
+}
+
+/// What tab `tab` of `frame` showed, taken: it comes back once.
+pub fn take_text_in(dir: &Path, frame: &str, tab: usize) -> Option<String> {
+    if !valid_frame(frame) {
+        return None;
+    }
+    let path = text_of(dir, frame, tab);
+    let text = std::fs::read_to_string(&path).ok();
+    let _ = std::fs::remove_file(&path);
+    text.filter(|text| !text.is_empty())
+}
+
+fn forget_texts_in(dir: &Path, frame: &str) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    let prefix = format!("{frame}.");
+    for entry in entries.flatten() {
+        let name = entry.file_name();
+        let Some(name) = name.to_str() else {
+            continue;
+        };
+        let tab = name.strip_prefix(&prefix).and_then(|rest| rest.strip_suffix(&format!(".{TEXT_EXTENSION}")));
+        if tab.is_some_and(|tab| tab.parse::<usize>().is_ok()) {
+            let _ = std::fs::remove_file(entry.path());
+        }
+    }
+}
+
+/// Tabs' texts left by a Terminal that never opened to take them.
+fn sweep_stale_texts_in(dir: &Path) {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return;
+    };
+    let now = SystemTime::now();
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let is_text = path.extension().is_some_and(|ext| ext == TEXT_EXTENSION);
+        let old = entry
+            .metadata()
+            .and_then(|m| m.modified())
+            .is_ok_and(|when| now.duration_since(when).is_ok_and(|age| age > STALE_TEXT));
+        if is_text && old {
+            let _ = std::fs::remove_file(path);
+        }
+    }
+}
+
+/// Every window kept in `dir`, oldest first, taken: no other Terminal opening
+/// at the same moment gets the same one (each file is claimed by a rename
+/// before it is read), and none comes back twice.
+pub fn take_all_in(dir: &Path) -> Vec<SavedWindow> {
+    let Ok(entries) = std::fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut found: Vec<(SystemTime, String, PathBuf)> = entries
+        .flatten()
+        .filter_map(|entry| {
+            let path = entry.path();
+            let frame = path.file_name()?.to_str()?.strip_suffix(&format!(".{EXTENSION}"))?.to_owned();
+            let when = entry.metadata().and_then(|m| m.modified()).unwrap_or(UNIX_EPOCH);
+            valid_frame(&frame).then_some((when, frame, path))
+        })
+        .collect();
+    found.sort();
+    sweep_stale_texts_in(dir);
+    let mut windows = Vec::new();
+    for (_, frame, path) in found {
+        let claimed = dir.join(format!(".{frame}.taken-{}", std::process::id()));
+        if std::fs::rename(&path, &claimed).is_err() {
+            continue;
+        }
+        let text = std::fs::read_to_string(&claimed).unwrap_or_default();
+        let _ = std::fs::remove_file(&claimed);
+        if windows.len() < MAX_WINDOWS {
+            if let Some(window) = SavedWindow::parse(&frame, &text) {
+                windows.push(window);
+            }
+        }
+    }
+    windows
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn scratch(name: &str) -> PathBuf {
+        let dir = std::env::temp_dir().join(format!("terminal-restore-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        dir
+    }
+
+    fn window(frame: &str, tabs: &[&str], active: usize) -> SavedWindow {
+        SavedWindow {
+            frame: frame.into(),
+            tabs: tabs.iter().map(|t| (!t.is_empty()).then(|| PathBuf::from(t))).collect(),
+            active,
+        }
+    }
+
+    #[test]
+    fn a_window_round_trips_through_its_file_and_its_command_line() {
+        let w = window("w-1-2", &["/tmp", "", "/Users/someone/a folder"], 2);
+        assert_eq!(SavedWindow::parse("w-1-2", &w.to_text()), Some(w.clone()));
+        let mut args = vec!["--cwd".to_owned(), "/ignored".to_owned()];
+        args.extend(w.to_args());
+        assert_eq!(SavedWindow::from_args(&args), Some(w));
+        // No restore asked for, or a frame name the WM would refuse.
+        assert_eq!(SavedWindow::from_args(&["--cwd".into(), "/tmp".into()]), None);
+        assert_eq!(SavedWindow::from_args(&["--restore".into(), "../x".into()]), None);
+        // The tab in front is one of the tabs.
+        assert_eq!(SavedWindow::parse("w", "active 9\ntab /a\n").map(|w| w.active), Some(0));
+        assert_eq!(SavedWindow::parse("w", "active 0\n"), None, "no tab, no window");
+    }
+
+    #[test]
+    fn quitting_keeps_a_window_and_closing_it_forgets_it() {
+        let dir = scratch("keep");
+        let w = window("w-10-1", &["/tmp", "/usr"], 1);
+        save_in(&dir, &w).unwrap();
+        save_in(&dir, &window("w-11-1", &["/"], 0)).unwrap();
+        forget_in(&dir, "w-11-1");
+        assert_eq!(take_all_in(&dir), vec![w]);
+        assert_eq!(take_all_in(&dir), Vec::new(), "taken once");
+        let leftovers: Vec<_> = std::fs::read_dir(&dir).unwrap().flatten().collect();
+        assert!(leftovers.is_empty(), "nothing left behind: {leftovers:?}");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn a_tabs_text_comes_back_once_and_only_its_owner_reads_it() {
+        let dir = scratch("text");
+        let w = window("w-20-1", &["/tmp", "/usr"], 0);
+        save_in(&dir, &w).unwrap();
+        save_texts_in(&dir, "w-20-1", &[Some("% echo hi\nhi\n%".into()), None]).unwrap();
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            let mode = std::fs::metadata(text_of(&dir, "w-20-1", 0)).unwrap().permissions().mode();
+            assert_eq!(mode & 0o077, 0, "only its owner reads what a terminal showed");
+        }
+        assert_eq!(take_all_in(&dir), vec![w.clone()]);
+        assert_eq!(take_text_in(&dir, "w-20-1", 0).as_deref(), Some("% echo hi\nhi\n%"));
+        assert_eq!(take_text_in(&dir, "w-20-1", 0), None, "taken once");
+        assert_eq!(take_text_in(&dir, "w-20-1", 1), None, "a tab that showed nothing");
+        // A window closed, not quit, forgets what its tabs showed.
+        save_in(&dir, &w).unwrap();
+        save_texts_in(&dir, "w-20-1", &[Some("x".into()), Some("y".into())]).unwrap();
+        save_texts_in(&dir, "w-20-12", &[Some("another window".into())]).unwrap();
+        forget_in(&dir, "w-20-1");
+        assert_eq!(take_text_in(&dir, "w-20-12", 0).as_deref(), Some("another window"), "only its own");
+        let leftovers: Vec<_> = std::fs::read_dir(&dir).unwrap().flatten().collect();
+        assert!(leftovers.is_empty(), "nothing left behind: {leftovers:?}");
+        assert!(save_texts_in(&dir, "../evil", &[Some("x".into())]).is_err());
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn a_long_text_keeps_its_last_whole_lines() {
+        let many: String = (0..MAX_TEXT_LINES + 10).map(|i| format!("line {i}\n")).collect::<String>().trim_end().to_owned();
+        let kept = kept_text(&many);
+        assert_eq!(kept.lines().count(), MAX_TEXT_LINES);
+        assert!(kept.starts_with("line 10\n"), "{}", &kept[..20]);
+        let wide = "x".repeat(MAX_TEXT_BYTES / 2) + "\n" + &"y".repeat(MAX_TEXT_BYTES) + "\nlast";
+        assert_eq!(kept_text(&wide), "last", "a line the size limit cuts doesn't come back half");
+        assert_eq!(kept_text("short\ntext"), "short\ntext");
+    }
+
+    #[test]
+    fn saving_again_replaces_and_a_bad_window_is_not_kept() {
+        let dir = scratch("replace");
+        save_in(&dir, &window("w-1-1", &["/a"], 0)).unwrap();
+        save_in(&dir, &window("w-1-1", &["/b", "/c"], 1)).unwrap();
+        assert!(save_in(&dir, &window("../evil", &["/a"], 0)).is_err());
+        assert!(save_in(&dir, &window("w-2-2", &[], 0)).is_err());
+        let all = take_all_in(&dir);
+        assert_eq!(all, vec![window("w-1-1", &["/b", "/c"], 1)]);
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn only_so_many_windows_come_back() {
+        let dir = scratch("many");
+        for i in 0..MAX_WINDOWS + 3 {
+            save_in(&dir, &window(&format!("w-{i}-1"), &["/tmp"], 0)).unwrap();
+        }
+        assert_eq!(take_all_in(&dir).len(), MAX_WINDOWS);
+        assert!(take_all_in(&dir).is_empty(), "the rest were taken and dropped");
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+}
