+
+impl Widget for SideList {
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        while let Some(item) = self.view.draw_walk(cx, scope, walk).step() {
+            if let Some(mut list) = item.borrow_mut::<PortalList>() {
+                let Some(chat) = scope.data.get_mut::<ChatState>() else {
+                    continue;
+                };
+                let total = chat.side_rows.len();
+                list.set_item_range(cx, 0, total);
+                while let Some(idx) = list.next_visible_item(cx) {
+                    if idx >= total {
+                        continue;
+                    }
+                    let row = &chat.side_rows[idx];
+                    let selected = chat.side_selected == Some(idx);
+                    let template = match row.glyph {
+                        SideGlyph::Place => id!(PlaceRow),
+                        SideGlyph::Start => id!(StepStart),
+                        SideGlyph::Straight => id!(StepStraight),
+                        SideGlyph::Left => id!(StepLeft),
+                        SideGlyph::Right => id!(StepRight),
+                        SideGlyph::Uturn => id!(StepUturn),
+                        SideGlyph::Round => id!(StepRound),
+                        SideGlyph::Flag => id!(StepFlag),
+                    };
+                    let item = list.item(cx, idx, template);
+                    item.label(cx, ids!(row_title)).set_text(cx, &row.title);
+                    item.label(cx, ids!(row_note)).set_text(cx, &row.note);
+                    if row.glyph == SideGlyph::Place {
+                        item.widget(cx, ids!(row_sel)).set_visible(cx, selected);
+                    } else {
+                        let color = if selected { chat.side_selected_color } else { Vec4f::default() };
+                        let mut hit = item.widget(cx, ids!(row_hit));
+                        script_apply_eval!(cx, hit, {
+                            draw_bg +: {
+                                color: #(color)
+                            }
+                        });
+                    }
+                    item.draw_all(cx, &mut Scope::empty());
+                }
+            }
+        }
+        DrawStep::done()
+    }
