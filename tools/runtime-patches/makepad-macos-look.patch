+// ---------------------------------------------------------------------------
+// the workbook file
+// ---------------------------------------------------------------------------
+
+/// The first line of a workbook file.
+const BOOK_HEADER: &str = "octosense-sheets 1";
+
+fn book_escape(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    for c in text.chars() {
+        match c {
+            '\\' => out.push_str("\\\\"),
+            '\t' => out.push_str("\\t"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            other => out.push(other),
+        }
+    }
+    out
+}
+
+fn book_unescape(text: &str) -> String {
+    let mut out = String::with_capacity(text.len());
+    let mut chars = text.chars();
+    while let Some(c) = chars.next() {
+        if c != '\\' {
+            out.push(c);
+            continue;
+        }
+        match chars.next() {
+            Some('t') => out.push('\t'),
+            Some('n') => out.push('\n'),
+            Some('r') => out.push('\r'),
+            Some(other) => out.push(other),
+            None => out.push('\\'),
+        }
+    }
+    out
+}
+
+/// A cell's format in four letters: bold, italic, alignment, number format.
+fn format_code(format: &CellFormat) -> String {
+    let bold = if format.bold { 'b' } else { '-' };
+    let italic = if format.italic { 'i' } else { '-' };
+    let align = match format.align {
+        HAlign::Auto => 'a',
+        HAlign::Left => 'l',
+        HAlign::Center => 'c',
+        HAlign::Right => 'r',
+    };
+    let num = match format.num {
+        NumFormat::General => 'g',
+        NumFormat::Fixed2 => 'f',
+        NumFormat::Thousands => 't',
+        NumFormat::Percent => 'p',
+    };
+    format!("{bold}{italic}{align}{num}")
+}
+
+fn format_from_code(code: &str) -> Option<CellFormat> {
+    let letters: Vec<char> = code.chars().collect();
+    let [bold, italic, align, num] = letters.as_slice() else {
+        return None;
+    };
+    Some(CellFormat {
+        bold: *bold == 'b',
+        italic: *italic == 'i',
+        align: match align {
+            'a' => HAlign::Auto,
+            'l' => HAlign::Left,
+            'c' => HAlign::Center,
+            'r' => HAlign::Right,
+            _ => return None,
+        },
+        num: match num {
+            'g' => NumFormat::General,
+            'f' => NumFormat::Fixed2,
+            't' => NumFormat::Thousands,
+            'p' => NumFormat::Percent,
+            _ => return None,
+        },
+    })
+}
+
+/// What a workbook holds, whichever sheet is in front: two workbooks with the
+/// same body are the same document, so this also says whether one has changes.
+pub fn book_body(wb: &Workbook) -> String {
+    let mut out = String::new();
+    for sheet in &wb.sheets {
+        out.push_str("sheet\t");
+        out.push_str(&book_escape(&sheet.name));
+        out.push('\n');
+        let mut widths: Vec<(usize, f64)> = sheet.col_widths.iter().map(|(col, width)| (*col, *width)).collect();
+        widths.sort_by_key(|(col, _)| *col);
+        for (col, width) in widths {
+            out.push_str(&format!("width\t{col}\t{width}\n"));
+        }
+        let mut cells: Vec<(Pos, &Cell)> = sheet
+            .cells
+            .iter()
+            .filter(|(_, cell)| !cell.input.is_empty() || !cell.format.is_default())
+            .map(|(pos, cell)| (*pos, cell))
+            .collect();
+        cells.sort_by_key(|(pos, _)| *pos);
+        for ((row, col), cell) in cells {
+            out.push_str(&format!(
+                "cell\t{row}\t{col}\t{}\t{}\n",
+                format_code(&cell.format),
+                book_escape(&cell.input)
+            ));
+        }
+    }
+    out
+}
+
+/// A workbook as its file holds it.
+pub fn to_book(wb: &Workbook) -> String {
+    format!("{BOOK_HEADER}\nactive\t{}\n{}", wb.active, book_body(wb))
+}
+
+/// A workbook back from its file: every sheet, its formulas and formats.
+pub fn book_from(text: &str) -> Result<Workbook, String> {
+    const DAMAGED: &str = "the file is damaged";
+    let mut lines = text.lines();
+    if lines.next() != Some(BOOK_HEADER) {
+        return Err("this is not a workbook".to_string());
+    }
+    let mut sheets: Vec<Sheet> = Vec::new();
+    let mut active = 0usize;
+    for line in lines {
+        if line.is_empty() {
+            continue;
+        }
+        let mut fields = line.split('\t');
+        match fields.next() {
+            Some("active") => {
+                active = fields.next().and_then(|v| v.parse().ok()).ok_or(DAMAGED)?;
+            }
+            Some("sheet") => {
+                sheets.push(Sheet::new(book_unescape(fields.next().ok_or(DAMAGED)?)));
+            }
+            Some("width") => {
+                let col: usize = fields.next().and_then(|v| v.parse().ok()).ok_or(DAMAGED)?;
+                let width: f64 = fields.next().and_then(|v| v.parse().ok()).ok_or(DAMAGED)?;
+                if !width.is_finite() || width <= 0.0 {
+                    return Err(DAMAGED.to_string());
+                }
+                sheets.last_mut().ok_or(DAMAGED)?.col_widths.insert(col, width);
+            }
+            Some("cell") => {
+                let row: usize = fields.next().and_then(|v| v.parse().ok()).ok_or(DAMAGED)?;
+                let col: usize = fields.next().and_then(|v| v.parse().ok()).ok_or(DAMAGED)?;
+                let format = fields.next().and_then(format_from_code).ok_or(DAMAGED)?;
+                let input = book_unescape(fields.next().ok_or(DAMAGED)?);
+                let sheet = sheets.last_mut().ok_or(DAMAGED)?;
+                sheet.write((row, col), &input);
+                sheet.write_format((row, col), |f| *f = format);
+            }
+            _ => return Err(DAMAGED.to_string()),
+        }
+    }
+    if sheets.is_empty() {
+        return Err(DAMAGED.to_string());
+    }
+    for sheet in &mut sheets {
+        sheet.recalc_all();
+    }
+    let active = active.min(sheets.len() - 1);
+    Ok(Workbook { sheets, active, ..Default::default() })
+}
