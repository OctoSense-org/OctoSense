+    /// The note whose row is under the pointer, among the rows drawn last.
+    fn note_under(&self, cx: &mut Cx, at: Vec2d) -> Option<NoteId> {
+        let list_ref = self.list(cx);
+        let presenter = list_ref.widget_uid();
+        let list = list_ref.as_portal_list();
+        self.rendered_rows
+            .iter()
+            .filter(|(uid, _, _)| *uid == presenter)
+            .find(|(_, _, id)| {
+                self.doc
+                    .notes
+                    .iter()
+                    .position(|note| note.id == *id)
+                    .and_then(|index| list.get_item(16 + index))
+                    .is_some_and(|(_, row)| row.area().rect(cx).contains(at))
+            })
+            .map(|(_, _, id)| *id)
+    }
+    /// The folder whose sidebar row is under the pointer.
+    fn folder_under(&self, cx: &mut Cx, at: Vec2d) -> Option<Collection> {
+        let rows = self.view.widget(cx, ids!(wide.folders.rows));
+        for (name, collection) in [
+            live_id!(all),
+            live_id!(notes),
+            live_id!(work),
+            live_id!(personal),
+            live_id!(trash),
+        ]
+        .into_iter()
+        .zip(Collection::ALL)
+        {
+            if rows.widget(cx, &[name]).area().rect(cx).contains(at) {
+                return Some(collection);
+            }
+        }
+        (0..self.doc.folders.len())
+            .find(|index| rows.widget(cx, &[custom_row(*index)]).area().rect(cx).contains(at))
+            .map(|index| Collection::Folder(FolderId::Custom(self.doc.folders[index].id)))
+    }
+    /// A right press: what is under it decides the menu. True when one opened;
+    /// a press in the note's body is the body's own.
+    fn open_context_menu(&mut self, cx: &mut Cx, press: &MouseDownEvent) -> bool {
+        let at = press.abs;
+        let compact = self.layout.is_compact();
+        let in_list = !compact || engine::current_screen(&self.ui) == Screen::List;
+        if in_list && self.list(cx).area().rect(cx).contains(at) {
+            let (rows, ticked) = match self.note_under(cx, at) {
+                Some(id) if self.unified => {
+                    // A Mac's list rings the row it acts on in the accent and
+                    // leaves the selection, and the note beside it, as they were.
+                    self.context_note = Some(id);
+                    self.redraw(cx);
+                    self.note_rows_for(Some(id))
+                }
+                Some(id) => {
+                    // The row it acts on is selected first, and the keys are the list's.
+                    self.flush_editor(cx);
+                    if !compact {
+                        if let Some(mut surface) = self.surface(cx).borrow_mut::<NotesTextSurface>() {
+                            surface.finish(cx);
+                        }
+                    }
+                    self.ui.selected = Some(id);
+                    engine::open_selected_read(&self.doc, &mut self.ui);
+                    self.note_rows()
+                }
+                None if self.ui.collection.allows_create() => {
+                    (vec![(ContextRow::new("New Note", true), Some(MenuAction::NewNote))], None)
+                }
+                None => return false,
+            };
+            self.open_menu(cx, at, press.time, rows, ticked, false);
+            return true;
+        }
+        if !compact && self.layout.is_three() && self.view.widget(cx, ids!(wide.folders)).area().rect(cx).contains(at) {
+            let room = self.doc.folders.len() < MAX_FOLDERS;
+            let rows = match self.folder_under(cx, at) {
+                Some(Collection::Folder(FolderId::Custom(id))) => vec![
+                    (ContextRow::new("Rename…", true), Some(MenuAction::RenameFolder(id))),
+                    (ContextRow::new("Delete Folder…", true), Some(MenuAction::DeleteFolder(id))),
+                    (ContextRow::rule(), None),
+                    (ContextRow::new("New Folder…", room), Some(MenuAction::NewFolder)),
+                ],
+                Some(Collection::RecentlyDeleted) => {
+                    let any = self.doc.notes.iter().any(Note::is_deleted);
+                    vec![(ContextRow::new("Empty Recently Deleted…", any), Some(MenuAction::EmptyDeleted))]
+                }
+                _ => vec![(ContextRow::new("New Folder…", room), Some(MenuAction::NewFolder))],
+            };
+            self.open_menu(cx, at, press.time, rows, None, false);
+            return true;
+        }
+        false
+    }
+    fn menu_chose(&mut self, cx: &mut Cx, index: usize) {
+        let Some(action) = self.menu_actions.get(index).copied().flatten() else {
+            return;
