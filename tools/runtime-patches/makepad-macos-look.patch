+    /// The address field stays in the middle of the window, as wide as it
+    /// can sensibly be; what is left over goes between it and the tools.
+    fn layout_toolbar(&mut self, cx: &mut Cx) {
+        if !self.desk {
+            return;
+        }
+        let width = self.ui.widget(cx, ids!(toolbar)).area().rect(cx).size.x;
+        if width <= 0.0 || width == self.toolbar_width {
+            return;
+        }
+        self.toolbar_width = width;
+        let leading = if self.unified { 84.0 } else { 12.0 } + 62.0;
+        // New Tab, and on other desktops the ⋮ menu: a Mac's toolbar has none.
+        let trailing = 12.0 + if self.unified { 30.0 } else { 62.0 };
+        let free = (width - leading - trailing - 20.0).max(120.0);
+        let field = (width * 0.52).clamp(280.0, 620.0).min(free);
+        // The two spacings beside the gap are the toolbar's.
+        let gap = ((width - field) * 0.5 - leading - 4.0).clamp(8.0, (free - field + 8.0).max(8.0));
+        let mut gap_view = self.ui.widget(cx, ids!(field_gap));
+        script_apply_eval!(cx, gap_view, {
+            width: #(gap)
+        });
+        let mut frame = self.ui.widget(cx, ids!(omnibox_frame));
+        script_apply_eval!(cx, frame, {
+            width: #(field)
+        });
+        self.ui.redraw(cx);
+    }
+
+    /// With the keyboard the field holds the whole address, selected. Without
+    /// it, it says the site in its middle, or what it is for.
+    fn sync_field(&mut self, cx: &mut Cx) {
+        if !self.desk {
+            return;
+        }
+        let omnibox = self.ui.text_input(cx, ids!(omnibox));
+        self.ui.widget(cx, ids!(field_face)).set_visible(cx, !self.omnibox_focused);
+        self.ui.widget(cx, ids!(field_glyph)).set_visible(cx, self.omnibox_focused);
+        if self.omnibox_focused {
+            omnibox.set_empty_text(cx, FIELD_PLACEHOLDER.to_string());
+            return;
+        }
+        omnibox.set_text(cx, "");
+        omnibox.set_empty_text(cx, String::new());
+        // Bookmarks or History is in front: the field says that, not the page behind.
+        let over = self.places_open.map(|kind| kind.title().to_string());
+        let says_site = over.is_some() || !self.shown_url.is_empty();
+        let text = over.clone().or_else(|| tabs::host_of(&self.shown_url)).unwrap_or_else(|| {
+            if says_site { self.shown_url.clone() } else { FIELD_PLACEHOLDER.to_string() }
+        });
+        let secure = over.is_none() && self.shown_url.starts_with("https://") && !self.shown_failed;
+        let color = if says_site { self.ink } else { self.muted };
+        self.ui.widget(cx, ids!(face_search)).set_visible(cx, !says_site);
+        self.ui.widget(cx, ids!(face_lock)).set_visible(cx, secure);
+        let mut label = self.ui.label(cx, ids!(face_text));
+        label.set_text(cx, &text);
+        script_apply_eval!(cx, label, {
+            draw_text +: {
+                color: #(color)
+            }
+        });
+    }
