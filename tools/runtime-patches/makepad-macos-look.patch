+impl MpPlacesPageRef {
+    pub fn show(&self, cx: &mut Cx, kind: PlacesKind, lines: Vec<Line>, action_words: &str) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.show(cx, kind, lines, action_words);
+        }
+    }
+
+    pub fn hide(&self, cx: &mut Cx) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.hide(cx);
+        }
+    }
+
