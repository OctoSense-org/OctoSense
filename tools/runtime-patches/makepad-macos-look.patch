+/// The phone's list, always these: the head of [`WORLD`].
+pub const FIXED_CITIES: usize = 4;
+/// How many locations a Mac's sidebar keeps.
+pub const MAX_LOCATIONS: usize = 12;
+
+/// Lower case, without the accents the table's names carry.
+fn plain(text: &str) -> String {
+    text.to_lowercase()
+        .chars()
+        .map(|c| match c {
+            'á' | 'à' | 'â' | 'ã' | 'ä' => 'a',
+            'é' | 'è' | 'ê' | 'ë' => 'e',
+            'í' | 'î' | 'ï' => 'i',
+            'ó' | 'ô' | 'õ' | 'ö' => 'o',
+            'ú' | 'û' | 'ü' => 'u',
+            'ç' => 'c',
+            'ñ' => 'n',
+            other => other,
+        })
+        .collect()
+}
+
+/// Add Location's matches: names that start with the words first, then a name
+/// or a country that holds them. A location already saved isn't offered.
+pub fn search_world(query: &str, saved: &[&'static City]) -> Vec<&'static City> {
+    let query = plain(query.trim());
+    let (mut first, mut then) = (Vec::new(), Vec::new());
+    for city in WORLD.iter().filter(|city| !saved.iter().any(|kept| std::ptr::eq(*kept, *city))) {
+        let name = plain(city.name);
+        if name.starts_with(&query) {
+            first.push(city);
+        } else if name.contains(&query) || plain(city.country).contains(&query) {
+            then.push(city);
+        }
+    }
+    if query.is_empty() {
+        first.sort_by_key(|city| city.name);
+    }
+    first.extend(then);
+    first
+}
+
+/// The saved locations on disk: a line per name.
+pub fn encode_locations(cities: &[&'static City]) -> Vec<u8> {
+    cities.iter().map(|city| city.name).collect::<Vec<_>>().join("\n").into_bytes()
+}
+
+/// A name the table no longer has is dropped; nothing left is no list at all.
+pub fn decode_locations(bytes: &[u8]) -> Option<Vec<&'static City>> {
+    let text = std::str::from_utf8(bytes).ok()?;
+    let mut cities: Vec<&'static City> = Vec::new();
+    for name in text.lines() {
+        if let Some(city) = WORLD.iter().find(|city| city.name == name) {
+            if cities.len() < MAX_LOCATIONS && !cities.iter().any(|kept| std::ptr::eq(*kept, city)) {
+                cities.push(city);
+            }
+        }
+    }
+    (!cities.is_empty()).then_some(cities)
+}
