+    /// The calendar's month, Sunday first, six weeks: the chosen day in the
+    /// accent, today's number in it, the neighbouring months' days quiet.
+    fn fill_calendar(&mut self, cx: &mut Cx) {
+        let roles = self.roles;
+        let key = self.form.calendar_month;
+        let first = date::month_key_start(key);
+        let (year, month, _) = date::to_ymd(first);
+        self.label(cx, ids!(cal_title))
+            .set_text(cx, &format!("{} {year}", date::MONTH_NAMES[(month - 1) as usize]));
+        self.form.calendar_start = first - ((date::weekday(first) + 1) % 7) as Day;
+        for cell in 0..42 {
+            let day = self.form.calendar_start + cell;
+            let chosen = day == self.form.date;
+            let ink = if chosen {
+                roles.on_primary
+            } else if day == self.today {
+                roles.primary
+            } else if date::month_key(day) == key {
+                roles.fg
+            } else {
+                roles.dim
+            };
+            let face = if chosen { roles.primary } else { Vec4f::default() };
+            let hover = if chosen { roles.primary } else { roles.hover };
+            let mut item = self.button(cx, &[LiveId::from_str(&format!("cal_d{cell}"))]);
+            item.set_text(cx, &date::to_ymd(day).2.to_string());
+            script_apply_eval!(cx, item, {
+                draw_bg +: { color: #(face) color_hover: #(hover) color_focus: #(face) }
+                draw_text +: { color: #(ink) color_hover: #(ink) color_down: #(ink) color_focus: #(ink) }
+            });
+        }
+    }
