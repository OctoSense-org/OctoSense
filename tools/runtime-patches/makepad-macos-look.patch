+        if let Some(mut inner) = self.borrow_mut() {
+            inner.set_inert(inert);
+        }
+    }
+
+    pub fn menu_open(&self) -> bool {
+        self.borrow().is_some_and(|inner| inner.menu_open())
+    }
+
+    pub fn searching(&self) -> bool {
+        self.borrow().is_some_and(|inner| inner.searching())
+    }
+
+    pub fn clear_search(&self, cx: &mut Cx) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.clear_search(cx);
+        }
+    }
+
+    pub fn focus_search(&self, cx: &mut Cx) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.focus_search(cx);
+        }
+    }
+}
