+    /// The default button: blue, and only once the form can be saved.
+    fn sync_done(&mut self, cx: &mut Cx, form: &WidgetRef) {
+        let valid = self
+            .draft_fields
+            .as_ref()
+            .is_some_and(|fields| !fields.title.trim().is_empty());
+        if self.done_enabled != Some(valid) {
+            self.done_enabled = Some(valid);
+            let done = form.widget(cx, ids!(header.done));
+            done.set_disabled(cx, !valid);
+            form.button(cx, ids!(header.done)).set_enabled(cx, valid);
+        }
+    }
+
+    /// The details hang from the row's info button, as a Mac's inspector does.
+    /// A question, a new reminder and a window with no room for that are a sheet
+    /// under the toolbar: a question is shorter than a form.
+    fn size_popover(&mut self, cx: &mut Cx) {
+        if !self.pointer || self.nav.layout.is_compact() {
+            return;
+        }
+        let size = self.last_size;
+        let origin = self.view.area().rect(cx).pos;
+        let hung = self
+            .pop_anchor
+            .filter(|_| !self.confirm_delete)
+            .map(|at| (at.pos.x - origin.x - POP_WIDTH - 8.0, at.pos.y + at.size.y * 0.5 - origin.y))
+            .filter(|(left, _)| *left >= 8.0);
+        let height = if self.confirm_delete {
+            112.0
+        } else {
+            // The form scrolls in a short window. It ends 20 points under the
+            // last row unless a line needs the room; a Mac's hung from a row
+            // has no buttons.
+            let form = if self.field_error.is_some() || self.utc_fallback { 408.0 } else { 384.0 };
+            let form = if self.unified && hung.is_some() { form - 52.0 } else { form };
+            (size.y - self.bar_height - 12.0).max(44.0).min(form)
+        };
+        let (width, left, top) = match hung {
+            Some((left, y)) => (POP_WIDTH, left, (y - 72.0).min(size.y - height - 8.0).max(self.bar_height + 4.0)),
+            None => {
+                let width = (size.x - 32.0).max(44.0).min(440.0);
+                (width, (size.x - width) * 0.5, self.bar_height)
+            }
+        };
+        self.popover_hung = hung.is_some();
+        self.view.widget(cx, ids!(wide.overlay.dim)).set_visible(cx, hung.is_none());
+        let beak = self.view.widget(cx, ids!(wide.overlay.beak));
+        beak.set_visible(cx, hung.is_some());
+        if let (Some((_, y)), Some(mut inner)) = (hung, beak.borrow_mut::<View>()) {
+            let y = y.min(top + height - 22.0).max(top + 22.0);
+            inner.walk.margin = Inset { left: left + width - 0.7, top: y - 8.0, right: 0.0, bottom: 0.0 };
+        }
+        let margin = Inset { left, top, right: 0.0, bottom: 0.0 };
+        let mut pop = self.view.widget(cx, ids!(wide.overlay.popover));
+        if let Some(mut inner) = pop.borrow_mut::<View>() {
+            if inner.walk.width == Size::Fixed(width) && inner.walk.height == Size::Fixed(height) && inner.walk.margin == margin {
+                return;
+            }
+            inner.walk.width = Size::Fixed(width);
+            inner.walk.height = Size::Fixed(height);
+            inner.walk.margin = margin;
+        }
+        apply_owned!(cx, self.source, pop, { width: #(width) height: #(height) });
+        self.view.redraw(cx);
+    }
