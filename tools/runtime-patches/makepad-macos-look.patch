@@ -0,0 +1,62 @@
+//! The tab strip's overflow: a window's tabs that don't fit stay reachable from
+//! a real menu that lists them all, the one in front ticked. The strip's slots
+//! show the ones that fit.
+
+use makepad_widgets::*;
+
+script_mod! {
+    use mod.prelude.widgets.*
+
+    mod.widgets.TabMenuBase = #(TabMenu::register_widget(vm))
+    mod.widgets.TabMenu = set_type_default() do mod.widgets.TabMenuBase{
+        width: 0
+        height: 0
+        popup_menu: mod.widgets.PopupMenu{}
+    }
+}
+
+/// Owns the menu and draws it. The app offers it every event first, so that
+/// while it is open the keys and the pointer reach nothing else.
+#[derive(Script, ScriptHook, Widget)]
+pub struct TabMenu {
+    #[deref]
+    view: View,
+    #[live]
+    popup_menu: ScriptValue,
+    #[rust]
+    context_menu: ContextMenu,
+}
+
+impl Widget for TabMenu {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.view.handle_event(cx, event, scope);
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        let step = self.view.draw_walk(cx, scope, walk);
+        if step.is_done() && self.context_menu.is_open() {
+            let uid = self.widget_uid();
+            let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+            self.context_menu.draw(cx, uid, owner);
+        }
+        step
+    }
+}
+
+impl TabMenuRef {
+    /// Hang the menu of `titles` from the window point `at`, `current` ticked.
+    pub fn open(&self, cx: &mut Cx, at: DVec2, titles: &[String], current: usize) {
+        let Some(mut inner) = self.borrow_mut() else { return };
+        let inner = &mut *inner;
+        let rows = titles.iter().map(|title| ContextRow::new(title, true)).collect();
+        let owner = ContextMenuOwner { source: &inner.view.source, template: inner.popup_menu, area: inner.view.area() };
+        inner.context_menu.open_pull_down(cx, owner, at, Cx::time_now(), rows, Some(current));
+    }
+
+    pub fn offer(&self, cx: &mut Cx, event: &Event) -> ContextMenuEvent {
+        let Some(mut inner) = self.borrow_mut() else { return ContextMenuEvent::Ignored };
+        let inner = &mut *inner;
+        let owner = ContextMenuOwner { source: &inner.view.source, template: inner.popup_menu, area: inner.view.area() };
+        inner.context_menu.handle_event(cx, event, owner)
+    }
+}
