+    #[test]
+    fn a_macs_failed_save_is_one_alert_a_failure_and_try_again_that_fails_asks_again() {
+        use makepad_widgets::makepad_platform::storage::{StorageError, StorageOp};
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        cx.init_cx_os();
+        let root = cx.with_vm(|vm| {
+            makepad_widgets::script_mod(vm);
+            crate::script_mod(vm);
+            let value = script_eval!(vm,{use mod.widgets.* NotesView{reduced_motion:true}});
+            WidgetRef::script_from_value(vm, value)
+        });
+        let mut view = root.borrow_mut::<NotesView>().unwrap();
+        view.started = true;
+        view.pointer = true;
+        view.doc = seed::generate(1_788_955_200_000);
+        view.load = LoadState::Ready;
+        view.ui = engine::initial_ui(&view.doc);
+        view.refresh_projection();
+        view.set_storage(cx.storage("notes.test"));
+        view.save.current = view.doc.revision;
+        view.save.saved = view.doc.revision;
+        fn change(view: &mut NotesView, cx: &mut Cx) {
+            view.doc.revision += 1;
+            view.save_now(cx, false);
+        }
+        fn answer(view: &mut NotesView, cx: &mut Cx, ok: bool) {
+            let (id, _) = view.save.in_flight.expect("a save on its way");
+            let result = if ok { Ok(StorageResult::Unit) } else { Err(StorageError::Io("full".into())) };
+            view.on_storage(cx, &[StorageResponse {
+                request_id: StorageRequestId(id),
+                namespace: "notes.test".into(),
+                op: StorageOp::Set,
+                result,
+            }]);
+        }
+        change(&mut view, &mut cx);
+        answer(&mut view, &mut cx, false);
+        // An alert says so, not a band across the window's foot.
+        assert_eq!(view.sheet, Some(SheetKind::NotSaved));
+        // Try Again that fails asks again.
+        view.commit_sheet(&mut cx);
+        assert_eq!(view.sheet, None);
+        answer(&mut view, &mut cx, false);
+        assert_eq!(view.sheet, Some(SheetKind::NotSaved));
+        // Not Now: the window goes on, the next change saves, and a failure in
+        // the same spell isn't asked about twice.
+        view.cancel_sheet(&mut cx);
+        assert_eq!(view.sheet, None);
+        change(&mut view, &mut cx);
+        answer(&mut view, &mut cx, false);
+        assert_eq!(view.sheet, None);
+        // A save that lands ends the spell: the next failure asks again.
+        change(&mut view, &mut cx);
+        answer(&mut view, &mut cx, true);
+        assert!(view.save.error.is_none());
+        assert_eq!(view.save.saved, view.doc.revision);
+        change(&mut view, &mut cx);
+        answer(&mut view, &mut cx, false);
+        assert_eq!(view.sheet, Some(SheetKind::NotSaved));
+    }
 }
