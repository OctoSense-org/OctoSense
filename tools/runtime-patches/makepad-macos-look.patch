+        let room = self.view.area().rect(cx);
+        let right = room.pos.x + room.size.x - EDGE;
+        let x = (self.tip_at.x - 4.0).min(right - tag.size.x).max(room.pos.x + EDGE);
+        let tip = self.view.tooltip(cx, ids!(new_chat_tip));
