+pub fn delete_folder(doc: &mut NotesDocument, ui: &mut NotesUi, id: u32, now_ms: i64) -> Result<(), &'static str> {
+    if !doc.folders.iter().any(|f| f.id == id) {
+        return Err("folder not found");
+    }
+    let folder = FolderId::Custom(id);
+    for note in doc.notes.iter_mut().filter(|note| note.folder == folder) {
+        if note.deleted_ms.is_none() {
+            note.deleted_ms = Some(now_ms.max(note.created_ms));
+            note.pinned = false;
+        }
+        note.folder = FolderId::Notes;
+    }
+    doc.folders.retain(|f| f.id != id);
+    bump_revision(doc);
+    if ui.collection == Collection::Folder(folder) {
+        ui.collection = Collection::All;
+    }
+    normalize_after_filter(doc, ui);
