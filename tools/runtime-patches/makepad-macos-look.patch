+/// What is next due from today on, soonest first. A date that has passed with
+/// nothing posted moves on to its next occurrence, as the forecast counts it.
+pub fn coming_up(ledger: &Ledger, days: i32, today: Day) -> Vec<(Day, &Scheduled)> {
+    let horizon = today + days;
+    let mut out: Vec<(Day, &Scheduled)> = ledger
+        .scheduled
+        .iter()
+        .filter(|s| s.enabled)
+        .filter_map(|s| {
+            let mut due = s.next_due;
+            while due < today {
+                due = s.recurrence.next(due);
+            }
+            (due <= horizon).then_some((due, s))
+        })
+        .collect();
+    out.sort_by_key(|(due, _)| *due);
+    out
+}
