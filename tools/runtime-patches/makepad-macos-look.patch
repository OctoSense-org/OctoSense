+    /// The ellipsis is part of what must fit: a text never comes out wider
+    /// than the room, ends on its letters, and is left alone when it fits.
+    #[test]
+    fn a_cell_elides_to_what_fits_with_its_ellipsis() {
+        let fits = |room: usize| move |text: &str| text.chars().count() <= room;
+        assert_eq!(elide_to_fit("Vodafone", fits(8)), "Vodafone");
+        assert_eq!(elide_to_fit("Kinderopvang Zonnetje", fits(14)), "Kinderopvang…");
+        assert_eq!(elide_to_fit("Kinderopvang Zonnetje", fits(15)), "Kinderopvang Z…");
+        assert_eq!(elide_to_fit("Kinderopvang", fits(0)), "…");
+    }
 
