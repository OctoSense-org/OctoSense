+                log!("copy: {err}");
+            }
+        }
+    }
+
+    fn cut(&mut self) {
+        if let Some(browser) = self.active_browser() {
+            if let Err(err) = browser.cut() {
+                log!("cut: {err}");
+            }
+        }
+    }
+
+    fn select_all(&mut self) {
+        if let Some(browser) = self.active_browser() {
+            if let Err(err) = browser.select_all() {
+                log!("select all: {err}");
+            }
+        }
+    }
