+/// Set a bar's length. The meter shader takes the fraction directly, so
+/// there is nothing to measure and nothing to re-measure on a resize.
+fn set_bar(cx: &mut Cx, row: &WidgetRef, fraction: f64, color: Option<Vec4f>) {
+    row.meter(cx, ids!(bar_meter)).set(cx, fraction, color, -1.0);
+}
+
+fn plain() -> CellStyle {
+    CellStyle { bg: None, color: None, align: 0.0, bold: false, font_scale: 1.0 }
+}
+
+impl Finance {
+    fn dim(&self) -> CellStyle {
+        CellStyle { color: Some(self.roles.dim), ..plain() }
+    }
+
+    /// A quiet amount: right-aligned, and on a desktop's grid in the tabular
+    /// face, which is what `bold` picks there.
+    fn dim_amount(&self) -> CellStyle {
+        CellStyle { align: 1.0, bold: self.roles.desk, ..self.dim() }
+    }
+
+    /// A cell of a list on a desktop. Its colour's alpha tells `DeskLedger`'s
+    /// program which piece of the row it is: .90 between, .91 first, .92 last,
+    /// .93 the only column, .04 more when the row is selected.
+    fn row_piece(&self, style: CellStyle, display_col: usize, cols: usize, selected: bool) -> CellStyle {
+        let code = match (display_col == 0, display_col + 1 >= cols) {
+            (true, true) => 0.93,
+            (true, false) => 0.91,
+            (false, true) => 0.92,
+            (false, false) => 0.90,
+        } + if selected { 0.04 } else { 0.0 };
+        let tint = if selected { self.roles.accent_row } else { self.roles.line };
+        CellStyle {
+            bg: Some(Vec4f { w: code, ..tint }),
+            color: if selected { Some(self.roles.on_primary) } else { style.color },
+            ..style
+        }
+    }
+}
