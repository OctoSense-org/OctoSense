+        assert_eq!(script_string("plain"), "\"plain\"");
+        assert_eq!(script_string("say \"hi\"\\"), "\"say \\\"hi\\\"\\\\\"");
+        assert_eq!(script_string("a\nb"), "\"a\\u000ab\"");
+    }
