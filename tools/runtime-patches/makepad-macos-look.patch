+pub fn find(name: &str) -> Option<&'static City> {
+    CITIES.iter().find(|c| c.name == name)
+}
+
+/// Days from the civil date; `local_time::civil_from_days`'s inverse.
+fn days_from_civil(year: i32, month: u32, day: u32) -> i64 {
+    let y = if month <= 2 { year as i64 - 1 } else { year as i64 };
+    let era = if y >= 0 { y } else { y - 399 } / 400;
+    let yoe = y - era * 400;
+    let mp = (month as i64 + 9) % 12;
+    let doy = (153 * mp + 2) / 5 + day as i64 - 1;
+    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    era * 146_097 + doe - 719_468
+}
+
+/// 0 = Sunday, from a day number.
+fn weekday(days: i64) -> i64 {
+    (days + 4).rem_euclid(7)
+}
+
+fn nth_sunday(year: i32, month: u32, nth: u32) -> i64 {
+    let first = days_from_civil(year, month, 1);
+    first + (7 - weekday(first)) % 7 + 7 * (nth as i64 - 1)
+}
+
+fn last_sunday(year: i32, month: u32) -> i64 {
+    let next = if month == 12 { days_from_civil(year + 1, 1, 1) } else { days_from_civil(year, month + 1, 1) };
+    let last = next - 1;
+    last - weekday(last)
+}
+
+/// A day's clock hour on a clock `offset` minutes east of UTC, in epoch seconds.
+fn at(day: i64, hour: i64, offset: i32) -> i64 {
+    day * 86_400 + hour * 3_600 - offset as i64 * 60
+}
+
+impl City {
+    fn in_daylight(&self, epoch: i64) -> bool {
+        let year = LocalTime::utc(epoch + self.offset as i64 * 60).year;
+        let std = self.offset;
+        let dst = self.offset + 60;
+        match self.dst {
+            Dst::None => false,
+            Dst::NorthAmerica => {
+                at(nth_sunday(year, 3, 2), 2, std) <= epoch && epoch < at(nth_sunday(year, 11, 1), 2, dst)
+            }
+            Dst::Europe => at(last_sunday(year, 3), 1, 0) <= epoch && epoch < at(last_sunday(year, 10), 1, 0),
+            Dst::Australia => epoch < at(nth_sunday(year, 4, 1), 3, dst) || at(nth_sunday(year, 10, 1), 2, std) <= epoch,
+            Dst::NewZealand => epoch < at(nth_sunday(year, 4, 1), 3, dst) || at(last_sunday(year, 9), 2, std) <= epoch,
+        }
+    }
+
+    /// Minutes east of UTC at this moment.
+    pub fn offset_at(&self, epoch: i64) -> i32 {
+        self.offset + if self.in_daylight(epoch) { 60 } else { 0 }
+    }
+
+    /// Its clock at this moment.
+    pub fn time_at(&self, epoch: i64) -> LocalTime {
+        let mut there = LocalTime::utc(epoch + self.offset_at(epoch) as i64 * 60);
+        there.zoned = true;
+        there
+    }
+}
+
+/// The local zone's minutes east of UTC at this moment.
+pub fn local_offset(epoch: i64) -> i32 {
+    offset_of(LocalTime::from_epoch(epoch), epoch)
+}
+
+fn offset_of(here: LocalTime, epoch: i64) -> i32 {
+    let minutes = days_from_civil(here.year, here.month, here.day) * 1_440 + (here.hour * 60 + here.minute) as i64;
+    (minutes - epoch.div_euclid(60)) as i32
+}
+
+/// A Mac's line under a clock: "Today, +3HRS", "Tomorrow, +12:30HRS".
+pub fn relative_text(here: LocalTime, there: LocalTime, difference: i32) -> String {
+    let days = days_from_civil(there.year, there.month, there.day) - days_from_civil(here.year, here.month, here.day);
+    let day = match days {
+        0 => "Today",
+        d if d > 0 => "Tomorrow",
+        _ => "Yesterday",
+    };
+    let sign = if difference < 0 { '-' } else { '+' };
+    let (h, m) = (difference.abs() / 60, difference.abs() % 60);
+    if m == 0 {
+        format!("{day}, {sign}{h}HRS")
+    } else {
+        format!("{day}, {sign}{h}:{m:02}HRS")
+    }
+}
+
+/// The table's rows a query finds: names that begin with it first, then names
+/// and countries that hold it, each in the table's order. An empty query is
+/// the whole table.
+pub fn search(query: &str) -> Vec<&'static City> {
+    let query = query.trim().to_lowercase();
+    if query.is_empty() {
+        return CITIES.iter().collect();
+    }
+    let (mut first, mut then) = (Vec::new(), Vec::new());
+    for city in CITIES {
+        let name = city.name.to_lowercase();
+        if name.starts_with(&query) {
+            first.push(city);
+        } else if name.contains(&query) || city.country.to_lowercase().contains(&query) {
+            then.push(city);
+        }
+    }
+    first.extend(then);
+    first
+}
+
+/// The saved list: a line per city. A name this table no longer has is dropped.
+pub fn encode(cities: &[&'static City]) -> Vec<u8> {
+    cities.iter().map(|c| c.name).collect::<Vec<_>>().join("\n").into_bytes()
+}
+
+pub fn decode(bytes: &[u8]) -> Option<Vec<&'static City>> {
+    let text = std::str::from_utf8(bytes).ok()?;
+    let mut cities: Vec<&'static City> = Vec::new();
+    for name in text.lines() {
+        if let Some(city) = find(name) {
+            if !cities.contains(&city) && cities.len() < MAX_CITIES {
+                cities.push(city);
+            }
+        }
+    }
+    Some(cities)
+}
+
+pub fn default_cities() -> Vec<&'static City> {
+    DEFAULT_CITIES.iter().filter_map(|name| find(name)).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn epoch(year: i32, month: u32, day: u32, hour: i64, minute: i64) -> i64 {
+        days_from_civil(year, month, day) * 86_400 + hour * 3_600 + minute * 60
+    }
+
+    fn city_named(name: &str) -> &'static City {
+        find(name).unwrap()
+    }
+
+    #[test]
+    fn the_table_has_no_repeat_and_holds_the_defaults() {
+        for (index, city) in CITIES.iter().enumerate() {
+            assert!(CITIES[index + 1..].iter().all(|other| other.name != city.name), "{}", city.name);
+        }
+        for name in DEFAULT_CITIES {
+            assert!(find(name).is_some(), "{name}");
+        }
+        for city in CITIES {
+            assert!(city.offset.abs() <= 14 * 60, "{}", city.name);
+        }
+    }
+
+    #[test]
+    fn north_america_changes_on_its_two_sundays_at_two_on_the_clock() {
+        let ny = city_named("New York");
+        // 2026: 8 March and 1 November. 02:00 EST is 07:00 UTC; 02:00 EDT is 06:00 UTC.
+        assert_eq!(ny.offset_at(epoch(2026, 3, 8, 6, 59)), -300);
+        assert_eq!(ny.offset_at(epoch(2026, 3, 8, 7, 0)), -240);
+        assert_eq!(ny.offset_at(epoch(2026, 11, 1, 5, 59)), -240);
+        assert_eq!(ny.offset_at(epoch(2026, 11, 1, 6, 0)), -300);
+        // 2027: 14 March and 7 November.
+        assert_eq!(ny.offset_at(epoch(2027, 3, 14, 6, 59)), -300);
+        assert_eq!(ny.offset_at(epoch(2027, 3, 14, 7, 0)), -240);
+        assert_eq!(ny.offset_at(epoch(2027, 11, 7, 6, 0)), -300);
+        // Los Angeles on its own clock: 02:00 PST is 10:00 UTC.
+        let la = city_named("Los Angeles");
+        assert_eq!(la.offset_at(epoch(2026, 3, 8, 9, 59)), -480);
+        assert_eq!(la.offset_at(epoch(2026, 3, 8, 10, 0)), -420);
+    }
+
+    #[test]
+    fn europe_changes_at_one_utc_on_the_last_sundays() {
+        let london = city_named("London");
+        let paris = city_named("Paris");
+        // 2026: 29 March and 25 October.
+        assert_eq!(london.offset_at(epoch(2026, 3, 29, 0, 59)), 0);
+        assert_eq!(london.offset_at(epoch(2026, 3, 29, 1, 0)), 60);
+        assert_eq!(paris.offset_at(epoch(2026, 3, 29, 1, 0)), 120);
+        assert_eq!(paris.offset_at(epoch(2026, 10, 25, 0, 59)), 120);
+        assert_eq!(paris.offset_at(epoch(2026, 10, 25, 1, 0)), 60);
+    }
+
+    #[test]
+    fn the_south_keeps_daylight_across_new_year() {
+        let sydney = city_named("Sydney");
+        assert_eq!(sydney.offset_at(epoch(2026, 1, 15, 0, 0)), 660);
+        assert_eq!(sydney.offset_at(epoch(2026, 7, 15, 0, 0)), 600);
+        // 2026: ends 5 April 03:00 AEDT (16:00 UTC on the 4th); starts 4 October 02:00 AEST (16:00 UTC on the 3rd).
+        assert_eq!(sydney.offset_at(epoch(2026, 4, 4, 15, 59)), 660);
+        assert_eq!(sydney.offset_at(epoch(2026, 4, 4, 16, 0)), 600);
+        assert_eq!(sydney.offset_at(epoch(2026, 10, 3, 15, 59)), 600);
+        assert_eq!(sydney.offset_at(epoch(2026, 10, 3, 16, 0)), 660);
+        let auckland = city_named("Auckland");
+        // 2026: ends 5 April 03:00 NZDT (14:00 UTC on the 4th); starts 27 September 02:00 NZST (14:00 UTC on the 26th).
+        assert_eq!(auckland.offset_at(epoch(2026, 4, 4, 13, 59)), 780);
+        assert_eq!(auckland.offset_at(epoch(2026, 4, 4, 14, 0)), 720);
+        assert_eq!(auckland.offset_at(epoch(2026, 9, 26, 13, 59)), 720);
+        assert_eq!(auckland.offset_at(epoch(2026, 9, 26, 14, 0)), 780);
+    }
+
+    #[test]
+    fn places_without_a_rule_keep_their_offset_and_half_hours_work() {
+        for (name, offset) in [("Tokyo", 540), ("Mumbai", 330), ("Kathmandu", 345), ("Phoenix", -420), ("Reykjavik", 0)] {
+            for month in 1..=12 {
+                assert_eq!(city_named(name).offset_at(epoch(2026, month, 15, 12, 0)), offset, "{name}");
+            }
+        }
+        let there = city_named("Mumbai").time_at(epoch(2026, 6, 1, 20, 0));
+        assert_eq!((there.day, there.hour, there.minute, there.zoned), (2, 1, 30, true));
+    }
+
+    #[test]
+    fn the_line_says_which_day_and_how_far() {
+        let here = LocalTime { year: 2026, month: 11, day: 4, hour: 10, ..Default::default() };
+        let same = LocalTime { year: 2026, month: 11, day: 4, hour: 13, ..Default::default() };
+        assert_eq!(relative_text(here, same, 180), "Today, +3HRS");
+        assert_eq!(relative_text(here, here, 0), "Today, +0HRS");
+        let next = LocalTime { year: 2026, month: 11, day: 5, hour: 1, ..Default::default() };
+        assert_eq!(relative_text(here, next, 930), "Tomorrow, +15:30HRS");
+        let prev = LocalTime { year: 2026, month: 11, day: 3, hour: 23, ..Default::default() };
+        assert_eq!(relative_text(here, prev, -660), "Yesterday, -11HRS");
+        // Across a month's end.
+        let end = LocalTime { year: 2026, month: 10, day: 31, hour: 23, ..Default::default() };
+        let start = LocalTime { year: 2026, month: 11, day: 1, hour: 1, ..Default::default() };
+        assert_eq!(relative_text(end, start, 120), "Tomorrow, +2HRS");
+    }
+
+    #[test]
+    fn the_local_offset_reads_off_the_broken_down_time() {
+        let epoch = epoch(2026, 11, 4, 12, 30);
+        let tokyo_like = LocalTime { year: 2026, month: 11, day: 4, hour: 21, minute: 30, ..Default::default() };
+        assert_eq!(offset_of(tokyo_like, epoch), 540);
+        let pacific = LocalTime { year: 2026, month: 11, day: 4, hour: 4, minute: 30, ..Default::default() };
+        assert_eq!(offset_of(pacific, epoch), -480);
+        let across_midnight = LocalTime { year: 2026, month: 11, day: 3, hour: 23, minute: 30, ..Default::default() };
+        assert_eq!(offset_of(across_midnight, epoch), -780);
+    }
+
+    #[test]
+    fn a_search_finds_names_first_then_what_holds_it() {
+        let names = |q: &str| search(q).iter().map(|c| c.name).collect::<Vec<_>>();
+        assert_eq!(names("tok"), ["Tokyo"]);
+        assert_eq!(names("  PARIS "), ["Paris"]);
+        assert_eq!(names("Lon"), ["London", "Barcelona"]);
+        assert!(names("nowhere at all").is_empty());
+        // A country finds its cities, after any name that begins with it.
+        let japan = names("japan");
+        assert!(japan.contains(&"Tokyo") && japan.contains(&"Osaka"));
+        let san = names("san");
+        assert_eq!(san[0], "San Diego");
+        assert_eq!(search("").len(), CITIES.len());
+    }
+
+    #[test]
+    fn the_saved_list_keeps_its_order_and_drops_what_it_does_not_know() {
+        let list = vec![city_named("Tokyo"), city_named("Berlin")];
+        assert_eq!(decode(&encode(&list)).unwrap(), list);
+        assert_eq!(decode(b"Tokyo\nAtlantis\nTokyo\nBerlin").unwrap(), list);
+        assert!(decode(&[0xff, 0xfe]).is_none());
+        assert_eq!(default_cities().len(), DEFAULT_CITIES.len());
+    }
+}
