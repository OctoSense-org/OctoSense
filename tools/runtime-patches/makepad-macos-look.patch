+/// What a person may do with a file, from its `rwxr-xr-x` letters: the words
+/// Get Info uses. Anything else (another system's word) is passed through as
+/// "Read & Write", which is what a listing that could not say means.
+pub fn access_words(permissions: &str) -> &'static str {
+    let owner: Vec<char> = permissions.chars().take(3).collect();
+    match owner.as_slice() {
+        ['r', 'w', _] => "Read & Write",
+        ['r', '-', _] => "Read Only",
+        ['-', 'w', _] => "Write Only",
+        ['-', '-', _] => "No Access",
+        _ => "Read & Write",
+    }
+}
