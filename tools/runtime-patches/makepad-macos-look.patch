+                && last.before == before
+                && rect.pos.x >= outer.pos.x
+                && rect.pos.y >= outer.pos.y
+                && rect.pos.x + rect.size.x <= outer.pos.x + outer.size.x
+                && rect.pos.y + rect.size.y <= outer.pos.y + outer.size.y
