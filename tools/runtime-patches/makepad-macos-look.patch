+                apply(&mut doc, Command::CreateList { name: name.into(), colour: ListColour::Red }, now),
+                Err(CommandError::Rejected(_))
+            ), "{name}");
+        }
+        apply(&mut doc, Command::UpdateList { id: trip.id, name: "Trip".into(), colour: ListColour::Red }, now).unwrap();
+        assert_eq!(doc.list(trip.id).unwrap().colour, ListColour::Red);
+        assert_eq!(
+            apply(&mut doc, Command::UpdateList { id: trip.id, name: "Trip".into(), colour: ListColour::Red }, now),
+            Err(CommandError::NoOp)
+        );
+        // This one goes, with what is in it.
+        apply(&mut doc, Command::DeleteList { id: trip.id }, now).unwrap();
+        assert!(doc.list(trip.id).is_none());
+        assert!(doc.reminders.is_empty());
+        // A starter list can go too, as on a Mac: a smart list's new reminders
+        // then go to the first list there is, and the last list stays.
+        let mut spare = doc.clone();
+        apply(&mut spare, Command::DeleteList { id: HOME_LIST_ID }, now).unwrap();
+        assert!(spare.list(HOME_LIST_ID).is_none());
+        assert_eq!(fit_defaults(&spare, home_create_defaults()).list_id, GROCERIES_LIST_ID);
+        assert_eq!(fit_defaults(&doc, home_create_defaults()).list_id, HOME_LIST_ID);
+        for id in [GROCERIES_LIST_ID, WORK_LIST_ID] {
+            apply(&mut spare, Command::DeleteList { id }, now).unwrap();
+        }
+        assert_eq!(fit_defaults(&spare, home_create_defaults()).list_id, TRAVEL_LIST_ID);
+        assert!(matches!(
+            apply(&mut spare, Command::DeleteList { id: TRAVEL_LIST_ID }, now),
+            Err(CommandError::Rejected(_))
+        ));
+        // A list made then never takes a starter list's id.
+        let mut bare = doc.clone();
+        apply(&mut bare, Command::DeleteList { id: TRAVEL_LIST_ID }, now).unwrap();
+        apply(&mut bare, Command::CreateList { name: "Trips".into(), colour: ListColour::Pink }, now).unwrap();
+        assert!(bare.lists.last().unwrap().id > TRAVEL_LIST_ID);
+        // A limit is a limit.
+        for index in 0..MAX_LISTS - 4 {
+            apply(&mut doc, Command::CreateList { name: format!("List {index}"), colour: ListColour::Blue }, now).unwrap();
+        }
+        assert!(matches!(
+            apply(&mut doc, Command::CreateList { name: "One more".into(), colour: ListColour::Blue }, now),
+            Err(CommandError::Rejected(_))
+        ));
+    }
 }
