+    /// Back and Forward say whether they can; Reload is Stop while loading;
+    /// one tab has no row of tabs; the app's own pages cover what the engine
+    /// has when they have something to say.
+    fn refresh_desk_chrome(&mut self, cx: &mut Cx, tab_count: usize, info: &webview::ActiveInfo) {
+        self.ui.widget(cx, ids!(tab_row)).set_visible(cx, tab_count >= 2);
+        // Back from Bookmarks or History is the page they're over.
+        let over = self.places_open.is_some();
+        self.set_tool(cx, ids!(back_btn), info.can_go_back || over);
+        self.set_tool(cx, ids!(forward_btn), info.can_go_forward);
+        let start = theme::is_new_tab_url(&info.url);
+        self.ui.widget(cx, ids!(reload_btn)).set_visible(cx, !info.loading);
+        // The Start Page has nothing to reload, nor has a list of pages.
+        self.set_tool(cx, ids!(reload_btn), !start && !over);
+        self.ui.widget(cx, ids!(stop_btn)).set_visible(cx, info.loading);
+        self.check_load(cx, info);
+        self.follow_load_line(cx, info.loading && !start);
+        let engine_error = self
+            .with_webview(cx, |_cx, wv| wv.engine_error().map(str::to_string))
+            .flatten();
+        let check = info.id.and_then(|id| self.load_checks.get(&id)).cloned().unwrap_or_default();
+        let failure = if engine_error.is_some() {
+            Some((
+                "Browser Couldn\u{2019}t Start".to_string(),
+                "Something kept web pages from opening. Try again, or close this window and open Browser once more.".to_string(),
+            ))
+        } else {
+            check.failed.clone()
+        };
+        let covered = failure.is_some() || check.waiting;
+        if self.shown_failed != failure.is_some() {
+            self.shown_failed = failure.is_some();
+            self.sync_field(cx);
+        }
+        self.ui.widget(cx, ids!(start_page)).set_visible(cx, start && !covered && !over);
+        self.ui.widget(cx, ids!(fail_page)).set_visible(cx, covered && !over);
+        self.ui.widget(cx, ids!(fail_box)).set_visible(cx, failure.is_some());
+        if let Some((title, note)) = failure {
+            self.ui.label(cx, ids!(fail_title)).set_text(cx, &title);
+            self.ui.label(cx, ids!(fail_note)).set_text(cx, &note);
+        }
+        let sheet = self.sheet.is_some();
+        self.with_webview(cx, |_cx, wv| wv.set_covered(start || covered || over || sheet));
+    }
