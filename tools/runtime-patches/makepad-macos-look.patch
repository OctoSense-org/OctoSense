+#[test]
+fn a_macs_failed_save_is_an_alert_asked_once_a_failure_and_the_window_goes_on() {
+    let (mut cx, root) = root();
+    let mut view = root.borrow_mut::<RemindersView>().unwrap();
+    view.pointer = true;
+    view.set_storage(cx.storage("reminders.test"));
+    view.mutate(&mut cx, Command::SetFlagged { id: 1, flagged: true });
+    fail(&mut view, &mut cx);
+    // An alert says so, not a strip across the window's foot.
+    assert_eq!(view.list_sheet, Some(ListSheet::NotSaved));
+    assert!(!view.view.view(&mut cx, ids!(save_strip)).visible());
+    // What is changed under it stays in the window.
+    assert!(view.mutate(&mut cx, Command::SetFlagged { id: 2, flagged: true }));
+    assert!(view.set_id.is_none());
+    // Not Now: the window as it was. The next change saves again, and a
+    // failure in the same spell isn't asked about twice.
+    view.cancel_list_sheet(&mut cx);
+    assert_eq!(view.list_sheet, None);
+    assert!(view.mutate(&mut cx, Command::SetFlagged { id: 3, flagged: true }));
+    fail(&mut view, &mut cx);
+    assert_eq!(view.list_sheet, None);
+    // A save that lands ends the spell: the next failure asks again.
+    assert!(view.mutate(&mut cx, Command::SetFlagged { id: 1, flagged: false }));
+    ack(&mut view, &mut cx);
+    assert!(view.machine.error.is_none());
+    assert!(view.mutate(&mut cx, Command::SetFlagged { id: 2, flagged: false }));
+    fail(&mut view, &mut cx);
+    assert_eq!(view.list_sheet, Some(ListSheet::NotSaved));
+    // Try Again (Return) that fails asks again; one that lands closes it.
+    let enter = KeyEvent { key_code: KeyCode::ReturnKey, ..Default::default() };
+    assert!(view.mac_key(&mut cx, &enter));
+    assert_eq!(view.list_sheet, None);
+    fail(&mut view, &mut cx);
+    assert_eq!(view.list_sheet, Some(ListSheet::NotSaved));
+    view.commit_list_sheet(&mut cx);
+    ack(&mut view, &mut cx);
+    assert_eq!(view.list_sheet, None);
+    assert!(view.machine.error.is_none());
+    assert_eq!(view.machine.saved_revision, view.document.as_ref().unwrap().revision);
+}
