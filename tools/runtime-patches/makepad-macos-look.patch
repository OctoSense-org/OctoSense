+/// How bright a colour is to the eye (relative luminance, 0..1).
+fn luminance(c: Vec4f) -> f32 {
+    let linear = |v: f32| if v <= 0.03928 { v / 12.92 } else { ((v + 0.055) / 1.055).powf(2.4) };
+    0.2126 * linear(c.x) + 0.7152 * linear(c.y) + 0.0722 * linear(c.z)
+}
+
+/// Between these luminances neither black nor white reads at 4.5:1 once a tile's
+/// own shading is counted.
+const MID_TONES: (f32, f32) = (0.10, 0.25);
+
+/// A tile inside the mid-tones moved to their nearer edge.
+fn clear_of_mid_tones(face: Vec4f) -> Vec4f {
+    let (low, high) = MID_TONES;
+    let now = luminance(face);
+    if now <= low || now >= high {
+        return face;
+    }
+    let to = if now - low < high - now { low } else { high };
+    let k = (to / now).powf(1.0 / 2.2);
+    Vec4f { x: (face.x * k).min(1.0), y: (face.y * k).min(1.0), z: (face.z * k).min(1.0), w: face.w }
+}
+
+/// What reads on a tile: black on a light one, white on a dark one.
+fn ink_on(face: Vec4f) -> Vec4f {
+    let (low, high) = MID_TONES;
+    let level = if luminance(face) > (low + high) * 0.5 { 0.05 } else { 1.0 };
+    Vec4f { x: level, y: level, z: level, w: 1.0 }
+}
+
