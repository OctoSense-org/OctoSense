+            if let Err(err) = browser.set_url(&url) {
+                log!("page menu: {err}");
+            }
+        }
+    }
+
+    fn heard_page_menu(&mut self, cx: &mut Cx, answer: &str) {
+        let (Some(asked), Some(answer)) = (self.menu_asked, PageMenuAnswer::parse(answer)) else {
+            return;
+        };
+        if answer.serial != asked.serial {
+            return;
+        }
+        self.menu_asked = None;
+        cx.stop_timer(self.menu_timer);
+        // The page has its own menu here, and has just shown it.
+        if answer.free {
+            self.open_page_menu(cx, asked, answer.selected, answer.link);
+        }
+    }
