+/// The most a file the person chose may hold when a host reads or writes it for a
+/// hosted child ([`ChosenFileAction`]): 64 MiB.
+pub const CHOSEN_FILE_MAX_BYTES: u64 = 64 * 1024 * 1024;
+
+/// What became of `Cx::read_chosen_file` or `Cx::write_chosen_file`, delivered as a
+/// plain action with the id it was asked with.
+#[derive(Clone, Debug, PartialEq, Eq, Default)]
+pub enum ChosenFileAction {
+    /// Done: the file's bytes for a read, nothing for a write.
+    Done { id: LiveId, data: Vec<u8> },
+    /// Refused or failed: why, in a person's words.
+    Failed { id: LiveId, error: String },
+    #[default]
+    None,
+}
+
+/// A chosen file read or replaced by the app itself: a process nobody hosts reaches
+/// the file the person chose in its own panel.
+pub(crate) fn chosen_file_locally(id: LiveId, path: &std::path::Path, data: Option<Vec<u8>>) -> ChosenFileAction {
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = (path, data);
+        ChosenFileAction::Failed { id, error: "Files aren\u{2019}t available here.".into() }
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let result = match data {
+            Some(bytes) if bytes.len() as u64 > CHOSEN_FILE_MAX_BYTES => Err("The document is larger than 64 MB.".to_string()),
+            Some(bytes) => write_selected_file(path, &bytes).map(|_| Vec::new()),
+            None => (|| {
+                use std::io::Read;
+                let meta = std::fs::metadata(path).map_err(|_| "The file is no longer there.")?;
+                if !meta.is_file() {
+                    return Err("This isn\u{2019}t a file.");
+                }
+                if meta.len() > CHOSEN_FILE_MAX_BYTES {
+                    return Err("The file is larger than 64 MB.");
+                }
+                let mut bytes = Vec::new();
+                let file = std::fs::File::open(path).map_err(|_| "The file can\u{2019}t be read.")?;
+                file.take(CHOSEN_FILE_MAX_BYTES + 1).read_to_end(&mut bytes).map_err(|_| "The file can\u{2019}t be read.")?;
+                if bytes.len() as u64 > CHOSEN_FILE_MAX_BYTES {
+                    return Err("The file is larger than 64 MB.");
+                }
+                Ok(bytes)
+            })()
+            .map_err(str::to_string),
+        };
+        match result {
+            Ok(data) => ChosenFileAction::Done { id, data },
+            Err(error) => ChosenFileAction::Failed { id, error },
+        }
+    }
+}
