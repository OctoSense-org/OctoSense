+
+    /// A right press on the page: the engine draws no menu of its own without a
+    /// window, so the page is asked what's there and the app's opens on the answer.
+    fn ask_page_menu(&mut self, cx: &mut Cx, abs: Vec2d, time: f64) {
+        let Some((x, y)) = self.cef_position(cx, abs) else {
+            return;
+        };
