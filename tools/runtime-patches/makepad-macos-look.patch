+                glyph: EmptyGlyph::Search,
+                title: format!("No Results for “{needle}”"),
+                note: "Check the spelling or try another word.".to_string(),
+                action: EmptyAction::ClearSearch,
+            });
+        }
+        self.empty_state.clone()
+    }
