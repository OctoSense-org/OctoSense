+/// The desktop tree's root: a View, of a type of its own. A process app first
+/// builds the touch tree on the stock sheet and then receives the shell's; a
+/// new type makes that build this tree fresh instead of applying it over the
+/// touch one, whose paddings and spacings it does not restate would survive.
+#[derive(Script, ScriptHook, Widget)]
+pub struct FinanceDeskRoot {
+    #[deref]
+    view: View,
+}
+
+impl Widget for FinanceDeskRoot {
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        self.view.draw_walk(cx, scope, walk)
+    }
+
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.view.handle_event(cx, event, scope);
+    }
+}
+
+/// Which sheet a desktop's window is showing.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Sheet {
+    Transaction,
+    Confirm,
+    Assign,
+    Files,
+}
+
+/// What the transaction sheet has open.
+#[derive(Default)]
+struct TxnForm {
+    /// The row being edited; `None` for a new one.
+    editing: Option<Id>,
+    /// Why only its words can change, if that is so.
+    locked: bool,
+    /// What the pop-ups' rows stand for.
+    accounts: Vec<Id>,
+    categories: Vec<Option<Id>>,
+    /// Which of the category menu's rows are a group's heading, and which row
+    /// is chosen: a press on a heading leaves the choice where it was.
+    headings: Vec<bool>,
+    category_at: usize,
+    /// The date, as the field last read it or the calendar chose it.
+    date: Day,
+    /// False while the field holds what can't be read as a date.
+    date_readable: bool,
+    /// The calendar: open or not, its month, and the day its first cell shows.
+    calendar_open: bool,
+    calendar_month: MonthKey,
+    calendar_start: Day,
+}
+
+/// How the last statement went, for the Import page.
+enum ImportOutcome {
+    Done { title: String, note: String },
+    Failed { title: String, note: String },
+}
+
+/// A process the shell hosts has no system file dialog: the host's platform
+/// operations do not carry one.
+fn hosted() -> bool {
+    std::env::var_os("STUDIO_HOST").is_some()
+}
+
+/// A number with its thousands marked, for counts.
+fn count_text(count: usize) -> String {
+    format_minor(count as i64, Currency { code: "", symbol: "", decimals: 0, symbol_first: true })
+}
