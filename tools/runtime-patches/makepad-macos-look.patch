diff --git a/apps/aichat/src/plain.rs b/apps/aichat/src/plain.rs
new file mode 100644
index 0000000000000000000000000000000000000000..616ab49289875fd37494df3ba8fdecd8e2481fc4
--- /dev/null
+++ b/apps/aichat/src/plain.rs
@@ -0,0 +1,721 @@
+//! What the engine says, in a person's words. A desktop's panel draws these;
+//! the engine's own text stays in `/ai/transcript` and on a phone. Nothing here
+//! has a side effect, so every line can be tested.
+
+use makepad_ai_services::state::{EngineState, Entry, Status, ToolEntry, ToolStatus};
+use makepad_ai_services::wire::ToolOutcome;
+use makepad_widgets::makepad_micro_serde::{DeJson, JsonValue};
+
+/// What a failed answer asks of the person next.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum NextStep {
+    TryAgain,
+    NewChat,
+    /// Nothing can answer until a model is there: what adds one comes first.
+    AddModel,
+}
+
+/// A line of the engine's that is a failure: a title, what to do, and a button.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Failure {
+    pub title: String,
+    pub note: String,
+    pub next: NextStep,
+}
+
+/// One of the engine's own lines.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Said {
+    Line(String),
+    Failure(Failure),
+}
+
+/// Which model answers, under the toolbar's title. With none found yet the
+/// line has nothing to say: asking is what looks for one.
+pub fn model_line(label: &str) -> String {
+    let Some(rest) = label.strip_prefix("Local") else {
+        return label.to_string();
+    };
+    let rest = rest.trim_start_matches([' ', '\u{00b7}']);
+    if rest.is_empty() {
+        return String::new();
+    }
+    if let Some((name, _)) = rest.split_once(" on ") {
+        return format!("{name} on your network");
+    }
+    let name = rest.trim_end_matches("in-process").trim_end_matches([' ', '\u{00b7}']);
+    format!("{name} on this computer")
+}
+
+/// What the model is doing, above the field; nothing when it is doing nothing.
+pub fn status_text(state: &EngineState) -> String {
+    match &state.status {
+        Status::Idle | Status::Error(_) => String::new(),
+        Status::Loading { phase, fraction } => {
+            if phase.contains("fleet") || phase.contains("listening") {
+                "Looking for a model\u{2026}".to_string()
+            } else {
+                format!("Loading the model\u{2026} {:.0}%", fraction * 100.0)
+            }
+        }
+        Status::Thinking => "Thinking\u{2026}".to_string(),
+        Status::Streaming => "Writing\u{2026}".to_string(),
+        Status::WaitingForTool => match waiting_on_person(state) {
+            Some(PersonWait::Here) => "Waiting for your answer\u{2026}".to_string(),
+            Some(PersonWait::InApp) => "Waiting for you in the app\u{2026}".to_string(),
+            None => "Waiting for the app\u{2026}".to_string(),
+        },
+    }
+}
+
+/// A call that only the person can move on.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum PersonWait {
+    /// The card in this conversation.
+    Here,
+    /// The app's own sheet.
+    InApp,
+}
+
+fn waiting_on_person(state: &EngineState) -> Option<PersonWait> {
+    state.entries.iter().rev().find_map(|entry| match entry {
+        Entry::Tool(tool) => match &tool.status {
+            ToolStatus::Confirm => Some(PersonWait::Here),
+            ToolStatus::Running { note, .. } if note.starts_with("waiting for the person") => Some(PersonWait::InApp),
+            _ => None,
+        },
+        _ => None,
+    })
+}
+
+/// What an empty conversation invites, naming the apps the assistant can reach.
+pub fn invitation(labels: &[String]) -> String {
+    match labels {
+        [] => "Ask a question.".to_string(),
+        [one] => format!("Ask a question, or tell it what to do in {one}."),
+        [rest @ .., last] => format!("Ask a question, or tell it what to do in {} and {last}.", rest.join(", ")),
+    }
+}
+
+/// One of `Entry::System`'s lines.
+pub fn said(text: &str) -> Said {
+    // What `/help` answers: how AI is used, in words. The engine's list is of
+    // tool ids, which are a developer's: a person never sees one.
+    if let Some(names) = text.strip_prefix("tools: ") {
+        let apps = names.split(", ").any(|name| !name.starts_with("bus.") && !name.starts_with("gen."));
+        return Said::Line(help_line(apps));
+    }
+    if text.starts_with("no tools") {
+        return Said::Line(help_line(false));
+    }
+    if let Some(label) = text.strip_prefix("now answering with ") {
+        return Said::Line(format!("Now answering with {}.", model_line(label)));
+    }
+    if text.starts_with("the tools changed") {
+        return Said::Line("The apps changed, so this conversation started over.".to_string());
+    }
+    if text.starts_with("the conversation was reset") {
+        return Said::Line("The app started this conversation over.".to_string());
+    }
+    Said::Failure(failure(text))
+}
+
+/// How AI is used, as `/help` says it: in words, and in an app when one is open.
+fn help_line(apps: bool) -> String {
+    if apps {
+        "Ask a question in your own words, or ask AI to do something in an app that\u{2019}s open.".to_string()
+    } else {
+        "Ask a question in your own words.".to_string()
+    }
+}
+
+/// A model's failure. The engine's words name folders and network details: they
+/// stay out of the window.
+fn failure(text: &str) -> Failure {
+    if text.starts_with("no model is answering") {
+        // Not a failure of the person's: what AI needs, and where it goes.
+        Failure {
+            title: "AI Needs a Model".to_string(),
+            note: "AI answers with a model on this computer or on another computer on your network, and it hasn\u{2019}t found one. Put a model file in the Models folder, then try again.".to_string(),
+            next: NextStep::AddModel,
+        }
+    } else if text.contains("context window is full") {
+        Failure {
+            title: "This Conversation Is Too Long".to_string(),
+            note: "Start a new chat to keep going.".to_string(),
+            next: NextStep::NewChat,
+        }
+    } else {
+        Failure {
+            title: "AI Couldn\u{2019}t Answer".to_string(),
+            note: "Something went wrong while it was answering.".to_string(),
+            next: NextStep::TryAgain,
+        }
+    }
+}
+
+/// The conversation's last answer, while nothing has been asked since: the one
+/// Try Again can ask for again.
+pub fn last_answer(state: &EngineState) -> Option<usize> {
+    for (index, entry) in state.entries.iter().enumerate().rev() {
+        match entry {
+            Entry::User { .. } => return None,
+            Entry::Assistant { text, .. } if !text.trim().is_empty() => return Some(index),
+            _ => {}
+        }
+    }
+    None
+}
+
+/// A whole conversation as text, for Copy Conversation: who said each line,
+/// and none of what a Try Again replaced or a failure said again.
+pub fn conversation_words(state: &EngineState, gone: &[usize]) -> String {
+    let mut parts = Vec::new();
+    for (index, entry) in state.entries.iter().enumerate() {
+        if gone.contains(&index) || repeated_failure(state, index) {
+            continue;
+        }
+        let words = words_of(entry);
+        if words.is_empty() {
+            continue;
+        }
+        parts.push(match entry {
+            Entry::User { .. } => format!("You: {words}"),
+            Entry::Assistant { .. } => format!("AI: {words}"),
+            _ => words,
+        });
+    }
+    parts.join("\n\n")
+}
+
+/// `list_dir` as a person would say it: `List Dir`.
+fn tool_words(tool: &str) -> String {
+    tool.split('_')
+        .filter(|word| !word.is_empty())
+        .map(|word| {
+            let mut chars = word.chars();
+            match chars.next() {
+                Some(first) => first.to_uppercase().chain(chars).collect::<String>(),
+                None => String::new(),
+            }
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
+/// A tool line's title: what it did and where, as a person would say it. What
+/// it did it to comes from the arguments that name something, never the rest.
+/// `Find \u{201c}Lisbon\u{201d} in Notes`
+pub fn tool_title(tool: &ToolEntry) -> String {
+    let words = tool_words(&tool.tool);
+    let Some(app) = app_of(tool) else { return words };
+    // A service named for what it does says it in one go.
+    if tool.service == "gen" {
+        return format!("{app} {words}");
+    }
+    match target_of(&tool.args) {
+        Some(target) => format!("{words} \u{201c}{target}\u{201d} in {app}"),
+        None => format!("{words} in {app}"),
+    }
+}
+
+/// How much of its work a running call has done, when it really knows: the
+/// engine's wait for an app to connect has a number but no such knowledge, and
+/// a call that hasn't said has only its spinner.
+pub fn tool_share(tool: &ToolEntry) -> Option<f64> {
+    match &tool.status {
+        ToolStatus::Running { note, permille } if *permille > 0 && !note.trim_start().starts_with("waiting for") => {
+            Some((*permille as f64 / 1000.0).min(1.0))
+        }
+        _ => None,
+    }
+}
+
+/// The words of a call that takes something away. Finder's rule follows from
+/// them: such a button is never the default.
+const REMOVING: &[&str] = &["delete", "remove", "erase", "trash", "clear", "drop", "wipe", "purge", "destroy", "uninstall", "discard"];
+
+/// This call takes something away, as far as its name says.
+pub fn takes_away(tool: &ToolEntry) -> bool {
+    tool.tool.split('_').any(|word| REMOVING.contains(&word.to_ascii_lowercase().as_str()))
+}
+
+/// The arguments that name what a call works on, most telling first.
+const NAMING: &[&str] = &["title", "name", "subject", "filename", "file", "path", "to", "recipient", "query", "id"];
+
+/// What a call works on, in the words of its arguments: a file by its name, and
+/// a long value cut. `None` when they name nothing a person could recognise.
+fn target_of(args: &str) -> Option<String> {
+    let JsonValue::Object(fields) = JsonValue::deserialize_json(args).ok()? else { return None };
+    let value = NAMING.iter().find_map(|key| match fields.get(*key) {
+        Some(JsonValue::String(text)) if !text.trim().is_empty() => Some(text.trim().to_string()),
+        _ => None,
+    })?;
+    let last = value.trim_end_matches('/').rsplit('/').next().unwrap_or(&value).trim().to_string();
+    if last.is_empty() || last.contains('{') || last.contains('`') {
+        return None;
+    }
+    const MOST: usize = 60;
+    if last.chars().count() > MOST {
+        let kept: String = last.chars().take(MOST).collect();
+        return Some(format!("{}\u{2026}", kept.trim_end()));
+    }
+    Some(last)
+}
+
+fn app_of(tool: &ToolEntry) -> Option<&str> {
+    let label = tool.service_label.trim();
+    (!label.is_empty() && label != "?").then_some(label)
+}
+
+/// A confirm's question: what it does, to what, and where, as far as the call
+/// says. `Delete “Old packing list” in Notes?`
+pub fn confirm_question(tool: &ToolEntry) -> String {
+    let words = tool_words(&tool.tool);
+    match (target_of(&tool.args), app_of(tool)) {
+        (Some(target), Some(app)) => format!("{words} \u{201c}{target}\u{201d} in {app}?"),
+        (Some(target), None) => format!("{words} \u{201c}{target}\u{201d}?"),
+        (None, Some(app)) => format!("{words} in {app}?"),
+        (None, None) => format!("{words}?"),
+    }
+}
+
+/// What saying yes does, under the question.
+pub fn confirm_note(tool: &ToolEntry) -> String {
+    match (takes_away(tool), app_of(tool)) {
+        (true, Some(app)) => format!("It will be removed from {app}."),
+        (true, None) => "It will be removed.".to_string(),
+        (false, Some(app)) => format!("This changes something in {app}, outside this chat."),
+        (false, None) => "This changes something outside this chat.".to_string(),
+    }
+}
+
+/// The button that goes ahead with a call that takes something away.
+pub fn confirm_verb(tool: &ToolEntry) -> String {
+    tool_words(&tool.tool)
+}
+
+/// The outcome of a call that came back with nothing to say.
+fn outcome_word(outcome: ToolOutcome) -> &'static str {
+    match outcome {
+        ToolOutcome::Ok => "Done",
+        ToolOutcome::Failed => "Failed",
+        ToolOutcome::Refused => "Couldn\u{2019}t Run",
+        ToolOutcome::Denied | ToolOutcome::Cancelled => "Canceled",
+        ToolOutcome::Unavailable => "Not Available",
+        ToolOutcome::TimedOut => "Took Too Long",
+    }
+}
+
+/// A call's note. The words the engine and the fleet use for their own cases
+/// become a sentence; a service's own note is already one.
+fn plain_note(note: &str, label: &str) -> Option<String> {
+    let note = note.trim();
+    if note.is_empty() {
+        return None;
+    }
+    let plain = if note.contains("no node advertises") {
+        "No computer on your network can do this right now.".to_string()
+    } else if note.contains("is not running") {
+        format!("{} isn\u{2019}t open.", if label.is_empty() { "The app" } else { label })
+    } else if note.starts_with("no service") || note.contains("has no tool") {
+        "AI doesn\u{2019}t know this command.".to_string()
+    } else if note.contains("JSON") || note.contains("size cap") {
+        "This command\u{2019}s details couldn\u{2019}t be read.".to_string()
+    } else if note == "the person did not confirm" || note == "cancelled" {
+        "Canceled.".to_string()
+    } else if note.starts_with("waiting for the person") {
+        "Waiting for you to confirm in the app.".to_string()
+    } else {
+        // A bare slug or some raw form says nothing to a person.
+        if note.contains('`') || note.contains('{') {
+            return None;
+        }
+        let mut chars = note.chars();
+        match chars.next() {
+            Some(first) => first.to_uppercase().chain(chars).collect(),
+            None => return None,
+        }
+    };
+    Some(plain)
+}
+
+/// What a tool line says under its title.
+pub fn tool_note(tool: &ToolEntry) -> String {
+    match &tool.status {
+        ToolStatus::Confirm => String::new(),
+        ToolStatus::Running { note, .. } => plain_note(note, &tool.service_label).unwrap_or_default(),
+        ToolStatus::Done { outcome, note, .. } => match plain_note(note, &tool.service_label) {
+            Some(note) => note,
+            None if outcome.is_ok() => String::new(),
+            None => outcome_word(*outcome).to_string(),
+        },
+    }
+}
+
+/// A question still waits for the model: the person's last words have neither
+/// an answer nor a failure after them. Lines typed to the console since then
+/// are neither. Before anything is said, a model coming up is the news.
+pub fn question_waits(state: &EngineState) -> bool {
+    for entry in state.entries.iter().rev() {
+        match entry {
+            Entry::User { .. } => return true,
+            Entry::Assistant { .. } => return false,
+            Entry::System { text } if matches!(said(text), Said::Failure(_)) => return false,
+            _ => {}
+        }
+    }
+    state.entries.is_empty()
+}
+
+/// The failure that can still be acted on: the latest answer to the latest
+/// question. Lines typed to the console since then don't take it away.
+pub fn live_failure(state: &EngineState) -> Option<usize> {
+    for (index, entry) in state.entries.iter().enumerate().rev() {
+        match entry {
+            Entry::User { .. } | Entry::Assistant { .. } => return None,
+            Entry::System { text } if matches!(said(text), Said::Failure(_)) => return Some(index),
+            _ => {}
+        }
+    }
+    None
+}
+
+/// The same failure said again with nothing asked since: the last one says it,
+/// with what can be done about it, and the ones before it go.
+pub fn repeated_failure(state: &EngineState, index: usize) -> bool {
+    let Some(Entry::System { text }) = state.entries.get(index) else { return false };
+    if !matches!(said(text), Said::Failure(_)) {
+        return false;
+    }
+    for entry in &state.entries[index + 1..] {
+        match entry {
+            Entry::User { .. } | Entry::Assistant { .. } => return false,
+            Entry::System { text: later } if later == text => return true,
+            _ => {}
+        }
+    }
+    false
+}
+
+/// What Copy takes from a line of the conversation: what it says.
+pub fn words_of(entry: &Entry) -> String {
+    let lines = |lines: &[String]| lines.iter().map(|line| line.trim()).filter(|line| !line.is_empty()).collect::<Vec<_>>().join("\n");
+    match entry {
+        Entry::User { text } => text.trim().to_string(),
+        Entry::Assistant { text, .. } => text.trim().to_string(),
+        Entry::Event(event) => lines(&[event.service_label.clone(), event.text.clone()]),
+        Entry::Tool(tool) if matches!(tool.status, ToolStatus::Confirm) => lines(&[confirm_question(tool), confirm_note(tool)]),
+        Entry::Tool(tool) => lines(&[tool_title(tool), tool_note(tool), tool_detail(tool)]),
+        Entry::System { text } => match said(text) {
+            Said::Line(line) => line,
+            Said::Failure(failure) => lines(&[failure.title, failure.note]),
+        },
+    }
+}
+
+/// The code in a message: its fenced blocks, or else the words it sets as code.
+pub fn code_in(text: &str) -> Option<String> {
+    let mut blocks: Vec<String> = Vec::new();
+    let mut open: Option<String> = None;
+    for line in text.lines() {
+        if line.trim_start().starts_with("```") {
+            match open.take() {
+                Some(block) => blocks.push(block),
+                None => open = Some(String::new()),
+            }
+        } else if let Some(block) = open.as_mut() {
+            block.push_str(line);
+            block.push('\n');
+        }
+    }
+    // A block still being written.
+    blocks.extend(open);
+    let blocks: Vec<&str> = blocks.iter().map(|block| block.trim_end()).filter(|block| !block.is_empty()).collect();
+    if !blocks.is_empty() {
+        return Some(blocks.join("\n\n"));
+    }
+    let pieces: Vec<&str> = text.split('`').collect();
+    // An even count leaves its last mark unclosed: what follows it is no code.
+    let closed = if pieces.len() % 2 == 0 { pieces.len() - 1 } else { pieces.len() };
+    let spans: Vec<&str> = pieces[..closed].iter().skip(1).step_by(2).map(|span| span.trim()).filter(|span| !span.is_empty()).collect();
+    (!spans.is_empty()).then(|| spans.join("\n"))
+}
+
+/// What opening a finished line shows: its answer, when that says more than the note.
+pub fn tool_detail(tool: &ToolEntry) -> String {
+    match &tool.status {
+        ToolStatus::Done { outcome, text, note } if outcome.is_ok() && text.trim() != note.trim() => text.trim().to_string(),
+        _ => String::new(),
+    }
+}
