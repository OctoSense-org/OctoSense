+#[cfg(test)]
+mod document_tests {
+    use super::*;
+
+    #[test]
+    fn a_name_says_what_is_wrong_with_it() {
+        assert_eq!(name_problem("Household"), None);
+        assert_eq!(name_problem("  Household budget  "), None);
+        assert_eq!(name_problem(""), Some(""));
+        assert_eq!(name_problem("   "), Some(""));
+        assert!(name_problem("bad/name").unwrap().contains("slash"));
+        assert!(name_problem("bad:name").unwrap().contains("colon"));
+        assert!(name_problem(".hidden").unwrap().contains("period"));
+        assert!(name_problem(&"x".repeat(300)).unwrap().contains("long"));
+    }
+
+    #[test]
+    fn a_file_is_named_once() {
+        assert_eq!(file_name_for(" Household ", DocFormat::Book), "Household.sheets");
+        assert_eq!(file_name_for("Household.sheets", DocFormat::Book), "Household.sheets");
+        assert_eq!(file_name_for("Household", DocFormat::Csv), "Household.csv");
+        assert_eq!(file_name_for("v1.2 plan", DocFormat::Book), "v1.2 plan.sheets");
+        assert_eq!(title_of("Household.sheets"), "Household");
+        assert_eq!(title_of("Monthly costs.csv"), "Monthly costs");
+    }
+
+    #[test]
+    fn the_list_offers_documents_and_nothing_else() {
+        assert_eq!(entry_for("Planning.sheets", String::new()).unwrap().name, "Planning");
+        assert_eq!(entry_for("Monthly costs.csv", String::new()).unwrap().name, "Monthly costs.csv");
+        assert!(entry_for(".last-document", String::new()).is_none());
+        assert!(entry_for(".Planning.sheets.saving", String::new()).is_none());
+        assert!(entry_for("notes.txt", String::new()).is_none());
+        assert!(entry_for("no extension", String::new()).is_none());
+    }
+
+    #[test]
+    fn a_document_is_written_whole_and_listed_by_name() {
+        let folder = std::env::temp_dir().join(format!("sheets-docs-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&folder);
+        assert_eq!(list_documents(&folder), Ok(Vec::new()), "no folder yet is an empty one");
+        write_document(&folder, "beta.sheets", b"one").unwrap();
+        write_document(&folder, "Alpha.csv", b"two").unwrap();
+        write_document(&folder, "beta.sheets", b"three").unwrap();
+        std::fs::write(folder.join(LAST_DOCUMENT), "beta.sheets").unwrap();
+        let names: Vec<String> = list_documents(&folder).unwrap().into_iter().map(|entry| entry.name).collect();
+        assert_eq!(names, ["Alpha.csv", "beta"]);
+        assert_eq!(read_document(&folder, "beta.sheets").unwrap(), b"three");
+        assert!(read_document(&folder, "gone.sheets").is_err());
+        let _ = std::fs::remove_dir_all(&folder);
+    }
+
+    #[test]
+    fn a_time_reads_as_a_mac_writes_it() {
+        // 2026-11-02 21:05 UTC.
+        let parts = local_time::utc(1_793_653_500);
+        assert_eq!((parts.year, parts.month, parts.day), (2026, 11, 2));
+        assert_eq!(parts.date(), "Nov 2, 2026");
+        assert_eq!(parts.clock(), "9:05 PM");
+        assert_eq!(local_time::Parts { year: 2026, month: 1, day: 1, hour: 0, minute: 7 }.clock(), "12:07 AM");
+        assert_eq!(saved_words(1_793_653_500, 1_793_653_500 + 60)[..8].to_string(), "Saved at");
+        assert!(saved_words(1_793_653_500, 1_793_653_500 + 86_400 * 3).starts_with("Saved Nov"));
+    }
+}
