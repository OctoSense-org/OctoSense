+impl Row {
+    pub fn desk_kind(self) -> DeskKind {
+        match self {
+            Row::FontSize | Row::LineHeight => DeskKind::Stepper,
+            Row::SaveProfile | Row::DeleteProfile => DeskKind::Button,
+            Row::Shortcuts => DeskKind::List,
+            _ if self.is_toggle() => DeskKind::Check,
+            _ => DeskKind::Popup,
+        }
+    }
+
+    /// A control's label, or a check box's or a button's own words.
+    pub fn desk_label(self) -> &'static str {
+        match self {
+            Row::Theme => "Color scheme:",
+            Row::Font => "Font:",
+            Row::CjkFont => "East Asian font:",
+            Row::Ligatures => "Use ligatures",
+            Row::Profile => "Profile:",
+            Row::SaveProfile => "Save As\u{2026}",
+            Row::DeleteProfile => "Delete\u{2026}",
+            Row::ExternalControl => "Let other programs read and type in Terminal",
+            Row::Shortcuts => "Keyboard shortcuts:",
+            Row::Opacity => "Background:",
+            Row::FontSize => "Font size:",
+            Row::LineHeight => "Line spacing:",
+            Row::MinimumContrast => "Text contrast:",
+            Row::CursorShape => "Cursor:",
+            Row::CursorBlink => "Blink cursor",
+            Row::Term => "Declare terminal as:",
+            Row::Scrollback => "Scrollback:",
+            Row::OptionAsMeta => "Use Option as Meta key",
+            Row::Bell => "Bell:",
+            Row::CopyOnSelect => "Copy text when it is selected",
+            Row::Shell => "Shells open with:",
+            Row::LoginShell => "Run as a login shell",
+            Row::TabBar => "Show tab bar:",
+            Row::NewTabDir => "New tabs open in:",
+            Row::TabTitle => "Tabs show:",
+            Row::ConfirmClose => "Ask before closing a tab with a running process",
+            Row::RestoreText => "Restore text when reopening windows",
+        }
+    }
+
+    /// A line under the row.
+    pub fn desk_note(self) -> Option<&'static str> {
+        match self {
+            Row::LoginShell | Row::Term => Some("Changes apply to new tabs."),
+            Row::Profile => Some("A profile keeps all of these settings under a name."),
+            _ => None,
+        }
+    }
+
+    pub fn desk_checked(self, s: &Settings) -> bool {
+        match self {
+            Row::Ligatures => ligatures_on(&s.font_features),
+            Row::ExternalControl => s.external_control,
+            Row::CursorBlink => s.cursor_blink,
+            Row::OptionAsMeta => s.option_as_meta,
+            Row::CopyOnSelect => s.copy_on_select,
+            Row::LoginShell => s.login_shell,
+            Row::ConfirmClose => s.confirm_close_running,
+            Row::RestoreText => s.restore_text,
+            _ => false,
+        }
+    }
+
+    /// A desktop's stepper: font size goes by whole points.
+    pub fn desk_step(self, s: &Settings, dir: i32) -> Settings {
+        if self != Row::FontSize {
+            return self.step(s, dir);
+        }
+        let points = (s.font_size * 4.0 / 3.0).round() + dir as f64;
+        Settings { font_size: (points * 0.75).clamp(FONT_SIZE_RANGE.0, FONT_SIZE_RANGE.1), ..s.clone() }
+    }
+
+    /// A stepper's number, or the words of a pop-up's choice.
+    pub fn desk_value(self, s: &Settings, mac: bool) -> String {
+        match self {
+            // Makepad's font size is three quarters of a point.
+            Row::FontSize => format!("{:.0} pt", s.font_size * 4.0 / 3.0),
+            Row::LineHeight => self.value(s),
+            _ => self
+                .desk_options(s, mac)
+                .into_iter()
+                .find(|option| option.settings == *s)
+                .map_or_else(String::new, |option| option.label),
+        }
+    }
+
+    /// A pop-up's choices, the one in force among them: a value set by hand in the
+    /// file shows as itself, last.
+    pub fn desk_options(self, s: &Settings, mac: bool) -> Vec<DeskOption> {
+        let with = |label: String, change: &dyn Fn(&mut Settings)| {
+            let mut settings = s.clone();
+            change(&mut settings);
+            DeskOption { label, settings, separated: false }
+        };
+        let font_choice = |row: Row, name: &str| with(name.to_owned(), &|n: &mut Settings| *n = row.with_value(n, name));
+        let fonts = |row: Row, options: &mut Vec<DeskOption>| {
+            let families = crate::fonts::families();
+            for (i, family) in families.iter().enumerate() {
+                let mut option = font_choice(row, &family.name);
+                option.separated = family.monospace && families.get(i + 1).is_some_and(|next| !next.monospace);
+                options.push(option);
+            }
+        };
+        let mut options = match self {
+            Row::Theme => {
+                let mut options = vec![with("Match System".into(), &|n| n.theme = THEME_DESKTOP.into())];
+                options[0].separated = true;
+                options.extend(themes::SCHEMES.iter().map(|scheme| with(scheme.name.into(), &|n| n.theme = scheme.id.into())));
+                options
+            }
+            Row::Font => {
+                // Empty is the bundled font, or on a Mac Terminal.app's.
+                let default = if mac { crate::fonts::mac_default().map_or(DEFAULT_FONT, |family| family.name.as_str()) } else { DEFAULT_FONT };
+                let mut options = vec![with(default.into(), &|n| n.font_family = String::new())];
+                options[0].separated = true;
+                fonts(self, &mut options);
+                options.retain(|o| o.settings.font_family.is_empty() || (o.label != DEFAULT_FONT && o.label != default));
+                options
+            }
+            Row::CjkFont => {
+                let auto = match crate::fonts::auto_cjk() {
+                    Some(family) => format!("Automatic ({})", family.name),
+                    None => "Automatic".to_owned(),
+                };
+                let mut options = vec![
+                    with(auto, &|n| n.cjk_font = CJK_AUTO.into()),
+                    with("None".into(), &|n| n.cjk_font = CJK_NONE.into()),
+                ];
+                options[1].separated = true;
+                fonts(self, &mut options);
+                options
+            }
+            Row::CursorShape => vec![
+                with("Block".into(), &|n| n.cursor_shape = CursorShape::Block),
+                with("Vertical Bar".into(), &|n| n.cursor_shape = CursorShape::Bar),
+                with("Underline".into(), &|n| n.cursor_shape = CursorShape::Underline),
+            ],
+            Row::Opacity => OPACITY
+                .iter()
+                .filter(|a| !mac || **a != Some(1.0))
+                .map(|a| {
+                    let label = match a {
+                        None if mac => "Opaque".to_owned(),
+                        None => "Automatic".to_owned(),
+                        Some(v) if *v >= 1.0 => "Opaque".to_owned(),
+                        Some(v) => format!("{:.0}%", v * 100.0),
+                    };
+                    with(label, &|n| n.background_opacity = *a)
+                })
+                .collect(),
+            Row::TabBar => vec![
+                with("When There Are Multiple Tabs".into(), &|n| n.tab_bar = TabBar::Auto),
+                with("Always".into(), &|n| n.tab_bar = TabBar::Always),
+            ],
+            Row::NewTabDir => vec![
+                with("Same Working Directory".into(), &|n| n.new_tab_cwd = NewTabCwd::Inherit),
+                with("Home Folder".into(), &|n| n.new_tab_cwd = NewTabCwd::Home),
+            ],
+            Row::TabTitle => vec![
+                with("Running Program".into(), &|n| n.tab_title = TabTitle::Program),
+                with("Working Directory".into(), &|n| n.tab_title = TabTitle::Directory),
+            ],
+            Row::Shell => {
+                let paths = shell_choices(&s.shell);
+                let name = |path: &str| path.rsplit('/').next().unwrap_or(path).to_owned();
+                paths
+                    .iter()
+                    .map(|path| {
+                        let label = if path.is_empty() {
+                            "Default Login Shell".to_owned()
+                        } else if paths.iter().filter(|other| name(other) == name(path)).count() > 1 {
+                            path.clone()
+                        } else {
+                            name(path)
+                        };
+                        let mut option = with(label, &|n| n.shell = path.clone());
+                        option.separated = path.is_empty();
+                        option
+                    })
+                    .collect()
+            }
+            Row::Scrollback => SCROLLBACK
+                .iter()
+                .map(|lines| with(format!("{} Lines", thousands(*lines)), &|n| n.scrollback_lines = *lines))
+                .collect(),
+            Row::Bell => vec![
+                with("Flash Window".into(), &|n| n.bell = BellStyle::Visual),
+                with("None".into(), &|n| n.bell = BellStyle::None),
+            ],
+            Row::Profile => {
+                let mut options = vec![with("None".into(), &|n| n.profile = String::new())];
+                options[0].separated = true;
+                options.extend(
+                    crate::settings::list_profiles()
+                        .into_iter()
+                        .map(|name| with(name.clone(), &|n| *n = Row::Profile.with_value(n, &name))),
+                );
+                options
+            }
+            Row::Term => TERMS.iter().map(|term| with((*term).to_owned(), &|n| n.term = (*term).to_owned())).collect(),
+            Row::MinimumContrast => [(crate::contrast::OFF, "Standard"), (7.0, "More"), (10.0, "Most")]
+                .iter()
+                .map(|(ratio, label)| with((*label).to_owned(), &|n| n.minimum_contrast = *ratio))
+                .collect(),
+            _ => Vec::new(),
+        };
+        // A value only the file knows, or a profile changed since it was saved.
+        if !options.is_empty() && !options.iter().any(|option| option.settings == *s) {
+            let label = match self {
+                Row::Profile => format!("{} (Changed)", s.profile),
+                Row::Opacity => s.background_opacity.map_or_else(String::new, |a| format!("{:.0}%", a * 100.0)),
+                Row::Scrollback => format!("{} Lines", thousands(s.scrollback_lines)),
+                Row::MinimumContrast => format!("{}:1", s.minimum_contrast),
+                _ => self.value(s),
+            };
+            options.push(DeskOption { label, settings: s.clone(), separated: false });
+        }
+        options
+    }
+}
