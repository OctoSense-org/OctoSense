+    #[test]
+    fn an_embed_is_an_https_frame_and_nothing_else() {
+        let page = embed_page("https://player.example/embed/a?b=1&c=\"><script>").unwrap();
+        assert!(page.contains("src=\"https://player.example/embed/a?b=1&amp;c=&quot;&gt;&lt;script&gt;\""));
+        assert!(page.contains("opacity:0") && page.contains("onload=\"this.style.opacity=1\""));
+        assert_eq!(page.matches("<script").count(), 1, "the page's own, and the address stays an address");
+        assert!(embed_page("http://player.example/").is_none());
+        assert!(embed_page("javascript:alert(1)").is_none());
+        assert!(embed_page("https://player.example/\n").is_none());
+    }
 
