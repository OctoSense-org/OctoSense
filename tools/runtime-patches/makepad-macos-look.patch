+/// The day a week starts on here, counted as `weekday` counts them (0 = Sunday). A Mac says
+/// so in its own settings, read once. Elsewhere nothing says, and it's Monday.
+fn week_start() -> i64 {
+    #[cfg(target_os = "macos")]
+    {
+        use std::ffi::c_void;
+        #[link(name = "CoreFoundation", kind = "framework")]
+        extern "C" {
+            fn CFCalendarCopyCurrent() -> *const c_void;
+            // 1 is Sunday.
+            fn CFCalendarGetFirstWeekday(calendar: *const c_void) -> isize;
+            fn CFRelease(object: *const c_void);
+        }
+        static START: std::sync::OnceLock<i64> = std::sync::OnceLock::new();
+        return *START.get_or_init(|| unsafe {
+            let calendar = CFCalendarCopyCurrent();
+            if calendar.is_null() {
+                return 1;
+            }
+            let first = CFCalendarGetFirstWeekday(calendar);
+            CFRelease(calendar);
+            (first as i64 - 1).rem_euclid(7)
+        });
+    }
+    #[cfg(not(target_os = "macos"))]
+    1
+}
