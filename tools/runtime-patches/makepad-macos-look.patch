+/// The largest chat model under `dir`, a Qwen before any other, at most two
+/// folders down. Projector and OCR files are not chat models. The same choice as AI's.
+fn chat_model_under(dir: &Path, depth: usize) -> Option<PathBuf> {
+    let mut best: Option<(bool, u64, PathBuf)> = None;
+    for entry in std::fs::read_dir(dir).ok()?.flatten() {
+        let path = entry.path();
+        let found = if path.is_dir() {
+            if depth >= 2 {
+                continue;
+            }
+            match chat_model_under(&path, depth + 1) {
+                Some(found) => found,
+                None => continue,
+            }
+        } else {
+            let name = path.file_name().and_then(|n| n.to_str()).unwrap_or_default().to_ascii_lowercase();
+            if !name.ends_with(".gguf") || name.contains("mmproj") || name.contains("ocr") {
+                continue;
+            }
+            path
+        };
+        let size = std::fs::metadata(&found).map(|m| m.len()).unwrap_or(0);
+        let name = found.file_name().and_then(|n| n.to_str()).unwrap_or_default().to_ascii_lowercase();
+        let rank = (name.contains("qwen"), size);
+        if best.as_ref().is_none_or(|(qwen, size, _)| rank > (*qwen, *size)) {
+            best = Some((rank.0, rank.1, found));
+        }
+    }
+    best.map(|(_, _, path)| path)
+}
