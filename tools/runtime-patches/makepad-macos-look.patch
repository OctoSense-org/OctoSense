+/// The cursor over an enabled control or a pressable row. A Mac keeps the arrow there
+/// and shows the hand only over a link; the other styles keep their pointing hand.
+pub fn control_cursor(cx: &mut Cx) -> MouseCursor {
+    // A process's heaps follow one appearance, so any of them can answer.
+    let macos = cx.global::<Styles>().heaps.values().next()
+        .is_some_and(|sheet| DesktopStyle::parse(&sheet.name) == Some(DesktopStyle::Macos));
+    if macos { MouseCursor::Arrow } else { MouseCursor::Hand }
+}
