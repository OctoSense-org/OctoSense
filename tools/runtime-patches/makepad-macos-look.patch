+impl Widget for Finance {
+    /// The register, for whoever reads the widget tree: its cells are drawn, not
+    /// widgets of their own. Which row is selected, what was drawn, and the order.
+    fn selected_value(&self, _cx: &Cx) -> Option<String> {
+        if self.screen != Screen::Ledger {
+            return None;
+        }
+        let (row, count) = match self.register_selected {
+            Some((first, count)) => (Some(first), count),
+            None => (None, 0),
+        };
+        let words = |row: usize| {
+            self.rows.get(row).map(|(index, _)| {
+                let txn = &self.ledger.transactions[*index];
+                format!("{}|{}|{}", self.date_text(txn.date), txn.payee, txn.amount)
+            })
+        };
+        let (first, last) = self.register_drawn.unwrap_or((0, 0));
+        Some(format!(
+            "rows={};selected={};count={};row={};drawn={}-{};scroll={:.0};top={};bottom={};sort={},{}",
+            self.rows.len(),
+            row.map_or("-".to_string(), |row| row.to_string()),
+            count,
+            row.and_then(words).unwrap_or_default(),
+            first,
+            last,
+            self.register_scroll,
+            words(first).unwrap_or_default(),
+            words(last).unwrap_or_default(),
+            if self.sort.column == Column::Cleared { "Cleared" } else { self.sort.column.label() },
+            if self.sort.ascending { "up" } else { "down" },
+        ))
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        self.start(cx);
+
+        // A restyle reaches this tree with no event of its own on an in-process
+        // host, so the draw notices it: a process app first runs on the stock
+        // sheet, then receives the shell's. Whatever the Rust side set follows
+        // the new sheet, and a desktop's first sheet has built a new tree, so
+        // which screen shows and whether Import exists go back on it.
+        let roles = Roles::for_cx(cx);
+        if roles != self.roles {
+            self.roles = roles;
+            self.layout_applied = false;
+            self.chrome_synced = false;
+            let has_import = self.backend.has_import();
+            self.widget(cx, ids!(nav_import)).set_visible(cx, has_import);
+            self.widget(cx, ids!(tab_import)).set_visible(cx, has_import);
+            self.show_only_current_screen(cx);
+            self.desk_bar = None;
+            self.show_sheet_part(cx);
+        }
+
+        // The layout follows the room THIS widget is given — the turtle it
+        // is about to walk, which is the window's body standalone and a
+        // host's tile in a window manager — never a window's geometry. The
+        // area rect it read before is empty for the first draw and for a
+        // root recorded into a host's texture, which left a phone on the
+        // desktop layout.
+        let width = cx.turtle().rect().size.x;
+        if width > 1.0 {
+            let layout = if self.roles.desk { Layout::for_desk_width(width) } else { Layout::for_width(width) };
+            if layout != self.layout || !self.layout_applied {
+                self.apply_layout(cx, layout);
+            }
+        }
+        if !self.chrome_synced {
+            self.sync_chrome(cx);
