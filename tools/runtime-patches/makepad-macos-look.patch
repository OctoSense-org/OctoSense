+//! `aichat --sample-model`: a scripted model and a small service, the way Files
+//! has `--demo`, so the window's states can be seen on a machine with no model.
+//! The steps are timed, slowly enough that each state can be looked at; nothing
+//! leaves the process, and without the flag none of this exists.
+
+use makepad_ai_services::engine::{Model, ModelEvent, ServiceRegistry, ToolDefinition};
+use makepad_ai_services::port::{AiServicePort, PortEvent};
+use makepad_ai_services::wire::{Risk, ServiceCall, ServiceManifest, ToolDef, ToolResult};
+use makepad_widgets::*;
+use std::collections::VecDeque;
+use std::time::{Duration, Instant};
+
+/// The flag, on this process's command line.
+pub fn requested() -> bool {
+    std::env::args().any(|arg| arg == "--sample-model")
+}
+
+const REPLY: &str = "Here is a plan for **three days in Lisbon**:\n\n\
+    1. Walk through Alfama and up to the castle.\n\
+    2. Take tram 28 to Estrela, then see the tiles at the museum.\n\
+    3. Spend the last day by the sea in Cascais.\n\n\
+    Book the museum ahead on weekends. To keep the plan, run `save trip` in Notes, or ask me to change anything.";
+const FOUND: &str = "I found one note about Lisbon, written last week. It lists **Alfama**, the tile museum and a place to eat near the river.";
+const DELETED: &str = "The old packing list is gone. Your other notes are as they were.";
+const KEPT: &str = "All right, I left the packing list where it is.";
+const EXPORTED: &str = "Your 12 notes are in one file now, **Notes Export**, in your Documents folder.";
+/// Long enough, asked a few times, to run a conversation past its window.
+const LONG: &str = "Here is the whole trip, day by day, with what to book and when to set out.\n\n\
+    **Day one.** Start at the viewpoint of Senhora do Monte before the tour buses arrive, then walk down through Graça into Alfama. \
+    The lanes below the cathedral are at their best before ten, when the laundry is still out and the cafés are only just opening. \
+    Have lunch near the river, then take your time over the castle in the afternoon, when the light falls on the walls.\n\n\
+    **Day two.** Take tram 28 to Estrela from the Martim Moniz end, where you will get a seat. Walk through the garden, then on to the tile museum, \
+    which deserves most of the afternoon. Book it ahead on weekends.\n\n\
+    1. Ask for the rooftop table at the place near the river.\n\
+    2. Keep some cash for the tram; the ticket machines don't always work.\n\
+    3. Wear shoes with a grip: the pavements are polished stone.\n\n\
+    To keep all this and share it, run these in Notes:\n\n\
+    ```\n\
+    save trip --days 3 --city Lisbon\n\
+    share trip --with family\n\
+    ```\n\n\
+    **Day three.** Take the train to Cascais from Cais do Sodré; it runs along the water the whole way, and the seats on the left have the sea. \
+    Walk to the Boca do Inferno, swim if the day allows it, and come back at sunset.\n\n\
+    That is everything for the three days. Tell me what to change.";
+
+const EXPORTING: &str = "Exporting your notes\u{2026}";
+
+/// When each scripted event is due.
+#[derive(Default)]
+pub struct SampleModel {
+    script: VecDeque<(Instant, ModelEvent)>,
+    /// When the next event goes out, past those already queued.
+    clock: Option<Instant>,
+    next_call: u32,
+    /// What the turn says once the tool has answered.
+    after_tool: Option<(&'static str, &'static str)>,
+}
+
+impl SampleModel {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn after(&mut self, wait_ms: u64, event: ModelEvent) {
+        let at = self.clock.unwrap_or_else(Instant::now) + Duration::from_millis(wait_ms);
+        self.clock = Some(at);
+        self.script.push_back((at, event));
+    }
+
+    /// A few words at a time, as a model writes.
+    fn write(&mut self, text: &str, every_ms: u64) {
+        let mut piece = String::new();
+        for word in text.split_inclusive(' ') {
+            piece.push_str(word);
+            if piece.len() >= 12 {
+                self.after(every_ms, ModelEvent::Delta(std::mem::take(&mut piece)));
+            }
+        }
+        if !piece.is_empty() {
+            self.after(every_ms, ModelEvent::Delta(piece));
+        }
+        self.after(every_ms, ModelEvent::TurnDone { tool_calls: 0 });
+    }
+
+    fn call(&mut self, wait_ms: u64, name: &str, args: &str) {
+        self.next_call += 1;
+        let call_id = format!("s{}", self.next_call);
+        self.after(wait_ms, ModelEvent::ToolCall { call_id, name: name.to_string(), args: args.to_string() });
+        self.after(1, ModelEvent::TurnDone { tool_calls: 1 });
+    }
+}
+
+impl Model for SampleModel {
+    fn label(&self) -> String {
+        "Local \u{00b7} Qwen3.5 9B".to_string()
+    }
+
+    fn configure(&mut self, _system: &str, _tools: &[ToolDefinition]) -> Result<(), String> {
+        Ok(())
+    }
+
+    fn send_user(&mut self, text: &str, _dynamic_context: &str) {
+        self.script.clear();
+        self.clock = None;
+        let text = text.to_lowercase();
+        if text.contains("delete") {
+            self.after_tool = Some((DELETED, KEPT));
+            self.call(800, "notes.delete", r#"{"title":"Old packing list"}"#);
+        } else if text.contains("find") {
+            self.after_tool = Some((FOUND, FOUND));
+            self.call(800, "notes.find", r#"{"query":"Lisbon"}"#);
+        } else if text.contains("export") {
+            self.after_tool = Some((EXPORTED, EXPORTED));
+            self.call(800, "notes.export", "{}");
+        } else if text.contains("long") {
+            self.write(LONG, 12);
+        } else if text.contains("load") {
+            for step in 1..=5 {
+                self.after(1500, ModelEvent::Loading { phase: "the model".to_string(), fraction: step as f64 * 0.17 });
+            }
+            self.after(800, ModelEvent::Ready);
+            self.write(REPLY, 60);
+        } else {
+            self.after(3500, ModelEvent::Thinking("Thinking about the route.".to_string()));
+            self.after(500, ModelEvent::Delta(String::new()));
+            self.write(REPLY, 170);
+        }
+    }
+
+    fn send_tool_result(&mut self, _call_id: &str, _text: &str, is_error: bool) {
+        self.clock = None;
+        let (done, failed) = self.after_tool.take().unwrap_or((KEPT, KEPT));
+        self.after(600, ModelEvent::Thinking(String::new()));
+        self.write(if is_error { failed } else { done }, 60);
+    }
+
+    fn cancel(&mut self) {
+        self.script.clear();
+        self.clock = None;
+    }
+
+    fn reset(&mut self) {
+        self.cancel();
+        self.after_tool = None;
+    }
+
+    fn poll(&mut self) -> Vec<ModelEvent> {
+        let now = Instant::now();
+        let mut due = Vec::new();
+        while self.script.front().is_some_and(|(at, _)| *at <= now) {
+            if let Some((_, event)) = self.script.pop_front() {
+                due.push(event);
+            }
+        }
+        due
+    }
+}
+
+/// The app the sample conversation reaches: a few notes that are never real.
+pub struct SampleService {
+    port: AiServicePort,
+    running: Option<(ServiceCall, Instant)>,
+    /// How far along the running export has said it is, in thousandths.
+    told: u16,
+}
+
+fn manifest() -> ServiceManifest {
+    ServiceManifest::new("notes", "Notes", "A sample of notes, for looking at the assistant's window.")
+        .with_tool(ToolDef::new(
+            "find",
+            "Find a note.",
+            r#"{"type":"object","properties":{"query":{"type":"string"}},"required":["query"]}"#,
+            Risk::Read,
+        ))
+        .with_tool(ToolDef::new(
+            "delete",
+            "Delete a note.",
+            r#"{"type":"object","properties":{"title":{"type":"string"}},"required":["title"]}"#,
+            Risk::Destructive,
+        ))
+        .with_tool(ToolDef::new(
+            "export",
+            "Export every note to one file.",
+            r#"{"type":"object","properties":{}}"#,
+            Risk::Read,
+        ))
+}
+
+impl SampleService {
+    pub fn open(registry: &ServiceRegistry) -> Option<SampleService> {
+        let (port, link) = AiServicePort::in_process(manifest()).ok()?;
+        registry.register(link, "built in", None).ok()?;
+        Some(SampleService { port, running: None, told: 0 })
+    }
+
+    /// A call takes a while, so a running line can be seen.
+    pub fn handle_event(&mut self, cx: &mut Cx, event: &Event) {
+        for ev in self.port.handle_event(cx, event) {
+            match ev {
+                PortEvent::Call(call) => {
+                    // Only what counts its way through its work says how far along it is.
+                    let note = match call.tool.as_str() {
+                        "delete" => "Deleting\u{2026}",
+                        "export" => EXPORTING,
+                        _ => "Looking through your notes\u{2026}",
+                    };
+                    self.port.progress(&call.call_id, note, 0);
+                    self.told = 0;
+                    self.running = Some((call, Instant::now()));
+                }
+                PortEvent::Cancel { call_id } => {
+                    if self.running.as_ref().is_some_and(|(call, _)| call.call_id == call_id) {
+                        self.running = None;
+                    }
+                }
+                _ => {}
+            }
+        }
+        if let Some((call, since)) = &self.running {
+            let share = (since.elapsed().as_millis() / 8).min(1000) as u16;
+            if call.tool == "export" && share >= self.told + 50 {
+                self.told = share;
+                self.port.progress(&call.call_id, EXPORTING, share);
+            }
+        }
+        let lasts = |call: &ServiceCall| Duration::from_secs(if call.tool == "export" { 8 } else { 4 });
+        if self.running.as_ref().is_some_and(|(call, since)| since.elapsed() > lasts(call)) {
+            if let Some((call, _)) = self.running.take() {
+                let (text, note) = match call.tool.as_str() {
+                    "delete" => ("Deleted \u{201c}Old packing list\u{201d}.", "Deleted \u{201c}Old packing list\u{201d}."),
+                    "export" => ("12 notes, in Notes Export.", "Exported 12 notes."),
+                    _ => ("Lisbon trip, edited last week: Alfama, the tile museum, a place to eat near the river.", "Found one note."),
+                };
+                self.port.reply(ToolResult::ok(&call.call_id, text, note));
+            }
+        }
+    }
+}
