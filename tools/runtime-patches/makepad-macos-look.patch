+        let mods = key.modifiers;
+        if mods.control && mods.logo && !mods.shift && !mods.alt && key.key_code == KeyCode::KeyS {
+            if !compact {
+                self.toggle_sidebar(cx);
+            }
+            return true;
+        }
+        if mods.is_primary() && mods.shift && !mods.alt && key.key_code == KeyCode::KeyN {
+            self.open_list_sheet(cx, ListSheet::New);
+            return true;
+        }
