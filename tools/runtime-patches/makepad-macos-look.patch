+/// A date as a Mac's Finder writes it: "Nov 2, 2026 at 3:45 PM".
+pub fn format_mac_stamp(secs: u64) -> String {
+    format_mac_stamp_at(secs, local_utc_offset_secs())
+}
+
+/// The day alone: `Nov 2, 2026`.
+pub fn format_mac_day(secs: u64) -> String {
+    let stamp = format_mac_stamp(secs);
+    stamp.split(" at ").next().unwrap_or(&stamp).to_string()
+}
+
+/// What the status bar says of columns the window has no room for.
+pub fn columns_left_out_words(columns: &[SortKey]) -> Option<String> {
+    let names: Vec<&str> = columns.iter().map(|column| column.desk_label()).collect();
+    match names.as_slice() {
+        [] => None,
+        [one] => Some(format!("{one} doesn\u{2019}t fit: make the window wider to see it.")),
+        [rest @ .., last] => Some(format!("{} and {last} don\u{2019}t fit: make the window wider to see them.", rest.join(", "))),
+    }
