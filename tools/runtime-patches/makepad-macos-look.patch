+    /// See [`LoadCheck`]: a finished load that looks like the engine's error
+    /// page is asked for once, and the page covered until the answer.
+    fn check_load(&mut self, cx: &mut Cx, info: &webview::ActiveInfo) {
+        let Some(id) = info.id else {
+            return;
+        };
+        if !(info.url.starts_with("http://") || info.url.starts_with("https://")) {
+            self.load_checks.remove(&id);
+            return;
+        }
+        let check = self.load_checks.entry(id).or_default();
+        if check.url != info.url {
+            *check = LoadCheck { url: info.url.clone(), ..LoadCheck::default() };
+        }
+        if info.loading {
+            return;
+        }
+        let bare = |text: &str| text.trim_start_matches("www.").to_string();
+        let titled_by_host = tabs::host_of(&info.url).is_some_and(|host| bare(&host) == bare(&info.title));
+        if !titled_by_host {
+            check.failed = None;
+            check.looked = false;
+            return;
+        }
+        if check.looked {
+            return;
+        }
+        check.looked = true;
+        check.waiting = true;
+        let request_id = LiveId::unique();
+        let mut request = HttpRequest::new(info.url.clone(), HttpMethod::GET);
+        request.set_header("Range".to_string(), "bytes=0-0".to_string());
+        cx.http_request(request_id, request);
+        self.load_probe = Some((request_id, id));
+        self.load_probe_timer = cx.start_timeout(LOAD_CHECK_SECONDS);
+    }
+
+    fn on_load_probe(&mut self, cx: &mut Cx, response: &NetworkResponse) {
+        let Some((request_id, tab)) = self.load_probe else {
+            return;
+        };
+        let failure = match response {
+            NetworkResponse::HttpResponse { request_id: id, response } if *id == request_id => {
+                (response.status_code >= 500).then(|| {
+                    let host = self.load_checks.get(&tab).and_then(|c| tabs::host_of(&c.url)).unwrap_or_default();
+                    (
+                        "This Page Isn\u{2019}t Working".to_string(),
+                        format!("The server \u{201c}{host}\u{201d} reported a problem with this page."),
+                    )
+                })
+            }
+            NetworkResponse::HttpError { request_id: id, error } if *id == request_id => {
+                let url = self.load_checks.get(&tab).map(|c| c.url.clone()).unwrap_or_default();
+                log!("browser: page did not open: {}", error.message);
+                Some(failure_text(&url, &error.message))
+            }
+            _ => return,
+        };
+        self.load_probe = None;
+        cx.stop_timer(self.load_probe_timer);
+        if let Some(check) = self.load_checks.get_mut(&tab) {
+            check.waiting = false;
+            check.failed = failure;
+        }
+        self.refresh_chrome(cx);
+    }
