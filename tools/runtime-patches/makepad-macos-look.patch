+impl MpPlacesPage {
+    /// Shows `kind`, at the top if it wasn't up; said again, it keeps its place.
+    pub fn show(&mut self, cx: &mut Cx, kind: PlacesKind, lines: Vec<Line>, action_words: &str) {
+        if self.kind != Some(kind) {
+            self.view.portal_list(cx, ids!(places_list)).set_first_id_and_scroll(0, 0.0);
+            self.set_query(cx, "");
+            self.view.text_input(cx, ids!(places_query)).set_empty_text(cx, kind.search_words().to_string());
+        }
+        self.kind = Some(kind);
+        self.all = lines;
+        self.filter();
+        self.action_words = action_words.to_string();
+        self.say(cx);
+    }
+
+    pub fn hide(&mut self, cx: &mut Cx) {
+        self.kind = None;
+        self.all.clear();
+        self.lines.clear();
+        self.set_query(cx, "");
+        self.drawn.clear();
+        self.hovered = None;
+        self.pressed = None;
+        self.menu_line = None;
+        self.view.redraw(cx);
+    }
+
+    pub fn set_inert(&mut self, inert: bool) {
+        self.inert = inert;
+    }
+
+    /// The menu at a right press is up: the keys are its own.
+    pub fn menu_open(&self) -> bool {
+        self.context_menu.is_open()
+    }
+
+    /// Something is typed in the search field.
+    pub fn searching(&self) -> bool {
+        !self.query.is_empty()
+    }
+
+    /// Escape in a search field empties it, as a Mac's does, and every row is back.
+    pub fn clear_search(&mut self, cx: &mut Cx) {
+        self.set_query(cx, "");
+        self.filter();
+        self.say(cx);
+    }
+
+    /// Command-F: the search field takes the keyboard, its words selected.
+    pub fn focus_search(&mut self, cx: &mut Cx) {
+        let field = self.view.text_input(cx, ids!(places_query));
+        field.set_key_focus(cx);
+        field.borrow_mut().map(|mut inner| inner.select_all(cx));
+    }
+
+    fn set_query(&mut self, cx: &mut Cx, query: &str) {
+        self.query = query.to_string();
+        self.view.text_input(cx, ids!(places_query)).set_text(cx, query);
+    }
+
+    fn filter(&mut self) {
+        self.lines = matching(&self.all, &self.query);
+    }
+
+    /// Says what the page says. A new sheet comes up with its words gone.
+    fn say(&mut self, cx: &mut Cx) {
+        let Some(kind) = self.kind else {
+            return;
+        };
+        let empty = self.lines.is_empty();
+        let none_at_all = self.all.is_empty();
+        let (title, note) = if none_at_all { kind.empty_words() } else { ("No Results", "") };
+        self.view.label(cx, ids!(places_title)).set_text(cx, kind.title());
+        self.view.widget(cx, ids!(places_list)).set_visible(cx, !empty);
+        self.view.widget(cx, ids!(places_empty)).set_visible(cx, empty);
+        self.view.label(cx, ids!(places_empty_title)).set_text(cx, title);
+        self.view.label(cx, ids!(places_empty_note)).set_text(cx, note);
+        self.view.widget(cx, ids!(places_empty_note)).set_visible(cx, !note.is_empty());
+        // A search that finds nothing says so, and no more.
+        self.view.widget(cx, ids!(empty_book)).set_visible(cx, none_at_all && kind == PlacesKind::Bookmarks);
+        self.view.widget(cx, ids!(empty_clock)).set_visible(cx, none_at_all && kind == PlacesKind::History);
+        self.view.button(cx, ids!(places_action)).set_text(cx, &self.action_words);
+        self.view.widget(cx, ids!(places_action)).set_visible(cx, none_at_all);
+        self.view.widget(cx, ids!(places_clear)).set_visible(cx, kind == PlacesKind::History);
+        let clear = self.view.button(cx, ids!(places_clear));
+        clear.set_enabled(cx, !none_at_all);
+        if none_at_all {
+            clear.reset_hover(cx);
+        }
+        self.view.widget(cx, ids!(places_clear)).set_disabled(cx, none_at_all);
+        // Nothing to search in, nothing to search with.
+        self.view.widget(cx, ids!(places_search)).set_visible(cx, !none_at_all || self.searching());
+        self.view.redraw(cx);
+    }
+
+    fn line_at(&self, cx: &Cx, abs: Vec2d) -> Option<usize> {
+        self.drawn.iter().find(|(_, area)| area.clipped_rect(cx).contains(abs)).map(|(index, _)| *index)
+    }
+
+    fn url_of(&self, index: usize) -> Option<String> {
+        match self.lines.get(index) {
+            Some(Line::Page { url, .. }) => Some(url.clone()),
+            _ => None,
+        }
+    }
+
+    fn open_line(&mut self, cx: &mut Cx, index: usize) {
+        if let Some(url) = self.url_of(index) {
+            cx.widget_action(self.widget_uid(), MpPlacesPageAction::Open(url));
+        }
+    }
+
+    fn open_row_menu(&mut self, cx: &mut Cx, press: &MouseDownEvent, index: usize) {
+        let Some(kind) = self.kind else {
+            return;
+        };
+        let rows = row_menu(kind);
+        self.menu_rows = rows.iter().map(|(row, _)| *row).collect();
+        self.menu_line = Some(index);
+        let rows = rows
+            .iter()
+            .map(|(row, title)| if *row == RowMenu::Rule { ContextRow::rule() } else { ContextRow::new(title, true) })
+            .collect();
+        let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+        self.context_menu.open(cx, owner, press.abs, press.time, rows);
+        self.view.redraw(cx);
+    }
+
+    fn menu_chose(&mut self, cx: &mut Cx, row: usize) {
+        let url = self.menu_line.take().and_then(|index| self.url_of(index));
+        self.view.redraw(cx);
+        let Some(url) = url else {
+            return;
+        };
+        let action = match self.menu_rows.get(row) {
+            Some(RowMenu::Open) => MpPlacesPageAction::Open(url),
+            Some(RowMenu::OpenInNewTab) => MpPlacesPageAction::OpenInNewTab(url),
+            Some(RowMenu::Edit) => MpPlacesPageAction::Edit(url),
+            Some(RowMenu::Remove) => MpPlacesPageAction::Remove(url),
+            Some(RowMenu::CopyLink) => {
+                cx.copy_to_clipboard(&url);
+                return;
+            }
+            Some(RowMenu::Rule) | None => return,
+        };
+        cx.widget_action(self.widget_uid(), action);
+    }
+
+    fn draw_lines(&mut self, cx: &mut Cx2d, list: &mut PortalList) {
+        list.set_item_range(cx, 0, self.lines.len());
+        self.drawn.clear();
+        while let Some(index) = list.next_visible_item(cx) {
+            match self.lines.get(index) {
+                Some(Line::Day(day)) => {
+                    let item = list.item(cx, index, id!(PlaceDay));
+                    item.label(&**cx, ids!(day_name)).set_text(&mut **cx, day);
+                    item.draw_all(cx, &mut Scope::empty());
+                }
+                Some(Line::Page { name, site, time, .. }) => {
+                    let item = list.item(cx, index, id!(PlaceRow));
+                    item.label(&**cx, ids!(place_name)).set_text(&mut **cx, name);
+                    item.label(&**cx, ids!(place_site)).set_text(&mut **cx, site);
+                    item.label(&**cx, ids!(place_time)).set_text(&mut **cx, time);
+                    item.widget(&**cx, ids!(place_time)).set_visible(&mut **cx, !time.is_empty());
+                    let down = self.pressed == Some(index);
+                    let lit = self.menu_line == Some(index) || self.hovered == Some(index);
+                    item.widget(&**cx, ids!(row_down)).set_visible(&mut **cx, down);
+                    item.widget(&**cx, ids!(row_fill)).set_visible(&mut **cx, lit && !down);
+                    item.draw_all(cx, &mut Scope::empty());
+                    self.drawn.push((index, item.area()));
+                }
+                None => {}
+            }
+        }
+    }
+}
