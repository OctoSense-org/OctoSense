+        fields.notes = form.text_input(cx, ids!(fields.text_group.notes)).text();
+        fields.date_on = form.check_box(cx, ids!(fields.schedule.date_on)).active(cx);
+        fields.time_on = form.check_box(cx, ids!(fields.schedule.time_on)).active(cx);
+        fields.date = form.widget(cx, ids!(fields.schedule.date)).text();
+        fields.time = form.widget(cx, ids!(fields.schedule.time)).text();
+        fields.flagged = form
+            .check_box(cx, ids!(fields.organization.flag))
+            .active(cx);
+        let priority = form.widget(cx, ids!(fields.organization.priority));
+        if let Some(seg) = priority.borrow::<GlassSegmented>() {
+            fields.priority = Priority::from_index(seg.selected());
+        } else if priority.borrow::<DropDown>().is_some() {
+            fields.priority = Priority::from_index(
+                form.drop_down(cx, ids!(fields.organization.priority))
+                    .selected_item(),
+            );
+        }
+        let index = form
+            .drop_down(cx, ids!(fields.organization.list))
+            .selected_item();
+        if let Some(list) = self.document.as_ref().and_then(|doc| doc.lists.get(index)) {
+            fields.list_id = list.id;
+        }
+        if self.pointer {
+            // The pop-up beside the date says which of its days this is.
+            let preset = form.drop_down(cx, ids!(preset));
+            let index = preset_index(&fields.date, self.now);
+            if preset.selected_item() != index {
+                preset.set_selected_item(cx, index);
+            }
+            self.sync_done(cx, &form);
+        }
+    }
