+/// What a desktop's window holds: the document's name, its file if it has one,
+/// and whether it has changes to keep.
+#[derive(Default)]
+struct Document {
+    /// Set up once, on the first desktop draw.
+    ready: bool,
+    /// Its file in the app's folder; None until a Save names one.
+    file: Option<String>,
+    /// What the toolbar calls it.
+    title: String,
+    /// The workbook as last saved or opened: the same body has nothing to save.
+    saved_body: String,
+    saved_at: Option<i64>,
+    edited: bool,
+    /// Where the file is when the person chose it in a Mac's own panel: anywhere they
+    /// can reach, which this sandboxed app reaches only through the window manager.
+    chosen: Option<PathBuf>,
+}
+
+/// What to do once the changes in hand are kept or let go.
+#[derive(Clone, Debug, PartialEq)]
+enum AfterKeep {
+    New,
+    Open(String),
+    /// A file chosen in a Mac's Open panel.
+    OpenChosen(PathBuf),
+    Close,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+struct SaveJob {
+    file: String,
+    format: DocFormat,
+    /// The place a Mac's Save panel named (or the chosen file's own): the file goes
+    /// there, through the window manager, instead of the app's folder.
+    chosen: Option<PathBuf>,
+}
+
+/// The alert a desktop's window is asking, if any.
+#[derive(Clone, Debug, PartialEq)]
+enum Ask {
+    KeepChanges(AfterKeep),
+    DeleteSheet(usize),
+    Replace(SaveJob),
+    SaveFailed { job: SaveJob, why: String },
+    OpenFailed { file: String, why: String },
+}
+
+/// A row of the toolbar's menu card.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum MenuChoice {
+    Function(usize),
+    Align(HAlign),
+    Number(NumFormat),
+}
+
+impl MenuChoice {
+    fn label(self) -> &'static str {
+        match self {
+            MenuChoice::Function(index) => FUNCTIONS.get(index).map_or("", |(name, _)| name),
+            MenuChoice::Align(HAlign::Left) => "Align Left",
+            MenuChoice::Align(HAlign::Center) => "Align Center",
+            MenuChoice::Align(_) => "Align Right",
+            MenuChoice::Number(NumFormat::General) => "General",
+            MenuChoice::Number(NumFormat::Fixed2) => "Number",
+            MenuChoice::Number(NumFormat::Thousands) => "1,000.00",
+            MenuChoice::Number(NumFormat::Percent) => "Percent",
+        }
+    }
+
+    /// Whether the active cell is already this, for the row's check mark.
+    fn is_on(self, format: &sheet::CellFormat) -> bool {
+        match self {
+            MenuChoice::Function(_) => false,
+            MenuChoice::Align(align) => format.align == align,
+            MenuChoice::Number(num) => format.num == num,
+        }
+    }
+
+    /// Whether a hairline goes over the row at `index`.
+    fn starts_group(self, index: usize, previous: Option<MenuChoice>) -> bool {
+        match self {
+            MenuChoice::Function(function) => FUNCTION_GROUPS.contains(&function),
+            MenuChoice::Number(_) => matches!(previous, Some(MenuChoice::Align(_))) && index > 0,
+            MenuChoice::Align(_) => false,
+        }
+    }
+}
+
+/// Who gets the keyboard after the next draw: what a sheet puts up has no area
+/// to focus until then.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Focus {
+    Grid,
+    Nobody,
+    SaveName { select: bool },
+    Rename,
+}
+
+/// What this widget tells the window around it.
+#[derive(Clone, Debug, Default)]
+pub enum MpSheetsAction {
+    /// The document's name changed.
+    Title(String),
+    /// The person answered the close: go.
+    CloseNow,
+    #[default]
+    None,
+}
+
+/// A tool that cannot be used now stays where it is, dimmed. Its label follows
+/// the button's own disabled state, its glyph has none.
+fn set_tool_enabled(widget: &WidgetRef, cx: &mut Cx, enabled: bool) {
+    let button = widget.as_button();
+    button.set_enabled(cx, enabled);
+    if let Some(mut inner) = button.borrow_mut() {
+        inner.draw_icon.opacity = if enabled { 1.0 } else { 0.35 };
+    }
+    widget.set_disabled(cx, !enabled);
+}
+
+/// A document's bytes as a workbook. A file that is not one says why, in words.
+fn parse_document(file: &str, bytes: Vec<u8>) -> Result<Workbook, String> {
+    let text = String::from_utf8(bytes).map_err(|_| "This file doesn\u{2019}t hold text that Sheets can read.".to_string())?;
+    if docs::is_csv(file) {
+        let mut workbook = Workbook::default();
+        workbook.sheets = vec![sheet::sheet_from_csv(&docs::title_of(file), &text)];
+        Ok(workbook)
+    } else {
+        sheet::book_from(&text).map_err(|_| "This file isn\u{2019}t a workbook, or it\u{2019}s damaged.".to_string())
+    }
+}
