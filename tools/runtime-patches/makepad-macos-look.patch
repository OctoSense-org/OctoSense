+    entries: Vec<OpenEntry>,
+    #[rust]
+    selected: Option<usize>,
+    /// What the list offers: lower case, without the dot.
+    #[rust]
+    extensions: Vec<String>,
+    /// What an empty folder is empty of: "images", "PDF documents".
+    #[rust]
+    kind: String,
+}
+
+impl Widget for MpOpenSheet {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        if !self.open {
+            return;
+        }
+        self.view.handle_event(cx, event, scope);
+        match event {
+            Event::KeyDown(ke) => self.handle_key(cx, ke),
+            Event::Actions(actions) => self.handle_actions(cx, actions),
+            _ => {}
+        }
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        while let Some(step) = self.view.draw_walk(cx, scope, walk).step() {
+            if let Some(mut list) = step.as_portal_list().borrow_mut() {
+                list.set_item_range(cx, 0, self.entries.len());
+                while let Some(index) = list.next_visible_item(cx) {
+                    let Some(entry) = self.entries.get(index) else {
+                        continue;
+                    };
+                    let on = self.selected == Some(index);
+                    let template = match (entry.is_dir, on) {
+                        (true, false) => id!(FolderLine),
+                        (true, true) => id!(FolderLineOn),
+                        (false, false) => id!(FileLine),
+                        (false, true) => id!(FileLineOn),
+                    };
+                    let item = list.item(cx, index, template);
+                    item.label(cx, ids!(name)).set_text(cx, &entry.name);
+                    item.label(cx, ids!(date)).set_text(cx, &entry.date);
+                    item.draw_all(cx, &mut Scope::empty());
+                }
+            }
+        }
+        DrawStep::done()
+    }
+}
+
+impl MpOpenSheet {
+    /// Put the sheet up over its window, in `start` when it can be read.
+    /// `home` is what the Favorites hang off.
+    pub fn present(&mut self, cx: &mut Cx, home: &Path, start: &Path, extensions: &[&str], kind: &str) {
+        self.home = home.to_path_buf();
+        self.extensions = extensions.iter().map(|e| e.to_string()).collect();
+        self.kind = kind.to_string();
+        self.open = true;
+        self.go_to(cx, start.to_path_buf());
+        self.view.set_visible(cx, true);
+        // A field that held the keyboard lets go of it: the list answers now.
+        cx.set_key_focus(Area::Empty);
+        cx.redraw_all();
+    }
+
+    pub fn is_open(&self) -> bool {
+        self.open
+    }
+
+    /// A new style sheet rebuilt the look: what the state decides comes back.
+    pub fn refresh(&mut self, cx: &mut Cx) {
+        if self.open {
+            self.paint(cx);
+        }
+    }
+
+    fn dismiss(&mut self, cx: &mut Cx) {
+        self.open = false;
+        self.entries.clear();
+        self.selected = None;
+        self.view.set_visible(cx, false);
+        cx.redraw_all();
+    }
+
+    fn go_to(&mut self, cx: &mut Cx, dir: PathBuf) {
+        self.entries = list_folder(&dir, &self.extensions);
+        self.dir = dir;
+        self.selected = None;
+        self.view.portal_list(cx, ids!(files)).set_first_id_and_scroll(0, 0.0);
+        self.paint(cx);
+    }
+
+    /// Everything of the sheet that follows from where it is.
+    fn paint(&mut self, cx: &mut Cx) {
+        let name = folder_title(&self.dir, &self.home);
+        self.view.label(cx, ids!(folder_name)).set_text(cx, &name);
+        let readable = std::fs::read_dir(&self.dir).is_ok();
+        let note = if !readable {
+            "This folder can\u{2019}t be read.".to_string()
+        } else if self.entries.is_empty() {
+            format!("No {} in this folder.", self.kind)
+        } else {
+            String::new()
+        };
+        self.view.widget(cx, ids!(nothing)).set_visible(cx, !note.is_empty());
+        self.view.label(cx, ids!(nothing_note)).set_text(cx, &note);
+
+        let places = [
+            (ids!(place_home), ids!(place_home_on), self.home.clone()),
+            (ids!(place_desktop), ids!(place_desktop_on), self.home.join("Desktop")),
+            (ids!(place_documents), ids!(place_documents_on), self.home.join("Documents")),
+            (ids!(place_downloads), ids!(place_downloads_on), self.home.join("Downloads")),
+            (ids!(place_pictures), ids!(place_pictures_on), self.home.join("Pictures")),
+        ];
+        for (off, on, path) in places {
+            let here = path == self.dir;
+            let there = path.is_dir();
+            self.view.widget(cx, off).set_visible(cx, there && !here);
+            self.view.widget(cx, on).set_visible(cx, there && here);
+        }
+
+        set_enabled(&self.view.widget(cx, ids!(enclosing_button)), cx, self.dir.parent().is_some());
+        set_enabled(&self.view.widget(cx, ids!(choose_button)), cx, self.selected.is_some());
+        cx.redraw_all();
+    }
+
+    fn handle_actions(&mut self, cx: &mut Cx, actions: &Actions) {
+        if self.view.button(cx, ids!(cancel_button)).clicked(actions) {
+            self.cancel(cx);
+            return;
+        }
+        if self.view.button(cx, ids!(choose_button)).clicked(actions) {
+            if let Some(index) = self.selected {
+                self.activate(cx, index);
+            }
+            return;
+        }
+        if self.view.button(cx, ids!(enclosing_button)).clicked(actions) {
+            self.go_up(cx);
+            return;
+        }
+        let places = [
+            (ids!(place_home), ids!(place_home_on), self.home.clone()),
+            (ids!(place_desktop), ids!(place_desktop_on), self.home.join("Desktop")),
+            (ids!(place_documents), ids!(place_documents_on), self.home.join("Documents")),
+            (ids!(place_downloads), ids!(place_downloads_on), self.home.join("Downloads")),
+            (ids!(place_pictures), ids!(place_pictures_on), self.home.join("Pictures")),
+        ];
+        for (off, on, path) in places {
+            if self.view.button(cx, off).clicked(actions) || self.view.button(cx, on).clicked(actions) {
+                self.go_to(cx, path);
+                return;
+            }
+        }
+        let list = self.view.portal_list(cx, ids!(files));
+        for (index, item) in list.items_with_actions(actions) {
+            // On the way down: the row under the pointer becomes another
+            // template as it is selected, and the way up is lost with it.
+            if let Some(down) = item.as_view().finger_down(actions) {
+                if down.tap_count >= 2 {
+                    self.activate(cx, index);
+                    return;
+                }
+                self.select(cx, Some(index));
+            }
+        }
+    }
+
+    fn handle_key(&mut self, cx: &mut Cx, ke: &KeyEvent) {
+        let command = ke.modifiers.is_primary();
+        match ke.key_code {
+            KeyCode::Escape => self.cancel(cx),
+            KeyCode::ReturnKey | KeyCode::NumpadEnter => {
+                if let Some(index) = self.selected {
+                    self.activate(cx, index);
+                }
+            }
+            KeyCode::ArrowUp if command => self.go_up(cx),
+            KeyCode::ArrowDown if command => {
+                if let Some(index) = self.selected {
+                    self.activate(cx, index);
+                }
+            }
+            KeyCode::ArrowDown => {
+                let last = self.entries.len().saturating_sub(1);
+                if !self.entries.is_empty() {
+                    self.select(cx, Some(self.selected.map_or(0, |i| (i + 1).min(last))));
+                }
+            }
+            KeyCode::ArrowUp => {
+                if !self.entries.is_empty() {
+                    self.select(cx, Some(self.selected.map_or(0, |i| i.saturating_sub(1))));
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn select(&mut self, cx: &mut Cx, index: Option<usize>) {
+        self.selected = index;
+        if let Some(index) = index {
+            let list = self.view.portal_list(cx, ids!(files));
+            let first = list.first_id();
+            let visible = list.visible_items().max(1);
+            if index < first || index >= first + visible.saturating_sub(1) {
+                list.set_first_id_and_scroll(index.saturating_sub(visible.saturating_sub(2)), 0.0);
+            }
+        }
+        self.paint(cx);
+    }
+
+    /// A folder is gone into; a file is the answer.
+    fn activate(&mut self, cx: &mut Cx, index: usize) {
+        let Some(entry) = self.entries.get(index).cloned() else {
+            return;
+        };
+        if entry.is_dir {
+            self.go_to(cx, entry.path);
+        } else {
+            self.dismiss(cx);
+            cx.widget_action(self.widget_uid(), MpOpenSheetAction::Chosen(entry.path));
+        }
+    }
+
+    /// Up one folder, with the one just left selected.
+    fn go_up(&mut self, cx: &mut Cx) {
+        let Some(parent) = self.dir.parent().map(Path::to_path_buf) else {
+            return;
+        };
+        let left = self.dir.clone();
+        self.go_to(cx, parent);
+        let index = self.entries.iter().position(|entry| entry.path == left);
+        self.select(cx, index);
+    }
+
+    fn cancel(&mut self, cx: &mut Cx) {
+        self.dismiss(cx);
+        cx.widget_action(self.widget_uid(), MpOpenSheetAction::Cancelled);
+    }
+}
+
+impl MpOpenSheetRef {
+    pub fn present(&self, cx: &mut Cx, home: &Path, start: &Path, extensions: &[&str], kind: &str) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.present(cx, home, start, extensions, kind);
+        }
+    }
+
+    pub fn is_open(&self) -> bool {
+        self.borrow().is_some_and(|inner| inner.is_open())
+    }
+
+    pub fn refresh(&self, cx: &mut Cx) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.refresh(cx);
+        }
+    }
+}
+
+/// A tool or button that cannot be used now: it stays where it is, dimmed. Its
+/// label follows the button's own disabled state, its glyph has none.
+pub fn set_enabled(widget: &WidgetRef, cx: &mut Cx, enabled: bool) {
+    let button = widget.as_button();
+    button.set_enabled(cx, enabled);
+    if let Some(mut inner) = button.borrow_mut() {
+        inner.draw_icon.opacity = if enabled { 1.0 } else { 0.35 };
+    }
+    widget.set_disabled(cx, !enabled);
+}
+
+/// One form of a two-form control (a tool and its pressed look) going or coming.
+/// The form that goes leaves with the pointer on it, and it hears no more of
+/// the pointer: without this it comes back with a plate and no pointer near.
+pub fn show_form(widget: &WidgetRef, cx: &mut Cx, show: bool) {
+    if !show && widget.visible() {
+        widget.as_button().reset_hover(cx);
+    }
+    widget.set_visible(cx, show);
+}
+
+/// Whether a hosted app asks with this sheet rather than the platform's panel.
+/// `--open-home=<dir>` is how a test on a Mac sees what other systems get.
+pub fn sheet_instead() -> bool {
+    !cfg!(target_os = "macos") || std::env::args().any(|arg| arg.starts_with("--open-home="))
+}
+
+/// The person's home folder, whichever way this platform names it.
+pub fn home_folder() -> PathBuf {
+    std::env::var_os("HOME")
+        .or_else(|| std::env::var_os("USERPROFILE"))
+        .map(PathBuf::from)
+        .unwrap_or_else(|| PathBuf::from("/"))
+}
+
+/// What the header calls a folder: its name, "Home" for the home folder, and
+/// the volume's own name at the top.
+fn folder_title(dir: &Path, home: &Path) -> String {
+    if dir == home {
+        return "Home".to_string();
+    }
+    match dir.file_name() {
+        Some(name) => name.to_string_lossy().to_string(),
+        None => "Computer".to_string(),
+    }
+}
+
+/// A folder's lines: its folders first, then the files this viewer opens, each
+/// group by name as a person reads them. Hidden files stay hidden.
+pub fn list_folder(dir: &Path, extensions: &[String]) -> Vec<OpenEntry> {
+    let Ok(read) = std::fs::read_dir(dir) else {
+        return Vec::new();
+    };
+    let mut entries: Vec<OpenEntry> = read
+        .filter_map(|entry| entry.ok())
+        .filter_map(|entry| {
+            let name = entry.file_name().to_string_lossy().to_string();
+            if name.starts_with('.') {
+                return None;
+            }
+            let path = entry.path();
+            // A link to a folder is a folder.
+            let meta = std::fs::metadata(&path).ok()?;
+            let is_dir = meta.is_dir();
+            if !is_dir && !has_extension(&path, extensions) {
+                return None;
+            }
+            let date = meta
+                .modified()
+                .ok()
+                .and_then(|time| time.duration_since(UNIX_EPOCH).ok())
+                .map(|age| format_date(age.as_secs() as i64, local_offset()))
+                .unwrap_or_default();
+            Some(OpenEntry { name, path, is_dir, date })
+        })
+        .collect();
+    entries.sort_by(|a, b| {
+        b.is_dir.cmp(&a.is_dir).then_with(|| a.name.to_lowercase().cmp(&b.name.to_lowercase()))
+    });
+    entries
+}
+
+fn has_extension(path: &Path, extensions: &[String]) -> bool {
+    path.extension()
+        .and_then(|e| e.to_str())
+        .is_some_and(|e| extensions.iter().any(|known| known.eq_ignore_ascii_case(e)))
+}
+
+/// A day as a Mac's list shows it: "Nov 2, 2026".
+pub fn format_date(secs: i64, offset_secs: i64) -> String {
+    const MONTHS: [&str; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+    // Howard Hinnant's civil_from_days.
+    let z = (secs + offset_secs).div_euclid(86_400) + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z.rem_euclid(146_097);
+    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let day = doy - (153 * mp + 2) / 5 + 1;
+    let month = if mp < 10 { mp + 3 } else { mp - 9 };
+    let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };
+    format!("{} {}, {}", MONTHS[(month as usize - 1).min(11)], day, year)
+}
+
+/// The machine's offset from UTC, asked once of its own `date`, which knows
+/// about daylight saving: the platform has no time zone database.
+pub fn local_offset() -> i64 {
+    static OFFSET: std::sync::OnceLock<i64> = std::sync::OnceLock::new();
+    *OFFSET.get_or_init(|| {
+        let Ok(out) = std::process::Command::new("date").arg("+%z").output() else {
+            return 0;
+        };
+        parse_offset(String::from_utf8_lossy(&out.stdout).trim())
+    })
+}
+
+/// `+0200` or `-0730`, in seconds east of UTC.
+fn parse_offset(text: &str) -> i64 {
+    if text.len() < 5 || !text.is_ascii() {
+        return 0;
+    }
+    let (Ok(hours), Ok(minutes)) = (text[1..3].parse::<i64>(), text[3..5].parse::<i64>()) else {
+        return 0;
+    };
+    let magnitude = hours * 3600 + minutes * 60;
+    match text.as_bytes()[0] {
+        b'-' => -magnitude,
+        b'+' => magnitude,
+        _ => 0,
+    }
+}
+
+#[cfg(test)]
+mod open_panel_tests {
+    use super::*;
+
+    #[test]
+    fn a_day_reads_as_a_mac_writes_it() {
+        // 2026-11-02 12:00 UTC.
+        assert_eq!(format_date(1_793_620_800, 0), "Nov 2, 2026");
+        // That evening in Tokyo is already the next day.
+        assert_eq!(format_date(1_793_620_800, 13 * 3600), "Nov 3, 2026");
+        assert_eq!(parse_offset("-0700"), -7 * 3600);
+        assert_eq!(parse_offset("+0530"), 5 * 3600 + 1800);
+        assert_eq!(parse_offset("nonsense"), 0);
+    }
+
+    #[test]
+    fn a_folder_lists_its_folders_then_what_opens() {
+        let dir = std::env::temp_dir().join(format!("open-panel-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&dir);
+        std::fs::create_dir_all(dir.join("Zebra")).unwrap();
+        std::fs::create_dir_all(dir.join("albums")).unwrap();
+        for name in ["b.PNG", "a.png", "notes.txt", ".hidden.png"] {
+            std::fs::write(dir.join(name), b"x").unwrap();
+        }
+        let names: Vec<String> =
+            list_folder(&dir, &["png".to_string()]).into_iter().map(|entry| entry.name).collect();
+        assert_eq!(names, ["albums", "Zebra", "a.png", "b.PNG"]);
+        assert!(list_folder(&dir.join("not here"), &["png".to_string()]).is_empty());
+        let _ = std::fs::remove_dir_all(&dir);
+    }
+
+    #[test]
+    fn the_header_names_a_folder_as_a_person_would() {
+        let home = Path::new("/Users/someone");
+        assert_eq!(folder_title(home, home), "Home");
+        assert_eq!(folder_title(&home.join("Pictures"), home), "Pictures");
+        assert_eq!(folder_title(Path::new("/"), home), "Computer");
+    }
+}
