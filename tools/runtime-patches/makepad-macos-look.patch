+    /// Show `text` as if the program had printed it, ahead of anything it
+    /// prints: a tab that comes back shows what it showed before Terminal
+    /// quit. Only its printable characters and its line breaks are shown.
+    pub fn show_text(&mut self, text: &str) {
+        let mut shown = String::with_capacity(text.len() + 2);
+        for c in text.chars() {
+            match c {
+                '\n' => shown.push_str("\r\n"),
+                c if c.is_control() => {}
+                c => shown.push(c),
+            }
+        }
+        shown.push_str("\r\n");
+        let _ = self.sync.feed(shown.as_bytes(), &mut self.stream, &mut self.terminal, Cx::monotonic_now());
+    }
+
+    /// The primary screen's text, its history too, through the cursor's row:
+    /// what this tab shows again when its window comes back.
+    pub fn restorable_text(&self) -> String {
+        let screen = &self.terminal.primary;
+        let last = (screen.scrollback.len() + screen.cursor.y).min(screen.total_rows().saturating_sub(1));
+        let text = screen.selection_text((screen.absolute_of_virtual(0), 0), (screen.absolute_of_virtual(last), screen.cols));
+        text.trim_end().to_owned()
+    }
