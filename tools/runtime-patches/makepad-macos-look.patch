+/// "3:45 PM", the way a Mac says a time.
+pub fn format_clock_12h(ms: i64) -> String {
+    let mins = ms.rem_euclid(DAY_MS) / 60_000;
+    let (hour, minute) = (mins / 60, mins % 60);
+    let shown = if hour % 12 == 0 { 12 } else { hour % 12 };
+    format!("{shown}:{minute:02} {}", if hour < 12 { "AM" } else { "PM" })
+}
+
+/// A note's date in a list on a Mac: "3:45 PM", "Yesterday", "Oct 30", and
+/// "Oct 30, 2025" from another year.
+pub fn format_note_date_mac(edited_ms: i64, now_ms: i64) -> String {
+    let day = utc_day(edited_ms);
+    let today = utc_day(now_ms);
+    if day == today {
+        format_clock_12h(edited_ms)
+    } else if day == today - 1 {
+        "Yesterday".to_string()
+    } else {
+        let (y, m, d) = civil::to_ymd(day);
+        let (ny, _, _) = civil::to_ymd(today);
+        let month = MONTH_ABBR[(m.saturating_sub(1) % 12) as usize];
+        if y == ny {
+            format!("{month} {d}")
+        } else {
+            format!("{month} {d}, {y}")
+        }
+    }
+}
+
+/// A note's date over its text on a Mac: "Nov 2, 2026 at 3:45 PM".
+pub fn format_note_stamp_mac(edited_ms: i64) -> String {
+    let (y, m, d) = civil::to_ymd(utc_day(edited_ms));
+    let month = MONTH_ABBR[(m.saturating_sub(1) % 12) as usize];
+    format!("{month} {d}, {y} at {}", format_clock_12h(edited_ms))
+}
