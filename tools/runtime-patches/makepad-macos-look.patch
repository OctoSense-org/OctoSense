+fn insert_random(doc: &mut CalculatorDoc, ui: &mut UiState, bits: u64) {
+    if doc.session.phase == Phase::Result || doc.session.phase == Phase::Error {
+        after_result_new_entry(doc, ui, false);
+    }
+    // 53 bits fill a double's mantissa: the result stays below 1.
+    let value = (bits >> 11) as f64 / (1u64 << 53) as f64;
+    let literal = roundtrip_literal(value);
+    // It takes the place of a number being entered, or the two would run
+    // together into one.
+    if let Some(start) = tokenize(&doc.session.source)
+        .ok()
+        .and_then(|tokens| tokens.last().filter(|t| matches!(t.kind, TokenKind::Number(_))).map(|t| t.start))
+    {
+        doc.session.source.truncate(start);
+    }
+    doc.session.source.push_str(&literal);
+    ui.clear_is_ac = false;
+    refresh_preview(doc, ui);
+}
