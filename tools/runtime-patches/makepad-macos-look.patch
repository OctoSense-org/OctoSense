+    fn heard_storage(&mut self, cx: &mut Cx, responses: &[StorageResponse]) {
+        let stored = |response: &StorageResponse| match &response.result {
+            Ok(StorageResult::Value(Some(bytes))) => places::decode(bytes),
+            _ => Vec::new(),
+        };
