+#[cfg(test)]
+mod key_focus_tests {
+    use super::*;
+    use crate::{area::RectArea, draw_list::DrawList};
+
+    fn two_views(cx: &mut Cx) -> (Area, Area) {
+        let draw_list_id = DrawList::new(cx).id();
+        let view = |rect_id| Area::Rect(RectArea { draw_list_id, rect_id, redraw_id: 0 });
+        (view(1), view(2))
+    }
+
+    /// The end of an event: the keyboard goes where it was asked to.
+    fn end_event(cx: &mut Cx) {
+        cx.keyboard.cycle_key_focus_changed();
+    }
+
+    #[test]
+    fn a_press_alone_marks_the_keyboard_and_asking_for_it_clears_the_mark() {
+        let mut cx = Cx::new(Box::new(|_cx: &mut Cx, _event: &Event| {}));
+        let (canvas, field) = two_views(&mut cx);
+        assert!(!cx.key_focus_pressed());
+        cx.set_key_focus_on_press(canvas);
+        end_event(&mut cx);
+        assert_eq!(cx.key_focus(), canvas);
+        assert!(cx.key_focus_pressed());
+        // Pressed again, it is still a view a press gave the keyboard to.
+        cx.set_key_focus_on_press(canvas);
+        end_event(&mut cx);
+        assert!(cx.key_focus_pressed());
+        // The same view asks for it: now it reads keys.
+        cx.set_key_focus(canvas);
+        end_event(&mut cx);
+        assert_eq!(cx.key_focus(), canvas);
+        assert!(!cx.key_focus_pressed());
+        // A field that asked for it earlier in the event keeps its standing when its press follows.
+        cx.set_key_focus(field);
+        cx.set_key_focus_on_press(field);
+        end_event(&mut cx);
+        assert_eq!(cx.key_focus(), field);
+        assert!(!cx.key_focus_pressed());
+    }
+
+    #[test]
+    fn the_mark_goes_back_with_the_keyboard_and_comes_back_after_a_sheet() {
+        let mut cx = Cx::new(Box::new(|_cx: &mut Cx, _event: &Event| {}));
+        let (canvas, field) = two_views(&mut cx);
+        cx.set_key_focus_on_press(canvas);
+        end_event(&mut cx);
+        cx.set_key_focus(field);
+        end_event(&mut cx);
+        assert!(!cx.key_focus_pressed());
+        // A press that takes the keyboard back gives the canvas its mark too.
+        cx.revert_key_focus();
+        end_event(&mut cx);
+        assert_eq!(cx.key_focus(), canvas);
+        assert!(cx.key_focus_pressed());
+        // A sheet comes up over the canvas and leaves.
+        cx.sheet_takes_keyboard(7);
+        end_event(&mut cx);
+        assert!(cx.key_focus().is_empty());
+        assert!(!cx.key_focus_pressed());
+        assert_eq!(cx.sheet_left_keyboard(7), Some((canvas, true)));
+        assert_eq!(cx.sheet_left_keyboard(7), None);
+        cx.restore_key_focus(canvas, true);
+        end_event(&mut cx);
+        assert_eq!(cx.key_focus(), canvas);
+        assert!(cx.key_focus_pressed());
+        // A field under a sheet comes back a field.
+        cx.set_key_focus(field);
+        end_event(&mut cx);
+        cx.sheet_takes_keyboard(7);
+        end_event(&mut cx);
+        assert_eq!(cx.sheet_left_keyboard(7), Some((field, false)));
+        cx.restore_key_focus(field, false);
+        end_event(&mut cx);
+        assert_eq!(cx.key_focus(), field);
+        assert!(!cx.key_focus_pressed());
+    }
+}
