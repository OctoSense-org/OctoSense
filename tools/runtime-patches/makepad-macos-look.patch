+pub const POINTER_UNIFIED_BAR: f64 = 52.0;
+
+/// A pointer's window: what the person chose it to show, apart from the
+/// document. The default is the window a Mac opens: the basic keys alone.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct PointerView {
+    pub scientific: bool,
+    pub history: bool,
+}
+
+impl PointerView {
+    pub fn encode(self) -> Vec<u8> {
+        let mut out = Vec::new();
+        if self.scientific {
+            out.extend_from_slice(b"scientific ");
+        }
+        if self.history {
+            out.extend_from_slice(b"history ");
+        }
+        out
+    }
+
+    /// Anything it does not recognise is the default: this is a preference,
+    /// and losing it costs a click.
+    pub fn decode(bytes: &[u8]) -> Self {
+        let text = std::str::from_utf8(bytes).unwrap_or("");
+        Self {
+            scientific: text.split_whitespace().any(|w| w == "scientific"),
+            history: text.split_whitespace().any(|w| w == "history"),
+        }
+    }
+
+    /// The window this view's keys fill exactly, at their natural 56 by 44
+    /// points, under a toolbar `bar` points high (`POINTER_BAR` or
+    /// `POINTER_UNIFIED_BAR`): a Mac's Calculator window hugs its keypad.
+    pub fn natural_size(self, bar: f64) -> (f64, f64) {
+        let mut width = POINTER_BASIC_WIDTH;
+        if self.scientific {
+            width += POINTER_SCIENTIFIC_EXTRA;
+        }
+        if self.history {
+            width += POINTER_TAPE_WIDTH;
+        }
+        (width, bar + POINTER_KEYS_HEIGHT)
+    }
+
+}
 
