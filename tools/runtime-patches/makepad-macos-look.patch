+/// A pair of `~~`, or of `<u>` and `</u>`, on one line.
+#[derive(Clone, Copy)]
+struct LineMark {
+    left: usize,
+    left_len: usize,
+    right: usize,
+    right_len: usize,
+    underline: bool,
+}
+
+/// `~~` around struck text and `<u>` … `</u>` around underlined text: a pair on
+/// one line, around more than blanks. A token with no partner is only text.
+fn line_marks(source: &str, start: usize, end: usize) -> Vec<LineMark> {
+    let mut pairs = Vec::new();
+    let (mut strike, mut underline): (Option<usize>, Option<usize>) = (None, None);
+    let mut at = start;
+    while at < end {
+        let rest = &source[at..end];
+        if rest.starts_with('\\') {
+            at += 1;
+            if at < end {
+                at += source[at..end].chars().next().unwrap().len_utf8();
+            }
+        } else if rest.starts_with("~~") {
+            match strike.take() {
+                Some(left) if !source[left + 2..at].trim().is_empty() => pairs.push(LineMark {
+                    left,
+                    left_len: 2,
+                    right: at,
+                    right_len: 2,
+                    underline: false,
+                }),
+                Some(_) => {}
