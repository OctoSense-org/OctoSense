+    assert_eq!(view.list_sheet, Some(ListSheet::Unreadable));
+    view.cancel_list_sheet(&mut cx);
+    assert_eq!(view.list_sheet, Some(ListSheet::StartOver));
+    assert!(view.mac_key(&mut cx, &escape));
+    assert_eq!(view.list_sheet, Some(ListSheet::Unreadable));
+    // Start Over gives a new document, with nothing to ask.
+    view.cancel_list_sheet(&mut cx);
+    view.commit_list_sheet(&mut cx);
+    assert_eq!(view.list_sheet, None);
+    assert!(view.load_error.is_none());
+    assert!(view.document.is_some());
+}
+
+#[test]
+fn a_macs_details_apply_each_change_as_it_is_made() {
+    let (mut cx, root) = root();
+    let mut view = root.borrow_mut::<RemindersView>().unwrap();
+    mac_work_list(&mut view, &mut cx);
+    let original = open_twelve(&mut view, &mut cx);
+    view.draft_seeded = true;
+    let twelve = |view: &RemindersView| view.document.as_ref().unwrap().reminder(12).unwrap().clone();
+    // A changed title is the reminder's at once, with nothing pressed.
+    view.draft_fields.as_mut().unwrap().title = "Renamed".into();
+    view.apply_live(&mut cx);
+    assert_eq!(twelve(&view).title, "Renamed");
+    assert!(view.draft.is_some(), "the details stay open");
+    view.draft_fields.as_mut().unwrap().flagged = !original.flagged;
+    view.apply_live(&mut cx);
+    assert_eq!(twelve(&view).flagged, !original.flagged);
+    // An empty title can't be kept: the last good one stays, as it does when
+    // the details close.
+    view.draft_fields.as_mut().unwrap().title = "  ".into();
+    view.apply_live(&mut cx);
+    assert_eq!(twelve(&view).title, "Renamed");
+    view.close_details(&mut cx);
+    assert!(view.draft.is_none());
+    assert_eq!((twelve(&view).title.as_str(), twelve(&view).flagged), ("Renamed", !original.flagged));
+}
+
+#[test]
+fn a_starter_list_can_be_deleted_and_new_reminders_find_a_list_that_is_there() {
+    let (mut cx, root) = root();
+    let mut view = root.borrow_mut::<RemindersView>().unwrap();
+    view.pointer = true;
+    view.open_list_sheet(&mut cx, ListSheet::Delete(HOME_LIST_ID));
+    view.commit_list_sheet(&mut cx);
+    assert_eq!(view.list_sheet, None);
+    let doc = view.document.clone().unwrap();
+    assert!(doc.list(HOME_LIST_ID).is_none());
+    assert!(!doc.reminders.iter().any(|item| item.list_id == HOME_LIST_ID));
+    let defaults = view.fit(home_create_defaults());
+    assert!(doc.list(defaults.list_id).is_some());
+}
