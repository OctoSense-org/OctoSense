+    /// The World Clock fills its page as the Mac's does: every place in view
+    /// at once, the dials as large as the page lets them be, wrapping into
+    /// rows (the fewest empty places in the last one, then the fewest rows).
+    /// A page too small for every place at its smallest dial keeps that dial,
+    /// as many across as fit, and scrolls.
+    fn size_world(&mut self, cx: &mut Cx, size: Vec2d) {
+        /// A cell's room beside its dial, and over and under it for the name
+        /// and the time.
+        const SIDE: f64 = 40.0;
+        const TEXT: f64 = 66.0;
+        /// The grid's `wrap_spacing` between rows.
+        const GAP: f64 = 6.0;
+        const DIAL_MIN: f64 = 96.0;
+        const DIAL_MAX: f64 = 240.0;
+        let bar = if self.toolbar_lead >= 84.0 { 52.0 } else { 40.0 };
+        let room = (size.x - 48.0).max(120.0);
+        // Under the toolbar and its rule, inside the page's 18 at each end.
+        let tall = (size.y - bar - 1.0 - 36.0).max(0.0);
+        let shown = (self.world.len() + 1).clamp(1, WORLD_CELLS);
+        let mut best: Option<(f64, usize, usize)> = None;
+        for columns in 1..=shown {
+            let rows = shown.div_ceil(columns);
+            let cell_w = (room / columns as f64).floor();
+            let cell_h = ((tall - GAP * (rows - 1) as f64) / rows as f64).floor();
+            let dial = (cell_w - SIDE).min(cell_h - TEXT).min(DIAL_MAX).floor();
+            let empty = rows * columns - shown;
+            let better = match best {
+                None => true,
+                Some((d, e, _)) => dial > d || (dial == d && empty < e) || (dial == d && empty == e),
+            };
+            if better {
+                best = Some((dial, empty, columns));
+            }
+        }
+        let (dial, columns) = match best {
+            Some((dial, _, columns)) if dial >= DIAL_MIN => (dial, columns),
+            _ => {
+                let columns = ((room / 170.0).floor().max(1.0) as usize).min(shown);
+                let cell_w = (room / columns as f64).floor();
+                ((cell_w - SIDE).clamp(DIAL_MIN, 132.0), columns)
+            }
+        };
+        let rows = shown.div_ceil(columns);
+        let cell_width = (room / columns as f64).floor();
+        // The dial sits 10 under the cell's top: the same under the text.
+        let cell_height = dial + TEXT;
+        // The numerals grow with the dial, from the 132-point dial's 8.25.
+        let numerals = (dial * 8.25 / 132.0).clamp(8.25, 12.0);
+        for index in 0..WORLD_CELLS {
+            let mut cell = self.view.widget(cx, world_cell(index));
+            script_apply_eval!(cx, cell, { width: #(cell_width) height: #(cell_height) });
+            let mut face = cell.widget(cx, ids!(dial));
+            script_apply_eval!(cx, face, { width: #(dial) height: #(dial) numeral_size: #(numerals) });
+        }
+        let inset = ((room - shown.min(columns) as f64 * cell_width) * 0.5).max(0.0).floor();
+        let grid_h = rows as f64 * cell_height + GAP * (rows - 1) as f64;
+        let top = ((tall - grid_h) * 0.5).max(0.0).floor();
+        if let Some(mut grid) = self.view.view(cx, ids!(world_grid)).borrow_mut() {
+            grid.layout.padding.left = inset;
+            grid.layout.padding.top = top;
+        }
+    }
