+        let target = self.context_note.or(self.ui.selected);
+        match action {
+            MenuAction::Pin => {
+                if let Some(id) = target {
+                    self.note_mutation(cx, id, live_id!(pin));
+                }
+            }
+            MenuAction::MoveTo(folder) => {
+                self.flush_editor(cx);
+                if let Some(id) = target {
+                    let result = engine::move_note(&mut self.doc, id, folder);
+                    self.after_mutation(cx, result);
+                }
+            }
+            MenuAction::Delete => {
+                if let Some(id) = target {
+                    self.note_mutation(cx, id, live_id!(delete));
+                }
+            }
+            MenuAction::Restore => {
+                if let Some(id) = target {
+                    self.note_mutation(cx, id, live_id!(restore));
+                }
+            }
+            MenuAction::Erase => {
+                if let Some(id) = target {
+                    self.open_sheet(cx, SheetKind::EraseNote(id));
+                }
+            }
+            MenuAction::Undo => self.undo_edit(cx, false),
+            MenuAction::Redo => self.undo_edit(cx, true),
+            MenuAction::Open(collection) => self.open_collection(cx, collection),
+            MenuAction::NewFolder => self.open_sheet(cx, SheetKind::NewFolder),
+            MenuAction::NewNote => self.new_note(cx),
+            MenuAction::RenameFolder(id) => self.open_sheet(cx, SheetKind::RenameFolder(id)),
+            MenuAction::DeleteFolder(id) => self.open_sheet(cx, SheetKind::DeleteFolder(id)),
+            MenuAction::EmptyDeleted => self.open_sheet(cx, SheetKind::EmptyDeleted),
+        }
+        self.redraw(cx);
+    }
+    fn open_sheet(&mut self, cx: &mut Cx, kind: SheetKind) {
+        if kind.is_alert() {
+            // An alert leaves what is being written as it is, and gives the
+            // note the keys back when it goes. (A save now would clear the
+            // failure it reports.)
+            let focused = self.surface(cx).borrow::<NotesTextSurface>().is_some_and(|s| s.is_focused(cx));
+            self.refocus_note |= focused;
+        } else {
+            self.flush_editor(cx);
+        }
+        if let Some(mut surface) = self.surface(cx).borrow_mut::<NotesTextSurface>() {
+            surface.finish(cx);
+        }
+        self.sheet_name = match kind {
+            SheetKind::RenameFolder(id) => self.doc.folder_name(FolderId::Custom(id)),
+            _ => String::new(),
+        };
+        self.sheet = Some(kind);
+        self.sheet_error = None;
+        self.sync_sheet(cx);
+        if matches!(kind, SheetKind::NewFolder | SheetKind::RenameFolder(_)) {
+            self.view.text_input(cx, ids!(notes_sheet.sheet_name)).take_key_focus(cx);
+        }
+        self.redraw(cx);
+    }
+    fn close_sheet(&mut self, cx: &mut Cx) {
+        self.sheet = None;
+        self.sheet_error = None;
+        self.sync_sheet(cx);
+        if std::mem::take(&mut self.refocus_note) {
+            if let Some(mut surface) = self.surface(cx).borrow_mut::<NotesTextSurface>() {
+                surface.focus(cx);
+            }
+        } else {
+            cx.set_key_focus(Area::Empty);
+        }
+        // A save that failed behind another sheet is reported now.
+        self.ask_if_not_saved(cx);
+        self.redraw(cx);
+    }
+    /// A sheet's other way out: Cancel, Not Now, or an unreadable file's Start Over….
+    fn cancel_sheet(&mut self, cx: &mut Cx) {
+        match self.sheet {
+            Some(SheetKind::Unreadable) => self.open_sheet(cx, SheetKind::StartOver),
+            // Not Now keeps the window: a close waiting on the save waits no more.
+            Some(SheetKind::NotSaved) => {
+                self.closing = false;
+                self.close_sheet(cx);
+            }
+            // Notes that can't be read stay under their alert.
+            Some(SheetKind::StartOver) if self.load == LoadState::Error => {
+                self.open_sheet(cx, SheetKind::Unreadable)
+            }
+            _ => self.close_sheet(cx),
+        }
+    }
+    fn sync_sheet(&mut self, cx: &mut Cx) {
+        if !self.pointer {
+            return;
+        }
+        let sheet = self.view.widget(cx, ids!(notes_sheet));
+        sheet.set_visible(cx, self.sheet.is_some());
+        let Some(kind) = self.sheet else {
+            return;
+        };
+        let names = matches!(kind, SheetKind::NewFolder | SheetKind::RenameFolder(_));
+        let (title, note) = match kind {
+            SheetKind::NewFolder => ("New Folder".to_string(), String::new()),
+            SheetKind::RenameFolder(_) => ("Rename Folder".to_string(), String::new()),
+            SheetKind::DeleteFolder(id) => {
+                let folder = FolderId::Custom(id);
+                let total = self.doc.notes.iter().filter(|n| !n.is_deleted() && n.folder == folder).count();
+                let note = match total {
+                    0 => "It has no notes in it.".to_string(),
+                    1 => "Its note goes to Recently Deleted.".to_string(),
+                    total => format!("Its {total} notes go to Recently Deleted."),
+                };
+                (format!("Delete “{}”?", self.doc.folder_name(folder)), note)
+            }
+            SheetKind::EraseNote(id) => {
+                let title = self.doc.note(id).map_or_else(String::new, |n| engine::display_title(&n.source));
+                (format!("Delete “{title}” Now?"), "This can’t be undone.".to_string())
+            }
+            SheetKind::StartOver => (
+                "Start Over With No Notes?".to_string(),
+                "The notes that are saved will be replaced. This can’t be undone.".to_string(),
+            ),
+            SheetKind::Unreadable => (
+                "Your Notes Can’t Be Opened".to_string(),
+                "They couldn’t be read. Nothing has been changed.".to_string(),
+            ),
+            SheetKind::NotSaved => (
+                "Changes Not Saved".to_string(),
+                "Your latest changes couldn’t be saved. They stay in this window, and Notes tries again with your next change.".to_string(),
+            ),
+            SheetKind::Refused => {
+                let (title, note) = refused_alert(self.edit_error.as_deref().unwrap_or(""));
+                (title.to_string(), note.to_string())
+            }
+            SheetKind::EmptyDeleted => {
+                let total = self.doc.notes.iter().filter(|n| n.is_deleted()).count();
+                let title = if total == 1 { "Delete 1 Note Now?".to_string() } else { format!("Delete {total} Notes Now?") };
+                (title, "This can’t be undone.".to_string())
+            }
+        };
+        sheet.label(cx, ids!(sheet_title)).set_text(cx, &title);
+        sheet.widget(cx, ids!(sheet_note)).set_visible(cx, !names);
+        sheet.label(cx, ids!(sheet_note)).set_text(cx, &note);
+        sheet.widget(cx, ids!(sheet_form)).set_visible(cx, names);
+        let field = sheet.text_input(cx, ids!(sheet_name));
+        if field.text() != self.sheet_name {
+            field.set_text(cx, &self.sheet_name);
+        }
+        sheet.widget(cx, ids!(sheet_error)).set_visible(cx, self.sheet_error.is_some());
+        sheet.label(cx, ids!(sheet_error)).set_text(cx, self.sheet_error.unwrap_or(""));
+        // A name's sheet and an alert: Cancel (or the alert's other way) and
+        // the default. A question before something goes for good: Cancel is
+        // the default, beside the red word.
+        let alert = kind.is_alert();
+        let (other, default) = match kind {
+            SheetKind::Unreadable => ("Start Over…", "Try Again"),
+            SheetKind::NotSaved => ("Not Now", "Try Again"),
+            _ => ("Cancel", "OK"),
+        };
+        let cancel = sheet.widget(cx, ids!(sheet_cancel));
+        cancel.set_visible(cx, names || (alert && kind != SheetKind::Refused));
+        if cancel.text() != other {
+            cancel.set_text(cx, other);
+        }
+        let ok = sheet.widget(cx, ids!(sheet_ok));
+        ok.set_visible(cx, names || alert);
+        if ok.text() != default {
+            ok.set_text(cx, default);
+        }
+        sheet.widget(cx, ids!(sheet_keep)).set_visible(cx, !names && !alert);
+        let destructive = sheet.widget(cx, ids!(sheet_destructive));
+        destructive.set_visible(cx, !names && !alert);
+        let word = if kind == SheetKind::StartOver { "Start Over" } else { "Delete" };
+        if destructive.text() != word {
+            destructive.set_text(cx, word);
+        }
+        let valid = alert || (!self.sheet_name.trim().is_empty() && self.sheet_error.is_none());
+        sheet.button(cx, ids!(sheet_ok)).set_enabled(cx, valid);
+        let ok = sheet.widget(cx, ids!(sheet_ok));
+        if ok.disabled(cx) == valid {
+            ok.set_disabled(cx, !valid);
+        }
+    }
+    fn commit_sheet(&mut self, cx: &mut Cx) {
+        let Some(kind) = self.sheet else {
+            return;
+        };
+        let name = self.sheet_name.clone();
+        let refused = match kind {
+            SheetKind::NewFolder => match engine::create_folder(&mut self.doc, &name) {
+                Ok(folder) => {
+                    self.close_sheet(cx);
+                    self.save_now(cx, false);
+                    // It opens, ready for a first note.
+                    self.open_collection(cx, Collection::Folder(folder));
+                    return;
+                }
+                Err(message) => Some(message),
+            },
+            SheetKind::RenameFolder(id) => engine::rename_folder(&mut self.doc, id, &name).err(),
+            SheetKind::DeleteFolder(id) => engine::delete_folder(&mut self.doc, &mut self.ui, id, now_ms()).err(),
+            SheetKind::EraseNote(id) => engine::erase_note(&mut self.doc, &mut self.ui, id).err(),
+            SheetKind::EmptyDeleted => {
+                engine::empty_deleted(&mut self.doc, &mut self.ui);
+                None
+            }
+            SheetKind::StartOver => {
+                self.close_sheet(cx);
+                self.start_over(cx);
+                return;
+            }
+            SheetKind::Unreadable => {
+                self.close_sheet(cx);
+                self.try_loading_again(cx);
+                self.sync_status(cx);
+                self.redraw(cx);
+                return;
+            }
+            SheetKind::NotSaved => {
+                self.close_sheet(cx);
+                // A Try Again that fails too asks again.
+                self.save_reported = false;
+                let effect = reduce_save(&mut self.save, SaveEvent::Retry { now_ms: now_ms() });
+                self.apply_save_effect(cx, effect);
+                self.ask_if_not_saved(cx);
+                self.sync_status(cx);
+                self.redraw(cx);
+                return;
+            }
+            SheetKind::Refused => {
+                self.edit_error = None;
+                self.close_sheet(cx);
+                self.sync_surface(cx);
+                self.redraw(cx);
+                return;
+            }
+        };
+        if let Some(message) = refused {
+            self.sheet_error = Some(message);
+            self.sync_sheet(cx);
+            self.redraw(cx);
+            return;
+        }
+        self.close_sheet(cx);
+        self.refresh_projection();
+        self.save_now(cx, false);
+        self.pending_nav = self.layout.is_compact();
+        self.redraw(cx);
+    }
+    fn sheet_key(&mut self, cx: &mut Cx, key: &KeyEvent) -> bool {
+        let Some(kind) = self.sheet else {
+            return false;
+        };
+        match key.key_code {
+            KeyCode::Escape => {
+                match kind {
+                    // Notes that can't be read have no way round their alert.
+                    SheetKind::Unreadable => {}
+                    SheetKind::Refused => self.commit_sheet(cx),
+                    _ => self.cancel_sheet(cx),
+                }
+                true
+            }
+            KeyCode::ReturnKey | KeyCode::NumpadEnter => {
+                let names = matches!(kind, SheetKind::NewFolder | SheetKind::RenameFolder(_));
+                if kind.is_alert() {
+                    // Try Again (or OK) is an alert's default.
+                    self.commit_sheet(cx);
+                } else if !names {
+                    // A question before something goes for good: Cancel is its default.
+                    self.cancel_sheet(cx);
+                } else if !self.sheet_name.trim().is_empty() && self.sheet_error.is_none() {
+                    self.commit_sheet(cx);
+                }
+                true
+            }
+            _ => false,
+        }
+    }
+    fn sheet_actions(&mut self, cx: &mut Cx, actions: &Actions) {
+        let sheet = self.view.widget(cx, ids!(notes_sheet));
+        if sheet.button(cx, ids!(sheet_cancel)).clicked(actions) || sheet.button(cx, ids!(sheet_keep)).clicked(actions) {
+            self.cancel_sheet(cx);
+            return;
+        }
+        if sheet.button(cx, ids!(sheet_ok)).clicked(actions) || sheet.button(cx, ids!(sheet_destructive)).clicked(actions) {
+            self.commit_sheet(cx);
+            return;
+        }
+        if let Some(text) = sheet.text_input(cx, ids!(sheet_name)).changed(actions) {
+            self.sheet_name = text;
+            self.sheet_error = None;
+            self.sync_sheet(cx);
+            self.redraw(cx);
+        }
+    }
