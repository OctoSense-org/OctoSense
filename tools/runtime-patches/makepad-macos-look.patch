+/// The shortcuts a desktop's settings list, as (what, keys): a Mac's marks on a Mac,
+/// one chord for each action (the Command one on a Mac), the tab numbers on one line,
+/// the system's Paste among them. Nothing here is a file's or a program's name.
+pub fn desk_shortcuts(s: &Settings, mac: bool) -> Vec<(String, String)> {
+    let table = Keybinds::build(&s.keybinds, mac);
+    let chord = |t: &keybinds::Trigger| if mac { keybinds::chord_glyphs(t) } else { keybinds::chord_label(t, false) };
+    let best = |action: &keybinds::Action| {
+        let same = |b: &&keybinds::Binding| std::mem::discriminant(&b.action) == std::mem::discriminant(action) && {
+            // A number is part of what these actions are.
+            match (action, &b.action) {
+                (keybinds::Action::GotoTab(a), keybinds::Action::GotoTab(b)) => a == b,
+                (keybinds::Action::NewSplit(a), keybinds::Action::NewSplit(b)) => a == b,
+                (keybinds::Action::GotoSplit(a), keybinds::Action::GotoSplit(b)) => a == b,
+                (keybinds::Action::NavigateSearch { next: a }, keybinds::Action::NavigateSearch { next: b }) => a == b,
+                _ => true,
+            }
+        };
+        let of_action = || table.bindings.iter().filter(same);
+        of_action().find(|b| b.trigger.mods.sup == mac).or_else(|| of_action().next()).map(|b| b.trigger)
+    };
+    let mut out = Vec::new();
+    for action in keybinds::available_actions() {
+        match action {
+            // Numbered as one line.
+            keybinds::Action::GotoTab(_) => {
+                if let (Some(first), Some(last)) = (best(&keybinds::Action::GotoTab(1)), best(&keybinds::Action::LastTab)) {
+                    out.push(("Show Tab 1 to 9".to_owned(), format!("{} to {}", chord(&first), chord(&last))));
+                }
+            }
+            keybinds::Action::LastTab => {}
+            action => {
+                if let Some(trigger) = best(&action) {
+                    out.push((action.menu_label(), chord(&trigger)));
+                }
+                // The system's, after Copy.
+                if action == keybinds::Action::CopyToClipboard {
+                    out.push(("Paste".to_owned(), if mac { "\u{2318}V" } else { "Ctrl+V" }.to_owned()));
+                }
+            }
+        }
+    }
+    out.retain(|(_, keys)| !keys.is_empty());
+    for binding in &table.bindings {
+        if matches!(binding.action, keybinds::Action::Text { .. }) {
+            out.push((binding.action.menu_label(), chord(&binding.trigger)));
+        }
+    }
+    out
+}
