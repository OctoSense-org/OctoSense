+fn hosted_window_focus(json: &str) -> Option<bool> {
+    match json {
+        r#"{"wm":{"Focus":{"focused":true}}}"# => Some(true),
+        r#"{"wm":{"Focus":{"focused":false}}}"# => Some(false),
+        _ => None,
+    }
