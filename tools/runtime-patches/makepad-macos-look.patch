+/// A number as the status line says it: 432900 is "432,900".
+fn grouped(value: f64) -> String {
+    let text = crate::formula::format_general(value);
+    let (sign, digits) = text.strip_prefix('-').map_or(("", text.as_str()), |d| ("-", d));
