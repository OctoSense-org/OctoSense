+//! The Mac's date and time field: "Nov 9, 2026" or "3:45 PM" in a text field's
+//! face with its little stepper. A click selects a part (month, day, year;
+//! hour, minute, AM or PM), the arrows and the stepper change it, digits type
+//! it. The form reads and writes the model's own text ("2026-11-09", "15:45")
+//! through `Widget::text` and `set_text`, so the Rust that binds a touch
+//! tree's text fields binds this one too.
+use makepad_civil_time as civil;
+use makepad_widgets::*;
+
+script_mod! {
+    use mod.prelude.widgets_internal.*
+    mod.widgets.DateFieldBase = #(DateField::register_widget(vm))
+    mod.widgets.DateField = set_type_default() do mod.widgets.DateFieldBase{
+        width: 132 height: 28
+        text +: {text_style: theme.font_regular{font_size: 9.75} color: theme.color_text}
+        face +: {
+            color: theme.color_bg_app
+            line: uniform(theme.color_text)
+            pixel: fn() {
+                let sdf = Sdf2d.viewport(self.pos * self.rect_size)
+                sdf.box(0.5, 0.5, self.rect_size.x - 1.0, self.rect_size.y - 1.0, 3.0)
+                sdf.fill_keep(self.color)
+                sdf.stroke(self.line, 1.0)
+                return sdf.result
+            }
+        }
+        ring +: {
+            color: theme.color_focus
+            pixel: fn() {
+                let sdf = Sdf2d.viewport(self.pos * self.rect_size)
+                sdf.box(0.5, 0.5, self.rect_size.x - 1.0, self.rect_size.y - 1.0, 3.0)
+                sdf.stroke(self.color, 1.0)
+                return sdf.result
+            }
+        }
+        part +: {
+            color: theme.color_focus
+            pixel: fn() {
+                let sdf = Sdf2d.viewport(self.pos * self.rect_size)
+                sdf.box(0.0, 0.0, self.rect_size.x, self.rect_size.y, 2.0)
+                sdf.fill(self.color)
+                return sdf.result
+            }
+        }
+        // The stepper: the pop-up button's pair of chevrons.
+        arrows +: {
+            color: theme.color_text
+            pixel: fn() {
+                let sdf = Sdf2d.viewport(self.pos * self.rect_size)
+                let c = self.rect_size * 0.5
+                sdf.move_to(c.x - 3.0, c.y - 1.5)
+                sdf.line_to(c.x, c.y - 4.5)
+                sdf.line_to(c.x + 3.0, c.y - 1.5)
+                sdf.stroke(self.color, 1.2)
+                sdf.move_to(c.x - 3.0, c.y + 1.5)
+                sdf.line_to(c.x, c.y + 4.5)
+                sdf.line_to(c.x + 3.0, c.y + 1.5)
+                sdf.stroke(self.color, 1.2)
+                return sdf.result
+            }
+        }
+        on_part: #xffffff
+    }
+}
+
+/// How wide the stepper's column is.
+const STEPPER: f64 = 18.0;
+
+#[derive(Script, ScriptHook, Widget)]
+pub struct DateField {
+    #[uid]
+    uid: WidgetUid,
+    #[source]
+    source: ScriptObjectRef,
+    #[walk]
+    walk: Walk,
+    #[visible]
+    visible: bool,
+    #[redraw]
+    #[rust]
+    area: Area,
+    #[live]
+    text: DrawText,
+    #[live]
+    face: DrawColor,
+    #[live]
+    ring: DrawColor,
+    #[live]
+    part: DrawColor,
+    #[live]
+    arrows: DrawColor,
+    /// The selected part's text.
+    #[live]
+    on_part: Vec4f,
+    /// A time of day rather than a date.
+    #[live]
+    time: bool,
+    /// The value; `None` until the form gives it one.
+    #[rust]
+    day: Option<civil::Day>,
+    #[rust]
+    minute: Option<u16>,
+    /// The selected part: month, day, year or hour, minute, AM/PM.
+    #[rust]
+    active: usize,
+    /// Digits typed into the selected part, not yet taken.
+    #[rust]
+    typed: String,
+    /// Where each part was drawn from the field's left edge, for a click.
+    #[rust]
+    spans: [(f64, f64); 3],
+}
+
+impl DateField {
+    fn parts(&self) -> [String; 3] {
+        if self.time {
+            let (hour, minute, pm) = hour12(self.minute.unwrap_or(9 * 60));
+            [hour.to_string(), format!("{minute:02}"), if pm { "PM" } else { "AM" }.into()]
+        } else {
+            let (year, month, day) = civil::to_ymd(self.day.unwrap_or(0));
+            [civil::MONTH_ABBR[(month - 1) as usize].into(), day.to_string(), year.to_string()]
+        }
+    }
+
+    fn separators(&self) -> [&'static str; 2] {
+        if self.time {
+            [":", " "]
+        } else {
+            [" ", ", "]
+        }
+    }
+
+    /// One step up or down of the selected part. A month or a year that has
+    /// no such day lands on its last one, as a Mac's field does.
+    fn step(&mut self, cx: &mut Cx, by: i32) {
+        self.typed.clear();
+        if self.time {
+            let Some(minute) = self.minute else { return };
+            let minute = minute as i32;
+            let next = match self.active {
+                0 => (minute + by * 60).rem_euclid(24 * 60),
+                1 => minute / 60 * 60 + (minute % 60 + by).rem_euclid(60),
+                _ => (minute + 12 * 60).rem_euclid(24 * 60),
+            };
+            self.minute = Some(next as u16);
+        } else {
+            let Some(day) = self.day else { return };
+            let (year, month, date) = civil::to_ymd(day);
+            self.day = Some(match self.active {
+                0 => {
+                    let month = ((month as i32 - 1 + by).rem_euclid(12) + 1) as u32;
+                    civil::from_ymd(year, month, date.min(civil::days_in_month(year, month)))
+                }
+                1 => {
+                    let last = civil::days_in_month(year, month) as i32;
+                    let date = (date as i32 - 1 + by).rem_euclid(last) + 1;
+                    civil::from_ymd(year, month, date as u32)
+                }
+                _ => {
+                    let year = year + by;
+                    civil::from_ymd(year, month, date.min(civil::days_in_month(year, month)))
+                }
+            });
+        }
+        self.redraw(cx);
+    }
+
+    fn type_digit(&mut self, cx: &mut Cx, digit: u32) {
+        let (low, high, width) = if self.time {
+            match self.active {
+                0 => (1, 12, 2),
+                1 => (0, 59, 2),
+                _ => return,
+            }
+        } else {
+            match self.active {
+                0 => (1, 12, 2),
+                1 => {
+                    let (year, month, _) = civil::to_ymd(self.day.unwrap_or(0));
+                    (1, civil::days_in_month(year, month), 2)
+                }
+                _ => (1, 9999, 4),
+            }
+        };
+        self.typed.push(char::from_digit(digit, 10).unwrap_or('0'));
+        let value = self.typed.parse::<u32>().unwrap_or(0);
+        // Full, or no further digit could still fit.
+        let done = self.typed.len() >= width || value * 10 > high;
+        if done {
+            if value >= low && value <= high {
+                self.take_typed(value);
+            }
+            self.typed.clear();
+            if self.active < 2 {
+                self.active += 1;
+            }
+        }
+        self.redraw(cx);
+    }
+
+    /// What was typed so far, on leaving the part.
+    fn settle_typed(&mut self, cx: &mut Cx) {
+        if self.typed.is_empty() {
+            return;
+        }
+        let value = self.typed.parse::<u32>().unwrap_or(0);
+        let fits = match (self.time, self.active) {
+            (true, 0) | (false, 0) => (1..=12).contains(&value),
+            (true, 1) => value <= 59,
+            (false, 1) => {
+                let (year, month, _) = civil::to_ymd(self.day.unwrap_or(0));
+                value >= 1 && value <= civil::days_in_month(year, month)
+            }
+            (false, _) => (1..=9999).contains(&value),
+            _ => false,
+        };
+        if fits {
+            self.take_typed(value);
+        }
+        self.typed.clear();
+        self.redraw(cx);
+    }
+
+    fn take_typed(&mut self, value: u32) {
+        if self.time {
+            let (_, minute, pm) = hour12(self.minute.unwrap_or(9 * 60));
+            self.minute = Some(match self.active {
+                0 => from_hour12(value, minute, pm),
+                _ => {
+                    let (hour, _, pm) = hour12(self.minute.unwrap_or(9 * 60));
+                    from_hour12(hour, value, pm)
+                }
+            });
+        } else {
+            let (year, month, date) = civil::to_ymd(self.day.unwrap_or(0));
+            self.day = Some(match self.active {
+                0 => civil::from_ymd(year, value, date.min(civil::days_in_month(year, value))),
+                1 => civil::from_ymd(year, month, value),
+                _ => {
+                    let year = value as i32;
+                    civil::from_ymd(year, month, date.min(civil::days_in_month(year, month)))
+                }
+            });
+        }
+    }
+
+    fn select_part(&mut self, cx: &mut Cx, part: usize) {
+        self.settle_typed(cx);
+        self.active = part.min(2);
+        self.redraw(cx);
+    }
+
+    /// The keyboard, as a press on the field gives it.
+    pub fn take_focus(&mut self, cx: &mut Cx) {
+        cx.set_key_focus(self.area);
+        self.redraw(cx);
+    }
+
+    pub fn has_focus(&self, cx: &Cx) -> bool {
+        cx.has_key_focus(self.area)
+    }
+}
+
+/// `(hour on a 12-hour clock, minute, afternoon)` of a minute of the day.
+fn hour12(minute: u16) -> (u32, u32, bool) {
+    let hour = (minute / 60) as u32;
+    let shown = match hour % 12 {
+        0 => 12,
+        other => other,
+    };
+    (shown, (minute % 60) as u32, hour >= 12)
+}
+
+fn from_hour12(hour: u32, minute: u32, pm: bool) -> u16 {
+    let hour = hour % 12 + if pm { 12 } else { 0 };
+    (hour * 60 + minute) as u16
+}
+
+impl Widget for DateField {
+    fn text(&self) -> String {
+        if self.time {
+            self.minute.map(crate::model::format_time).unwrap_or_default()
+        } else {
+            self.day.map(civil::format_iso).unwrap_or_default()
+        }
+    }
+
+    fn set_text(&mut self, cx: &mut Cx, text: &str) {
+        if self.time {
+            self.minute = crate::model::parse_time(text).ok();
+        } else {
+            self.day = crate::model::parse_date(text).ok();
+        }
+        self.typed.clear();
+        self.redraw(cx);
+    }
+
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, _scope: &mut Scope) {
+        if !self.visible {
+            return;
+        }
+        match event.hits(cx, self.area) {
+            Hit::FingerHoverIn(_) => cx.set_cursor(MouseCursor::Default),
+            Hit::FingerDown(e) if e.is_primary_hit() => {
+                cx.set_key_focus(self.area);
+                let rect = self.area.rect(cx);
+                if e.abs.x >= rect.pos.x + rect.size.x - STEPPER {
+                    self.settle_typed(cx);
+                    self.step(cx, if e.abs.y < rect.center().y { 1 } else { -1 });
+                } else {
+                    let at = e.abs.x - rect.pos.x;
+                    let part = self
+                        .spans
+                        .iter()
+                        .position(|(start, end)| at < *end && at >= *start)
+                        .unwrap_or_else(|| {
+                            // Between two parts: the nearer on its left.
+                            self.spans.iter().rposition(|(start, _)| at >= *start).unwrap_or(0)
+                        });
+                    self.select_part(cx, part);
+                }
+            }
+            Hit::KeyFocusLost(_) => {
+                self.settle_typed(cx);
+                self.redraw(cx);
+            }
+            Hit::KeyFocus(_) => self.redraw(cx),
+            Hit::KeyDown(e) if !e.modifiers.any() => {
+                let digit = match e.key_code {
+                    KeyCode::Key0 | KeyCode::Numpad0 => Some(0),
+                    KeyCode::Key1 | KeyCode::Numpad1 => Some(1),
+                    KeyCode::Key2 | KeyCode::Numpad2 => Some(2),
+                    KeyCode::Key3 | KeyCode::Numpad3 => Some(3),
+                    KeyCode::Key4 | KeyCode::Numpad4 => Some(4),
+                    KeyCode::Key5 | KeyCode::Numpad5 => Some(5),
+                    KeyCode::Key6 | KeyCode::Numpad6 => Some(6),
+                    KeyCode::Key7 | KeyCode::Numpad7 => Some(7),
+                    KeyCode::Key8 | KeyCode::Numpad8 => Some(8),
+                    KeyCode::Key9 | KeyCode::Numpad9 => Some(9),
+                    _ => None,
+                };
+                if let Some(digit) = digit {
+                    self.type_digit(cx, digit);
+                    return;
+                }
+                match e.key_code {
+                    KeyCode::ArrowUp => self.step(cx, 1),
+                    KeyCode::ArrowDown => self.step(cx, -1),
+                    KeyCode::ArrowLeft => {
+                        let part = self.active.saturating_sub(1);
+                        self.select_part(cx, part);
+                    }
+                    KeyCode::ArrowRight => {
+                        let part = self.active + 1;
+                        self.select_part(cx, part);
+                    }
+                    KeyCode::KeyA | KeyCode::KeyP if self.time && self.active == 2 => {
+                        let want_pm = e.key_code == KeyCode::KeyP;
+                        if let Some(minute) = self.minute {
+                            if hour12(minute).2 != want_pm {
+                                self.step(cx, 1);
+                            }
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, _scope: &mut Scope, walk: Walk) -> DrawStep {
+        if !self.visible {
+            return DrawStep::done();
+        }
+        cx.begin_turtle(walk, Layout::default());
+        let rect = cx.turtle().rect();
+        self.face.draw_abs(cx, rect);
+        let focused = cx.has_key_focus(self.area);
+        let parts = self.parts();
+        let separators = self.separators();
+        let ink = self.text.color;
+        let measure = |this: &mut Self, cx: &mut Cx2d, text: &str| {
+            let run = this.text.layout(cx, 0.0, 0.0, None, false, Align::default(), text);
+            (run.size_in_lpxs.width as f64, run.size_in_lpxs.height as f64, run.ink_center_offset_in_lpxs() as f64)
+        };
+        let mut x = rect.pos.x + 8.0;
+        for (index, part) in parts.iter().enumerate() {
+            let selected = focused && index == self.active;
+            let shown = if selected && !self.typed.is_empty() { self.typed.clone() } else { part.clone() };
+            let shown = shown.as_str();
+            let (width, height, offset) = measure(self, cx, shown);
+            let y = rect.center().y - height * 0.5 + offset;
+            if selected {
+                self.part.draw_abs(cx, Rect {
+                    pos: dvec2(x - 2.0, rect.center().y - 9.0),
+                    size: dvec2(width + 2.5, 18.0),
+                });
+                self.text.color = self.on_part;
+            }
+            self.text.draw_abs(cx, dvec2(x, y), shown);
+            self.text.color = ink;
+            // From the field's edge: a host may draw it elsewhere than it hits it.
+            self.spans[index] = (x - 2.0 - rect.pos.x, x + width + 2.0 - rect.pos.x);
+            x += width;
+            if let Some(separator) = separators.get(index) {
+                let (width, height, offset) = measure(self, cx, separator);
+                let y = rect.center().y - height * 0.5 + offset;
+                self.text.draw_abs(cx, dvec2(x, y), separator);
+                x += width;
+            }
+        }
+        self.arrows.draw_abs(cx, Rect {
+            pos: dvec2(rect.pos.x + rect.size.x - STEPPER, rect.pos.y),
+            size: dvec2(STEPPER - 2.0, rect.size.y),
+        });
+        if focused {
+            self.ring.draw_abs(cx, rect);
+        }
+        cx.end_turtle_with_area(&mut self.area);
+        DrawStep::done()
+    }
+}
