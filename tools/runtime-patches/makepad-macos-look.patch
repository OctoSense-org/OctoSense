+/// Connects, trying again when the system refuses the attempt. macOS 14 answers
+/// the first connection of a sandboxed process after a quiet spell with EPERM,
+/// although its profile allows the address, and a moment later the same call
+/// works (seen on 14.8.5; 15 and 26 do not do it). A process app that gave up
+/// here would exit before opening a window.
+fn connect_tcp(address: &str) -> std::io::Result<TcpStream> {
+    let mut retries = 4;
+    loop {
+        match TcpStream::connect(address) {
+            Err(err) if err.kind() == std::io::ErrorKind::PermissionDenied && retries > 0 => {
+                retries -= 1;
+                std::thread::sleep(std::time::Duration::from_millis(50));
+            }
+            result => return result,
+        }
+    }
+}
