new file mode 100644
index 0000000000000000000000000000000000000000..62ac8309acfa7f9074505e671460b456bc1665ad
--- /dev/null
+++ b/apps/browser/src/places.rs
@@ -0,0 +1,428 @@
+//! Bookmarks and History: what they hold, kept in the app's own storage as two
+//! plain JSON values. A write replaces a whole value atomically, so a crash
+//! leaves the last one whole; History is capped, so a write stays small.
+
+use makepad_strict_json::{obj, parse_depth, s, Value};
+
+/// The most pages History keeps; the oldest go first.
+pub const HISTORY_CAP: usize = 1000;
+/// The most bookmarks kept. A person will not reach it; a bug can't grow past it.
+pub const BOOKMARK_CAP: usize = 2000;
+/// The longest address and title that are kept. A `data:` page can be megabytes.
+const LONGEST_URL: usize = 8 * 1024;
+const LONGEST_TITLE: usize = 1024;
+/// A stored list is an array of objects of strings.
+const STORED_DEPTH: u32 = 3;
+
+pub const BOOKMARKS_KEY: &str = "bookmarks";
+pub const HISTORY_KEY: &str = "history";
+
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Place {
+    pub url: String,
+    pub title: String,
+    /// Seconds since the epoch: when it was saved, or last visited.
+    pub at: i64,
+}
+
+impl Place {
+    /// What a list shows for it: its title, or where it is when it has none.
+    pub fn name(&self) -> String {
+        if self.title.trim().is_empty() {
+            crate::tabs::host_of(&self.url).unwrap_or_else(|| self.url.clone())
+        } else {
+            self.title.clone()
+        }
+    }
+}
+
+/// What a person could go back to: not the app's own pages, nor a script's address.
+pub fn worth_keeping(url: &str) -> bool {
+    (url.starts_with("http://") || url.starts_with("https://") || url.starts_with("file://")) && url.len() <= LONGEST_URL
+}
+
+fn cut_title(title: &str) -> String {
+    title.chars().take(LONGEST_TITLE).collect()
+}
+
+#[derive(Debug, Default)]
+pub struct Places {
+    /// The last one saved first.
+    pub bookmarks: Vec<Place>,
+    /// The last one visited first, each page once.
+    pub history: Vec<Place>,
+}
+
+impl Places {
+    /// A page opened. It comes to the top of History; it's there once.
+    pub fn visit(&mut self, url: &str, title: &str, at: i64) {
+        if !worth_keeping(url) {
+            return;
+        }
+        self.history.retain(|place| place.url != url);
+        self.history.insert(0, Place { url: url.to_string(), title: cut_title(title), at });
+        self.history.truncate(HISTORY_CAP);
+    }
+
+    /// A page's title came, or changed, after it opened. Says if anything did.
+    pub fn retitle(&mut self, url: &str, title: &str) -> bool {
+        let title = cut_title(title);
+        match self.history.iter_mut().find(|place| place.url == url) {
+            Some(place) if place.title != title => {
+                place.title = title;
+                true
+            }
+            _ => false,
+        }
+    }
+
+    pub fn bookmark(&self, url: &str) -> Option<&Place> {
+        self.bookmarks.iter().find(|place| place.url == url)
+    }
+
+    /// Saves a page, or renames the one saved already, where it is.
+    pub fn save_bookmark(&mut self, url: &str, title: &str, at: i64) {
+        if !worth_keeping(url) {
+            return;
+        }
+        let title = cut_title(title.trim());
+        if let Some(place) = self.bookmarks.iter_mut().find(|place| place.url == url) {
+            place.title = title;
+            return;
+        }
+        self.bookmarks.insert(0, Place { url: url.to_string(), title, at });
+        self.bookmarks.truncate(BOOKMARK_CAP);
+    }
+
+    pub fn remove_bookmark(&mut self, url: &str) {
+        self.bookmarks.retain(|place| place.url != url);
+    }
+
+    pub fn remove_visit(&mut self, url: &str) {
+        self.history.retain(|place| place.url != url);
+    }
+
+    pub fn clear_history(&mut self) {
+        self.history.clear();
+    }
+
+    /// What storage held arrived, after anything that happened meanwhile.
+    pub fn restored_bookmarks(&mut self, stored: Vec<Place>) {
+        merge(&mut self.bookmarks, stored, BOOKMARK_CAP);
+    }
+
+    pub fn restored_history(&mut self, stored: Vec<Place>) {
+        merge(&mut self.history, stored, HISTORY_CAP);
+    }
+}
+
+fn merge(list: &mut Vec<Place>, stored: Vec<Place>, cap: usize) {
+    for place in stored {
+        if !list.iter().any(|kept| kept.url == place.url) {
+            list.push(place);
+        }
+    }
+    list.truncate(cap);
+}
+
+pub fn encode(places: &[Place]) -> Vec<u8> {
+    Value::Arr(
+        places
+            .iter()
+            .map(|place| obj(vec![("url", s(place.url.clone())), ("title", s(place.title.clone())), ("at", Value::Int(place.at))]))
+            .collect(),
+    )
+    .to_json()
+    .into_bytes()
+}
+
+/// What's stored, keeping what can be read of it.
+pub fn decode(bytes: &[u8]) -> Vec<Place> {
+    let Ok(value) = parse_depth(bytes, STORED_DEPTH) else {
+        return Vec::new();
+    };
+    let Some(items) = value.as_arr() else {
+        return Vec::new();
+    };
+    items
+        .iter()
+        .filter_map(|item| {
+            let url = item.get("url")?.as_str()?;
+            worth_keeping(url).then(|| Place {
+                url: url.to_string(),
+                title: item.get("title").and_then(Value::as_str).map(cut_title).unwrap_or_default(),
+                at: item.get("at").and_then(Value::as_i64).unwrap_or(0),
+            })
+        })
+        .collect()
+}
+
+/// The machine's UTC offset in seconds, read once: the platform has no timezone
+/// database, and `date` knows about daylight saving. As Files does it.
+fn utc_offset() -> i64 {
+    static OFFSET: std::sync::OnceLock<i64> = std::sync::OnceLock::new();
+    *OFFSET.get_or_init(|| {
+        #[cfg(any(target_os = "macos", target_os = "linux"))]
+        if let Ok(out) = std::process::Command::new("/bin/date").arg("+%z").output() {
+            return parse_utc_offset(String::from_utf8_lossy(&out.stdout).trim());
+        }
+        0
+    })
+}
+
+/// `+0200` and `-0730`, in seconds east of UTC.
+fn parse_utc_offset(text: &str) -> i64 {
+    let (sign, digits) = match text.as_bytes().first() {
+        Some(b'+') => (1, &text[1..]),
+        Some(b'-') => (-1, &text[1..]),
+        _ => return 0,
+    };
+    if digits.len() != 4 {
+        return 0;
+    }
+    let (Ok(hours), Ok(minutes)) = (digits[..2].parse::<i64>(), digits[2..].parse::<i64>()) else {
+        return 0;
+    };
+    sign * (hours * 3600 + minutes * 60)
+}
+
+/// Days since the epoch, as a calendar date (Howard Hinnant's algorithm).
+fn civil(days: i64) -> (i64, u32, u32) {
+    let z = days + 719_468;
+    let era = z.div_euclid(146_097);
+    let doe = z.rem_euclid(146_097);
+    let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    let mp = (5 * doy + 2) / 153;
+    let day = (doy - (153 * mp + 2) / 5 + 1) as u32;
+    let month = if mp < 10 { mp + 3 } else { mp - 9 } as u32;
+    (yoe + era * 400 + i64::from(month <= 2), month, day)
+}
+
+const WEEKDAYS: [&str; 7] = ["Thursday", "Friday", "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday"];
+const MONTHS: [&str; 12] = [
+    "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December",
+];
+
+/// Which local day a moment fell on, as a number to compare.
+fn day_of(at: i64, offset: i64) -> i64 {
+    (at + offset).div_euclid(86_400)
+}
+
+fn day_heading(day: i64, today: i64) -> String {
+    if day == today {
+        return "Today".to_string();
+    }
+    if day == today - 1 {
+        return "Yesterday".to_string();
+    }
+    let (year, month, date) = civil(day);
+    let weekday = WEEKDAYS[day.rem_euclid(7) as usize];
+    let month = MONTHS[(month - 1) as usize];
+    if year == civil(today).0 {
+        format!("{weekday}, {month} {date}")
+    } else {
+        format!("{weekday}, {month} {date}, {year}")
+    }
+}
+
+fn clock(at: i64, offset: i64) -> String {
+    let seconds = (at + offset).rem_euclid(86_400);
+    let (hour, minute) = (seconds / 3600, seconds % 3600 / 60);
+    let shown = if hour % 12 == 0 { 12 } else { hour % 12 };
+    format!("{shown}:{minute:02} {}", if hour < 12 { "AM" } else { "PM" })
+}
+
+/// A line of a list of places.
+#[derive(Clone, Debug, PartialEq)]
+pub enum Line {
+    Day(String),
+    Page { url: String, name: String, site: String, time: String },
+}
+
+fn page_line(place: &Place, time: String) -> Line {
+    Line::Page {
+        url: place.url.clone(),
+        name: place.name(),
+        site: crate::tabs::host_of(&place.url).unwrap_or_else(|| place.url.clone()),
+        time,
+    }
+}
+
+/// History, by the day, the last one first.
+pub fn history_lines(history: &[Place], now: i64) -> Vec<Line> {
+    lines_by_day(history, now, utc_offset())
+}
+
+fn lines_by_day(history: &[Place], now: i64, offset: i64) -> Vec<Line> {
+    let today = day_of(now, offset);
+    let mut lines = Vec::with_capacity(history.len() + 8);
+    let mut last_day = None;
+    for place in history {
+        let day = day_of(place.at, offset);
+        if last_day != Some(day) {
+            last_day = Some(day);
+            lines.push(Line::Day(day_heading(day, today)));
+        }
+        lines.push(page_line(place, clock(place.at, offset)));
+    }
+    lines
+}
+
+pub fn bookmark_lines(bookmarks: &[Place]) -> Vec<Line> {
+    bookmarks.iter().map(|place| page_line(place, String::new())).collect()
+}
+
+/// The letter a page's tile shows.
+pub fn tile_letter(name: &str) -> String {
+    name.chars().find(|c| c.is_alphanumeric()).map(|c| c.to_uppercase().collect()).unwrap_or_else(|| "?".to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn urls(list: &[Place]) -> Vec<&str> {
+        list.iter().map(|place| place.url.as_str()).collect()
+    }
+
+    #[test]
+    fn a_page_is_in_history_once_at_its_last_visit() {
+        let mut places = Places::default();
+        places.visit("https://a.test/", "A", 1);
+        places.visit("https://b.test/", "B", 2);
+        places.visit("https://a.test/", "A again", 3);
+        assert_eq!(urls(&places.history), ["https://a.test/", "https://b.test/"]);
+        assert_eq!(places.history[0].at, 3);
+        assert_eq!(places.history[0].title, "A again");
+    }
+
+    #[test]
+    fn history_stops_at_its_cap_and_the_oldest_go() {
+        let mut places = Places::default();
+        for i in 0..HISTORY_CAP + 25 {
+            places.visit(&format!("https://a.test/{i}"), "", i as i64);
+        }
+        assert_eq!(places.history.len(), HISTORY_CAP);
+        assert_eq!(places.history[0].url, format!("https://a.test/{}", HISTORY_CAP + 24));
+        assert_eq!(places.history.last().unwrap().url, "https://a.test/25");
+    }
+
+    #[test]
+    fn the_apps_own_pages_and_scripts_are_not_kept() {
+        for url in ["javascript:alert(1)", "data:text/html,x", "about:blank", "chrome://gpu", ""] {
+            assert!(!worth_keeping(url), "{url}");
+        }
+        assert!(!worth_keeping(&format!("https://a.test/{}", "x".repeat(LONGEST_URL))));
+        let mut places = Places::default();
+        places.visit("data:text/html,x", "x", 1);
+        places.save_bookmark("javascript:alert(1)", "x", 1);
+        assert!(places.history.is_empty() && places.bookmarks.is_empty());
+    }
+
+    #[test]
+    fn a_title_that_comes_later_finds_its_page() {
+        let mut places = Places::default();
+        places.visit("https://a.test/", "", 1);
+        assert!(places.retitle("https://a.test/", "A"));
+        assert!(!places.retitle("https://a.test/", "A"));
+        assert!(!places.retitle("https://b.test/", "B"));
+        assert_eq!(places.history[0].name(), "A");
+    }
+
+    #[test]
+    fn a_page_with_no_title_goes_by_its_site() {
+        let place = Place { url: "https://www.a.test/x?y".into(), title: "  ".into(), at: 0 };
+        assert_eq!(place.name(), "a.test");
+    }
+
+    #[test]
+    fn saving_a_saved_page_renames_it_where_it_is() {
+        let mut places = Places::default();
+        places.save_bookmark("https://a.test/", "A", 1);
+        places.save_bookmark("https://b.test/", "B", 2);
+        places.save_bookmark("https://a.test/", " New name ", 3);
+        assert_eq!(urls(&places.bookmarks), ["https://b.test/", "https://a.test/"]);
+        assert_eq!(places.bookmark("https://a.test/").unwrap().title, "New name");
+        places.remove_bookmark("https://a.test/");
+        assert!(places.bookmark("https://a.test/").is_none());
+    }
+
+    #[test]
+    fn what_is_stored_comes_back_whatever_it_holds() {
+        let list = vec![
+            Place { url: "https://a.test/?q=\"x\"&y=\\".into(), title: "Line\nbreak \u{1f600} \"quoted\"".into(), at: 1_700_000_000 },
+            Place { url: "https://b.test/".into(), title: String::new(), at: 0 },
+        ];
+        assert_eq!(decode(&encode(&list)), list);
+    }
+
+    #[test]
+    fn a_damaged_value_is_an_empty_list_and_a_bad_row_is_left_out() {
+        assert!(decode(b"").is_empty());
+        assert!(decode(b"{\"not\":\"a list\"}").is_empty());
+        assert!(decode(b"[{\"url\":\"https://a.test/\"").is_empty());
+        let kept = decode(b"[{\"title\":\"no address\"},{\"url\":\"javascript:x\"},{\"url\":\"https://a.test/\"}]");
+        assert_eq!(kept, vec![Place { url: "https://a.test/".into(), title: String::new(), at: 0 }]);
+    }
+
+    #[test]
+    fn what_arrives_from_storage_goes_after_what_happened_meanwhile() {
+        let mut places = Places::default();
+        places.visit("https://new.test/", "New", 9);
+        places.restored_history(vec![
+            Place { url: "https://old.test/".into(), title: "Old".into(), at: 1 },
+            Place { url: "https://new.test/".into(), title: "Stale".into(), at: 2 },
+        ]);
+        assert_eq!(urls(&places.history), ["https://new.test/", "https://old.test/"]);
+        assert_eq!(places.history[0].title, "New");
+    }
+
+    #[test]
+    fn clearing_history_leaves_the_bookmarks() {
+        let mut places = Places::default();
+        places.visit("https://a.test/", "A", 1);
+        places.save_bookmark("https://a.test/", "A", 1);
+        places.clear_history();
+        assert!(places.history.is_empty());
+        assert_eq!(places.bookmarks.len(), 1);
+    }
+
+    #[test]
+    fn dates_read_as_a_person_says_them() {
+        // Thursday 5 November 2026, 10:30 in UTC.
+        let now = 1_793_874_600;
+        let at = |days_ago: i64| now - days_ago * 86_400;
+        let history: Vec<Place> = [0, 0, 1, 3, 400]
+            .iter()
+            .enumerate()
+            .map(|(i, days)| Place { url: format!("https://a.test/{i}"), title: format!("Page {i}"), at: at(*days) })
+            .collect();
+        let days: Vec<String> = lines_by_day(&history, now, 0)
+            .into_iter()
+            .filter_map(|line| if let Line::Day(day) = line { Some(day) } else { None })
+            .collect();
+        assert_eq!(days, ["Today", "Yesterday", "Monday, November 2", "Wednesday, October 1, 2025"]);
+    }
+
+    #[test]
+    fn the_day_and_the_hour_are_the_machines_own() {
+        // 02:00 UTC is still the evening before, seven hours west.
+        let now = 1_793_844_000;
+        assert_eq!(clock(now, 0), "2:00 AM");
+        assert_eq!(clock(now, -7 * 3600), "7:00 PM");
+        assert_eq!(clock(now + 10 * 3600, 0), "12:00 PM");
+        assert_eq!(clock(now - 2 * 3600, 0), "12:00 AM");
+        assert_eq!(day_of(now, 0), day_of(now, -7 * 3600) + 1);
+        assert_eq!(parse_utc_offset("+0200"), 7200);
+        assert_eq!(parse_utc_offset("-0730"), -27000);
+        assert_eq!(parse_utc_offset("nonsense"), 0);
+    }
+
+    #[test]
+    fn a_tile_has_a_letter() {
+        assert_eq!(tile_letter("example"), "E");
+        assert_eq!(tile_letter("  (the) page"), "T");
+        assert_eq!(tile_letter("..."), "?");
+    }
+}
