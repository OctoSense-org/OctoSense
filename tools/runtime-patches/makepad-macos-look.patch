+/// The origin of an embed's page: the referrer its frame gets, which is how an embedded
+/// player asks a native app to identify itself, by its bundle identifier. Never fetched.
+#[cfg(target_os = "macos")]
+const EMBED_ORIGIN: &str = "https://dev.makepad.octosense/";
+
+/// What an embed's page does besides show its frame. A player that speaks YouTube's iframe
+/// protocol (`enablejsapi=1` in its address) answers these greetings with what it knows, and
+/// says when it won't play this video: wanting a sign-in, or kept off other sites by its owner.
+/// The greetings start at once: a frame's load event can come long after its player plays,
+/// or not at all. The frame shows when the player is up, when it has loaded, or after 8 s.
+/// Its error may come before it has heard a greeting, and then only its data holds it. The frame
+/// goes clear at once, and a moment later the app hears of it, unless the player is playing by
+/// then. The app also hears when the player is first up, showing a video or about to. Any other
+/// player says nothing and this does nothing.
+#[cfg(target_os = "macos")]
+const EMBED_SCRIPT: &str = r#"(function(){
+var f=document.getElementById("p"),t,n,w,up,code=0,said;
+function say(m){f.contentWindow.postMessage(JSON.stringify(m),"*")}
+function hello(){say({event:"listening",id:1,channel:"widget"});say({event:"command",func:"addEventListener",args:["onError"],id:1,channel:"widget"});if(++n>120)clearInterval(t)}
+function greet(){clearInterval(t);n=0;t=setInterval(hello,250)}
+addEventListener("message",function(e){
+if(e.source!==f.contentWindow||said)return;
+var d;try{d=JSON.parse(e.data)}catch(x){return}
+if(!d)return;
+if(d.channel==="widget")clearInterval(t);
+var i=d.info,v=i&&i.videoData,s=i&&i.playerState;
+if(d.event==="onError")code=Number(i)||0;
+if(s===1||s===2||s===3||s===5){clearTimeout(w);w=0;f.style.opacity=1;if(!up){up=1;webkit.messageHandlers.embed.postMessage("up")}}
