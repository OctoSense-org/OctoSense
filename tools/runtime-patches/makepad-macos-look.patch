+struct Front {
+    /// The last frame's shell says what it stacks over its web views.
+    counts: bool,
+    /// A shell is counting this frame, and there are pages to care about.
+    counting: bool,
+    /// The frame drew the windows, so a reader it didn't draw isn't on the screen.
+    walked: bool,
+    covers: Vec<WebCover>,
+    drawn: Vec<DrawnReader>,
+    /// The window being drawn: its shape, and what lies over all of it (overlay lists).
+    window: Option<SystemBrowserShape>,
+    window_overlays: Vec<SystemBrowserShape>,
+    /// The surface being drawn, and the last that was.
+    layer: u32,
+    in_surface: bool,
+    /// The readers shown by the last frame that drew the windows.
