+    /// The help tag a little under the pointer, but never past the window's
+    /// edge: New Chat sits at the window's trailing end, and a tag hung from the
+    /// pointer there ran out of the window and was cut to "New".
+    fn place_tip(&mut self, cx: &mut Cx) {
+        let tag = self.view.view(cx, ids!(new_chat_tip.content)).area().rect(cx);
+        if tag.size.x <= 0.0 {
+            // Not drawn yet: look again on the next frame, a few times.
