diff --git a/apps/aichat/src/chats.rs b/apps/aichat/src/chats.rs
new file mode 100644
index 0000000000000000000000000000000000000000..664258e1ddab38d3f59b46e3ee32cdaa4f3d8747
--- /dev/null
+++ b/apps/aichat/src/chats.rs
@@ -0,0 +1,315 @@
+//! A window's conversations, as a Mac chat app keeps them in its sidebar:
+//! each its own engine, all on the one model. Only the conversation on
+//! screen talks to the model. The one that asks next takes it over, and the
+//! model hears that conversation so far before the question ([`recap`]).
+//! Nothing is stored: AI keeps no chats, and the list lasts as long as the
+//! window does.
+
+use makepad_ai_services::engine::{EngineCore, Model, ModelEvent, ToolDefinition};
+use makepad_ai_services::state::{EngineState, Entry};
+use std::cell::RefCell;
+use std::rc::Rc;
+
+/// The one model the conversations share, and whose conversation it holds.
+pub struct Seat {
+    model: Box<dyn Model>,
+    holder: Option<u64>,
+}
+
+pub type SharedSeat = Rc<RefCell<Seat>>;
+
+pub fn seat(model: Box<dyn Model>) -> SharedSeat {
+    Rc::new(RefCell::new(Seat { model, holder: None }))
+}
+
+/// The model's own account of itself (the local election names its route
+/// only once it has one), whichever conversation asked last.
+pub fn seat_label(seat: &SharedSeat) -> String {
+    seat.borrow().model.label()
+}
+
+/// The most of a conversation the model hears again when it comes back to it.
+const RECAP_MAX: usize = 6000;
+
+/// A conversation the window keeps while another is on screen.
+pub struct Shelved {
+    pub id: u64,
+    pub engine: EngineCore,
+    /// Rows a Try Again replaced.
+    pub replaced: Vec<usize>,
+    /// When the person last asked in it: the list's order.
+    pub touched: f64,
+}
+
+/// A conversation's hold on the shared model: the `Model` its engine drives.
+pub struct SeatModel {
+    seat: SharedSeat,
+    chat: u64,
+    system: String,
+    tools: Vec<ToolDefinition>,
+    /// The conversation as the model heard it: each question and its answer.
+    said: Vec<(String, String)>,
+}
+
+impl SeatModel {
+    pub fn new(seat: SharedSeat, chat: u64) -> Self {
+        SeatModel { seat, chat, system: String::new(), tools: Vec::new(), said: Vec::new() }
+    }
+
+    fn holds(&self) -> bool {
+        self.seat.borrow().holder == Some(self.chat)
+    }
+}
+
+impl Model for SeatModel {
+    fn label(&self) -> String {
+        seat_label(&self.seat)
+    }
+
+    fn configure(&mut self, system: &str, tools: &[ToolDefinition]) -> Result<(), String> {
+        self.system = system.to_string();
+        self.tools = tools.to_vec();
+        let mut seat = self.seat.borrow_mut();
+        match seat.holder {
+            Some(holder) if holder != self.chat => Ok(()),
+            _ => seat.model.configure(system, tools),
+        }
+    }
+
+    fn send_user(&mut self, text: &str, dynamic_context: &str) {
+        let mut seat = self.seat.borrow_mut();
+        let mut context = dynamic_context.to_string();
+        if seat.holder != Some(self.chat) {
+            if seat.holder.is_some() {
+                // The model forgets the other conversation, and hears this one so far.
+                seat.model.cancel();
+                seat.model.reset();
+                let _ = seat.model.poll();
+                if !self.system.is_empty() {
+                    let _ = seat.model.configure(&self.system, &self.tools);
+                }
+                let earlier = recap(&self.said);
+                if !earlier.is_empty() {
+                    if !context.is_empty() {
+                        context.push('\n');
+                    }
+                    context.push_str(&earlier);
+                }
+            }
+            seat.holder = Some(self.chat);
+        }
+        self.said.push((text.to_string(), String::new()));
+        seat.model.send_user(text, &context);
+    }
+
+    fn send_tool_result(&mut self, call_id: &str, text: &str, is_error: bool) {
+        if self.holds() {
+            self.seat.borrow_mut().model.send_tool_result(call_id, text, is_error);
+        }
+    }
+
+    fn cancel(&mut self) {
+        if self.holds() {
+            self.seat.borrow_mut().model.cancel();
+        }
+    }
+
+    fn reset(&mut self) {
+        self.said.clear();
+        if self.holds() {
+            self.seat.borrow_mut().model.reset();
+        }
+    }
+
+    fn poll(&mut self) -> Vec<ModelEvent> {
+        if !self.holds() {
+            return Vec::new();
+        }
+        let events = self.seat.borrow_mut().model.poll();
+        if let Some((_, answer)) = self.said.last_mut() {
+            for event in &events {
+                if let ModelEvent::Delta(text) = event {
+                    answer.push_str(text);
+                }
+            }
+        }
+        events
+    }
+
+    fn can_rebind_mid_turn(&self) -> bool {
+        self.seat.borrow().model.can_rebind_mid_turn()
+    }
+}
+
+/// What the model hears of a conversation it comes back to: the questions and
+/// answers so far, the newest kept when there are too many.
+pub fn recap(said: &[(String, String)]) -> String {
+    let mut pairs = Vec::new();
+    let mut size = 0;
+    for (question, answer) in said.iter().rev() {
+        let pair = format!("The person: {}\nYou: {}\n", question.trim(), answer.trim());
+        if size + pair.len() > RECAP_MAX {
+            break;
+        }
+        size += pair.len();
+        pairs.push(pair);
+    }
+    if pairs.is_empty() {
+        return String::new();
+    }
+    pairs.reverse();
+    format!("# This conversation so far\n{}", pairs.concat())
+}
+
+/// A conversation's name in the list: the person's first words, on one line.
+pub fn title(state: &EngineState) -> String {
+    state
+        .entries
+        .iter()
+        .find_map(|entry| match entry {
+            Entry::User { text } => Some(one_line(text)),
+            _ => None,
+        })
+        .filter(|words| !words.is_empty())
+        .unwrap_or_else(|| "New Chat".to_string())
+}
+
+/// What the list says under the name: the last answer's first words. Before
+/// any answer, what AI said to the last question instead, in the window's
+/// words ("AI Needs a Model"); a conversation nothing was asked in has none.
+pub fn preview(state: &EngineState) -> String {
+    let answer = state.entries.iter().rev().find_map(|entry| match entry {
+        Entry::Assistant { text, .. } if !text.trim().is_empty() => Some(plain_words(text)),
+        _ => None,
+    });
+    answer.unwrap_or_else(|| {
+        state
+            .entries
+            .iter()
+            .rev()
+            .take_while(|entry| !matches!(entry, Entry::User { .. }))
+            .find_map(|entry| match entry {
+                Entry::System { text } => Some(match crate::plain::said(text) {
+                    crate::plain::Said::Line(line) => line,
+                    crate::plain::Said::Failure(failure) => failure.title,
+                }),
+                _ => None,
+            })
+            .filter(|_| state.entries.iter().any(|entry| matches!(entry, Entry::User { .. })))
+            .unwrap_or_default()
+    })
+}
+
+fn one_line(text: &str) -> String {
+    text.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+/// An answer's words without its Markdown: no stars, ticks, hashes or list marks.
+fn plain_words(markdown: &str) -> String {
+    let mut words = Vec::new();
+    for line in markdown.lines() {
+        let line = line.trim().trim_start_matches(['#', '>', '-', '*', ' ']);
+        let line = line.trim_start_matches(|c: char| c.is_ascii_digit()).trim_start_matches(['.', ')', ' ']);
+        let clean: String = line.chars().filter(|c| !matches!(c, '*' | '`' | '_')).collect();
+        if !clean.trim().is_empty() {
+            words.push(clean.trim().to_string());
+        }
+        if words.join(" ").len() > 160 {
+            break;
+        }
+    }
+    one_line(&words.join(" "))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A model that answers each question with its number and says what it heard.
+    #[derive(Default)]
+    struct Heard {
+        asked: Rc<RefCell<Vec<(String, String)>>>,
+        resets: Rc<RefCell<usize>>,
+        queued: Vec<ModelEvent>,
+    }
+
+    impl Model for Heard {
+        fn label(&self) -> String {
+            "Heard".into()
+        }
+        fn configure(&mut self, _system: &str, _tools: &[ToolDefinition]) -> Result<(), String> {
+            Ok(())
+        }
+        fn send_user(&mut self, text: &str, dynamic_context: &str) {
+            self.asked.borrow_mut().push((text.to_string(), dynamic_context.to_string()));
+            let n = self.asked.borrow().len();
+            self.queued.push(ModelEvent::Delta(format!("answer {n}")));
+            self.queued.push(ModelEvent::TurnDone { tool_calls: 0 });
+        }
+        fn send_tool_result(&mut self, _call_id: &str, _text: &str, _is_error: bool) {}
+        fn cancel(&mut self) {}
+        fn reset(&mut self) {
+            *self.resets.borrow_mut() += 1;
+            self.queued.clear();
+        }
+        fn poll(&mut self) -> Vec<ModelEvent> {
+            std::mem::take(&mut self.queued)
+        }
+    }
+
+    #[test]
+    fn the_conversation_that_asks_takes_the_model_and_brings_its_past() {
+        let heard = Heard::default();
+        let (asked, resets) = (heard.asked.clone(), heard.resets.clone());
+        let seat = seat(Box::new(heard));
+        let mut first = SeatModel::new(seat.clone(), 1);
+        let mut second = SeatModel::new(seat.clone(), 2);
+        first.send_user("Plan a trip", "");
+        assert_eq!(first.poll().len(), 2, "the one that asked hears its answer");
+        assert!(second.poll().is_empty(), "the other hears nothing");
+        assert_eq!(*resets.borrow(), 0, "the first question needs no fresh start");
+        second.send_user("What is 2 + 2?", "");
+        assert_eq!(*resets.borrow(), 1, "a new conversation starts the model afresh");
+        assert_eq!(asked.borrow()[1].1, "", "and has no past to bring");
+        assert_eq!(second.poll().len(), 2);
+        first.send_user("Make it longer", "apps");
+        let (text, context) = asked.borrow()[2].clone();
+        assert_eq!(text, "Make it longer", "the question goes as asked");
+        assert!(context.starts_with("apps\n# This conversation so far\n"), "{context}");
+        assert!(context.contains("The person: Plan a trip\nYou: answer 1\n"), "{context}");
+        assert!(!context.contains("2 + 2"), "and nothing of the other: {context}");
+    }
+
+    #[test]
+    fn a_long_past_keeps_its_newest_part() {
+        let said: Vec<(String, String)> = (0..400).map(|n| (format!("question {n}"), "x".repeat(40))).collect();
+        let text = recap(&said);
+        assert!(text.len() <= RECAP_MAX + 40, "{}", text.len());
+        assert!(text.contains("question 399") && !text.contains("question 0\n"));
+    }
+
+    #[test]
+    fn the_list_names_a_conversation_by_its_first_question() {
+        let mut state = EngineState::default();
+        assert_eq!(title(&state), "New Chat");
+        state.entries.push(Entry::User { text: "Plan three\ndays in   Lisbon".into() });
+        state.entries.push(Entry::Assistant { text: "## Day one\n\n1. Walk through **Alfama** and `rest`.".into(), streaming: false });
+        state.entries.push(Entry::User { text: "And the next?".into() });
+        assert_eq!(title(&state), "Plan three days in Lisbon");
+        assert_eq!(preview(&state), "Day one Walk through Alfama and rest.");
+    }
+
+    #[test]
+    fn a_conversation_with_no_answer_says_what_ai_said_instead() {
+        let mut state = EngineState::default();
+        state.entries.push(Entry::System { text: "now answering with Qwen".into() });
+        assert_eq!(preview(&state), "", "nothing asked, nothing under the name");
+        state.entries.push(Entry::User { text: "What can you do?".into() });
+        state.entries.push(Entry::System { text: "tools: gen.image".into() });
+        assert_eq!(preview(&state), "Ask a question in your own words.");
+        state.entries.push(Entry::System { text: "no model is answering: no model file in ~/models".into() });
+        assert_eq!(preview(&state), "AI Needs a Model", "the card's name, never the engine's words");
+        state.entries.push(Entry::User { text: "And now?".into() });
+        assert_eq!(preview(&state), "", "a question waiting has no reply yet");
+    }
+}
