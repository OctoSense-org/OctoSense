+    /// Try Again on a failure: the person's last words go out again. The
+    /// question stays where it was asked and what failed gives way, so nothing
+    /// in the conversation moves: the words sent again are that question, not
+    /// a new one under what came since, and are not shown twice. What they have
+    /// started to type stays.
+    fn retry(&mut self, cx: &mut Cx, failed: usize) {
+        let now = Self::now(cx);
+        let earlier = self.ensure_engine().state().entries.get(..failed).unwrap_or_default().iter().rev().find_map(
+            |entry| match entry {
+                Entry::User { text } => Some(text.clone()),
+                _ => None,
+            },
+        );
+        let Some(text) = earlier else { return };
+        self.replaced.push(failed);
+        self.stopped = false;
+        self.chat_touched = now;
+        let engine = self.ensure_engine();
+        let before = engine.state().entries.len();
+        engine.send(&text, now);
+        let resent = engine.state().entries.get(before..).unwrap_or_default().iter().position(|entry| matches!(entry, Entry::User { .. }));
+        if let Some(offset) = resent {
+            self.replaced.push(before + offset);
+        }
+        self.view.text_input(cx, ids!(input)).take_key_focus(cx);
+        self.composer_focused = false;
+        self.view.redraw(cx);
+    }
