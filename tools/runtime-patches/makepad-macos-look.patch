+/// The colours the Rust side paints with: the register's cells, the sidebar's
+/// selection, the balances. On a desktop they are read back from `mod.finance`
+/// after the sheet's roles went through it; anywhere else the status colours
+/// stay the literal values this app has always painted with.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Roles {
+    pub desk: bool,
+    pub unified: bool,
+    pub panel: Vec4f,
+    pub accent_row: Vec4f,
+    pub disabled: Vec4f,
+    pub fg: Vec4f,
+    pub dim: Vec4f,
+    pub up: Vec4f,
+    pub down: Vec4f,
+    pub flag: Vec4f,
+    pub split: Vec4f,
+    pub quiet: Vec4f,
+    pub hover: Vec4f,
+    pub selected: Vec4f,
+    pub button: Vec4f,
+    pub segment: Vec4f,
+    pub line: Vec4f,
+    pub primary: Vec4f,
+    pub on_primary: Vec4f,
+}
+
+impl Default for Roles {
+    fn default() -> Self {
+        Self {
+            desk: false,
+            unified: false,
+            panel: Vec4f::default(),
+            accent_row: Vec4f::default(),
+            disabled: Vec4f::default(),
+            fg: rgb(0xe6edf3),
+            dim: rgb(0x9aa7b4),
+            up: rgb(GOOD),
+            down: rgb(CRITICAL),
+            flag: rgb(WARNING),
+            split: rgb(0xa371f7),
+            quiet: rgb(0x6b7784),
+            hover: Vec4f::default(),
+            selected: rgb(0x1f3a63),
+            button: Vec4f::default(),
+            segment: Vec4f::default(),
+            line: Vec4f::default(),
+            primary: Vec4f::default(),
+            on_primary: rgb(0xffffff),
+        }
+    }
+}
+
+impl Roles {
+    /// The roles of the sheet in force. A process app first runs on the stock
+    /// sheet and then receives the shell's, so ask again after every restyle.
+    pub fn for_cx(cx: &mut Cx) -> Self {
+        cx.with_vm(|vm| {
+            let finance = vm.module(id!(finance));
+            let desk = vm.bx.heap.value(finance, id!(desk).into(), NoTrap).as_bool() == Some(true);
+            let unified = vm.bx.heap.value(finance, id!(unified).into(), NoTrap).as_bool() == Some(true);
+            let mut roles = Self { desk, unified, ..Self::default() };
+            let role = |key: LiveId, into: &mut Vec4f| {
+                if let Some(color) = vm.bx.heap.value(finance, key.into(), NoTrap).as_color() {
+                    *into = Vec4f::from_u32(color);
+                }
+            };
+            // Text follows the sheet everywhere: these literals were a dark
+            // appearance's, and unreadable in a light one.
+            role(id!(fg), &mut roles.fg);
+            role(id!(fg_dim), &mut roles.dim);
+            if !desk {
+                role(id!(accent_soft), &mut roles.selected);
+                return roles;
+            }
+            role(id!(up), &mut roles.up);
+            role(id!(down), &mut roles.down);
+            role(id!(flag), &mut roles.flag);
+            role(id!(split), &mut roles.split);
+            role(id!(fg_faint), &mut roles.quiet);
+            role(id!(hover), &mut roles.hover);
+            role(id!(selected), &mut roles.selected);
+            role(id!(button), &mut roles.button);
+            role(id!(segment), &mut roles.segment);
+            role(id!(line), &mut roles.line);
+            role(id!(primary), &mut roles.primary);
+            role(id!(on_primary), &mut roles.on_primary);
+            role(id!(panel), &mut roles.panel);
+            role(id!(accent_row), &mut roles.accent_row);
+            role(id!(disabled), &mut roles.disabled);
+            roles
+        })
+    }
+}
