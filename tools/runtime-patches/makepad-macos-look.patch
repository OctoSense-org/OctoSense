+    // ---- a pointer's right-click menus ----
+
+    /// The sidebar row of a list under the pointer.
+    fn list_under(&self, cx: &mut Cx, at: Vec2d) -> Option<ListId> {
+        let home = self.home_parent(cx, self.nav.layout.is_compact());
+        for (path, id) in [
+            (ids!(lists.groceries), GROCERIES_LIST_ID),
+            (ids!(lists.work), WORK_LIST_ID),
+            (ids!(lists.home), HOME_LIST_ID),
+            (ids!(lists.travel), TRAVEL_LIST_ID),
+        ] {
+            let there = self.document.as_ref().is_some_and(|doc| doc.list(id).is_some());
+            if there && home.widget(cx, path).area().rect(cx).contains(at) {
+                return Some(id);
+            }
+        }
+        let doc = self.document.as_ref()?;
+        doc.lists
+            .iter()
+            .filter(|list| !is_starter_list(list.id))
+            .enumerate()
+            .find(|(index, _)| home.widget(cx, &[custom_row(*index)]).area().rect(cx).contains(at))
+            .map(|(_, list)| list.id)
+    }
+
+    /// A right press: what is under it decides the menu. True when one opened.
+    fn open_context_menu(&mut self, cx: &mut Cx, press: &MouseDownEvent) -> bool {
+        let compact = self.nav.layout.is_compact();
+        let on_home = compact && matches!(self.nav.current(), Route::Home);
+        let at = press.abs;
+        let mut rows: Vec<(ContextRow, Option<MenuAction>)> = Vec::new();
+        let can_add = self.document.as_ref().is_some_and(|doc| doc.lists.len() < MAX_LISTS);
+        let in_sidebar = (!compact || on_home) && self.home_parent(cx, compact).area().rect(cx).contains(at);
+        if in_sidebar {
+            if let Some(id) = self.list_under(cx, at) {
+                self.context_list = Some(id);
+                rows.push((ContextRow::new("Show List Info…", true), Some(MenuAction::ListInfo(id))));
+                // Any list can go, as on a Mac, while another stays for new reminders.
+                let others = self.document.as_ref().is_some_and(|doc| doc.lists.len() > 1);
+                rows.push((ContextRow::new("Delete List…", others), Some(MenuAction::DeleteList(id))));
+                rows.push((ContextRow::rule(), None));
+            }
+            rows.push((ContextRow::new("Add List…", can_add), Some(MenuAction::AddList)));
+        } else if !on_home {
+            let Some(id) = self.reminder_under(cx, at) else {
+                return false;
+            };
+            let Some(reminder) = self.document.as_ref().and_then(|doc| doc.reminder(id)).cloned() else {
+                return false;
+            };
+            // A Mac rings the row its menu acts on; the selection stays.
+            self.context_row = Some(id);
+            cx.set_key_focus(Area::Empty);
+            rows.push((ContextRow::new("Show Details", true), Some(MenuAction::Details(id))));
+            rows.push((ContextRow::rule(), None));
+            let flag = if reminder.flagged { "Remove Flag" } else { "Flag" };
+            rows.push((ContextRow::new(flag, true), Some(MenuAction::Flag(id, !reminder.flagged))));
+            let done = if reminder.is_completed() { "Mark as Not Completed" } else { "Mark as Completed" };
+            rows.push((ContextRow::new(done, true), Some(MenuAction::Complete(id, !reminder.is_completed()))));
+            rows.push((ContextRow::rule(), None));
+            rows.push((ContextRow::new("Delete…", true), Some(MenuAction::Delete(id))));
+        } else {
+            return false;
+        }
+        let (rows, actions): (Vec<_>, Vec<_>) = rows.into_iter().unzip();
+        self.menu_actions = actions;
+        let owner = ContextMenuOwner { source: &self.source, template: self.popup_menu, area: self.view.area() };
+        self.context_menu.open(cx, owner, at, press.time, rows);
+        self.sync_chrome(cx);
+        self.view.redraw(cx);
+        true
+    }
+
+    /// The ring goes with its menu.
+    fn end_context(&mut self, cx: &mut Cx) {
+        if self.context_menu.is_open() {
+            return;
+        }
+        let row = self.context_row.take().is_some();
+        let list = self.context_list.take().is_some();
+        if row || list {
+            self.sync_chrome(cx);
+            self.view.redraw(cx);
+        }
+    }
+
+    fn menu_chose(&mut self, cx: &mut Cx, index: usize) {
+        match self.menu_actions.get(index).copied().flatten() {
+            Some(MenuAction::Details(id)) => self.open_details(cx, id, false),
+            Some(MenuAction::Flag(id, flagged)) => {
+                self.mutate(cx, Command::SetFlagged { id, flagged });
+            }
+            Some(MenuAction::Complete(id, completed)) => {
+                self.mutate(cx, Command::SetCompleted { id, completed });
+            }
+            Some(MenuAction::Delete(id)) => self.open_details(cx, id, true),
+            Some(MenuAction::ListInfo(id)) => self.open_list_sheet(cx, ListSheet::Edit(id)),
+            Some(MenuAction::DeleteList(id)) => self.open_list_sheet(cx, ListSheet::Delete(id)),
+            Some(MenuAction::AddList) => self.open_list_sheet(cx, ListSheet::New),
+            None => {}
+        }
+    }
+
+    fn clear_search(&mut self, cx: &mut Cx) {
+        self.search.clear();
+        for compact in [false, true] {
+            self.list_parent(cx, compact)
+                .text_input(cx, ids!(toolbar.search_box.search))
+                .set_text(cx, "");
+        }
+    }
+
+    /// Back to the start of opening the document, after a failure.
+    fn try_loading_again(&mut self, cx: &mut Cx) {
+        self.load_error = None;
+        self.machine = StorageMachine::default();
+        self.get_id = None;
+        self.list_id = None;
+        if let Some(timer) = self.tick.take() {
+            cx.stop_timer(timer);
+        }
+        self.started = false;
+        self.ensure_started(cx);
+    }
+
+    /// The reminder rows, as `(row, id)`, for the arrows.
+    fn item_rows(&self) -> Vec<(usize, ReminderId)> {
+        self.list_rows
+            .iter()
+            .enumerate()
+            .filter_map(|(index, row)| match row {
+                ListRow::Item(item) => Some((index, item.id)),
+                _ => None,
+            })
+            .collect()
+    }
+
+    /// The next or the previous reminder, kept in sight.
+    fn walk_rows(&mut self, cx: &mut Cx, forward: bool) {
+        let rows = self.item_rows();
+        let at = self.selected_row.and_then(|id| rows.iter().position(|(_, row)| *row == id));
+        let next = match (at, forward) {
+            (None, true) => 0,
+            (None, false) => rows.len().saturating_sub(1),
+            (Some(at), true) => (at + 1).min(rows.len().saturating_sub(1)),
+            (Some(at), false) => at.saturating_sub(1),
+        };
+        let Some(&(row, id)) = rows.get(next) else {
+            return;
+        };
+        self.selected_row = Some(id);
+        let list = self
+            .list_parent(cx, self.nav.layout.is_compact())
+            .portal_list(cx, ids!(rows));
+        let (first, shown) = (list.first_id(), list.visible_items());
+        if row <= first {
+            // A section's title goes along with the first reminder under it.
+            let above = usize::from(row > 0 && matches!(self.list_rows.get(row - 1), Some(ListRow::Section(_))));
+            list.set_first_id_and_scroll(row - above, 0.0);
+        } else if shown > 1 && row + 1 >= first + shown {
+            list.set_first_id_and_scroll(row + 2 - shown, 0.0);
+        }
+        self.view.redraw(cx);
+    }
+
+    fn open_details(&mut self, cx: &mut Cx, id: ReminderId, confirm: bool) {
+        let Some(draft) = self
+            .document
+            .as_ref()
+            .and_then(|doc| doc.reminder(id))
+            .map(crate::engine::draft_from)
+        else {
+            return;
+        };
+        self.open_draft(cx, draft, Some(id));
+        if confirm {
+            self.confirm_delete = true;
+            self.confirm_from_key = true;
+            self.sync_chrome(cx);
+        }
+    }
+
+    /// What a Mac's Reminders does with a key while its sheet is down: Escape
+    /// closes a menu, then the question, then the sheet; Return is the default
+    /// button; Tab walks the fields. True when the key was taken.
+    fn sheet_key(&mut self, cx: &mut Cx, key: &KeyEvent) -> bool {
+        let form = self.form_parent(cx, self.nav.layout.is_compact());
+        let title = form.text_input(cx, ids!(fields.text_group.title));
+        let notes = form.text_input(cx, ids!(fields.text_group.notes));
+        let pickers: [&[LiveId]; 3] = [ids!(fields.organization.list), ids!(fields.organization.priority), ids!(preset)];
+        let menu_open = |cx: &mut Cx, path: &[LiveId]| {
+            // A closed menu has no items among the drop-down's children.
+            let mut open = false;
+            form.widget(cx, path).children(&mut |_, _| open = true);
+            open
+        };
+        match key.key_code {
+            KeyCode::Escape => {
+                for path in pickers {
+                    if menu_open(cx, path) {
+                        if let Some(mut picker) = form.drop_down(cx, path).borrow_mut() {
+                            picker.set_closed(cx);
+                        }
+                        return true;
+                    }
+                }
+                if self.confirm_delete && !self.confirm_from_key {
+                    self.confirm_delete = false;
+                    self.sync_chrome(cx);
+                } else if self.unified && !self.confirm_delete {
+                    self.close_details(cx);
+                } else {
+                    self.discard_draft(cx);
+                }
+                true
+            }
+            KeyCode::ReturnKey | KeyCode::NumpadEnter => {
+                if self.confirm_delete {
+                    // Cancel is its default.
+                    if self.confirm_from_key {
+                        self.discard_draft(cx);
+                    } else {
+                        self.confirm_delete = false;
+                        self.sync_chrome(cx);
+                    }
+                    return true;
+                }
+                for path in pickers {
+                    if menu_open(cx, path) {
+                        return false;
+                    }
+                }
+                let primary = key.modifiers.logo || key.modifiers.control;
+                if notes.key_focus(cx) && !primary {
+                    return false;
+                }
+                if self.unified && self.draft.as_ref().is_some_and(|draft| draft.original_id.is_some()) {
+                    // A Mac's details have applied what they say: Return closes them.
+                    self.close_details(cx);
+                } else if self.draft_fields.as_ref().is_some_and(|fields| !fields.title.trim().is_empty()) {
+                    self.commit_draft(cx);
+                }
+                true
+            }
+            KeyCode::Tab if !key.modifiers.logo && !key.modifiers.control => {
+                let date = form.widget(cx, ids!(fields.schedule.date));
+                let time = form.widget(cx, ids!(fields.schedule.time));
+                let date_on = self.draft_fields.as_ref().is_some_and(|fields| fields.date_on);
+                let time_on = self.draft_fields.as_ref().is_some_and(|fields| fields.time_on);
+                let in_date = date.borrow::<DateField>().is_some_and(|field| field.has_focus(cx));
+                let in_time = time.borrow::<DateField>().is_some_and(|field| field.has_focus(cx));
+                let at = if title.key_focus(cx) {
+                    0
+                } else if notes.key_focus(cx) {
+                    1
+                } else if in_date {
+                    2
+                } else if in_time {
+                    3
+                } else {
+                    // Nothing has it yet: the walk starts at the title.
+                    if key.modifiers.shift { 1 } else { 3 }
+                };
+                let mut stops = vec![0, 1];
+                if date_on {
+                    stops.push(2);
+                }
+                if time_on {
+                    stops.push(3);
+                }
+                let here = stops.iter().position(|stop| *stop == at).unwrap_or(stops.len() - 1);
+                let count = stops.len();
+                let next = stops[if key.modifiers.shift { (here + count - 1) % count } else { (here + 1) % count }];
+                match next {
+                    0 => title.take_key_focus(cx),
+                    1 => notes.take_key_focus(cx),
+                    2 => {
+                        if let Some(mut field) = date.borrow_mut::<DateField>() {
+                            field.take_focus(cx);
+                        }
+                    }
+                    _ => {
+                        if let Some(mut field) = time.borrow_mut::<DateField>() {
+                            field.take_focus(cx);
+                        }
+                    }
+                }
+                self.view.redraw(cx);
+                true
+            }
+            _ => false,
+        }
+    }
+
+    /// What a Mac's Reminders does with a key: new reminder, find, and, while
+    /// no text has the keyboard, the arrows, Return, Space and Delete on the
+    /// selected row. True when the key was taken.
+    fn mac_key(&mut self, cx: &mut Cx, key: &KeyEvent) -> bool {
+        // A sheet or an alert has the keys, before anything is read too.
+        if self.list_sheet.is_some() {
+            return self.list_sheet_key(cx, key);
+        }
+        if !self.ready() {
+            return false;
+        }
+        if self.draft.is_some() {
+            return self.sheet_key(cx, key);
