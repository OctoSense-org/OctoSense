+         if(t.indexOf('{FIND_TITLE}')!==0&&t.indexOf('{MENU_TITLE}')!==0)window.__findTitle=t;\
+         document.title='{MENU_TITLE}'+serial+':'+(free?1:0)+':'+(sel?1:0)+':'+link;\
+         clearTimeout(window.__findTimer);\
+         window.__findTimer=setTimeout(function(){{document.title=window.__findTitle;}},300);\
