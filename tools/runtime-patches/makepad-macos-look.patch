+/// A Mac's clock for `hour_label`'s "14" or `hhmm_of`'s "06:52": "2 PM",
+/// "6:52 AM". Anything else ("Now") stays as it is.
+pub fn mac_clock(label: &str) -> String {
+    let (hour, minute) = match label.split_once(':') {
+        Some((hour, minute)) => (hour, Some(minute)),
+        None => (label, None),
+    };
+    let Ok(hour) = hour.parse::<u32>() else {
+        return label.to_string();
+    };
+    let shown = match hour % 12 {
+        0 => 12,
+        other => other,
+    };
+    let part = if hour >= 12 { "PM" } else { "AM" };
+    match minute {
+        Some(minute) => format!("{shown}:{minute} {part}"),
+        None => format!("{shown} {part}"),
+    }
+}
