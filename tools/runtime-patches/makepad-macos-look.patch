+#[cfg(test)]
+mod mac_palette_tests {
+    use super::*;
+
+    fn f(c: Rgb) -> [f32; 3] {
+        [c.r as f32 / 255.0, c.g as f32 / 255.0, c.b as f32 / 255.0]
+    }
+
+    #[test]
+    fn every_basic_colour_reads_and_each_bright_one_stands_apart() {
+        for dark in [false, true] {
+            let look = if dark { "dark" } else { "light" };
+            let (palette, _, page, _) = mac_profile_colors(dark);
+            for (i, c) in palette.iter().enumerate() {
+                let r = contrast::ratio(f(*c), f(page));
+                assert!(r >= 4.5, "{look}: colour {i} {c:?} is {r:.2}:1 on the page");
+            }
+            for i in 0..8 {
+                let (normal, bright) = (palette[i], palette[i + 8]);
+                let apart = contrast::ratio(f(normal), f(bright));
+                let least = if i == 0 || i == 7 { 1.2 } else { 1.4 };
+                assert!(apart >= least, "{look}: {} and {} are only {apart:.2} apart: {normal:?} {bright:?}", 30 + i, 90 + i);
+                // A bright colour is the lighter one, as in Terminal's own profile.
+                let (ln, lb) = (contrast::luminance(f(normal)), contrast::luminance(f(bright)));
+                assert!(lb > ln, "{look}: {} is not lighter than {}", 90 + i, 30 + i);
+            }
+            // The grays in order, a step apart: black, bright black, white, bright white.
+            for pair in [0usize, 8, 7, 15].windows(2) {
+                let (a, b) = (palette[pair[0]], palette[pair[1]]);
+                assert!(contrast::luminance(f(b)) > contrast::luminance(f(a)), "{look}: {pair:?} out of order");
+                assert!(contrast::ratio(f(a), f(b)) >= 1.2, "{look}: {pair:?} too close: {a:?} {b:?}");
+            }
+        }
+    }
+
+    #[test]
+    fn colours_that_already_read_keep_terminals_values() {
+        let hex = |c: u32| Rgb::new((c >> 16) as u8, (c >> 8) as u8, c as u8);
+        let (light, ..) = mac_profile_colors(false);
+        // Magenta (5) is darkened a little: bright magenta, raised to the floor, would
+        // otherwise sit too close to it.
+        for (i, c) in [(0, 0x000000), (1, 0x990000), (4, 0x0000b2), (9, 0xe50000), (12, 0x0000ff)] {
+            assert_eq!(light[i], hex(c), "light colour {i}");
+        }
+        let (dark, ..) = mac_profile_colors(true);
+        for (i, c) in [(2, 0x00a600), (3, 0x999900), (6, 0x00a6b2), (7, 0xbfbfbf), (10, 0x00d900), (11, 0xe5e500), (14, 0x00e5e5), (15, 0xe5e5e5)] {
+            assert_eq!(dark[i], hex(c), "dark colour {i}");
+        }
+    }
