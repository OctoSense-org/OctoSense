+
+// A regex is interned and runs again and again: what one run leaves behind must
+// not reach the next, whatever lengths of text they read.
+#[test]
+fn a_run_keeps_nothing_of_the_one_before() {
+    let regex = crate::Regex::new("^([0-9]+)-([0-9]+)-([0-9]+)T([0-9]+):([0-9]+)").unwrap();
+    for _ in 0..3 {
+        for (text, last) in [
+            ("2026-09-25T01:00", 14..16),
+            ("26-9-5T1:0", 9..10),
+            ("2026-10-28T08:00:00", 14..16),
+            ("926-10-28T8:00", 12..14),
+        ] {
+            let mut slots = vec![None; 12];
+            assert!(regex.run(text, &mut slots), "{text}");
+            assert_eq!(slots[0], Some(0), "{text}");
+            assert_eq!((slots[10], slots[11]), (Some(last.start), Some(last.end)), "{text}");
+        }
+    }
+}
