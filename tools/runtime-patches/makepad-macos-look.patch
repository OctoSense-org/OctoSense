+    /// How many tabs a desktop's strip shows at once: each shares the width and
+    /// keeps its words, and with too many the menu takes its place at the end.
+    fn desk_tabs_that_fit(&self) -> usize {
+        // A slot at the strip's end, the + or the menu's, and the rule before it.
+        const END: f64 = 33.0;
+        let sidebar = if self.sidebar_shown() { 209.0 } else { 0.0 };
+        let width = self.layout_width - sidebar;
+        if width < 1.0 {
+            return TOUCH_TABS;
+        }
+        let each = MIN_TAB_WIDTH + 1.0;
+        let all = ((width - END + 1.0) / each).floor() as usize;
+        if self.tabs.len() <= all {
+            return all.min(TAB_IDS.len());
+        }
+        (((width - 2.0 * END + 1.0) / each).floor() as usize).clamp(1, TAB_IDS.len())
+    }
+
+    /// Which tab a slot of the strip holds.
+    fn slot_tab(&self, slot: usize) -> Option<usize> {
+        let index = self.tab_first + slot;
+        (slot < self.tab_fit && index < self.tabs.len()).then_some(index)
+    }
+
+    /// Everything the window has open, from the strip's menu.
+    fn open_tab_menu(&mut self, cx: &mut Cx) {
+        let titles: Vec<String> = self.tabs.iter().map(|tab| model::friendly_name(&tab.dir, &self.home)).collect();
+        let anchor = self.ui.view(cx, ids!(tab_more_box)).area().rect(cx);
+        let at = dvec2(anchor.pos.x, anchor.pos.y + anchor.size.y + 4.0);
+        self.ui.tab_menu(cx, ids!(tab_menu)).open(cx, at, &titles, self.tab);
+    }
+
+    fn refresh_tab_strip(&mut self, cx: &mut Cx) {
+        // One tab is not a tab strip: it is a window, and a strip over it is
+        // just a bar that says nothing.
+        let many = self.tabs.len() > 1;
+        let strip = if self.desk { ids!(desk_tabs) } else { ids!(tab_strip) };
+        self.ui.widget(cx, strip).set_visible(cx, many);
+        let room = self.tabs.len() < self.tab_cap();
+        self.ui.widget(cx, ids!(tab_add_box)).set_visible(cx, room);
+        // The tab in front is always among those shown.
+        self.tab_fit = if self.desk { self.desk_tabs_that_fit() } else { TOUCH_TABS };
+        let mut first = self.tab_first.min(self.tabs.len().saturating_sub(self.tab_fit));
+        if self.tab < first {
+            first = self.tab;
+        } else if self.tab >= first + self.tab_fit {
+            first = self.tab + 1 - self.tab_fit;
+        }
+        self.tab_first = first;
+        if self.desk {
+            self.ui.widget(cx, ids!(tab_more_box)).set_visible(cx, self.tabs.len() > self.tab_fit);
+        }
+        let slots = if self.desk { TAB_IDS.len() } else { TOUCH_TABS };
+        let palette = &Palette::for_cx(cx);
+        // A desktop's strip is the toolbar's shade with the active tab open
+        // onto the content below it.
+        let (on, off) = if palette.desk {
+            (Palette::vec4(&palette.bg), Palette::vec4(&palette.bar))
+        } else {
+            (Palette::vec4(&palette.bg_light), Palette::vec4(&palette.bg_dark))
+        };
+        for (slot, id) in TAB_IDS[..slots].iter().enumerate() {
+            let at = self.slot_tab(slot).filter(|_| many);
+            let mut item = self.ui.view(cx, *id);
+            item.set_visible(cx, at.is_some());
+            let Some(index) = at else {
+                continue;
+            };
+            let title = if palette.desk {
+                model::friendly_name(&self.tabs[index].dir, &self.home)
+            } else {
+                display_name(&self.tabs[index].dir)
+            };
+            item.label(cx, ids!(tab_title)).set_text(cx, &title);
+            if palette.desk {
+                let shows_close = index == self.tab || self.tab_hover == Some(index);
+                item.widget(cx, ids!(tab_close)).set_visible(cx, shows_close);
+                let ink = Palette::vec4(if index == self.tab { &palette.fg_bright } else { &palette.fg_dim });
+                let mut label = item.label(cx, ids!(tab_title));
+                script_apply_eval!(cx, label, {
+                    draw_text +: {color: #(ink)}
+                });
             }
+            let color = if index == self.tab { on } else { off };
+            script_apply_eval!(cx, item, {
+                draw_bg +: {color: #(color)}
+            });
         }
     }
