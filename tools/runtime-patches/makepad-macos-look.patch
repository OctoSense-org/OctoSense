+//! A Mac's World Clock, offline: a compiled table of cities, each with its
+//! standard offset and daylight-saving rule. The app has no zone database and
+//! a module reads no files, so the rules live here, as the current law of the
+//! places listed; a city whose rule changes needs a line changed here.
+
+use crate::local_time::LocalTime;
+
+/// When a place's clocks go forward. Every rule moves them by one hour.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Dst {
+    None,
+    /// The US and Canada: second Sunday of March to first Sunday of November,
+    /// at 02:00 on the clock.
+    NorthAmerica,
+    /// The EU and the UK: last Sunday of March to last Sunday of October, at
+    /// 01:00 UTC.
+    Europe,
+    /// South-east Australia: first Sunday of October at 02:00 standard, to
+    /// first Sunday of April at 03:00 daylight.
+    Australia,
+    /// New Zealand: last Sunday of September at 02:00 standard, to first
+    /// Sunday of April at 03:00 daylight.
+    NewZealand,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct City {
+    pub name: &'static str,
+    pub country: &'static str,
+    /// Standard time, minutes east of UTC.
+    pub offset: i32,
+    pub dst: Dst,
+}
+
+const fn city(name: &'static str, country: &'static str, offset: i32, dst: Dst) -> City {
+    City { name, country, offset, dst }
+}
+
+/// What a new window's World Clock shows beside the local time.
