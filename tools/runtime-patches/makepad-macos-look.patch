+// ---------------------------------------------------------------------------
+// the desktop's documents: files in the app's own folder
+// ---------------------------------------------------------------------------
+
+/// A workbook's extension, and the only other kind Open offers.
+pub const BOOK_EXTENSION: &str = "sheets";
+pub const CSV_EXTENSION: &str = "csv";
+/// The document to reopen in the next window. Hidden, so no list offers it.
+pub const LAST_DOCUMENT: &str = ".last-document";
+
+/// What a document is saved as.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum DocFormat {
+    /// Every sheet, its formulas and formats.
+    #[default]
+    Book,
+    /// The sheet in front, its values only: a copy for other apps.
+    Csv,
+}
+
+impl DocFormat {
+    pub fn extension(self) -> &'static str {
+        match self {
+            DocFormat::Book => BOOK_EXTENSION,
+            DocFormat::Csv => CSV_EXTENSION,
+        }
+    }
+}
+
+/// One line of the Open sheet.
+#[derive(Clone, Debug, PartialEq)]
+pub struct DocEntry {
+    /// The file's name in the folder.
+    pub file: String,
+    /// What the list says: a workbook without its extension, as Finder hides it.
+    pub name: String,
+    /// When it last changed, as "Nov 2, 2026"; empty when nobody knows.
+    pub date: String,
+}
+
+/// What a file's name means here, or None for what Open does not offer.
+pub fn entry_for(file: &str, date: String) -> Option<DocEntry> {
+    if file.starts_with('.') {
+        return None;
+    }
+    let (stem, extension) = file.rsplit_once('.')?;
+    if stem.is_empty() {
+        return None;
+    }
+    let name = if extension.eq_ignore_ascii_case(BOOK_EXTENSION) {
+        stem.to_string()
+    } else if extension.eq_ignore_ascii_case(CSV_EXTENSION) {
+        file.to_string()
+    } else {
+        return None;
+    };
+    Some(DocEntry { file: file.to_string(), name, date })
+}
+
+/// The name a window calls a document by: its file's name, without the extension.
+pub fn title_of(file: &str) -> String {
+    match file.rsplit_once('.') {
+        Some((stem, _)) if !stem.is_empty() => stem.to_string(),
+        _ => file.to_string(),
+    }
+}
+
+pub fn is_csv(file: &str) -> bool {
+    file.rsplit_once('.').is_some_and(|(_, extension)| extension.eq_ignore_ascii_case(CSV_EXTENSION))
+}
+
+/// What is wrong with a name someone typed: None when it can be saved under.
+/// An empty name has nothing to say, its Save is simply off.
+pub fn name_problem(name: &str) -> Option<&'static str> {
+    let name = name.trim();
+    if name.is_empty() {
+        Some("")
+    } else if name.contains('/') {
+        Some("A name can\u{2019}t contain a slash.")
+    } else if name.contains('\\') || name.contains(':') {
+        Some("A name can\u{2019}t contain a backslash or a colon.")
+    } else if name.starts_with('.') {
+        Some("A name can\u{2019}t start with a period.")
+    } else if name.len() > 200 {
+        Some("This name is too long.")
+    } else {
+        None
+    }
+}
+
+/// The name as saved: a person who typed the extension meant the same file.
+pub fn file_name_for(name: &str, format: DocFormat) -> String {
+    let name = name.trim();
+    let extension = format.extension();
+    match name.rsplit_once('.') {
+        Some((stem, typed)) if !stem.is_empty() && typed.eq_ignore_ascii_case(extension) => format!("{stem}.{extension}"),
+        _ => format!("{name}.{extension}"),
+    }
+}
+
+/// What the toolbar says about a document saved at `secs`, seen at `now`.
+pub fn saved_words(secs: i64, now: i64) -> String {
+    let (saved, today) = (local_time::of(secs), local_time::of(now));
+    if (saved.year, saved.month, saved.day) == (today.year, today.month, today.day) {
+        format!("Saved at {}", saved.clock())
+    } else {
+        format!("Saved {}", saved.date())
+    }
+}
+
+/// The time now, where the platform has a clock to ask.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn now_secs() -> Option<i64> {
+    let age = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).ok()?;
+    Some(age.as_secs() as i64)
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn now_secs() -> Option<i64> {
+    None
+}
+
+/// The app's own folder. A sandboxed app's Makepad home is its jail; relative
+/// names would land in whatever folder it was started from.
+#[cfg(not(target_arch = "wasm32"))]
+pub fn documents_folder() -> std::path::PathBuf {
+    makepad_widgets::makepad_platform::home::makepad_home().join("sheets")
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn documents_folder() -> std::path::PathBuf {
+    std::path::PathBuf::new()
+}
+
+/// A failure in a person's words: the operating system's are not for them.
+fn failure_words(error: &std::io::Error) -> String {
+    match error.kind() {
+        std::io::ErrorKind::NotFound => "The file is no longer there.".to_string(),
+        // The shell's save panel says the same (`chosen_files`), as a Mac's alert does.
+        std::io::ErrorKind::PermissionDenied => "You don\u{2019}t have permission to use this file.".to_string(),
+        _ => "The disk may be full or unavailable.".to_string(),
+    }
+}
+
+/// A folder's documents, by name as a person reads them. A folder that is not
+/// there yet is an empty one; a folder that cannot be read is a failure.
+pub fn list_documents(folder: &std::path::Path) -> Result<Vec<DocEntry>, String> {
+    let read = match std::fs::read_dir(folder) {
+        Ok(read) => read,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(Vec::new()),
+        Err(e) => return Err(failure_words(&e)),
+    };
+    let mut entries: Vec<DocEntry> = read
+        .filter_map(|entry| entry.ok())
+        .filter_map(|entry| {
+            let meta = entry.metadata().ok()?;
+            if !meta.is_file() {
+                return None;
+            }
+            let date = meta
+                .modified()
+                .ok()
+                .and_then(|time| time.duration_since(std::time::UNIX_EPOCH).ok())
+                .map(|age| local_time::of(age.as_secs() as i64).date())
+                .unwrap_or_default();
+            entry_for(&entry.file_name().to_string_lossy(), date)
+        })
+        .collect();
+    entries.sort_by(|a, b| a.name.to_lowercase().cmp(&b.name.to_lowercase()));
+    Ok(entries)
+}
+
+pub fn read_document(folder: &std::path::Path, file: &str) -> Result<Vec<u8>, String> {
+    std::fs::read(folder.join(file)).map_err(|e| failure_words(&e))
+}
+
+/// All of a document or nothing: a failure leaves the old file as it was.
+pub fn write_document(folder: &std::path::Path, file: &str, bytes: &[u8]) -> Result<(), String> {
+    std::fs::create_dir_all(folder).map_err(|e| failure_words(&e))?;
+    let scratch = folder.join(format!(".{file}.saving"));
+    std::fs::write(&scratch, bytes).map_err(|e| failure_words(&e))?;
+    std::fs::rename(&scratch, folder.join(file)).map_err(|e| {
+        let _ = std::fs::remove_file(&scratch);
+        failure_words(&e)
+    })
+}
+
+/// When a document was last written, for a document just opened.
+pub fn modified_secs(folder: &std::path::Path, file: &str) -> Option<i64> {
+    let time = std::fs::metadata(folder.join(file)).ok()?.modified().ok()?;
+    Some(time.duration_since(std::time::UNIX_EPOCH).ok()?.as_secs() as i64)
+}
+
+/// Local time from the platform's own zone rules: a sandboxed app cannot ask `date`.
+pub mod local_time {
+    const MONTHS: [&str; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct Parts {
+        pub year: i64,
+        /// 1..=12
+        pub month: u32,
+        pub day: u32,
+        pub hour: u32,
+        pub minute: u32,
+    }
+
+    impl Parts {
+        /// "3:45 PM"
+        pub fn clock(&self) -> String {
+            let shown = match self.hour % 12 {
+                0 => 12,
+                other => other,
+            };
+            format!("{shown}:{:02} {}", self.minute, if self.hour >= 12 { "PM" } else { "AM" })
+        }
+
+        /// "Nov 2, 2026"
+        pub fn date(&self) -> String {
+            format!("{} {}, {}", MONTHS[(self.month.max(1) as usize - 1).min(11)], self.day, self.year)
+        }
+    }
+
+    pub fn of(secs: i64) -> Parts {
+        sys::local(secs).unwrap_or_else(|| utc(secs))
+    }
+
+    /// Howard Hinnant's civil_from_days.
+    pub fn utc(secs: i64) -> Parts {
+        let rem = secs.rem_euclid(86_400) as u32;
+        let z = secs.div_euclid(86_400) + 719_468;
+        let era = z.div_euclid(146_097);
+        let doe = z.rem_euclid(146_097);
+        let yoe = (doe - doe / 1460 + doe / 36_524 - doe / 146_096) / 365;
+        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+        let mp = (5 * doy + 2) / 153;
+        let day = (doy - (153 * mp + 2) / 5 + 1) as u32;
+        let month = (if mp < 10 { mp + 3 } else { mp - 9 }) as u32;
+        let year = yoe + era * 400 + if month <= 2 { 1 } else { 0 };
+        Parts { year, month, day, hour: rem / 3600, minute: (rem / 60) % 60 }
+    }
+
+    #[cfg(unix)]
+    mod sys {
+        use super::Parts;
+        use std::os::raw::{c_char, c_int, c_long};
+
+        /// The common prefix of `struct tm` on Darwin, glibc, musl and bionic.
+        #[repr(C)]
+        struct Tm {
+            tm_sec: c_int,
+            tm_min: c_int,
+            tm_hour: c_int,
+            tm_mday: c_int,
+            tm_mon: c_int,
+            tm_year: c_int,
+            tm_wday: c_int,
+            tm_yday: c_int,
+            tm_isdst: c_int,
+            tm_gmtoff: c_long,
+            tm_zone: *const c_char,
+        }
+
+        extern "C" {
+            fn tzset();
+            fn localtime_r(time: *const c_long, out: *mut Tm) -> *mut Tm;
+        }
+
+        pub fn local(secs: i64) -> Option<Parts> {
+            static TZ_INIT: std::sync::Once = std::sync::Once::new();
+            TZ_INIT.call_once(|| unsafe { tzset() });
+            let time = c_long::try_from(secs).ok()?;
+            let mut tm = Tm {
+                tm_sec: 0,
+                tm_min: 0,
+                tm_hour: 0,
+                tm_mday: 1,
+                tm_mon: 0,
+                tm_year: 70,
+                tm_wday: 4,
+                tm_yday: 0,
+                tm_isdst: 0,
+                tm_gmtoff: 0,
+                tm_zone: std::ptr::null(),
+            };
+            // SAFETY: `localtime_r` writes only into the caller's `tm`, whose
+            // layout matches the platform prefix declared above.
+            if unsafe { localtime_r(&time, &mut tm).is_null() } {
+                return None;
+            }
+            Some(Parts {
+                year: tm.tm_year as i64 + 1900,
+                month: (tm.tm_mon + 1).clamp(1, 12) as u32,
+                day: tm.tm_mday.clamp(1, 31) as u32,
+                hour: tm.tm_hour.clamp(0, 23) as u32,
+                minute: tm.tm_min.clamp(0, 59) as u32,
+            })
+        }
+    }
+
+    #[cfg(not(unix))]
+    mod sys {
+        pub fn local(_secs: i64) -> Option<super::Parts> {
+            None
+        }
+    }
+}
