@@ -13,6 +13,53 @@
 use std::sync::Arc;
 
 pub const DEFAULT_LOCAL_MODEL: &str = "local/models/Qwen3.5-9B-UD-Q4_K_XL.gguf";
+/// How deep the Models folder is searched: the registry installs a model as
+/// `<repo>/<file>`, so two levels reach every one.
+const MODELS_SEARCH_DEPTH: usize = 2;
+
+/// Where the dispatcher's model is: the override, then a chat model in the
+/// Models folder (the folder AI looks in, the hub's `weights`), then the
+/// checkout's copy. It may name nothing: the hub still looks on the network.
+pub fn model_path() -> String {
+    if let Ok(path) = std::env::var("MAKEPAD_ROUTE_LOCAL_MODEL") {
+        return path;
+    }
+    match chat_model_under(&makepad_ai_hub::home::weights_dir(), 0) {
+        Some(found) => found.display().to_string(),
+        None => DEFAULT_LOCAL_MODEL.to_string(),
+    }
+}
+
+/// The largest chat model under `dir`, a Qwen before any other. Projector and
+/// OCR files are not chat models. The same choice as AI's.
+fn chat_model_under(dir: &std::path::Path, depth: usize) -> Option<PathBuf> {
+    let mut best: Option<(bool, u64, PathBuf)> = None;
+    for entry in std::fs::read_dir(dir).ok()?.flatten() {
+        let path = entry.path();
+        let found = if path.is_dir() {
+            if depth >= MODELS_SEARCH_DEPTH {
+                continue;
+            }
+            match chat_model_under(&path, depth + 1) {
+                Some(found) => found,
+                None => continue,
+            }
+        } else {
+            let name = path.file_name().and_then(|n| n.to_str()).unwrap_or_default().to_ascii_lowercase();
+            if !name.ends_with(".gguf") || name.contains("mmproj") || name.contains("ocr") {
+                continue;
+            }
+            path
+        };
+        let size = std::fs::metadata(&found).map(|m| m.len()).unwrap_or(0);
+        let name = found.file_name().and_then(|n| n.to_str()).unwrap_or_default().to_ascii_lowercase();
+        let rank = (name.contains("qwen"), size);
+        if best.as_ref().is_none_or(|(qwen, size, _)| rank > (*qwen, *size)) {
+            best = Some((rank.0, rank.1, found));
+        }
+    }
+    best.map(|(_, _, path)| path)
+}
