+    /// Paint the top of `sky`, a sky of `whole` points, as it does: a pinned
+    /// header over the page's sky, which then shows no seam and nothing that
+    /// scrolls under it. `fade` brings it in as it pins.
+    pub fn follow(&mut self, cx: &mut Cx, sky: &SkyView, whole: Vec2d, fade: f32) {
+        let s = &sky.draw_sky;
+        let frame = vec4(0.0, 0.0, whole.x as f32, whole.y as f32);
+        let d = &mut self.draw_sky;
+        let zones = [s.zone0, s.zone1, s.zone2, s.zone3, s.zone4, s.zone5, s.zone6];
+        let same = d.kind == s.kind
+            && d.phase == s.phase
+            && d.cover == s.cover
+            && d.precip == s.precip
+            && d.time == s.time
+            && d.calm == s.calm
+            && d.feather == s.feather
+            && d.soft_feather == s.soft_feather
+            && [d.zone0, d.zone1, d.zone2, d.zone3, d.zone4, d.zone5, d.zone6] == zones
+            && d.frame == frame
+            && d.fade == fade;
+        if !same {
+            (d.kind, d.phase, d.cover, d.precip, d.time, d.calm) = (s.kind, s.phase, s.cover, s.precip, s.time, s.calm);
+            (d.feather, d.soft_feather) = (s.feather, s.soft_feather);
+            [d.zone0, d.zone1, d.zone2, d.zone3, d.zone4, d.zone5, d.zone6] = zones;
+            d.frame = frame;
+            d.fade = fade;
+            d.redraw(cx);
+        }
+    }
+
