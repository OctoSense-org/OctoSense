diff --git a/widgets/src/context_menu.rs b/widgets/src/context_menu.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f3ad6295830b33ce1c00261e412f06f091b2315c
--- /dev/null
+++ b/widgets/src/context_menu.rs
@@ -0,0 +1,272 @@
+//! A right-click menu for a native widget that draws its own rows: the shared
+//! `PopupMenu` at the pointer, with what a `GestureView`'s `menu:` and a text
+//! field's menu give theirs (the highlight, the keys, a press that closes it).
+//! The owner decides when it opens and what its rows are, and acts on a choice.
+//!
+//! The owner's DSL says `popup_menu: mod.widgets.PopupMenu{}` for a
+//! `#[live] popup_menu: ScriptValue`. It offers its events here first, and draws
+//! this at the end of its own `draw_walk`.
+
+use crate::{
+    drop_down::{PopupMenuGlobal, PopupMenuKey},
+    gesture_view::MenuPressClaim,
+    makepad_draw::*,
+    popup_menu::{PopupMenu, PopupMenuAction},
+    widget::*,
+    widget_async::CxSplashVmExt,
+};
+
+/// A sheet takes the pointer, so what lay under the pointer as it opened hears no
+/// move that would tell it the pointer left, and it stays lit. After the sheet has
+/// had a move, this marks it taken if it is over the owner and says to offer it to
+/// the tree under the sheet too: nothing there lights, and what was lit goes out.
+pub fn pass_move_under_sheet(cx: &Cx, event: &Event, owner: Area) -> bool {
+    let Event::MouseMove(moved) = event else {
+        return false;
+    };
+    if cx.fingers.first_mouse_button.is_some() {
+        return false;
+    }
+    if moved.handled.get().is_empty() && owner.clipped_rect(cx).contains(moved.abs) {
+        moved.handled.set(owner);
+    }
+    true
+}
+
+/// One row of the menu; its title `"-"` is a rule.
+#[derive(Clone, Debug, PartialEq)]
+pub struct ContextRow {
+    pub title: String,
+    /// A row with nothing to act on is grey, and the pointer passes it by.
+    pub live: bool,
+}
+
+impl ContextRow {
+    pub fn new(title: &str, live: bool) -> Self {
+        Self { title: title.into(), live }
+    }
+    pub fn rule() -> Self {
+        Self { title: "-".into(), live: false }
+    }
+}
+
+/// What an event did to the menu.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum ContextMenuEvent {
+    /// It is the owner's, as if there were no menu.
+    Ignored,
+    /// The menu took it.
+    Spent,
+    /// The person chose this row (its index in the rows).
+    Chosen(usize),
+}
+
+#[derive(Clone, Copy)]
+struct Placed {
+    origin: DVec2,
+    at: DVec2,
+    keyboard: Option<usize>,
+}
+
+/// Where the menu's template lives and which area owns it, as the owner has them:
+/// `self.view.source`, its `popup_menu`, `self.view.area()`.
+#[derive(Clone, Copy)]
+pub struct ContextMenuOwner<'a> {
+    pub source: &'a ScriptObjectRef,
+    pub template: ScriptValue,
+    pub area: Area,
+}
+
+impl ContextMenuOwner<'_> {
+    fn key(&self) -> PopupMenuKey {
+        PopupMenuKey { heap: self.source.heap_key(), template: self.template }
+    }
+}
+
+#[derive(Default)]
+pub struct ContextMenu {
+    placed: Option<Placed>,
+    rows: Vec<ContextRow>,
+    ticked: Option<usize>,
+    closing: bool,
+    /// A toolbar's pull-down: past the window's edge it slides back, where a
+    /// right click's menu opens to the other side of the pointer.
+    slides: bool,
+}
+
+impl ContextMenu {
+    pub fn is_open(&self) -> bool {
+        self.placed.is_some()
+    }
+
+    /// Open at the window point `abs`, on the press at `time`.
+    pub fn open(&mut self, cx: &mut Cx, owner: ContextMenuOwner, abs: DVec2, time: f64, rows: Vec<ContextRow>) {
+        self.open_ticked(cx, owner, abs, time, rows, None)
+    }
+
+    /// `open_ticked` for a menu that hangs from a tool in a toolbar.
+    pub fn open_pull_down(&mut self, cx: &mut Cx, owner: ContextMenuOwner, abs: DVec2, time: f64, rows: Vec<ContextRow>, ticked: Option<usize>) {
+        self.open_ticked(cx, owner, abs, time, rows, ticked);
+        self.slides = true;
+    }
+
+    /// `open`, with one row ticked: the place something is in now.
+    pub fn open_ticked(&mut self, cx: &mut Cx, owner: ContextMenuOwner, abs: DVec2, time: f64, rows: Vec<ContextRow>, ticked: Option<usize>) {
+        self.slides = false;
+        if rows.is_empty() || owner.template.is_nil() {
+            return;
+        }
+        let Some(vm_id) = cx.script_ref_vm_id(owner.source) else {
+            return;
+        };
+        let global = cx.global::<PopupMenuGlobal>().clone();
+        let Ok(mut map) = global.map.try_borrow_mut() else {
+            return;
+        };
+        let template = owner.template;
+        map.get_or_insert(cx, owner.key(), |cx| {
+            cx.with_script_vm_id(vm_id, |vm| PopupMenu::script_from_value(vm, template))
+        })
+        .clear_item_states(cx);
+        drop(map);
+        // The views around the owner leave this press to it.
+        cx.global::<MenuPressClaim>().time = time;
+        let origin = owner.area.rect(cx).pos;
+        self.placed = Some(Placed { origin, at: abs - origin, keyboard: None });
+        self.rows = rows;
+        self.ticked = ticked;
+        cx.sweep_take(owner.area);
+        cx.set_cursor(MouseCursor::Default);
+        owner.area.redraw(cx);
+    }
+
+    pub fn close(&mut self, cx: &mut Cx, area: Area) {
+        if self.placed.take().is_some() {
+            cx.sweep_unlock(area);
+            area.redraw(cx);
+        }
+    }
+
+    /// While it is open, the pointer and the keys are the menu's.
+    pub fn handle_event(&mut self, cx: &mut Cx, event: &Event, owner: ContextMenuOwner) -> ContextMenuEvent {
+        let area = owner.area;
+        if self.closing && matches!(event, Event::MouseDown(_) | Event::MouseUp(_)) {
+            self.closing = false;
+            cx.sweep_unlock(area);
+            if matches!(event, Event::MouseUp(_)) {
+                return ContextMenuEvent::Spent;
+            }
+        }
+        let Some(mut placed) = self.placed else {
+            return ContextMenuEvent::Ignored;
+        };
+        let global = cx.global::<PopupMenuGlobal>().clone();
+        let mut map = global.map.borrow_mut();
+        let Some(menu) = map.get_mut(&owner.key()) else {
+            drop(map);
+            self.close(cx, area);
+            return ContextMenuEvent::Ignored;
+        };
+        let mut chosen = None;
+        let mut close = false;
+        menu.handle_event_with(cx, event, area, &mut |_, action| {
+            if let PopupMenuAction::WasSelected(id) = action {
+                chosen = Some(id.0.0 as usize);
+            }
+        });
+        match event {
+            Event::MouseDown(e) if !menu.menu_contains_pos(cx, e.abs) => {
+                close = true;
+                // A left press only closes the menu. A view can read a press someone
+                // handled, so the lock stays until its release.
+                if e.button.is_primary() {
+                    e.handled.set(area);
+                    self.closing = true;
+                }
+            }
+            // A grey row, or a rule: the press is still the menu's.
+            Event::MouseDown(e) if e.handled.get().is_empty() => e.handled.set(area),
+            Event::KeyDown(key) => match key.key_code {
+                KeyCode::Escape => close = true,
+                KeyCode::ReturnKey | KeyCode::NumpadEnter => {
+                    chosen = placed.keyboard;
+                    close = chosen.is_none();
+                }
+                KeyCode::ArrowDown | KeyCode::ArrowUp => {
+                    let count = self.rows.len() as isize;
+                    let step = if key.key_code == KeyCode::ArrowDown { 1 } else { -1 };
+                    let mut at = placed.keyboard.map_or(if step > 0 { -1 } else { count }, |i| i as isize);
+                    for _ in 0..count {
+                        at = (at + step + count) % count;
+                        if self.rows[at as usize].live {
+                            placed.keyboard = Some(at as usize);
+                            menu.highlight_item(cx, LiveId(at as u64).into());
+                            menu.redraw(cx);
+                            break;
+                        }
+                    }
+                    self.placed = Some(placed);
+                }
+                _ => {}
+            },
+            _ => {}
+        }
+        drop(map);
+        if let Some(index) = chosen {
+            self.close(cx, area);
+            return ContextMenuEvent::Chosen(index);
+        }
+        if close {
+            self.close(cx, area);
+            if self.closing {
+                cx.sweep_take(area);
+            }
+            // A right press goes on, and opens the menu of what it landed on.
+            return if matches!(event, Event::MouseDown(e) if !e.button.is_primary()) {
+                ContextMenuEvent::Ignored
+            } else {
+                ContextMenuEvent::Spent
+            };
+        }
+        if matches!(
+            event,
+            Event::MouseDown(_) | Event::MouseUp(_) | Event::MouseMove(_) | Event::KeyDown(_) | Event::KeyUp(_) | Event::TextInput(_) | Event::Scroll(_)
+        ) {
+            ContextMenuEvent::Spent
+        } else {
+            ContextMenuEvent::Ignored
+        }
+    }
+
+    /// At the end of the owner's own draw. `uid` is the owner's widget, whose
+    /// children the rows read as in the widget tree.
+    pub fn draw(&mut self, cx: &mut Cx2d, uid: WidgetUid, owner: ContextMenuOwner) {
+        let Some(placed) = self.placed else {
+            return;
+        };
+        let global = cx.global::<PopupMenuGlobal>().clone();
+        let mut map = global.map.borrow_mut();
+        let Some(menu) = map.get_mut(&owner.key()) else {
+            return;
+        };
+        // One menu instance serves everything with the same template.
+        menu.tree_parent = uid;
+        menu.min_width = 180.0;
+        menu.ticked_item = self.ticked.map(|i| LiveId(i as u64).into());
+        menu.begin(cx);
+        for (index, row) in self.rows.iter().enumerate() {
+            if row.title == "-" {
+                menu.draw_separator(cx);
+            } else if row.live {
+                menu.draw_item(cx, LiveId(index as u64).into(), &row.title);
+            } else {
+                menu.draw_item_off(cx, LiveId(index as u64).into(), &row.title);
+            }
+        }
+        if self.slides {
+            menu.end_slid_inside_window(cx, owner.area, placed.origin, placed.at);
+        } else {
+            menu.end_inside_window(cx, owner.area, placed.origin, placed.at);
+        }
+    }
+}
