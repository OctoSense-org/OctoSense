+    fn a_twelve_hour_clock_reads_both_ways() {
+        assert_eq!(hour12(0), (12, 0, false));
+        assert_eq!(hour12(9 * 60 + 5), (9, 5, false));
+        assert_eq!(hour12(12 * 60), (12, 0, true));
+        assert_eq!(hour12(15 * 60 + 45), (3, 45, true));
+        assert_eq!(from_hour12(12, 0, false), 0);
+        assert_eq!(from_hour12(12, 30, true), 12 * 60 + 30);
+        assert_eq!(from_hour12(3, 45, true), 15 * 60 + 45);
+    }
+}
