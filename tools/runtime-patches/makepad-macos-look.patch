+            view.load = LoadState::Ready;
+            view.ui = engine::initial_ui(&view.doc);
+            view.refresh_projection();
+            // A Mac's window with no title bar over the app.
+            view.pointer = true;
+            view.unified = true;
+        }
+        // Three columns leave the note 528 points, two at 720 and 640 leave it
+        // 474 and 421: the field is the toolbar's. At 560 and the 420-point
+        // minimum the note is narrower and the field heads the list.
+        for (width, in_bar) in [(994.0, true), (720.0, true), (640.0, true), (560.0, false), (420.0, false), (994.0, true)] {
+            draw(&mut cx, &root, dvec2(width, 600.0));
+            let view = root.borrow::<NotesView>().unwrap();
+            assert_eq!(view.search_in_bar, in_bar, "at {width}");
+            assert_eq!(view.view.widget(&mut cx, ids!(wide.editor.toolbar.search_tool)).visible(), in_bar, "at {width}");
+            assert_eq!(view.view.widget(&mut cx, ids!(wide.notes_list.search_slot)).visible(), !in_bar, "at {width}");
