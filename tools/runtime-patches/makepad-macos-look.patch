+//! The folder's pictures down the window's leading edge, as Preview's sidebar
+//! has them. A folder can hold thousands of photographs, so a picture costs
+//! nothing until its row comes into view, only a few are on their way at any
+//! time, and only the ones seen most recently are kept. What's kept is decoded
+//! for the size it's drawn, not the picture's own: a few hundred kilobytes each
+//! against the 96 MB of a 24-megapixel photograph.
+
+use makepad_widgets::image::Image;
+use makepad_widgets::image_cache::{
+    load_image_from_cache, load_image_from_data_async_at_size, process_async_image_load, AsyncImageLoad,
+    AsyncLoadResult, ImageCacheImpl,
+};
+use makepad_widgets::*;
+use std::cell::RefCell;
+use std::collections::{HashMap, HashSet};
+use std::ffi::OsString;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+/// A row is one height whatever its picture is, so the strip scrolls evenly
+/// and doesn't move as the pictures arrive.
+const ROW_HEIGHT: f64 = 124.0;
+/// The box a picture fits in, in points.
+const PICTURE: (f64, f64) = (118.0, 88.0);
+/// Files being read or decoded at once. Each costs its encoded bytes and, while
+/// it decodes, all of its pixels, so this is what bounds the worst moment.
+const AT_ONCE: usize = 3;
+/// Thumbnails kept; those seen longest ago go first. More than any window shows.
+const KEPT: usize = 48;
+/// A file bigger than this isn't read for a thumbnail.
+const LARGEST_FILE: u64 = 256 * 1024 * 1024;
+/// What a thumbnail's decode is cached under: not the picture's own path, so
+/// that the viewer's full decode and this one never stand in for each other.
+const KEY_ENDING: &str = "#thumbnail";
+
+script_mod! {
+    use mod.prelude.widgets_internal.*
+    use mod.widgets.*
+
+    mod.widgets.MpImageThumbsBase = #(MpImageThumbs::register_widget(vm))
+
+    // A sidebar's gray, a hairline along its edge, the current picture in the
+    // source list's selection: PDF's thumbnail strip, whose sidebar this follows.
+    let ink = theme.color_text
+    let page = theme.color_bg_app
+    let sidebar = mix(page, ink, 0.03)
+    let muted = mix(ink, page, 0.24)
+
+    mod.widgets.MpImageThumbs = set_type_default() do mod.widgets.MpImageThumbsBase{
+        width: 150
+        height: Fill
+        flow: Overlay
+
+        strip_bg := SolidView{
+            width: Fill
+            height: Fill
+            flow: Down
+            draw_bg +: { color: sidebar }
+
+            strip := PortalList{
+                width: Fill
+                height: Fill
+                flow: Down
+
+                Thumb := View{
+                    width: Fill
+                    height: 124
+                    flow: Down
+                    spacing: 2
+                    padding: Inset{top: 6 left: 12 right: 12}
+                    cursor: MouseCursor.Default
+
+                    frame := View{
+                        width: Fill
+                        height: 96
+                        flow: Overlay
+                        align: Align{x: 0.5 y: 0.5}
+
+                        selected := RoundedView{
+                            visible: false
+                            width: Fill
+                            height: Fill
+                            draw_bg +: { color: mix(page, ink, 0.2) border_radius: 2.5 }
+                        }
+                        // Until its picture comes, or if it can't.
+                        waiting := RoundedView{
+                            width: 118
+                            height: 88
+                            align: Align{x: 0.5 y: 0.5}
+                            draw_bg +: { color: mix(page, ink, 0.08) border_radius: 1.5 }
+                            unreadable := View{
+                                visible: false
+                                width: Fit
+                                height: Fit
+                                Icon{
+                                    icon_walk: Walk{width: 24 height: 24}
+                                    draw_icon +: {
+                                        svg: crate_resource("self://resources/icons/photo.svg")
+                                        color: muted
+                                    }
+                                }
+                            }
+                        }
+                        picture_box := View{
+                            width: 118
+                            height: 88
+                            align: Align{x: 0.5 y: 0.5}
+                            picture := Image{
+                                visible: false
+                                width: Fill
