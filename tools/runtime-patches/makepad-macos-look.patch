+pub fn encode_kept(epoch: u64, body: &str) -> Vec<u8> {
+    format!("{epoch}\n{body}").into_bytes()
+}
+
+pub fn decode_kept(bytes: &[u8]) -> Option<(u64, &str)> {
+    let text = std::str::from_utf8(bytes).ok()?;
+    let (epoch, body) = text.split_once('\n')?;
+    Some((epoch.parse().ok()?, body))
+}
