+//! The terminal on a pointer desktop (`theme.ui_pointer`), the way Terminal.app has it:
+//! the tab bar under the title bar, the question sheets, the settings sheet with its
+//! pop-ups, the context menu, the window's title. A child module of `crate::tabs`, so
+//! it reaches the widget's fields. A phone keeps the bar and the panel in `tabs.rs`.
+
+use super::*;
+use crate::palette::{mix, DeskPalette};
+use crate::settings_panel::{self as model, DeskKind, DESK_PANES};
+
+/// What a press lands on in a sheet or a menu.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) enum DeskHit {
+    Cancel,
+    Confirm,
+    /// Inside a sheet, on no control.
+    Sheet,
+    Pane(usize),
+    Control(Row),
+    Step(Row, i32),
+    Restore,
+    Done,
+    NameField,
+    NameCancel,
+    NameSave,
+    DeleteCancel,
+    DeleteConfirm,
+    MenuItem(usize),
+    MenuUp,
+    MenuDown,
+}
+
+/// What a sheet's text is set in: 13-point body, its bold, 12 and 11 points.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Type {
+    Body,
+    Bold,
+    Small,
+    Note,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Glyph {
+    Xmark,
+    Plus,
+    Check,
+    UpDown,
+    Up,
+    Down,
+}
+
+/// A row of the settings sheet's shortcut list.
+const LIST_ROW: f64 = 22.0;
+const LIST_ROWS: usize = 10;
+const CONTROL: f64 = 28.0;
+const ROW_GAP: f64 = 8.0;
+const CHECK_ROW: f64 = 20.0;
+const NOTE_ROW: f64 = 16.0;
+const MENU_ROW: f64 = 22.0;
+const MENU_PAD: f64 = 5.0;
+const MENU_SEP: f64 = 9.0;
+/// How long a scroll knob stays after the scrolling ends.
+const KNOB_SECONDS: f64 = 1.0;
+/// The Settings window's toolbar: a pane a button, its picture over its name.
+const SETTINGS_TOOLBAR: f64 = 62.0;
+/// The Settings window's width; its height follows the pane.
+const SETTINGS_WIDTH: f64 = 600.0;
+
+/// What's up in the overlay, and the pointer's state over it.
+#[derive(Default)]
+pub(super) struct DeskUi {
+    hits: Vec<(Rect, DeskHit)>,
+    hover: Option<DeskHit>,
+    press: Option<DeskHit>,
+    settings: Option<SettingsSheet>,
+    menu: Option<Menu>,
+    /// The focused pane's columns and rows, in the window's title.
+    cells: (usize, usize),
+    knob_until: f64,
+    knob_timer: Timer,
+}
+
+#[derive(Default)]
+struct SettingsSheet {
+    pane: usize,
+    /// The control the keyboard is on, once Tab or an arrow has been used.
+    focus: Option<DeskHit>,
+    /// Content rows scrolled off the top (a very short window).
+    scroll: usize,
+    max_scroll: usize,
+    /// The shortcut list's rows scrolled off its top.
+    list_scroll: usize,
+    list_rows: usize,
+    list_rect: Rect,
+    /// Typing a name for Save As….
+    name: Option<NameEdit>,
+    /// Delete… asks.
+    asking_delete: bool,
+    /// How the last profile action went.
+    note: Option<String>,
+}
+
+struct MenuItem {
+    label: String,
+    keys: String,
+    enabled: bool,
+    checked: bool,
+    separated: bool,
+    act: MenuAct,
+}
+
+#[derive(Clone)]
+enum MenuAct {
+    Apply(Box<Settings>),
+    Copy,
+    Paste,
+    SelectAll,
+    Clear,
+    Find,
+    NewTab,
+    Settings,
+    CloseTab(usize),
+    CloseOtherTabs(usize),
+    RenameTab(usize),
+}
+
+struct Menu {
+    items: Vec<MenuItem>,
+    /// A pop-up's button: the menu lies over it with the current item on its text.
+    /// None: a context menu, opening at `at`.
+    anchor: Option<Rect>,
+    at: DVec2,
+    hover: Option<usize>,
+    /// The first item shown, and how many fit.
+    top: usize,
+    visible: usize,
+    placed: bool,
+    /// The widest label and the widest keys, measured once.
+    widths: (f64, f64),
+    rect: Rect,
+    /// The press that opened it is still down: a release on an item picks it.
+    opening: bool,
+    moved: bool,
+    typed: String,
+    typed_at: f64,
+}
+
+impl Menu {
+    fn new(items: Vec<MenuItem>, anchor: Option<Rect>, at: DVec2) -> Menu {
+        let hover = anchor.and_then(|_| items.iter().position(|i| i.checked));
+        Menu {
+            items,
+            anchor,
+            at,
+            hover,
+            top: 0,
+            visible: 0,
+            placed: false,
+            widths: (0.0, 0.0),
+            rect: Rect::default(),
+            opening: true,
+            moved: false,
+            typed: String::new(),
+            typed_at: 0.0,
+        }
+    }
+
+    fn step(&mut self, dir: i64) {
+        let n = self.items.len() as i64;
+        if n == 0 {
+            return;
+        }
+        let mut at = match self.hover {
+            Some(i) => i as i64 + dir,
+            None if dir > 0 => 0,
+            None => n - 1,
+        };
+        while (0..n).contains(&at) && !self.items[at as usize].enabled {
+            at += dir;
+        }
+        if (0..n).contains(&at) {
+            self.hover = Some(at as usize);
+            self.reveal();
+        }
+    }
+
+    /// Keep the highlighted item in view.
+    fn reveal(&mut self) {
+        let Some(at) = self.hover else {
+            return;
+        };
+        if self.visible == 0 {
+            return;
+        }
+        let (above, below) = self.arrows();
+        let first = self.top + usize::from(above);
+        let last = (self.top + self.visible).saturating_sub(usize::from(below) + 1);
+        if at < first {
+            self.top = at.saturating_sub(usize::from(at > 0));
+        } else if at > last {
+            self.top = (at + 2).saturating_sub(self.visible).min(self.items.len() - self.visible);
+        }
+    }
+
+    /// Whether the top and the bottom row are scroll arrows.
+    fn arrows(&self) -> (bool, bool) {
+        (self.top > 0, self.top + self.visible < self.items.len())
+    }
+
+    fn scroll(&mut self, by: i64) {
+        let max = self.items.len().saturating_sub(self.visible) as i64;
+        self.top = (self.top as i64 + by).clamp(0, max) as usize;
+    }
+
+    /// Jump to the first item starting with what has been typed.
+    fn type_select(&mut self, typed: &str, now: f64) {
+        if now - self.typed_at > 1.0 {
+            self.typed.clear();
+        }
+        self.typed_at = now;
+        self.typed.push_str(&typed.to_lowercase());
+        let found = self.items.iter().position(|i| i.enabled && i.label.to_lowercase().starts_with(&self.typed));
+        if let Some(at) = found {
+            self.hover = Some(at);
+            self.reveal();
+        }
+    }
+}
+
+/// A Mac's words for the running programs a close ends: each name once.
+fn process_list(names: impl IntoIterator<Item = String>) -> (bool, String) {
+    let mut seen: Vec<String> = Vec::new();
+    for name in names {
+        if !seen.contains(&name) {
+            seen.push(name);
+        }
+    }
+    (seen.len() > 1, seen.join(", "))
+}
+
+/// A close question as (title, explanation, its button).
+pub(super) fn close_words(pending: &PendingClose) -> (String, String, &'static str) {
+    match pending {
+        PendingClose::Tab { pane, job, .. } => {
+            let what = if pane.is_some() { "pane" } else { "tab" };
+            (
+                format!("Do you want to terminate running processes in this {what}?"),
+                format!("Closing this {what} will terminate the running process: {job}."),
+                "Terminate",
+            )
+        }
+        PendingClose::All { jobs } => {
+            let (several, names) = process_list(jobs.iter().map(|(_, job)| job.clone()));
+            let process = if several { "processes" } else { "process" };
+            (
+                "Do you want to terminate running processes in this window?".to_owned(),
+                format!("Closing this window will terminate the running {process}: {names}."),
+                "Terminate",
+            )
+        }
+        PendingClose::AllTabs { count } => (
+            "Do you want to close all tabs in this window?".to_owned(),
+            format!("This window has {count} tabs."),
+            "Close All",
+        ),
+    }
+}
+
+/// A folder as a Mac's title says it: its name, the home folder's too.
+fn folder_name(dir: &Path) -> String {
+    dir.file_name().map_or_else(|| dir.display().to_string(), |name| name.to_string_lossy().into_owned())
+}
+
+/// A shell's name without the mark of a login shell.
+fn program_name(name: &str) -> String {
+    name.trim_start_matches('-').to_owned()
+}
+
+/// What a tab is called in a desktop's tab bar.
+pub(super) fn desk_tab_label(tab: &Tab, mode: TabTitle) -> String {
+    let pane = tab.focused_pane();
+    if let Some(name) = tab.custom_title.as_deref().map(str::trim).filter(|name| !name.is_empty()) {
+        return name.to_owned();
+    }
+    let osc = Some(pane.osc_title.trim()).filter(|osc| !osc.is_empty()).map(str::to_owned);
+    let folder = pane.dir.as_deref().map(folder_name);
+    let program = pane.job.clone().or_else(|| pane.shell.as_deref().map(program_name));
+    let label = match mode {
+        TabTitle::Program => osc.or(program).or(folder),
+        TabTitle::Directory => folder.or(program),
+    }
+    .unwrap_or_else(|| "Terminal".to_owned());
+    if tab.panes.len() > 1 {
+        format!("{label} \u{00b7} {}", tab.panes.len())
+    } else {
+        label
+    }
+}
+
+/// The window's title, as Terminal.app writes it: where, what, and how big.
+pub(super) fn desk_window_title(tab: &Tab, cells: (usize, usize)) -> String {
+    let pane = tab.focused_pane();
+    let named = tab.custom_title.as_deref().map(str::trim).filter(|name| !name.is_empty()).map(str::to_owned);
+    let osc = Some(pane.osc_title.trim()).filter(|osc| !osc.is_empty()).map(str::to_owned);
+    let first = named.or(osc).or_else(|| pane.dir.as_deref().map(folder_name));
+    let what = pane.job.clone().or_else(|| pane.shell.as_deref().map(program_name));
+    if first.is_none() && what.is_none() {
+        return "Terminal".to_owned();
+    }
+    let mut parts: Vec<String> = first.into_iter().chain(what).collect();
+    if cells.0 > 0 && cells.1 > 0 {
+        parts.push(format!("{}\u{00d7}{}", cells.0, cells.1));
+    }
+    parts.join(" \u{2014} ")
+}
+
+fn inset(rect: Rect, by: f64) -> Rect {
+    Rect { pos: rect.pos + dvec2(by, by), size: dvec2((rect.size.x - 2.0 * by).max(0.0), (rect.size.y - 2.0 * by).max(0.0)) }
+}
+
+fn rect_at(x: f64, y: f64, w: f64, h: f64) -> Rect {
+    Rect { pos: dvec2(x, y), size: dvec2(w, h) }
+}
+
+impl TermTabs {
+    fn palette(&self) -> DeskPalette {
+        DeskPalette::of(self.ink, self.page)
+    }
+
+    /// A sheet or a menu is up: the terminal under it takes no input.
+    pub(super) fn desk_modal(&self) -> bool {
+        self.desk && (self.pending_close.is_some() || self.desk_ui.settings.is_some() || self.desk_ui.menu.is_some())
+    }
+
+    /// One of the desk's own menus is up.
+    pub(super) fn desk_menu_up(&self) -> bool {
+        self.desk && self.desk_ui.menu.is_some()
+    }
+
+    /// Open another window: the window manager's, else another process.
+    pub(super) fn desk_new_window(&mut self, cx: &mut Cx) {
+        let cwd = self.new_cwd();
+        let args: Vec<String> = cwd
+            .iter()
+            .flat_map(|dir| ["--cwd".to_owned(), dir.display().to_string()])
+            .collect();
+        let asked = makepad_wm_api::send(cx, &makepad_wm_api::WmRequest::Launch { app: "terminal".into(), args: args.clone() });
+        if !asked {
+            if let Ok(exe) = std::env::current_exe() {
+                let spawned = std::process::Command::new(exe)
+                    .args(&args)
+                    .stdin(std::process::Stdio::null())
+                    .stdout(std::process::Stdio::null())
+                    .stderr(std::process::Stdio::null())
+                    .spawn();
+                if let Err(err) = spawned {
+                    error!("terminal: could not open a new window: {err}");
+                }
+            }
+        }
+    }
+
+    pub(super) fn desk_title(&self) -> String {
+        self.tabs
+            .get(self.active)
+            .map_or_else(|| "Terminal".to_owned(), |tab| desk_window_title(tab, self.desk_ui.cells))
+    }
+
+    /// The title says how big the terminal is: tell the window when that changes.
+    pub(super) fn desk_update_cells(&mut self, cx: &mut Cx) {
+        let cells = self
+            .tabs
+            .get(self.active)
+            .and_then(|tab| tab.with_term(|term| term.grid_cells()))
+            .unwrap_or((0, 0));
+        if cells != self.desk_ui.cells {
+            self.desk_ui.cells = cells;
+            self.report_title(cx);
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // Drawing's small parts
+    // ------------------------------------------------------------------
+
+    fn fill(&mut self, cx: &mut Cx2d, rect: Rect, color: Vec4f, radius: f32) {
+        self.draw_desk.color = color;
+        self.draw_desk.line_width = 0.0;
+        self.draw_desk.radius = radius;
+        self.draw_desk.draw_abs(cx, rect);
+    }
+
+    fn framed(&mut self, cx: &mut Cx2d, rect: Rect, color: Vec4f, line: Vec4f, radius: f32) {
+        self.draw_desk.color = color;
+        self.draw_desk.line = line;
+        self.draw_desk.line_width = 1.0;
+        self.draw_desk.radius = radius;
+        self.draw_desk.draw_abs(cx, rect);
+    }
+
+    /// The ring round the control the keyboard is on.
+    fn focus_ring(&mut self, cx: &mut Cx2d, c: &DeskPalette, rect: Rect, radius: f32) {
+        let ring = vec4(c.primary.x, c.primary.y, c.primary.z, 0.55);
+        self.draw_desk.color = vec4(0.0, 0.0, 0.0, 0.0);
+        self.draw_desk.line = ring;
+        self.draw_desk.line_width = 3.0;
+        self.draw_desk.radius = radius + 1.5;
+        self.draw_desk.draw_abs(cx, inset(rect, -3.0));
+    }
+
+    fn glyph(&mut self, cx: &mut Cx2d, which: Glyph, rect: Rect, color: Vec4f) {
+        let draw = match which {
+            Glyph::Xmark => &mut self.glyph_xmark,
+            Glyph::Plus => &mut self.glyph_plus,
+            Glyph::Check => &mut self.glyph_check,
+            Glyph::UpDown => &mut self.glyph_updown,
+            Glyph::Up => &mut self.glyph_up,
+            Glyph::Down => &mut self.glyph_down,
+        };
+        draw.color = color;
+        draw.draw_abs(cx, rect);
+    }
+
+    fn set_type(&mut self, ty: Type) -> &mut DrawText {
+        match ty {
+            Type::Bold => {
+                self.draw_ui_bold.text_style.font_size = 9.75;
+                &mut self.draw_ui_bold
+            }
+            Type::Body | Type::Small | Type::Note => {
+                self.draw_ui.text_style.font_size = match ty {
+                    Type::Small => 9.0,
+                    Type::Note => 8.25,
+                    _ => 9.75,
+                };
+                &mut self.draw_ui
+            }
+        }
+    }
+
+    fn measure(&mut self, cx: &mut Cx2d, ty: Type, text: &str) -> f64 {
+        crate::palette::text_width(self.set_type(ty), cx, text)
+    }
+
+    fn text(&mut self, cx: &mut Cx2d, ty: Type, x: f64, mid: f64, text: &str, color: Vec4f) {
+        crate::palette::text_on_line(self.set_type(ty), cx, x, mid, text, color);
+    }
+
+    fn text_right(&mut self, cx: &mut Cx2d, ty: Type, right: f64, mid: f64, text: &str, color: Vec4f) {
+        let width = self.measure(cx, ty, text);
+        self.text(cx, ty, right - width, mid, text, color);
+    }
+
+    fn text_center(&mut self, cx: &mut Cx2d, ty: Type, center: f64, mid: f64, text: &str, color: Vec4f) {
+        let width = self.measure(cx, ty, text);
+        self.text(cx, ty, center - width * 0.5, mid, text, color);
+    }
+
+    /// `text` cut with an ellipsis to fit `width`.
+    fn fitted(&mut self, cx: &mut Cx2d, ty: Type, text: &str, width: f64) -> String {
+        if self.measure(cx, ty, text) <= width {
+            return text.to_owned();
+        }
+        let chars: Vec<char> = text.chars().collect();
+        let mut keep = chars.len();
+        while keep > 0 {
+            keep -= 1;
+            let candidate: String = chars[..keep].iter().collect::<String>().trim_end().to_owned() + "\u{2026}";
+            if self.measure(cx, ty, &candidate) <= width {
+                return candidate;
+            }
+        }
+        String::new()
+    }
+
+    /// `text` broken into lines that fit `width`.
+    fn wrapped(&mut self, cx: &mut Cx2d, ty: Type, text: &str, width: f64) -> Vec<String> {
+        let mut lines = Vec::new();
+        let mut line = String::new();
+        for word in text.split_whitespace() {
+            let candidate = if line.is_empty() { word.to_owned() } else { format!("{line} {word}") };
+            if !line.is_empty() && self.measure(cx, ty, &candidate) > width {
+                lines.push(std::mem::replace(&mut line, word.to_owned()));
+            } else {
+                line = candidate;
+            }
+        }
+        if !line.is_empty() {
+            lines.push(line);
+        }
+        lines
+    }
+
+    fn is_hot(&self, hit: DeskHit) -> (bool, bool) {
+        let hot = self.desk_ui.hover == Some(hit);
+        (hot, hot && self.desk_ui.press == Some(hit))
+    }
+
+    fn is_focused(&self, hit: DeskHit) -> bool {
+        self.desk_ui.settings.as_ref().is_some_and(|sheet| sheet.focus == Some(hit))
+    }
+
+    /// A push button. `primary`: the sheet's one default, blue.
+    #[allow(clippy::too_many_arguments)]
+    fn push_button(&mut self, cx: &mut Cx2d, c: &DeskPalette, rect: Rect, title: &str, hit: DeskHit, primary: bool, enabled: bool) {
+        let (hot, down) = self.is_hot(hit);
+        if primary && enabled {
+            let face = if down { c.primary_down } else if hot { c.primary_hover } else { c.primary };
+            self.fill(cx, rect, face, 3.0);
+        } else {
+            let face = if !enabled { c.button } else if down { c.button_down } else if hot { c.button_hover } else { c.button };
+            self.framed(cx, rect, face, c.border, 3.0);
+        }
+        let ink = if primary && enabled { c.white } else if enabled { c.ink } else { c.muted };
+        self.text_center(cx, Type::Body, rect.pos.x + rect.size.x * 0.5, rect.pos.y + rect.size.y * 0.5, title, ink);
+        if enabled {
+            self.desk_ui.hits.push((rect, hit));
+            if self.is_focused(hit) {
+                self.focus_ring(cx, c, rect, 3.0);
+            }
+        }
+    }
+
+    fn button_width(&mut self, cx: &mut Cx2d, title: &str) -> f64 {
+        (self.measure(cx, Type::Body, title) + 28.0).max(72.0)
+    }
+
+    // ------------------------------------------------------------------
+    // The tab bar
+    // ------------------------------------------------------------------
+
+    /// Tabs across the window's whole width right under its title bar, the selected
+    /// one in the title bar's own colour, as a Mac's window tabs are.
+    pub(super) fn draw_desk_tab_bar(&mut self, cx: &mut Cx2d) {
+        let c = self.palette();
+        let h = self.bar_height;
+        let bar = cx.walk_turtle(Walk::new(Size::fill(), Size::Fixed(h)));
+        self.draw_bar.color = c.strip;
+        self.draw_bar.draw_abs(cx, bar);
+
+        let plus_w = 30.0;
+        let room = (bar.size.x - plus_w).max(0.0);
+        let count = self.tabs.len().max(1);
+        let tab_w = (room / count as f64).floor();
+        let line_y = bar.pos.y + h - 1.0;
+        let hover_face = mix(c.strip, c.ink, 0.05);
+        // The hairline over the tabs that are not selected.
+        self.fill(cx, rect_at(bar.pos.x, bar.pos.y, bar.size.x, 1.0), c.strip_line, 0.0);
+        for index in 0..self.tabs.len() {
+            let x = bar.pos.x + tab_w * index as f64;
+            let w = if index + 1 == count { room - tab_w * (count - 1) as f64 } else { tab_w };
+            let rect = rect_at(x, bar.pos.y, w, h);
+            let selected = index == self.active;
+            let hovered = matches!(self.hover, Some(BarHit::Tab(i)) | Some(BarHit::CloseTab(i)) if i == index);
+            if selected {
+                self.fill(cx, rect_at(x, bar.pos.y, w, h - 1.0), c.bar, 0.0);
+            } else if hovered {
+                self.fill(cx, rect_at(x, bar.pos.y + 1.0, w, h - 2.0), hover_face, 0.0);
+            }
+            self.fill(cx, rect_at(x + w - 1.0, bar.pos.y, 1.0, h), c.strip_line, 0.0);
+            self.hits.push((rect, BarHit::Tab(index)));
+
+            let tab_id = self.tabs[index].id;
+            if self.rename.as_ref().is_some_and(|r| r.tab == tab_id) {
+                let placeholder = desk_tab_label(&self.tabs[index], self.settings.tab_title);
+                self.draw_desk_name_field(cx, &c, rect, &placeholder);
+                continue;
+            }
+            let mut label = desk_tab_label(&self.tabs[index], self.settings.tab_title);
+            if self.tabs[index].bell() {
+                label = format!("\u{2022} {label}");
+            }
+            // Room for the close mark while it shows, at the tab's leading edge only;
+            // a narrow tab at rest keeps its words.
+            let (room, lead) = if hovered {
+                (w - 26.0 - 3.0, 26.0)
+            } else if w >= 104.0 {
+                (w - 52.0, 26.0)
+            } else {
+                (w - 16.0, 8.0)
+            };
+            let label = self.fitted(cx, Type::Small, &label, room.max(0.0));
+            let half = self.measure(cx, Type::Small, &label) * 0.5;
+            let mid = (x + (w - 1.0) * 0.5).max(x + lead + half);
+            let ink = if selected { c.ink } else { c.muted };
+            self.text_center(cx, Type::Small, mid, bar.pos.y + (h - 1.0) * 0.5, &label, ink);
+            if hovered {
+                let close = rect_at(x + 6.0, bar.pos.y + (h - 16.0) * 0.5, 16.0, 16.0);
+                if self.hover == Some(BarHit::CloseTab(index)) {
+                    let face = if selected { c.hover } else { mix(c.strip, c.ink, 0.12) };
+                    self.fill(cx, close, face, 2.0);
+                }
+                self.glyph(cx, Glyph::Xmark, inset(close, 2.0), c.muted);
+                self.hits.push((close, BarHit::CloseTab(index)));
+            }
+        }
+        let plus = rect_at(bar.pos.x + room, bar.pos.y, plus_w, h);
+        if self.hover == Some(BarHit::NewTab) {
+            self.fill(cx, rect_at(plus.pos.x, bar.pos.y + 1.0, plus_w, h - 2.0), hover_face, 0.0);
+        }
+        self.glyph(cx, Glyph::Plus, rect_at(plus.pos.x + (plus_w - 14.0) * 0.5, bar.pos.y + (h - 15.0) * 0.5, 14.0, 14.0), c.muted);
+        self.hits.push((plus, BarHit::NewTab));
+        // The hairline between the bar and the terminal.
+        self.fill(cx, rect_at(bar.pos.x, line_y, bar.size.x, 1.0), c.border, 0.0);
+    }
+
+    /// The name being typed, in place of a tab's label.
+    fn draw_desk_name_field(&mut self, cx: &mut Cx2d, c: &DeskPalette, tab: Rect, placeholder: &str) {
+        let Some(edit) = self.rename.as_ref().map(|r| r.edit.clone()) else {
+            return;
+        };
+        let field = rect_at(tab.pos.x + 4.0, tab.pos.y + 3.0, tab.size.x - 9.0, tab.size.y - 7.0);
+        self.framed(cx, field, c.field, c.link, 2.0);
+        let mid = field.pos.y + field.size.y * 0.5;
+        let room = field.size.x - 12.0;
+        let x = field.pos.x + 6.0;
+        let chars: Vec<char> = edit.text.chars().collect();
+        let caret = edit.caret.min(chars.len());
+        let caret_x = if chars.is_empty() {
+            let shown = self.fitted(cx, Type::Small, placeholder, room);
+            self.text(cx, Type::Small, x, mid, &shown, c.muted);
+            x
+        } else {
+            let mut start = 0;
+            while start < caret && self.measure(cx, Type::Small, &chars[start..caret].iter().collect::<String>()) > room - 2.0 {
+                start += 1;
+            }
+            let shown = self.fitted(cx, Type::Small, &chars[start..].iter().collect::<String>(), room);
+            self.text(cx, Type::Small, x, mid, &shown, c.ink);
+            x + self.measure(cx, Type::Small, &chars[start..caret].iter().collect::<String>())
+        };
+        self.fill(cx, rect_at(caret_x, mid - 7.0, 1.0, 14.0), c.ink, 0.0);
+        if let Some(rename) = self.rename.as_mut() {
+            rename.rect = tab;
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // The overlay: sheets and menus
+    // ------------------------------------------------------------------
+
+    pub(super) fn draw_desk_overlay(&mut self, cx: &mut Cx2d) {
+        let c = self.palette();
+        self.desk_ui.hits.clear();
+        // Takes every press and the wheel while anything is up.
+        self.draw_panel.new_draw_call(cx);
+        self.draw_panel.color = vec4(0.0, 0.0, 0.0, 0.0);
+        self.draw_panel.draw_abs(cx, self.whole);
+        if self.settings_window {
+            self.draw_settings_window(cx, &c);
+        } else {
+            if self.pending_close.is_some() || self.desk_ui.settings.is_some() {
+                self.draw_desk.new_draw_call(cx);
+                // A Mac dims the window behind a sheet, as the shell's own sheets do.
+                self.fill(cx, self.whole, vec4(0.0, 0.0, 0.0, if c.light { 0.14 } else { 0.32 }), 0.0);
+            }
+            if self.desk_ui.settings.is_some() {
+                self.draw_settings_sheet(cx, &c);
+            }
+        }
+        if self.pending_close.is_some() {
+            self.draw_close_sheet(cx, &c);
+        }
+        if self.desk_ui.menu.is_some() {
+            self.draw_menu(cx, &c);
+        }
+    }
+
+    /// A new sheet on top of what is there: a card hanging from the bottom of the
+    /// title bar, or of the tab bar when tabs show, square where it hangs and
+    /// rounded below, with a hairline and a shadow; what is drawn next lies on it.
+    fn begin_sheet(&mut self, cx: &mut Cx2d, c: &DeskPalette, width: f64, height: f64) -> Rect {
+        let whole = self.whole;
+        // A Mac's sheet hangs flush from the bar, leaving the tabs it may be
+        // asking about in sight.
+        // The Settings window's own sheets hang from its toolbar.
+        let top = if self.settings_window { whole.pos.y + SETTINGS_TOOLBAR } else { self.body.pos.y.max(whole.pos.y) };
+        let w = width.min(whole.size.x - 24.0).max(120.0);
+        let h = height.min(whole.pos.y + whole.size.y - top - 8.0).max(60.0);
+        let x = (whole.pos.x + (whole.size.x - w) * 0.5).floor();
+        let rect = rect_at(x, top, w, h);
+        self.draw_shadow.new_draw_call(cx);
+        self.draw_shadow.color = vec4(0.0, 0.0, 0.0, if c.light { 0.32 } else { 0.6 });
+        let margin = self.draw_shadow.margin as f64;
+        self.draw_shadow.cut_top = margin as f32;
+        self.draw_shadow.draw_abs(cx, inset(rect, -margin));
+        self.draw_shadow.cut_top = 0.0;
+        self.draw_desk.new_draw_call(cx);
+        self.draw_desk.square_top = 1.0;
+        self.framed(cx, rect, c.bar, c.border, 5.0);
+        self.draw_desk.square_top = 0.0;
+        self.draw_ui.new_draw_call(cx);
+        self.draw_ui_bold.new_draw_call(cx);
+        self.desk_ui.hits.push((rect, DeskHit::Sheet));
+        rect
+    }
+
+    fn draw_close_sheet(&mut self, cx: &mut Cx2d, c: &DeskPalette) {
+        let Some((title, body, action)) = self.pending_close.as_ref().map(close_words) else {
+            return;
+        };
+        // A Mac alert carries its app's icon beside its words.
+        const ICON: f64 = 52.0;
+        let width = 470.0f64.min(self.whole.size.x - 24.0);
+        let inner = width - 40.0 - ICON - 14.0;
+        let title_lines = self.wrapped(cx, Type::Bold, &title, inner);
+        let body_lines = self.wrapped(cx, Type::Small, &body, inner);
+        let words = title_lines.len() as f64 * 18.0 + 6.0 + body_lines.len() as f64 * 16.0;
+        let height = 20.0 + words.max(ICON) + 20.0 + CONTROL + 16.0;
+        let rect = self.begin_sheet(cx, c, width, height);
+        let style = cx.with_vm(|vm| desktop_style::current_style(vm));
+        self.app_icon.draw(cx, "terminal", style, rect_at(rect.pos.x + 20.0, rect.pos.y + 18.0, ICON, ICON), 1.0, c.ink);
+        let x = rect.pos.x + 20.0 + ICON + 14.0;
+        let mut y = rect.pos.y + 20.0;
+        for line in &title_lines {
+            self.text(cx, Type::Bold, x, y + 9.0, line, c.ink);
+            y += 18.0;
+        }
+        y += 6.0;
+        for line in &body_lines {
+            self.text(cx, Type::Small, x, y + 8.0, line, c.ink);
+            y += 16.0;
+        }
+        let right = rect.pos.x + rect.size.x - 16.0;
+        let bottom = rect.pos.y + rect.size.y - 16.0 - CONTROL;
+        let action_w = self.button_width(cx, action);
+        let cancel_w = self.button_width(cx, "Cancel");
+        let confirm = rect_at(right - action_w, bottom, action_w, CONTROL);
+        let cancel = rect_at(confirm.pos.x - 8.0 - cancel_w, bottom, cancel_w, CONTROL);
+        self.push_button(cx, c, cancel, "Cancel", DeskHit::Cancel, false, true);
+        self.push_button(cx, c, confirm, action, DeskHit::Confirm, true, true);
+    }
+
+    // ------------------------------------------------------------------
+    // Settings
+    // ------------------------------------------------------------------
+
+    /// The controls of the open pane, in the order Tab walks them.
+    fn focus_order(&self) -> Vec<DeskHit> {
+        let Some(sheet) = self.desk_ui.settings.as_ref() else {
+            return Vec::new();
+        };
+        let mut order = Vec::new();
+        for row in DESK_PANES[sheet.pane].1 {
+            match row.desk_kind() {
+                DeskKind::List => {}
+                DeskKind::Stepper => order.push(DeskHit::Control(*row)),
+                _ => {
+                    if *row != Row::DeleteProfile || !self.settings.profile.is_empty() {
+                        order.push(DeskHit::Control(*row));
+                    }
+                }
+            }
+        }
+        order.push(DeskHit::Restore);
+        order
+    }
+
+    /// How tall a pane's content is, its rows, gaps and notes.
+    fn pane_height(rows: &[Row]) -> f64 {
+        let mut h: f64 = 0.0;
+        for row in rows {
+            h += match row.desk_kind() {
+                DeskKind::Button => 0.0,
+                DeskKind::Check => CHECK_ROW + ROW_GAP,
+                DeskKind::List => 2.0 + LIST_ROW * LIST_ROWS as f64 + ROW_GAP,
+                _ => CONTROL + ROW_GAP,
+            };
+            if row.desk_note().is_some() {
+                h += NOTE_ROW;
+            }
+        }
+        (h - ROW_GAP).max(0.0)
+    }
+
+    fn draw_settings_sheet(&mut self, cx: &mut Cx2d, c: &DeskPalette) {
+        let Some(pane) = self.desk_ui.settings.as_ref().map(|sheet| sheet.pane) else {
+            return;
+        };
+        let s = self.current_settings();
+        let rows: &[Row] = DESK_PANES[pane].1;
+        const TOP: f64 = 84.0;
+        const BOTTOM: f64 = 60.0;
+        let content_h = Self::pane_height(rows);
+        let rect = self.begin_sheet(cx, c, 560.0, TOP + content_h + BOTTOM);
+        let left = rect.pos.x;
+        let right = rect.pos.x + rect.size.x;
+        self.text_center(cx, Type::Bold, left + rect.size.x * 0.5, rect.pos.y + 20.0, "Settings", c.ink);
+
+        // The panes, as a segmented control.
+        let mut widths = Vec::new();
+        for (name, _) in DESK_PANES {
+            widths.push(self.measure(cx, Type::Body, name));
+        }
+        let text_w: f64 = widths.iter().sum();
+        let room = rect.size.x - 32.0 - 4.0 - 2.0 * (DESK_PANES.len() as f64 - 1.0);
+        let padding = ((room - text_w) / DESK_PANES.len() as f64).clamp(6.0, 24.0);
+        let seg_w = text_w + padding * DESK_PANES.len() as f64 + 2.0 * (DESK_PANES.len() as f64 - 1.0) + 4.0;
+        let seg = rect_at(left + (rect.size.x - seg_w) * 0.5, rect.pos.y + 38.0, seg_w, CONTROL);
+        self.fill(cx, seg, c.selected, 3.5);
+        let mut x = seg.pos.x + 2.0;
+        for (index, (name, _)) in DESK_PANES.iter().enumerate() {
+            let w = widths[index] + padding;
+            let one = rect_at(x, seg.pos.y + 2.0, w, CONTROL - 4.0);
+            let hit = DeskHit::Pane(index);
+            if index == pane {
+                self.framed(cx, one, c.segment, c.border, 2.5);
+            } else {
+                let (hot, down) = self.is_hot(hit);
+                if hot {
+                    self.fill(cx, one, if down { c.selected } else { c.hover }, 2.5);
+                }
+            }
+            self.text_center(cx, Type::Body, x + w * 0.5, seg.pos.y + CONTROL * 0.5, name, c.ink);
+            self.desk_ui.hits.push((one, hit));
+            x += w + 2.0;
+        }
+
+        self.draw_pane_form(cx, c, pane, left, right, rect.pos.y + TOP, rect.pos.y + rect.size.y - BOTTOM, false);
+
+        let buttons_y = rect.pos.y + rect.size.y - 16.0 - CONTROL;
+        let restore_w = self.button_width(cx, "Restore Defaults");
+        self.push_button(cx, c, rect_at(left + 16.0, buttons_y, restore_w, CONTROL), "Restore Defaults", DeskHit::Restore, false, true);
+        let done_w = self.button_width(cx, "Done");
+        self.push_button(cx, c, rect_at(right - 16.0 - done_w, buttons_y, done_w, CONTROL), "Done", DeskHit::Done, true, true);
+        self.draw_settings_subsheet(cx, c, &s);
+    }
+
+    /// A pane's form between `view_top` and `view_bottom`: labels right-aligned in a
+    /// column, controls at one x; `centred` sets the two columns in the middle of
+    /// `left`..`right` (the Settings window) instead of from the left (the sheet).
+    #[allow(clippy::too_many_arguments)]
+    fn draw_pane_form(&mut self, cx: &mut Cx2d, c: &DeskPalette, pane: usize, left: f64, right: f64, view_top: f64, view_bottom: f64, centred: bool) {
+        let s = self.current_settings();
+        let mac = self.mac_style;
+        let rows: &[Row] = DESK_PANES[pane].1;
+        let content_h = Self::pane_height(rows);
+        let width = right - left;
+        let overflow = (content_h - (view_bottom - view_top)).max(0.0);
+        let scroll = self.desk_ui.settings.as_ref().map_or(0, |sheet| sheet.scroll);
+        let steps = (overflow / (CONTROL + ROW_GAP)).ceil() as usize;
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.max_scroll = steps;
+            sheet.scroll = sheet.scroll.min(steps);
+        }
+        let mut label_end = left + (width * 0.3).clamp(120.0, 170.0);
+        let mut control_x = label_end + 8.0;
+        let control_w = (right - 20.0 - control_x).clamp(120.0, 300.0);
+        if centred {
+            // As much room left of the labels as right of the controls.
+            let shift = ((right - (control_x + control_w)) - 20.0).max(0.0) * 0.5;
+            label_end += shift;
+            control_x += shift;
+        }
+        let mut y = view_top - scroll.min(steps) as f64 * (CONTROL + ROW_GAP);
+        let mut last_row_rect = Rect::default();
+        for row in rows {
+            let kind = row.desk_kind();
+            let row_h = match kind {
+                DeskKind::Button => 0.0,
+                DeskKind::Check => CHECK_ROW,
+                DeskKind::List => 2.0 + LIST_ROW * LIST_ROWS as f64,
+                _ => CONTROL,
+            };
+            let shown = y >= view_top - 0.5 && y + row_h <= view_bottom + 0.5;
+            match kind {
+                DeskKind::Popup if shown => {
+                    self.text_right(cx, Type::Body, label_end, y + CONTROL * 0.5, row.desk_label(), c.ink);
+                    let value = row.desk_value(&s, mac);
+                    let width = if *row == Row::Profile { (control_w - 180.0).max(120.0) } else { control_w };
+                    let button = rect_at(control_x, y, width, CONTROL);
+                    self.draw_popup(cx, c, button, &value, DeskHit::Control(*row));
+                    last_row_rect = button;
+                }
+                DeskKind::Stepper if shown => {
+                    self.text_right(cx, Type::Body, label_end, y + CONTROL * 0.5, row.desk_label(), c.ink);
+                    self.draw_stepper(cx, c, control_x, y, *row, &row.desk_value(&s, mac));
+                }
+                DeskKind::Check if shown => {
+                    self.draw_check(cx, c, control_x, y, right - 20.0 - control_x, *row, row.desk_checked(&s));
+                }
+                DeskKind::Button => {
+                    // Beside the pop-up before it.
+                    let title = row.desk_label();
+                    let w = self.button_width(cx, title);
+                    let at = last_row_rect.pos.x + last_row_rect.size.x + 8.0;
+                    let enabled = *row != Row::DeleteProfile || !s.profile.is_empty();
+                    self.push_button(cx, c, rect_at(at, last_row_rect.pos.y, w, CONTROL), title, DeskHit::Control(*row), false, enabled);
+                    last_row_rect.pos.x = at;
+                    last_row_rect.size.x = w;
+                }
+                DeskKind::List => {
+                    let list = rect_at(left + 20.0, y, width - 40.0, (view_bottom - y).min(row_h).max(LIST_ROW + 2.0));
+                    self.draw_shortcut_list(cx, c, list, &s, cfg!(target_os = "macos"));
+                }
+                _ => {}
+            }
+            y += row_h;
+            if let Some(note) = row.desk_note() {
+                let line = match (row, self.desk_ui.settings.as_ref().and_then(|sheet| sheet.note.clone())) {
+                    (Row::Profile, Some(outcome)) => outcome,
+                    _ => note.to_owned(),
+                };
+                if y + NOTE_ROW <= view_bottom + 0.5 && y >= view_top {
+                    self.text(cx, Type::Note, control_x, y + NOTE_ROW * 0.5 + 2.0, &line, c.muted);
+                }
+                y += NOTE_ROW;
+            }
+            if kind != DeskKind::Button {
+                y += ROW_GAP;
+            }
+        }
+    }
+
+    /// Save As…'s name and Delete…'s question, over the settings when one is up.
+    fn draw_settings_subsheet(&mut self, cx: &mut Cx2d, c: &DeskPalette, s: &Settings) {
+        let naming = self.desk_ui.settings.as_ref().is_some_and(|sheet| sheet.name.is_some());
+        let asking = self.desk_ui.settings.as_ref().is_some_and(|sheet| sheet.asking_delete);
+        if (naming || asking) && self.settings_window {
+            // The Settings window dims under its own sheet, as the terminal's does.
+            self.draw_desk.new_draw_call(cx);
+            self.fill(cx, self.whole, vec4(0.0, 0.0, 0.0, if c.light { 0.14 } else { 0.32 }), 0.0);
+        }
+        if naming {
+            self.desk_ui.hits.clear();
+            self.draw_name_sheet(cx, c);
+        } else if asking {
+            self.desk_ui.hits.clear();
+            self.draw_delete_sheet(cx, c, &s.profile);
+        }
+    }
+
+    // ------------------------------------------------------------------
+    // The Settings window
+    // ------------------------------------------------------------------
+
+    /// Make this window Terminal's Settings window (`--settings`), as a Mac's
+    /// Terminal has one: a window of its own beside the terminal windows, which
+    /// stay in use, its panes in a toolbar, its title the pane's name, its height
+    /// the pane's. What changes applies at once, to every terminal window (each
+    /// rereads the settings file within a second).
+    pub(super) fn open_settings_window(&mut self, cx: &mut Cx) {
+        self.settings_window = true;
+        crate::fonts::warm();
+        self.desk_ui.settings = Some(SettingsSheet::default());
+        self.reported_title.clear();
+        self.refresh(cx);
+    }
+
+    /// The window's whole height for a pane: toolbar, the form, Restore Defaults.
+    fn settings_window_height(rows: &[Row]) -> f64 {
+        SETTINGS_TOOLBAR + 24.0 + Self::pane_height(rows) + 24.0 + CONTROL + 20.0
+    }
+
+    /// The pane's name in the window's title and the window fitted to the pane,
+    /// once a pane: the window manager does both.
+    fn settings_window_fit(&mut self, cx: &mut Cx, pane: usize) {
+        let name = DESK_PANES[pane].0;
+        if self.reported_title == name {
+            return;
+        }
+        self.reported_title = name.to_owned();
+        makepad_wm_api::set_title(cx, name);
+        cx.widget_action(self.uid, MpTermAction::TitleChanged(name.to_owned()));
+        makepad_wm_api::resize(cx, SETTINGS_WIDTH, Self::settings_window_height(DESK_PANES[pane].1));
+    }
+
+    fn pane_glyph(&mut self, cx: &mut Cx2d, pane: usize, rect: Rect, color: Vec4f) {
+        let draw = match pane {
+            0 => &mut self.glyph_pane_text,
+            1 => &mut self.glyph_pane_window,
+            2 => &mut self.glyph_pane_shell,
+            3 => &mut self.glyph_pane_keyboard,
+            4 => &mut self.glyph_pane_profiles,
+            _ => &mut self.glyph_pane_advanced,
+        };
+        draw.color = color;
+        draw.draw_abs(cx, rect);
+    }
+
+    /// The Settings window: its toolbar of panes, the pane, Restore Defaults.
+    fn draw_settings_window(&mut self, cx: &mut Cx2d, c: &DeskPalette) {
+        let Some(pane) = self.desk_ui.settings.as_ref().map(|sheet| sheet.pane) else {
+            return;
+        };
+        self.settings_window_fit(cx, pane);
+        let whole = self.whole;
+        let s = self.current_settings();
+        self.draw_desk.new_draw_call(cx);
+        self.fill(cx, whole, c.bar, 0.0);
+
+        // The toolbar: each pane a picture over its name, the chosen one on a
+        // rounded field with its picture in the accent colour.
+        let widths: Vec<f64> = DESK_PANES.iter().map(|(name, _)| (self.measure(cx, Type::Note, name) + 20.0).max(62.0)).collect();
+        let total: f64 = widths.iter().sum::<f64>() + 2.0 * (DESK_PANES.len() as f64 - 1.0);
+        let first_x = whole.pos.x + ((whole.size.x - total) * 0.5).max(8.0).floor();
+        let top = whole.pos.y + 6.0;
+        let item_h = SETTINGS_TOOLBAR - 12.0;
+        let mut items = Vec::new();
+        let mut x = first_x;
+        for w in &widths {
+            items.push(rect_at(x, top, *w, item_h));
+            x += w + 2.0;
+        }
+        // The fields first, then the pictures and names on them.
+        for (index, item) in items.iter().enumerate() {
+            let hit = DeskHit::Pane(index);
+            let (hot, down) = self.is_hot(hit);
+            if index == pane {
+                self.fill(cx, *item, c.selected, 3.0);
+            } else if hot {
+                self.fill(cx, *item, if down { c.selected } else { c.hover }, 3.0);
+            }
+            self.desk_ui.hits.push((*item, hit));
+        }
+        for (index, item) in items.iter().enumerate() {
+            let chosen = index == pane;
+            let icon = rect_at(item.pos.x + (item.size.x - 22.0) * 0.5, top + 5.0, 22.0, 22.0);
+            self.pane_glyph(cx, index, icon, if chosen { c.link } else { c.muted });
+            let name = DESK_PANES[index].0;
+            self.text_center(cx, Type::Note, item.pos.x + item.size.x * 0.5, top + item_h - 10.0, name, if chosen { c.ink } else { c.muted });
+        }
+        // The pane on new layers: its controls' faces under their words and marks.
+        self.draw_desk.new_draw_call(cx);
+        self.fill(cx, rect_at(whole.pos.x, whole.pos.y + SETTINGS_TOOLBAR - 1.0, whole.size.x, 1.0), c.border, 0.0);
+        self.draw_ui.new_draw_call(cx);
+        self.draw_ui_bold.new_draw_call(cx);
+
+        let left = whole.pos.x;
+        let right = whole.pos.x + whole.size.x;
+        let view_top = whole.pos.y + SETTINGS_TOOLBAR + 24.0;
+        let buttons_y = whole.pos.y + whole.size.y - 20.0 - CONTROL;
+        self.draw_pane_form(cx, c, pane, left, right, view_top, buttons_y - 24.0, true);
+        let restore_w = self.button_width(cx, "Restore Defaults");
+        self.push_button(cx, c, rect_at(left + 20.0, buttons_y, restore_w, CONTROL), "Restore Defaults", DeskHit::Restore, false, true);
+        self.draw_settings_subsheet(cx, c, &s);
+    }
+
+    /// Settings are closed: the sheet goes, or the Settings window closes.
+    fn close_settings(&mut self, cx: &mut Cx) {
+        if self.settings_window {
+            cx.widget_action(self.uid, TermTabsAction::LastTabClosed);
+        } else {
+            self.desk_ui.settings = None;
+        }
+    }
+
+    fn draw_popup(&mut self, cx: &mut Cx2d, c: &DeskPalette, rect: Rect, value: &str, hit: DeskHit) {
+        let (hot, down) = self.is_hot(hit);
+        let face = if down { c.button_down } else if hot { c.button_hover } else { c.button };
+        self.framed(cx, rect, face, c.border, 3.0);
+        let value = self.fitted(cx, Type::Body, value, (rect.size.x - 38.0).max(0.0));
+        let mid = rect.pos.y + rect.size.y * 0.5;
+        self.text(cx, Type::Body, rect.pos.x + 10.0, mid, &value, c.ink);
+        self.glyph(cx, Glyph::UpDown, rect_at(rect.pos.x + rect.size.x - 21.0, mid - 6.5, 13.0, 13.0), c.muted);
+        self.desk_ui.hits.push((rect, hit));
+        if self.is_focused(hit) {
+            self.focus_ring(cx, c, rect, 3.0);
+        }
+    }
+
+    fn draw_stepper(&mut self, cx: &mut Cx2d, c: &DeskPalette, x: f64, y: f64, row: Row, value: &str) {
+        let field = rect_at(x, y, 56.0, CONTROL);
+        self.framed(cx, field, c.field, c.border, 3.0);
+        self.text_right(cx, Type::Body, x + 56.0 - 10.0, y + CONTROL * 0.5, value, c.ink);
+        let arrows = rect_at(x + 60.0, y, 20.0, CONTROL);
+        let up = rect_at(arrows.pos.x, y, 20.0, CONTROL * 0.5);
+        let down = rect_at(arrows.pos.x, y + CONTROL * 0.5, 20.0, CONTROL * 0.5);
+        self.framed(cx, arrows, c.button, c.border, 3.0);
+        for (rect, hit) in [(up, DeskHit::Step(row, 1)), (down, DeskHit::Step(row, -1))] {
+            let (hot, pressed) = self.is_hot(hit);
+            if hot {
+                self.fill(cx, inset(rect, 1.0), if pressed { c.button_down } else { c.button_hover }, 2.0);
+            }
+            self.desk_ui.hits.push((rect, hit));
+        }
+        self.fill(cx, rect_at(arrows.pos.x + 1.0, y + CONTROL * 0.5 - 0.5, 18.0, 1.0), c.border, 0.0);
+        self.glyph(cx, Glyph::Up, rect_at(arrows.pos.x + 4.0, y + 1.5, 12.0, 12.0), c.ink);
+        self.glyph(cx, Glyph::Down, rect_at(arrows.pos.x + 4.0, y + CONTROL * 0.5 + 0.5, 12.0, 12.0), c.ink);
+        if self.is_focused(DeskHit::Control(row)) {
+            self.focus_ring(cx, c, rect_at(x, y, 80.0, CONTROL), 3.0);
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn draw_check(&mut self, cx: &mut Cx2d, c: &DeskPalette, x: f64, y: f64, width: f64, row: Row, on: bool) {
+        let hit = DeskHit::Control(row);
+        let mid = y + CHECK_ROW * 0.5;
+        let boxed = rect_at(x, mid - 7.0, 14.0, 14.0);
+        let (_, down) = self.is_hot(hit);
+        if on {
+            self.fill(cx, boxed, if down { c.primary_down } else { c.primary }, 1.5);
+            self.glyph(cx, Glyph::Check, inset(boxed, 1.0), c.white);
+        } else {
+            self.framed(cx, boxed, if down { c.button_down } else { c.field }, c.check_edge, 1.5);
+        }
+        let label = self.fitted(cx, Type::Body, row.desk_label(), (width - 22.0).max(0.0));
+        self.text(cx, Type::Body, x + 22.0, mid, &label, c.ink);
+        let w = 22.0 + self.measure(cx, Type::Body, &label);
+        self.desk_ui.hits.push((rect_at(x, y, w, CHECK_ROW), hit));
+        if self.is_focused(hit) {
+            self.focus_ring(cx, c, boxed, 1.5);
+        }
+    }
+
+    fn desk_apply_step(&mut self, cx: &mut Cx, row: Row, dir: i32) {
+        let next = row.desk_step(&self.current_settings(), dir);
+        self.apply(cx, next);
+    }
+
+    fn draw_shortcut_list(&mut self, cx: &mut Cx2d, c: &DeskPalette, rect: Rect, s: &Settings, mac: bool) {
+        let list = model::desk_shortcuts(s, mac);
+        self.framed(cx, rect, c.content, c.border, 3.0);
+        let fit = ((rect.size.y - 2.0) / LIST_ROW).floor().max(1.0) as usize;
+        let max = list.len().saturating_sub(fit);
+        let scroll = self.desk_ui.settings.as_ref().map_or(0, |sheet| sheet.list_scroll).min(max);
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.list_scroll = scroll;
+            sheet.list_rows = fit;
+            sheet.list_rect = rect;
+        }
+        let mut y = rect.pos.y + 1.0;
+        for (what, keys) in list.iter().skip(scroll).take(fit) {
+            let mid = y + LIST_ROW * 0.5;
+            let keys_w = self.measure(cx, Type::Body, keys);
+            let what = self.fitted(cx, Type::Body, what, (rect.size.x - 32.0 - keys_w).max(0.0));
+            self.text(cx, Type::Body, rect.pos.x + 10.0, mid, &what, c.ink);
+            self.text_right(cx, Type::Body, rect.pos.x + rect.size.x - 12.0, mid, keys, c.muted);
+            y += LIST_ROW;
+        }
+        // An overlay knob: faint at rest, to say the list goes on, and stronger as it scrolls.
+        if max > 0 {
+            let track = rect.size.y - 6.0;
+            let h = (track * fit as f64 / list.len() as f64).max(18.0);
+            let top = rect.pos.y + 3.0 + (track - h) * scroll as f64 / max as f64;
+            let knob = vec4(c.ink.x, c.ink.y, c.ink.z, if Cx::monotonic_now() < self.desk_ui.knob_until { 0.4 } else { 0.22 });
+            self.fill(cx, rect_at(rect.pos.x + rect.size.x - 9.0, top, 6.0, h), knob, 1.5);
+        }
+    }
+
+    fn draw_name_sheet(&mut self, cx: &mut Cx2d, c: &DeskPalette) {
+        let Some(edit) = self.desk_ui.settings.as_ref().and_then(|sheet| sheet.name.clone()) else {
+            return;
+        };
+        let name = edit.text.trim().to_owned();
+        let valid = term_settings::valid_profile_name(&name);
+        let exists = term_settings::list_profiles().iter().any(|saved| *saved == name);
+        let height = 20.0 + 18.0 + 12.0 + CONTROL + NOTE_ROW + 20.0 + CONTROL + 16.0;
+        let rect = self.begin_sheet(cx, c, 380.0, height);
+        let left = rect.pos.x;
+        let right = left + rect.size.x;
+        let mut y = rect.pos.y + 20.0;
+        self.text(cx, Type::Bold, left + 20.0, y + 9.0, "Save the settings as a profile", c.ink);
+        y += 18.0 + 12.0;
+        self.text_right(cx, Type::Body, left + 64.0, y + CONTROL * 0.5, "Name:", c.ink);
+        let field = rect_at(left + 72.0, y, right - 20.0 - (left + 72.0), CONTROL);
+        self.framed(cx, field, c.field, c.link, 3.0);
+        self.desk_ui.hits.push((field, DeskHit::NameField));
+        let mid = y + CONTROL * 0.5;
+        let room = field.size.x - 16.0;
+        let chars: Vec<char> = edit.text.chars().collect();
+        let caret = edit.caret.min(chars.len());
+        let mut start = 0;
+        while start < caret && self.measure(cx, Type::Body, &chars[start..caret].iter().collect::<String>()) > room - 2.0 {
+            start += 1;
+        }
+        let shown = self.fitted(cx, Type::Body, &chars[start..].iter().collect::<String>(), room);
+        self.text(cx, Type::Body, field.pos.x + 8.0, mid, &shown, c.ink);
+        let caret_x = field.pos.x + 8.0 + self.measure(cx, Type::Body, &chars[start..caret].iter().collect::<String>());
+        self.fill(cx, rect_at(caret_x, mid - 8.0, 1.0, 16.0), c.ink, 0.0);
+        y += CONTROL;
+        let note = if exists {
+            Some("A profile with this name is replaced.")
+        } else if !name.is_empty() && !valid {
+            Some("Use up to 40 characters, without / \\ : = #.")
+        } else {
+            None
+        };
+        if let Some(note) = note {
+            self.text(cx, Type::Note, field.pos.x, y + NOTE_ROW * 0.5 + 2.0, note, c.muted);
+        }
+        let bottom = rect.pos.y + rect.size.y - 16.0 - CONTROL;
+        let save_w = self.button_width(cx, "Save");
+        let cancel_w = self.button_width(cx, "Cancel");
+        let save = rect_at(right - 16.0 - save_w, bottom, save_w, CONTROL);
+        let cancel = rect_at(save.pos.x - 8.0 - cancel_w, bottom, cancel_w, CONTROL);
+        self.push_button(cx, c, cancel, "Cancel", DeskHit::NameCancel, false, true);
+        self.push_button(cx, c, save, "Save", DeskHit::NameSave, true, valid);
+    }
+
+    fn draw_delete_sheet(&mut self, cx: &mut Cx2d, c: &DeskPalette, profile: &str) {
+        let title = format!("Do you want to delete the profile \u{201c}{profile}\u{201d}?");
+        let width = 380.0;
+        let title_lines = self.wrapped(cx, Type::Bold, &title, width - 40.0);
+        let height = 20.0 + title_lines.len() as f64 * 18.0 + 6.0 + 16.0 + 20.0 + CONTROL + 16.0;
+        let rect = self.begin_sheet(cx, c, width, height);
+        let left = rect.pos.x;
+        let right = left + rect.size.x;
+        let mut y = rect.pos.y + 20.0;
+        for line in &title_lines {
+            self.text(cx, Type::Bold, left + 20.0, y + 9.0, line, c.ink);
+            y += 18.0;
+        }
+        y += 6.0;
+        self.text(cx, Type::Small, left + 20.0, y + 8.0, "Its settings stay in use until you change them.", c.ink);
+        let bottom = rect.pos.y + rect.size.y - 16.0 - CONTROL;
+        let cancel_w = self.button_width(cx, "Cancel");
+        let delete_w = self.button_width(cx, "Delete");
+        let cancel = rect_at(right - 16.0 - cancel_w, bottom, cancel_w, CONTROL);
+        let delete = rect_at(cancel.pos.x - 8.0 - delete_w, bottom, delete_w, CONTROL);
+        self.push_button(cx, c, delete, "Delete", DeskHit::DeleteConfirm, false, true);
+        self.push_button(cx, c, cancel, "Cancel", DeskHit::DeleteCancel, true, true);
+    }
+
+    // ------------------------------------------------------------------
+    // Menus
+    // ------------------------------------------------------------------
+
+    fn draw_menu(&mut self, cx: &mut Cx2d, c: &DeskPalette) {
+        let Some(mut menu) = self.desk_ui.menu.take() else {
+            return;
+        };
+        let whole = inset(self.whole, 4.0);
+        let gutter = 22.0;
+        let mut label_w: f64 = 0.0;
+        let mut keys_w: f64 = 0.0;
+        if menu.placed {
+            (label_w, keys_w) = menu.widths;
+        } else {
+            for item in &menu.items {
+                label_w = label_w.max(self.measure(cx, Type::Body, &item.label));
+                if !item.keys.is_empty() {
+                    keys_w = keys_w.max(self.measure(cx, Type::Body, &item.keys));
+                }
+            }
+            menu.widths = (label_w, keys_w);
+        }
+        let content_w = gutter + label_w + if keys_w > 0.0 { 28.0 + keys_w } else { 0.0 } + 16.0;
+        let width = content_w.max(menu.anchor.map_or(180.0, |button| button.size.x + 14.0)).min(whole.size.x).min(420.0);
+        let total: f64 = menu.items.iter().map(|i| MENU_ROW + if i.separated { MENU_SEP } else { 0.0 }).sum::<f64>() + 2.0 * MENU_PAD;
+        let overflow = total > whole.size.y;
+        if !menu.placed {
+            menu.placed = true;
+            let fit = ((whole.size.y - 2.0 * MENU_PAD) / MENU_ROW).floor().max(3.0) as usize;
+            menu.visible = if overflow { fit.min(menu.items.len()) } else { menu.items.len() };
+            let shown_h = if overflow { menu.visible as f64 * MENU_ROW + 2.0 * MENU_PAD } else { total };
+            let (x, y) = match menu.anchor {
+                // The current choice lies right on the button's text.
+                Some(button) => {
+                    let current = menu.items.iter().position(|i| i.checked).unwrap_or(0);
+                    if overflow {
+                        menu.top = current.saturating_sub(menu.visible / 2).min(menu.items.len() - menu.visible);
+                    }
+                    let above: f64 = if overflow {
+                        (current - menu.top) as f64 * MENU_ROW
+                    } else {
+                        menu.items[..current].iter().map(|i| MENU_ROW + if i.separated { MENU_SEP } else { 0.0 }).sum()
+                    };
+                    (
+                        button.pos.x + 10.0 - gutter,
+                        button.pos.y + button.size.y * 0.5 - MENU_PAD - above - MENU_ROW * 0.5,
+                    )
+                }
+                None => (menu.at.x, if menu.at.y + shown_h > whole.pos.y + whole.size.y { menu.at.y - shown_h } else { menu.at.y }),
+            };
+            let x = x.min(whole.pos.x + whole.size.x - width).max(whole.pos.x);
+            let y = y.min(whole.pos.y + whole.size.y - shown_h).max(whole.pos.y);
+            menu.rect = rect_at(x, y, width, shown_h);
+        }
+        let rect = menu.rect;
+        self.draw_shadow.new_draw_call(cx);
+        self.draw_shadow.color = vec4(0.0, 0.0, 0.0, if c.light { 0.28 } else { 0.55 });
+        let margin = self.draw_shadow.margin as f64;
+        self.draw_shadow.draw_abs(cx, inset(rect, -margin));
+        self.draw_desk.new_draw_call(cx);
+        self.framed(cx, rect, c.menu, c.border, 3.0);
+        self.draw_ui.new_draw_call(cx);
+        self.draw_ui_bold.new_draw_call(cx);
+        self.desk_ui.hits.clear();
+        let (above, below) = menu.arrows();
+        let mut y = rect.pos.y + MENU_PAD;
+        let end = menu.top + menu.visible;
+        for index in menu.top..end {
+            let row = rect_at(rect.pos.x, y, rect.size.x, MENU_ROW);
+            let mid = y + MENU_ROW * 0.5;
+            if above && index == menu.top {
+                self.glyph(cx, Glyph::Up, rect_at(rect.pos.x + (rect.size.x - 12.0) * 0.5, mid - 6.0, 12.0, 12.0), c.ink);
+                self.desk_ui.hits.push((row, DeskHit::MenuUp));
+                y += MENU_ROW;
+                continue;
+            }
+            if below && index + 1 == end {
+                self.glyph(cx, Glyph::Down, rect_at(rect.pos.x + (rect.size.x - 12.0) * 0.5, mid - 6.0, 12.0, 12.0), c.ink);
+                self.desk_ui.hits.push((row, DeskHit::MenuDown));
+                y += MENU_ROW;
+                continue;
+            }
+            let (label, keys, enabled, checked, separated) = {
+                let item = &menu.items[index];
+                (item.label.clone(), item.keys.clone(), item.enabled, item.checked, item.separated)
+            };
+            let lit = enabled && menu.hover == Some(index);
+            if lit {
+                self.fill(cx, rect_at(rect.pos.x + 5.0, y, rect.size.x - 10.0, MENU_ROW), c.accent_row, 2.0);
+            }
+            let ink = if lit { c.white } else if enabled { c.ink } else { c.muted };
+            if checked {
+                self.glyph(cx, Glyph::Check, rect_at(rect.pos.x + 7.0, mid - 6.5, 13.0, 13.0), ink);
+            }
+            let room = rect.size.x - gutter - 16.0 - if keys.is_empty() { 0.0 } else { 28.0 + keys_w };
+            let label = self.fitted(cx, Type::Body, &label, room.max(0.0));
+            self.text(cx, Type::Body, rect.pos.x + gutter, mid, &label, ink);
+            if !keys.is_empty() {
+                let key_ink = if lit { c.white } else { c.muted };
+                self.text_right(cx, Type::Body, rect.pos.x + rect.size.x - 12.0, mid, &keys, key_ink);
+            }
+            if enabled {
+                self.desk_ui.hits.push((row, DeskHit::MenuItem(index)));
+            }
+            y += MENU_ROW;
+            if separated && !overflow {
+                self.fill(cx, rect_at(rect.pos.x + 12.0, y + MENU_SEP * 0.5 - 0.5, rect.size.x - 24.0, 1.0), c.border, 0.0);
+                y += MENU_SEP;
+            }
+        }
+        self.desk_ui.menu = Some(menu);
+    }
+
+    fn open_row_menu(&mut self, cx: &mut Cx, row: Row, anchor: Rect) {
+        let s = self.current_settings();
+        let mac = self.mac_style;
+        let items: Vec<MenuItem> = row
+            .desk_options(&s, mac)
+            .into_iter()
+            .map(|option| MenuItem {
+                checked: option.settings == s,
+                label: option.label,
+                keys: String::new(),
+                enabled: true,
+                separated: option.separated,
+                act: MenuAct::Apply(Box::new(option.settings)),
+            })
+            .collect();
+        if items.is_empty() {
+            return;
+        }
+        self.desk_ui.menu = Some(Menu::new(items, Some(anchor), anchor.pos));
+        self.refresh(cx);
+    }
+
+    /// The menu of a right click in the terminal.
+    pub(super) fn desk_close_menu(&mut self, cx: &mut Cx) {
+        if self.desk_ui.menu.take().is_some() {
+            self.desk_ui.hover = None;
+            self.refresh(cx);
+        }
+    }
+
+    pub(super) fn open_context_menu(&mut self, cx: &mut Cx, at: DVec2) {
+        let has_selection = self
+            .tabs
+            .get(self.active)
+            .and_then(|tab| tab.with_term(|term| term.has_selection()))
+            .unwrap_or(false);
+        let mac = cfg!(target_os = "macos");
+        let keys = |action: keybinds::Action| {
+            let found = self.keys.bindings.iter().filter(|b| b.action == action);
+            let best = found.clone().find(|b| b.trigger.mods.sup == mac).or_else(|| found.clone().next());
+            best.map_or_else(String::new, |b| {
+                if mac {
+                    keybinds::chord_glyphs(&b.trigger)
+                } else {
+                    keybinds::chord_label(&b.trigger, false)
+                }
+            })
+        };
+        let item = |label: &str, keys: String, enabled: bool, separated: bool, act: MenuAct| MenuItem {
+            label: label.to_owned(),
+            keys,
+            enabled,
+            checked: false,
+            separated,
+            act,
+        };
+        let mut items = vec![item("Copy", keys(keybinds::Action::CopyToClipboard), has_selection, false, MenuAct::Copy)];
+        if mac {
+            items.push(item("Paste", "\u{2318}V".to_owned(), true, false, MenuAct::Paste));
+        }
+        items.push(item("Select All", keys(keybinds::Action::SelectAll), true, true, MenuAct::SelectAll));
+        items.push(item("Clear to Start", keys(keybinds::Action::ClearScreen), true, false, MenuAct::Clear));
+        items.push(item("Find\u{2026}", keys(keybinds::Action::StartSearch), true, true, MenuAct::Find));
+        items.push(item("New Tab", keys(keybinds::Action::NewTab), true, false, MenuAct::NewTab));
+        items.push(item("Settings\u{2026}", keys(keybinds::Action::OpenConfig), true, false, MenuAct::Settings));
+        self.desk_ui.menu = Some(Menu::new(items, None, at));
+        self.refresh(cx);
+    }
+
+    /// The menu of a right click on a tab.
+    pub(super) fn open_tab_menu(&mut self, cx: &mut Cx, index: usize, at: DVec2) {
+        let item = |label: &str, enabled: bool, separated: bool, act: MenuAct| MenuItem {
+            label: label.to_owned(),
+            keys: String::new(),
+            enabled,
+            checked: false,
+            separated,
+            act,
+        };
+        let items = vec![
+            item("Rename Tab\u{2026}", true, true, MenuAct::RenameTab(index)),
+            item("Close Tab", true, false, MenuAct::CloseTab(index)),
+            item("Close Other Tabs", self.tabs.len() > 1, false, MenuAct::CloseOtherTabs(index)),
+        ];
+        self.desk_ui.menu = Some(Menu::new(items, None, at));
+        self.refresh(cx);
+    }
+
+    fn pick_menu_item(&mut self, cx: &mut Cx, index: usize) {
+        let Some(act) = self.desk_ui.menu.take().and_then(|menu| menu.items.get(index).filter(|i| i.enabled).map(|i| i.act.clone())) else {
+            self.refresh(cx);
+            return;
+        };
+        self.desk_ui.press = None;
+        self.desk_ui.hover = None;
+        let term = self.tabs.get(self.active).map(|tab| tab.focused_pane().term.clone());
+        let with_term = |cx: &mut Cx, f: &dyn Fn(&mut Cx, &mut MpTerm)| {
+            if let Some(mut term) = term.as_ref().and_then(|t| t.borrow_mut::<MpTerm>()) {
+                f(cx, &mut term);
+            }
+        };
+        match act {
+            MenuAct::Apply(settings) => self.apply_later_if_font(cx, *settings),
+            MenuAct::Copy => with_term(cx, &|cx, term| term.run_shortcut(cx, &keybinds::Action::CopyToClipboard)),
+            MenuAct::Paste => with_term(cx, &|cx, term| term.paste_from_system(cx)),
+            MenuAct::SelectAll => with_term(cx, &|cx, term| term.run_shortcut(cx, &keybinds::Action::SelectAll)),
+            MenuAct::Clear => with_term(cx, &|cx, term| term.run_shortcut(cx, &keybinds::Action::ClearScreen)),
+            MenuAct::Find => with_term(cx, &|cx, term| term.run_shortcut(cx, &keybinds::Action::StartSearch)),
+            MenuAct::NewTab => self.run_command(cx, TabCommand::New),
+            MenuAct::Settings => self.toggle_desk_settings(cx),
+            MenuAct::CloseTab(index) => self.request_close(cx, index, None),
+            MenuAct::CloseOtherTabs(keep) => {
+                let id = self.tabs.get(keep).map(|tab| tab.id);
+                let mut index = self.tabs.len();
+                while index > 0 {
+                    index -= 1;
+                    if Some(self.tabs[index].id) != id {
+                        self.close(cx, index);
+                    }
+                }
+            }
+            MenuAct::RenameTab(index) => self.begin_rename(cx, index),
+        }
+        self.refresh(cx);
+    }
+
+    /// A pick from a pop-up. A font is prepared off the UI thread; the rest apply now.
+    fn apply_later_if_font(&mut self, cx: &mut Cx, settings: Settings) {
+        self.apply(cx, settings);
+    }
+
+    pub(super) fn toggle_desk_settings(&mut self, cx: &mut Cx) {
+        if self.settings_window {
+            return;
+        }
+        // A Mac's Terminal keeps its settings in a window of their own, and the
+        // terminal windows stay in use: the window manager opens it, or brings the
+        // open one to the front. Elsewhere (another style, no window manager) the
+        // settings are this window's sheet.
+        if self.mac_style && self.desk_ui.settings.is_none() && makepad_wm_api::launch_or_focus(cx, "terminal", &["--settings"]) {
+            return;
+        }
+        if self.desk_ui.settings.take().is_none() {
+            // The font pop-ups list installed fonts: start looking now.
+            crate::fonts::warm();
+            self.desk_ui.settings = Some(SettingsSheet::default());
+        }
+        self.desk_ui.hover = None;
+        self.desk_ui.press = None;
+        self.refresh(cx);
+    }
+
+    // ------------------------------------------------------------------
+    // Input
+    // ------------------------------------------------------------------
+
+    fn desk_hit_at(&self, abs: DVec2) -> Option<DeskHit> {
+        self.desk_ui.hits.iter().rev().find(|(rect, _)| rect.contains(abs)).map(|(_, hit)| *hit)
+    }
+
+    fn rect_of(&self, hit: DeskHit) -> Option<Rect> {
+        self.desk_ui.hits.iter().rev().find(|(_, h)| *h == hit).map(|(rect, _)| *rect)
+    }
+
+    /// The pointer over the overlay.
+    pub(super) fn desk_pointer(&mut self, cx: &mut Cx, event: &Event) {
+        if self.desk_ui.knob_timer.is_event(event).is_some() {
+            self.refresh(cx);
+        }
+        // A press off the window, its host closing what the app has open, closes the
+        // menu as a press off it does: the panel hears only presses on the window.
+        if let Event::MouseDown(e) = event {
+            if self.desk_ui.menu.is_some() && !self.whole.contains(e.abs) {
+                self.desk_ui.menu = None;
+                self.desk_ui.hover = None;
+                self.refresh(cx);
+                return;
+            }
+        }
+        match event.hits(cx, self.draw_panel.area()) {
+            Hit::FingerHoverIn(e) | Hit::FingerHoverOver(e) => self.desk_hover(cx, e.abs),
+            Hit::FingerHoverOut(_) => {
+                if self.desk_ui.hover.take().is_some() {
+                    self.refresh(cx);
+                }
+            }
+            Hit::FingerDown(e) => self.desk_press(cx, e.abs),
+            Hit::FingerMove(e) => self.desk_hover(cx, e.abs),
+            Hit::FingerUp(e) => self.desk_release(cx, e.abs),
+            Hit::FingerScroll(e) => self.desk_scroll(cx, e.abs, e.scroll.y),
+            _ => {}
+        }
+    }
+
+    fn desk_hover(&mut self, cx: &mut Cx, abs: DVec2) {
+        let hit = self.desk_hit_at(abs);
+        cx.set_cursor(if hit == Some(DeskHit::NameField) { MouseCursor::Text } else { MouseCursor::Default });
+        if let Some(menu) = self.desk_ui.menu.as_mut() {
+            menu.moved = menu.moved || hit != self.desk_ui.hover;
+            match hit {
+                Some(DeskHit::MenuItem(index)) => menu.hover = Some(index),
+                _ if menu.rect.contains(abs) => {}
+                _ => menu.hover = None,
+            }
+        }
+        if hit != self.desk_ui.hover {
+            self.desk_ui.hover = hit;
+            self.refresh(cx);
+        }
+    }
+
+    fn desk_press(&mut self, cx: &mut Cx, abs: DVec2) {
+        let hit = self.desk_hit_at(abs);
+        if let Some(menu) = self.desk_ui.menu.as_mut() {
+            menu.opening = false;
+            if !menu.rect.contains(abs) {
+                self.desk_ui.menu = None;
+                self.desk_ui.hover = None;
+                self.refresh(cx);
+                return;
+            }
+        }
+        self.desk_ui.hover = hit;
+        self.desk_ui.press = hit;
+        match hit {
+            // A pop-up opens on the press, as a Mac's does.
+            Some(DeskHit::Control(row)) if row.desk_kind() == DeskKind::Popup => {
+                if let Some(rect) = self.rect_of(DeskHit::Control(row)) {
+                    self.desk_ui.press = None;
+                    self.open_row_menu(cx, row, rect);
+                }
+            }
+            Some(DeskHit::Pane(index)) => {
+                if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                    sheet.pane = index;
+                    sheet.focus = None;
+                    sheet.scroll = 0;
+                    sheet.list_scroll = 0;
+                    sheet.note = None;
+                }
+            }
+            _ => {}
+        }
+        self.refresh(cx);
+    }
+
+    fn desk_release(&mut self, cx: &mut Cx, abs: DVec2) {
+        let hit = self.desk_hit_at(abs);
+        let pressed = self.desk_ui.press.take();
+        if let Some(menu) = self.desk_ui.menu.as_mut() {
+            if menu.opening {
+                // The press that opened it: a drag onto an item picks it.
+                menu.opening = false;
+                if let (true, Some(DeskHit::MenuItem(index))) = (menu.moved, hit) {
+                    self.pick_menu_item(cx, index);
+                }
+                return;
+            }
+            match hit {
+                Some(DeskHit::MenuItem(index)) => self.pick_menu_item(cx, index),
+                Some(DeskHit::MenuUp) => {
+                    menu.scroll(-3);
+                    self.refresh(cx);
+                }
+                Some(DeskHit::MenuDown) => {
+                    menu.scroll(3);
+                    self.refresh(cx);
+                }
+                _ => {}
+            }
+            return;
+        }
+        if hit.is_some() && hit == pressed {
+            if let Some(hit) = hit {
+                self.desk_activate(cx, hit);
+            }
+        }
+        self.refresh(cx);
+    }
+
+    fn desk_scroll(&mut self, cx: &mut Cx, abs: DVec2, dy: f64) {
+        let by = if dy > 0.0 { 1 } else if dy < 0.0 { -1 } else { 0 };
+        if by == 0 {
+            return;
+        }
+        if let Some(menu) = self.desk_ui.menu.as_mut() {
+            menu.scroll(by);
+        } else if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            if sheet.list_rect.contains(abs) {
+                sheet.list_scroll = (sheet.list_scroll as i64 + by).max(0) as usize;
+                self.desk_ui.knob_until = Cx::monotonic_now() + KNOB_SECONDS;
+                cx.stop_timer(self.desk_ui.knob_timer);
+                self.desk_ui.knob_timer = cx.start_timeout(KNOB_SECONDS + 0.05);
+            } else {
+                sheet.scroll = (sheet.scroll as i64 + by).clamp(0, sheet.max_scroll as i64) as usize;
+            }
+        }
+        self.refresh(cx);
+    }
+
+    /// A control's press went through, or the keyboard activated it.
+    fn desk_activate(&mut self, cx: &mut Cx, hit: DeskHit) {
+        match hit {
+            DeskHit::Cancel => self.pending_close = None,
+            DeskHit::Confirm => self.confirm_pending(cx),
+            DeskHit::Control(row) => self.desk_activate_row(cx, row),
+            DeskHit::Step(row, dir) => self.desk_apply_step(cx, row, dir),
+            DeskHit::Restore => {
+                // Shortcuts are the file's to change: a reset keeps its `keybind` lines,
+                // as the phone's panel does.
+                let next = Settings {
+                    profile: self.settings.profile.clone(),
+                    keybinds: self.settings.keybinds.clone(),
+                    ..Settings::default()
+                };
+                self.apply(cx, next);
+            }
+            DeskHit::Done => self.desk_ui.settings = None,
+            DeskHit::NameCancel => {
+                if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                    sheet.name = None;
+                }
+            }
+            DeskHit::NameSave => self.desk_save_profile(cx),
+            DeskHit::DeleteCancel => {
+                if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                    sheet.asking_delete = false;
+                }
+            }
+            DeskHit::DeleteConfirm => self.desk_delete_profile(cx),
+            _ => {}
+        }
+        self.desk_ui.hover = None;
+        self.refresh(cx);
+    }
+
+    fn desk_activate_row(&mut self, cx: &mut Cx, row: Row) {
+        match row.desk_kind() {
+            DeskKind::Check => self.apply_step(cx, row, 1),
+            DeskKind::Popup => {
+                if let Some(rect) = self.rect_of(DeskHit::Control(row)) {
+                    self.open_row_menu(cx, row, rect);
+                }
+            }
+            DeskKind::Button => {
+                let profile = self.settings.profile.clone();
+                if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                    sheet.note = None;
+                    if row == Row::SaveProfile {
+                        sheet.name = Some(NameEdit::new(&profile));
+                    } else if !profile.is_empty() {
+                        sheet.asking_delete = true;
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn desk_save_profile(&mut self, cx: &mut Cx) {
+        let Some(name) = self.desk_ui.settings.as_ref().and_then(|sheet| sheet.name.as_ref()).map(|edit| edit.text.trim().to_owned()) else {
+            return;
+        };
+        if !term_settings::valid_profile_name(&name) {
+            return;
+        }
+        let result = term_settings::save_profile(&name, &self.settings);
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.name = None;
+            sheet.note = Some(match &result {
+                Ok(()) => format!("Saved \u{201c}{name}\u{201d}."),
+                Err(_) => format!("\u{201c}{name}\u{201d} could not be saved."),
+            });
+        }
+        if result.is_ok() {
+            let next = Settings { profile: name, ..self.settings.clone() };
+            self.apply(cx, next);
+        }
+    }
+
+    fn desk_delete_profile(&mut self, cx: &mut Cx) {
+        let profile = self.settings.profile.clone();
+        let result = term_settings::delete_profile(&profile);
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            sheet.asking_delete = false;
+            sheet.note = Some(match &result {
+                Ok(()) => format!("Deleted \u{201c}{profile}\u{201d}."),
+                Err(_) => format!("\u{201c}{profile}\u{201d} could not be deleted."),
+            });
+        }
+        let next = Settings { profile: String::new(), ..self.settings.clone() };
+        self.apply(cx, next);
+    }
+
+    /// A key while a sheet or a menu is up: nothing reaches the shell.
+    pub(super) fn desk_key(&mut self, cx: &mut Cx, key: &KeyEvent) {
+        if self.desk_ui.menu.is_some() {
+            self.desk_menu_key(cx, key);
+        } else if self.desk_ui.settings.is_some() {
+            self.desk_settings_key(cx, key);
+        } else if self.pending_close.is_some() {
+            match key.key_code {
+                KeyCode::ReturnKey | KeyCode::NumpadEnter => self.confirm_pending(cx),
+                KeyCode::Escape => self.pending_close = None,
+                _ => {}
+            }
+        }
+        self.refresh(cx);
+    }
+
+    /// Typed text while a sheet or a menu is up.
+    pub(super) fn desk_text(&mut self, cx: &mut Cx, input: &str) {
+        let typed: String = input.chars().filter(|c| !c.is_control()).collect();
+        if typed.is_empty() {
+            return;
+        }
+        if let Some(menu) = self.desk_ui.menu.as_mut() {
+            menu.type_select(&typed, Cx::monotonic_now());
+        } else if let Some(edit) = self.desk_ui.settings.as_mut().and_then(|sheet| sheet.name.as_mut()) {
+            edit.insert(&typed);
+        }
+        self.refresh(cx);
+    }
+
+    fn desk_menu_key(&mut self, cx: &mut Cx, key: &KeyEvent) {
+        let Some(menu) = self.desk_ui.menu.as_mut() else {
+            return;
+        };
+        match key.key_code {
+            KeyCode::ArrowUp => menu.step(-1),
+            KeyCode::ArrowDown => menu.step(1),
+            KeyCode::ReturnKey | KeyCode::NumpadEnter | KeyCode::Space => {
+                let hover = menu.hover;
+                match hover {
+                    Some(index) => self.pick_menu_item(cx, index),
+                    None => self.desk_ui.menu = None,
+                }
+            }
+            KeyCode::Escape => self.desk_ui.menu = None,
+            _ => {}
+        }
+    }
+
+    fn desk_settings_key(&mut self, cx: &mut Cx, key: &KeyEvent) {
+        let (naming, asking) = self
+            .desk_ui
+            .settings
+            .as_ref()
+            .map_or((false, false), |sheet| (sheet.name.is_some(), sheet.asking_delete));
+        if naming {
+            let result = self.desk_ui.settings.as_mut().and_then(|sheet| sheet.name.as_mut()).map(|edit| edit.key(key));
+            match result {
+                Some(NameKey::Commit(_)) => self.desk_save_profile(cx),
+                Some(NameKey::Cancel) => {
+                    if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                        sheet.name = None;
+                    }
+                }
+                _ => {}
+            }
+            return;
+        }
+        if asking {
+            match key.key_code {
+                KeyCode::ReturnKey | KeyCode::NumpadEnter | KeyCode::Escape => {
+                    if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                        sheet.asking_delete = false;
+                    }
+                }
+                _ => {}
+            }
+            return;
+        }
+        // The settings are a window of their own on a Mac: Cmd+W closes them.
+        if key.key_code == KeyCode::KeyW && key.modifiers.logo && !key.modifiers.shift {
+            self.close_settings(cx);
+            return;
+        }
+        if self.keys.lookup(key).is_some_and(|b| b.action == keybinds::Action::OpenConfig) {
+            // The Settings window is already in front.
+            if !self.settings_window {
+                self.desk_ui.settings = None;
+            }
+            return;
+        }
+        let window = self.settings_window;
+        let focus = self.desk_ui.settings.as_ref().and_then(|sheet| sheet.focus);
+        let stepper = match focus {
+            Some(DeskHit::Control(row)) if row.desk_kind() == DeskKind::Stepper => Some(row),
+            _ => None,
+        };
+        match key.key_code {
+            // A sheet's Escape and Return close it; a window's do nothing, as a Mac's
+            // Settings window's do.
+            KeyCode::Escape if !window => self.desk_ui.settings = None,
+            KeyCode::Tab => self.desk_move_focus(if key.modifiers.shift { -1 } else { 1 }),
+            KeyCode::ReturnKey | KeyCode::NumpadEnter => match focus {
+                Some(hit @ DeskHit::Control(row)) if row.desk_kind() != DeskKind::Stepper => self.desk_activate(cx, hit),
+                Some(DeskHit::Restore) => self.desk_activate(cx, DeskHit::Restore),
+                _ if !window => self.desk_ui.settings = None,
+                _ => {}
+            },
+            KeyCode::Space => {
+                if let Some(hit) = focus {
+                    self.desk_activate(cx, hit);
+                }
+            }
+            KeyCode::ArrowUp if stepper.is_some() => self.desk_apply_step(cx, stepper.unwrap_or(Row::FontSize), 1),
+            KeyCode::ArrowDown if stepper.is_some() => self.desk_apply_step(cx, stepper.unwrap_or(Row::FontSize), -1),
+            KeyCode::ArrowUp => self.desk_move_focus(-1),
+            KeyCode::ArrowDown => self.desk_move_focus(1),
+            KeyCode::ArrowLeft => self.desk_move_pane(-1),
+            KeyCode::ArrowRight => self.desk_move_pane(1),
+            KeyCode::PageUp | KeyCode::PageDown => {
+                let by = if key.key_code == KeyCode::PageUp { -1i64 } else { 1 };
+                if let Some(sheet) = self.desk_ui.settings.as_mut() {
+                    sheet.list_scroll = (sheet.list_scroll as i64 + by * sheet.list_rows.max(1) as i64).max(0) as usize;
+                }
+            }
+            _ => {}
+        }
+    }
+
+    fn desk_move_focus(&mut self, dir: i64) {
+        let order = self.focus_order();
+        if order.is_empty() {
+            return;
+        }
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            let n = order.len() as i64;
+            let at = sheet.focus.and_then(|f| order.iter().position(|hit| *hit == f));
+            let next = match at {
+                Some(i) => (i as i64 + dir).rem_euclid(n),
+                None if dir > 0 => 0,
+                None => n - 1,
+            };
+            sheet.focus = Some(order[next as usize]);
+        }
+    }
+
+    fn desk_move_pane(&mut self, dir: i64) {
+        if let Some(sheet) = self.desk_ui.settings.as_mut() {
+            let n = DESK_PANES.len() as i64;
+            sheet.pane = (sheet.pane as i64 + dir).rem_euclid(n) as usize;
+            sheet.focus = None;
+            sheet.scroll = 0;
+            sheet.list_scroll = 0;
+            sheet.note = None;
+        }
