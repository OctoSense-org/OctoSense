+    #[test]
+    fn a_right_press_answer_reads_whatever_the_link_holds() {
+        assert_eq!(
+            PageMenuAnswer::parse("7:1:0:https://a.test/x?y=1:2#z"),
+            Some(PageMenuAnswer { serial: 7, free: true, selected: false, link: Some("https://a.test/x?y=1:2#z".into()) })
+        );
+        assert_eq!(
+            PageMenuAnswer::parse("8:0:1:"),
+            Some(PageMenuAnswer { serial: 8, free: false, selected: true, link: None })
+        );
+        assert_eq!(PageMenuAnswer::parse("not a serial:1:0:"), None);
+        assert_eq!(PageMenuAnswer::parse("7:1"), None);
+    }
+
+    #[test]
+    fn the_pages_menu_puts_a_link_first_and_greys_what_cant_act() {
+        let titles = |rows: &[(PageMenuRow, &str, bool)]| rows.iter().map(|(_, title, _)| title.to_string()).collect::<Vec<_>>();
+        let plain = page_menu_rows(None, false, true, false);
+        assert_eq!(titles(&plain), ["Back", "Forward", "Reload", "-", "Copy", "Select All"]);
+        let live = |rows: &[(PageMenuRow, &'static str, bool)], title: &str| rows.iter().find(|(_, t, _)| *t == title).unwrap().2;
+        assert!(!live(&plain, "Back"));
+        assert!(live(&plain, "Forward"));
+        assert!(!live(&plain, "Copy"));
+        assert!(live(&plain, "Select All"));
+        let on_link = page_menu_rows(Some(true), true, false, true);
+        assert_eq!(titles(&on_link)[..3], ["Open Link in New Tab", "Copy Link", "-"]);
+        assert!(live(&on_link, "Copy"));
+        // A `mailto:` can be copied and can't be a tab.
+        let mail = page_menu_rows(Some(false), true, false, false);
+        assert!(!live(&mail, "Open Link in New Tab"));
+        assert!(live(&mail, "Copy Link"));
+    }
