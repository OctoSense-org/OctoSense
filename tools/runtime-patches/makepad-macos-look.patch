+
+/// What the strip tells the window.
+#[derive(Clone, Debug, Default)]
+pub enum MpImageThumbsAction {
+    /// A thumbnail was pressed: go to this picture of the folder.
+    Goto(usize),
+    #[default]
+    None,
+}
+
+/// A file's bytes, read off the interface's thread. `None` when it can't be read.
+struct ThumbRead {
+    key: PathBuf,
+    data: RefCell<Option<Option<Vec<u8>>>>,
+}
+
+impl std::fmt::Debug for ThumbRead {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "ThumbRead({})", self.key.display())
+    }
+}
+
+/// One picture of the folder.
+struct Row {
+    path: PathBuf,
+    key: PathBuf,
+    name: String,
+}
+
+/// A row that has been asked for.
+#[derive(Default)]
+struct Thumb {
+    /// `None` until it comes, or for good if `failed`.
+    texture: Option<Texture>,
+    failed: bool,
+    /// The draw that last showed it.
+    seen: u64,
+}
+
+fn thumb_key(path: &Path) -> PathBuf {
+    let mut key = OsString::from(path.as_os_str());
+    key.push(KEY_ENDING);
+    PathBuf::from(key)
+}
+
+fn is_thumb_key(path: &Path) -> bool {
+    path.to_str().is_some_and(|path| path.ends_with(KEY_ENDING))
+}
+
+/// Which of the thumbnails kept should go, the ones seen longest ago first:
+/// never anything seen in this very draw (`now`), and never more than takes it
+/// back down to `keep`.
+fn over_the_limit(seen: &[(PathBuf, u64)], keep: usize, now: u64) -> Vec<PathBuf> {
+    let mut oldest: Vec<&(PathBuf, u64)> = seen.iter().filter(|(_, at)| *at != now).collect();
+    oldest.sort_by_key(|(_, at)| *at);
+    let excess = seen.len().saturating_sub(keep);
+    oldest.into_iter().take(excess).map(|(key, _)| key.clone()).collect()
+}
+
+/// Where the list's top has to go so that a row shows whole, if it doesn't:
+/// the top of the view stays put when it can, and moves the least it must.
+/// `top` and the answer are distances from the first row's top.
+fn top_to_reveal(index: usize, top: f64, view: f64, row: f64) -> Option<f64> {
+    let (row_top, row_end) = (index as f64 * row, (index + 1) as f64 * row);
+    if row_top < top {
+        Some(row_top)
+    } else if row_end > top + view {
+        Some((row_end - view).max(0.0))
+    } else {
+        None
+    }
+}
+
+#[derive(Script, ScriptHook, Widget)]
+pub struct MpImageThumbs {
+    #[source]
+    source: ScriptObjectRef,
+    #[deref]
+    view: View,
+
+    #[rust]
+    rows: Vec<Row>,
+    #[rust]
+    current: usize,
+    /// By cache key: the thumbnails asked for and not let go.
+    #[rust]
+    thumbs: HashMap<PathBuf, Thumb>,
+    /// The keys being read or decoded, whether or not they're still wanted.
+    #[rust]
+    on_the_way: HashSet<PathBuf>,
+    /// Counts draws, to tell which thumbnails were seen last.
+    #[rust]
+    draws: u64,
+    /// The size to decode for, in pixels. The last draw's.
+    #[rust]
+    drawn: (usize, usize),
+    /// A sheet is up over the window: the pointer is the sheet's.
+    #[rust]
+    inert: bool,
+}
+
+impl Widget for MpImageThumbs {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        if let Event::Actions(actions) = event {
+            self.hear_the_workers(cx, actions);
+        }
+        if self.inert && matches!(event, Event::Scroll(_) | Event::MouseDown(_) | Event::MouseMove(_) | Event::MouseUp(_)) {
+            return;
+        }
+        self.view.handle_event(cx, event, scope);
+
+        if let Event::Actions(actions) = event {
+            let list = self.view.portal_list(cx, ids!(strip));
+            for (index, item) in list.items_with_actions(actions) {
+                if item.as_view().finger_down(actions).is_some_and(|down| down.device.is_primary_hit()) {
+                    cx.widget_action(self.widget_uid(), MpImageThumbsAction::Goto(index));
+                }
+            }
+        }
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        while let Some(step) = self.view.draw_walk(cx, scope, walk).step() {
+            if let Some(mut list) = step.as_portal_list().borrow_mut() {
+                self.draw_thumbs(cx, &mut list);
+            }
+        }
+        DrawStep::done()
+    }
+}
+
+impl MpImageThumbs {
+    /// The window's sidebar was opened, or its folder or place may have changed.
+    /// `revealing`: it has only just opened, and has to find its place.
+    pub fn show(&mut self, cx: &mut Cx, paths: &[PathBuf], current: usize, revealing: bool) {
+        let same = self.rows.len() == paths.len() && self.rows.iter().zip(paths).all(|(row, path)| row.path == *path);
+        if !same {
+            self.let_go(cx);
+            self.rows = paths
+                .iter()
+                .map(|path| Row {
+                    path: path.clone(),
+                    key: thumb_key(path),
+                    name: path.file_name().map(|name| name.to_string_lossy().to_string()).unwrap_or_default(),
+                })
+                .collect();
+            self.view.portal_list(cx, ids!(strip)).set_first_id_and_scroll(0, 0.0);
+        }
+        let moved = !same || self.current != current;
+        self.current = current;
+        if moved || revealing {
+            self.reveal(cx, current);
+            self.view.redraw(cx);
+        }
+    }
+
+    /// The sidebar was closed: every thumbnail goes back.
+    pub fn hide(&mut self, cx: &mut Cx) {
+        self.let_go(cx);
+        self.rows.clear();
+        self.view.redraw(cx);
+    }
+
+    pub fn set_inert(&mut self, inert: bool) {
+        self.inert = inert;
+    }
+
+    fn let_go(&mut self, cx: &mut Cx) {
+        // The strip's own rows go with the next draw; until then what they hold survives this.
+        for (key, _) in self.thumbs.drain() {
+            evict_image_from_cache(cx, &key);
+        }
+    }
+
+    /// The list's scroll, so that this row shows whole.
+    fn reveal(&mut self, cx: &mut Cx, index: usize) {
+        let list = self.view.portal_list(cx, ids!(strip));
+        let view = self.view.area().rect(cx).size.y;
+        // Not laid out yet: one row of context above it, as PDF's strip gives.
+        if view <= 0.0 {
+            list.set_first_id_and_scroll(index.saturating_sub(1), 0.0);
+            return;
+        }
+        let top = list.first_id() as f64 * ROW_HEIGHT - list.scroll_position();
+        if let Some(top) = top_to_reveal(index, top, view, ROW_HEIGHT) {
+            let first = (top / ROW_HEIGHT).floor();
+            list.set_first_id_and_scroll(first as usize, first * ROW_HEIGHT - top);
+        }
+    }
+
+    fn draw_thumbs(&mut self, cx: &mut Cx2d, list: &mut PortalList) {
+        self.draws += 1;
+        let dpi = cx.current_dpi_factor();
+        self.drawn = ((PICTURE.0 * dpi).ceil() as usize, (PICTURE.1 * dpi).ceil() as usize);
+        list.set_item_range(cx, 0, self.rows.len());
+
+        let mut wanted = Vec::new();
+        while let Some(index) = list.next_visible_item(cx) {
+            let Some(row) = self.rows.get(index) else {
+                continue;
+            };
+            let thumb = self.thumbs.get_mut(&row.key);
+            let (texture, failed) = match thumb {
+                Some(thumb) => {
+                    thumb.seen = self.draws;
+                    (thumb.texture.clone(), thumb.failed)
+                }
+                None => {
+                    wanted.push(index);
+                    (None, false)
+                }
+            };
+            let showing = texture.is_some();
+
+            let item = list.item(cx, index, id!(Thumb));
+            item.label(&**cx, ids!(thumb_name)).set_text(&mut **cx, &row.name);
+            item.widget(&**cx, ids!(selected)).set_visible(&mut **cx, index == self.current);
+            item.widget(&**cx, ids!(waiting)).set_visible(&mut **cx, !showing);
+            item.widget(&**cx, ids!(unreadable)).set_visible(&mut **cx, failed);
+            let picture = item.widget(&**cx, ids!(picture));
+            picture.set_visible(&mut **cx, showing);
+            if let Some(mut image) = picture.borrow_mut::<Image>() {
+                ImageCacheImpl::set_texture(&mut *image, texture, 0);
+            }
+            item.draw_all(cx, &mut Scope::empty());
+        }
+
+        for index in wanted {
+            if self.on_the_way.len() >= AT_ONCE {
+                break;
+            }
+            self.ask_for(index);
+        }
+        self.keep_to_the_limit(cx);
+    }
+
+    /// Off to be read. Its answer comes back as an action.
+    fn ask_for(&mut self, index: usize) {
+        let Some(row) = self.rows.get(index) else {
+            return;
+        };
+        self.thumbs.entry(row.key.clone()).or_default().seen = self.draws;
+        if !self.on_the_way.insert(row.key.clone()) {
+            // On its way already, from when it was wanted before.
+            return;
+        }
+        let (path, key) = (row.path.clone(), row.key.clone());
+        std::thread::spawn(move || {
+            let data = std::fs::metadata(&path)
+                .ok()
+                .filter(|file| file.len() <= LARGEST_FILE)
+                .and_then(|_| std::fs::read(&path).ok());
+            Cx::post_action(ThumbRead { key, data: RefCell::new(Some(data)) });
+        });
+    }
+
+    fn hear_the_workers(&mut self, cx: &mut Cx, actions: &Actions) {
+        let mut any = false;
+        for action in actions {
+            if let Some(read) = action.downcast_ref::<ThumbRead>() {
+                let Some(data) = read.data.borrow_mut().take() else {
+                    continue;
+                };
+                self.file_read(cx, &read.key, data);
+                any = true;
+            } else if let Some(AsyncImageLoad { image_path, result }) = action.downcast_ref() {
+                if !is_thumb_key(image_path) {
+                    continue;
+                }
+                // Whichever `Image` hears of a decode first puts it in the cache.
+                if let Some(result) = result.borrow_mut().take() {
+                    process_async_image_load(cx, image_path, result);
+                }
+                self.on_the_way.remove(image_path);
+                self.settle(cx, image_path);
+                any = true;
+            }
+        }
+        if any {
+            // The next draw shows these, and asks for any row still waiting.
+            self.view.redraw(cx);
+        }
+    }
+
+    fn file_read(&mut self, cx: &mut Cx, key: &Path, data: Option<Vec<u8>>) {
+        if !self.thumbs.contains_key(key) {
+            self.on_the_way.remove(key);
+            return;
+        }
+        let answer = data.ok_or(()).and_then(|data| {
+            load_image_from_data_async_at_size(cx, key, Arc::new(data), Some(self.drawn)).map_err(|_| ())
+        });
+        match answer {
+            // On to the decoders, whose answer comes as an `AsyncImageLoad`.
+            Ok(AsyncLoadResult::Loading(..)) => {}
+            Ok(AsyncLoadResult::Loaded) | Err(()) => {
+                self.on_the_way.remove(key);
+                self.settle(cx, key);
+            }
+        }
+    }
+
+    /// A key's answer is in: the cache has its picture, or it can't have one.
+    fn settle(&mut self, cx: &mut Cx, key: &Path) {
+        let Some(thumb) = self.thumbs.get_mut(key) else {
+            // Let go while it was on its way.
+            evict_image_from_cache(cx, key);
+            return;
+        };
+        thumb.texture = load_image_from_cache(cx, key);
+        thumb.failed = thumb.texture.is_none();
+    }
+
+    fn keep_to_the_limit(&mut self, cx: &mut Cx) {
+        if self.thumbs.len() <= KEPT {
+            return;
+        }
+        let seen: Vec<(PathBuf, u64)> = self
+            .thumbs
+            .iter()
+            .filter(|(key, _)| !self.on_the_way.contains(*key))
+            .map(|(key, thumb)| (key.clone(), thumb.seen))
+            .collect();
+        for key in over_the_limit(&seen, KEPT, self.draws) {
+            // Its handle first, so the cache's is the last and the pixels go.
+            self.thumbs.remove(&key);
+            evict_image_from_cache(cx, &key);
+        }
+    }
+}
+
+impl MpImageThumbsRef {
+    pub fn show(&self, cx: &mut Cx, paths: &[PathBuf], current: usize, revealing: bool) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.show(cx, paths, current, revealing);
+        }
+    }
+
+    pub fn hide(&self, cx: &mut Cx) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.hide(cx);
+        }
+    }
+
+    pub fn set_inert(&self, inert: bool) {
+        if let Some(mut inner) = self.borrow_mut() {
+            inner.set_inert(inert);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_thumbnail_is_cached_apart_from_its_picture() {
+        let key = thumb_key(Path::new("/a/b c.jpg"));
+        assert_ne!(key, Path::new("/a/b c.jpg"));
+        assert!(is_thumb_key(&key));
+        assert!(!is_thumb_key(Path::new("/a/b c.jpg")));
+    }
+
+    #[test]
+    fn those_seen_longest_ago_go_first_and_never_what_is_on_screen() {
+        let seen: Vec<(PathBuf, u64)> = [("a", 5), ("b", 1), ("c", 9), ("d", 3)].iter().map(|(k, at)| (PathBuf::from(k), *at)).collect();
+        assert_eq!(over_the_limit(&seen, 2, 9), vec![PathBuf::from("b"), PathBuf::from("d")]);
+        assert_eq!(over_the_limit(&seen, 4, 9), Vec::<PathBuf>::new());
+        // All on screen now: nothing goes, however many there are.
+        let now: Vec<(PathBuf, u64)> = [("a", 9), ("b", 9), ("c", 9)].iter().map(|(k, at)| (PathBuf::from(k), *at)).collect();
+        assert!(over_the_limit(&now, 1, 9).is_empty());
+    }
+
+    #[test]
+    fn a_row_in_view_leaves_the_list_where_it_is() {
+        // A view of three rows, its top at the second row.
+        assert_eq!(top_to_reveal(1, 100.0, 300.0, 100.0), None);
+        assert_eq!(top_to_reveal(3, 100.0, 300.0, 100.0), None);
+        // Above: it comes to the top. Below: to the bottom. Part way out counts as out.
+        assert_eq!(top_to_reveal(0, 100.0, 300.0, 100.0), Some(0.0));
+        assert_eq!(top_to_reveal(4, 100.0, 300.0, 100.0), Some(200.0));
+        assert_eq!(top_to_reveal(4, 150.0, 300.0, 100.0), Some(200.0));
+        assert_eq!(top_to_reveal(1, 150.0, 300.0, 100.0), Some(100.0));
+    }
+}
