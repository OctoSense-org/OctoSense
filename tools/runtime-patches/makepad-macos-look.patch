+    }
+
+    fn open_page_menu(&mut self, cx: &mut Cx, asked: PageMenuAsked, selected: bool, link: Option<String>) {
+        if self.covered {
+            return;
+        }
+        let Some(tab) = self.tabs.active() else {
+            return;
+        };
+        let web = link.as_deref().map(|link| link.starts_with("http://") || link.starts_with("https://") || link.starts_with("file://"));
+        let rows = page_menu_rows(web, tab.can_go_back, tab.can_go_forward, selected);
+        self.menu_rows = rows.iter().map(|(row, _, _)| *row).collect();
+        self.menu_link = link;
+        let rows = rows
+            .iter()
+            .map(|(row, title, live)| if *row == PageMenuRow::Rule { ContextRow::rule() } else { ContextRow::new(title, *live) })
+            .collect();
+        let owner = ContextMenuOwner { source: &self.source, template: self.popup_menu, area: self.draw_bg.area() };
+        self.context_menu.open(cx, owner, asked.abs, asked.time, rows);
+    }
+
+    fn page_menu_chose(&mut self, cx: &mut Cx, index: usize) {
+        let link = self.menu_link.take();
+        match self.menu_rows.get(index).copied() {
+            Some(PageMenuRow::OpenLink) => {
+                if let Some(link) = link {
+                    // A tab has its engine once it's in front: this one opens there.
+                    self.new_tab(cx, &link, true);
+                }
+            }
+            Some(PageMenuRow::CopyLink) => {
+                if let Some(link) = link {
+                    cx.copy_to_clipboard(&link);
+                }
+            }
+            Some(PageMenuRow::Back) => self.go_back(cx),
+            Some(PageMenuRow::Forward) => self.go_forward(cx),
+            Some(PageMenuRow::Reload) => self.reload(cx),
+            Some(PageMenuRow::Copy) => self.copy(),
+            Some(PageMenuRow::SelectAll) => self.select_all(),
+            Some(PageMenuRow::Rule) | None => {}
+        }
+    }
