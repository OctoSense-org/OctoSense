+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn item(label: &str, enabled: bool, checked: bool) -> MenuItem {
+        MenuItem { label: label.to_owned(), keys: String::new(), enabled, checked, separated: false, act: MenuAct::Copy }
+    }
+
+    #[test]
+    fn the_close_question_says_it_as_a_mac_does() {
+        let (title, body, action) = close_words(&PendingClose::All { jobs: vec![("a".into(), "sleep".into())] });
+        assert_eq!(title, "Do you want to terminate running processes in this window?");
+        assert_eq!(body, "Closing this window will terminate the running process: sleep.");
+        assert_eq!(action, "Terminate");
+        let jobs = vec![("a".into(), "sleep".into()), ("b".into(), "sleep".into()), ("c".into(), "vim".into())];
+        let (_, body, _) = close_words(&PendingClose::All { jobs });
+        assert_eq!(body, "Closing this window will terminate the running processes: sleep, vim.");
+        let (title, body, _) = close_words(&PendingClose::Tab { tab: 0, pane: None, job: "top".into() });
+        assert_eq!(title, "Do you want to terminate running processes in this tab?");
+        assert_eq!(body, "Closing this tab will terminate the running process: top.");
+        let (title, _, _) = close_words(&PendingClose::Tab { tab: 0, pane: Some(3), job: "top".into() });
+        assert_eq!(title, "Do you want to terminate running processes in this pane?");
+        let (title, body, action) = close_words(&PendingClose::AllTabs { count: 3 });
+        assert_eq!(title, "Do you want to close all tabs in this window?");
+        assert_eq!(body, "This window has 3 tabs.");
+        assert_eq!(action, "Close All");
+    }
+
+    #[test]
+    fn a_title_names_a_folder_and_a_program_as_a_mac_does() {
+        assert_eq!(folder_name(Path::new("/Users/someone")), "someone");
+        assert_eq!(folder_name(Path::new("/")), "/");
+        assert_eq!(program_name("-zsh"), "zsh");
+    }
+
+    #[test]
+    fn a_pop_up_opens_on_its_choice_and_the_keyboard_walks_the_enabled_items() {
+        let anchor = Rect::default();
+        let mut menu = Menu::new(vec![item("One", true, false), item("Two", true, true), item("Off", false, false), item("Four", true, false)], Some(anchor), anchor.pos);
+        assert_eq!(menu.hover, Some(1), "on the choice in force");
+        menu.step(1);
+        assert_eq!(menu.hover, Some(3), "over the disabled one");
+        menu.step(1);
+        assert_eq!(menu.hover, Some(3), "stops at the end");
+        menu.step(-1);
+        assert_eq!(menu.hover, Some(1));
+        let context = Menu::new(vec![item("One", true, false)], None, anchor.pos);
+        assert_eq!(context.hover, None, "a context menu opens with nothing lit");
+    }
+
+    #[test]
+    fn typing_jumps_to_an_item_and_a_pause_starts_over() {
+        let anchor = Rect::default();
+        let mut menu = Menu::new(vec![item("Menlo", true, false), item("Monaco", true, false), item("SF Mono", true, false)], Some(anchor), anchor.pos);
+        menu.type_select("m", 10.0);
+        assert_eq!(menu.hover, Some(0));
+        menu.type_select("o", 10.2);
+        assert_eq!(menu.hover, Some(1));
+        menu.type_select("s", 12.0);
+        assert_eq!(menu.hover, Some(2));
+    }
+
+    #[test]
+    fn a_long_menu_keeps_what_is_lit_between_its_arrows() {
+        let anchor = Rect::default();
+        let items = (0..30).map(|i| item(&format!("Item {i}"), true, i == 0)).collect();
+        let mut menu = Menu::new(items, Some(anchor), anchor.pos);
+        menu.visible = 8;
+        for _ in 0..12 {
+            menu.step(1);
+        }
+        assert_eq!(menu.hover, Some(12));
+        let (above, below) = menu.arrows();
+        assert!(above && below);
+        assert!(menu.top + 1 <= 12 && 12 < menu.top + menu.visible - 1, "top {} shows it", menu.top);
+        menu.scroll(100);
+        assert_eq!(menu.top, 22);
+        assert_eq!(menu.arrows(), (true, false));
+    }
+}
