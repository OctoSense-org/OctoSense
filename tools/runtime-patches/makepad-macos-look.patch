+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::model::Current;
+
+    #[test]
+    fn a_macs_summary_keeps_its_gusts_whole_on_a_line_of_their_own() {
+        let gusty = Forecast { current: Current { weather_code: Some(3.0), wind_gusts_10m: Some(31.2), ..Default::default() }, ..Default::default() };
+        let mac = WeatherView::summary_text(&gusty, true);
+        assert!(mac.ends_with(".\nWind gusts up to 31 km/h."), "{mac:?}");
+        assert_eq!(mac.matches('\n').count(), 1, "{mac:?}");
+        let phone = WeatherView::summary_text(&gusty, false);
+        assert!(phone.ends_with(". Wind gusts up to 31 km/h."), "{phone:?}");
+        let calm = Forecast { current: Current { wind_gusts_10m: Some(18.0), ..Default::default() }, ..Default::default() };
+        assert!(!WeatherView::summary_text(&calm, true).contains("km/h"));
+    }
+}
