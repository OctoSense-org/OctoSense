+                glyph: EmptyGlyph::Filter,
+                title: "No Files Match".to_string(),
+                note: "Try another name, size or kind.".to_string(),
+                action: EmptyAction::ClearFilter,
+            });
+        }
+        if !self.rows.is_empty() {
+            return None;
+        }
+        let needle = self.filter.trim();
+        if !needle.is_empty() {
