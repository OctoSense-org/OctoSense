+        .find(|c: char| !c.is_ascii_digit())
+        .map_or((digits, ""), |i| digits.split_at(i));
+    let mut out = String::new();
+    for (i, c) in whole.chars().enumerate() {
+        if i > 0 && (whole.len() - i) % 3 == 0 {
+            out.push(',');
+        }
+        out.push(c);
+    }
+    format!("{sign}{out}{rest}")
+}
