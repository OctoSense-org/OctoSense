+/// A pointer's layout: below this height the display folds into one bar.
+pub const POINTER_SHORT_MAX: f64 = 340.0;
+/// A pointer's layout: the history sidebar's width, and the least it leaves
+/// for the keys.
+pub const POINTER_TAPE_WIDTH: f64 = 200.0;
+pub const POINTER_TAPE_LEAVES: f64 = 160.0;
+/// A pointer's layout: what choosing the scientific keys adds to the window's
