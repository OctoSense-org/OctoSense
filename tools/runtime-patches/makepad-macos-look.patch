+    /// A right press on a line of the conversation: what can be taken from it.
+    /// `false` when there is no line there, and nothing has happened.
+    fn open_message_menu(&mut self, cx: &mut Cx, press: &MouseDownEvent) -> bool {
+        let Some(index) = self.entry_at(cx, press.abs) else { return false };
+        let Some(entry) = self.engine.as_ref().and_then(|engine| engine.state().entries.get(index)) else { return false };
+        let words = plain::words_of(entry);
+        if words.is_empty() {
+            return false;
+        }
+        let code = match entry {
+            Entry::User { text } | Entry::Assistant { text, .. } => plain::code_in(text),
+            _ => None,
+        };
+        let state = self.engine.as_ref().map(|engine| engine.state());
+        let working = state.is_some_and(|state| self.working(state));
+        let mut rows = vec![ContextRow::new("Copy", true), ContextRow::new("Copy Code", code.is_some())];
+        let mut acts = vec![MenuAct::Copy(words), code.map_or(MenuAct::Nothing, MenuAct::Copy)];
+        // A question can be asked again; the last answer can be asked for again.
+        match entry {
+            Entry::User { .. } => {
+                rows.extend([ContextRow::rule(), ContextRow::new("Ask Again", !working)]);
+                acts.extend([MenuAct::Nothing, MenuAct::AskAgain(index)]);
+            }
+            Entry::Assistant { .. } => {
+                let last = state.and_then(plain::last_answer) == Some(index);
+                rows.extend([ContextRow::rule(), ContextRow::new("Try Again", last && !working)]);
+                acts.extend([MenuAct::Nothing, MenuAct::TryAgain(index)]);
+            }
+            _ => {}
+        }
+        rows.extend([ContextRow::rule(), ContextRow::new("Copy Conversation", true)]);
+        acts.extend([MenuAct::Nothing, MenuAct::CopyAll]);
+        self.menu_acts = acts;
+        let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+        self.context_menu.open(cx, owner, press.abs, press.time, rows);
+        self.view.redraw(cx);
+        true
+    }
