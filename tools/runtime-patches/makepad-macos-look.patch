+#[derive(Script, ScriptHook, Widget)]
+pub struct MpPlacesPage {
+    #[deref]
+    view: View,
+    #[live]
+    popup_menu: ScriptValue,
+    #[rust]
+    context_menu: ContextMenu,
+    /// What it's showing; nothing while it's away.
+    #[rust]
+    kind: Option<PlacesKind>,
+    /// Everything there is, and what the search keeps of it (the rows shown).
+    #[rust]
+    all: Vec<Line>,
+    #[rust]
+    lines: Vec<Line>,
+    /// What the search field says.
+    #[rust]
+    query: String,
+    /// What the button says on a page with nothing on it.
+    #[rust]
+    action_words: String,
+    /// The rows on screen, and where: the pointer finds its row by this.
+    #[rust]
+    drawn: Vec<(usize, Area)>,
+    #[rust]
+    hovered: Option<usize>,
+    #[rust]
+    pressed: Option<usize>,
+    /// The row the menu at the pointer is about, and that menu's rows.
+    #[rust]
+    menu_line: Option<usize>,
+    #[rust]
+    menu_rows: Vec<RowMenu>,
+    /// A sheet or a menu is over it: the pointer is theirs.
+    #[rust]
+    inert: bool,
+}
+
+impl Widget for MpPlacesPage {
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        if self.kind.is_none() {
+            return;
+        }
+        let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+        match self.context_menu.handle_event(cx, event, owner) {
+            ContextMenuEvent::Chosen(row) => {
+                self.menu_chose(cx, row);
+                return;
+            }
+            ContextMenuEvent::Spent => {
+                if !self.context_menu.is_open() && self.menu_line.take().is_some() {
+                    self.view.redraw(cx);
+                }
+                return;
+            }
+            ContextMenuEvent::Ignored => {}
+        }
+        if self.inert && matches!(event, Event::Scroll(_) | Event::MouseDown(_) | Event::MouseMove(_) | Event::MouseUp(_)) {
+            return;
+        }
+        match event {
+            Event::MouseDown(press) if press.button.is_secondary() => {
+                if let Some(index) = self.line_at(cx, press.abs) {
+                    self.open_row_menu(cx, press, index);
+                    return;
+                }
+            }
+            Event::MouseMove(moved) => {
+                let over = self.line_at(cx, moved.abs);
+                if over != self.hovered {
+                    self.hovered = over;
+                    self.view.redraw(cx);
+                }
+            }
+            // The rows move under the pointer: the next move says which it's over.
+            Event::Scroll(_) => {
+                if self.hovered.take().is_some() {
+                    self.view.redraw(cx);
+                }
+            }
+            Event::MouseUp(up) => {
+                if let Some(index) = self.pressed.take() {
+                    if self.line_at(cx, up.abs) == Some(index) {
+                        self.open_line(cx, index);
+                    }
+                    self.view.redraw(cx);
+                }
+            }
+            _ => {}
+        }
+        self.view.handle_event(cx, event, scope);
+        if let Event::Actions(actions) = event {
+            if let Some(query) = self.view.text_input(cx, ids!(places_query)).changed(actions) {
+                self.query = query;
+                self.filter();
+                self.view.portal_list(cx, ids!(places_list)).set_first_id_and_scroll(0, 0.0);
+                self.hovered = None;
+                self.say(cx);
+            }
+            let list = self.view.portal_list(cx, ids!(places_list));
+            for (index, item) in list.items_with_actions(actions) {
+                if item.as_view().finger_down(actions).is_some_and(|down| down.device.is_primary_hit()) {
+                    self.pressed = Some(index);
+                    self.view.redraw(cx);
+                }
+            }
+        }
+    }
+
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        while let Some(step) = self.view.draw_walk(cx, scope, walk).step() {
+            if let Some(mut list) = step.as_portal_list().borrow_mut() {
+                self.draw_lines(cx, &mut list);
+            }
+        }
+        if self.context_menu.is_open() {
+            let uid = self.widget_uid();
+            let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+            self.context_menu.draw(cx, uid, owner);
+        }
+        DrawStep::done()
+    }
+}
