 /// a second to draw this.
+/// Net worth through a period, ends included and at most `points` samples: the
+/// total [`Ledger::net_worth_on`] gives on each of those days, at the cost of
+/// one pass over the ledger.
+pub fn net_worth_over(ledger: &Ledger, range: DateRange, points: usize) -> Vec<(Day, i64)> {
+    let on_budget: std::collections::HashSet<Id> =
+        ledger.accounts.iter().filter(|a| !a.off_budget).map(|a| a.id).collect();
+    let mut sorted: Vec<&Transaction> =
+        ledger.transactions.iter().filter(|t| on_budget.contains(&t.account)).collect();
+    sorted.sort_by_key(|t| t.date);
+    let mut running: i64 =
+        ledger.accounts.iter().filter(|a| !a.off_budget).map(|a| a.opening_balance).sum();
+    // One day has no line: the day before it starts one.
+    let start = if range.end > range.start { range.start } else { range.end - 1 };
+    let span = (range.end - start) as usize;
+    let samples = (span + 1).min(points.max(2));
+    let mut index = 0;
+    let mut out = Vec::with_capacity(samples);
+    for sample in 0..samples {
+        let day = start + (span * sample / (samples - 1)) as Day;
+        while index < sorted.len() && sorted[index].date <= day {
+            running += sorted[index].amount;
+            index += 1;
+        }
+        out.push((day, running));
+    }
+    out
+}
