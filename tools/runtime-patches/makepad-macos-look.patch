+    /// A name too long for its column ends in an ellipsis, as Activity
+    /// Monitor's do, rather than being cut through a letter.
+    fn fit_name(&mut self, cx: &mut Cx2d, name: &str, room: f64) -> String {
+        let mut width = |text: &str| {
+            self.draw_name.layout(cx, 0.0, 0.0, None, false, Align::default(), text).size_in_lpxs.width as f64
+        };
+        if width(name) <= room {
+            return name.to_owned();
+        }
+        // The longest start that still fits with its ellipsis.
+        let chars: Vec<char> = name.chars().collect();
+        let (mut fits, mut over) = (0, chars.len());
+        while over - fits > 1 {
+            let mid = (fits + over) / 2;
+            if width(&(chars[..mid].iter().collect::<String>() + "…")) <= room {
+                fits = mid;
+            } else {
+                over = mid;
+            }
+        }
+        chars[..fits].iter().collect::<String>().trim_end().to_owned() + "…"
+    }
+
+    /// One tree row's name on a desktop: its indent, its disclosure mark when
+    /// it has children, then the name, clipped to the column.
+    fn draw_tree_name(&mut self, cx: &mut Cx2d, cell: &GridCell, row: &Row, selected: bool) {
+        let process = &self.processes[row.index];
+        let folded = self.collapsed.contains(&process.pid);
+        let name = process.name.clone();
+        let x = cell.rect.pos.x + DESK_HEAD_PAD + row.depth.min(24) as f64 * DESK_TREE_INDENT;
+        let middle = cell.rect.pos.y + cell.rect.size.y * 0.5;
+        cx.push_clip_rect(Rect { pos: cell.rect.pos, size: cell.rect.size - dvec2(1.0, 0.0) });
+        if row.children > 0 {
+            let rect = Rect { pos: dvec2(x, middle - 5.0), size: dvec2(10.0, 10.0) };
+            let draw = if folded { &mut self.draw_twist_closed } else { &mut self.draw_twist_open };
+            draw.color = if selected { self.on_primary } else { self.muted_color };
+            draw.draw_abs(cx, rect);
+            // A little wider than the mark, for a finger on a trackpad.
+            self.twist_rects.push((
+                Rect { pos: dvec2(x - 3.0, cell.rect.pos.y), size: dvec2(16.0, cell.rect.size.y) },
+                cell.row,
+            ));
+        }
+        let name = self.fit_name(cx, &name, cell.rect.pos.x + cell.rect.size.x - DESK_HEAD_PAD - (x + DESK_TREE_MARK));
+        self.draw_name.color = if selected { self.on_primary } else { self.ink };
+        let laidout = self.draw_name.layout(cx, 0.0, 0.0, None, false, Align::default(), &name);
+        let tall = laidout.size_in_lpxs.height as f64;
+        self.draw_name.draw_abs(
+            cx,
+            dvec2(x + DESK_TREE_MARK, cell.rect.pos.y + (cell.rect.size.y - tall) * 0.5),
+            &name,
+        );
+        cx.pop_clip_rect();
+    }
+
+    /// The header's labels, aligned with their columns, over the cells the
+    /// grid drew for them (it would centre them all); the grid keeps the
+    /// header's clicks and column drags. Also the sort mark beside the sorted
+    /// column's label, and the header's hairlines: one under it, one between
+    /// each pair of columns.
+    fn draw_grid_head(&mut self, cx: &mut Cx2d) {
+        let rect = self.view.widget(cx, ids!(process_grid)).area().rect(cx);
+        if rect.size.x < 1.0 {
+            return;
+        }
+        self.grid_rect = rect;
+        let grid_ref = self.view.data_grid(cx, ids!(process_grid));
+        let Some(grid) = grid_ref.borrow() else { return };
+        let scroll = grid.scroll_pos().x;
+        let columns = self.columns();
+        let widths: Vec<f64> = (0..columns.len()).map(|display| grid.col_width(display)).collect();
+        drop(grid);
+        let head = Rect { pos: rect.pos, size: dvec2(rect.size.x, DESK_HEAD_HEIGHT) };
+        cx.push_clip_rect(head);
+        self.draw_rule.color = self.line;
+        self.draw_rule.draw_abs(
+            cx,
+            Rect { pos: dvec2(head.pos.x, head.pos.y + DESK_HEAD_HEIGHT - 1.0), size: dvec2(head.size.x, 1.0) },
+        );
+        let mut x = head.pos.x - scroll;
+        for (display, &col) in columns.iter().enumerate() {
+            let width = widths[display];
+            let label = self.column_label(col);
+            let sorted = col == self.sort_column;
+            let laidout = self.draw_head.layout(cx, 0.0, 0.0, None, false, Align::default(), label);
+            let text_width = laidout.size_in_lpxs.width as f64;
+            let tall = laidout.size_in_lpxs.height as f64;
+            let mark_width = if sorted { 12.0 } else { 0.0 };
+            let room = (width - 2.0 * DESK_HEAD_PAD - text_width - mark_width).max(0.0);
+            let at = x + DESK_HEAD_PAD + room * self.column_align(col);
+            let y = head.pos.y + (DESK_HEAD_HEIGHT - tall) * 0.5;
+            self.draw_head.draw_abs(cx, dvec2(at, y), label);
+            if sorted {
+                let draw = if self.ascending { &mut self.draw_sort_up } else { &mut self.draw_sort_down };
+                draw.color = self.muted_color;
+                draw.draw_abs(
+                    cx,
+                    Rect {
+                        pos: dvec2(at + text_width + 4.0, head.pos.y + DESK_HEAD_HEIGHT * 0.5 - 3.0),
+                        size: dvec2(8.0, 6.0),
+                    },
+                );
+            }
+            if display + 1 < columns.len() {
+                self.draw_rule.draw_abs(
+                    cx,
+                    Rect { pos: dvec2(x + width - 1.0, head.pos.y + 5.0), size: dvec2(1.0, DESK_HEAD_HEIGHT - 10.0) },
+                );
+            }
+            x += width;
+        }
+        cx.pop_clip_rect();
+    }
+}
+
+/// A desktop's State column.
+fn state_word(state: ProcState) -> &'static str {
+    match state {
+        ProcState::Running => "Running",
+        ProcState::Sleeping => "Sleeping",
+        ProcState::Waiting => "Waiting",
+        ProcState::Idle => "Idle",
+        ProcState::Stopped => "Stopped",
+        ProcState::Zombie => "Zombie",
+        ProcState::Unknown => "—",
+    }
+}
