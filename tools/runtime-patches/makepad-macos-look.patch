+/// A Mac's unified window, on the touch tree the tests build: the in-place
+/// adding needs none of the desk's widgets.
+fn mac_work_list(view: &mut RemindersView, cx: &mut Cx) {
+    view.pointer = true;
+    view.unified = true;
+    view.open_filter(cx, Filter::List(WORK_LIST_ID));
+}
+
+fn new_rows(view: &RemindersView) -> Vec<usize> {
+    view.list_rows
+        .iter()
+        .enumerate()
+        .filter(|(_, row)| matches!(row, ListRow::New))
+        .map(|(at, _)| at)
+        .collect()
+}
+
+fn reminder_count(view: &RemindersView) -> usize {
+    view.document.as_ref().unwrap().reminders.len()
+}
+
+#[test]
+fn a_macs_new_reminder_is_a_row_in_place_and_return_makes_it_and_starts_another() {
+    let (mut cx, root) = root();
+    let mut view = root.borrow_mut::<RemindersView>().unwrap();
+    mac_work_list(&mut view, &mut cx);
+    let before = reminder_count(&view);
+    view.begin_adding(&mut cx);
+    assert!(view.draft.is_none(), "a sheet opened");
+    assert!(view.adding_focus, "the row's title doesn't take the keyboard");
+    let at = new_rows(&view);
+    assert_eq!(at.len(), 1);
+    let at = at[0];
+    // At the end of the list: no open reminder under it.
+    assert!(!view.list_rows[at + 1..]
+        .iter()
+        .any(|row| matches!(row, ListRow::Item(item) if !item.completed)));
+    view.return_in_new_row(&mut cx, "Call Sam".into());
+    let made = view
+        .document
+        .as_ref()
+        .unwrap()
+        .reminders
+        .iter()
+        .find(|reminder| reminder.title == "Call Sam")
+        .cloned()
+        .unwrap();
+    assert_eq!(reminder_count(&view), before + 1);
+    assert_eq!((made.list_id, made.due, made.flagged), (WORK_LIST_ID, None, false));
+    // It takes the row's place, and the next empty row waits under it.
+    assert!(matches!(&view.list_rows[at], ListRow::Item(item) if item.id == made.id));
+    assert_eq!(new_rows(&view), vec![at + 1]);
+    assert_eq!(view.adding.as_ref().unwrap().text, "");
+    assert!(view.adding_focus);
+    // Return in an empty row ends adding, and makes nothing.
+    view.return_in_new_row(&mut cx, "  ".into());
+    assert!(view.adding.is_none());
+    assert!(new_rows(&view).is_empty());
+    assert_eq!(reminder_count(&view), before + 1);
+}
+
+#[test]
+fn a_macs_new_row_is_kept_when_it_loses_the_keyboard_and_an_empty_one_goes() {
+    let (mut cx, root) = root();
+    let mut view = root.borrow_mut::<RemindersView>().unwrap();
+    mac_work_list(&mut view, &mut cx);
+    let before = reminder_count(&view);
+    view.begin_adding(&mut cx);
+    view.adding.as_mut().unwrap().text = "Buy stamps".into();
+    // A press on another list: it goes where it was being added.
+    view.open_filter(&mut cx, Filter::Today);
+    assert!(view.adding.is_none());
+    let stamps = view
+        .document
+        .as_ref()
+        .unwrap()
+        .reminders
+        .iter()
+        .find(|reminder| reminder.title == "Buy stamps")
+        .cloned()
+        .unwrap();
+    assert_eq!((stamps.list_id, stamps.due), (WORK_LIST_ID, None));
+    // Today's row is due today; empty, it goes without a reminder.
+    view.begin_adding(&mut cx);
+    assert_eq!(view.adding.as_ref().unwrap().defaults.due.map(|due| due.day), Some(view.now.day));
+    assert_eq!(new_rows(&view).len(), 1);
+    view.finish_adding(&mut cx);
+    assert!(new_rows(&view).is_empty());
+    assert_eq!(reminder_count(&view), before + 1);
+    // Completed takes no new reminder; a search gives way to one.
+    view.open_filter(&mut cx, Filter::Completed);
+    view.begin_adding(&mut cx);
+    assert!(view.adding.is_none());
+    view.open_filter(&mut cx, Filter::All);
+    view.search = "zzz".into();
+    view.rebuild(&mut cx);
+    view.begin_adding(&mut cx);
+    assert!(view.search.is_empty());
+    assert_eq!(new_rows(&view).len(), 1);
+    assert!(view.draft.is_none());
+}
+
+#[test]
+fn a_macs_new_row_hangs_its_details_from_its_info_button() {
+    let (mut cx, root) = root();
+    let mut view = root.borrow_mut::<RemindersView>().unwrap();
+    mac_work_list(&mut view, &mut cx);
+    let anchor = Rect { pos: dvec2(600.0, 200.0), size: dvec2(28.0, 28.0) };
+    // What was typed becomes the reminder, whose details hang from the row.
+    view.begin_adding(&mut cx);
+    view.adding.as_mut().unwrap().text = "Pay rent".into();
+    view.adding_box = Some(anchor);
+    view.open_new_details(&mut cx);
+    let id = view
+        .document
+        .as_ref()
+        .unwrap()
+        .reminders
+        .iter()
+        .find(|reminder| reminder.title == "Pay rent")
+        .map(|reminder| reminder.id)
+        .unwrap();
+    assert_eq!(view.draft.as_ref().unwrap().original_id, Some(id));
+    assert_eq!(view.pop_anchor, Some(anchor));
+    assert!(view.adding.is_none());
+    view.discard_draft(&mut cx);
+    // An empty row's details make a new one; the row waits under them and
+    // goes when they close.
+    let before = reminder_count(&view);
+    view.begin_adding(&mut cx);
+    view.adding_box = Some(anchor);
+    view.open_new_details(&mut cx);
+    assert_eq!(view.draft.as_ref().unwrap().original_id, None);
+    assert_eq!(view.draft.as_ref().unwrap().value.list_id, WORK_LIST_ID);
+    assert_eq!(view.pop_anchor, Some(anchor));
+    assert_eq!(new_rows(&view).len(), 1);
+    view.discard_draft(&mut cx);
+    assert!(view.adding.is_none());
+    assert!(new_rows(&view).is_empty());
+    assert_eq!(reminder_count(&view), before);
+}
+
+fn fail(view: &mut RemindersView, cx: &mut Cx) {
+    let id = view.set_id.unwrap();
+    view.on_storage(cx, &[response(id, StorageOp::Set, Err(StorageError::Io("full".into())))]);
+}
+
+fn ack(view: &mut RemindersView, cx: &mut Cx) {
+    let id = view.set_id.unwrap();
+    view.on_storage(cx, &[response(id, StorageOp::Set, Ok(StorageResult::Unit))]);
+}
