+        self.widths_applied = false;
+        self.status = "New workbook".into();
+        self.grid(cx).set_selection(cx, Some(GridSelection::single(0, 0)));
+        self.after_model_change(cx);
+    }
+
+    // -- fill handle -------------------------------------------------------
+
+    fn cell_at(&self, abs: Vec2d) -> Option<Pos> {
+        self.cell_rects
+            .iter()
+            .find(|c| c.rect.contains(abs))
+            .map(|c| (c.row, c.display_col))
+    }
+
+    /// The fill gesture runs *before* the grid sees the mouse, so dragging the
+    /// handle does not start a selection drag instead.
+    fn handle_fill_gesture(&mut self, cx: &mut Cx, event: &Event) -> bool {
+        match event {
+            Event::MouseDown(e) => {
+                if self.fill.is_some() || self.editing.is_some() {
+                    return false;
+                }
+                let Some(hr) = self.handle_rect else {
+                    return false;
+                };
+                if !hr.contains(e.abs) {
+                    return false;
+                }
+                let ((r0, c0), (r1, c1)) = self.selection_rect(cx);
+                self.fill = Some(FillDrag {
+                    s0: (r0, c0),
+                    s1: (r1, c1),
+                    cur: (r1, c1),
+                });
+                true
+            }
+            Event::MouseMove(e) if self.fill.is_some() => {
+                if let Some(pos) = self.cell_at(e.abs) {
+                    if let Some(f) = &mut self.fill {
+                        if f.cur != pos {
+                            f.cur = pos;
+                            self.view.redraw(cx);
+                        }
+                    }
+                }
+                true
+            }
+            Event::MouseUp(_) if self.fill.is_some() => {
+                if let Some(f) = self.fill.take() {
+                    self.commit_fill(cx, f);
+                }
+                true
+            }
+            _ => false,
+        }
+    }
+
+    /// The destination a drag to `cur` means: Excel extends along whichever
+    /// axis the pointer moved furthest.
+    fn fill_dest(f: &FillDrag) -> (Pos, Pos) {
+        // How far the pointer reaches beyond each edge of the source block.
+        let down = f.cur.0 as isize - f.s1.0 as isize;
+        let up = f.s0.0 as isize - f.cur.0 as isize;
+        let right = f.cur.1 as isize - f.s1.1 as isize;
+        let left = f.s0.1 as isize - f.cur.1 as isize;
+        let vertical = down.max(up).max(0);
+        let horizontal = right.max(left).max(0);
+        if vertical == 0 && horizontal == 0 {
+            return (f.s0, f.s1);
+        }
+        if vertical >= horizontal {
+            if down > 0 {
+                (f.s0, (f.cur.0, f.s1.1))
+            } else {
+                ((f.cur.0, f.s0.1), f.s1)
+            }
+        } else if right > 0 {
+            (f.s0, (f.s1.0, f.cur.1))
+        } else {
+            ((f.s0.0, f.cur.1), f.s1)
+        }
+    }
+
+    fn commit_fill(&mut self, cx: &mut Cx, f: FillDrag) {
+        let dest = Self::fill_dest(&f);
+        if dest == (f.s0, f.s1) {
+            self.view.redraw(cx);
+            return;
+        }
+        self.wb.fill((f.s0, f.s1), dest);
+        self.grid(cx).set_selection(
+            cx,
+            Some(GridSelection {
+                kind: GridSelectKind::Cells,
+                anchor: dest.0,
+                head: dest.1,
+            }),
+        );
+        self.note(format!(
+            "Filled {}:{}",
+            sheet::pos_name(dest.0),
+            sheet::pos_name(dest.1)
+        ));
+        self.after_model_change(cx);
+    }
+
+    // -- keyboard ----------------------------------------------------------
+
+    /// True when the key was all this function's, and goes no further.
+    fn handle_global_keys(&mut self, cx: &mut Cx, event: &Event) -> bool {
+        if self.desk {
+            if let Event::KeyDown(ke) = event {
+                return self.desk_key(cx, ke);
+            }
+        }
+        match event {
+            Event::TextInput(te) if te.was_paste => {
+                if self.editing.is_some() {
+                    return false;
+                }
+                let area = self.grid_area(cx);
+                if cx.has_key_focus(area) {
+                    let text = te.input.clone();
+                    self.paste_clipboard(cx, &text);
+                }
+            }
+            Event::KeyDown(ke) => {
+                let cmd = ke.modifiers.logo || ke.modifiers.control;
+                if !cmd {
+                    return false;
+                }
+                match ke.key_code {
+                    KeyCode::KeyZ if ke.modifiers.shift => self.redo(cx),
+                    KeyCode::KeyZ => self.undo(cx),
+                    KeyCode::KeyY => self.redo(cx),
+                    KeyCode::KeyB => {
+                        let pos = self.active(cx);
+                        let on = !self.wb.sheet().format(pos).bold;
+                        self.apply_format(cx, move |f| f.bold = on);
+                    }
+                    KeyCode::KeyI => {
+                        let pos = self.active(cx);
+                        let on = !self.wb.sheet().format(pos).italic;
+                        self.apply_format(cx, move |f| f.italic = on);
+                    }
+                    KeyCode::KeyC => {
+                        // The grid answers the platform copy request through
+                        // its provider; this is the belt-and-braces path for
+                        // platforms that do not raise Hit::TextCopy.
+                        if self.editing.is_none() {
+                            self.copy_selection(cx);
+                        }
+                    }
+                    _ => (),
+                }
+            }
+            _ => (),
+        }
+        false
+    }
+}
+
+/// A desktop's window: its document, its sheets and its menus. A phone keeps the
+/// tree above as it always was, and none of this runs there.
+impl MpSheets {
+    fn add_sheet(&mut self, cx: &mut Cx) {
+        if self.wb.sheets.len() < MAX_TABS {
+            self.wb.add_sheet();
+            self.widths_applied = false;
+            self.note("New sheet".into());
+            if self.desk {
+                self.reset_loaded_sheet_view(cx);
+                self.focus_wanted = Some(Focus::Grid);
+            }
+            self.after_model_change(cx);
+        } else {
+            self.status = if self.desk {
+                format!("A workbook can have up to {MAX_TABS} sheets.")
+            } else {
+                format!("At most {MAX_TABS} sheets")
+            };
+            self.sync_chrome(cx);
+        }
+    }
+
+    fn clear_selection(&mut self, cx: &mut Cx) {
+        let cells = self.selection_cells(cx);
+        self.wb.clear_cells(&cells);
+        self.note(format!("Cleared {} cells", cells.len()));
+        self.after_model_change(cx);
+    }
+
+    // -- the document ------------------------------------------------------
+
+    fn first_desk_sync(&mut self, cx: &mut Cx) {
+        self.tool_level = None;
+        if !self.doc.ready {
+            self.doc = Document {
+                ready: true,
+                title: "Untitled".to_string(),
+                saved_body: sheet::book_body(&self.wb),
+                ..Default::default()
+            };
+            self.restore_last_document(cx);
+            self.announce_title(cx);
+        }
+        self.sync_doc_labels(cx);
+        self.settle_focus();
+        self.paint_overlays(cx);
+    }
+
+    /// The toolbar's two lines: the document's name, and whether it is saved. A Mac's
+    /// document says Edited until it is saved, then nothing.
+    fn sync_doc_labels(&mut self, cx: &mut Cx) {
+        let state = if self.doc.edited {
+            "Edited".to_string()
+        } else if self.desk {
+            String::new()
+        } else {
+            match (self.doc.saved_at, docs::now_secs()) {
+                (Some(at), Some(now)) => docs::saved_words(at, now),
+                _ => String::new(),
+            }
+        };
+        self.view.label(cx, ids!(doc_title)).set_text(cx, &self.doc.title);
+        self.view.label(cx, ids!(doc_state)).set_text(cx, &state);
+        self.view.widget(cx, ids!(doc_state)).set_visible(cx, !state.is_empty());
+    }
+
+    /// Whether the document has changes follows the model, so an edit undone
+    /// has none. Called after every change to it, which is rare next to frames.
+    fn refresh_edited(&mut self, cx: &mut Cx) {
+        if !self.desk || !self.doc.ready {
+            return;
+        }
+        let edited = sheet::book_body(&self.wb) != self.doc.saved_body;
+        if edited != self.doc.edited {
+            self.doc.edited = edited;
+            self.sync_doc_labels(cx);
+        }
+    }
+
+    fn announce_title(&mut self, cx: &mut Cx) {
+        cx.widget_action(self.widget_uid(), MpSheetsAction::Title(self.doc.title.clone()));
+    }
+
+    fn commit_any_edit(&mut self, cx: &mut Cx) {
+        if self.editing.is_some() {
+            self.commit_live_editor(cx);
+        }
+        if self.rename.is_some() {
+            self.commit_rename(cx);
+        }
+    }
+
+    /// This window now holds this workbook.
+    fn install_document(&mut self, cx: &mut Cx, workbook: Workbook, file: Option<String>, title: String, saved_at: Option<i64>) {
+        self.wb = workbook;
+        self.doc = Document {
+            ready: true,
+            file,
+            title,
+            saved_body: sheet::book_body(&self.wb),
+            saved_at,
+            edited: false,
+            chosen: None,
+        };
+        self.status.clear();
+        self.reset_loaded_sheet_view(cx);
+        self.sync_doc_labels(cx);
+        self.announce_title(cx);
+        self.after_model_change(cx);
+    }
+
+    /// A workbook stays bound to its file. A CSV is something to work from: it
+    /// holds one sheet's values, so saving it makes a workbook. A file chosen in a
+    /// Mac's panel is not reopened by the next window: what the panel gave this
+    /// process ends with it.
+    fn take_document(&mut self, cx: &mut Cx, workbook: Workbook, file: &str, chosen: Option<PathBuf>) {
+        let bound = !docs::is_csv(file);
+        let saved_at = if bound && self.storage.is_none() && chosen.is_none() {
+            docs::modified_secs(&docs::documents_folder(), file)
+        } else {
+            None
+        };
+        self.install_document(cx, workbook, bound.then(|| file.to_string()), docs::title_of(file), saved_at);
+        self.remember_document(if chosen.is_some() { None } else { Some(file) });
+        self.doc.chosen = if bound { chosen } else { None };
+    }
+
+    fn fresh_document(&mut self, cx: &mut Cx) {
+        self.install_document(cx, Workbook::default(), None, "Untitled".to_string(), None);
+        self.remember_document(None);
+    }
+
+    /// The next window opens on the same document. Best effort: without this
+    /// a window opens as a new one, and nothing else depends on it.
+    fn remember_document(&self, file: Option<&str>) {
+        if self.storage.is_some() {
+            return;
+        }
+        let folder = docs::documents_folder();
+        match file {
+            Some(file) => {
+                let _ = docs::write_document(&folder, docs::LAST_DOCUMENT, file.as_bytes());
+            }
+            None => {
+                let _ = std::fs::remove_file(folder.join(docs::LAST_DOCUMENT));
+            }
+        }
+    }
+
+    fn restore_last_document(&mut self, cx: &mut Cx) {
+        if self.storage.is_some() || !self.can_save() {
+            return;
+        }
+        let folder = docs::documents_folder();
+        let Ok(bytes) = docs::read_document(&folder, docs::LAST_DOCUMENT) else {
+            return;
+        };
+        let Ok(file) = String::from_utf8(bytes) else {
+            return;
+        };
+        let file = file.trim().to_string();
+        if file.contains('/') || docs::entry_for(&file, String::new()).is_none() {
+            return;
+        }
+        let Ok(bytes) = docs::read_document(&folder, &file) else {
+            return;
+        };
+        if let Ok(workbook) = parse_document(&file, bytes) {
+            self.take_document(cx, workbook, &file, None);
+        }
+    }
+
+    fn new_command(&mut self, cx: &mut Cx) {
+        self.commit_any_edit(cx);
+        if self.doc.edited {
+            self.put_ask(cx, Ask::KeepChanges(AfterKeep::New));
+        } else {
+            self.fresh_document(cx);
+        }
+    }
+
+    /// A Mac's own Open and Save panels serve this window: the Mac's style, on a desk,
+    /// hosted as a process by a window manager that puts them up. In-process hosting
+    /// (a storage jail), other styles and other systems keep the app's own sheets.
+    fn native_panels(&self, cx: &Cx) -> bool {
+        cfg!(target_os = "macos") && self.desk && self.mac_style && self.storage.is_none() && cx.in_makepad_studio() && !app_sheets_asked()
+    }
+
+    /// A Mac's panel starts in the app's own folder, as a Mac app's starts in its Documents.
+    fn panel_dialog(&self, id: LiveId, title: &str) -> FileDialog {
+        let folder = docs::documents_folder();
+        let _ = std::fs::create_dir_all(&folder);
+        let kinds = vec![docs::BOOK_EXTENSION.to_string(), docs::CSV_EXTENSION.to_string()];
+        FileDialog::new().set_id(id).set_title(title.into()).set_location(folder).add_filter("Spreadsheets".into(), kinds)
+    }
+
+    fn open_command(&mut self, cx: &mut Cx) {
+        self.commit_any_edit(cx);
+        if self.native_panels(cx) {
+            let dialog = self.panel_dialog(OPEN_PANEL, "Open");
+            cx.open_select_file_dialog(dialog);
+            return;
+        }
+        self.open_open = true;
+        self.doc_selected = None;
+        self.view.portal_list(cx, ids!(docs_list)).set_first_id_and_scroll(0, 0.0);
+        self.settle_focus();
+        self.request_list(cx);
+    }
+
+    fn save_command(&mut self, cx: &mut Cx) {
+        self.commit_any_edit(cx);
+        match self.doc.file.clone() {
+            Some(file) => {
+                let chosen = self.doc.chosen.clone();
+                self.start_write(cx, SaveJob { file, format: DocFormat::Book, chosen })
+            }
+            None => self.present_save(cx),
+        }
+    }
+
+    fn save_as_command(&mut self, cx: &mut Cx) {
+        self.commit_any_edit(cx);
+        self.after_save = None;
+        self.present_save(cx);
+    }
+
+    /// Where a document is named: a Mac's Save panel, else the app's own sheet.
+    fn present_save(&mut self, cx: &mut Cx) {
+        if !self.native_panels(cx) {
+            self.present_save_sheet(cx);
+            return;
+        }
+        let name = docs::file_name_for(&self.doc.title, DocFormat::Book);
+        let dialog = self.panel_dialog(SAVE_PANEL, "Save").set_filename(name);
+        cx.open_save_file_dialog(dialog);
+    }
+
+    /// What a Mac's Open or Save panel came back with.
+    fn panel_answer(&mut self, cx: &mut Cx, answer: &FileDialogAction) {
+        match answer {
+            FileDialogAction::FileSelected { id, paths } if *id == OPEN_PANEL => {
+                let Some(path) = paths.first().cloned() else {
+                    return;
+                };
+                if self.doc.edited {
+                    self.put_ask(cx, Ask::KeepChanges(AfterKeep::OpenChosen(path)));
+                } else {
+                    self.read_chosen(cx, path);
+                }
+            }
+            FileDialogAction::SaveFileSelected { id, path } if *id == SAVE_PANEL => {
+                let file = path.file_name().map(|name| name.to_string_lossy().into_owned()).unwrap_or_default();
+                // The panel asked about a file of that name already; its kind says what it holds.
+                let format = if docs::is_csv(&file) { DocFormat::Csv } else { DocFormat::Book };
+                self.start_write(cx, SaveJob { file, format, chosen: chosen_place(path) });
+            }
+            // Nothing was named: whatever the Save was for doesn't happen either.
+            FileDialogAction::SaveFileCancelled { id } if *id == SAVE_PANEL => self.after_save = None,
+            _ => {}
+        }
+    }
+
+    fn read_chosen(&mut self, cx: &mut Cx, path: PathBuf) {
+        let id = LiveId::unique();
+        cx.read_chosen_file(id, &path);
+        self.chosen_read = Some((id, path));
+    }
+
+    /// The window manager read or wrote a chosen file for this window.
+    fn chosen_answer(&mut self, cx: &mut Cx, done: &ChosenFileAction) {
+        let (id, result) = match done {
+            ChosenFileAction::Done { id, data } => (*id, Ok(data.clone())),
+            ChosenFileAction::Failed { id, error } => (*id, Err(error.clone())),
+            ChosenFileAction::None => return,
+        };
+        if self.chosen_read.as_ref().is_some_and(|(read, _)| *read == id) {
+            let (_, path) = self.chosen_read.take().unwrap();
+            let file = path.file_name().map(|name| name.to_string_lossy().into_owned()).unwrap_or_default();
+            match result.and_then(|bytes| parse_document(&file, bytes)) {
+                Ok(workbook) => {
+                    self.open_open = false;
+                    self.ask = None;
+                    self.take_document(cx, workbook, &file, chosen_place(&path));
+                    self.settle_focus();
+                    self.paint_overlays(cx);
+                }
+                // What is on the screen stays: nothing was replaced. The refusal reads in
+                // the app's own sheet.
+                Err(why) => self.put_ask(cx, Ask::OpenFailed { file, why }),
+            }
+        } else if self.chosen_write.as_ref().is_some_and(|(write, _)| *write == id) {
+            let (_, job) = self.chosen_write.take().unwrap();
+            self.document_written(cx, job, result.map(|_| ()));
+        }
+    }
+
+    /// The window's close: true lets it go. With changes it asks, and whatever
+    /// is answered decides; under a sheet of its own it stays, as a Mac's does.
+    pub fn close_requested(&mut self, cx: &mut Cx) -> bool {
+        if !self.desk {
+            return true;
+        }
+        if self.sheet_up() {
+            return false;
+        }
+        self.close_menus(cx);
+        self.commit_any_edit(cx);
+        if self.doc.edited {
+            self.put_ask(cx, Ask::KeepChanges(AfterKeep::Close));
+            return false;
+        }
+        true
+    }
+
+    fn run_after(&mut self, cx: &mut Cx, after: AfterKeep) {
+        match after {
+            AfterKeep::New => self.fresh_document(cx),
+            AfterKeep::Open(file) => self.request_read(cx, file),
+            AfterKeep::OpenChosen(path) => self.read_chosen(cx, path),
+            AfterKeep::Close => cx.widget_action(self.widget_uid(), MpSheetsAction::CloseNow),
+        }
+    }
+
+    // -- the folder, on disk or in a host's storage jail ---------------------
+
+    fn request_list(&mut self, cx: &mut Cx) {
+        if let Some(storage) = &self.storage {
+            self.doc_list_request = Some(storage.list(cx, DOC_PREFIX, None, 1000));
+            self.paint_overlays(cx);
+            return;
+        }
+        let result = docs::list_documents(&docs::documents_folder());
+        self.documents_listed(cx, result);
+    }
+
+    fn documents_listed(&mut self, cx: &mut Cx, result: Result<Vec<DocEntry>, String>) {
+        match result {
+            Ok(entries) => {
+                self.doc_entries = entries;
+                self.docs_error = false;
+            }
+            Err(_) => {
+                self.doc_entries.clear();
+                self.docs_error = true;
+            }
+        }
+        let count = self.doc_entries.len();
+        self.doc_selected = self.doc_selected.filter(|index| *index < count);
+        self.paint_overlays(cx);
+    }
+
+    fn request_read(&mut self, cx: &mut Cx, file: String) {
+        if let Some(storage) = &self.storage {
+            let id = storage.get(cx, &format!("{DOC_PREFIX}{file}"));
+            self.doc_read_request = Some((id, file));
+            return;
+        }
+        let result = docs::read_document(&docs::documents_folder(), &file);
+        self.document_read(cx, file, result);
+    }
+
+    fn document_read(&mut self, cx: &mut Cx, file: String, result: Result<Vec<u8>, String>) {
+        match result.and_then(|bytes| parse_document(&file, bytes)) {
+            Ok(workbook) => {
+                self.open_open = false;
+                self.ask = None;
+                self.take_document(cx, workbook, &file, None);
+                self.settle_focus();
+                self.paint_overlays(cx);
+            }
+            // What is on the screen stays: nothing was replaced.
+            Err(why) => self.put_ask(cx, Ask::OpenFailed { file, why }),
+        }
+    }
+
+    fn start_write(&mut self, cx: &mut Cx, job: SaveJob) {
+        let bytes = match job.format {
+            DocFormat::Book => sheet::to_book(&self.wb),
+            DocFormat::Csv => sheet::to_csv(self.wb.sheet()),
+        }
+        .into_bytes();
+        // A place a Mac's panel named: the window manager writes it, whole, for this window.
+        if let Some(path) = job.chosen.clone() {
+            let id = LiveId::unique();
+            cx.write_chosen_file(id, &path, bytes);
+            self.chosen_write = Some((id, job));
+            return;
+        }
+        if let Some(storage) = &self.storage {
+            let id = storage.set(cx, &format!("{DOC_PREFIX}{}", job.file), bytes);
+            self.doc_write_request = Some((id, job));
+            return;
+        }
+        let result = docs::write_document(&docs::documents_folder(), &job.file, &bytes);
+        self.document_written(cx, job, result);
+    }
+
+    fn document_written(&mut self, cx: &mut Cx, job: SaveJob, result: Result<(), String>) {
+        if let Err(why) = result {
+            self.put_ask(cx, Ask::SaveFailed { job, why });
+            return;
+        }
+        self.save_open = false;
+        self.ask = None;
+        match job.format {
+            DocFormat::Book => {
+                self.doc.file = Some(job.file.clone());
+                self.doc.title = docs::title_of(&job.file);
+                self.doc.saved_body = sheet::book_body(&self.wb);
+                self.doc.saved_at = docs::now_secs();
+                self.doc.edited = false;
+                self.doc.chosen = job.chosen.clone();
+                self.status.clear();
+                // A file outside the app's folder is not the next window's to reopen.
+                self.remember_document(if job.chosen.is_some() { None } else { Some(&job.file) });
+                self.announce_title(cx);
+            }
+            // A copy for other apps: this workbook is as saved or unsaved as it was.
+            DocFormat::Csv => {
+                self.status = format!("Saved a copy as \u{201c}{}\u{201d}.", job.file);
+            }
+        }
+        self.sync_doc_labels(cx);
+        self.sync_chrome(cx);
+        self.settle_focus();
+        self.paint_overlays(cx);
+        if let Some(after) = self.after_save.take() {
+            self.run_after(cx, after);
+        }
+    }
+
+    /// True when this answer was to one of the requests above.
+    fn desk_storage_answer(&mut self, cx: &mut Cx, response: &StorageResponse) -> bool {
+        if self.doc_list_request.as_ref().is_some_and(|id| *id == response.request_id) {
+            self.doc_list_request = None;
+            let result = match &response.result {
+                Ok(StorageResult::List(list)) => Ok(list
+                    .keys
+                    .iter()
+                    .filter_map(|key| key.strip_prefix(DOC_PREFIX))
+                    .filter_map(|file| docs::entry_for(file, String::new()))
+                    .collect()),
+                Ok(_) => Ok(Vec::new()),
+                Err(_) => Err(String::new()),
+            };
+            self.documents_listed(cx, result);
+            return true;
+        }
+        if self.doc_read_request.as_ref().is_some_and(|(id, _)| *id == response.request_id) {
+            let (_, file) = self.doc_read_request.take().unwrap();
+            let result = match &response.result {
+                Ok(StorageResult::Value(Some(bytes))) => Ok(bytes.clone()),
+                Ok(_) => Err("The file is no longer there.".to_string()),
+                Err(_) => Err("The storage may be full or unavailable.".to_string()),
+            };
+            self.document_read(cx, file, result);
+            return true;
+        }
+        if self.doc_write_request.as_ref().is_some_and(|(id, _)| *id == response.request_id) {
+            let (_, job) = self.doc_write_request.take().unwrap();
+            let result = match &response.result {
+                Ok(_) => Ok(()),
+                Err(_) => Err("The storage may be full or unavailable.".to_string()),
+            };
+            self.document_written(cx, job, result);
+            return true;
+        }
+        false
+    }
+
+    // -- the Save sheet ------------------------------------------------------
+
+    fn present_save_sheet(&mut self, cx: &mut Cx) {
+        self.save_open = true;
+        self.save_format = DocFormat::Book;
+        self.view.drop_down(cx, ids!(save_format)).set_selected_item(cx, 0);
+        let title = self.doc.title.clone();
+        self.view.text_input(cx, ids!(save_name)).set_text(cx, &title);
+        self.focus_wanted = Some(Focus::SaveName { select: true });
+        // Which names are taken.
+        self.request_list(cx);
+    }
+
+    fn close_save_sheet(&mut self, cx: &mut Cx) {
+        self.save_open = false;
+        self.after_save = None;
+        self.settle_focus();
+        self.paint_overlays(cx);
+    }
+
+    fn save_confirm(&mut self, cx: &mut Cx) {
+        let name = self.view.text_input(cx, ids!(save_name)).text();
+        if docs::name_problem(&name).is_some() {
+            // Return lets go of the keyboard; there is nothing to go on to.
+            self.focus_wanted = Some(Focus::SaveName { select: false });
+            self.view.redraw(cx);
+            return;
+        }
+        let format = self.save_format;
+        let job = SaveJob { file: docs::file_name_for(&name, format), format, chosen: None };
+        let own = self.doc.file.as_deref().is_some_and(|file| file.eq_ignore_ascii_case(&job.file));
+        let taken = self.doc_entries.iter().any(|entry| entry.file.eq_ignore_ascii_case(&job.file));
+        if taken && !own {
+            self.put_ask(cx, Ask::Replace(job));
+        } else {
+            self.start_write(cx, job);
+        }
+    }
+
+    // -- the Open sheet ------------------------------------------------------
+
+    fn close_open_sheet(&mut self, cx: &mut Cx) {
+        self.open_open = false;
+        self.settle_focus();
+        self.paint_overlays(cx);
+    }
+
+    fn doc_step(&mut self, cx: &mut Cx, delta: isize) {
+        let count = self.doc_entries.len();
+        if count == 0 {
+            return;
+        }
+        let next = match self.doc_selected {
+            Some(index) => (index as isize + delta).clamp(0, count as isize - 1) as usize,
+            None => 0,
+        };
+        self.doc_selected = Some(next);
+        let list = self.view.portal_list(cx, ids!(docs_list));
+        let first = list.first_id();
+        let visible = list.visible_items().max(1);
+        if next < first || next >= first + visible.saturating_sub(1) {
+            list.set_first_id_and_scroll(next.saturating_sub(visible.saturating_sub(2)), 0.0);
+        }
+        self.paint_overlays(cx);
+    }
+
+    fn open_selected(&mut self, cx: &mut Cx) {
+        let Some(file) = self.doc_selected.and_then(|index| self.doc_entries.get(index)).map(|entry| entry.file.clone()) else {
+            return;
+        };
+        if self.doc.edited {
+            self.open_open = false;
+            self.put_ask(cx, Ask::KeepChanges(AfterKeep::Open(file)));
+        } else {
+            self.request_read(cx, file);
+        }
+    }
+
+    // -- the alert -----------------------------------------------------------
+
+    fn put_ask(&mut self, cx: &mut Cx, ask: Ask) {
+        self.ask = Some(ask);
+        self.settle_focus();
+        self.paint_overlays(cx);
+    }
+
+    fn ask_cancel(&mut self, cx: &mut Cx) {
+        if self.ask.take().is_some() && !self.save_open {
+            self.after_save = None;
+        }
+        self.settle_focus();
+        self.paint_overlays(cx);
+    }
+
+    /// Return, and the blue button.
+    fn ask_default(&mut self, cx: &mut Cx) {
+        match self.ask.take() {
+            Some(Ask::KeepChanges(after)) => {
+                self.after_save = Some(after);
+                self.settle_focus();
+                self.paint_overlays(cx);
+                self.save_command(cx);
+            }
+            Some(Ask::SaveFailed { job, .. }) => self.start_write(cx, job),
+            // A question about losing something: its default keeps it. A file that
+            // can't be opened has nothing to choose: a retry can't mend it.
+            Some(Ask::OpenFailed { .. }) | Some(Ask::DeleteSheet(_)) | Some(Ask::Replace(_)) | None => {
+                self.settle_focus();
+                self.paint_overlays(cx);
+            }
+        }
+    }
+
+    /// Don't Save.
+    fn ask_let_go(&mut self, cx: &mut Cx) {
+        if let Some(Ask::KeepChanges(after)) = self.ask.take() {
+            self.settle_focus();
+            self.paint_overlays(cx);
+            self.run_after(cx, after);
+        }
+    }
+
+    /// Delete, Replace.
+    fn ask_destroy(&mut self, cx: &mut Cx) {
+        match self.ask.take() {
+            Some(Ask::DeleteSheet(index)) => {
+                self.wb.remove_sheet(index);
+                self.widths_applied = false;
+                self.note("Sheet removed".into());
+                self.settle_focus();
+                self.paint_overlays(cx);
+                self.after_model_change(cx);
+            }
+            Some(Ask::Replace(job)) => self.start_write(cx, job),
+            _ => {
+                self.settle_focus();
+                self.paint_overlays(cx);
+            }
+        }
+    }
+
+    // -- what is up over the window ------------------------------------------
+
+    fn sheet_up(&self) -> bool {
+        self.save_open || self.open_open || self.ask.is_some()
+    }
+
+    fn menu_up(&self) -> bool {
+        !self.menu.is_empty() || self.tab_menu.is_some() || self.cell_menu
+    }
+
+    fn overlay_up(&self) -> bool {
+        self.sheet_up() || self.menu_up() || self.rename.is_some()
+    }
+
+    /// The keyboard goes to what is on top: nothing behind a sheet takes it.
+    fn settle_focus(&mut self) {
+        self.focus_wanted = Some(if self.ask.is_some() || self.open_open {
+            Focus::Nobody
+        } else if self.save_open {
+            Focus::SaveName { select: false }
+        } else {
+            Focus::Grid
+        });
+    }
+
+    fn apply_focus(&mut self, cx: &mut Cx) {
+        match self.focus_wanted.take() {
+            None => {}
+            Some(Focus::Nobody) => cx.set_key_focus(Area::Empty),
+            Some(Focus::Grid) => {
+                let area = self.grid_area(cx);
+                cx.set_key_focus(area);
+            }
+            Some(Focus::SaveName { select }) => self.focus_field(cx, ids!(save_name), select),
+            Some(Focus::Rename) => self.focus_field(cx, ids!(rename_box), true),
+        }
+    }
+
+    fn focus_field(&mut self, cx: &mut Cx, id: &[LiveId], select: bool) {
+        let field = self.view.text_input(cx, id);
+        if select {
+            if let Some(mut inner) = field.borrow_mut() {
+                inner.select_all(cx);
+            }
+        }
+        field.take_key_focus(cx);
+    }
+
+    fn has_focus(&self, cx: &mut Cx, id: &[LiveId]) -> bool {
+        let area = self.view.widget(cx, id).area();
+        !area.is_empty() && cx.has_key_focus(area)
+    }
+
+    /// The window as the toolbar and the status bar see it: an overlay's
+    /// padding is measured from the same corner.
+    fn window_rect(&self, cx: &mut Cx) -> Rect {
+        let top = self.view.widget(cx, ids!(toolbar)).area().rect(cx);
+        let bottom = self.view.widget(cx, ids!(statusbar)).area().rect(cx);
+        Rect {
+            pos: top.pos,
+            size: dvec2(top.size.x, (bottom.pos.y + bottom.size.y - top.pos.y).max(0.0)),
+        }
+    }
+
+    /// Everything over the window follows from the state, also after a new
+    /// look brought its parts back hidden.
+    fn paint_overlays(&mut self, cx: &mut Cx) {
+        if !self.desk {
+            return;
+        }
+        let sheet = self.sheet_up();
+        let asking = self.ask.is_some();
+        for (id, on) in [
+            (ids!(sheet_scrim), sheet),
+            (ids!(band_guard), sheet),
+            (ids!(save_sheet), self.save_open && !asking),
+            (ids!(open_sheet), self.open_open && !asking),
+            (ids!(ask_sheet), asking),
+            (ids!(menu_layer), !self.menu.is_empty()),
+            (ids!(tab_menu_layer), self.tab_menu.is_some()),
+            (ids!(cell_menu_layer), self.cell_menu),
+            (ids!(rename_layer), self.rename.is_some()),
+        ] {
+            self.view.widget(cx, id).set_visible(cx, on);
+        }
+        self.paint_menu_rows(cx);
+        if self.save_open {
+            self.paint_save(cx);
+        }
+        if self.open_open {
+            self.paint_open(cx);
+        }
+        if asking {
+            self.paint_ask(cx);
+        }
+        self.paint_tool_states(cx);
+        self.view.redraw(cx);
+    }
+
+    /// Under a sheet the toolbar goes quiet; undo and redo say when they can act.
+    fn paint_tool_states(&mut self, cx: &mut Cx) {
+        let free = !self.sheet_up();
+        for id in [
+            ids!(new_btn),
+            ids!(open_btn),
+            ids!(save_btn),
+            ids!(bold_btn),
+            ids!(italic_btn),
+            ids!(align_l),
+            ids!(align_c),
+            ids!(align_r),
+            ids!(fx_menu),
+            ids!(more_menu),
+        ] {
+            set_tool_enabled(&self.view.widget(cx, id), cx, free);
+        }
+        let can_undo = free && self.wb.can_undo();
+        let can_redo = free && self.wb.can_redo();
+        set_tool_enabled(&self.view.widget(cx, ids!(undo_btn)), cx, can_undo);
+        set_tool_enabled(&self.view.widget(cx, ids!(redo_btn)), cx, can_redo);
+        self.view.widget(cx, ids!(fmt_menu)).set_disabled(cx, !free);
+        let room = free && self.wb.sheets.len() < MAX_TABS;
+        set_tool_enabled(&self.view.widget(cx, ids!(add_tab)), cx, room);
+    }
+
+    fn paint_save(&mut self, cx: &mut Cx) {
+        let name = self.view.text_input(cx, ids!(save_name)).text();
+        let problem = docs::name_problem(&name);
+        let hint = problem.unwrap_or("");
+        self.view.label(cx, ids!(save_hint)).set_text(cx, hint);
+        self.view.widget(cx, ids!(save_hint_line)).set_visible(cx, !hint.is_empty());
+        set_tool_enabled(&self.view.widget(cx, ids!(save_ok)), cx, problem.is_none());
+        // A Save that goes on to something else keeps this workbook: no copies.
+        let plain = self.after_save.is_none();
+        self.view.widget(cx, ids!(save_format_line)).set_visible(cx, plain);
+        self.view
+            .widget(cx, ids!(save_note_line))
+            .set_visible(cx, plain && self.save_format == DocFormat::Csv);
+    }
+
+    fn paint_open(&mut self, cx: &mut Cx) {
+        let empty = self.docs_error || self.doc_entries.is_empty();
+        let (title, note, action) = if self.docs_error {
+            (
+                "Couldn\u{2019}t Read Your Documents",
+                "The Sheets folder can\u{2019}t be opened right now.",
+                "Try Again",
+            )
+        } else {
+            ("No Documents Yet", "The workbooks you save appear here.", "Save This Workbook\u{2026}")
+        };
+        self.view.widget(cx, ids!(docs_list)).set_visible(cx, !empty);
+        self.view.widget(cx, ids!(docs_empty)).set_visible(cx, empty);
+        self.view.label(cx, ids!(docs_empty_title)).set_text(cx, title);
+        self.view.label(cx, ids!(docs_empty_note)).set_text(cx, note);
+        self.view.button(cx, ids!(docs_action)).set_text(cx, action);
+        set_tool_enabled(&self.view.widget(cx, ids!(open_ok)), cx, self.doc_selected.is_some());
+    }
+
+    fn paint_ask(&mut self, cx: &mut Cx) {
+        let Some(ask) = self.ask.clone() else {
+            return;
+        };
+        let (title, note, left, danger, second, primary) = match ask {
+            Ask::KeepChanges(_) => (
+                format!("Do you want to keep the changes you made to \u{201c}{}\u{201d}?", self.doc.title),
+                "Your changes will be lost if you don\u{2019}t save them.".to_string(),
+                "Don\u{2019}t Save",
+                "",
+                "Cancel",
+                if self.doc.file.is_some() { "Save" } else { "Save\u{2026}" },
+            ),
+            Ask::DeleteSheet(index) => (
+                format!(
+                    "Delete the sheet \u{201c}{}\u{201d}?",
+                    self.wb.sheets.get(index).map_or("", |sheet| sheet.name.as_str())
+                ),
+                "You can\u{2019}t undo this.".to_string(),
+                "",
+                "Delete",
+                "",
+                "Cancel",
+            ),
+            Ask::Replace(job) => (
+                format!("\u{201c}{}\u{201d} already exists. Do you want to replace it?", docs::title_of(&job.file)),
+                "Replacing it overwrites what it holds.".to_string(),
+                "",
+                "Replace",
+                "",
+                "Cancel",
+            ),
+            Ask::SaveFailed { job, why } => (
+                format!("Couldn\u{2019}t Save \u{201c}{}\u{201d}", docs::title_of(&job.file)),
+                why,
+                "",
+                "",
+                "Cancel",
+                "Try Again",
+            ),
+            Ask::OpenFailed { file, why } => (
+                format!(
+                    "Couldn\u{2019}t Open \u{201c}{}\u{201d}",
+                    docs::entry_for(&file, String::new()).map_or_else(|| file.clone(), |entry| entry.name)
+                ),
+                why,
+                "",
+                "",
+                "",
+                "OK",
+            ),
+        };
+        self.view.label(cx, ids!(ask_title)).set_text(cx, &title);
+        self.view.label(cx, ids!(ask_note)).set_text(cx, &note);
+        for (id, text) in [(ids!(ask_left), left), (ids!(ask_danger), danger), (ids!(ask_second), second)] {
+            self.view.widget(cx, id).set_visible(cx, !text.is_empty());
+            self.view.button(cx, id).set_text(cx, text);
+        }
+        self.view.button(cx, ids!(ask_primary)).set_text(cx, primary);
+    }
+
+    // -- menus ---------------------------------------------------------------
+
+    /// How many rows the menu that is up has that can take the hand.
+    fn menu_row_count(&self) -> usize {
+        if self.cell_menu {
+            CELL_MENU_ROWS.len()
+        } else if self.tab_menu.is_some() {
+            if self.wb.sheets.len() > 1 { 2 } else { 1 }
+        } else {
+            self.menu.len().min(MENU_ROWS.len())
+        }
+    }
+
+    fn menu_row_id(&self, index: usize) -> &'static [LiveId] {
+        if self.cell_menu {
+            CELL_MENU_ROWS[index.min(CELL_MENU_ROWS.len() - 1)]
+        } else if self.tab_menu.is_some() {
+            TAB_MENU_ROWS[index.min(TAB_MENU_ROWS.len() - 1)]
+        } else {
+            MENU_ROWS[index.min(MENU_ROWS.len() - 1)]
+        }
+    }
+
+    fn paint_menu_rows(&mut self, cx: &mut Cx) {
+        if !self.menu_up() {
+            return;
+        }
+        let c = theme::colors(cx);
+        let white = vec4(1.0, 1.0, 1.0, 1.0);
+        let format = self.wb.sheet().format(self.active(cx));
+        if self.cell_menu {
+            for (index, id) in CELL_MENU_ROWS.iter().enumerate() {
+                self.paint_menu_row(cx, id, self.menu_focus == Some(index), false, true, &c, white);
+            }
+            return;
+        }
+        if self.tab_menu.is_some() {
+            let can_delete = self.wb.sheets.len() > 1;
+            set_tool_enabled(&self.view.widget(cx, ids!(del_tab)), cx, can_delete);
+            for (index, id) in TAB_MENU_ROWS.iter().enumerate() {
+                let enabled = index == 0 || can_delete;
+                self.paint_menu_row(cx, id, self.menu_focus == Some(index), false, enabled, &c, white);
+            }
+            return;
+        }
+        for index in 0..MENU_ROWS.len() {
+            let row = self.view.widget(cx, MENU_ROWS[index]);
+            let gap = self.view.widget(cx, MENU_GAPS[index]);
+            let Some(choice) = self.menu.get(index).copied() else {
+                row.set_visible(cx, false);
+                gap.set_visible(cx, false);
+                continue;
+            };
+            row.set_visible(cx, true);
+            self.view.button(cx, MENU_ROWS[index]).set_text(cx, choice.label());
+            let previous = index.checked_sub(1).and_then(|before| self.menu.get(before).copied());
+            gap.set_visible(cx, choice.starts_group(index, previous));
+            self.paint_menu_row(cx, MENU_ROWS[index], self.menu_focus == Some(index), choice.is_on(&format), true, &c, white);
+        }
+    }
+
+    /// A row in hand is blue, whether the pointer or the keyboard has it.
+    fn paint_menu_row(&mut self, cx: &mut Cx, id: &[LiveId], focused: bool, checked: bool, enabled: bool, c: &theme::Colors, white: Vec4f) {
+        let (face, ink) = if focused { (c.primary, white) } else { (Vec4f::default(), if enabled { c.ink } else { c.muted }) };
+        let mut row = self.view.widget(cx, id);
+        // Every state says the same: a row hidden under the pointer keeps its
+        // button's hover, and would come back blue when the menu next opens.
+        script_apply_eval!(cx, row, {
+            draw_bg +: {color: #(face) color_hover: #(face) color_down: #(face)}
+            draw_text +: {color: #(ink) color_hover: #(ink) color_down: #(ink) color_focus: #(ink)}
+        });
+        if let Some(mut button) = row.as_button().borrow_mut() {
+            button.draw_icon.color = ink;
+            button.draw_icon.opacity = if checked { 1.0 } else { 0.0 };
+        }
+        row.redraw(cx);
+    }
+
+    pub fn close_menus(&mut self, cx: &mut Cx) {
+        if !self.menu_up() {
+            return;
+        }
+        self.menu.clear();
+        self.tab_menu = None;
+        self.cell_menu = false;
+        self.menu_focus = None;
+        self.paint_overlays(cx);
+    }
+
+    fn open_menu(&mut self, cx: &mut Cx, anchor: &[LiveId], choices: Vec<MenuChoice>) {
+        let window = self.window_rect(cx);
+        let at = self.view.widget(cx, anchor).area().rect(cx);
+        let gaps = choices
+            .iter()
+            .enumerate()
+            .filter(|(index, choice)| choice.starts_group(*index, index.checked_sub(1).and_then(|before| choices.get(before).copied())))
+            .count();
+        let height = choices.len() as f64 * MENU_ROW_HEIGHT + gaps as f64 * MENU_GAP_HEIGHT + MENU_PADDING * 2.0;
+        let left = (at.pos.x - window.pos.x).min(window.size.x - MENU_WIDTH - 8.0).max(8.0);
+        let top = (at.pos.y + at.size.y + 2.0 - window.pos.y).min(window.size.y - height - 8.0).max(8.0);
+        let mut layer = self.view.widget(cx, ids!(menu_layer));
+        script_apply_eval!(cx, layer, {
+            padding.left: #(left)
+            padding.top: #(top)
+        });
+        self.menu = choices;
+        self.menu_focus = None;
+        self.paint_overlays(cx);
+    }
+
+    fn open_function_menu(&mut self, cx: &mut Cx) {
+        let choices = (0..FUNCTIONS.len().min(MENU_ROWS.len())).map(MenuChoice::Function).collect();
+        self.open_menu(cx, ids!(fx_menu), choices);
+    }
+
+    /// What the toolbar has no room for.
+    fn open_more_menu(&mut self, cx: &mut Cx) {
+        let mut choices = vec![
+            MenuChoice::Align(HAlign::Left),
+            MenuChoice::Align(HAlign::Center),
+            MenuChoice::Align(HAlign::Right),
+        ];
+        if self.tool_level == Some(2) {
+            choices.extend(NUM_FORMATS.iter().map(|num| MenuChoice::Number(*num)));
+        }
+        self.open_menu(cx, ids!(more_menu), choices);
+    }
+
+    fn open_tab_menu(&mut self, cx: &mut Cx, index: usize, at: Vec2d) {
+        let window = self.window_rect(cx);
+        let strip = self.view.widget(cx, ids!(tabbar)).area().rect(cx);
+        let height = TAB_MENU_ROWS.len() as f64 * MENU_ROW_HEIGHT + MENU_PADDING * 2.0;
+        let left = (at.x - window.pos.x).min(window.size.x - MENU_WIDTH - 8.0).max(8.0);
+        let top = (strip.pos.y - window.pos.y - height - 2.0).max(8.0);
+        let mut layer = self.view.widget(cx, ids!(tab_menu_layer));
+        script_apply_eval!(cx, layer, {
+            padding.left: #(left)
+            padding.top: #(top)
+        });
+        self.tab_menu = Some(index);
+        self.menu_focus = None;
+        self.paint_overlays(cx);
+    }
+
+    /// A right press on a cell. The cell becomes the selection, unless it is in it.
+    fn open_cell_menu(&mut self, cx: &mut Cx, pos: Pos, at: Vec2d) {
+        let ((r0, c0), (r1, c1)) = self.selection_rect(cx);
+        if !(r0..=r1).contains(&pos.0) || !(c0..=c1).contains(&pos.1) {
+            self.grid(cx).set_selection(cx, Some(GridSelection::single(pos.0, pos.1)));
+            self.sync_chrome(cx);
+        }
+        let area = self.grid_area(cx);
+        cx.set_key_focus(area);
+        let window = self.window_rect(cx);
+        let height = CELL_MENU_ROWS.len() as f64 * MENU_ROW_HEIGHT + MENU_GAP_HEIGHT + MENU_PADDING * 2.0;
+        let left = (at.x - window.pos.x).min(window.size.x - MENU_WIDTH - 8.0).max(8.0);
+        let top = (at.y - window.pos.y).min(window.size.y - height - 8.0).max(8.0);
+        let mut layer = self.view.widget(cx, ids!(cell_menu_layer));
+        script_apply_eval!(cx, layer, {
+            padding.left: #(left)
+            padding.top: #(top)
+        });
+        self.cell_menu = true;
+        self.menu_focus = None;
