+impl KeyButtons {
+    /// Whether this key is still unanswered. A view hands an event to what it drew last
+    /// first, so the frontmost sheet hears a key before the one under it.
+    fn answer(cx: &mut Cx) -> bool {
+        let event = cx.event_id();
+        let buttons = cx.global::<KeyButtons>();
+        if buttons.covered || buttons.hidden > 0 || buttons.answered == event {
+            return false;
+        }
+        buttons.answered = event;
+        true
+    }
