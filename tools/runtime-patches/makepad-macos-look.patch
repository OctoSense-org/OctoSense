+/// A pointer's toolbar at a window width: the segmented control's width, whether
+/// it stays in the middle, and whether the tools beside it have lost their room.
+fn pointer_toolbar(window: f64, lead: f64) -> (f64, bool, bool) {
+    /// The two tools at the toolbar's end, with their margins.
+    const TOOLS: f64 = 76.0;
+    let width = (window - 2.0 * TOOLS).clamp(300.0, 360.0).min((window - lead - TOOLS - 10.0).max(300.0));
+    let centred = (window - width) * 0.5 >= lead.max(TOOLS);
+    (width, centred, !centred && window - width - lead < TOOLS)
+}
