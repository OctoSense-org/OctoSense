+    /// A page on its way: the blue line along the field's lower edge. The engine does not say how
+    /// far along it is, so the line says the page is coming and slows as it goes.
+    fn follow_load_line(&mut self, cx: &mut Cx, loading: bool) {
+        match (loading, self.load_line_since) {
+            (true, None) => {
+                self.load_line_since = Some(Cx::monotonic_now());
+                self.ui.widget(cx, ids!(load_line)).set_visible(cx, true);
+                self.step_load_line(cx);
+            }
+            (false, Some(_)) => {
+                self.load_line_since = None;
+                cx.stop_timer(self.load_line_timer);
+                self.ui.widget(cx, ids!(load_line)).set_visible(cx, false);
+            }
+            _ => {}
+        }
+    }
+
+    fn step_load_line(&mut self, cx: &mut Cx) {
+        let Some(since) = self.load_line_since else {
+            return;
+        };
+        let spent = Cx::monotonic_now() - since;
+        let along = (0.08 + 0.92 * (1.0 - (-spent / 3.0).exp())).min(0.92);
+        let room = (self.ui.widget(cx, ids!(omnibox_frame)).area().rect(cx).size.x - 6.0).max(0.0);
+        let width = room * along;
+        let mut fill = self.ui.widget(cx, ids!(load_fill));
+        script_apply_eval!(cx, fill, {
+            width: #(width)
+        });
+        self.ui.widget(cx, ids!(load_line)).redraw(cx);
+        self.load_line_timer = cx.start_timeout(LOAD_LINE_STEP_SECONDS);
+    }
