+    fn paint_tools(&mut self, cx: &mut Cx) {
+        let has_chat = self.engine.as_ref().is_some_and(|e| !e.state().entries.is_empty());
+        let has_text = !self.view.text_input(cx, ids!(input)).text().trim().is_empty();
+        let working = self.engine.as_ref().is_some_and(|e| self.working(e.state()));
+        let tools = Some((has_chat, has_text, working));
+        if self.tools == tools {
+            return;
+        }
+        self.tools = tools;
+        set_enabled(&self.view.widget(cx, ids!(clear_button)), cx, has_chat);
+        set_enabled(&self.view.widget(cx, ids!(clear_glyph)), cx, has_chat);
+        set_enabled(&self.view.widget(cx, ids!(send_button)), cx, has_text);
+        self.view.widget(cx, ids!(send_button)).set_visible(cx, !working);
+        self.view.widget(cx, ids!(stop_button)).set_visible(cx, working);
         self.view.redraw(cx);
     }
 
+    /// Which line of the conversation a point lies on, as the list last drew it.
+    fn entry_at(&self, cx: &Cx, abs: DVec2) -> Option<usize> {
+        let rect = self.view.widget(cx, ids!(transcript)).area().rect(cx);
+        if !rect.contains(abs) {
+            return None;
+        }
+        let along = abs.y - rect.pos.y;
+        let list = self.view.portal_list(cx, ids!(transcript));
+        let state = self.engine.as_ref()?.state();
+        (0..state.entries.len()).find(|index| {
+            !self.replaced.contains(index)
+                && !plain::repeated_failure(state, *index)
+                && list.drawn_slot(*index).is_some_and(|slot| along >= slot.start && along < slot.start + slot.size)
