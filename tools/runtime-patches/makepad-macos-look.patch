 impl App {
+    fn with_viewer(&self, cx: &mut Cx, f: impl FnOnce(&mut MpImageView, &mut Cx)) {
+        let widget = self.ui.widget(cx, ids!(viewer));
+        let Some(mut viewer) = widget.borrow_mut::<MpImageView>() else {
+            return;
+        };
+        f(&mut viewer, cx);
+        drop(viewer);
+    }
+
+    /// Show `path` in this window.
+    fn open_path(&mut self, cx: &mut Cx, path: PathBuf) {
+        self.preview = PreviewState::new(self.preview.is_preview(), Some(&path));
+        self.name = file_name(Some(&path));
+        self.failed = false;
+        self.size = (0, 0);
+        self.with_viewer(cx, |viewer, cx| viewer.open(cx, &path));
+        self.set_title(cx);
+        self.update_chrome(cx);
+    }
+
+    /// Open..., Command-O and the empty window's button. Hosted on a desktop
+    /// the shell puts up a Mac's own panel, and elsewhere the app's own sheet
+    /// asks (the studio runtime drops the panel there). A phone's window
+    /// manager opens a file in this app from Files. Standalone the platform's
+    /// own panel asks.
+    fn open_action(&mut self, cx: &mut Cx) {
+        let on_a_desk = self.desk && makepad_wm_api::hosted(cx);
+        if on_a_desk && open_panel::sheet_instead() {
+            self.put_up_sheet(cx);
+            return;
+        }
+        let files = makepad_wm_api::WmRequest::Launch { app: "files".to_string(), args: Vec::new() };
+        if !on_a_desk && makepad_wm_api::send(cx, &files) {
+            return;
+        }
+        let extensions = EXTENSIONS.map(String::from).to_vec();
+        let mut dialog = FileDialog::new()
+            .set_id(live_id!(open_image))
+            .set_title("Open Image".to_string())
+            .add_filter("Images".to_string(), extensions);
+        // From what's showing. With nothing showing the panel knows where it was.
+        let widget = self.ui.widget(cx, ids!(viewer));
+        let showing = widget.borrow::<MpImageView>().and_then(|viewer| viewer.current_path().map(Path::to_path_buf));
+        if let Some(folder) = showing.as_deref().and_then(Path::parent).filter(|folder| folder.is_dir()) {
+            dialog = dialog.set_location(folder.to_path_buf());
+        }
+        cx.open_select_file_dialog(dialog);
+    }
+
+    fn put_up_sheet(&mut self, cx: &mut Cx) {
+        let sheet = self.ui.widget(cx, ids!(open_sheet)).as_mp_open_sheet();
+        if sheet.is_open() {
+            return;
+        }
+        let home = self.open_home.clone().unwrap_or_else(open_panel::home_folder);
+        let widget = self.ui.widget(cx, ids!(viewer));
+        let showing = widget.borrow::<MpImageView>().and_then(|viewer| viewer.current_path().map(Path::to_path_buf));
+        let start = showing
+            .as_deref()
+            .and_then(Path::parent)
+            .filter(|folder| folder.is_dir())
+            .map(Path::to_path_buf)
+            .or_else(|| self.last_folder.clone())
+            .unwrap_or_else(|| {
+                let pictures = home.join("Pictures");
+                if pictures.is_dir() { pictures } else { home.clone() }
+            });
+        sheet.present(cx, &home, &start, &EXTENSIONS, "images");
+        self.with_viewer(cx, |viewer, _| viewer.set_inert(true));
+        self.ui.widget(cx, ids!(thumbs)).as_mp_image_thumbs().set_inert(true);
+        self.update_chrome(cx);
+    }
+
+    /// The sidebar is for a picture in a window, on a Mac's sheet.
+    fn can_show_thumbs(&self) -> bool {
+        self.desk && self.unified && !self.preview.is_preview() && !self.name.is_empty()
+    }
+
+    fn toggle_thumbs(&mut self, cx: &mut Cx) {
+        self.thumbs_open = !self.thumbs_open;
