+#[cfg(test)]
+mod nav_routes_tests {
+    use super::*;
+
+    #[test]
+    fn a_route_list_keeps_each_alternative_with_its_steps() {
+        let body = br#"{"routes":[
+            {"geometry":"abc","distance":1000.0,"duration":120.0,"legs":[{"summary":"Main St","steps":[
+                {"name":"Main St","distance":400.0,"maneuver":{"type":"depart","location":[-121.9,37.3]}},
+                {"name":"","ref":"I 280","distance":600.0,"maneuver":{"type":"turn","modifier":"slight left","location":[-121.8,37.4]}},
+                {"name":"","distance":0.0,"maneuver":{"type":"arrive","location":[-121.7,37.5]}}]}]},
+            {"geometry":"def","distance":1500.0,"duration":180.0,"legs":[{"summary":"","steps":[
+                {"name":"First St","distance":1500.0,"maneuver":{"type":"roundabout","exit":2,"modifier":"right","location":[-121.6,37.2]}}]}]},
+            {"distance":1.0,"legs":[]}
+        ]}"#;
+        let routes: serde_json::Value = serde_json::from_str(&nav_routes_json(body).unwrap()).unwrap();
+        let routes = routes.as_array().unwrap();
+        assert_eq!(routes.len(), 2, "a route with no line is left out");
+        assert_eq!(routes[0]["min"], 2.0);
+        assert_eq!(routes[0]["m"], 1000.0);
+        assert_eq!(routes[0]["via"], "Main St");
+        assert_eq!(routes[0]["polyline"], "abc");
+        let steps = routes[0]["steps"].as_array().unwrap();
+        assert_eq!(steps[0]["instr"], "Start on Main St");
+        assert_eq!(steps[1]["instr"], "Bear left onto I 280");
+        assert_eq!(steps[1]["lat"], 37.4);
+        assert_eq!(steps[1]["lon"], -121.8);
+        assert_eq!(steps[1]["modifier"], "slight left");
+        assert_eq!(steps[2]["kind"], "arrive");
+        assert_eq!(routes[1]["steps"][0]["instr"], "At the roundabout, take exit 2 onto First St");
+    }
+
+    #[test]
+    fn a_route_list_says_nothing_for_an_answer_with_no_route() {
+        assert_eq!(nav_routes_json(br#"{"code":"NoRoute","routes":[]}"#), None);
+        assert_eq!(nav_routes_json(br#"{"code":"Ok"}"#), None);
+        assert_eq!(nav_routes_json(b"<html>busy</html>"), None);
+    }
+
+    #[test]
+    fn a_written_step_reads_the_way_a_person_says_it() {
+        assert_eq!(nav_list_step("turn", "left", "Oak St", None), "Turn left onto Oak St");
+        assert_eq!(nav_list_step("turn", "right", "", None), "Turn right");
+        assert_eq!(nav_list_step("turn", "sharp right", "Oak St", None), "Turn sharply right onto Oak St");
+        assert_eq!(nav_list_step("continue", "uturn", "Oak St", None), "Make a U-turn onto Oak St");
+        assert_eq!(nav_list_step("turn", "straight", "Oak St", None), "Continue onto Oak St");
+        assert_eq!(nav_list_step("new name", "", "Oak St", None), "Continue onto Oak St");
+        assert_eq!(nav_list_step("fork", "slight right", "I 5", None), "Keep right at the fork onto I 5");
+        assert_eq!(nav_list_step("on ramp", "right", "US 101", None), "Take the ramp onto US 101");
+        assert_eq!(nav_list_step("exit roundabout", "right", "Oak St", None), "Exit the roundabout onto Oak St");
+    }
+}
