+    /// The window's arrangement on a desktop, for the room the page has: the
+    /// sidebar, the 84 points a toolbar leaves the lights when nothing else
+    /// is under them, and what the toolbar can afford beside its title.
+    fn sync_desk_window(&mut self, cx: &mut Cx, content_width: f64) {
+        let shown = self.sidebar_shown();
+        let lead = if self.roles.unified && !shown { 84.0 } else { 14.0 };
+        let segments_fit = content_width - lead >= 560.0;
+        let search_width = if content_width >= 760.0 {
+            200.0
+        } else if content_width >= 600.0 {
+            150.0
+        } else {
+            110.0
+        };
+        let budget_wide = content_width >= 560.0;
+        let key = (shown, segments_fit, search_width as u32, budget_wide);
+        if self.desk_bar == Some(key) {
+            return;
+        }
+        self.desk_bar = Some(key);
+        self.segments_fit = segments_fit;
+        self.budget_wide = budget_wide;
+        self.view(cx, ids!(sidebar)).set_visible(cx, shown);
+        self.widget(cx, ids!(sidebar_show)).set_visible(cx, !self.roles.unified || !shown);
+        // A tool hidden under the pointer never hears it leave.
+        self.button(cx, ids!(sidebar_hide)).reset_hover(cx);
+        self.button(cx, ids!(sidebar_show)).reset_hover(cx);
+        let mut bar = self.view(cx, ids!(topbar));
+        script_apply_eval!(cx, bar, { padding.left: #(lead) });
+        let mut search = self.view(cx, ids!(search_box));
+        script_apply_eval!(cx, search, { width: #(search_width) });
+        self.chrome_synced = false;
+    }
+
+    /// Push every value the chrome shows. Cheap enough to run whenever
+    /// something changed, rather than tracking what.
+    fn sync_chrome(&mut self, cx: &mut Cx) {
+        let currency = self.currency();
+        let today = self.today;
+        let range = self.range();
+        let roles = self.roles;
+
+        self.label(cx, ids!(screen_title)).set_text(cx, self.screen.title());
+        for (screen, id) in Screen::ALL.iter().zip([
+            ids!(nav_overview),
+            ids!(nav_ledger),
+            ids!(nav_budget),
+            ids!(nav_reports),
+            ids!(nav_import),
+        ]) {
+            let mut active = *screen == self.screen;
+            let mut item = self.button(cx, id);
+            if roles.desk {
+                // One selection in a source list: an account filtering the
+                // register is the selected row instead of Transactions.
+                active = active && !(*screen == Screen::Ledger && self.account_filter.is_some());
+                let color = if active { roles.selected } else { Vec4f::default() };
+                script_apply_eval!(cx, item, {
+                    draw_bg +: { color: #(color) color_hover: #(color) color_focus: #(color) }
+                });
+            } else {
+                let color = if active { roles.fg } else { roles.dim };
+                let bg = if active { roles.selected } else { Vec4f::default() };
+                script_apply_eval!(cx, item, {
+                    draw_bg +: { color: #(bg) }
+                    draw_text +: { color: #(color) }
+                });
+            }
+        }
+        if roles.desk {
+            self.sync_desk_toolbar(cx);
+        }
+
+        let worth = self.ledger.net_worth_on(today);
+        self.label(cx, ids!(net_worth_value))
+            .set_text(cx, &format_money(worth, currency));
+
+        // Overview numbers.
+        let flow = report::flow(&self.ledger, range);
+        let saved = if flow.income > 0 {
+            format!("{:.0}%", flow.net() as f64 / flow.income as f64 * 100.0)
+        } else {
+            "—".to_string()
+        };
+        for (id, label, value, note) in [
+            (ids!(stat_in), "Money in", format_money(flow.income, currency), self.range.label()),
+            (ids!(stat_out), "Money out", format_money(flow.expense, currency), self.range.label()),
+            (ids!(stat_net), "Net", format_money(flow.net(), currency), self.range.label()),
+            (
+                ids!(stat_saved),
+                if roles.desk { "Saved" } else { "Kept" },
+                saved.clone(),
+                if roles.desk { "of income" } else { "of what came in" },
+            ),
+        ] {
+            let card = self.view(cx, id);
+            card.label(cx, ids!(stat_label)).set_text(cx, label);
+            card.label(cx, ids!(stat_value)).set_text(cx, &value);
+            card.label(cx, ids!(stat_note)).set_text(cx, note);
+        }
+        if roles.desk {
+            let color = if flow.net() < 0 { roles.down } else { roles.fg };
+            let mut net = self.view(cx, ids!(stat_net)).label(cx, ids!(stat_value));
+            script_apply_eval!(cx, net, { draw_text +: { color: #(color) } });
+        }
+
+        // Net worth chart: 24 months of ends-of-month.
+        let series = report::net_worth_series(&self.ledger, 24, today);
+        let major = currency.decimals as i32;
+        let scale = 10f64.powi(major);
+        let values: Vec<f64> = series.iter().map(|(_, v)| *v as f64 / scale).collect();
+        if roles.desk {
+            self.sync_desk_worth(cx);
+        } else {
+        let high = values.iter().cloned().fold(f64::MIN, f64::max);
+        let low = values.iter().cloned().fold(f64::MAX, f64::min);
+        let marks = vec![
+            (high, format_compact((high * scale) as i64, currency)),
+            (low, format_compact((low * scale) as i64, currency)),
+            (0.0, format_compact(0, currency)),
+        ];
+        self.finance_chart(cx, ids!(worth_chart)).set_area(cx, &values, marks);
+        if let (Some(first), Some(last)) = (series.first(), series.last()) {
+            let change = last.1 - first.1;
+            self.label(cx, ids!(worth_sub)).set_text(
+                cx,
+                &format!(
+                    "{} over 24 months",
+                    if change >= 0 {
+                        format!("up {}", format_money(change, currency))
+                    } else {
+                        format!("down {}", format_money(-change, currency))
+                    }
+                ),
+            );
+        }
+        }
+
+        // Where the money went.
+        let spending = report::spending_by_group(&self.ledger, range);
+        let biggest = spending.first().map(|(_, v)| *v).unwrap_or(1).max(1);
+        for (slot, id) in [
+            ids!(cat_0),
+            ids!(cat_1),
+            ids!(cat_2),
+            ids!(cat_3),
+            ids!(cat_4),
+            ids!(cat_5),
+            ids!(cat_6),
+            ids!(cat_7),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let row = self.widget(cx, id);
+            match spending.get(slot) {
+                Some((category, amount)) => {
+                    row.set_visible(cx, true);
+                    let name = category
+                        .map(|c| self.ledger.categories.name(c).to_string())
+                        .unwrap_or_else(|| "Uncategorized".to_string());
+                    row.label(cx, ids!(bar_label)).set_text(cx, &name);
+                    row.label(cx, ids!(bar_value))
+                        .set_text(cx, &format_money(*amount, currency));
+                    let fraction = (*amount as f64 / biggest as f64).clamp(0.0, 1.0);
+                    set_bar(cx, &row, fraction, None);
+                }
+                None => row.set_visible(cx, false),
+            }
+        }
+        self.widget(cx, ids!(spend_none)).set_visible(cx, spending.is_empty());
+
+        // Coming up.
+        // A desktop lists dates from today on; a phone keeps the schedule's own.
+        let upcoming: Vec<(Day, &Scheduled)> = if roles.desk {
+            report::coming_up(&self.ledger, 30, today)
+        } else {
+            report::upcoming(&self.ledger, 30, today).into_iter().map(|item| (item.next_due, item)).collect()
+        };
+        self.widget(cx, ids!(due_none)).set_visible(cx, upcoming.is_empty());
+        for (slot, (row_id, name_id, date_id, amount_id)) in [
+            (ids!(due_0), ids!(due_name_0), ids!(due_date_0), ids!(due_amount_0)),
+            (ids!(due_1), ids!(due_name_1), ids!(due_date_1), ids!(due_amount_1)),
+            (ids!(due_2), ids!(due_name_2), ids!(due_date_2), ids!(due_amount_2)),
+            (ids!(due_3), ids!(due_name_3), ids!(due_date_3), ids!(due_amount_3)),
+            (ids!(due_4), ids!(due_name_4), ids!(due_date_4), ids!(due_amount_4)),
+            (ids!(due_5), ids!(due_name_5), ids!(due_date_5), ids!(due_amount_5)),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let row = self.view(cx, row_id);
+            match upcoming.get(slot) {
+                Some((due, item)) => {
+                    row.set_visible(cx, true);
+                    if roles.desk {
+                        self.label(cx, name_id).set_text(cx, &item.payee);
+                        self.label(cx, date_id).set_text(cx, &self.date_text(*due));
+                    } else {
+                        self.label(cx, name_id).set_text(
+                            cx,
+                            &format!("{}  ·  {}", item.payee, date::format_short(*due)),
+                        );
+                    }
+                    let mut amount = self.label(cx, amount_id);
+                    amount.set_text(cx, &format_money(item.amount, currency));
+                    // A desktop keeps red for what went wrong: a bill is just due.
+                    let color = if item.amount >= 0 {
+                        roles.up
+                    } else if roles.desk {
+                        roles.fg
+                    } else {
+                        roles.down
+                    };
+                    script_apply_eval!(cx, amount, {
+                        draw_text +: { color: #(color) }
+                    });
+                }
+                None => row.set_visible(cx, false),
+            }
+        }
+
+        // Reports.
+        let months = report::monthly_flow(&self.ledger, 18, today);
+        let income: Vec<f64> = months.iter().map(|(_, f)| f.income as f64 / scale).collect();
+        let spend: Vec<f64> = months.iter().map(|(_, f)| -(f.expense as f64) / scale).collect();
+        let labels: Vec<String> = months
+            .iter()
+            .map(|(key, _)| date::format_month(*key).split(' ').next().unwrap_or("").to_string())
+            .collect();
+        let flow = self.finance_chart(cx, ids!(flow_chart));
+        flow.set_currency(cx, currency);
+        flow.set_bars(cx, &income, &spend, labels);
+        let average: i64 = if months.is_empty() {
+            0
+        } else {
+            months.iter().map(|(_, f)| f.expense).sum::<i64>() / months.len() as i64
+        };
+        self.label(cx, ids!(flow_sub)).set_text(
+            cx,
+            &if roles.desk {
+                format!("Last {} months · average spending {} a month", months.len(), format_money(average, currency))
+            } else {
+                format!("Monthly net over 24 months · average spend {}", format_money(average, currency))
+            },
+        );
+
+        let payees = report::top_payees(&self.ledger, range, 8);
+        if roles.desk {
+            self.label(cx, ids!(payee_title)).set_text(cx, "Biggest payees");
+            let at = Range::ALL.iter().position(|range| *range == self.range).unwrap_or(0);
+            self.drop_down(cx, ids!(payee_range)).set_selected_item(cx, at);
+            self.widget(cx, ids!(payee_none)).set_visible(cx, payees.is_empty());
+        }
+        let biggest = payees.first().map(|(_, v, _)| *v).unwrap_or(1).max(1);
+        for (slot, id) in [
+            ids!(pay_0),
+            ids!(pay_1),
+            ids!(pay_2),
+            ids!(pay_3),
+            ids!(pay_4),
+            ids!(pay_5),
+            ids!(pay_6),
+            ids!(pay_7),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let row = self.widget(cx, id);
+            match payees.get(slot) {
+                Some((payee, amount, count)) => {
+                    row.set_visible(cx, true);
+                    row.label(cx, ids!(bar_label)).set_text(
+                        cx,
+                        &if roles.desk { payee.clone() } else { format!("{payee}  ({count})") },
+                    );
+                    row.label(cx, ids!(bar_value))
+                        .set_text(cx, &format_money(*amount, currency));
+                    let fraction = (*amount as f64 / biggest as f64).clamp(0.0, 1.0);
+                    set_bar(cx, &row, fraction, None);
+                }
+                None => row.set_visible(cx, false),
+            }
+        }
+
+        let subs = report::detected_subscriptions(&self.ledger, today);
+        let monthly: i64 = subs
+            .iter()
+            .filter(|(_, _, r, _)| *r == Recurrence::Monthly)
+            .map(|(_, amount, _, _)| -amount)
+            .sum();
+        let list = subs
+            .iter()
+            .take(8)
+            .map(|(payee, amount, recurrence, due)| {
+                format!(
+                    "{payee} — {} {} · next {}",
+                    format_money(*amount, currency),
+                    recurrence.label().to_lowercase(),
+                    date::format_short(*due)
+                )
+            })
+            .collect::<Vec<_>>()
+            .join("\n");
+        self.label(cx, ids!(subs_body)).set_text(
+            cx,
+            &format!(
+                "{} recurring charges found, {} a month\n\n{list}",
+                subs.len(),
+                format_money(monthly, currency)
+            ),
+        );
+
+        // A desktop lists them as rows, name, cadence and amount in columns.
+        self.label(cx, ids!(subs_head)).set_text(
+            cx,
+            &if !roles.desk {
+                format!("{} recurring charges found, {} a month", subs.len(), format_money(monthly, currency))
+            } else if subs.len() > 8 {
+                format!("{} charges, {} a month. The 8 largest are shown.", subs.len(), format_money(monthly, currency))
+            } else {
+                format!("{} charges, {} a month", subs.len(), format_money(monthly, currency))
+            },
+        );
+        for (slot, (row_id, name_id, note_id, amount_id)) in [
+            (ids!(sub_0), ids!(sub_name_0), ids!(sub_note_0), ids!(sub_amount_0)),
+            (ids!(sub_1), ids!(sub_name_1), ids!(sub_note_1), ids!(sub_amount_1)),
+            (ids!(sub_2), ids!(sub_name_2), ids!(sub_note_2), ids!(sub_amount_2)),
+            (ids!(sub_3), ids!(sub_name_3), ids!(sub_note_3), ids!(sub_amount_3)),
+            (ids!(sub_4), ids!(sub_name_4), ids!(sub_note_4), ids!(sub_amount_4)),
+            (ids!(sub_5), ids!(sub_name_5), ids!(sub_note_5), ids!(sub_amount_5)),
+            (ids!(sub_6), ids!(sub_name_6), ids!(sub_note_6), ids!(sub_amount_6)),
+            (ids!(sub_7), ids!(sub_name_7), ids!(sub_note_7), ids!(sub_amount_7)),
+        ]
+        .into_iter()
+        .enumerate()
+        {
+            let row = self.view(cx, row_id);
+            match subs.get(slot) {
+                Some((payee, amount, recurrence, due)) => {
+                    row.set_visible(cx, true);
+                    self.label(cx, name_id).set_text(cx, payee);
+                    self.label(cx, note_id).set_text(
+                        cx,
+                        &if roles.desk {
+                            // The line above says what they cost a month: only another rhythm needs saying.
+                            if matches!(recurrence, Recurrence::Monthly) {
+                                format!("Next {}", self.date_text(*due))
+                            } else {
+                                format!("{} · Next {}", recurrence.label(), self.date_text(*due))
+                            }
+                        } else {
+                            format!("{} · next {}", recurrence.label().to_lowercase(), date::format_short(*due))
+                        },
+                    );
+                    self.label(cx, amount_id).set_text(cx, &format_money(*amount, currency));
+                }
+                None => row.set_visible(cx, false),
+            }
+        }
+
+        // Budget header.
+        self.label(cx, ids!(budget_month))
+            .set_text(cx, &date::format_month(self.budget_month));
+        let lines = report::budget_lines(&self.ledger, self.budget_month);
+        let assigned: i64 = lines.iter().map(|(_, l)| l.assigned).sum();
+        let spent: i64 = lines.iter().map(|(_, l)| l.spent).sum();
+        let over = lines.iter().filter(|(_, l)| l.available < 0).count();
+        self.label(cx, ids!(budget_summary)).set_text(
+            cx,
+            &format!(
+                "{} assigned · {} spent · {} left{}",
+                format_money(assigned, currency),
+                format_money(spent, currency),
+                format_money(assigned - spent, currency),
+                if over > 0 { format!(" · {over} over") } else { String::new() }
+            ),
+        );
+
+        // Import.
+        let import_line = match &self.import {
+            // A desktop names the file, not its whole path, and does not shout.
+            Some(state) if roles.desk => format!(
+                "{} · {} new, {} already here, {} unreadable{}",
+                std::path::Path::new(&state.path)
+                    .file_name()
+                    .map(|name| name.to_string_lossy().into_owned())
+                    .unwrap_or_else(|| state.path.clone()),
+                state.plan.new_count(),
+                state.plan.duplicate_count(),
+                state.plan.unreadable_count(),
+                if state.ask_date_order {
+                    " · Date order is a guess: check the preview"
+                } else {
+                    ""
+                }
+            ),
+            Some(state) => format!(
+                "{} · {} new, {} already here, {} unreadable{}",
+                state.path,
+                state.plan.new_count(),
+                state.plan.duplicate_count(),
+                state.plan.unreadable_count(),
+                if state.ask_date_order {
+                    "  ·  DATE ORDER IS A GUESS — check the preview"
+                } else {
+                    ""
+                }
+            ),
+            None => self.status.clone(),
+        };
+        self.label(cx, ids!(import_status)).set_text(cx, &import_line);
+        self.widget(cx, ids!(import_apply))
+            .set_visible(cx, self.import.is_some());
+        self.widget(cx, ids!(import_cancel))
+            .set_visible(cx, self.import.is_some());
+        if roles.desk {
+            self.sync_desk_pages(cx);
+        }
+
+        self.chrome_synced = true;
+    }
+
+    /// The first and last day of the period, how net worth moved through it,
+    /// and that in words that say the same thing as the chart.
+    fn sync_desk_worth(&mut self, cx: &mut Cx) {
+        let currency = self.currency();
+        let scale = 10f64.powi(currency.decimals as i32);
+        let range = self.range();
+        // A period that runs on past today has no numbers there yet.
+        let until = DateRange { start: range.start, end: range.end.min(self.today) };
+        let series = report::net_worth_over(&self.ledger, until, 120);
+        let values: Vec<f64> = series.iter().map(|(_, v)| *v as f64 / scale).collect();
+        // The chart fits its values, as Stocks' does, and its value axis says
+        // where it stands: a month that moved shows that it moved.
+        let chart = self.finance_chart(cx, ids!(worth_chart));
+        chart.set_currency(cx, currency);
+        chart.set_area(cx, &values, Vec::new());
+        if let (Some(first), Some(last)) = (series.first(), series.last()) {
+            let ends = (self.date_text(first.0), self.date_text(last.0));
+            self.finance_chart(cx, ids!(worth_chart)).set_axis_ends(cx, Some(ends));
+            let change = last.1 - first.1;
+            let moved = if change >= 0 { "Up" } else { "Down" };
+            let period = match self.range {
+                Range::All => format!("since {}", self.date_text(first.0)),
+                Range::Month => "this month".to_string(),
+                other => format!("over {}", other.label()),
+            };
+            self.label(cx, ids!(worth_sub))
+                .set_text(cx, &format!("{moved} {} {period}", format_money(change.abs(), currency)));
+        }
+    }
+
+    /// What each page shows besides its data on a desktop: empty, failed, done.
+    fn sync_desk_pages(&mut self, cx: &mut Cx) {
+        // The file with the accounts: nothing else can be shown without it.
+        self.view(cx, ids!(db_failed)).set_visible(cx, self.db_failed);
+        if self.db_failed {
+            for screen in Screen::ALL {
+                self.view(cx, screen.view_id()).set_visible(cx, false);
+            }
+        }
+
+        let lines = report::budget_lines(&self.ledger, self.budget_month);
+        let budgeted = lines.iter().any(|(_, l)| l.assigned != 0 || l.spent != 0 || l.carried != 0);
+        self.view(cx, ids!(budget_empty)).set_visible(cx, !budgeted);
+        self.widget(cx, ids!(budget_grid_box)).set_visible(cx, budgeted);
+        self.label(cx, ids!(budget_empty_title))
+            .set_text(cx, &format!("No Budget for {}", date::format_month(self.budget_month)));
+
+        let none = self.rows.is_empty();
+        let searched = self.search.trim();
+        self.view(cx, ids!(ledger_empty)).set_visible(cx, none);
+        self.widget(cx, ids!(ledger_grid_box)).set_visible(cx, !none);
+        self.widget(cx, ids!(ledger_empty_glyph)).set_visible(cx, searched.is_empty());
+        self.widget(cx, ids!(ledger_empty_search)).set_visible(cx, !searched.is_empty());
+        self.widget(cx, ids!(ledger_empty_clear)).set_visible(cx, !searched.is_empty());
+        self.widget(cx, ids!(ledger_empty_add))
+            .set_visible(cx, searched.is_empty() && self.backend.has_import());
+        let (title, note) = if searched.is_empty() {
+            (
+                "No Transactions".to_string(),
+                "Add one by hand, or import a statement from your bank.".to_string(),
+            )
+        } else {
+            (
+                "No Results".to_string(),
+                format!("No transactions match “{searched}”. Check the spelling or try fewer words."),
+            )
+        };
+        self.label(cx, ids!(ledger_empty_text)).set_text(cx, &title);
+        self.label(cx, ids!(ledger_empty_note)).set_text(cx, &note);
+
+        // The import page is one of four things at a time.
+        let previewing = self.import.is_some();
+        let (done, failed) = match &self.import_outcome {
+            Some(ImportOutcome::Done { title, note }) if !previewing => (Some((title.clone(), note.clone())), None),
+            Some(ImportOutcome::Failed { title, note }) if !previewing => (None, Some((title.clone(), note.clone()))),
+            _ => (None, None),
+        };
+        self.view(cx, ids!(import_head)).set_visible(cx, !previewing && done.is_none() && failed.is_none());
+        self.view(cx, ids!(import_table)).set_visible(cx, previewing);
+        self.view(cx, ids!(import_done)).set_visible(cx, done.is_some());
+        self.view(cx, ids!(import_failed)).set_visible(cx, failed.is_some());
+        if let Some((title, note)) = done {
+            self.label(cx, ids!(import_done_title)).set_text(cx, &title);
+            self.label(cx, ids!(import_done_note)).set_text(cx, &note);
+        }
+        if let Some((title, note)) = failed {
+            self.label(cx, ids!(import_failed_title)).set_text(cx, &title);
+            self.label(cx, ids!(import_failed_note)).set_text(cx, &note);
+        }
+        if let Some(state) = &self.import {
+            let new = state.plan.new_count();
+            let label = match new {
+                0 => "Import".to_string(),
+                1 => "Import 1 Transaction".to_string(),
+                _ => format!("Import {} Transactions", count_text(new)),
+            };
+            let dates = state.ask_date_order;
+            let day_first = state.day_first;
+            let account = state.account;
+            self.button(cx, ids!(import_apply)).set_text(cx, &label);
+            self.set_default_enabled(cx, ids!(import_apply), new > 0);
+            self.widget(cx, ids!(import_dates_box)).set_visible(cx, dates);
+            self.drop_down(cx, ids!(import_dates)).set_selected_item(cx, if day_first { 0 } else { 1 });
+            let accounts: Vec<&Account> = self.ledger.accounts.iter().filter(|a| !a.closed).collect();
+            let names = accounts.iter().map(|a| a.name.clone()).collect();
+            let at = accounts.iter().position(|a| a.id == account).unwrap_or(0);
+            let popup = self.drop_down(cx, ids!(import_account));
+            popup.set_labels(cx, names);
+            popup.set_selected_item(cx, at);
+        }
+    }
+
+    /// A sheet's or a page's default button: blue when it can be pressed.
+    fn set_default_enabled(&mut self, cx: &mut Cx, id: &[LiveId], enabled: bool) {
+        self.button(cx, id).set_enabled(cx, enabled);
+        self.widget(cx, id).set_disabled(cx, !enabled);
+    }
+
+    /// The toolbar's parts that follow the page on a desktop: its subtitle,
+    /// the budget's month stepper, the period's segments and which segment
+    /// is on.
+    fn sync_desk_toolbar(&mut self, cx: &mut Cx) {
+        let currency = self.currency();
+        let sub = match self.screen {
+            Screen::Ledger => {
+                let count = format!(
+                    "{} transaction{}",
+                    count_text(self.rows.len()),
+                    if self.rows.len() == 1 { "" } else { "s" }
+                );
+                match self.account_filter.and_then(|id| self.ledger.account(id)) {
+                    Some(account) => {
+                        // The source list's selection names the page.
+                        let name = account.name.clone();
+                        let line = format!("{} · {} · {count}", account.kind.label(), account.institution);
+                        self.label(cx, ids!(screen_title)).set_text(cx, &name);
+                        line
+                    }
+                    None => count,
+                }
+            }
+            Screen::Import => match &self.import {
+                Some(state) => {
+                    let name = std::path::Path::new(&state.path)
+                        .file_name()
+                        .map(|name| name.to_string_lossy().into_owned())
+                        .unwrap_or_default();
+                    let mut line = format!("{name} · {} new", count_text(state.plan.new_count()));
+                    if state.plan.duplicate_count() > 0 {
+                        line += &format!(", {} already here", count_text(state.plan.duplicate_count()));
+                    }
+                    if state.plan.unreadable_count() > 0 {
+                        line += &format!(", {} unreadable", count_text(state.plan.unreadable_count()));
+                    }
+                    line
+                }
+                None => String::new(),
+            },
+            Screen::Budget => {
+                // The total of the column of the same name; the others are
+                // under their columns, where the subtitle needn't be cut.
+                let lines = report::budget_lines(&self.ledger, self.budget_month);
+                let available: i64 = lines.iter().map(|(_, l)| l.available).sum();
+                let over = lines.iter().filter(|(_, l)| l.available < 0).count();
+                format!(
+                    "{} available{}",
+                    format_money(available, currency),
+                    if over > 0 { format!(" · {over} over") } else { String::new() }
+                )
+            }
+            _ => String::new(),
+        };
+        self.widget(cx, ids!(screen_sub)).set_visible(cx, !sub.is_empty());
+        self.label(cx, ids!(screen_sub)).set_text(cx, &sub);
+        self.widget(cx, ids!(budget_nav)).set_visible(cx, self.screen == Screen::Budget);
+        // Going back to this month is a shortcut: a narrow window keeps the subtitle.
+        self.widget(cx, ids!(budget_today)).set_visible(
+            cx,
+            self.screen == Screen::Budget && self.budget_month != date::month_key(self.today) && self.budget_wide,
+        );
+        if self.screen == Screen::Budget {
+            self.sync_budget_totals(cx);
+        }
+        // Overview follows the period as a whole. Reports has it beside the one report it changes.
+        let period = self.screen == Screen::Overview && !self.db_failed;
+        self.widget(cx, ids!(range_segments)).set_visible(cx, period && self.segments_fit);
+        self.widget(cx, ids!(range_popup_box)).set_visible(cx, period && !self.segments_fit);
+        let at = Range::ALL.iter().position(|range| *range == self.range).unwrap_or(0);
+        self.drop_down(cx, ids!(range_popup)).set_selected_item(cx, at);
+        // The Import page has nothing to add to or search: it has a statement to choose.
+        let on_import = self.screen == Screen::Import;
+        self.widget(cx, ids!(add_txn)).set_visible(cx, self.backend.has_import() && !self.db_failed && !on_import);
+        if self.roles.desk {
+            self.widget(cx, ids!(search_box)).set_visible(cx, !self.db_failed && !on_import);
+            // With no accounts to show, nothing speaks of them.
+            for id in [ids!(accounts_head), ids!(net_worth_box)] {
+                self.widget(cx, id).set_visible(cx, !self.db_failed);
+            }
+        }
+        self.widget(cx, ids!(search_clear)).set_visible(cx, !self.search.is_empty());
+        for (range, id) in [
+            (Range::Month, ids!(range_month)),
+            (Range::Quarter, ids!(range_quarter)),
+            (Range::Year, ids!(range_year)),
+            (Range::All, ids!(range_all)),
+        ] {
+            self.paint_segment(cx, id, range == self.range);
+        }
+    }
+
+    /// The month's totals under the budget's columns, at the columns' widths.
+    fn sync_budget_totals(&mut self, cx: &mut Cx) {
+        let currency = self.currency();
+        let lines = report::budget_lines(&self.ledger, self.budget_month);
+        let sum = |pick: fn(&BudgetLine) -> i64| lines.iter().map(|(_, line)| pick(line)).sum::<i64>();
+        let (assigned, spent, carried, available) =
+            (sum(|l| l.assigned), sum(|l| l.spent), sum(|l| l.carried), sum(|l| l.available));
+        self.label(cx, ids!(total_assigned)).set_text(cx, &format_minor(assigned, currency));
+        self.label(cx, ids!(total_spent)).set_text(cx, &format_minor(spent, currency));
+        self.label(cx, ids!(total_carried)).set_text(cx, &format_minor(carried, currency));
+        let mut left = self.label(cx, ids!(total_available));
+        left.set_text(cx, &format_minor(available, currency));
+        let ink = if available < 0 { self.roles.down } else { self.roles.fg };
+        script_apply_eval!(cx, left, { draw_text +: { color: #(ink) } });
+        let money = if self.budget_wide { 110.0 } else { 96.0 };
+        for id in [ids!(total_assigned_box), ids!(total_spent_box), ids!(total_carried_box), ids!(total_available_box)] {
+            let mut cell = self.view(cx, id);
+            script_apply_eval!(cx, cell, { width: #(money) });
+        }
+        self.widget(cx, ids!(total_carried_box)).set_visible(cx, self.budget_wide);
+    }
+
+    /// A segmented control's segment: the one in force is raised.
+    fn paint_segment(&mut self, cx: &mut Cx, id: &[LiveId], on: bool) {
+        let roles = self.roles;
+        let mut item = self.button(cx, id);
+        let face = if on { roles.segment } else { Vec4f::default() };
+        let hover = if on { roles.segment } else { roles.hover };
+        let edge = if on { roles.line } else { Vec4f::default() };
+        let size = if on { 1.0 } else { 0.0 };
+        script_apply_eval!(cx, item, {
+            draw_bg +: { color: #(face) color_hover: #(hover) color_focus: #(face) border_color: #(edge) border_size: #(size) }
+        });
+    }
+
+    /// A register's header labels, aligned with their columns, over the cells
+    /// the grid drew for them (it would centre them all); the grid keeps the
+    /// header's clicks and column drags. Also its hairlines: one under the
+    /// header, one between each pair of columns.
+    fn draw_grid_head(&mut self, cx: &mut Cx2d, grid_id: &[LiveId], labels: &[(&str, f64)], sorted: Option<(usize, bool)>) {
+        const HEIGHT: f64 = 24.0;
+        const PAD: f64 = 12.0;
+        let rect = self.widget(cx, grid_id).area().rect(cx);
+        if rect.size.x < 1.0 {
+            return;
+        }
+        let grid_ref = self.view.data_grid(cx, grid_id);
+        let Some(grid) = grid_ref.borrow() else { return };
+        let scroll = grid.scroll_pos().x;
+        let widths: Vec<f64> = (0..labels.len()).map(|col| grid.col_width(col)).collect();
+        drop(grid);
+        let head = Rect { pos: rect.pos, size: dvec2(rect.size.x, HEIGHT) };
+        cx.push_clip_rect(head);
+        self.draw_rule.color = self.roles.line;
+        self.draw_rule.draw_abs(
+            cx,
+            Rect { pos: dvec2(head.pos.x, head.pos.y + HEIGHT - 1.0), size: dvec2(head.size.x, 1.0) },
+        );
+        let mut x = head.pos.x - scroll;
+        for (col, (label, align)) in labels.iter().enumerate() {
+            let width = widths[col];
+            if !label.is_empty() {
+                let laidout = self.draw_head.layout(cx, 0.0, 0.0, None, false, Align::default(), label);
+                let text = laidout.size_in_lpxs.width as f64;
+                let tall = laidout.size_in_lpxs.height as f64;
+                let mark = sorted.filter(|(on, _)| *on == col);
+                let room = (width - 2.0 * PAD - text - if mark.is_some() { 12.0 } else { 0.0 }).max(0.0);
+                let at = x + PAD + room * align;
+                self.draw_head.draw_abs(cx, dvec2(at, head.pos.y + (HEIGHT - tall) * 0.5), label);
+                if let Some((_, ascending)) = mark {
+                    let draw = if ascending { &mut self.draw_sort_up } else { &mut self.draw_sort_down };
+                    draw.color = self.roles.dim;
+                    draw.draw_abs(
+                        cx,
+                        Rect { pos: dvec2(at + text + 4.0, head.pos.y + HEIGHT * 0.5 - 3.0), size: dvec2(8.0, 6.0) },
+                    );
+                }
+            }
+            if col + 1 < labels.len() {
+                self.draw_rule.draw_abs(
+                    cx,
+                    Rect { pos: dvec2(x + width - 1.0, head.pos.y + 5.0), size: dvec2(1.0, HEIGHT - 10.0) },
+                );
+            }
+            x += width;
+        }
+        cx.pop_clip_rect();
+    }
+
+    /// Write the plan. Everything or nothing.
+    fn commit_import(&mut self, cx: &mut Cx) {
+        let Some(state) = self.import.take() else { return };
+        // What a desktop's page says afterwards.
+        let name = std::path::Path::new(&state.path)
+            .file_name()
+            .map(|name| name.to_string_lossy().into_owned())
+            .unwrap_or_default();
+        let count = state.plan.new_count();
+        let into = self.ledger.account_name(state.account).to_string();
+        match self.backend.commit_import(state) {
+            Ok((ledger, status)) => {
+                self.status = status;
+                self.ledger = ledger;
+                self.rebuild_rows();
+                if self.roles.desk {
+                    self.import_outcome = Some(ImportOutcome::Done {
+                        title: if count == 1 {
+                            "1 Transaction Imported".to_string()
+                        } else {
+                            format!("{} Transactions Imported", count_text(count))
+                        },
+                        note: format!("From “{name}” into {into}."),
+                    });
+                    self.set_screen(cx, Screen::Import);
+                } else {
+                    self.set_screen(cx, Screen::Ledger);
+                }
+            }
+            Err(error) => {
+                self.status = format!("import failed, nothing written: {error}");
+                self.import_outcome = Some(ImportOutcome::Failed {
+                    title: "Nothing Was Imported".to_string(),
+                    note: format!("The transactions in “{name}” could not be saved. Your accounts are unchanged."),
+                });
+                self.chrome_synced = false;
+                self.redraw(cx);
+            }
+        }
+    }
+
+    /// One register cell.
+    fn ledger_cell(&self, row: usize, column: Column) -> (String, CellStyle) {
+        let currency = self.currency();
+        let Some((index, balance)) = self.rows.get(row).copied() else {
+            return (String::new(), plain());
+        };
+        let txn = &self.ledger.transactions[index];
+        match column {
+            Column::Date => (self.date_text(txn.date), self.dim()),
+            Column::Payee => {
+                let mut style = plain();
+                if txn.flagged {
+                    style.color = Some(self.roles.flag);
+                }
+                (txn.payee.clone(), style)
+            }
+            Column::Category => {
+                let label = txn.category_label(&self.ledger.categories);
+                let mut style = self.dim();
+                if label.is_empty() && !txn.is_transfer() {
+                    let none = if self.roles.desk { "Uncategorized" } else { "— uncategorized" };
+                    return (none.to_string(), CellStyle {
+                        color: Some(self.roles.flag),
+                        ..self.dim()
+                    });
+                }
+                if txn.is_split() {
+                    style.color = Some(self.roles.split);
+                }
+                (label, style)
+            }
+            Column::Account => (self.ledger.account_name(txn.account).to_string(), self.dim()),
+            Column::Cleared => (
+                if self.roles.desk {
+                    // Cleared and reconciled, the way a register ticks them off.
+                    match txn.cleared {
+                        Cleared::Uncleared => String::new(),
+                        // Not U+2714: a font takes that one for an emoji and paints it its own dark grey.
+                        Cleared::Cleared => "✓".to_string(),
+                        Cleared::Reconciled => "✓✓".to_string(),
+                    }
+                } else {
+                    txn.cleared.mark().to_string()
+                },
+                CellStyle { align: 0.5, ..self.dim() },
+            ),
+            Column::Amount => (
+                format_minor(txn.amount, currency),
+                CellStyle {
+                    // A desktop's list reads like a statement: money coming in
+                    // stands out, spending is not an alarm.
+                    color: Some(if txn.amount >= 0 {
+                        self.roles.up
+                    } else if self.roles.desk {
+                        self.roles.fg
+                    } else {
+                        self.roles.down
+                    }),
+                    align: 1.0,
+                    bold: true,
+                    ..plain()
+                },
+            ),
+            Column::Balance => (
+                format_minor(balance, currency),
+                self.dim_amount(),
+            ),
+        }
+    }
+
+    /// One budget cell.
+    fn budget_cell(&self, lines: &[(Id, BudgetLine)], row: usize, col: usize) -> (String, CellStyle) {
+        let currency = self.currency();
+        let Some((category, line)) = lines.get(row) else {
+            return (String::new(), plain());
+        };
+        match col {
+            0 => (self.ledger.categories.path(*category), plain()),
+            1 => (format_minor(line.assigned, currency), self.dim_amount()),
+            2 => (format_minor(line.spent, currency), self.dim_amount()),
+            3 => (
+                if line.carried != 0 {
+                    format_minor(line.carried, currency)
+                } else {
+                    String::new()
+                },
+                self.dim_amount(),
+            ),
+            _ => (
+                format_minor(line.available, currency),
+                CellStyle {
+                    color: Some(match line.state() {
+                        BudgetState::Overspent => self.roles.down,
+                        BudgetState::Untouched => self.roles.quiet,
+                        _ if self.roles.desk => self.roles.fg,
+                        _ => self.roles.up,
+                    }),
+                    align: 1.0,
+                    bold: true,
+                    ..plain()
+                },
+            ),
+        }
+    }
+
+    /// One preview cell of an import.
+    fn import_cell(&self, state: &ImportState, row: usize, col: usize) -> (String, CellStyle) {
+        let currency = self.currency();
+        let Some(candidate) = state.plan.rows.get(row) else {
+            return (String::new(), plain());
+        };
+        use crate::import::RowStatus;
+        let faded = matches!(candidate.status, RowStatus::Duplicate | RowStatus::Unreadable);
+        let base = if faded { self.dim() } else { plain() };
+        match col {
+            0 => (
+                match (candidate.status, self.roles.desk) {
+                    (RowStatus::New, true) => "New".to_string(),
+                    (RowStatus::Duplicate, true) => "Already here".to_string(),
+                    (RowStatus::Unreadable, true) => "Unreadable".to_string(),
+                    (RowStatus::New, false) => "new".to_string(),
+                    (RowStatus::Duplicate, false) => "already here".to_string(),
+                    (RowStatus::Unreadable, false) => "unreadable".to_string(),
+                },
+                CellStyle {
+                    color: Some(match candidate.status {
+                        RowStatus::New => self.roles.up,
+                        RowStatus::Duplicate => self.roles.quiet,
+                        RowStatus::Unreadable => self.roles.down,
+                    }),
+                    ..base
+                },
+            ),
+            1 => (
+                if candidate.status == RowStatus::Unreadable {
+                    String::new()
+                } else {
+                    self.date_text(candidate.txn.date)
+                },
+                base,
+            ),
+            2 => (candidate.txn.payee.clone(), base),
+            3 => (
+                match candidate.txn.category {
+                    None if self.roles.desk => "Uncategorized".to_string(),
+                    category => self.ledger.categories.path(category.unwrap_or(0)),
+                },
+                base,
+            ),
+            _ => (
+                if self.roles.desk && candidate.status == RowStatus::Unreadable {
+                    String::new()
+                } else {
+                    format_minor(candidate.txn.amount, currency)
+                },
+                // `bold` is the tabular face on a desktop's grid.
+                CellStyle { align: 1.0, bold: !faded || self.roles.desk, ..base },
+            ),
+        }
+    }
+
+    // -- AI --------------------------------------------------------------
+
+    /// Net worth, the current range's flow, and which screen and account
+    /// filter are showing — the one fact the `finance.summary` tool reads.
+    pub fn ai_summary(&self) -> String {
+        let currency = self.currency();
+        let worth = self.ledger.net_worth_on(self.today);
+        let flow = report::flow(&self.ledger, self.range());
+        let filter = match self.account_filter.and_then(|id| self.ledger.account(id)) {
+            Some(account) => format!(" Filtered to {}.", account.name),
+            None => String::new(),
+        };
+        format!(
+            "{} screen. Net worth {}. Over {}: in {}, out {}, net {}.{filter}",
+            self.screen.title(),
+            format_money(worth, currency),
+            self.range.label(),
+            format_money(flow.income, currency),
+            format_money(flow.expense, currency),
+            format_money(flow.net(), currency),
+        )
+    }
+
+    /// Answer one call from the AI bus — the module's executor and, if a
+    /// standalone build opens a service port later, that port too.
+    pub fn ai_answer(&self, call: &makepad_ai_services::wire::ServiceCall) -> makepad_ai_services::wire::ToolResult {
+        crate::ai::answer(call, || self.ai_summary())
+    }
+}
