+/// A click's way out of an app, to the system's handler for `url`. External
+/// handlers can execute native apps: a contained app's page grant only covers
+/// HTTP(S), and opening OS UI has the same foreground authority as other prompts.
+pub(crate) fn open_external(cx: &mut Cx, heap: usize, url: &str, in_place: OpenUrlInPlace) {
+    match normalize_external_url(url) {
+        Ok(url) => {
+            let policed = crate::splash_policy::is_enforced(heap);
+            if !crate::splash_host::prompts_allowed_for_heap(heap) {
+                crate::error!("LinkLabel: external links require foreground user input");
+            } else if policed
+                && (!url.starts_with("https://") && !url.starts_with("http://")
+                    || !crate::splash_policy::page_allowed(heap, &url))
+            {
+                crate::error!("LinkLabel: external URL is not allowed by this app's page grant");
+            } else {
+                cx.open_url(&url, in_place);
+            }
+        }
+        Err(error) => crate::error!("LinkLabel: {error}"),
+    }
