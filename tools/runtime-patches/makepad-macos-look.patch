+    #[test]
+    fn a_fitted_axis_steps_by_round_values_and_covers_its_range() {
+        // A balance that moved a little in a month: the axis fits it, not zero.
+        let ticks = nice_ticks(233_000.0, 234_500.0, AXIS_STEPS);
+        assert!(ticks[0] <= 233_000.0 && *ticks.last().unwrap() >= 234_500.0, "{ticks:?}");
+        assert!(ticks[0] > 200_000.0, "{ticks:?}");
+        let step = ticks[1] - ticks[0];
+        assert!([100.0, 200.0, 250.0, 500.0, 1000.0].contains(&step), "{ticks:?}");
+        assert!((3..=7).contains(&ticks.len()), "{ticks:?}");
+        // Bars from zero: zero is one of the values, with spending below it.
+        let ticks = nice_ticks(-3_420.0, 5_100.0, AXIS_STEPS);
+        assert!(ticks.contains(&0.0), "{ticks:?}");
+        assert!(ticks[0] <= -3_420.0 && *ticks.last().unwrap() >= 5_100.0, "{ticks:?}");
+        // The axis hugs its values: eighteen months of spending to 5,500 and
+        // income to 4,900 don't get an axis down to -10,000 (a third of the
+        // plot empty), but -6,000 by steps of 2,000.
+        let wide = nice_ticks(-5_500.0, 4_900.0, AXIS_STEPS);
+        assert_eq!(wide, vec![-6_000.0, -4_000.0, -2_000.0, 0.0, 2_000.0, 4_000.0, 6_000.0]);
+        assert!(wide.len() <= AXIS_STEPS + 3, "{wide:?}");
+        // Every step the same, and no value a hair off a round one.
+        for pair in ticks.windows(2) {
+            assert!(((pair[1] - pair[0]) - (ticks[1] - ticks[0])).abs() < 1e-6);
+        }
+        for value in &ticks {
+            assert_eq!(value.fract(), 0.0, "{ticks:?}");
+        }
+        // A flat line still gets an axis around it.
+        let ticks = nice_ticks(500.0, 500.0, AXIS_STEPS);
+        assert!(ticks[0] < 500.0 && *ticks.last().unwrap() > 500.0, "{ticks:?}");
+        let ticks = nice_ticks(0.0, 0.0, AXIS_STEPS);
