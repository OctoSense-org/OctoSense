+/// `MAKEPAD_FILES_CHAT_MODEL` wins; then a chat model in the Models folder (the
+/// folder AI looks in, the hub's `weights`); otherwise the file is looked for
+/// relative to the working directory, then up from the binary (which finds
+/// `target/release` runs from anywhere), then in the checkout this binary was
+/// compiled in.
 pub fn model_path() -> Option<PathBuf> {
     if let Some(from_env) = std::env::var_os(MODEL_ENV) {
         let path = PathBuf::from(from_env);
         return path.is_file().then_some(path);
     }
+    if let Some(found) = chat_model_under(&makepad_ai_hub::home::weights_dir(), 0) {
+        return Some(found);
+    }
     let relative = Path::new(MODEL_FILE);
     if relative.is_file() {
         return Some(relative.to_path_buf());
