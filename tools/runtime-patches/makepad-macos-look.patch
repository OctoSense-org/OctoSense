+fn search_rows(doc: &Document, now: Now, query: &str) -> Vec<ListRow> {
+    let query = query.trim().to_lowercase();
+    let projection = project(doc, Filter::All, now);
+    let mut rows = Vec::new();
+    for group in projection.groups.iter().chain(projection.completed_groups.iter()) {
+        let hits: Vec<ListRow> = group
+            .items
+            .iter()
+            .filter(|item| {
