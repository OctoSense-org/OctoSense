+impl Finance {
+    fn currency(&self) -> Currency {
+        let base = self.ledger.base_currency;
+        // A desktop writes money one way everywhere, like its dates: €1,234.56.
+        if self.roles.desk {
+            Currency { symbol_first: true, ..base }
+        } else {
+            base
+        }
+    }
+
+    /// What a desktop's grid cell can print of a text. A grid clips at its cell
+    /// and has no ellipsis of its own, so this measures with the cell's own
+    /// face: anything short of that loses the end of the ellipsis at the edge.
+    fn fit_cell(&self, cx: &mut Cx, text: String, room: f64) -> String {
+        elide_to_fit(&text, |candidate| {
+            let laidout = self.draw_measure.layout(cx, 0.0, 0.0, None, false, Align::default(), candidate);
+            laidout.size_in_lpxs.width as f64 <= room
+        })
+    }
+
+    /// A day as this appearance writes it: "Nov 2, 2026" on a desktop.
+    fn date_text(&self, day: Day) -> String {
+        if !self.roles.desk {
+            return date::format_short(day);
+        }
+        let (year, month, of_month) = date::to_ymd(day);
+        format!("{} {of_month}, {year}", date::MONTH_ABBR[(month - 1) as usize])
+    }
