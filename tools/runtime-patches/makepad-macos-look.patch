+/// What a press on the page asks of the window.
+#[derive(Clone, Debug, Default)]
+pub enum MpPlacesPageAction {
+    #[default]
+    None,
+    Open(String),
+    OpenInNewTab(String),
+    Edit(String),
+    Remove(String),
+}
+
+/// A row of the menu at a right press on a page's row.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum RowMenu {
+    Open,
+    OpenInNewTab,
+    CopyLink,
+    Edit,
+    Remove,
+    Rule,
+}
+
+/// The rows that name `query`, by title, site or address, case aside, each
+/// under its day's heading.
+fn matching(all: &[Line], query: &str) -> Vec<Line> {
+    let query = query.trim().to_lowercase();
+    if query.is_empty() {
+        return all.to_vec();
+    }
+    let mut lines = Vec::new();
+    let mut heading = None;
+    for line in all {
+        match line {
+            Line::Day(_) => heading = Some(line),
+            Line::Page { url, name, site, .. } => {
+                if [name, site, url].iter().any(|words| words.to_lowercase().contains(&query)) {
+                    if let Some(day) = heading.take() {
+                        lines.push(day.clone());
+                    }
+                    lines.push(line.clone());
+                }
+            }
+        }
+    }
+    lines
+}
+
+fn row_menu(kind: PlacesKind) -> Vec<(RowMenu, &'static str)> {
+    let mut rows = vec![
+        (RowMenu::Open, "Open"),
+        (RowMenu::OpenInNewTab, "Open in New Tab"),
+        (RowMenu::CopyLink, "Copy Link"),
+        (RowMenu::Rule, "-"),
+    ];
+    match kind {
+        PlacesKind::Bookmarks => {
+            rows.push((RowMenu::Edit, "Edit Bookmark\u{2026}"));
+            rows.push((RowMenu::Remove, "Remove Bookmark"));
+        }
+        PlacesKind::History => rows.push((RowMenu::Remove, "Remove from History")),
+    }
+    rows
+}
