+
+    #[test]
+    fn the_stock_sheet_builds_every_part_of_the_panel() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        cx.init_cx_os();
+        let app = cx.with_vm(|vm| App::from_script_mod(vm, App::script_mod));
+        for id in [ids!(title), ids!(provider), ids!(clear_button), ids!(transcript), ids!(status), ids!(input), ids!(send_button)] {
