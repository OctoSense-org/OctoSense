+++ b/apps/route/src/view/desk.rs
@@ -0,0 +1,1828 @@
+//! A desktop's sidebar, the way a Mac's Maps has one: search with its results,
+//! a place, directions with their steps and a list of recent places; the map's
+//! controls at the trailing edge; the keyboard. Only a desktop's sheet draws
+//! these, and a phone never comes here.
+//!
+//! A place search and a route go to the map data on this machine when it has
+//! it, and otherwise to the service the hosted map comes from.
+
+use super::*;
+use crate::chrome::{SideGlyph, SideRow};
+use crate::nav_api::{ApiOperation, NavApi, NavApiEvent, RouteRequestContext};
+use crate::provisioner::demo::hosted_api;
+use crate::trip::{Leg, TripMode};
+use makepad_map_nav::geo::LonLat;
+use makepad_map_nav::graph::{Route, TravelMode};
+use makepad_map_nav::nav::ManeuverKind;
+use makepad_map_nav::search::{Category, SearchResult};
+use makepad_widgets::makepad_platform::storage::{StorageRequestId, StorageResult};
+use makepad_widgets::map::MapViewAction;
+
+const SEARCH_WAIT_SECONDS: f64 = 0.25;
+const RESULTS: usize = 20;
+const RECENTS: usize = 8;
+const RECENTS_KEY: &str = "recents";
+/// Below this width the map needs the room: the sidebar steps aside by itself.
+const SIDEBAR_MIN_WINDOW: f64 = 620.0;
+/// What the Assistant takes of the map: its 320 points and its margin. The
+/// sidebar gives way before the map is a sliver between the two.
+const ASSISTANT_ROOM: f64 = 328.0;
+const SIDEBAR_WIDTH: f64 = 281.0;
+/// A place's neighbourhood, when the camera frames several results.
+const FRAME_RADIUS_M: f64 = 60_000.0;
+/// How far an arrow key moves the map, in points.
+const PAN_POINTS: f64 = 120.0;
+/// Zoom presses this close together add up, whatever the camera has reached.
+const ZOOM_CHAIN_SECONDS: f64 = 0.6;
+/// The tilt of the 3D control.
+const TILT_3D: f64 = 55.0;
+const CURRENT_LOCATION: &str = "Current Location";
+
+/// What the sidebar shows under its search field.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub(super) enum Pane {
+    #[default]
+    Home,
+    Results,
+    Place,
+    Directions,
+}
+
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct Place {
+    name: String,
+    note: String,
+    lon: f64,
+    lat: f64,
+}
+
+impl Place {
+    fn from_result(result: &SearchResult) -> Self {
+        let mut parts = Vec::new();
+        if result.category != Category::Other {
+            parts.push(result.category.label().to_string());
+        }
+        if !result.secondary.is_empty() {
+            parts.push(result.secondary.clone());
+        }
+        if let Some(meters) = result.distance_m {
+            parts.push(distance_text(meters));
+        }
+        Self {
+            name: result.name.clone(),
+            note: parts.join(" · "),
+            lon: result.pos.lon,
+            lat: result.pos.lat,
+        }
+    }
+
+    /// A point with no name of its own says where it is, in the words Copy Coordinates copies.
+    fn dropped_pin(lon: f64, lat: f64) -> Self {
+        Self {
+            name: DROPPED_PIN.to_string(),
+            note: coordinates_text(lat, lon),
+            lon,
+            lat,
+        }
+    }
+
+    /// What a route's end says: the place's name, or, for a point with no name
+    /// of its own, where it is, so a route between two dropped pins has two
+    /// ends a person can tell apart.
+    fn end_name(&self) -> String {
+        if self.name == DROPPED_PIN {
+            coordinates_text(self.lat, self.lon)
+        } else {
+            self.name.clone()
+        }
+    }
+
+    fn row(&self) -> SideRow {
+        SideRow {
+            title: self.name.clone(),
+            note: self.note.clone(),
+            glyph: SideGlyph::Place,
+        }
+    }
+
+    fn at(&self) -> LonLat {
+        LonLat { lon: self.lon, lat: self.lat }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+enum End {
+    From,
+    #[default]
+    To,
+}
+
+/// One end of a route: what the field says, and the place once it is one.
+#[derive(Clone, Debug, Default)]
+struct RouteEnd {
+    text: String,
+    place: Option<Place>,
+}
+
+/// What the rows of the list are.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+enum Rows {
+    #[default]
+    Recents,
+    Results,
+    Choices(End),
+    Steps,
+}
+
+/// What Try Again does.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Retry {
+    Search,
+    Route,
+}
+
+/// The sidebar's centred message in place of its list.
+#[derive(Clone, Debug, PartialEq)]
+struct Notice {
+    title: &'static str,
+    note: &'static str,
+    busy: bool,
+    retry: Option<Retry>,
+}
+
+const SEARCHING: Notice = Notice { title: "Searching\u{2026}", note: "", busy: true, retry: None };
+const NO_RESULTS: Notice = Notice {
+    title: "No Results",
+    note: "Try a different name, or check the spelling.",
+    busy: false,
+    retry: None,
+};
+const SEARCH_FAILED: Notice = Notice {
+    title: "Search Isn\u{2019}t Available",
+    note: "Check your connection and try again.",
+    busy: false,
+    retry: Some(Retry::Search),
+};
+const ROUTING: Notice = Notice { title: "Finding a Route\u{2026}", note: "", busy: true, retry: None };
+const ROUTE_FAILED: Notice = Notice {
+    title: "No Route Found",
+    note: "Directions may not cover these places yet, or the connection is down.",
+    busy: false,
+    retry: Some(Retry::Route),
+};
+
+/// What a row of the map's menu does.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum MapCommand {
+    DropPin,
+    DirectionsTo,
+    DirectionsFrom,
+    CopyCoordinates,
+}
+
+/// How long the window says the map is catching up, whatever keeps it from
+/// finishing: an overlay's server can take its time, and go on doing so.
+const CATCH_UP_SECONDS: f64 = 20.0;
+
+/// The map is building what the popover asked for.
+#[derive(Clone, Copy, Debug)]
+struct CatchUp {
+    style: bool,
+    since: f64,
+}
+
+/// How long after a move the map's tiles are watched: a flight is on its way
+/// for up to this long even while what it shows is ready.
+const TILES_FLIGHT_SECONDS: f64 = 3.0;
+/// How long a view may fill before the window stops saying so: a server that
+/// never answers is the map's own plate to tell.
+const TILES_WATCH_SECONDS: f64 = 30.0;
+/// A view that fills inside this beat needs no word.
+const TILES_QUIET_SECONDS: f64 = 0.35;
+
+pub(super) struct DeskSide {
+    /// A right press on the map.
+    context_menu: ContextMenu,
+    /// What the menu's rows do, rule included, and to what place.
+    map_commands: Vec<Option<MapCommand>>,
+    map_menu_place: Option<Place>,
+    /// Where and when the mouse last went down: the map's action has neither time nor window point.
+    pressed: (DVec2, f64),
+    /// What the popover has the map building.
+    catching_up: Option<CatchUp>,
+    /// Since when the map has been moved to a view it may not have drawn yet,
+    /// and whether "Loading Map" is up over it.
+    tiles_watch: Option<f64>,
+    tiles_said: bool,
+    /// A spinner is showing: each turns with a frame of its own.
+    spin_frame: NextFrame,
+    /// The sidebar is shown.
+    open: bool,
+    /// The window's width closed it, and widening opens it again.
+    closed_for_width: bool,
+    width_seen: f64,
+    pub(super) pane: Pane,
+    /// Where Back goes from a place.
+    place_from_results: bool,
+    query: String,
+    search_timer: Timer,
+    /// Return was pressed before the results came.
+    return_pending: bool,
+    searching_for: Rows,
+    notice: Option<Notice>,
+    rows_are: Rows,
+    results: Vec<Place>,
+    place: Option<Place>,
+    from: RouteEnd,
+    to: RouteEnd,
+    mode: TravelMode,
+    route: Option<Route>,
+    route_generation: u64,
+    api: NavApi,
+    recents: Vec<Place>,
+    recents_load: Option<StorageRequestId>,
+    recents_loaded: bool,
+    /// The zoom the last press asked for, and when.
+    zoom_asked: Option<(f64, f64)>,
+    /// The camera as of the last event: a new sheet puts the script's back.
+    camera: Option<((f64, f64), f64, f64, f64)>,
+    /// A field that gets the keyboard next frame: focus set during a click
+    /// does not survive the rest of that click.
+    focus_after_frame: Option<&'static [LiveId]>,
+    focus_frame: NextFrame,
+    /// What the map was last told: it stays out of the sidebar's way.
+    map_margin: Option<(f64, f64)>,
+}
+
+impl Default for DeskSide {
+    fn default() -> Self {
+        Self {
+            context_menu: ContextMenu::default(),
+            map_commands: Vec::new(),
+            map_menu_place: None,
+            pressed: (DVec2::default(), 0.0),
+            catching_up: None,
+            tiles_watch: None,
+            tiles_said: false,
+            spin_frame: NextFrame::default(),
+            open: true,
+            closed_for_width: false,
+            width_seen: 0.0,
+            pane: Pane::Home,
+            place_from_results: false,
+            query: String::new(),
+            search_timer: Timer::empty(),
+            return_pending: false,
+            searching_for: Rows::Results,
+            notice: None,
+            rows_are: Rows::Recents,
+            results: Vec::new(),
+            place: None,
+            from: RouteEnd::default(),
+            to: RouteEnd::default(),
+            mode: TravelMode::Car,
+            route: None,
+            route_generation: 0,
+            api: NavApi::new(hosted_api()),
+            recents: Vec::new(),
+            recents_load: None,
+            recents_loaded: false,
+            zoom_asked: None,
+            camera: None,
+            focus_after_frame: None,
+            focus_frame: NextFrame::default(),
+            map_margin: None,
+        }
+    }
+}
+
+/// A point of the map with no name of its own.
+const DROPPED_PIN: &str = "Dropped Pin";
+
+/// "52.3702, 4.8952": latitude and longitude, as Copy Coordinates puts them.
+fn coordinates_text(lat: f64, lon: f64) -> String {
+    format!("{lat:.4}, {lon:.4}")
+}
+
+/// "350 m", "4.4 km", "12 km".
+fn distance_text(meters: f64) -> String {
+    if meters < 950.0 {
+        format!("{} m", ((meters / 10.0).round() as i64 * 10).max(10))
+    } else if meters < 9_950.0 {
+        format!("{:.1} km", meters / 1000.0)
+    } else {
+        format!("{:.0} km", meters / 1000.0)
+    }
+}
+
+/// "8 min", "1 hr 5 min".
+pub(super) fn time_text(seconds: f64) -> String {
+    let minutes = (seconds / 60.0).round().max(1.0) as i64;
+    match (minutes / 60, minutes % 60) {
+        (0, m) => format!("{m} min"),
+        (h, 0) => format!("{h} hr"),
+        (h, m) => format!("{h} hr {m} min"),
+    }
+}
+
+fn step_glyph(kind: &ManeuverKind) -> SideGlyph {
+    match kind {
+        ManeuverKind::Depart => SideGlyph::Start,
+        ManeuverKind::Arrive => SideGlyph::Flag,
+        ManeuverKind::TurnSlightLeft | ManeuverKind::TurnLeft | ManeuverKind::TurnSharpLeft => SideGlyph::Left,
+        ManeuverKind::TurnSlightRight | ManeuverKind::TurnRight | ManeuverKind::TurnSharpRight => SideGlyph::Right,
+        ManeuverKind::UTurn => SideGlyph::Uturn,
+        ManeuverKind::RoundaboutExit(_) => SideGlyph::Round,
+    }
+}
+
+/// The one line of a stored place. Tabs and new lines in a name become spaces.
+fn recents_text(recents: &[Place]) -> String {
+    let clean = |text: &str| text.replace(['\t', '\n', '\r'], " ");
+    recents
+        .iter()
+        .map(|p| format!("{}\t{}\t{:.7}\t{:.7}", clean(&p.name), clean(&p.note), p.lon, p.lat))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn recents_from(text: &str) -> Vec<Place> {
+    text.lines()
+        .filter_map(|line| {
+            let mut parts = line.split('\t');
+            let name = parts.next()?.to_string();
+            let note = parts.next()?.to_string();
+            let lon = parts.next()?.parse().ok()?;
+            let lat = parts.next()?.parse().ok()?;
+            Some(Place { name, note, lon, lat })
+        })
+        .take(RECENTS)
+        .collect()
+}
+
+/// What a person reads for a line of the transcript; `None` for the workshop's
+/// lines, which a phone's console keeps.
+pub(super) fn desk_entry(kind: EntryKind, text: &str) -> Option<(EntryKind, String)> {
+    match kind {
+        EntryKind::User | EntryKind::Assistant => {
+            Some((kind, text.to_string())).filter(|_| !text.starts_with("tools: "))
+        }
+        EntryKind::Tool => {
+            let name = text.strip_prefix("⚙ ")?.split_whitespace().next()?;
+            let line = match name {
+                "route_plan" => "Planning a route\u{2026}",
+                "route_add_stop" | "route_remove_stop" => "Changing the route\u{2026}",
+                "route_along" => "Looking along the route\u{2026}",
+                "images_search" => "Looking for pictures\u{2026}",
+                _ if name.contains("search") || name.contains("find") => "Searching\u{2026}",
+                _ if name.contains("rain") || name.contains("weather") => "Checking the weather\u{2026}",
+                _ => return None,
+            };
+            Some((EntryKind::Tool, line.to_string()))
+        }
+        EntryKind::Info => {
+            let line = if let Some(heard) = text.strip_prefix("🎤 “") {
+                return Some((EntryKind::User, heard.trim_end_matches('”').to_string()));
+            } else if text.starts_with("🎤 listening") {
+                "Listening. Say \u{201c}computer\u{201d}, then what you need."
+            } else if text.starts_with("🎤 arming") {
+                "Getting the microphone ready\u{2026}"
+            } else if text.starts_with("🎤 mic off") {
+                "Microphone off."
+            } else if text.starts_with("🔇") {
+                "Spoken replies off."
+            } else if text.starts_with("🔊") {
+                "Spoken replies on."
+            } else if text.starts_with("⚠ no agent, said") {
+                "The assistant can\u{2019}t answer without a language model."
+            } else if text.starts_with("⚠ session error") {
+                // The panel says so, and what to do, in place of the list.
+                return None;
+            } else if text.starts_with("⚠ no agent") {
+                "The assistant needs a language model, and none is installed on this computer. Search and directions work without it."
+            } else if text.starts_with('⚠') {
+                "Something went wrong. Try again."
+            } else if text.starts_with('▶') {
+                "Navigation started."
+            } else if text.starts_with('■') {
+                "Navigation ended."
+            } else if text.starts_with('↻') {
+                "Finding a new route\u{2026}"
+            } else if text.starts_with('↩') {
+                "Showing that trip on the map."
+            } else if let Some(place) = text.strip_prefix("🏁 arrived at ") {
+                return Some((EntryKind::Info, format!("Arrived at {place}.")));
+            } else if let Some(place) = text.strip_prefix("● reached ") {
+                let place = place.split(" — ").next().unwrap_or(place);
+                return Some((EntryKind::Info, format!("Reached {place}.")));
+            } else {
+                return None;
+            };
+            Some((EntryKind::Info, line.to_string()))
+        }
+    }
+}
+
+/// The line under the prompt: what the assistant is doing, in a person's
+/// words, and nothing when it is simply ready.
+pub(super) fn desk_status(text: &str) -> &'static str {
+    let lower = text.to_ascii_lowercase();
+    if lower.starts_with("thinking") {
+        "Thinking\u{2026}"
+    } else if lower.starts_with("ai loading") || lower.starts_with("starting") {
+        "Getting ready\u{2026}"
+    } else if lower.contains("error") || lower.contains("failed") {
+        "Something went wrong. Try again."
+    } else {
+        ""
+    }
+}
+
+impl RouteView {
+    fn with_tools<R>(&mut self, cx: &mut Cx, f: impl FnOnce(&mut ToolCtx) -> R) -> R {
+        let map = self.map(cx);
+        let history_dir = self.paths.as_ref().map(|p| p.history.clone()).unwrap_or_default();
+        let mut nav_action = None;
+        let mut tool_ctx = ToolCtx {
+            cx,
+            map: &map,
+            trip: &mut self.trip,
+            nav: self.nav.as_mut(),
+            radar: self.radar.as_ref(),
+            markers: &mut self.markers,
+            position: self.position.as_ref().map(|p| (p.lon, p.lat)),
+            layers: &mut self.layers,
+            leg_routes: &mut self.leg_routes,
+            nav_action: &mut nav_action,
+            history_dir: &history_dir,
+        };
+        f(&mut tool_ctx)
+    }
+
+    /// The pins of the results, with the selected one or the shown place in
+    /// its own colour.
+    fn show_pins(&mut self, cx: &mut Cx) {
+        let selected = self.chat.side_selected;
+        let mut pins: Vec<MarkerSpec> = Vec::new();
+        if self.side.pane != Pane::Directions {
+            if self.side.rows_are == Rows::Results && self.side.pane == Pane::Results || self.side.place_from_results {
+                for (index, place) in self.side.results.iter().enumerate() {
+                    let on = self.side.pane == Pane::Results && selected == Some(index);
+                    if self.side.pane == Pane::Place && self.side.place.as_ref() == Some(place) {
+                        continue;
+                    }
+                    pins.push(MarkerSpec {
+                        lon: place.lon,
+                        lat: place.lat,
+                        label: place.name.clone(),
+                        kind: if on { "selected" } else { "search" }.to_string(),
+                    });
+                }
+            }
+            if self.side.pane == Pane::Place {
+                if let Some(place) = &self.side.place {
+                    pins.push(MarkerSpec {
+                        lon: place.lon,
+                        lat: place.lat,
+                        label: place.name.clone(),
+                        kind: "selected".to_string(),
+                    });
+                }
+            }
+        } else if self.side.route.is_none() {
+            // Directions with no route yet: the ends it has stay on the map, as
+            // Maps keeps the place you asked for in view while it finds the rest.
+            // Where you are is the location's own dot.
+            for (end, kind) in [(&self.side.from, "start"), (&self.side.to, "end")] {
+                if let Some(place) = end.place.as_ref().filter(|place| place.name != CURRENT_LOCATION) {
+                    pins.push(MarkerSpec {
+                        lon: place.lon,
+                        lat: place.lat,
+                        label: place.end_name(),
+                        kind: kind.to_string(),
+                    });
+                }
+            }
+        }
+        self.markers.adhoc = pins;
+        self.with_tools(cx, |ctx| tools::map::sync_trip_display(ctx, false));
+    }
+
+    /// Frame the results that lie around the best one.
+    fn frame_results(&mut self, cx: &mut Cx) {
+        let Some(first) = self.side.results.first().cloned() else {
+            return;
+        };
+        let near: Vec<&Place> = self
+            .side
+            .results
+            .iter()
+            .filter(|p| trip::haversine_m((first.lon, first.lat), (p.lon, p.lat)) < FRAME_RADIUS_M)
+            .collect();
+        let bounds = near.iter().fold(((first.lon, first.lat), (first.lon, first.lat)), |(min, max), p| {
+            ((min.0.min(p.lon), min.1.min(p.lat)), (max.0.max(p.lon), max.1.max(p.lat)))
+        });
+        let (lon, lat, zoom) = self.with_tools(cx, |ctx| tools::map::fit_camera(ctx, bounds));
+        self.move_map(cx, lon, lat, zoom.min(15.0));
+    }
+
+    fn fly_to_place(&mut self, cx: &mut Cx, place: &Place) {
+        let zoom = self.map(cx).map_zoom().unwrap_or(13.0).max(14.5);
+        self.move_map(cx, place.lon, place.lat, zoom);
+    }
+
+    /// Take the map to a place: a flight when the way there is in reach, a
+    /// jump when it is farther. A flight that far climbs through views the map
+    /// has not drawn and shows an empty map all the way; a jump shows the
+    /// place as soon as its tiles are built, and "Loading Map" says so until
+    /// then.
+    fn move_map(&mut self, cx: &mut Cx, lon: f64, lat: f64, zoom: f64) {
+        let map = self.map(cx);
+        let rect = self.view.widget(cx, ids!(map)).area().rect(cx);
+        let at = map.borrow().map(|map| map.lon_lat_to_screen(lon, lat));
+        let far = match at {
+            Some(at) if rect.size.x > 0.0 && rect.size.y > 0.0 => {
+                let middle = rect.pos + rect.size * 0.5;
+                (at - middle).length() > rect.size.x.max(rect.size.y) * 2.0
+            }
+            _ => false,
+        };
+        if far {
+            map.set_map_zoom(cx, zoom);
+            map.set_center(cx, lon, lat);
+        } else {
+            map.fly_to(cx, lon, lat, zoom);
+        }
+        self.watch_tiles(cx);
+    }
+
+    /// Watch the map's view fill after a move, and say "Loading Map" over it
+    /// while it does.
+    pub(super) fn watch_tiles(&mut self, cx: &mut Cx) {
+        if !self.desk {
+            return;
+        }
+        self.side.tiles_watch = Some(cx.seconds_since_app_start());
+        self.side.spin_frame = cx.new_next_frame();
+    }
+
+    /// How the map's view stands, in the map's own words: "ready", "loading"
+    /// while more than a tenth of its tiles are on their way, or "failed".
+    fn map_tiles_state(&mut self, cx: &mut Cx) -> Option<String> {
+        let map = self.map(cx);
+        let mut inner = map.borrow_mut()?;
+        cx.with_vm(|vm| match inner.script_call(vm, live_id!(tiles_state), NIL) {
+            ScriptAsyncResult::Return(value) => vm.bx.heap.cast_to_owned_string(value, "tiles_state"),
+            _ => None,
+        })
+    }
+
+    // --- search ---------------------------------------------------------------
+
+    fn search_near(&self, cx: &mut Cx) -> LonLat {
+        let (lon, lat) = self.map(cx).center().unwrap_or(AMSTERDAM_CENTER);
+        LonLat { lon, lat }
+    }
+
+    /// The field changed: search a moment later, when typing has paused.
+    fn search_typed(&mut self, cx: &mut Cx, text: &str, target: Rows) {
+        self.side.query = text.trim().to_string();
+        self.side.return_pending = false;
+        cx.stop_timer(self.side.search_timer);
+        self.side.search_timer = Timer::empty();
+        self.side.searching_for = target;
+        if self.side.query.is_empty() {
+            self.side.notice = None;
+            self.side.results.clear();
+            self.chat.side_selected = None;
+            if target == Rows::Results {
+                self.side.pane = Pane::Home;
+                self.side.rows_are = Rows::Recents;
+                self.side.place = None;
+                self.side.place_from_results = false;
+            } else if self.side.rows_are != Rows::Steps {
+                self.chat.side_rows.clear();
+            }
+            self.show_pins(cx);
+            self.desk_sync(cx);
+            return;
+        }
+        self.side.search_timer = cx.start_timeout(SEARCH_WAIT_SECONDS);
+        if target == Rows::Results {
+            if self.side.pane != Pane::Results {
+                self.chat.side_rows.clear();
+                self.side.rows_are = Rows::Results;
+                self.side.place_from_results = false;
+            }
+            self.side.pane = Pane::Results;
+            self.side.place = None;
+        }
+        // Results already up stay until the new ones come.
+        if self.chat.side_rows.is_empty() {
+            self.side.notice = Some(SEARCHING);
+        }
+        self.desk_sync(cx);
+    }
+
+    fn run_search(&mut self, cx: &mut Cx) {
+        cx.stop_timer(self.side.search_timer);
+        self.side.search_timer = Timer::empty();
+        if self.side.query.is_empty() {
+            return;
+        }
+        let near = self.search_near(cx);
+        if let Some(nav) = &self.nav {
+            let results = nav.search(&self.side.query, Some(near), RESULTS);
+            self.on_search_results(cx, &results);
+            return;
+        }
+        if self.chat.side_rows.is_empty() || self.side.notice.is_some() {
+            self.side.notice = Some(SEARCHING);
+        }
+        let query = self.side.query.clone();
+        self.side.api.search(cx, &query, Some(near), RESULTS);
+        self.desk_sync(cx);
+    }
+
+    fn on_search_results(&mut self, cx: &mut Cx, results: &[SearchResult]) {
+        // The person moved on while it was on its way.
+        let wanted = match self.side.searching_for {
+            Rows::Results => self.side.pane == Pane::Results,
+            Rows::Choices(_) => self.side.pane == Pane::Directions,
+            Rows::Recents | Rows::Steps => false,
+        };
+        if !wanted || self.side.query.is_empty() {
+            return;
+        }
+        self.side.results = results.iter().map(Place::from_result).collect();
+        self.chat.side_selected = None;
+        self.side.notice = results.is_empty().then_some(NO_RESULTS);
+        self.side.rows_are = self.side.searching_for;
+        self.chat.side_rows = self.side.results.iter().map(Place::row).collect();
+        let answer_return = std::mem::take(&mut self.side.return_pending);
+        match self.side.searching_for {
+            Rows::Results => {
+                self.show_pins(cx);
+                if answer_return {
+                    self.answer_search_return(cx);
+                }
+            }
+            Rows::Choices(end) => {
+                if answer_return {
+                    self.choose_first_for(cx, end);
+                }
+            }
+            Rows::Recents | Rows::Steps => {}
+        }
+        self.desk_sync(cx);
+    }
+
+    /// Return in the search field: one place opens, and several are framed.
+    fn answer_search_return(&mut self, cx: &mut Cx) {
+        if let Some(index) = self.chat.side_selected {
+            self.open_result(cx, index);
+        } else if self.side.results.len() == 1 {
+            self.open_result(cx, 0);
+        } else {
+            self.frame_results(cx);
+        }
+    }
+
+    fn select_result(&mut self, cx: &mut Cx, index: usize) {
+        self.chat.side_selected = Some(index);
+        if let Some(place) = self.side.results.get(index).cloned() {
+            self.show_pins(cx);
+            self.fly_to_place(cx, &place);
+        }
+        self.desk_sync(cx);
+    }
+
+    fn open_result(&mut self, cx: &mut Cx, index: usize) {
+        if let Some(place) = self.side.results.get(index).cloned() {
+            self.chat.side_selected = Some(index);
+            self.side.place_from_results = true;
+            self.open_place(cx, place);
+        }
+    }
+
+    fn open_place(&mut self, cx: &mut Cx, place: Place) {
+        self.remember_recent(cx, &place);
+        self.fly_to_place(cx, &place);
+        self.side.place = Some(place);
+        self.side.pane = Pane::Place;
+        self.side.notice = None;
+        self.show_pins(cx);
+        self.desk_sync(cx);
+    }
+
+    fn focus_later(&mut self, cx: &mut Cx, field: &'static [LiveId]) {
+        self.side.focus_after_frame = Some(field);
+        self.side.focus_frame = cx.new_next_frame();
+    }
+
+    fn focus_field(&mut self, cx: &mut Cx, field: &'static [LiveId]) {
+        let input = self.view.text_input(cx, field);
+        input.set_key_focus(cx);
+        input.borrow_mut().map(|mut inner| inner.select_all(cx));
+    }
+
+    /// Cmd+F: the search field, with what it holds selected.
+    fn focus_search(&mut self, cx: &mut Cx) {
+        if !self.side.open {
+            self.set_sidebar(cx, true);
+        }
+        if self.side.pane == Pane::Directions {
+            self.leave_directions(cx);
+        }
+        self.focus_field(cx, ids!(search_input));
+        self.focus_later(cx, ids!(search_input));
+    }
+
+    fn clear_search(&mut self, cx: &mut Cx) {
+        self.view.text_input(cx, ids!(search_input)).set_text(cx, "");
+        self.search_typed(cx, "", Rows::Results);
+    }
+
+    // --- recents --------------------------------------------------------------
+
+    fn remember_recent(&mut self, cx: &mut Cx, place: &Place) {
+        self.side.recents.retain(|p| p.name != place.name || p.note != place.note);
+        self.side.recents.insert(0, place.clone());
+        self.side.recents.truncate(RECENTS);
+        if let Some(storage) = self.storage.clone() {
+            storage.set(cx, RECENTS_KEY, recents_text(&self.side.recents).into_bytes());
+        }
+    }
+
+    fn on_storage(&mut self, event: &Event) -> bool {
+        let Event::Storage(responses) = event else {
+            return false;
+        };
+        let Some(request_id) = self.side.recents_load else {
+            return false;
+        };
+        let Some(response) = responses.iter().find(|r| r.request_id == request_id) else {
+            return false;
+        };
+        self.side.recents_load = None;
+        if let Ok(StorageResult::Value(Some(bytes))) = &response.result {
+            self.side.recents = recents_from(&String::from_utf8_lossy(bytes));
+        }
+        true
+    }
+
+    // --- directions -----------------------------------------------------------
+
+    fn current_location(&self) -> Option<Place> {
+        self.position.as_ref().map(|fix| Place {
+            name: CURRENT_LOCATION.to_string(),
+            note: String::new(),
+            lon: fix.lon,
+            lat: fix.lat,
+        })
+    }
+
+    fn set_end(&mut self, cx: &mut Cx, end: End, place: Option<Place>) {
+        let text = place.as_ref().map(Place::end_name).unwrap_or_default();
+        let field = match end {
+            End::From => ids!(from_input),
+            End::To => ids!(to_input),
+        };
+        self.view.text_input(cx, field).set_text(cx, &text);
+        let slot = match end {
+            End::From => &mut self.side.from,
+            End::To => &mut self.side.to,
+        };
+        *slot = RouteEnd { text, place };
+    }
+
+    fn open_directions(&mut self, cx: &mut Cx) {
+        let to = self.side.place.clone().or_else(|| self.side.to.place.clone());
+        let from = self.side.from.place.clone().or_else(|| self.current_location());
+        self.show_directions(cx, from, to);
+    }
+
+    /// Directions to or from a point of the map: the other end stays what it
+    /// was, or what the sidebar was looking at.
+    fn directions_here(&mut self, cx: &mut Cx, end: End, place: Place) {
+        let (from, to) = match end {
+            End::To => (self.side.from.place.clone().or_else(|| self.current_location()), Some(place)),
+            End::From => (Some(place), self.side.to.place.clone().or_else(|| self.side.place.clone())),
+        };
+        self.clear_route(cx);
+        self.show_directions(cx, from, to);
+    }
+
+    fn show_directions(&mut self, cx: &mut Cx, from: Option<Place>, to: Option<Place>) {
+        if !self.side.open {
+            self.set_sidebar(cx, true);
+        }
+        self.side.pane = Pane::Directions;
+        self.side.notice = None;
+        self.chat.side_rows.clear();
+        self.chat.side_selected = None;
+        self.side.rows_are = Rows::Steps;
+        self.set_end(cx, End::From, from);
+        self.set_end(cx, End::To, to);
+        self.show_pins(cx);
+        self.route_if_ready(cx);
+        if self.side.from.place.is_none() {
+            self.focus_field(cx, ids!(from_input));
+            self.focus_later(cx, ids!(from_input));
+        } else if self.side.to.place.is_none() {
+            self.focus_field(cx, ids!(to_input));
+            self.focus_later(cx, ids!(to_input));
+        }
+        self.desk_sync(cx);
+    }
+
+    fn clear_route(&mut self, cx: &mut Cx) {
+        self.side.route_generation += 1;
+        if self.side.route.take().is_some() {
+            self.trip = TripModel::default();
+            self.leg_routes.clear();
+        }
+        self.show_pins(cx);
+    }
+
+    fn leave_directions(&mut self, cx: &mut Cx) {
+        self.clear_route(cx);
+        self.side.notice = None;
+        self.chat.side_rows.clear();
+        self.chat.side_selected = None;
+        if self.side.place.is_some() {
+            self.side.pane = Pane::Place;
+            self.side.rows_are = Rows::Results;
+            if self.side.place_from_results {
+                self.chat.side_rows = self.side.results.iter().map(Place::row).collect();
+            }
+        } else {
+            self.side.pane = Pane::Home;
+            self.side.rows_are = Rows::Recents;
+        }
+        self.show_pins(cx);
+        self.desk_sync(cx);
+    }
+
+    /// A step back: from directions, from a place, from results.
+    fn side_back(&mut self, cx: &mut Cx) -> bool {
+        match self.side.pane {
+            Pane::Directions => self.leave_directions(cx),
+            Pane::Place if self.side.place_from_results => {
+                self.side.pane = Pane::Results;
+                self.side.place = None;
+                self.side.rows_are = Rows::Results;
+                self.chat.side_rows = self.side.results.iter().map(Place::row).collect();
+                self.show_pins(cx);
+                self.desk_sync(cx);
+            }
+            Pane::Place => {
+                self.side.pane = Pane::Home;
+                self.side.place = None;
+                self.side.rows_are = Rows::Recents;
+                self.show_pins(cx);
+                self.desk_sync(cx);
+            }
+            Pane::Results => self.clear_search(cx),
+            Pane::Home => return false,
+        }
+        true
+    }
+
+    fn route_if_ready(&mut self, cx: &mut Cx) {
+        let (Some(from), Some(to)) = (self.side.from.place.clone(), self.side.to.place.clone()) else {
+            return;
+        };
+        self.side.route_generation += 1;
+        self.chat.side_rows.clear();
+        self.chat.side_selected = None;
+        self.side.rows_are = Rows::Steps;
+        let mode = self.side.mode;
+        if let Some(nav) = self.nav.as_mut() {
+            match nav.route_pair(from.at(), to.at(), mode) {
+                Some(route) => self.apply_route(cx, route),
+                None => {
+                    self.side.notice = Some(ROUTE_FAILED);
+                    self.desk_sync(cx);
+                }
+            }
+            return;
+        }
+        self.side.notice = Some(ROUTING);
+        let generation = self.side.route_generation;
+        self.side
+            .api
+            .route(cx, from.at(), to.at(), mode, RouteRequestContext::Reroute { generation });
+        self.desk_sync(cx);
+    }
+
+    fn apply_route(&mut self, cx: &mut Cx, route: Route) {
+        let (Some(from), Some(to)) = (self.side.from.place.clone(), self.side.to.place.clone()) else {
+            return;
+        };
+        let (from_name, to_name) = (from.end_name(), to.end_name());
+        let mut trip = TripModel::from_waypoints(&[
+            (from_name.clone(), from.lon, from.lat),
+            (to_name.clone(), to.lon, to.lat),
+        ]);
+        trip.mode = match self.side.mode {
+            TravelMode::Car => TripMode::Car,
+            TravelMode::Bike => TripMode::Bike,
+            TravelMode::Foot => TripMode::Foot,
+        };
+        trip.legs = vec![Leg {
+            polyline: route.points.iter().map(|p| (p.lon, p.lat)).collect(),
+            distance_m: route.length_m,
+            duration_s: route.duration_s,
+        }];
+        self.trip = trip;
+        self.leg_routes = vec![route.clone()];
+        self.markers.adhoc.clear();
+        // The route's frame is a flight of its own.
+        self.resync_trip_display(cx);
+        self.watch_tiles(cx);
+        self.chat.side_rows = route
+            .maneuvers
+            .iter()
+            .enumerate()
+            .map(|(index, step)| {
+                let next = route.maneuvers.get(index + 1).map(|n| n.dist_m - step.dist_m);
+                let title = match step.kind {
+                    ManeuverKind::Depart if from.name == CURRENT_LOCATION => "Start".to_string(),
+                    ManeuverKind::Depart => format!("Start at {from_name}"),
+                    ManeuverKind::Arrive => format!("Arrive at {to_name}"),
+                    _ => step.text(),
+                };
+                SideRow {
+                    title,
+                    note: next.filter(|m| *m > 0.5).map(distance_text).unwrap_or_default(),
+                    glyph: step_glyph(&step.kind),
+                }
+            })
+            .collect();
+        self.chat.side_selected = None;
+        self.side.rows_are = Rows::Steps;
+        self.side.route = Some(route);
+        self.side.notice = None;
+        self.desk_sync(cx);
+    }
+
+    fn set_mode(&mut self, cx: &mut Cx, mode: TravelMode) {
+        if self.side.mode != mode {
+            self.side.mode = mode;
+            self.route_if_ready(cx);
+            self.desk_sync(cx);
+        }
+    }
+
+    fn choose_first_for(&mut self, cx: &mut Cx, end: End) {
+        if let Some(place) = self.side.results.first().cloned() {
+            self.choose_for(cx, end, place);
+        }
+    }
+
+    fn choose_for(&mut self, cx: &mut Cx, end: End, place: Place) {
+        self.remember_recent(cx, &place);
+        self.set_end(cx, end, Some(place));
+        self.side.results.clear();
+        self.chat.side_rows.clear();
+        self.chat.side_selected = None;
+        self.side.rows_are = Rows::Steps;
+        self.side.notice = None;
+        self.route_if_ready(cx);
+        if self.side.to.place.is_none() {
+            self.focus_field(cx, ids!(to_input));
+            self.focus_later(cx, ids!(to_input));
+        } else if self.side.from.place.is_none() {
+            self.focus_field(cx, ids!(from_input));
+            self.focus_later(cx, ids!(from_input));
+        }
+        self.desk_sync(cx);
+    }
+
+    fn end_typed(&mut self, cx: &mut Cx, end: End, text: &str) {
+        let slot = match end {
+            End::From => &mut self.side.from,
+            End::To => &mut self.side.to,
+        };
+        *slot = RouteEnd { text: text.to_string(), place: None };
+        self.clear_route(cx);
+        self.chat.side_rows.clear();
+        self.side.rows_are = Rows::Choices(end);
+        self.search_typed(cx, text, Rows::Choices(end));
+    }
+
+    /// Return in a field of directions: the first answer, once there is one.
+    fn end_returned(&mut self, cx: &mut Cx, end: End) {
+        if self.side.rows_are == Rows::Choices(end) && !self.side.results.is_empty() && self.side.search_timer.is_empty() {
+            self.choose_first_for(cx, end);
+            return;
+        }
+        let text = match end {
+            End::From => self.side.from.text.clone(),
+            End::To => self.side.to.text.clone(),
+        };
+        if text.trim().is_empty() {
+            return;
+        }
+        self.side.query = text.trim().to_string();
+        self.side.searching_for = Rows::Choices(end);
+        self.side.return_pending = true;
+        self.run_search(cx);
+    }
+
+    // --- the sidebar and the map's controls -----------------------------------
+
+    fn set_sidebar(&mut self, cx: &mut Cx, open: bool) {
+        self.side.open = open;
+        self.desk_sync(cx);
+    }
+
+    /// The window got narrower or wider than the sidebar can share with a map. `width`
+    /// is what this frame draws at: a rect read off a widget is a frame behind a resize,
+    /// nothing may draw after the last one, and a geometry change stops at the Window.
+    pub(super) fn fit_sidebar_to_window(&mut self, cx: &mut Cx, width: f64) {
+        if !(width > 0.0) || width == self.side.width_seen {
+            return;
+        }
+        self.side.width_seen = width;
+        self.refit_sidebar(cx);
+    }
+
+    /// The sidebar against the window, and the Assistant if it is open.
+    pub(super) fn refit_sidebar(&mut self, cx: &mut Cx) {
+        let width = self.side.width_seen;
+        if !(width > 0.0) {
+            return;
+        }
+        let needed = SIDEBAR_MIN_WINDOW + if self.assistant_panel_open { ASSISTANT_ROOM } else { 0.0 };
+        if width < needed && self.side.open {
+            self.side.closed_for_width = true;
+            self.set_sidebar(cx, false);
+        } else if width >= needed && self.side.closed_for_width {
+            self.side.closed_for_width = false;
+            self.set_sidebar(cx, true);
+        }
+    }
+
+    fn zoom_by(&mut self, cx: &mut Cx, delta: f64) {
+        let map = self.map(cx);
+        let (lon, lat) = map.center().unwrap_or(AMSTERDAM_CENTER);
+        let now = Cx::monotonic_now();
+        let from = match self.side.zoom_asked {
+            Some((zoom, at)) if now - at < ZOOM_CHAIN_SECONDS => zoom,
+            _ => map.map_zoom().unwrap_or(13.0),
+        };
+        let zoom = (from + delta).clamp(3.0, 19.0);
+        self.side.zoom_asked = Some((zoom, now));
+        map.fly_to(cx, lon, lat, zoom);
+    }
+
+    fn pan_by(&mut self, cx: &mut Cx, right: f64, down: f64) {
+        let map = self.map(cx);
+        let (lon, lat) = map.center().unwrap_or(AMSTERDAM_CENTER);
+        let zoom = map.map_zoom().unwrap_or(13.0);
+        let degrees = 360.0 / (256.0 * 2f64.powf(zoom));
+        map.fly_to(
+            cx,
+            lon + right * degrees,
+            lat - down * degrees * lat.to_radians().cos(),
+            zoom,
+        );
+    }
+
+    fn set_layers_open(&mut self, cx: &mut Cx, open: bool) {
+        self.layers_panel_open = open;
+        self.view.widget(cx, ids!(layers_panel)).set_visible(cx, open);
+        self.sync_tools(cx);
+        self.view.redraw(cx);
+    }
+
+    fn choose_style(&mut self, cx: &mut Cx, theme: Option<u32>) {
+        match theme {
+            Some(theme) => {
+                self.layers.theme = theme;
+                self.save_theme(cx);
+            }
+            None => {
+                self.theme_chosen = false;
+                self.layers.theme = u32::from(self.dark);
+                if let Some(storage) = self.storage.clone() {
+                    self.theme_preference.forget(cx, &storage);
+                }
+            }
+        }
+        self.layers.dirty = false;
+        self.apply_layers(cx);
+        self.map_catching_up(cx, true);
+        self.desk_sync(cx);
+    }
+
+    /// What the popover asked for has the map building every tile in view, and
+    /// the old ones show until then: the popover says it is working on it.
+    pub(super) fn map_catching_up(&mut self, cx: &mut Cx, style: bool) {
+        self.side.catching_up = Some(CatchUp { style, since: cx.seconds_since_app_start() });
+        self.view.widget(cx, ids!(style_working)).set_visible(cx, style);
+        self.view.widget(cx, ids!(layers_working)).set_visible(cx, !style);
+        self.side.spin_frame = cx.new_next_frame();
+        self.view.redraw(cx);
+    }
+
+    /// One frame of whichever spinners are showing, and the end of the map's.
+    fn turn_spinners(&mut self, cx: &mut Cx) {
+        let mut again = false;
+        if let Some(since) = self.side.tiles_watch {
+            let spent = cx.seconds_since_app_start() - since;
+            let loading = self.map_tiles_state(cx).as_deref() == Some("loading");
+            // The map's own plate speaks for a map that is not there at all.
+            let map_up = matches!(self.map_probe.state, MapState::Ready | MapState::Unknown);
+            let say = loading && map_up && spent > TILES_QUIET_SECONDS && spent < TILES_WATCH_SECONDS;
+            if say != self.side.tiles_said {
+                self.side.tiles_said = say;
+                self.view.widget(cx, ids!(map_loading)).set_visible(cx, say);
+                self.view.redraw(cx);
+            }
+            if say {
+                self.view.widget(cx, ids!(map_loading_spin)).redraw(cx);
+            }
+            if (loading || spent < TILES_FLIGHT_SECONDS) && spent < TILES_WATCH_SECONDS {
+                again = true;
+            } else {
+                self.side.tiles_watch = None;
+            }
+        }
+        if self.location_state.is_waiting() {
+            self.view.widget(cx, ids!(location_wait_spin)).redraw(cx);
+            again = true;
+        }
+        if let Some(up) = self.side.catching_up {
+            let over = cx.seconds_since_app_start() - up.since > CATCH_UP_SECONDS;
+            if over || !self.map(cx).rebuilding() {
+                self.side.catching_up = None;
+                self.view.widget(cx, ids!(style_working)).set_visible(cx, false);
+                self.view.widget(cx, ids!(layers_working)).set_visible(cx, false);
+                self.view.widget(cx, ids!(layers_panel)).redraw(cx);
+            } else {
+                let spinner = if up.style { ids!(style_working) } else { ids!(layers_working) };
+                self.view.widget(cx, spinner).redraw(cx);
+                again = true;
+            }
+        }
+        if again {
+            self.side.spin_frame = cx.new_next_frame();
+        }
+    }
+
+    /// What location says: looking is said in the tool's own place, and what
+    /// went wrong on a plate under the toolbar, with what to do about it.
+    pub(super) fn desk_show_location(&mut self, cx: &mut Cx, status: &str) {
+        let (title, note, failed) = if status.starts_with("Locating") || status.starts_with("Location found") {
+            ("", "", false)
+        } else if status.starts_with("Permission denied") {
+            (
+                "Location Is Off",
+                "Allow location for this app in System Settings, then try again.",
+                true,
+            )
+        } else if status.contains("timed out") {
+            ("Can\u{2019}t Find Your Location", "It took too long. Try again in a moment.", true)
+        } else {
+            ("Can\u{2019}t Find Your Location", "This computer can\u{2019}t tell where it is right now.", true)
+        };
+        self.view.label(cx, ids!(location_status_text)).set_text(cx, title);
+        self.view.label(cx, ids!(location_status_note)).set_text(cx, note);
+        self.view.widget(cx, ids!(location_status_note)).set_visible(cx, !note.is_empty());
+        self.view.widget(cx, ids!(location_retry)).set_visible(cx, failed);
+        self.view.widget(cx, ids!(location_dismiss)).set_visible(cx, failed);
+        self.view.widget(cx, ids!(location_status)).set_visible(cx, !title.is_empty());
+        self.sync_location_tool(cx);
+        self.view.redraw(cx);
+    }
+
+    fn sync_location_tool(&mut self, cx: &mut Cx) {
+        let waiting = self.location_state.is_waiting();
+        let active = !waiting && self.position.is_some() && self.location_state == LocationState::Active;
+        self.view.widget(cx, ids!(location_wait)).set_visible(cx, waiting);
+        self.view.widget(cx, ids!(location_button)).set_visible(cx, !waiting && !active);
+        self.view.widget(cx, ids!(location_on)).set_visible(cx, active);
+        if waiting {
+            self.side.spin_frame = cx.new_next_frame();
+        }
+    }
+
+    // --- the map's menu ---------------------------------------------------------
+
+    /// While the map's menu is open, the pointer and the keys are its own.
+    pub(super) fn map_menu_event(&mut self, cx: &mut Cx, event: &Event) -> bool {
+        let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+        match self.side.context_menu.handle_event(cx, event, owner) {
+            ContextMenuEvent::Chosen(row) => {
+                self.map_menu_chose(cx, row);
+                true
+            }
+            ContextMenuEvent::Spent => true,
+            ContextMenuEvent::Ignored => false,
+        }
+    }
+
+    pub(super) fn draw_map_menu(&mut self, cx: &mut Cx2d) {
+        if self.side.context_menu.is_open() {
+            let uid = self.widget_uid();
+            let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+            self.side.context_menu.draw(cx, uid, owner);
+        }
+    }
+
+    /// A right press on the map: what can be done with that point, or with the
+    /// place whose pin it is. Nothing acts over a map that isn't there.
+    fn open_map_menu(&mut self, cx: &mut Cx, lon: f64, lat: f64, marker: u64) {
+        let pin = self.markers.name_of(marker).and_then(|name| self.side.place.iter().chain(self.side.results.iter()).find(|place| place.name == name)).cloned();
+        let on_pin = pin.is_some();
+        let place = pin.unwrap_or_else(|| Place::dropped_pin(lon, lat));
+        let up = !matches!(self.map_probe.state, MapState::Failed(_) | MapState::Loading);
+        let mut rows: Vec<(ContextRow, Option<MapCommand>)> = Vec::new();
+        if !on_pin {
+            // Directions has its own place in the sidebar, and a pin would take it away.
+            rows.push((ContextRow::new("Drop Pin", up && self.side.pane != Pane::Directions), Some(MapCommand::DropPin)));
+        }
+        rows.push((ContextRow::new("Directions To Here", up), Some(MapCommand::DirectionsTo)));
+        rows.push((ContextRow::new("Directions From Here", up), Some(MapCommand::DirectionsFrom)));
+        rows.push((ContextRow::rule(), None));
+        rows.push((ContextRow::new("Copy Coordinates", up), Some(MapCommand::CopyCoordinates)));
+        let (rows, commands): (Vec<_>, Vec<_>) = rows.into_iter().unzip();
+        self.side.map_commands = commands;
+        self.side.map_menu_place = Some(place);
+        let (abs, time) = self.side.pressed;
+        let owner = ContextMenuOwner { source: &self.view.source, template: self.popup_menu, area: self.view.area() };
+        self.side.context_menu.open(cx, owner, abs, time, rows);
+        self.view.redraw(cx);
+    }
+
+    fn map_menu_chose(&mut self, cx: &mut Cx, row: usize) {
+        let Some(Some(command)) = self.side.map_commands.get(row).copied() else { return };
+        let Some(place) = self.side.map_menu_place.clone() else { return };
+        match command {
+            MapCommand::DropPin => {
+                self.side.place_from_results = false;
+                self.open_place(cx, place);
+            }
+            MapCommand::DirectionsTo => self.directions_here(cx, End::To, place),
+            MapCommand::DirectionsFrom => self.directions_here(cx, End::From, place),
+            MapCommand::CopyCoordinates => cx.copy_to_clipboard(&coordinates_text(place.lat, place.lon)),
+        }
+    }
+
+    /// Everything the sidebar and the map's controls show, said again.
+    pub(super) fn desk_sync(&mut self, cx: &mut Cx) {
+        if !self.desk {
+            return;
+        }
+        let side = &self.side;
+        let open = side.open;
+        let pane = side.pane;
+        self.view.widget(cx, ids!(sidebar)).set_visible(cx, open);
+        self.view.widget(cx, ids!(side_space)).set_visible(cx, open);
+        self.view.widget(cx, ids!(lead_open)).set_visible(cx, open);
+        self.view.widget(cx, ids!(lead_closed)).set_visible(cx, !open);
+        self.view.widget(cx, ids!(search_tool)).set_visible(cx, !open);
+
+        let left = if open { SIDEBAR_WIDTH } else { 0.0 };
+        let top = if self.unified { 53.0 } else { 41.0 };
+        if self.side.map_margin != Some((left, top)) {
+            self.side.map_margin = Some((left, top));
+            let mut map_widget = self.view.widget(cx, ids!(map));
+            script_apply_eval!(cx, map_widget, {
+                use mod.prelude.widgets.*
+                margin: Inset{left: #(left) top: #(top)}
+            });
+            // On a Mac a right press on the map is a menu (`open_map_menu`), and
+            // Option-drag still turns it. The map says so only to a map with a
+            // function to call; elsewhere a right drag goes on turning it.
+            if self.unified {
+                script_apply_eval!(cx, map_widget, {
+                    on_context: |lat, lon, pin, x, y| nil
+                });
+            }
+        }
+
+        let side = &self.side;
+        let in_results = pane == Pane::Results;
+        let notice = if in_results || pane == Pane::Directions { side.notice.clone() } else { None };
+        let shows_rows = notice.is_none()
+            && match pane {
+                Pane::Home => !side.recents.is_empty(),
+                Pane::Results => true,
+                Pane::Place => false,
+                Pane::Directions => true,
+            };
+        let query_empty = side.query.is_empty();
+        let place = side.place.clone();
+        let from_results = side.place_from_results;
+        let route = side.route.as_ref().map(|r| (r.duration_s, r.length_m));
+        let mode = side.mode;
+        let recents_empty = side.recents.is_empty();
+        self.view.widget(cx, ids!(search_row)).set_visible(cx, pane != Pane::Directions);
+        self.view.widget(cx, ids!(search_clear)).set_visible(cx, !query_empty && pane != Pane::Directions);
+        self.view.widget(cx, ids!(home_pane)).set_visible(cx, pane == Pane::Home);
+        self.view.widget(cx, ids!(recents_note)).set_visible(cx, recents_empty);
+        self.view.widget(cx, ids!(place_pane)).set_visible(cx, pane == Pane::Place);
+        self.view.widget(cx, ids!(directions_pane)).set_visible(cx, pane == Pane::Directions);
+        self.view.widget(cx, ids!(side_list)).set_visible(cx, shows_rows);
+        self.view.widget(cx, ids!(side_state)).set_visible(cx, notice.is_some());
+        if pane == Pane::Home {
+            self.chat.side_rows = self.side.recents.iter().map(Place::row).collect();
+            self.chat.side_selected = None;
+        }
+
+        if let Some(notice) = &notice {
+            self.view.label(cx, ids!(side_state_title)).set_text(cx, notice.title);
+            self.view.label(cx, ids!(side_state_note)).set_text(cx, notice.note);
+            self.view.widget(cx, ids!(side_state_note)).set_visible(cx, !notice.note.is_empty());
+            self.view.widget(cx, ids!(side_spinner)).set_visible(cx, notice.busy);
+            self.view.widget(cx, ids!(side_state_glyph)).set_visible(cx, !notice.busy);
+            self.view.widget(cx, ids!(side_retry)).set_visible(cx, notice.retry.is_some());
+            // It says what it retries: the map's own button can be up beside it.
+            let words = match notice.retry {
+                Some(Retry::Route) => "Find Route Again",
+                _ => "Search Again",
+            };
+            self.view.button(cx, ids!(side_retry)).set_text(cx, words);
+        }
+
+        if let Some(place) = &place {
+            self.view.label(cx, ids!(place_name)).set_text(cx, &place.name);
+            self.view.label(cx, ids!(place_note)).set_text(cx, &place.note);
+        }
+        self.view
+            .button(cx, ids!(place_back))
+            .set_text(cx, if from_results { "Results" } else { "Back" });
+
+        self.view.widget(cx, ids!(route_summary)).set_visible(cx, route.is_some());
+        if let Some((seconds, meters)) = route {
+            self.view.label(cx, ids!(route_time)).set_text(cx, &time_text(seconds));
+            self.view.label(cx, ids!(route_length)).set_text(cx, &distance_text(meters));
+        }
+        let pairs: [(&[LiveId], &[LiveId], bool); 3] = [
+            (ids!(mode_car), ids!(mode_car_on), mode == TravelMode::Car),
+            (ids!(mode_foot), ids!(mode_foot_on), mode == TravelMode::Foot),
+            (ids!(mode_bike), ids!(mode_bike_on), mode == TravelMode::Bike),
+        ];
+        for (off, on, active) in pairs {
+            self.view.widget(cx, off).set_visible(cx, !active);
+            self.view.widget(cx, on).set_visible(cx, active);
+        }
+
+        let theme = self.layers.theme;
+        let chosen = self.theme_chosen;
+        let styles: [(&[LiveId], &[LiveId], bool); 4] = [
+            (ids!(style_auto), ids!(style_auto_on), !chosen),
+            (ids!(style_light), ids!(style_light_on), chosen && theme == 0),
+            (ids!(style_night), ids!(style_night_on), chosen && theme == 1),
+            (ids!(style_circuit), ids!(style_circuit_on), chosen && theme == 2),
+        ];
+        for (off, on, active) in styles {
+            self.view.widget(cx, off).set_visible(cx, !active);
+            self.view.widget(cx, on).set_visible(cx, active);
+        }
+        self.sync_map_tools(cx);
+        self.sync_location_tool(cx);
+        self.view.portal_list(cx, ids!(side_items)).redraw(cx);
+        self.view.redraw(cx);
+    }
+
+    fn sync_map_tools(&mut self, cx: &mut Cx) {
+        let map = self.map(cx);
+        let flat = map.tilt() < 5.0;
+        self.view.widget(cx, ids!(tilt_tool)).set_visible(cx, flat);
+        self.view.widget(cx, ids!(tilt_tool_on)).set_visible(cx, !flat);
+        let rotated = {
+            let rotation = map.rotation();
+            rotation > 0.5 && rotation < 359.5
+        };
+        self.view.widget(cx, ids!(compass_plate)).set_visible(cx, rotated);
+    }
+
+    /// The fields say what the state says: a new sheet may have rebuilt them.
+    pub(super) fn desk_styled(&mut self, cx: &mut Cx) {
+        self.chat.side_selected_color = self.text_selected;
+        // The script just said its own margin again.
+        self.side.map_margin = None;
+        if !self.side.recents_loaded {
+            self.side.recents_loaded = true;
+            if let Some(storage) = self.storage.clone() {
+                self.side.recents_load = Some(storage.get(cx, RECENTS_KEY));
+            }
+        }
+        if let Some(((lon, lat), zoom, tilt, rotation)) = self.side.camera {
+            let map = self.map(cx);
+            map.set_center(cx, lon, lat);
+            map.set_map_zoom(cx, zoom);
+            map.set_tilt(cx, tilt);
+            map.set_rotation(cx, rotation);
+        }
+        self.desk_sync(cx);
+    }
+
+    /// One event's worth of the sidebar: its timers, its answers, the keyboard.
+    pub(super) fn desk_event(&mut self, cx: &mut Cx, event: &Event) {
+        if self.on_storage(event) {
+            self.desk_sync(cx);
+        }
+        if let Event::MouseDown(down) = event {
+            self.side.pressed = (down.abs, down.time);
+        }
+        if self.side.spin_frame.is_event(event).is_some() {
+            self.turn_spinners(cx);
+        }
+        if self.side.search_timer.is_event(event).is_some() {
+            self.side.search_timer = Timer::empty();
+            self.run_search(cx);
+        }
+        if self.side.focus_frame.is_event(event).is_some() {
+            if let Some(field) = self.side.focus_after_frame {
+                // A pane just shown has not been drawn yet: nothing to focus.
+                if self.view.text_input(cx, field).area().is_valid(cx) {
+                    self.side.focus_after_frame = None;
+                    self.focus_field(cx, field);
+                } else {
+                    self.side.focus_frame = cx.new_next_frame();
+                }
+            }
+        }
+        for answer in self.side.api.handle_event(cx, event) {
+            self.on_api_answer(cx, answer);
+        }
+        if let Event::KeyDown(key) = event {
+            self.desk_key(cx, key);
+        }
+        // A press anywhere else in the window closes a popover, as on a Mac. Its own tool toggles it.
+        if let (true, Event::MouseDown(down)) = (self.layers_panel_open, event) {
+            let panel = self.view.widget(cx, ids!(layers_panel)).area().rect(cx);
+            let tool = self.view.widget(cx, ids!(layers_on)).area().rect(cx);
+            if !panel.contains(down.abs) && !tool.contains(down.abs) {
+                self.set_layers_open(cx, false);
+            }
+        }
+        // A press outside the window reaches it only as the window manager's word that the focus went.
+        if let (true, Event::Custom(json)) = (self.layers_panel_open, event) {
+            if json == r#"{"wm":{"Focus":{"focused":false}}}"# {
+                self.set_layers_open(cx, false);
+            }
+        }
+    }
+
+    /// Kept for the sheet to come; asked at the end of an event, so a new
+    /// sheet's script values never count.
+    pub(super) fn desk_note_camera(&mut self, cx: &mut Cx) {
+        let map = self.map(cx);
+        if let (Some(center), Some(zoom)) = (map.center(), map.map_zoom()) {
+            self.side.camera = Some((center, zoom, map.tilt(), map.rotation()));
+            let flat = map.tilt() < 5.0;
+            let shown = self.view.widget(cx, ids!(tilt_tool)).visible();
+            if flat != shown {
+                self.sync_map_tools(cx);
+            }
+        }
+    }
+
+    fn on_api_answer(&mut self, cx: &mut Cx, answer: NavApiEvent) {
+        match answer {
+            NavApiEvent::Search(results) => self.on_search_results(cx, &results),
+            NavApiEvent::Route { context, route } => {
+                if context.generation() == self.side.route_generation {
+                    self.apply_route(cx, route);
+                }
+            }
+            NavApiEvent::Failed { operation, retrying, route_generation, .. } if !retrying => match operation {
+                ApiOperation::Search => {
+                    self.side.notice = Some(SEARCH_FAILED);
+                    self.side.return_pending = false;
+                    self.chat.side_rows.clear();
+                    self.desk_sync(cx);
+                }
+                ApiOperation::Route if route_generation.map_or(true, |g| g == self.side.route_generation) => {
+                    self.side.notice = Some(ROUTE_FAILED);
+                    self.desk_sync(cx);
+                }
+                _ => {}
+            },
+            _ => {}
+        }
+    }
+
+    fn field_has_keyboard(&self, cx: &Cx) -> bool {
+        [ids!(search_input), ids!(from_input), ids!(to_input), ids!(prompt_input)]
+            .into_iter()
+            .any(|field| self.view.widget(cx, field).key_focus(cx))
+    }
+
+    fn desk_key(&mut self, cx: &mut Cx, key: &KeyEvent) {
+        let cmd = key.modifiers.logo;
+        let in_field = self.field_has_keyboard(cx);
+        match key.key_code {
+            KeyCode::KeyF if cmd => self.focus_search(cx),
+            KeyCode::KeyL if cmd => self.handle_location_click(cx),
+            KeyCode::KeyR if cmd => self.open_directions(cx),
+            KeyCode::KeyS if cmd && key.modifiers.control => {
+                self.side.closed_for_width = false;
+                let open = !self.side.open;
+                self.set_sidebar(cx, open);
+            }
+            KeyCode::Equals if cmd => self.zoom_by(cx, 1.0),
+            KeyCode::Minus if cmd => self.zoom_by(cx, -1.0),
+            KeyCode::Escape => self.desk_escape(cx),
+            KeyCode::Tab if self.side.pane == Pane::Directions => {
+                let from = self.view.widget(cx, ids!(from_input)).key_focus(cx);
+                let field = if from { ids!(to_input) } else { ids!(from_input) };
+                self.focus_field(cx, field);
+            }
+            KeyCode::ArrowUp | KeyCode::ArrowDown if !cmd && self.list_takes_arrows(cx, in_field) => {
+                let down = key.key_code == KeyCode::ArrowDown;
+                self.move_selection(cx, down);
+            }
+            KeyCode::ReturnKey if !cmd && !in_field => self.activate_selection(cx),
+            KeyCode::ArrowLeft if !cmd && !in_field => self.pan_by(cx, -PAN_POINTS, 0.0),
+            KeyCode::ArrowRight if !cmd && !in_field => self.pan_by(cx, PAN_POINTS, 0.0),
+            KeyCode::ArrowUp if !cmd && !in_field => self.pan_by(cx, 0.0, -PAN_POINTS),
+            KeyCode::ArrowDown if !cmd && !in_field => self.pan_by(cx, 0.0, PAN_POINTS),
+            _ => {}
+        }
+    }
+
+    /// The arrows walk the list while the search field has the keyboard, or
+    /// once a row is selected; otherwise they move the map.
+    fn list_takes_arrows(&self, cx: &Cx, in_field: bool) -> bool {
+        let list_up = !self.chat.side_rows.is_empty() && self.side.notice.is_none();
+        match self.side.pane {
+            Pane::Results => list_up && (!in_field || self.view.widget(cx, ids!(search_input)).key_focus(cx)),
+            Pane::Directions => list_up && (!in_field || self.chat.side_selected.is_some()),
+            Pane::Home | Pane::Place => false,
+        }
+    }
+
+    fn move_selection(&mut self, cx: &mut Cx, down: bool) {
+        let count = self.chat.side_rows.len();
+        if count == 0 {
+            return;
+        }
+        let next = match (self.chat.side_selected, down) {
+            (None, _) => 0,
+            (Some(index), true) => (index + 1).min(count - 1),
+            (Some(index), false) => index.saturating_sub(1),
+        };
+        self.row_selected(cx, next);
+    }
+
+    /// A row got the selection, by a click or the arrows.
+    fn row_selected(&mut self, cx: &mut Cx, index: usize) {
+        match self.side.rows_are {
+            Rows::Results => self.select_result(cx, index),
+            Rows::Steps => {
+                self.chat.side_selected = Some(index);
+                let at = self.side.route.as_ref().and_then(|r| r.maneuvers.get(index)).map(|m| m.at);
+                if let Some(at) = at {
+                    let map = self.map(cx);
+                    let zoom = map.map_zoom().unwrap_or(13.0).max(16.0);
+                    map.fly_to(cx, at.lon, at.lat, zoom);
+                }
+                self.desk_sync(cx);
+            }
+            Rows::Choices(_) | Rows::Recents => {
+                self.chat.side_selected = Some(index);
+                self.desk_sync(cx);
+            }
+        }
+    }
+
+    fn activate_selection(&mut self, cx: &mut Cx) {
+        if let Some(index) = self.chat.side_selected {
+            self.row_activated(cx, index);
+        }
+    }
+
+    /// A row was clicked, or Return pressed on it.
+    fn row_activated(&mut self, cx: &mut Cx, index: usize) {
+        match self.side.rows_are {
+            Rows::Results => self.open_result(cx, index),
+            Rows::Recents => {
+                if let Some(place) = self.side.recents.get(index).cloned() {
+                    self.side.place_from_results = false;
+                    self.open_place(cx, place);
+                }
+            }
+            Rows::Choices(end) => {
+                if let Some(place) = self.side.results.get(index).cloned() {
+                    self.choose_for(cx, end, place);
+                }
+            }
+            Rows::Steps => self.row_selected(cx, index),
+        }
+    }
+
+    /// Escape: a popover first, then a step back through the sidebar.
+    fn desk_escape(&mut self, cx: &mut Cx) {
+        if self.layers_panel_open {
+            self.set_layers_open(cx, false);
+        } else if self.assistant_panel_open {
+            self.close_assistant_panel(cx);
+        } else if self.view.widget(cx, ids!(location_retry)).visible() {
+            self.dismiss_location(cx);
+        } else {
+            self.side_back(cx);
+        }
+    }
+
+    fn dismiss_location(&mut self, cx: &mut Cx) {
+        self.location_text = None;
+        self.view.widget(cx, ids!(location_status)).set_visible(cx, false);
+        self.view.widget(cx, ids!(location_retry)).set_visible(cx, false);
+        self.view.redraw(cx);
+    }
+
+    fn retry_notice(&mut self, cx: &mut Cx) {
+        let retry = self.side.notice.as_ref().and_then(|n| n.retry);
+        match retry {
+            Some(Retry::Search) => {
+                self.side.notice = None;
+                self.run_search(cx);
+            }
+            Some(Retry::Route) => {
+                self.side.notice = None;
+                self.route_if_ready(cx);
+            }
+            None => {}
+        }
+    }
+
+    pub(super) fn desk_actions(&mut self, cx: &mut Cx, actions: &Actions) {
+        if self.view.button(cx, ids!(side_toggle)).clicked(actions) {
+            self.side.closed_for_width = false;
+            let open = !self.side.open;
+            self.set_sidebar(cx, open);
+        }
+        if self.view.button(cx, ids!(search_tool)).clicked(actions) {
+            self.focus_search(cx);
+        }
+        let search = self.view.text_input(cx, ids!(search_input));
+        if let Some(text) = search.changed(actions) {
+            self.search_typed(cx, &text, Rows::Results);
+        }
+        if search.returned(actions).is_some() {
+            if self.side.notice.is_none() && self.side.search_timer.is_empty() && !self.side.results.is_empty() {
+                self.answer_search_return(cx);
+            } else if !self.side.query.is_empty() {
+                self.side.searching_for = Rows::Results;
+                self.side.return_pending = true;
+                self.run_search(cx);
+            }
+        }
+        if self.view.button(cx, ids!(search_clear)).clicked(actions) {
+            self.clear_search(cx);
+            self.focus_field(cx, ids!(search_input));
+            self.focus_later(cx, ids!(search_input));
+        }
+        if self.view.button(cx, ids!(home_directions)).clicked(actions)
+            || self.view.button(cx, ids!(place_directions)).clicked(actions)
+        {
+            self.open_directions(cx);
+        }
+        if self.view.button(cx, ids!(home_location)).clicked(actions) {
+            self.handle_location_click(cx);
+        }
+        if self.view.button(cx, ids!(place_back)).clicked(actions)
+            || self.view.button(cx, ids!(directions_back)).clicked(actions)
+        {
+            self.side_back(cx);
+        }
+        if self.view.button(cx, ids!(side_retry)).clicked(actions) {
+            self.retry_notice(cx);
+        }
+        for (end, field) in [(End::From, ids!(from_input)), (End::To, ids!(to_input))] {
+            let input = self.view.text_input(cx, field);
+            if let Some(text) = input.changed(actions) {
+                self.end_typed(cx, end, &text);
+            }
+            if input.returned(actions).is_some() {
+                self.end_returned(cx, end);
+            }
+        }
+        if self.view.button(cx, ids!(directions_swap)).clicked(actions) {
+            let from = self.side.from.place.clone();
+            let to = self.side.to.place.clone();
+            self.clear_route(cx);
+            self.set_end(cx, End::From, to);
+            self.set_end(cx, End::To, from);
+            self.route_if_ready(cx);
+            self.desk_sync(cx);
+        }
+        for (off, on, mode) in [
+            (ids!(mode_car), ids!(mode_car_on), TravelMode::Car),
+            (ids!(mode_foot), ids!(mode_foot_on), TravelMode::Foot),
+            (ids!(mode_bike), ids!(mode_bike_on), TravelMode::Bike),
+        ] {
+            if self.view.button(cx, off).clicked(actions) || self.view.button(cx, on).clicked(actions) {
+                self.set_mode(cx, mode);
+            }
+        }
+        for (off, on, theme) in [
+            (ids!(style_auto), ids!(style_auto_on), None),
+            (ids!(style_light), ids!(style_light_on), Some(0)),
+            (ids!(style_night), ids!(style_night_on), Some(1)),
+            (ids!(style_circuit), ids!(style_circuit_on), Some(2)),
+        ] {
+            if self.view.button(cx, off).clicked(actions) || self.view.button(cx, on).clicked(actions) {
+                self.choose_style(cx, theme);
+            }
+        }
+        if self.view.button(cx, ids!(zoom_in)).clicked(actions) {
+            self.zoom_by(cx, 1.0);
+        }
+        if self.view.button(cx, ids!(zoom_out)).clicked(actions) {
+            self.zoom_by(cx, -1.0);
+        }
+        if self.view.button(cx, ids!(tilt_tool)).clicked(actions) {
+            self.map(cx).set_tilt(cx, TILT_3D);
+            self.sync_map_tools(cx);
+            self.view.redraw(cx);
+        }
+        if self.view.button(cx, ids!(tilt_tool_on)).clicked(actions) {
+            self.map(cx).set_tilt(cx, 0.0);
+            self.sync_map_tools(cx);
+            self.view.redraw(cx);
+        }
+        if self.view.button(cx, ids!(compass_tool)).clicked(actions) {
+            self.map(cx).set_rotation(cx, 0.0);
+            self.sync_map_tools(cx);
+            self.view.redraw(cx);
+        }
+        if self.view.button(cx, ids!(location_retry)).clicked(actions) {
+            self.handle_location_click(cx);
+        }
+        if self.view.button(cx, ids!(location_dismiss)).clicked(actions) {
+            self.dismiss_location(cx);
+        }
+        if self.view.button(cx, ids!(location_on)).clicked(actions) {
+            self.handle_location_click(cx);
+        }
+        let list = self.view.portal_list(cx, ids!(side_items));
+        for (index, item) in list.items_with_actions(actions) {
+            if item.button(cx, ids!(row_btn)).clicked(actions) || item.view(cx, ids!(row_hit)).finger_up(actions).is_some() {
+                self.row_activated(cx, index);
+            }
+        }
+        let map = self.map(cx);
+        for action in actions.filter_widget_actions_cast::<MapViewAction>(map.widget_uid()) {
+            if let MapViewAction::ContextPressed { lon, lat, marker, .. } = action {
+                self.open_map_menu(cx, lon, lat, marker);
+            }
+        }
+        if let Some(id) = map.marker_clicked(actions) {
+            let name = self.markers.name_of(id).map(str::to_string);
+            let index = name.and_then(|name| self.side.results.iter().position(|p| p.name == name));
+            if let Some(index) = index {
+                if self.side.pane == Pane::Results {
+                    self.select_result(cx, index);
+                } else {
+                    self.open_result(cx, index);
+                }
+            }
+        }
+        if let Some((lon, lat)) = map.long_pressed(actions) {
+            self.side.place_from_results = false;
+            self.open_place(cx, Place::dropped_pin(lon, lat));
+        }
+        if let Some((lon, lat, info)) = map.pin_tapped(actions) {
+            let field = |key: &str| info.iter().find(|(k, _)| k == key).map(|(_, v)| v.clone());
+            let name = field("name").or_else(|| field("operator")).unwrap_or_else(|| "Marked Place".to_string());
+            let note = [field("kind"), field("operator"), field("max_kw").map(|kw| format!("{kw} kW")), field("city")]
+                .into_iter()
+                .flatten()
+                .collect::<Vec<_>>()
+                .join(" · ");
+            self.side.place_from_results = false;
+            self.open_place(cx, Place { name, note, lon, lat });
+        }
+        // A click on the map closes a popover, as on a Mac.
+        if map.tapped(actions).is_some() && self.layers_panel_open {
+            self.set_layers_open(cx, false);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn two_dropped_pins_are_two_ends_a_person_can_tell_apart() {
+        let one = Place::dropped_pin(4.8952, 52.3702);
+        let two = Place::dropped_pin(4.8836, 52.3637);
+        assert_eq!(one.name, two.name);
+        assert_ne!(one.end_name(), two.end_name());
+        // In the words Copy Coordinates copies, and the pin's card says under its name.
+        assert_eq!(one.end_name(), "52.3702, 4.8952");
+        assert_eq!(one.end_name(), one.note);
+        let named = Place { name: "Rijksmuseum".to_string(), note: "Museum".to_string(), lon: 4.8852, lat: 52.36 };
+        assert_eq!(named.end_name(), "Rijksmuseum");
+    }
+}
