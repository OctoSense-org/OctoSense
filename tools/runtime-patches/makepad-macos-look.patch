+    /// Try Again: the same address once more; what covers the page stays
+    /// until the answer.
+    fn retry_failed_page(&mut self, cx: &mut Cx) {
+        let info = self
+            .with_webview(cx, |_cx, wv| wv.active_info())
+            .unwrap_or_default();
+        let engine_failed = self
+            .with_webview(cx, |_cx, wv| wv.engine_error().is_some())
+            .unwrap_or(false);
+        if engine_failed {
+            self.with_webview(cx, |cx, wv| wv.retry_engine(cx));
+            self.refresh_chrome(cx);
+            return;
+        }
+        if let Some(check) = info.id.and_then(|id| self.load_checks.get_mut(&id)) {
+            check.looked = false;
+        }
+        let url = info.url.clone();
+        self.with_webview(cx, |cx, wv| wv.navigate(cx, &url));
+        self.refresh_chrome(cx);
+    }
