+        let shape = HostShape::new(host, Some(rounded(0.0, -50.0, 100.0, 150.0, 12.0)), &[]);
+        let picture = drawn(&shape, 1.0);
+        assert_eq!(at(&picture, 0, 99), 0, "the bottom left corner");
+        assert_eq!(at(&picture, 99, 99), 0, "the bottom right corner");
+        assert_eq!(at(&picture, 50, 99), 255, "between them");
+        assert_eq!(at(&picture, 0, 0), 255, "the view's top, which is mid window");
+    }
+
+    /// A click goes through a real view tree: to the page where it shows, past it where not.
+    #[test]
+    fn a_hidden_part_takes_no_click() {
+        unsafe {
+            let frame = |x: f64, y: f64, w: f64, h: f64| NSRect {
+                origin: NSPoint { x, y },
+                size: NSSize { width: w, height: h },
+            };
+            let parent: ObjcId = msg_send![class!(NSView), alloc];
+            let parent: ObjcId = msg_send![parent, initWithFrame: frame(0.0, 0.0, 400.0, 300.0)];
+            let host: ObjcId = msg_send![web_host_class(), alloc];
+            // 100 up from the parent's bottom, y up.
+            let host: ObjcId = msg_send![host, initWithFrame: frame(50.0, 100.0, 200.0, 100.0)];
+            let page: ObjcId = msg_send![class!(NSView), alloc];
+            let page: ObjcId = msg_send![page, initWithFrame: frame(0.0, 0.0, 200.0, 100.0)];
+            let () = msg_send![host, addSubview: page];
+            let () = msg_send![parent, addSubview: host];
+            let hit = |x: f64, y: f64| -> ObjcId { msg_send![parent, hitTest: NSPoint { x, y }] };
+            assert_eq!(hit(100.0, 150.0), page, "all shows: the page");
+            let top_right_cut = HostShape::new(
+                Rect { pos: dvec2(0.0, 0.0), size: dvec2(200.0, 100.0) },
+                None,
+                &[rounded(150.0, 0.0, 50.0, 50.0, 0.0)],
+            );
+            HOST_SHAPES.with(|shapes| shapes.borrow_mut().insert(host as usize, top_right_cut));
+            // The host's top right is at the parent's x 200..250, y 150..200.
+            assert_eq!(hit(225.0, 175.0), parent, "the cut goes to the window");
+            assert_eq!(hit(225.0, 125.0), page, "below the cut, the page");
+            assert_eq!(hit(100.0, 175.0), page, "left of the cut, the page");
+            assert_eq!(hit(10.0, 10.0), parent, "outside the host");
+            HOST_SHAPES.with(|shapes| shapes.borrow_mut().remove(&(host as usize)));
+            assert_eq!(hit(225.0, 175.0), page, "whole again: the page");
+        }
+    }
