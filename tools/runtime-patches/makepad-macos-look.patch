+pub const POINTER_SCIENTIFIC_EXTRA: f64 = 300.0;
+/// A pointer's window at its natural size: the basic keys' width (four
+/// 56-point keys, three 4-point gaps and two 8-point edges) and, under the
+/// toolbar, the height of the display (104 and its rule) and five 44-point
+/// rows of keys with their gaps and edges.
+pub const POINTER_BASIC_WIDTH: f64 = 252.0;
+pub const POINTER_KEYS_HEIGHT: f64 = 353.0;
+/// A pointer's toolbar under a window's title bar, and the one a Mac's unified
+/// window has instead of a title bar (`theme.ui_unified`): 52 points, the
