+/// How long a text may stay when `fits` says what a width can hold: the most
+/// of it that still fits with its ellipsis. A text that fits comes back whole.
+fn elide_to_fit(text: &str, mut fits: impl FnMut(&str) -> bool) -> String {
+    if fits(text) {
+        return text.to_string();
+    }
+    let chars: Vec<char> = text.chars().collect();
+    let cut_at = |at: usize| {
+        let mut cut: String = chars[..at].iter().collect();
+        cut.truncate(cut.trim_end().len());
+        cut.push('…');
+        cut
+    };
+    let (mut holds, mut over) = (0, chars.len());
+    while over - holds > 1 {
+        let at = (holds + over) / 2;
+        if fits(&cut_at(at)) {
+            holds = at;
+        } else {
+            over = at;
+        }
+    }
+    cut_at(holds)
+}
