+    /// The rows a Mac's menu bar shows for this window (`AppModule::menu_rows`):
+    /// the sidebar's row says what choosing it does.
+    pub fn menu_rows(&self) -> Vec<makepad_app_module::MenuRow> {
+        use makepad_app_module::MenuRow;
+        let sidebar = if self.side_hidden() { "Show Sidebar" } else { "Hide Sidebar" };
+        vec![
+            MenuRow::keyed("File", "New Reminder", "cmd+N"),
+            MenuRow::keyed("File", "New List\u{2026}", "shift+cmd+N"),
+            MenuRow::keyed("Edit", "Find\u{2026}", "cmd+F"),
+            MenuRow::keyed("View", sidebar, "ctrl+cmd+S"),
+        ]
+    }
+
+    /// The sidebar goes and comes back. In a window too narrow for it the
+    /// toggle shows it for as long as the window stays that narrow.
+    fn toggle_sidebar(&mut self, cx: &mut Cx) {
+        if self.narrow {
+            self.narrow_shown = !self.narrow_shown;
+        } else {
+            self.sidebar_hidden = !self.sidebar_hidden;
+        }
+        self.sync_chrome(cx);
+        self.view.redraw(cx);
+    }
+
+    /// A narrow list's toolbar keeps New Reminder beside a shorter field.
+    fn size_search(&mut self, cx: &mut Cx) {
+        if !self.pointer || self.last_size.x < 1.0 {
+            return;
+        }
+        let hidden = self.side_hidden();
+        let list = self.last_size.x - if hidden { 0.0 } else { 209.0 };
+        // The bar's ends, the lights' room and the sidebar's tool, New
+        // Reminder, the gaps between them and the field's own margin.
+        let lead = if hidden { (if self.unified { 76.0 } else { 0.0 }) + 32.0 } else { 0.0 };
+        let width = (list - 12.0 - 10.0 - lead - 32.0 - 4.0 - 12.0).clamp(96.0, 172.0);
+        if (width - self.search_width).abs() < 0.5 {
+            return;
+        }
+        self.search_width = width;
+        if let Some(mut search) = self.view.widget(cx, ids!(wide.columns.list.toolbar.search_box)).borrow_mut::<View>() {
+            search.walk.width = Size::Fixed(width);
+        }
+        self.view.redraw(cx);
+    }
+
+    /// Whether a pointer's sidebar is hidden now: by its toggle, or by a
+    /// window too narrow for it.
+    fn side_hidden(&self) -> bool {
+        if self.narrow {
+            !self.narrow_shown
+        } else {
+            self.sidebar_hidden
+        }
+    }
+
+    /// The person's choice, after the question: what can't be read gives way
+    /// to a new document.
+    fn start_over(&mut self, cx: &mut Cx) {
+        self.load_error = None;
+        self.machine = StorageMachine::default();
+        self.machine.phase = StoragePhase::Ready;
+        self.apply_load(cx, LoadOutcome::Seed);
+    }
+
+    // ---- a pointer's sheet about a list ----
+
+    fn list_sheet_parent(&self, cx: &mut Cx, compact: bool) -> WidgetRef {
+        if compact {
+            self.view.widget(cx, ids!(compact.list_sheet))
+        } else {
+            self.view.widget(cx, ids!(wide.list_sheet))
+        }
+    }
+
+    fn open_list_sheet(&mut self, cx: &mut Cx, mode: ListSheet) {
+        if mode.is_alert() {
+            // An alert leaves what is being typed as it is, and gives it the
+            // keys back when it goes.
+            if !self.list_sheet.is_some_and(ListSheet::is_alert) {
+                self.alert_focus = cx.key_focus();
+                self.alert_keys = self.keys_now(cx);
+            }
+            self.list_sheet = Some(mode);
+            self.list_sheet_error = None;
+            cx.set_key_focus(Area::Empty);
+            self.sync_list_sheet(cx);
+            return;
+        }
+        self.finish_adding(cx);
+        let (name, colour) = match mode {
+            ListSheet::New => {
+                if self.document.as_ref().is_some_and(|doc| doc.lists.len() >= MAX_LISTS) {
+                    return;
+                }
+                (String::new(), ListColour::Blue)
+            }
+            ListSheet::Edit(id) | ListSheet::Delete(id) => match self.document.as_ref().and_then(|doc| doc.list(id)) {
+                Some(list) => (list.name.clone(), list.colour),
+                None => return,
+            },
+            ListSheet::Unreadable | ListSheet::StartOver | ListSheet::NotSaved => return,
+        };
+        self.list_sheet = Some(mode);
+        self.list_sheet_name = name;
+        self.list_sheet_colour = ListColour::ALL.iter().position(|c| *c == colour).unwrap_or(0);
+        self.list_sheet_error = None;
+        self.sync_list_sheet(cx);
+        if !matches!(mode, ListSheet::Delete(_)) {
+            self.list_sheet_parent(cx, self.nav.layout.is_compact())
+                .text_input(cx, ids!(list_name))
+                .take_key_focus(cx);
+        }
+    }
+
+    fn close_list_sheet(&mut self, cx: &mut Cx) {
+        let alert = self.list_sheet.is_some_and(ListSheet::is_alert);
+        self.list_sheet = None;
+        self.sync_list_sheet(cx);
+        cx.set_key_focus(if alert { std::mem::take(&mut self.alert_focus) } else { Area::Empty });
+        if alert {
+            self.give_keys_back(cx);
+        }
+        // A save that failed behind another sheet is reported now.
+        self.ask_if_not_saved(cx);
+        self.view.redraw(cx);
+    }
+
+    /// Which of the fields that take typing has the keys now.
+    fn keys_now(&mut self, cx: &mut Cx) -> KeysBack {
+        if self.new_field(cx).is_some_and(|field| typing_in(cx, &field)) {
+            return KeysBack::NewRow;
+        }
+        let compact = self.nav.layout.is_compact();
+        if self.draft.is_some() {
+            let form = self.form_parent(cx, compact);
+            let title = form.text_input(cx, ids!(fields.text_group.title));
+            if typing_in(cx, &title) {
+                return KeysBack::DetailTitle;
+            }
+            let notes = form.text_input(cx, ids!(fields.text_group.notes));
+            if typing_in(cx, &notes) {
+                return KeysBack::DetailNotes;
+            }
+        }
+        let search = self.list_parent(cx, compact).text_input(cx, ids!(toolbar.search_box.search));
+        if typing_in(cx, &search) {
+            return KeysBack::Search;
+        }
+        KeysBack::Kept
+    }
+
+    /// An alert has gone: the field that had the keys has them again, as it
+    /// is drawn now.
+    fn give_keys_back(&mut self, cx: &mut Cx) {
+        let compact = self.nav.layout.is_compact();
+        match std::mem::take(&mut self.alert_keys) {
+            // The row takes them as it draws.
+            KeysBack::NewRow if self.adding.is_some() => self.adding_focus = true,
+            KeysBack::DetailTitle if self.draft.is_some() => {
+                self.form_parent(cx, compact).text_input(cx, ids!(fields.text_group.title)).take_key_focus(cx);
+            }
+            KeysBack::DetailNotes if self.draft.is_some() => {
+                self.form_parent(cx, compact).text_input(cx, ids!(fields.text_group.notes)).take_key_focus(cx);
+            }
+            KeysBack::Search => {
+                self.list_parent(cx, compact).text_input(cx, ids!(toolbar.search_box.search)).take_key_focus(cx);
+            }
+            _ => {}
+        }
+    }
+
+    /// A sheet's other way out: Cancel, Not Now, or an unreadable file's Start Over….
+    fn cancel_list_sheet(&mut self, cx: &mut Cx) {
+        match self.list_sheet {
+            Some(ListSheet::Unreadable) => self.open_list_sheet(cx, ListSheet::StartOver),
+            // Reminders that can't be read stay under their alert.
+            Some(ListSheet::StartOver) if self.load_error.is_some() => self.open_list_sheet(cx, ListSheet::Unreadable),
+            _ => self.close_list_sheet(cx),
+        }
+    }
+
+    /// A Mac reports a save that failed in an alert, once a failure: Not Now
+    /// leaves the window as it is, and the next change saves again.
+    fn ask_if_not_saved(&mut self, cx: &mut Cx) {
+        if self.pointer
+            && self.machine.error.is_some()
+            && !self.save_reported
+            && self.list_sheet.is_none()
+            && self.document.is_some()
+        {
+            self.save_reported = true;
+            self.open_list_sheet(cx, ListSheet::NotSaved);
+        }
+    }
+
+    fn sync_list_sheet(&mut self, cx: &mut Cx) {
+        if !self.pointer {
+            return;
+        }
+        let compact = self.nav.layout.is_compact();
+        // An alert shows over the window even before a document is read.
+        let up = self.list_sheet.is_some_and(|mode| mode.is_alert() || self.document.is_some());
+        self.view.widget(cx, ids!(wide.list_sheet)).set_visible(cx, up && !compact);
+        self.view.widget(cx, ids!(compact.list_sheet)).set_visible(cx, up && compact);
+        let Some(mode) = self.list_sheet else {
+            return;
+        };
+        let sheet = self.list_sheet_parent(cx, compact);
+        // A question before something goes: the red word and Cancel, the
+        // default. An alert: its other way and its default (`list_save`).
+        let question = matches!(mode, ListSheet::Delete(_) | ListSheet::StartOver);
+        let alert = matches!(mode, ListSheet::Unreadable | ListSheet::NotSaved);
+        let names = !question && !alert;
+        sheet.widget(cx, ids!(list_form)).set_visible(cx, names);
+        sheet.widget(cx, ids!(list_note)).set_visible(cx, !names);
+        sheet.button(cx, ids!(list_cancel)).set_visible(cx, !question);
+        sheet.button(cx, ids!(list_save)).set_visible(cx, !question);
+        sheet.button(cx, ids!(list_delete)).set_visible(cx, question);
+        sheet.button(cx, ids!(list_keep)).set_visible(cx, question);
+        let (other, default, red) = match mode {
+            ListSheet::Unreadable => ("Start Over…", "Try Again", "Delete"),
+            ListSheet::NotSaved => ("Not Now", "Try Again", "Delete"),
+            ListSheet::StartOver => ("Cancel", "OK", "Start Over"),
+            _ => ("Cancel", "OK", "Delete"),
+        };
+        for (path, text) in [(ids!(list_cancel), other), (ids!(list_save), default), (ids!(list_delete), red)] {
+            let button = sheet.widget(cx, path);
+            if button.text() != text {
+                button.set_text(cx, text);
+            }
+        }
+        let title = match mode {
+            ListSheet::New => "New List".to_string(),
+            ListSheet::Edit(_) => "List Info".to_string(),
+            ListSheet::Delete(_) => format!("Delete “{}”?", self.list_sheet_name),
+            ListSheet::Unreadable => "Your Reminders Can’t Be Opened".to_string(),
+            ListSheet::StartOver => "Start Over With No Reminders?".to_string(),
+            ListSheet::NotSaved => "Changes Not Saved".to_string(),
+        };
+        sheet.label(cx, ids!(list_title)).set_text(cx, &title);
+        let note = match mode {
+            ListSheet::Delete(id) => {
+                let total = self.document.as_ref().map_or(0, |doc| doc.reminders.iter().filter(|item| item.list_id == id).count());
+                match total {
+                    0 => "This can’t be undone.".to_string(),
+                    1 => "Its reminder goes with it. This can’t be undone.".to_string(),
+                    total => format!("Its {total} reminders go with it. This can’t be undone."),
+                }
+            }
+            ListSheet::Unreadable => "They couldn’t be read. Nothing has been changed.".to_string(),
+            ListSheet::StartOver => "The reminders that are saved will be replaced. This can’t be undone.".to_string(),
+            ListSheet::NotSaved => {
+                "Your latest changes couldn’t be saved. They stay in this window, and Reminders tries again with your next change.".to_string()
+            }
+            _ => String::new(),
+        };
+        if !names {
+            sheet.label(cx, ids!(list_note)).set_text(cx, &note);
+        }
+        let field = sheet.text_input(cx, ids!(list_name));
+        if field.text() != self.list_sheet_name {
+            field.set_text(cx, &self.list_sheet_name);
+        }
+        sheet.label(cx, ids!(list_error)).set_visible(cx, self.list_sheet_error.is_some());
+        sheet.label(cx, ids!(list_error)).set_text(cx, self.list_sheet_error.unwrap_or(""));
+        let valid = alert || (!self.list_sheet_name.trim().is_empty() && self.list_sheet_error.is_none());
+        sheet.button(cx, ids!(list_save)).set_enabled(cx, valid);
+        let save = sheet.widget(cx, ids!(list_save));
+        if save.disabled(cx) == valid {
+            save.set_disabled(cx, !valid);
+        }
+        for index in 0..ListColour::ALL.len() {
+            let mut dot = sheet.widget(cx, &[LiveId::from_str(&format!("colour_{index}"))]);
+            let ring = if index == self.list_sheet_colour { self.desk_muted } else { vec4(0.0, 0.0, 0.0, 0.0) };
+            apply_owned!(cx, self.source, dot, { draw_bg: {border_color: #(ring)} });
+        }
+        self.view.redraw(cx);
+    }
+
+    fn commit_list_sheet(&mut self, cx: &mut Cx) {
+        let Some(mode) = self.list_sheet else {
+            return;
+        };
+        let name = self.list_sheet_name.clone();
+        let colour = ListColour::ALL.get(self.list_sheet_colour).copied().unwrap_or(ListColour::Blue);
+        let command = match mode {
+            ListSheet::New => Command::CreateList { name, colour },
+            ListSheet::Edit(id) => Command::UpdateList { id, name, colour },
+            ListSheet::Delete(id) => Command::DeleteList { id },
+            ListSheet::Unreadable => {
+                self.close_list_sheet(cx);
+                self.try_loading_again(cx);
+                return;
+            }
+            ListSheet::StartOver => {
+                self.close_list_sheet(cx);
+                self.start_over(cx);
+                return;
+            }
+            ListSheet::NotSaved => {
+                self.close_list_sheet(cx);
+                // A Try Again that fails too asks again.
+                self.save_reported = false;
+                if self.machine.retry_save() {
+                    self.persist(cx);
+                }
+                return;
+            }
+        };
+        let result = self.document.as_mut().map(|doc| apply(doc, command, self.now));
+        match result {
+            Some(Err(CommandError::Rejected(message))) => {
+                self.list_sheet_error = Some(message);
+                self.sync_list_sheet(cx);
+            }
+            Some(Ok(())) => {
+                self.close_list_sheet(cx);
+                match mode {
+                    ListSheet::New => {
+                        if let Some(id) = self.document.as_ref().and_then(|doc| doc.lists.last()).map(|list| list.id) {
+                            self.open_filter(cx, Filter::List(id));
+                        }
+                    }
+                    ListSheet::Delete(id) if self.nav.filter == Filter::List(id) => {
+                        self.open_filter(cx, Filter::Today);
+                    }
+                    _ => {}
+                }
+                self.rebuild(cx);
+                self.persist(cx);
+            }
+            _ => self.close_list_sheet(cx),
+        }
+    }
+
+    fn list_sheet_key(&mut self, cx: &mut Cx, key: &KeyEvent) -> bool {
+        let Some(mode) = self.list_sheet else {
+            return false;
+        };
+        match key.key_code {
+            KeyCode::Escape => {
+                // Reminders that can't be read have no way round their alert.
+                if mode != ListSheet::Unreadable {
+                    self.cancel_list_sheet(cx);
+                }
+                true
+            }
+            KeyCode::ReturnKey | KeyCode::NumpadEnter => {
+                // A question before something goes: Cancel is its default; an
+                // alert's is Try Again.
+                if matches!(mode, ListSheet::Delete(_) | ListSheet::StartOver) {
+                    self.cancel_list_sheet(cx);
+                } else if mode.is_alert()
+                    || (!self.list_sheet_name.trim().is_empty() && self.list_sheet_error.is_none())
+                {
+                    self.commit_list_sheet(cx);
+                }
+                true
+            }
+            _ => false,
+        }
+    }
+
+    fn handle_list_sheet_clicks(&mut self, cx: &mut Cx, actions: &Actions) {
+        if self.list_sheet.is_none() {
+            return;
+        }
+        let sheet = self.list_sheet_parent(cx, self.nav.layout.is_compact());
+        if sheet.button(cx, ids!(list_cancel)).clicked(actions) || sheet.button(cx, ids!(list_keep)).clicked(actions) {
+            self.cancel_list_sheet(cx);
+            return;
+        }
+        if sheet.button(cx, ids!(list_save)).clicked(actions) || sheet.button(cx, ids!(list_delete)).clicked(actions) {
+            self.commit_list_sheet(cx);
+            return;
+        }
+        if let Some(text) = sheet.text_input(cx, ids!(list_name)).changed(actions) {
+            self.list_sheet_name = text;
+            self.list_sheet_error = None;
+            self.sync_list_sheet(cx);
+        }
+        for index in 0..ListColour::ALL.len() {
+            if sheet.view(cx, &[LiveId::from_str(&format!("colour_{index}"))]).finger_up(actions).is_some() {
+                self.list_sheet_colour = index;
+                self.sync_list_sheet(cx);
+            }
+        }
+    }
