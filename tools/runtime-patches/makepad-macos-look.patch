+/// The key a typed key stands for, on a Mac's US layout: what the Mac's
+/// Calculator lights when that key is typed.
+fn key_for_code(code: KeyCode, shift: bool) -> Option<&'static [LiveId]> {
+    let key: &'static [LiveId] = match (code, shift) {
+        (KeyCode::Key8, true) | (KeyCode::NumpadMultiply, _) => ids!(k_mul),
+        (KeyCode::Key5, true) => ids!(k_percent),
+        (KeyCode::Key9, true) => ids!(k_lparen),
+        (KeyCode::Key0, true) => ids!(k_rparen),
+        (KeyCode::Key6, true) => ids!(k_power),
+        (KeyCode::Key1, true) => ids!(k_fact),
+        (KeyCode::Equals, true) | (KeyCode::NumpadAdd, _) => ids!(k_add),
+        (KeyCode::Key0, false) | (KeyCode::Numpad0, _) => ids!(k_0),
+        (KeyCode::Key1, false) | (KeyCode::Numpad1, _) => ids!(k_1),
+        (KeyCode::Key2, false) | (KeyCode::Numpad2, _) => ids!(k_2),
+        (KeyCode::Key3, false) | (KeyCode::Numpad3, _) => ids!(k_3),
+        (KeyCode::Key4, false) | (KeyCode::Numpad4, _) => ids!(k_4),
+        (KeyCode::Key5, false) | (KeyCode::Numpad5, _) => ids!(k_5),
+        (KeyCode::Key6, false) | (KeyCode::Numpad6, _) => ids!(k_6),
+        (KeyCode::Key7, false) | (KeyCode::Numpad7, _) => ids!(k_7),
+        (KeyCode::Key8, false) | (KeyCode::Numpad8, _) => ids!(k_8),
+        (KeyCode::Key9, false) | (KeyCode::Numpad9, _) => ids!(k_9),
+        (KeyCode::Period, false) | (KeyCode::NumpadDecimal, _) => ids!(k_dot),
+        (KeyCode::Minus, false) | (KeyCode::NumpadSubtract, _) => ids!(k_sub),
+        (KeyCode::Slash, false) | (KeyCode::NumpadDivide, _) => ids!(k_div),
+        (KeyCode::Equals, false) | (KeyCode::ReturnKey, _) | (KeyCode::NumpadEnter, _) | (KeyCode::NumpadEquals, _) => {
+            ids!(k_eq)
+        }
+        (KeyCode::Backspace, _) | (KeyCode::Delete, _) => ids!(k_back),
+        (KeyCode::Escape, _) | (KeyCode::KeyC, false) => ids!(k_clear),
+        _ => return None,
+    };
+    Some(key)
+}
