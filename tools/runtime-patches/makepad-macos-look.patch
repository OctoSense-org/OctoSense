+/// What a person is told about a failure: no error numbers, no raw paths.
+fn plain_failure(message: &str) -> String {
+    let lower = message.to_lowercase();
+    if lower.contains("permission denied") || lower.contains("not permitted") {
+        return "You don’t have permission to do this.".to_string();
+    }
+    if lower.contains("no space left") {
+        return "There isn’t enough free space on the disk.".to_string();
+    }
+    if lower.contains("no such file") {
+        return "It can’t be found. It may have been moved or deleted.".to_string();
+    }
+    let text = message.split(" (os error").next().unwrap_or(message).trim();
+    if let Some(name) = text.strip_suffix(" already exists") {
+        let name = name.trim_matches('"');
+        return format!("The name “{name}” is already taken. Choose a different name.");
+    }
+    let text = text.replace('"', "");
+    match text.chars().last() {
+        Some('.') | None => text,
+        Some(_) => format!("{text}."),
+    }
 }
 
