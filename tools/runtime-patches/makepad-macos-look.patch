+            RegisterSort { column, ascending: !self.sort.ascending }
+        } else {
+            RegisterSort { column, ascending: column.sorts_ascending_first() }
+        };
+        self.rebuild_rows();
+        self.data_grid(cx, ids!(ledger_grid)).set_selection(cx, None);
+        self.select_next = self.register_kept;
+        self.top_next = self.register_kept.is_none();
