+    let name = name.trim();
+    if name.is_empty() {
+        return Err("A folder needs a name");
+    }
+    if name.chars().count() > MAX_FOLDER_NAME_CHARS {
+        return Err("That name is too long");
+    }
+    let builtin = Collection::ALL.iter().any(|c| c.label().eq_ignore_ascii_case(name));
+    if builtin || doc.folders.iter().any(|f| Some(f.id) != except && f.name.eq_ignore_ascii_case(name)) {
