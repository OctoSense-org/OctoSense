+/// A run of selected rows on a desktop.
+#[derive(Script, ScriptHook, Debug)]
+#[repr(C)]
+pub struct DrawRowSel {
+    #[deref]
+    draw_super: DrawQuad,
+    #[live]
+    pub color: Vec4f,
+    /// Half the top corners' radius; 0 where the run goes on above.
+    #[live]
+    pub top: f32,
+    /// Half the bottom corners' radius; 0 where the run goes on below.
+    #[live]
+    pub bottom: f32,
+}
+
+/// Which glyph an empty view shows.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum EmptyGlyph {
+    #[default]
+    Folder,
+    Trash,
+    Search,
+    Warn,
+    Filter,
+}
+
+/// The one thing an empty view offers to do.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum EmptyAction {
+    #[default]
+    None,
+    NewFolder,
+    ClearSearch,
+    ClearFilter,
+    TryAgain,
+}
+
+impl EmptyAction {
+    fn label(self) -> &'static str {
+        match self {
+            EmptyAction::None => "",
+            EmptyAction::NewFolder => "New Folder",
+            EmptyAction::ClearSearch => "Clear Search",
+            EmptyAction::ClearFilter => "Clear Filter",
+            EmptyAction::TryAgain => "Try Again",
+        }
+    }
+}
+
+/// What a desktop's view says when it has nothing to show.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct EmptyState {
+    pub glyph: EmptyGlyph,
+    pub title: String,
+    pub note: String,
+    pub action: EmptyAction,
