+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_bookmark_can_be_edited_and_a_visit_cannot() {
+        let titles = |kind| row_menu(kind).iter().map(|(_, title)| title.to_string()).collect::<Vec<_>>();
+        assert_eq!(titles(PlacesKind::Bookmarks), ["Open", "Open in New Tab", "Copy Link", "-", "Edit Bookmark\u{2026}", "Remove Bookmark"]);
+        assert_eq!(titles(PlacesKind::History), ["Open", "Open in New Tab", "Copy Link", "-", "Remove from History"]);
+    }
+
+    #[test]
+    fn a_search_keeps_the_rows_that_name_it_under_their_days() {
+        let page = |site: &str, name: &str| Line::Page { url: format!("https://{site}/"), name: name.into(), site: site.into(), time: String::new() };
+        let day = |name: &str| Line::Day(name.into());
+        let all = vec![day("Today"), page("a.test", "Apples"), page("b.test", "Bananas"), day("Yesterday"), page("c.test", "Cherries")];
+        assert_eq!(matching(&all, ""), all);
+        assert_eq!(matching(&all, " BAN "), [day("Today"), page("b.test", "Bananas")]);
+        assert_eq!(matching(&all, "c.test"), [day("Yesterday"), page("c.test", "Cherries")]);
+        assert_eq!(matching(&all, "https://"), all);
+        assert!(matching(&all, "zzz").is_empty());
+    }
+}
