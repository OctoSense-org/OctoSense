+/// A failed main-frame navigation is otherwise just a blank WKWebView. Auth
+/// browsers have their own delegate; ordinary readers report through the same
+/// page-error action the other platforms use.
+#[cfg(target_os = "macos")]
+struct ReaderNavigationState {
+    browser_id: u64,
+    navigation: std::cell::Cell<usize>,
+}
+
+#[cfg(target_os = "macos")]
+fn reader_navigation_delegate(state: &mut ReaderNavigationState) -> ObjcId {
+    static CLASS: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    let class = *CLASS.get_or_init(|| {
+        unsafe fn state(this: &Object) -> Option<&ReaderNavigationState> {
+            let ptr = *this.get_ivar::<*mut std::ffi::c_void>("reader_state");
+            (ptr as *const ReaderNavigationState).as_ref()
+        }
+        extern "C" fn started(this: &Object, _: Sel, _: ObjcId, navigation: ObjcId) {
+            unsafe {
+                if let Some(state) = state(this) { state.navigation.set(navigation as usize); }
+            }
+        }
+        extern "C" fn failed(this: &Object, _: Sel, _: ObjcId, navigation: ObjcId, error: ObjcId) {
+            unsafe {
+                let Some(state) = state(this) else { return; };
+                if navigation == nil || state.navigation.get() != navigation as usize || error == nil { return; }
+                let code: i64 = msg_send![error, code];
+                // WebKit sends cancellation when a navigation is intentionally replaced.
+                if code == -999 { return; }
+                let description: ObjcId = msg_send![error, localizedDescription];
+                let description = if description == nil { "The page could not load".to_string() }
+                    else { crate::os::apple::apple_util::nsstring_to_string(description) };
+                crate::cx::Cx::post_action(crate::event::NativeSystemBrowserPageError {
+                    browser_id: state.browser_id,
+                    code: code.clamp(i32::MIN as i64, i32::MAX as i64) as i32,
+                    description,
+                    url: String::new(),
+                });
+            }
+        }
+        let mut declaration = ClassDecl::new("MakepadReaderNavigationDelegate", class!(NSObject)).unwrap();
+        declaration.add_ivar::<*mut std::ffi::c_void>("reader_state");
+        unsafe {
+            declaration.add_method(sel!(webView:didStartProvisionalNavigation:), started as extern "C" fn(&Object, Sel, ObjcId, ObjcId));
+            declaration.add_method(sel!(webView:didFailNavigation:withError:), failed as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId));
+            declaration.add_method(sel!(webView:didFailProvisionalNavigation:withError:), failed as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId));
+            if let Some(protocol) = Protocol::get("WKNavigationDelegate") { declaration.add_protocol(protocol); }
+        }
+        declaration.register() as *const Class as usize
+    }) as *const Class;
+    unsafe {
+        let delegate: ObjcId = msg_send![class, new];
+        (*delegate).set_ivar("reader_state", state as *mut ReaderNavigationState as *mut std::ffi::c_void);
+        delegate
+    }
+}
