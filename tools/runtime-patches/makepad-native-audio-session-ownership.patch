+/// Exclusive ownership of the process's ordinary microphone route. A caller
+/// holds this while its callback or an OS speech recognizer can still capture.
+/// This is a host coordination primitive, never a device permission grant.
+#[derive(Debug)]
+pub struct AudioInputLease { _private: () }
+static INPUT_LEASED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+impl AudioInputLease {
+    pub fn try_acquire() -> Option<Self> {
+        INPUT_LEASED.compare_exchange(false, true, std::sync::atomic::Ordering::AcqRel,
+            std::sync::atomic::Ordering::Acquire).ok().map(|_| Self { _private: () })
+    }
+}
+impl Drop for AudioInputLease {
+    fn drop(&mut self) {
+        INPUT_LEASED.store(false, std::sync::atomic::Ordering::Release);
+    }
+}
