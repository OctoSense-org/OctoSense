+    /// Request Android's text-share chooser with an observable dispatch result.
+    /// `makepad.share_text.result` returns the same request id and `opened` or
+    /// `error`; opened means OS handoff only, never recipient selection/delivery.
+    /// Other backends explicitly reject this operation.
+    pub fn share_text_request(&mut self, request_id: &str, content: &str) -> Result<(), &'static str> {
+        if request_id.len() != 16 || !request_id.bytes().all(|b| b.is_ascii_hexdigit())
+            || content.is_empty() || content.len() > 8192 {
+            return Err("invalid_arguments: Invalid share id or text size");
+        }
+        #[cfg(target_os = "android")]
+        {
+            self.platform_ops.push_back(CxOsOp::ShareTextRequest {
+                request_id: request_id.into(), content: content.into(),
+            });
+            Ok(())
+        }
+        #[cfg(not(target_os = "android"))]
+        { Err("unsupported_platform: Text sharing is available on Android only") }
+    }
