 pub unsafe fn to_java_share_text(content: String) {
     let env = attach_jni_env();
-    // Strip interior NULs: a NUL in a Java string aborts in NewStringUTF.
-    let content = CString::new(content.replace('\0', "")).unwrap();
-    let content = ((**env).NewStringUTF.unwrap())(env, content.as_ptr());
-    ndk_utils::call_void_method!(
-        env,
-        get_activity(),
-        "shareText",
-        "(Ljava/lang/String;)V",
-        content
-    );
+    // JNI NewStringUTF expects modified UTF-8, not Rust UTF-8. UTF-16 preserves
+    // supplementary characters and embedded NULs without truncation.
+    let content = new_java_string(env, &content);
+    ndk_utils::call_void_method!(env, get_activity(), "shareText", "(Ljava/lang/String;)V", content);
+    (**env).DeleteLocalRef.unwrap()(env, content);
+}
+
+pub unsafe fn to_java_share_text_request(request_id: &str, content: &str) {
+    let env = attach_jni_env();
+    let request_id = new_java_string(env, request_id);
+    let content = new_java_string(env, content);
+    ndk_utils::call_void_method!(env, get_activity(), "shareTextRequest",
+        "(Ljava/lang/String;Ljava/lang/String;)V", request_id, content);
+    (**env).DeleteLocalRef.unwrap()(env, request_id);
+    (**env).DeleteLocalRef.unwrap()(env, content);
 }
 
