+    // Correlated outcome, using the existing bounded AndroidIntegration queue.
+    // No recipient or delivery claim: startActivity only hands off to the OS.
+    public void shareTextRequest(final String requestId, final String content) {
+        if (requestId == null || !requestId.matches("[a-fA-F0-9]{16}")) return;
+        runOnUiThread(() -> {
+            String outcome = "error";
+            String reason = "invalid_arguments";
+            try {
+                if (content != null && !content.isEmpty() && content.getBytes(java.nio.charset.StandardCharsets.UTF_8).length <= 8192) {
+                    reason = "foreground_required";
+                    if (!isFinishing() && !isDestroyed() && hasWindowFocus()) {
+                        reason = "unavailable";
+                        openTextShare(content);
+                        outcome = "opened";
+                        reason = "";
+                    }
+                }
+                org.json.JSONObject result = new org.json.JSONObject().put("id", requestId)
+                    .put("outcome", outcome).put("reason", reason);
+                emitShareTextResult(result.toString(), 0);
+            } catch (Exception error) {
+                try { emitShareTextResult(new org.json.JSONObject().put("id", requestId)
+                    .put("outcome", "error").put("reason", reason).toString(), 0); }
+                catch (org.json.JSONException ignored) { }
+            }
+        });
+    }
+
+    private void emitShareTextResult(final String payload, final int attempt) {
+        if (!MakepadNative.onAndroidIntegrationEvent("makepad.share_text.result", payload) && attempt < 4 && !isDestroyed()) {
+            new android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(
+                () -> emitShareTextResult(payload, attempt + 1), 50);
         }
     }
 
