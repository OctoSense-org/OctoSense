--- /dev/null
+++ b/widgets/src/splash_storage/commits.rs
@@ -0,0 +1,70 @@
+//! Serialize publication into one app jail. A worker can measure usage
+//! outside the lock and retry if a script or native writer changed it.
+use std::collections::{HashMap, HashSet};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, Mutex, OnceLock, Weak};
+
+#[derive(Default)]
+pub struct JailWrites {
+    version: Mutex<u64>,
+    private: Mutex<HashSet<PathBuf>>,
+}
+
+/// Keeps a host-created staging directory out of committed usage until
+/// its owner has removed it. Names alone never exempt app data.
+pub struct PrivateStage {
+    gate: Arc<JailWrites>,
+    relative: PathBuf,
+}
+
+impl Drop for PrivateStage {
+    fn drop(&mut self) {
+        self.gate.change(|| self.gate.private.lock().unwrap_or_else(|p| p.into_inner()).remove(&self.relative));
+    }
+}
+
+pub fn jail_writes(root: &Path) -> Arc<JailWrites> {
+    static JAILS: OnceLock<Mutex<HashMap<PathBuf, Weak<JailWrites>>>> = OnceLock::new();
+    let path = root.canonicalize().unwrap_or_else(|_| root.to_owned());
+    let mut jails = JAILS.get_or_init(Mutex::default).lock().unwrap_or_else(|p| p.into_inner());
+    if let Some(gate) = jails.get(&path).and_then(Weak::upgrade) {
+        return gate;
+    }
+    jails.retain(|_, gate| gate.strong_count() != 0);
+    let gate = Arc::new(JailWrites::default());
+    jails.insert(path, Arc::downgrade(&gate));
+    gate
+}
+
+impl JailWrites {
+    pub fn register_stage(self: &Arc<Self>, relative: PathBuf) -> PrivateStage {
+        self.change(|| self.private.lock().unwrap_or_else(|p| p.into_inner()).insert(relative.clone()));
+        PrivateStage { gate: self.clone(), relative }
+    }
+
+    pub fn private_dirs(&self) -> HashSet<PathBuf> {
+        self.private.lock().unwrap_or_else(|p| p.into_inner()).clone()
+    }
+
+    pub(super) fn change<T>(&self, change: impl FnOnce() -> T) -> T {
+        let mut version = self.version.lock().unwrap_or_else(|p| p.into_inner());
+        *version = version.wrapping_add(1);
+        change()
+    }
+
+    /// Publish only if the measurement still describes the same committed
+    /// files. Bulk work belongs before this call or in `measure`.
+    pub fn checked<T, R>(&self, mut measure: impl FnMut() -> T, publish: impl FnOnce(T) -> Result<R, String>) -> Result<R, String> {
+        // Continuous foreground activity must not occupy the worker forever.
+        for _ in 0..8 {
+            let before = *self.version.lock().unwrap_or_else(|p| p.into_inner());
+            let measured = measure();
+            let mut version = self.version.lock().unwrap_or_else(|p| p.into_inner());
+            if *version == before {
+                *version = version.wrapping_add(1);
+                return publish(measured);
+            }
+        }
+        Err("app storage kept changing during the write; try again".into())
+    }
+}
