+/// A worker may check whether the originating isolate still owns the same
+/// storage. Only the thread that owns the isolate can mint a lifetime.
+#[derive(Clone)]
+pub struct StorageLifetime(std::sync::Weak<()>);
+
+impl StorageLifetime {
+    pub fn is_live(&self) -> bool { self.0.strong_count() != 0 }
+}
+
+pub fn storage_lifetime_for_heap(heap_key: usize, app_id: &str) -> Option<StorageLifetime> {
+    storage_for_heap(heap_key, app_id)?;
+    SCOPE_LIFETIMES.with(|scopes| {
+        let mut scopes = scopes.borrow_mut();
+        Some(StorageLifetime(std::sync::Arc::downgrade(scopes.entry(heap_key).or_default())))
+    })
+}
+
+pub(crate) fn invalidate_scope(heap_key: usize) {
+    SCOPE_LIFETIMES.with(|scopes| scopes.borrow_mut().remove(&heap_key));
+}
