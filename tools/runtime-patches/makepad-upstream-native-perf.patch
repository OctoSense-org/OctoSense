+    args: A,
+) -> R
+where
+    T: Message,
+    A: MessageArguments,
+    R: Any,
+{
+    match send_super_message(obj, superclass, sel, args) {
+        Ok(r) => r,
+        Err(err) => message_failed(err),
+    }
+}
+
+#[doc(hidden)]
+#[inline]
+#[track_caller]
+#[cfg(feature = "verify_message")]
+pub unsafe fn send_super_message_or_panic<T, A, R>(
+    obj: *const T,
+    superclass: &Class,
+    sel: Sel,
+    args: A,
+) -> R
+where
+    T: Message,
+    A: MessageArguments + EncodeArguments,
+    R: Any + Encode,
+{
+    match send_super_message(obj, superclass, sel, args) {
+        Ok(r) => r,
+        Err(err) => message_failed(err),
+    }
+}
