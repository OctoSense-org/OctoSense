+use std::{cell::RefCell, collections::HashMap, rc::{Rc, Weak}};
+
+const MAX_OPEN_VIDEO_PLAYERS: usize = 64;
+const MAX_VIDEO_PLAYERS_PER_HEAP: usize = 16;
+struct VideoLifetime { heap: usize, owner: Weak<()> }
+thread_local! {
+    // Weak owners cannot keep a discarded widget alive. Only actual native
+    // players enter this bounded registry, not every Video prototype.
+    static VIDEO_PLAYERS: RefCell<HashMap<LiveId, VideoLifetime>> = RefCell::new(HashMap::new());
+}
+fn register_video_lifetime(heap: usize, id: LiveId, owner: &Rc<()>) -> bool {
+    VIDEO_PLAYERS.with(|players| {
+        let mut players = players.borrow_mut();
+        if let Some(existing) = players.get(&id) {
+            return existing.heap == heap && existing.owner.ptr_eq(&Rc::downgrade(owner));
+        }
+        if players.len() >= MAX_OPEN_VIDEO_PLAYERS
+            || players.values().filter(|player| player.heap == heap).count() >= MAX_VIDEO_PLAYERS_PER_HEAP {
+            return false;
+        }
+        players.insert(id, VideoLifetime { heap, owner: Rc::downgrade(owner) });
+        true
+    })
+}
+fn forget_video_lifetime(id: LiveId) {
+    VIDEO_PLAYERS.with(|players| { players.borrow_mut().remove(&id); });
+}
+fn take_retired_video_players(heap: Option<usize>) -> Vec<LiveId> {
+    VIDEO_PLAYERS.with(|players| {
+        let mut players = players.borrow_mut();
+        let ids: Vec<_> = players.iter().filter_map(|(id, player)| {
+            (player.owner.strong_count() == 0 || heap == Some(player.heap)).then_some(*id)
+        }).collect();
+        for id in &ids { players.remove(id); }
+        ids
+    })
+}
+fn release_video_players(cx: &mut Cx, heap: Option<usize>) {
+    for id in take_retired_video_players(heap) {
+        cx.cancel_pending_camera_playback(id);
+        cx.detach_camera_native_preview(id);
+        cx.cleanup_video_playback_resources(id);
+    }
+}
+/// Called by isolate close/GC, including plain file/network videos.
+pub(crate) fn release_isolate_videos(cx: &mut Cx, heap: usize) {
+    release_video_players(cx, Some(heap));
+}
+/// Drop has no Cx. The next UI signal/async pump retires its native player.
+pub(crate) fn drain_dropped_videos(cx: &mut Cx) {
+    release_video_players(cx, None);
+}
