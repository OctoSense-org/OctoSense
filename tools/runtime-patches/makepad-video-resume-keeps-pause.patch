+    #[test]
+    fn activity_resume_keeps_an_app_pause_made_while_the_os_held_playback() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let widget = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let value = crate::script_eval!(vm, {use mod.widgets.* Video{autoplay: false}});
+            WidgetRef::script_from_value(vm, value)
+        });
+        let mut video = widget.borrow_mut::<Video>().unwrap();
+        video.playback_state = PlaybackState::Playing;
+        video.handle_activity_events(&mut cx, &Event::Pause);
+        assert_eq!(video.playback_state, PlaybackState::Paused);
+        // The app's Splash pause (a timer, an agent) while the OS holds the
+        // player: accepted once, though the player is already paused.
+        assert_eq!(video.script_control(&mut cx, live_id!(pause_playback)), Some(true));
+        assert_eq!(video.script_control(&mut cx, live_id!(pause_playback)), Some(false));
+        video.handle_activity_events(&mut cx, &Event::Resume);
+        assert_eq!(video.playback_state, PlaybackState::Paused);
+    }
+
+    #[test]
+    fn activity_resume_starts_again_what_the_pause_cancelled_unless_the_app_said_otherwise() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let widget = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let value = crate::script_eval!(vm, {use mod.widgets.* Video{autoplay: false}});
+            WidgetRef::script_from_value(vm, value)
+        });
+        let mut video = widget.borrow_mut::<Video>().unwrap();
+        // No policy applies to bytes, and this Cx has no platform loop to
+        // hand the queued native prepare to.
+        video.set_source_in_memory(Rc::new(vec![0; 16]));
+        for app in [None, Some(live_id!(pause_playback)), Some(live_id!(stop_and_cleanup_resources))] {
+            video.begin_playback(&mut cx);
+            assert_eq!(video.playback_state, PlaybackState::Preparing);
+            let cancelled = video.id;
+            // A player prepared with autoplay would start on its own, so the
+            // pause cancels the start rather than holding it.
+            video.handle_activity_events(&mut cx, &Event::Pause);
+            assert_eq!(video.playback_state, PlaybackState::Unprepared);
+            assert!(!VIDEO_PLAYERS.with(|players| players.borrow().contains_key(&cancelled)));
+            if let Some(method) = app {
+                assert_eq!(video.script_control(&mut cx, method), Some(true));
+            }
+            video.handle_activity_events(&mut cx, &Event::Resume);
+            if app.is_some() {
+                assert_eq!(video.playback_state, PlaybackState::Unprepared);
+                assert!(!video.autoplay);
+                continue;
+            }
+            assert_eq!(video.playback_state, PlaybackState::Preparing);
+            assert!(video.autoplay);
+            assert_ne!(video.id, cancelled);
+            assert!(VIDEO_PLAYERS.with(|players| players.borrow().contains_key(&video.id)));
+            video.stop_and_cleanup_resources(&mut cx);
+        }
+        // A camera's start is CameraPreview's to make again, after its checks.
+        video.in_memory_source = None;
+        video.source = VideoDataSource::Camera { input_id: LiveId(1), format_id: LiveId(2) };
+        video.playback_state = PlaybackState::Preparing;
+        video.autoplay = true;
+        video.handle_activity_events(&mut cx, &Event::Pause);
+        video.handle_activity_events(&mut cx, &Event::Resume);
+        assert_eq!(video.playback_state, PlaybackState::Unprepared);
+        assert!(!video.autoplay && video.last_error.is_none());
+    }
