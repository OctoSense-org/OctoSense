+#[cfg(test)]
+mod availability_tests {
+    use super::*;
+
+    #[test]
+    fn unsupported_platform_never_starts_browser_lifecycle() {
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        let mut reader = cx.with_vm(|vm| {
+            crate::script_mod(vm);
+            let value = vm.eval(script! { use mod.widgets.* WebReader {} });
+            WebReader::script_from_value(vm, value)
+        });
+        for platform in ["linux", "windows", "freebsd", "unknown"] {
+            assert!(!reader.open_on_platform(&mut cx, "https://example.test/", platform));
+            assert!(!reader.open);
+            assert!(!reader.spawned);
+            assert!(reader.last_error.contains("unavailable"));
+            assert!(reader.timer.is_none());
+            assert!(reader.url.is_none());
+        }
+    }
+}
