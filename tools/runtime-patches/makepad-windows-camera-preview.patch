diff --git a/platform/src/os/windows/windows_camera_player.rs b/platform/src/os/windows/windows_camera_player.rs
new file mode 100644
index 0000000..060c7bb
--- /dev/null
+++ b/platform/src/os/windows/windows_camera_player.rs
@@ -0,0 +1,84 @@
+//! Media Foundation camera frames as a bounded latest-frame video source.
+use {
+    super::media_foundation::MediaFoundationAccess,
+    crate::{
+        media_plugin::PlaybackPrepared,
+        video::{CameraFrameInputFn, CameraFrameOwned, CameraFramePool, CameraFrameRef, VideoFormatId, VideoInputId},
+    },
+    std::{sync::{Arc, Mutex}, time::{Duration, Instant}},
+};
+
+pub struct WindowsCameraPlayer {
+    frame_pool: Arc<Mutex<CameraFramePool>>,
+    access: Option<Arc<Mutex<MediaFoundationAccess>>>,
+    started: Instant,
+    prepared: bool,
+    playing: bool,
+}
+
+impl WindowsCameraPlayer {
+    pub fn new(input_id: VideoInputId, format_id: VideoFormatId,
+               access: Arc<Mutex<MediaFoundationAccess>>, autoplay: bool) -> Self {
+        let frame_pool = Arc::new(Mutex::new(CameraFramePool::new(4)));
+        let pending = frame_pool.clone();
+        let callback: CameraFrameInputFn = Box::new(move |source: CameraFrameRef<'_>| {
+            let mut pool = pending.lock().unwrap();
+            let mut frame = pool.checkout();
+            if frame.convert_to_i420(source) {
+                pool.publish_latest(frame);
+            } else {
+                pool.recycle(frame);
+            }
+        });
+        {
+            let mut camera = access.lock().unwrap();
+            *camera.camera_frame_input_cb[0].lock().unwrap() = Some(callback);
+            *camera.video_input_cb[0].lock().unwrap() = None;
+            camera.use_video_input(&[(input_id, format_id)]);
+        }
+        Self { frame_pool, access: Some(access), started: Instant::now(),
+            prepared: false, playing: autoplay }
+    }
+
+    pub fn check_prepared(&mut self) -> Option<Result<PlaybackPrepared, String>> {
+        if self.prepared { return None; }
+        let mut pool = self.frame_pool.lock().unwrap();
+        if let Some(frame) = pool.take_latest() {
+            let (width, height) = (frame.width as u32, frame.height as u32);
+            pool.publish_latest(frame);
+            self.prepared = true;
+            return Some(Ok(PlaybackPrepared::new(width, height, 0, false,
+                vec!["camera".to_string()], vec![])));
+        }
+        if self.started.elapsed() > Duration::from_secs(6) {
+            self.prepared = true;
+            return Some(Err("Camera did not deliver a video frame".to_string()));
+        }
+        None
+    }
+
+    pub fn take_frame(&self) -> Option<CameraFrameOwned> {
+        if self.playing { self.frame_pool.lock().unwrap().take_latest() } else { None }
+    }
+
+    pub fn recycle_frame(&self, frame: CameraFrameOwned) {
+        self.frame_pool.lock().unwrap().recycle(frame);
+    }
+
+    pub fn is_playing(&self) -> bool { self.playing }
+    pub fn keep_polling(&self) -> bool { !self.prepared || self.playing }
+    pub fn play(&mut self) { self.playing = true; }
+    pub fn pause(&mut self) { self.playing = false; }
+    pub fn cleanup(&mut self) {
+        if let Some(access) = self.access.take() {
+            let mut camera = access.lock().unwrap();
+            camera.use_video_input(&[]);
+            *camera.camera_frame_input_cb[0].lock().unwrap() = None;
+        }
+        self.playing = false;
+    }
+}
+
+impl Drop for WindowsCameraPlayer {
+    fn drop(&mut self) { self.cleanup(); }
+}
