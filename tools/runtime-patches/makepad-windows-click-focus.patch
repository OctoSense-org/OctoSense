+// WA_CLICKACTIVE is 2 in WinUser.h, but this pinned windows-rs binding omits it.
+const WA_CLICKACTIVE_VALUE: usize = 2;
+
+fn window_activation_gained(wparam: usize) -> bool {
+    let state = wparam & 0xffff;
+    state == WA_ACTIVE as usize || state == WA_CLICKACTIVE_VALUE
+}
+
+#[cfg(test)]
+mod activation_tests {
+    use super::*;
+
+    #[test]
+    fn mouse_and_programmatic_activation_gain_focus_but_deactivation_loses_it() {
+        assert!(window_activation_gained(WA_ACTIVE as usize));
+        assert!(window_activation_gained(WA_CLICKACTIVE_VALUE));
+        assert!(window_activation_gained((1 << 16) | WA_CLICKACTIVE_VALUE));
+        assert!(!window_activation_gained(0));
+    }
+}
