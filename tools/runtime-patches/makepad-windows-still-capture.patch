+//! Bounded still capture; the UI never waits for the camera or file IO.
+use crate::{cx::Cx, video::*};
+use std::{
+    fs::OpenOptions,
+    io::Write,
+    path::Path,
+    sync::{
+        atomic::{AtomicBool, AtomicU64, Ordering},
+        mpsc::{sync_channel, Receiver, SyncSender},
+        Arc, OnceLock,
+    },
+    time::{Duration, Instant},
+};
+
+const PHASE: u64 = 7;
+const ARMING: u64 = 1;
+const WAITING: u64 = 2;
+const FRAME: u64 = 3;
+const WRITING: u64 = 4;
+const CANCELLED: u64 = 5;
+const MAX_BYTES: usize = 32 * 1024 * 1024;
+const MAX_PIXELS: usize = 8 * 1024 * 1024;
+const DEADLINE: Duration = Duration::from_secs(10);
+
+struct Shared {
+    state: AtomicU64,
+    closed: AtomicBool,
+}
+struct Request {
+    ticket: u64,
+    path: String,
+    deadline: Instant,
+}
+enum Command {
+    Start(Request),
+    Frame {
+        ticket: u64,
+        format: VideoFormat,
+        bytes: Result<Arc<[u8]>, String>,
+    },
+}
+pub(super) struct StillCapture {
+    input: VideoInputId,
+    shared: Arc<Shared>,
+    worker: OnceLock<Result<SyncSender<Command>, String>>,
+}
+impl StillCapture {
+    pub fn new(input: VideoInputId) -> Self {
+        Self {
+            input,
+            shared: Arc::new(Shared {
+                state: AtomicU64::new(0),
+                closed: AtomicBool::new(false),
+            }),
+            worker: OnceLock::new(),
+        }
+    }
+    pub fn request(&self, path: String) -> Result<(), String> {
+        if self.shared.closed.load(Ordering::Acquire) {
+            return Err("Camera is closed".into());
+        }
+        if !Path::new(&path).is_absolute() {
+            return Err("Capture path must be absolute".into());
+        }
+        let old = self.shared.state.load(Ordering::Acquire);
+        if old & PHASE != 0 {
+            return Err("A photo capture is already pending".into());
+        }
+        let ticket = old.wrapping_add(PHASE + 1);
+        self.shared
+            .state
+            .compare_exchange(old, ticket | ARMING, Ordering::AcqRel, Ordering::Acquire)
+            .map_err(|_| "A photo capture is already pending")?;
+        let sender = self.worker.get_or_init(|| {
+            let (tx, rx) = sync_channel(2);
+            let shared = self.shared.clone();
+            let input = self.input;
+            std::thread::Builder::new()
+                .name("windows-camera-still".into())
+                .spawn(move || worker(input, shared, rx))
+                .map_err(|e| e.to_string())?;
+            Ok(tx)
+        });
+        let sent = sender.as_ref().map_err(Clone::clone).and_then(|tx| {
+            tx.try_send(Command::Start(Request {
+                ticket,
+                path,
+                deadline: Instant::now() + DEADLINE,
+            }))
+            .map_err(|_| "Still capture queue is full or closed".into())
+        });
+        if sent.is_err() {
+            self.shared.state.store(ticket, Ordering::Release);
+        } else {
+            // Start is enqueued first; a frame cannot overtake its request.
+            let _ = self.shared.state.compare_exchange(
+                ticket | ARMING,
+                ticket | WAITING,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            );
+        }
+        sent
+    }
+    pub fn offer_frame(&self, format: VideoFormat, bytes: &[u8]) {
+        let state = self.shared.state.load(Ordering::Acquire);
+        if state & PHASE != WAITING {
+            return;
+        }
+        let ticket = state & !PHASE;
+        if self
+            .shared
+            .state
+            .compare_exchange(state, ticket | FRAME, Ordering::AcqRel, Ordering::Acquire)
+            .is_err()
+        {
+            return;
+        }
+        let data = if bytes.len() > MAX_BYTES || !valid_dimensions(format) {
+            Err("Camera frame exceeds the still capture budget".into())
+        } else if !matches!(
+            format.pixel_format,
+            VideoPixelFormat::MJPEG | VideoPixelFormat::NV12 | VideoPixelFormat::YUY2
+        ) {
+            Err("This camera format does not support JPEG capture".into())
+        } else {
+            Ok(Arc::from(bytes))
+        };
+        if let Some(Ok(tx)) = self.worker.get() {
+            if tx
+                .try_send(Command::Frame {
+                    ticket,
+                    format,
+                    bytes: data,
+                })
+                .is_ok()
+            {
+                return;
+            }
+        }
+        let _ = self.shared.state.compare_exchange(
+            ticket | FRAME,
+            ticket | CANCELLED,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        );
+    }
+    pub fn cancel(&self) {
+        let _ = self
+            .shared
+            .state
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |s| {
+                (s & PHASE != 0).then_some((s & !PHASE) | CANCELLED)
+            });
+    }
+    pub fn close(&self) {
+        self.shared.closed.store(true, Ordering::Release);
+        self.cancel();
+    }
+}
+fn valid_dimensions(format: VideoFormat) -> bool {
+    format.width > 0
+        && format.height > 0
+        && format.width <= 4096
+        && format.height <= 4096
+        && format
+            .width
+            .checked_mul(format.height)
+            .is_some_and(|n| n <= MAX_PIXELS)
+}
+fn check(request: &Request, shared: &Shared) -> Result<(), String> {
+    let state = shared.state.load(Ordering::Acquire);
+    if shared.closed.load(Ordering::Acquire)
+        || state & !PHASE != request.ticket
+        || state & PHASE == CANCELLED
+    {
+        Err("Photo capture cancelled because the camera closed or changed".into())
+    } else if Instant::now() >= request.deadline {
+        Err("Photo capture timed out".into())
+    } else {
+        Ok(())
+    }
+}
+fn settle(
+    input: VideoInputId,
+    shared: &Shared,
+    request: &Request,
+    result: Result<(u32, u32), String>,
+) {
+    let _ = shared
+        .state
+        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |s| {
+            (s & !PHASE == request.ticket).then_some(request.ticket)
+        });
+    Cx::post_action(CameraCaptureEvent {
+        input_id: input,
+        result: match result {
+            Ok((width, height)) => CameraCaptureResult::Photo {
+                path: request.path.clone(),
+                width,
+                height,
+            },
+            Err(error) => CameraCaptureResult::Failed {
+                what: "photo".into(),
+                error,
+            },
+        },
+    });
+}
+fn worker(input: VideoInputId, shared: Arc<Shared>, rx: Receiver<Command>) {
+    let mut pending: Option<Request> = None;
+    loop {
+        if let Some(request) = pending.as_ref() {
+            if let Err(error) = check(request, &shared) {
+                settle(input, &shared, request, Err(error));
+                pending = None;
+            }
+        }
+        match rx.recv_timeout(Duration::from_millis(100)) {
+            Ok(Command::Start(request)) => {
+                pending = Some(request);
+            }
+            Ok(Command::Frame {
+                ticket,
+                format,
+                bytes,
+            }) => {
+                if pending.as_ref().is_some_and(|p| p.ticket == ticket) {
+                    let request = pending.take().unwrap();
+                    let result = bytes.and_then(|data| save(&request, &shared, format, &data));
+                    settle(input, &shared, &request, result);
+                }
+            }
+            Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => break,
+            Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {}
+        }
+        if shared.closed.load(Ordering::Acquire) && pending.is_none() {
+            break;
+        }
+    }
+}
+fn jpeg(
+    format: VideoFormat,
+    bytes: &[u8],
+    request: &Request,
+    shared: &Shared,
+) -> Result<Vec<u8>, String> {
+    check(request, shared)?;
+    if !valid_dimensions(format) || bytes.len() > MAX_BYTES {
+        return Err("Invalid or oversized camera frame".into());
+    }
+    if format.pixel_format == VideoPixelFormat::MJPEG {
+        use makepad_zune_jpeg::{
+            makepad_zune_core::{bytestream::ZCursor, options::DecoderOptions},
+            JpegDecoder,
+        };
+        let options = DecoderOptions::default()
+            .set_strict_mode(true)
+            .set_max_width(4096)
+            .set_max_height(4096);
+        let mut decoder = JpegDecoder::new_with_options(ZCursor::new(bytes), options);
+        decoder
+            .decode_headers()
+            .map_err(|e| format!("Invalid camera JPEG: {e}"))?;
+        let info = decoder.info().ok_or("JPEG dimensions missing")?;
+        if info.width as usize != format.width || info.height as usize != format.height {
+            return Err("JPEG dimensions differ from the camera format".into());
+        }
+        decoder
+            .decode()
+            .map_err(|e| format!("Invalid camera JPEG: {e}"))?;
+        check(request, shared)?;
+        return Ok(bytes.to_vec());
+    }
+    if format.width % 2 != 0 || format.height % 2 != 0 {
+        return Err("Still capture needs an even YUV frame size".into());
+    }
+    let frame = super::media_foundation::camera_frame_from_media_buffer(format, 0, bytes)
+        .ok_or("Invalid camera plane layout")?;
+    let mut rgb = Vec::with_capacity(format.width * format.height * 3);
+    for y in 0..format.height {
+        check(request, shared)?;
+        for x in 0..format.width {
+            let (luma, u, v) = match frame.layout {
+                CameraFrameLayout::NV12 => {
+                    let uv = y / 2 * frame.planes[1].row_stride + (x / 2) * 2;
+                    (
+                        frame.planes[0].bytes[y * frame.planes[0].row_stride + x],
+                        frame.planes[1].bytes[uv],
+                        frame.planes[1].bytes[uv + 1],
+                    )
+                }
+                CameraFrameLayout::YUY2 => {
+                    let p = y * frame.planes[0].row_stride + (x / 2) * 4;
+                    (
+                        frame.planes[0].bytes[p + (x % 2) * 2],
+                        frame.planes[0].bytes[p + 1],
+                        frame.planes[0].bytes[p + 3],
+                    )
+                }
+                _ => return Err("This camera format cannot be encoded as JPEG".into()),
+            };
+            // Media Foundation camera frames here are limited-range BT.709.
+            let c = (luma as i32 - 16).max(0);
+            let d = u as i32 - 128;
+            let e = v as i32 - 128;
+            rgb.extend_from_slice(&[
+                ((298 * c + 459 * e + 128) >> 8).clamp(0, 255) as u8,
+                ((298 * c - 55 * d - 136 * e + 128) >> 8).clamp(0, 255) as u8,
+                ((298 * c + 541 * d + 128) >> 8).clamp(0, 255) as u8,
+            ]);
+        }
+    }
+    let mut encoded = Vec::new();
+    jpeg_encoder::Encoder::new(&mut encoded, 90)
+        .encode(
+            &rgb,
+            format.width as u16,
+            format.height as u16,
+            jpeg_encoder::ColorType::Rgb,
+        )
+        .map_err(|e| format!("JPEG encoding failed: {e}"))?;
+    check(request, shared)?;
+    if encoded.len() > MAX_BYTES {
+        return Err("Encoded photo exceeds capture budget".into());
+    }
+    Ok(encoded)
+}
+fn save(
+    request: &Request,
+    shared: &Shared,
+    format: VideoFormat,
+    bytes: &[u8],
+) -> Result<(u32, u32), String> {
+    let encoded = jpeg(format, bytes, request, shared)?;
+    check(request, shared)?;
+    shared
+        .state
+        .compare_exchange(
+            request.ticket | FRAME,
+            request.ticket | WRITING,
+            Ordering::AcqRel,
+            Ordering::Acquire,
+        )
+        .map_err(|_| "Photo capture cancelled before writing")?;
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&request.path)
+        .map_err(|e| {
+            format!("Cannot create capture file without replacing an existing file: {e}")
+        })?;
+    let result = (|| {
+        file.write_all(&encoded)
+            .map_err(|e| format!("Cannot write capture: {e}"))?;
+        file.sync_all()
+            .map_err(|e| format!("Cannot save capture: {e}"))?;
+        check(request, shared)?;
+        // Commit is the cancellation boundary; no later close removes a completed capture.
+        shared
+            .state
+            .compare_exchange(
+                request.ticket | WRITING,
+                request.ticket,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .map_err(|_| "Photo capture cancelled before commit")?;
+        Ok((format.width as u32, format.height as u32))
+    })();
+    drop(file);
+    if result.is_err() {
+        let _ = std::fs::remove_file(&request.path);
+    }
+    result
+}
