+    fn hardware_mouse_message() -> bool {
+        // This pinned windows-rs shim lacks Win32::UI::Input's message-origin
+        // bindings. Query user32 directly while processing the native message.
+        #[repr(C)]
+        #[derive(Default)]
+        struct InputMessageSource { device_type: i32, origin_id: i32 }
+        #[link(name = "user32")]
+        unsafe extern "system" {
+            fn GetCurrentInputMessageSource(source: *mut InputMessageSource) -> i32;
+        }
+        let mut source = InputMessageSource::default();
+        let received = unsafe { GetCurrentInputMessageSource(&mut source) != 0 };
+        received && Self::trusted_pointer_source(source.device_type, source.origin_id)
+    }
+
+    fn trusted_pointer_source(device_type: i32, origin_id: i32) -> bool {
+        matches!(device_type, 2 | 4 | 8 | 16) // mouse, touch, pen, touchpad
+            && origin_id == 1 // IMO_HARDWARE; injected/post messages fail closed
+    }
+
     pub fn send_mouse_down(&mut self, button: MouseButton, modifiers: KeyModifiers) {
         if self.mouse_buttons_down == 0 {
             unsafe {
@@ -1878,7 +1898,7 @@ pub fn send_mouse_down(&mut self, button: MouseButton, modifiers: KeyModifiers)
             abs: self.last_mouse_pos,
             time: self.time_now(),
             handled: Cell::new(Area::Empty),
-        }));
+        }, Self::hardware_mouse_message()));
     }
 
     pub fn send_mouse_up(&mut self, button: MouseButton, modifiers: KeyModifiers) {
@@ -1896,7 +1916,7 @@ pub fn send_mouse_up(&mut self, button: MouseButton, modifiers: KeyModifiers) {
             window_id: self.window_id,
             abs: self.last_mouse_pos,
             time: self.time_now(),
-        }));
+        }, Self::hardware_mouse_message()));
     }
 
     pub fn send_mouse_move(&mut self, pos: Vec2d, modifiers: KeyModifiers) {
@@ -2085,3 +2105,19 @@ pub fn virtual_key_to_key_code(wparam: WPARAM) -> KeyCode {
         }
     }
 }
+
+#[cfg(test)]
+mod input_source_tests {
+    use super::Win32Window;
+
+    #[test]
+    fn only_physical_pointer_messages_are_trusted() {
+        for device in [2, 4, 8, 16] {
+            assert!(Win32Window::trusted_pointer_source(device, 1));
+            assert!(!Win32Window::trusted_pointer_source(device, 2));
+            assert!(!Win32Window::trusted_pointer_source(device, 4));
+        }
+        assert!(!Win32Window::trusted_pointer_source(0, 1));
+        assert!(!Win32Window::trusted_pointer_source(1, 1));
+    }
+}
